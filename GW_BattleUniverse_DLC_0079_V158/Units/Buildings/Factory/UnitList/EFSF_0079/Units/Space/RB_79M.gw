[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini





[hiddenAction_AutoProduce_RB_79M]
@copyFromSection:template_AutoProduce
@define UnitID=RB_79M
alsoTriggerAction:AutoProduce_RB_79M_Step2

[hiddenAction_AutoProduce_RB_79M_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=450
@define Resource=1000
alsoQueueAction:Produce_RB_79M_StandardSquad



[action_Produce_RB_79M_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=RB_79M
@define Money=450
@define Resource=1000
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:30s

alsoQueueAction:"""
Produce_RB_79M_StandardSquad_1,
Produce_RB_79M_StandardSquad_2,
Produce_RB_79M_StandardSquad_3
"""
[hiddenAction_Produce_RB_79M_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RB_79M*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RB_79M_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RB_79M*1(addResources=PilotType:1101|EquipmentIndex:0)
