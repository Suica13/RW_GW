@define UnitID=RGM_79G_Space
@define Money=2500
@define Resource=3000
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:60s

alsoQueueAction:"""
Produce_RGM_79G_Space_StandardSquad_1,
Produce_RGM_79G_Space_StandardSquad_2,
Produce_RGM_79G_Space_StandardSquad_3
"""
