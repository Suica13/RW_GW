@define Money=800
@define Resource=1500
alsoQueueAction:Produce_RB_79K_StandardSquad



[action_Produce_RB_79K_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=RB_79K
@define Money=800
@define Resource=1500
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:45s

alsoQueueAction:"""
Produce_RB_79K_StandardSquad_1,
Produce_RB_79K_StandardSquad_2,
Produce_RB_79K_StandardSquad_3
"""
