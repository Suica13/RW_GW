[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini




[hiddenAction_AutoProduce_FF_S3]
@copyFromSection:template_AutoProduce
@define UnitID=FF_S3
alsoTriggerAction:AutoProduce_FF_S3_Step2

[hiddenAction_AutoProduce_FF_S3_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=300
@define Resource=600
alsoQueueAction:Produce_FF_S3_StandardSquad



[action_Produce_FF_S3_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=FF_S3
@define Money=550
@define Resource=1500
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:35s

alsoQueueAction:"""
Produce_FF_S3_StandardSquad_1,
Produce_FF_S3_StandardSquad_2,
Produce_FF_S3_StandardSquad_3
"""
[hiddenAction_Produce_FF_S3_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
FF_S3*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_FF_S3_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
FF_S3*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_FF_S3_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
FF_S3*1(addResources=PilotType:1101|EquipmentIndex:0)
"""