[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini




[hiddenAction_AutoProduce_SFU_X79]
@copyFromSection:template_AutoProduce
@define UnitID=SFU_X79
alsoTriggerAction:AutoProduce_SFU_X79_Step2

[hiddenAction_AutoProduce_SFU_X79_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=450
@define Resource=900
alsoQueueAction:Produce_SFU_X79_StandardSquad



[action_Produce_SFU_X79_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=SFU_X79
@define Money=450
@define Resource=650
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:25s

alsoQueueAction:"""
Produce_SFU_X79_StandardSquad_1,
Produce_SFU_X79_StandardSquad_2,
Produce_SFU_X79_StandardSquad_3
"""
[hiddenAction_Produce_SFU_X79_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
SFU_X79*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_SFU_X79_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
SFU_X79*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_SFU_X79_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
SFU_X79*1(addResources=PilotType:1101|EquipmentIndex:0)
"""