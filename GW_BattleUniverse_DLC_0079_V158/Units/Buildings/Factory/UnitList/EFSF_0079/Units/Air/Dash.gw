[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini




[hiddenAction_AutoProduce_Dash]
@copyFromSection:template_AutoProduce
@define UnitID=Dash
alsoTriggerAction:AutoProduce_Dash_Step2

[hiddenAction_AutoProduce_Dash_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=250
@define Resource=500
alsoQueueAction:Produce_Dash_StandardSquad



[action_Produce_Dash_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=Dash
@define Money=250
@define Resource=500
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:25s

alsoQueueAction:"""
Produce_Dash_StandardSquad_1
