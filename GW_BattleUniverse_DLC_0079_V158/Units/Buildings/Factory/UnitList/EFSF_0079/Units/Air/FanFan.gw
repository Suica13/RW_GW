[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini



[hiddenAction_AutoProduce_FanFan]
@copyFromSection:template_AutoProduce
@define UnitID=FanFan
alsoTriggerAction:AutoProduce_FanFan_Step2

[hiddenAction_AutoProduce_FanFan_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=125
@define Resource=300
alsoQueueAction:Produce_FanFan_StandardSquad


[action_Produce_FanFan_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=FanFan
@define Money=350
@define Resource=500
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:20s

alsoQueueAction:"""
Produce_FanFan_StandardSquad_1,
Produce_FanFan_StandardSquad_2,
Produce_FanFan_StandardSquad_3
"""
[hiddenAction_Produce_FanFan_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
FanFan*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_FanFan_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
FanFan*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
