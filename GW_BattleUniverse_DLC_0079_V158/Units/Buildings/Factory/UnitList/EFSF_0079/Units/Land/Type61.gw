[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini





[hiddenAction_AutoProduce_Type61]
@copyFromSection:template_AutoProduce
@define UnitID=Type61
alsoTriggerAction:AutoProduce_Type61_Step2

[hiddenAction_AutoProduce_Type61_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=250
@define Resource=500
alsoQueueAction:Produce_Type61_StandardSquad


[action_Produce_Type61_StandardSquad]
@copyFromSection:template_Produce_Fast

@define UnitID=Type61
@define Money=400
@define Resource=800
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
@define OtherVisible= (not self.globalTeamTags(includes='Unlock_Type61A5'))
buildSpeed:30s

alsoQueueAction:"""
Produce_Type61_StandardSquad_1,
Produce_Type61_StandardSquad_2,
Produce_Type61_StandardSquad_3
"""
[hiddenAction_Produce_Type61_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
Type61*1(addResources=PilotType:1001|EquipmentIndex:0)
"""
[hiddenAction_Produce_Type61_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
Type61*1(addResources=PilotType:1001|EquipmentIndex:0)
"""
[hiddenAction_Produce_Type61_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
Type61*1(addResources=PilotType:1001|EquipmentIndex:0)
"""