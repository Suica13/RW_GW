[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGC_80:bool


[hiddenAction_Pannel_Close_RGC_80]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGC_80=false




[hiddenAction_AutoProduce_RGC_80]
@copyFromSection:template_AutoProduce
@define UnitID=RGC_80
alsoTriggerAction:AutoProduce_RGC_80_Step2

[hiddenAction_AutoProduce_RGC_80_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1500
@define Resource=2050
alsoTriggerAction:AutoProduce_RGC_80_Random



[hiddenAction_AutoProduce_RGC_80_Random]
alsoTriggerAction:"""
AutoProduce_RGC_80_Random_A,
AutoProduce_RGC_80_Random_B
"""
[hiddenAction_AutoProduce_RGC_80_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RGC_80_StandardSquad

[hiddenAction_AutoProduce_RGC_80_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RGC_80_MGSquad




[action_Pannel_RGC_80]
@copyFromSection:template_Pannel
@define UnitID=RGC_80
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)

[action_Produce_RGC_80_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=RGC_80
@define Money=2700
@define Resource=4200
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:60s

alsoQueueAction:"""
Produce_RGC_80_StandardSquad_1,
Produce_RGC_80_StandardSquad_2,
Produce_RGC_80_StandardSquad_3
"""
[hiddenAction_Produce_RGC_80_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RGC_80*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RGC_80_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RGC_80*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RGC_80_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
RGC_80*1(addResources=PilotType:1101|EquipmentIndex:0)
"""

[action_Produce_RGC_80_MGSquad]
@copyFromSection:template_Produce
@define UnitID=RGC_80
@define Money=2250
@define Resource=3300
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:60s

text:MG Squad
text_zh:机枪小队

alsoQueueAction:"""
Produce_RGC_80_MGSquad_1,
Produce_RGC_80_MGSquad_2,
Produce_RGC_80_MGSquad_3
"""
[hiddenAction_Produce_RGC_80_MGSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RGC_80*1(addResources=PilotType:1101|EquipmentIndex:1)
"""
[hiddenAction_Produce_RGC_80_MGSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RGC_80*1(addResources=PilotType:1101|EquipmentIndex:1)
"""
[hiddenAction_Produce_RGC_80_MGSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
RGC_80*1(addResources=PilotType:1101|EquipmentIndex:1)
