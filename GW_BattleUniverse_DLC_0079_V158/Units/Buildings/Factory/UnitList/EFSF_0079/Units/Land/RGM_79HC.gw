[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGM_79HC:bool


[hiddenAction_Pannel_Close_RGM_79HC]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGM_79HC=false




[hiddenAction_AutoProduce_RGM_79HC]
@copyFromSection:template_AutoProduce
@define UnitID=RGM_79HC
alsoTriggerAction:AutoProduce_RGM_79HC_Step2

[hiddenAction_AutoProduce_RGM_79HC_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3400
@define Resource=4500
alsoTriggerAction:AutoProduce_RGM_79HC_Random



[hiddenAction_AutoProduce_RGM_79HC_Random]
alsoTriggerAction:"""
AutoProduce_RGM_79HC_Random_A,
AutoProduce_RGM_79HC_Random_B
"""
[hiddenAction_AutoProduce_RGM_79HC_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RGM_79HC_StandardSquad

[hiddenAction_AutoProduce_RGM_79HC_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RGM_79HC_BazookaSquad





[action_Pannel_RGM_79HC]
@copyFromSection:template_Pannel
@define UnitID=RGM_79HC
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)

[action_Produce_RGM_79HC_StandardSquad]
