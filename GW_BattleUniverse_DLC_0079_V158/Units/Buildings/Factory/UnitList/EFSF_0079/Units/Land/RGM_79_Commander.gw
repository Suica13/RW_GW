[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGM_79_Commander:bool


[hiddenAction_Pannel_Close_RGM_79_Commander]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGM_79_Commander=false




[hiddenAction_AutoProduce_RGM_79_Commander]
@copyFromSection:template_AutoProduce
@define UnitID=RGM_79_Commander
alsoTriggerAction:AutoProduce_RGM_79_Commander_Step2

[hiddenAction_AutoProduce_RGM_79_Commander_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=900
@define Resource=1250
alsoTriggerAction:AutoProduce_RGM_79_Commander_Random



[hiddenAction_AutoProduce_RGM_79_Commander_Random]
alsoTriggerAction:"""
AutoProduce_RGM_79_Commander_Random_A,
AutoProduce_RGM_79_Commander_Random_B,
AutoProduce_RGM_79_Commander_Random_C
"""
[hiddenAction_AutoProduce_RGM_79_Commander_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RGM_79_Commander_StandardSquad

[hiddenAction_AutoProduce_RGM_79_Commander_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RGM_79_Commander_BazookaSquad

[hiddenAction_AutoProduce_RGM_79_Commander_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_RGM_79_Commander_MGSquad





[action_Pannel_RGM_79_Commander]
@copyFromSection:template_Pannel
@define UnitID=RGM_79_Commander
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png

[action_Produce_RGM_79_Commander_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=RGM_79_Commander
@define Money=900
@define Resource=1250
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:30s

text:BG
text_zh:光束枪

alsoQueueAction:"""
Produce_RGM_79_Commander_StandardSquad_1
"""
[hiddenAction_Produce_RGM_79_Commander_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RGM_79_Commander*1(addResources=PilotType:1101|EquipmentIndex:0)
"""



[action_Produce_RGM_79_Commander_MGSquad]
@copyFromSection:template_Produce
@define UnitID=RGM_79_Commander
@define Money=650
@define Resource=650
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:30s

text:MG
text_zh:机枪

alsoQueueAction:"""
Produce_RGM_79_Commander_MGSquad_1
"""
[hiddenAction_Produce_RGM_79_Commander_MGSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RGM_79_Commander*1(addResources=PilotType:1101|EquipmentIndex:1)
"""


[action_Produce_RGM_79_Commander_BazookaSquad]
@copyFromSection:template_Produce
@define UnitID=RGM_79_Commander
@define Money=650
@define Resource=850
