[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGM_79N:bool


[hiddenAction_Pannel_Close_RGM_79N]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGM_79N=false




[hiddenAction_AutoProduce_RGM_79N]
@copyFromSection:template_AutoProduce
@define UnitID=RGM_79N
alsoTriggerAction:AutoProduce_RGM_79N_Step2

[hiddenAction_AutoProduce_RGM_79N_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3200
@define Resource=4000
alsoTriggerAction:AutoProduce_RGM_79N_Random



[hiddenAction_AutoProduce_RGM_79N_Random]
alsoTriggerAction:"""
AutoProduce_RGM_79N_Random_A,
AutoProduce_RGM_79N_Random_B,
AutoProduce_RGM_79N_Random_C
"""
[hiddenAction_AutoProduce_RGM_79N_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RGM_79N_StandardSquad

[hiddenAction_AutoProduce_RGM_79N_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RGM_79N_BeamGunSquad

[hiddenAction_AutoProduce_RGM_79N_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_RGM_79N_BazookaSquad





[action_Pannel_RGM_79N]
@copyFromSection:template_Pannel
@define UnitID=RGM_79N
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)

[action_Produce_RGM_79N_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=RGM_79N
@define Money=3200
@define Resource=4000
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:55s

alsoQueueAction:"""
Produce_RGM_79N_StandardSquad_1,
Produce_RGM_79N_StandardSquad_2,
Produce_RGM_79N_StandardSquad_3
"""
[hiddenAction_Produce_RGM_79N_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RGM_79N*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RGM_79N_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RGM_79N*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RGM_79N_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
RGM_79N*1(addResources=PilotType:1101|EquipmentIndex:0)
"""

