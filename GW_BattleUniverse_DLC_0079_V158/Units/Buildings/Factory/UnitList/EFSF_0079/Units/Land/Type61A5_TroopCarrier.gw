[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini



[hiddenAction_AutoProduce_Type61A5_TroopCarrier]
@copyFromSection:template_AutoProduce
@define UnitID=Type61A5_TroopCarrier
alsoTriggerAction:AutoProduce_Type61A5_TroopCarrier_Step2

[hiddenAction_AutoProduce_Type61A5_TroopCarrier_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=250
@define Resource=500
alsoQueueAction:Produce_Type61A5_TroopCarrier_StandardSquad





[action_Produce_Type61A5_TroopCarrier_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=Type61A5_TroopCarrier
@define Money=450
@define Resource=900
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:30s

alsoQueueAction:"""
Produce_Type61A5_TroopCarrier_StandardSquad_1,
Produce_Type61A5_TroopCarrier_StandardSquad_2,
Produce_Type61A5_TroopCarrier_StandardSquad_3
"""
[hiddenAction_Produce_Type61A5_TroopCarrier_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
Type61A5_TroopCarrier*1(addResources=PilotType:1001|EquipmentIndex:1)
"""
