[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RX_81:bool


[hiddenAction_Pannel_Close_RX_81]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RX_81=false




[hiddenAction_AutoProduce_RX_81]
@copyFromSection:template_AutoProduce
@define UnitID=RX_81
alsoTriggerAction:AutoProduce_RX_81_Step2

[hiddenAction_AutoProduce_RX_81_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=5750
@define Resource=8000
alsoTriggerAction:AutoProduce_RX_81_Random



[hiddenAction_AutoProduce_RX_81_Random]
alsoTriggerAction:"""
AutoProduce_RX_81_Random_A,
AutoProduce_RX_81_Random_B,
AutoProduce_RX_81_Random_C
"""
[hiddenAction_AutoProduce_RX_81_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RX_81_STSquad

[hiddenAction_AutoProduce_RX_81_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RX_81_LASquad

[hiddenAction_AutoProduce_RX_81_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_RX_81_ASSquad





[action_Pannel_RX_81]
@copyFromSection:template_Pannel
@define UnitID=RX_81
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)

[action_Produce_RX_81_STSquad]
@copyFromSection:template_Produce
@define UnitID=RX_81
@define Money=5500
@define Resource=6000
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
@define OtherVisible= (self.globalTeamTags(includes='Unlock_RX_81ST'))

isLocked:if not self.globalTeamTags(includes='Unlock_RX_81ST') 

buildSpeed:60s

unitShownInUI:RX_81ST
text:Standard Armor Squad
text_zh:标准装甲型小队

alsoQueueAction:"""
Produce_RX_81_STSquad_1,
Produce_RX_81_STSquad_2,
Produce_RX_81_STSquad_3
"""
[hiddenAction_Produce_RX_81_STSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RX_81ST*1(addResources=PilotType:1101|EquipmentIndex:1)
"""
[hiddenAction_Produce_RX_81_STSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RX_81ST*1(addResources=PilotType:1101|EquipmentIndex:1)
"""
[hiddenAction_Produce_RX_81_STSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
RX_81ST*1(addResources=PilotType:1101|EquipmentIndex:1)
"""

