"""
[hiddenAction_Produce_RGM_79L_MGSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RGM_79L*1(addResources=PilotType:1101|EquipmentIndex:1)
"""
[hiddenAction_Produce_RGM_79L_MGSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RGM_79L*1(addResources=PilotType:1101|EquipmentIndex:1)
