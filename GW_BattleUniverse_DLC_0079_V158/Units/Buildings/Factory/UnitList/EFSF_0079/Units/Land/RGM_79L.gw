[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGM_79L:bool


[hiddenAction_Pannel_Close_RGM_79L]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGM_79L=false




[hiddenAction_AutoProduce_RGM_79L]
@copyFromSection:template_AutoProduce
@define UnitID=RGM_79L
alsoTriggerAction:AutoProduce_RGM_79L_Step2

[hiddenAction_AutoProduce_RGM_79L_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1500
@define Resource=2250
alsoTriggerAction:AutoProduce_RGM_79L_Random



[hiddenAction_AutoProduce_RGM_79L_Random]
alsoTriggerAction:"""
AutoProduce_RGM_79L_Random_A,
AutoProduce_RGM_79L_Random_B
"""
[hiddenAction_AutoProduce_RGM_79L_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RGM_79L_StandardSquad

[hiddenAction_AutoProduce_RGM_79L_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RGM_79L_MGSquad




[action_Pannel_RGM_79L]
@copyFromSection:template_Pannel
@define UnitID=RGM_79L
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)

[action_Produce_RGM_79L_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=RGM_79L
@define Money=2700
@define Resource=3100
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:55s

alsoQueueAction:"""
Produce_RGM_79L_StandardSquad_1,
Produce_RGM_79L_StandardSquad_2,
Produce_RGM_79L_StandardSquad_3
"""
[hiddenAction_Produce_RGM_79L_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RGM_79L*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RGM_79L_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RGM_79L*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RGM_79L_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
RGM_79L*1(addResources=PilotType:1101|EquipmentIndex:0)
"""

