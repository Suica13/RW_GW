[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGM_79V:bool


[hiddenAction_Pannel_Close_RGM_79V]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGM_79V=false




[hiddenAction_AutoProduce_RGM_79V]
@copyFromSection:template_AutoProduce
@define UnitID=RGM_79V
alsoTriggerAction:AutoProduce_RGM_79V_Step2

[hiddenAction_AutoProduce_RGM_79V_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3200
@define Resource=3700
alsoTriggerAction:AutoProduce_RGM_79V_Random



[hiddenAction_AutoProduce_RGM_79V_Random]
alsoTriggerAction:"""
AutoProduce_RGM_79V_Random_A,
AutoProduce_RGM_79V_Random_B
"""
[hiddenAction_AutoProduce_RGM_79V_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RGM_79V_StandardSquad

[hiddenAction_AutoProduce_RGM_79V_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RGM_79V_MGSquad




[action_Pannel_RGM_79V]
@copyFromSection:template_Pannel
@define UnitID=RGM_79V
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)

[action_Produce_RGM_79V_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=RGM_79V
@define Money=3200
@define Resource=3700
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:55s

alsoQueueAction:"""
Produce_RGM_79V_StandardSquad_1,
Produce_RGM_79V_StandardSquad_2,
Produce_RGM_79V_StandardSquad_3
"""
[hiddenAction_Produce_RGM_79V_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RGM_79V*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RGM_79V_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RGM_79V*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RGM_79V_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
RGM_79V*1(addResources=PilotType:1101|EquipmentIndex:0)
"""

