[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGM_79_D:bool


[hiddenAction_Pannel_Close_RGM_79_D]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGM_79_D=false




[hiddenAction_AutoProduce_RGM_79_D]
@copyFromSection:template_AutoProduce
@define UnitID=RGM_79_D
alsoTriggerAction:AutoProduce_RGM_79_D_Step2

[hiddenAction_AutoProduce_RGM_79_D_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1700
@define Resource=3900
alsoTriggerAction:AutoProduce_RGM_79_D_Random



[hiddenAction_AutoProduce_RGM_79_D_Random]
alsoTriggerAction:"""
AutoProduce_RGM_79_D_Random_A,
AutoProduce_RGM_79_D_Random_B
"""
[hiddenAction_AutoProduce_RGM_79_D_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RGM_79_D_StandardSquad

[hiddenAction_AutoProduce_RGM_79_D_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RGM_79_D_BeamShotGunSquad






[action_Pannel_RGM_79_D]
@copyFromSection:template_Pannel
@define UnitID=RGM_79_D
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)

[action_Produce_RGM_79_D_StandardSquad]
