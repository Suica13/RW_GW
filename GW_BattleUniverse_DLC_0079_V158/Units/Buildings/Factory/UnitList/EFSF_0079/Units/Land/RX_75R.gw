[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini





[hiddenAction_AutoProduce_RX_75R]
@copyFromSection:template_AutoProduce
@define UnitID=RX_75R
alsoTriggerAction:AutoProduce_RX_75R_Step2

[hiddenAction_AutoProduce_RX_75R_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=600
@define Resource=1250
alsoQueueAction:Produce_RX_75R_StandardSquad



[action_Produce_RX_75R_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=RX_75R
@define Money=800
@define Resource=1500
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:60s

alsoQueueAction:"""
Produce_RX_75R_StandardSquad_1,
Produce_RX_75R_StandardSquad_2,
Produce_RX_75R_StandardSquad_3
"""
[hiddenAction_Produce_RX_75R_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RX_75R*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RX_75R_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RX_75R*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RX_75R_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
RX_75R*1(addResources=PilotType:1101|EquipmentIndex:0)
"""