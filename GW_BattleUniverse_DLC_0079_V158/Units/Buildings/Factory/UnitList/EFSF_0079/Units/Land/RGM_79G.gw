Produce_RGM_79G_StandardSquad_3
"""
[hiddenAction_Produce_RGM_79G_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RGM_79G*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
