[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RAG_79:bool


[hiddenAction_Pannel_Close_RAG_79]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RAG_79=false




[hiddenAction_AutoProduce_RAG_79]
@copyFromSection:template_AutoProduce
@define UnitID=RAG_79
alsoTriggerAction:AutoProduce_RAG_79_Step2

[hiddenAction_AutoProduce_RAG_79_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2250
@define Resource=2800
alsoTriggerAction:AutoProduce_RAG_79_Random



[hiddenAction_AutoProduce_RAG_79_Random]
alsoTriggerAction:"""
AutoProduce_RAG_79_Random_A,
AutoProduce_RAG_79_Random_B
"""
[hiddenAction_AutoProduce_RAG_79_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RAG_79_StandardSquad

[hiddenAction_AutoProduce_RAG_79_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RAG_79_HGSquad




[action_Pannel_RAG_79]
@copyFromSection:template_Pannel
@define UnitID=RAG_79
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)

[action_Produce_RAG_79_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=RAG_79
@define Money=2250
@define Resource=3400
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:55s

alsoQueueAction:"""
Produce_RAG_79_StandardSquad_1,
Produce_RAG_79_StandardSquad_2,
Produce_RAG_79_StandardSquad_3
"""
[hiddenAction_Produce_RAG_79_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RAG_79*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RAG_79_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RAG_79*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RAG_79_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
RAG_79*1(addResources=PilotType:1101|EquipmentIndex:0)
"""

