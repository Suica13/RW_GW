[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGM_79LV:bool


[hiddenAction_Pannel_Close_RGM_79LV]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGM_79LV=false




[hiddenAction_AutoProduce_RGM_79LV]
@copyFromSection:template_AutoProduce
@define UnitID=RGM_79LV
alsoTriggerAction:AutoProduce_RGM_79LV_Step2

[hiddenAction_AutoProduce_RGM_79LV_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2500
@define Resource=3000
alsoTriggerAction:AutoProduce_RGM_79LV_Random



[hiddenAction_AutoProduce_RGM_79LV_Random]
alsoTriggerAction:"""
AutoProduce_RGM_79LV_Random_A,
AutoProduce_RGM_79LV_Random_B,
AutoProduce_RGM_79LV_Random_C
"""
[hiddenAction_AutoProduce_RGM_79LV_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RGM_79LV_StandardSquad

[hiddenAction_AutoProduce_RGM_79LV_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RGM_79LV_BeamGunSquad

[hiddenAction_AutoProduce_RGM_79LV_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_RGM_79LV_BazookaSquad





[action_Pannel_RGM_79LV]
@copyFromSection:template_Pannel
@define UnitID=RGM_79LV
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)

[action_Produce_RGM_79LV_StandardSquad]
