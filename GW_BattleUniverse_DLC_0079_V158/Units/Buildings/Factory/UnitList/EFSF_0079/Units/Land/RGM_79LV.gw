@define UnitID=RGM_79LV
@define Money=3000
@define Resource=3500
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:60s

alsoQueueAction:"""
Produce_RGM_79LV_StandardSquad_1,
Produce_RGM_79LV_StandardSquad_2,
Produce_RGM_79LV_StandardSquad_3
"""
[hiddenAction_Produce_RGM_79LV_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RGM_79LV*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RGM_79LV_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RGM_79LV*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
