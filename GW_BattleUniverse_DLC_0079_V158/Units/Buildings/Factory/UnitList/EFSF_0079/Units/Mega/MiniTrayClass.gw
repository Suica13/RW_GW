[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini





[hiddenAction_AutoProduce_MiniTrayClass]
@copyFromSection:template_AutoProduce
@define UnitID=MiniTrayClass
alsoTriggerAction:AutoProduce_MiniTrayClass_Step2

[hiddenAction_AutoProduce_MiniTrayClass_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2500
@define Resource=3500
alsoQueueAction:Produce_MiniTrayClass



[action_Produce_MiniTrayClass]
@copyFromSection:template_Produce_Fast
@define UnitID=MiniTrayClass
@define Money=2500
@define Resource=3500
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:45s

alsoQueueAction:"""
Produce_MiniTrayClass_1
