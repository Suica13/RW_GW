@define Money=600
@define Resource=1200
alsoQueueAction:Produce_BurkeClass



[action_Produce_BurkeClass]
@copyFromSection:template_Produce_Fast
@define UnitID=BurkeClass
@define Money=600
@define Resource=1200
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:35s

alsoQueueAction:"""
Produce_BurkeClass_1
