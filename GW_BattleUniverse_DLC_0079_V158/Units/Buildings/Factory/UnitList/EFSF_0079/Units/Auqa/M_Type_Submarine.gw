[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini





[hiddenAction_AutoProduce_M_Type_Submarine]
@copyFromSection:template_AutoProduce
@define UnitID=M_Type_Submarine
alsoTriggerAction:AutoProduce_M_Type_Submarine_Step2

[hiddenAction_AutoProduce_M_Type_Submarine_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2500
@define Resource=5000
alsoQueueAction:Produce_M_Type_Submarine



[action_Produce_M_Type_Submarine]
@copyFromSection:template_Produce_Fast
@define UnitID=M_Type_Submarine
@define Money=2500
@define Resource=5000
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:60s

alsoQueueAction:"""
Produce_M_Type_Submarine_1
