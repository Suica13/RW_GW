[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini




[hiddenAction_AutoProduce_Luggun]
@copyFromSection:template_AutoProduce
@define UnitID=Luggun
alsoTriggerAction:AutoProduce_Luggun_Step2

[hiddenAction_AutoProduce_Luggun_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=350
@define Resource=500
alsoQueueAction:Produce_Luggun_StandardSquad



[action_Produce_Luggun_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=Luggun
@define Money=350
@define Resource=500
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:25s

alsoQueueAction:"""
Produce_Luggun_StandardSquad_1
