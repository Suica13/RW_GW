[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini




[hiddenAction_AutoProduce_ZN_Heli]
@copyFromSection:template_AutoProduce
@define UnitID=ZN_Heli
alsoTriggerAction:AutoProduce_ZN_Heli_Step2

[hiddenAction_AutoProduce_ZN_Heli_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=500
@define Resource=900
alsoQueueAction:Produce_ZN_Heli_StandardSquad



[action_Produce_ZN_Heli_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=ZN_Heli
@define Money=500
@define Resource=900
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:25s

alsoQueueAction:"""
Produce_ZN_Heli_StandardSquad_1,
Produce_ZN_Heli_StandardSquad_2,
Produce_ZN_Heli_StandardSquad_3
"""
[hiddenAction_Produce_ZN_Heli_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
ZN_Heli*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_ZN_Heli_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
ZN_Heli*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
