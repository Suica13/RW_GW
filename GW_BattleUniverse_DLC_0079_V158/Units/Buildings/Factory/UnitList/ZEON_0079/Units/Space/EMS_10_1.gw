[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory EMS_10_1:bool


[hiddenAction_Pannel_Close_EMS_10_1]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:EMS_10_1=false




[hiddenAction_AutoProduce_EMS_10_1]
@copyFromSection:template_AutoProduce
@define UnitID=EMS_10_1
alsoTriggerAction:AutoProduce_EMS_10_1_Step2

[hiddenAction_AutoProduce_EMS_10_1_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=650
@define Resource=750
alsoTriggerAction:AutoProduce_EMS_10_1_Random



[hiddenAction_AutoProduce_EMS_10_1_Random]
alsoTriggerAction:"""
AutoProduce_EMS_10_1_Random_A,
AutoProduce_EMS_10_1_Random_B,
AutoProduce_EMS_10_1_Random_C
"""
[hiddenAction_AutoProduce_EMS_10_1_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_EMS_10_1_StandardSquad

[hiddenAction_AutoProduce_EMS_10_1_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_EMS_10_1_BazookaSquad

[hiddenAction_AutoProduce_EMS_10_1_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_EMS_10_1_SniperSquad





[action_Pannel_EMS_10_1]
@copyFromSection:template_Pannel
@define UnitID=EMS_10_1
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png

[action_Produce_EMS_10_1_StandardSquad]
