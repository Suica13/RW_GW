@define UnitID=EMS_10_1
@define Money=650
@define Resource=750
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:30s

text:MG
text_zh:机枪

alsoQueueAction:"""
Produce_EMS_10_1_StandardSquad_1
"""
[hiddenAction_Produce_EMS_10_1_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
EMS_10_1*1(addResources=PilotType:1101|EquipmentIndex:0)
"""



