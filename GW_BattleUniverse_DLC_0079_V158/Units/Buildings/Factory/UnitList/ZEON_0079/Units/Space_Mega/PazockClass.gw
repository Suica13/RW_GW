@define UnitID=PazockClass
alsoTriggerAction:AutoProduce_PazockClass_Step2

[hiddenAction_AutoProduce_PazockClass_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1000
@define Resource=2000
alsoQueueAction:Produce_PazockClass_StandardSquad



[action_Produce_PazockClass_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=PazockClass
@define Money=1000
@define Resource=2000
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:35s

alsoQueueAction:"""
Produce_PazockClass_StandardSquad_1
