[action_Produce_DabudeClass]
@copyFromSection:template_Produce_Fast
@define UnitID=DabudeClass
@define Money=3000
@define Resource=5000
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:50s

alsoQueueAction:"""
Produce_DabudeClass_1
