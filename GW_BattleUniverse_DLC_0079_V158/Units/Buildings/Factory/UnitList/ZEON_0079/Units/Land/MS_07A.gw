[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_07A:bool


[hiddenAction_Pannel_Close_MS_07A]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_07A=false



[hiddenAction_AutoProduce_MS_07A]
@copyFromSection:template_AutoProduce
@define UnitID=MS_07A
alsoTriggerAction:AutoProduce_MS_07A_Step2

[hiddenAction_AutoProduce_MS_07A_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1400
@define Resource=1600
alsoTriggerAction:AutoProduce_MS_07A_Random



[hiddenAction_AutoProduce_MS_07A_Random]
alsoTriggerAction:"""
AutoProduce_MS_07A_Random_A,
AutoProduce_MS_07A_Random_B,
AutoProduce_MS_07A_Random_C
"""
[hiddenAction_AutoProduce_MS_07A_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MS_07A_StandardSquad

[hiddenAction_AutoProduce_MS_07A_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_MS_07A_BazookaSquad

[hiddenAction_AutoProduce_MS_07A_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_MS_07A_AntiAirSquad




[action_Pannel_MS_07A]
@copyFromSection:template_Pannel
@define UnitID=MS_07A
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)


[action_Produce_MS_07A_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MS_07A
@define Money=1400
@define Resource=1600
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:50s

alsoQueueAction:"""
Produce_MS_07A_StandardSquad_1,
Produce_MS_07A_StandardSquad_2,
Produce_MS_07A_StandardSquad_3
"""
[hiddenAction_Produce_MS_07A_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_07A*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_07A_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MS_07A*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_07A_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
MS_07A*1(addResources=PilotType:1101|EquipmentIndex:0)
"""



