[hiddenAction_AutoProduce_YMS_09J]
@copyFromSection:template_AutoProduce
@define UnitID=YMS_09J
alsoTriggerAction:AutoProduce_YMS_09J_Step2

[hiddenAction_AutoProduce_YMS_09J_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3000
@define Resource=4400
alsoTriggerAction:AutoProduce_YMS_09J_Random



[hiddenAction_AutoProduce_YMS_09J_Random]
alsoTriggerAction:"""
AutoProduce_YMS_09J_Random_A,
AutoProduce_YMS_09J_Random_B
"""
[hiddenAction_AutoProduce_YMS_09J_Random_A]
