[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory MS_14S:bool


[hiddenAction_Pannel_Close_MS_14S]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_14S=false




[hiddenAction_AutoProduce_MS_14S]
@copyFromSection:template_AutoProduce
@define UnitID=MS_14S
alsoTriggerAction:AutoProduce_MS_14S_Step2

[hiddenAction_AutoProduce_MS_14S_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1550
@define Resource=2050
alsoTriggerAction:AutoProduce_MS_14S_Random



[hiddenAction_AutoProduce_MS_14S_Random]
alsoTriggerAction:"""
AutoProduce_MS_14S_Random_A,
AutoProduce_MS_14S_Random_B,
AutoProduce_MS_14S_Random_C
"""
[hiddenAction_AutoProduce_MS_14S_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MS_14S_StandardSquad

[hiddenAction_AutoProduce_MS_14S_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_MS_14S_MGSquad

[hiddenAction_AutoProduce_MS_14S_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_MS_14S_BazookaSquad





[action_Pannel_MS_14S]
@copyFromSection:template_Pannel
@define UnitID=MS_14S
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png

[action_Produce_MS_14S_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MS_14S
@define Money=1550
@define Resource=1950
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:35s

text:BR
text_zh:光束步枪

alsoQueueAction:"""
Produce_MS_14S_StandardSquad_1
"""
[hiddenAction_Produce_MS_14S_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_14S*1(addResources=PilotType:1101|EquipmentIndex:0)
"""



[action_Produce_MS_14S_BazookaSquad]
@copyFromSection:template_Produce
@define UnitID=MS_14S
@define Money=1350
@define Resource=1750
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:35s

text:Bazooka
text_zh:火箭筒

alsoQueueAction:"""
Produce_MS_14S_BazookaSquad_1
"""
[hiddenAction_Produce_MS_14S_BazookaSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_14S*1(addResources=PilotType:1101|EquipmentIndex:1)
"""


