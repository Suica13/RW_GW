[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_09F:bool


[hiddenAction_Pannel_Close_MS_09F]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_09F=false



[hiddenAction_AutoProduce_MS_09F]
@copyFromSection:template_AutoProduce
@define UnitID=MS_09F
alsoTriggerAction:AutoProduce_MS_09F_Step2

[hiddenAction_AutoProduce_MS_09F_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2000
@define Resource=3350
alsoTriggerAction:AutoProduce_MS_09F_Random



[hiddenAction_AutoProduce_MS_09F_Random]
alsoTriggerAction:"""
AutoProduce_MS_09F_Random_A,
AutoProduce_MS_09F_Random_B
"""
[hiddenAction_AutoProduce_MS_09F_Random_A]
requireConditional:"""
if memory.randomProduce<500
"""
alsoQueueAction:Produce_MS_09F_StandardSquad

[hiddenAction_AutoProduce_MS_09F_Random_B]
requireConditional:"""
if memory.randomProduce>500
"""
