[hiddenAction_AutoProduce_MS_06C]
@copyFromSection:template_AutoProduce
@define UnitID=MS_06C
alsoTriggerAction:AutoProduce_MS_06C_Step2

[hiddenAction_AutoProduce_MS_06C_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=4500
@define Resource=4500
alsoTriggerAction:Produce_MS_06C_StandardSquad




[action_Produce_MS_06C_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=MS_06C
@define Money=4500
@define Resource=4500
@define MoralPoint=250
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:40s

text:Nuke
text_zh:核弹头

alsoQueueAction:"""
Produce_MS_06C_StandardSquad_1
