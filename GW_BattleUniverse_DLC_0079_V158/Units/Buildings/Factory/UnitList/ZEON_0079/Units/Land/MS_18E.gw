[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory MS_18E:bool


[hiddenAction_Pannel_Close_MS_18E]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_18E=false




[hiddenAction_AutoProduce_MS_18E]
@copyFromSection:template_AutoProduce
@define UnitID=MS_18E
alsoTriggerAction:AutoProduce_MS_18E_Step2

[hiddenAction_AutoProduce_MS_18E_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1750
@define Resource=2250
alsoTriggerAction:AutoProduce_MS_18E_Random



[hiddenAction_AutoProduce_MS_18E_Random]
alsoTriggerAction:"""
AutoProduce_MS_18E_Random_A
"""
[hiddenAction_AutoProduce_MS_18E_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MS_18E_StandardSquad




[action_Produce_MS_18E_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=MS_18E
@define Money=1750
@define Resource=2250
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:40s

alsoQueueAction:"""
Produce_MS_18E_StandardSquad_1
"""
[hiddenAction_Produce_MS_18E_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_18E*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
