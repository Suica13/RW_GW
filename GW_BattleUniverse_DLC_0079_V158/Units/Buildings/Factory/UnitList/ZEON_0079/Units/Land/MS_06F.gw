[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_06F:bool


[hiddenAction_Pannel_Close_MS_06F]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_06F=false



[hiddenAction_AutoProduce_MS_06F]
@copyFromSection:template_AutoProduce
@define UnitID=MS_06F
alsoTriggerAction:AutoProduce_MS_06F_Step2

[hiddenAction_AutoProduce_MS_06F_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=800
@define Resource=1600
alsoTriggerAction:AutoProduce_MS_06F_Random

[hiddenAction_AutoProduce_MS_06F_Random]
alsoTriggerAction:"""
AutoProduce_MS_06F_Random_A,
AutoProduce_MS_06F_Random_B
"""
[hiddenAction_AutoProduce_MS_06F_Random_A]
requireConditional:if memory.randomProduce<=750
alsoQueueAction:Produce_MS_06F_StandardSquad

[hiddenAction_AutoProduce_MS_06F_Random_B]
requireConditional:if memory.randomProduce>750
alsoQueueAction:Produce_MS_06F_BazookaSquad




[action_Pannel_MS_06F]
@copyFromSection:template_Pannel
@define UnitID=MS_06F
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
@define OtherVisible= (not self.globalTeamTags(includes='Unlock_MS_06F2'))


[action_Produce_MS_06F_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MS_06F
@define Money=800
@define Resource=1600
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
@define OtherVisible= (not self.globalTeamTags(includes='Unlock_MS_06F2'))
buildSpeed:50s

alsoQueueAction:"""
Produce_MS_06F_StandardSquad_1,
Produce_MS_06F_StandardSquad_2,
Produce_MS_06F_StandardSquad_3
"""
[hiddenAction_Produce_MS_06F_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_06F*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_06F_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MS_06F*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_06F_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
MS_06F*1(addResources=PilotType:1101|EquipmentIndex:0)
"""



[action_Produce_MS_06F_BazookaSquad]
@copyFromSection:template_Produce
@define UnitID=MS_06F
@define Money=800
@define Resource=2200
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
@define OtherVisible= (not self.globalTeamTags(includes='Unlock_MS_06F2'))
buildSpeed:50s

text:Bazooka Squad
text_zh:火箭筒小队

alsoQueueAction:"""
Produce_MS_06F_BazookaSquad_1,
Produce_MS_06F_BazookaSquad_2,
Produce_MS_06F_BazookaSquad_3
"""
[hiddenAction_Produce_MS_06F_BazookaSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_06F*1(addResources=PilotType:1101|EquipmentIndex:1)
"""
[hiddenAction_Produce_MS_06F_BazookaSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MS_06F*1(addResources=PilotType:1101|EquipmentIndex:1)
"""
[hiddenAction_Produce_MS_06F_BazookaSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
MS_06F*1(addResources=PilotType:1101|EquipmentIndex:1)
"""