[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_09:bool


[hiddenAction_Pannel_Close_MS_09]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_09=false



[hiddenAction_AutoProduce_MS_09]
@copyFromSection:template_AutoProduce
@define UnitID=MS_09
alsoTriggerAction:AutoProduce_MS_09_Step2

[hiddenAction_AutoProduce_MS_09_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2000
@define Resource=3350
alsoTriggerAction:AutoProduce_MS_09_Random



[hiddenAction_AutoProduce_MS_09_Random]
alsoTriggerAction:"""
AutoProduce_MS_09_Random_A,
AutoProduce_MS_09_Random_B
"""
[hiddenAction_AutoProduce_MS_09_Random_A]
requireConditional:"""
if memory.randomProduce<500
"""
alsoQueueAction:Produce_MS_09_StandardSquad

[hiddenAction_AutoProduce_MS_09_Random_B]
requireConditional:"""
if memory.randomProduce>500
"""
alsoQueueAction:Produce_MS_09_MGSquad




[action_Pannel_MS_09]
@copyFromSection:template_Pannel
@define UnitID=MS_09
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)


[action_Produce_MS_09_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MS_09
@define Money=2000
@define Resource=3350
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:55s

alsoQueueAction:"""
Produce_MS_09_StandardSquad_1,
Produce_MS_09_StandardSquad_2,
Produce_MS_09_StandardSquad_3
"""
[hiddenAction_Produce_MS_09_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_09*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_09_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MS_09*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_09_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
MS_09*1(addResources=PilotType:1101|EquipmentIndex:0)
"""



[action_Produce_MS_09_MGSquad]
