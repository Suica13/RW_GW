[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory MS_14G:bool


[hiddenAction_Pannel_Close_MS_14G]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_14G=false




[hiddenAction_AutoProduce_MS_14G]
@copyFromSection:template_AutoProduce
@define UnitID=MS_14G
alsoTriggerAction:AutoProduce_MS_14G_Step2

[hiddenAction_AutoProduce_MS_14G_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2250
@define Resource=3050
alsoTriggerAction:AutoProduce_MS_14G_Random



[hiddenAction_AutoProduce_MS_14G_Random]
alsoTriggerAction:"""
AutoProduce_MS_14G_Random_A,
AutoProduce_MS_14G_Random_B,
AutoProduce_MS_14G_Random_C
"""
[hiddenAction_AutoProduce_MS_14G_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MS_14G_StandardSquad

[hiddenAction_AutoProduce_MS_14G_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_MS_14G_MGSquad

[hiddenAction_AutoProduce_MS_14G_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_MS_14G_BazookaSquad





[action_Pannel_MS_14G]
@copyFromSection:template_Pannel
@define UnitID=MS_14G
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)

[action_Produce_MS_14G_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MS_14G
@define Money=2250
@define Resource=2850
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:45s

text:BeamRifle
text_zh:光束步枪

alsoQueueAction:"""
Produce_MS_14G_StandardSquad_1
"""
[hiddenAction_Produce_MS_14G_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_14G*1(addResources=PilotType:1101|EquipmentIndex:0)
"""



