[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory YMS_15:bool


[hiddenAction_Pannel_Close_YMS_15]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:YMS_15=false




[hiddenAction_AutoProduce_YMS_15]
@copyFromSection:template_AutoProduce
@define UnitID=YMS_15
alsoTriggerAction:AutoProduce_YMS_15_Step2

[hiddenAction_AutoProduce_YMS_15_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1850
@define Resource=2350
alsoTriggerAction:AutoProduce_YMS_15_Random



[hiddenAction_AutoProduce_YMS_15_Random]
alsoTriggerAction:"""
AutoProduce_YMS_15_Random_A
"""
[hiddenAction_AutoProduce_YMS_15_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_YMS_15_StandardSquad



[action_Produce_YMS_15_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=YMS_15
@define Money=1850
@define Resource=2350
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:35s

alsoQueueAction:"""
Produce_YMS_15_StandardSquad_1
"""
[hiddenAction_Produce_YMS_15_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
YMS_15*1(addResources=PilotType:1101|EquipmentIndex:0)
"""

