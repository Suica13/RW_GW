@define UnitID=MS_14A
@define Money=3350
@define Resource=4500
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:55s

alsoQueueAction:"""
Produce_MS_14A_StandardSquad_1,
