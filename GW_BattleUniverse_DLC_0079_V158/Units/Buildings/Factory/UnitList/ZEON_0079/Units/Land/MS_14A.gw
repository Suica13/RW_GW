[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_14A:bool


[hiddenAction_Pannel_Close_MS_14A]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_14A=false



[hiddenAction_AutoProduce_MS_14A]
@copyFromSection:template_AutoProduce
@define UnitID=MS_14A
alsoTriggerAction:AutoProduce_MS_14A_Step2

[hiddenAction_AutoProduce_MS_14A_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2750
@define Resource=3300
alsoTriggerAction:AutoProduce_MS_14A_Random



[hiddenAction_AutoProduce_MS_14A_Random]
alsoTriggerAction:"""
AutoProduce_MS_14A_Random_A,
AutoProduce_MS_14A_Random_B
"""
[hiddenAction_AutoProduce_MS_14A_Random_A]
requireConditional:"""
if memory.randomProduce<500
"""
alsoQueueAction:Produce_MS_14A_StandardSquad

[hiddenAction_AutoProduce_MS_14A_Random_B]
requireConditional:"""
if memory.randomProduce>500
"""
alsoQueueAction:Produce_MS_14A_BazookaSquad




[action_Pannel_MS_14A]
