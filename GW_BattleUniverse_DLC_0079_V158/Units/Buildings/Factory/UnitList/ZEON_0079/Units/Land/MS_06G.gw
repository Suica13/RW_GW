[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_06G:bool


[hiddenAction_Pannel_Close_MS_06G]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_06G=false



[hiddenAction_AutoProduce_MS_06G]
@copyFromSection:template_AutoProduce
@define UnitID=MS_06G
alsoTriggerAction:AutoProduce_MS_06G_Step2

[hiddenAction_AutoProduce_MS_06G_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1500
@define Resource=2500
alsoTriggerAction:AutoProduce_MS_06G_Random



[hiddenAction_AutoProduce_MS_06G_Random]
alsoTriggerAction:"""
AutoProduce_MS_06G_Random_A,
AutoProduce_MS_06G_Random_B,
AutoProduce_MS_06G_Random_C
"""
[hiddenAction_AutoProduce_MS_06G_Random_A]
requireConditional:"""
if memory.randomProduce<500
"""
alsoQueueAction:Produce_MS_06G_StandardSquad

[hiddenAction_AutoProduce_MS_06G_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=800
"""
alsoQueueAction:Produce_MS_06G_BazookaSquad

[hiddenAction_AutoProduce_MS_06G_Random_C]
requireConditional:"""
if memory.randomProduce>800
"""
alsoQueueAction:Produce_MS_06G_AntiShipSquad




[action_Pannel_MS_06G]
@copyFromSection:template_Pannel
@define UnitID=MS_06G
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)


[action_Produce_MS_06G_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MS_06G
@define Money=1750
@define Resource=2750
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:60s

alsoQueueAction:"""
Produce_MS_06G_StandardSquad_1,
Produce_MS_06G_StandardSquad_2,
Produce_MS_06G_StandardSquad_3
"""
[hiddenAction_Produce_MS_06G_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_06G*1(addResources=PilotType:1001|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_06G_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MS_06G*1(addResources=PilotType:1001|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_06G_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
MS_06G*1(addResources=PilotType:1001|EquipmentIndex:0)
"""



