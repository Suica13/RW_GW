[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_06K:bool


[hiddenAction_Pannel_Close_MS_06K]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_06K=false



[hiddenAction_AutoProduce_MS_06K]
@copyFromSection:template_AutoProduce
@define UnitID=MS_06K
alsoTriggerAction:AutoProduce_MS_06K_Step2

[hiddenAction_AutoProduce_MS_06K_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1300
@define Resource=2250
alsoTriggerAction:AutoProduce_MS_06K_Random



[hiddenAction_AutoProduce_MS_06K_Random]
alsoTriggerAction:"""
AutoProduce_MS_06K_Random_A,
AutoProduce_MS_06K_Random_B
"""
[hiddenAction_AutoProduce_MS_06K_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MS_06K_StandardSquad

[hiddenAction_AutoProduce_MS_06K_Random_B]
requireConditional:"""
if memory.randomProduce>500 
"""
alsoQueueAction:Produce_MS_06K_BigGunSquad





[action_Pannel_MS_06K]
@copyFromSection:template_Pannel
@define UnitID=MS_06K
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)


[action_Produce_MS_06K_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MS_06K
@define Money=1300
@define Resource=2250
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:55s

alsoQueueAction:"""
Produce_MS_06K_StandardSquad_1,
Produce_MS_06K_StandardSquad_2,
Produce_MS_06K_StandardSquad_3
"""
[hiddenAction_Produce_MS_06K_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_06K*1(addResources=PilotType:1001|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_06K_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MS_06K*1(addResources=PilotType:1001|EquipmentIndex:0)
"""
