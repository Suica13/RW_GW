[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory MSM_07S:bool


[hiddenAction_Pannel_Close_MSM_07S]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MSM_07S=false




[hiddenAction_AutoProduce_MSM_07S]
@copyFromSection:template_AutoProduce
@define UnitID=MSM_07S
alsoTriggerAction:AutoProduce_MSM_07S_Step2

[hiddenAction_AutoProduce_MSM_07S_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=800
@define Resource=1450
alsoTriggerAction:AutoProduce_MSM_07S_Random



[hiddenAction_AutoProduce_MSM_07S_Random]
alsoTriggerAction:"""
AutoProduce_MSM_07S_Random_A
"""
[hiddenAction_AutoProduce_MSM_07S_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MSM_07S_StandardSquad




[action_Produce_MSM_07S_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=MSM_07S
@define Money=800
@define Resource=1450
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:35s

alsoQueueAction:"""
Produce_MSM_07S_StandardSquad_1
"""
[hiddenAction_Produce_MSM_07S_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
