shoot_flame:Beam_Fire_1_Yellow_S



[projectile_ZN_MAN_08_Funnel_BeamGun_Projectile]
directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Yellow*1
(
    addResources=
    BeamDamage:1250
    |DpDamage:45
    |WeaponAccuracy=85
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:55
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""



[hiddenAction_ZN_MAN_08_Funnel_BeamGun_Trigger]
alsoTriggerAction:"""
ZN_MAN_08_Funnel_BeamGun_Fire
"""
[hiddenAction_ZN_MAN_08_Funnel_BeamGun_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MAN_08_Funnel_BeamGun_CDTimer and memory.onAttacking==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:ZN_MAN_08_Funnel_BeamGun_CDTimer=self.timeAlive+${ZN_MAN_08_Funnel_BeamGun_CD}
addResources:EN=-${ZN_MAN_08_Funnel_BeamGun_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_MAN_08_Funnel_BeamGun_SetWeaponIndex,
ZN_MAN_08_Funnel_BeamGun_B1_Step_1
"""
[hiddenAction_ZN_MAN_08_Funnel_BeamGun_B1_Step_1]
setUnitMemory:"""
ZN_MAN_08_Funnel_BeamGun_CDTimer=self.timeAlive+${ZN_MAN_08_Funnel_BeamGun_CD}
"""

alsoQueueAction:"""
ZN_MAN_08_Funnel_BeamGun_Fire_Step_1,
ZN_MAN_08_Funnel_BeamGun_Fire_Step_Final
"""




[hiddenAction_ZN_MAN_08_Funnel_BeamGun_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MAN_08_Funnel_BeamGun_Fire_Step_1]
buildSpeed:0.25s
fireTurretXAtGround:ZN_MAN_08_Funnel_BeamGun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
whenBuilding_cannotMove:true
[hiddenAction_ZN_MAN_08_Funnel_BeamGun_Fire_Step_Final]
buildSpeed:0s
alsoTriggerAction:"""
SetAttackingOff
"""