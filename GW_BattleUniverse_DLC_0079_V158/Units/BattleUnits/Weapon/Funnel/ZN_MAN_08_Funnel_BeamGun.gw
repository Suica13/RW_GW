[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw
"""

@memory ZN_MAN_08_Funnel_BeamGun_CDTimer:float
@global ZN_MAN_08_Funnel_BeamGun_CD=2.5
@global ZN_MAN_08_Funnel_BeamGun_EN=25


[turret_ZN_MAN_08_Funnel_BeamGun]
x:0
y:0

canShoot:false
projectile:ZN_MAN_08_Funnel_BeamGun_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:0
barrelY:2
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
