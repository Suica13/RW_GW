pos:10
text:AA BeamCannon %{select(self.timeAlive<=memory.ZN_MA_08_AA_BeamCannon_CDTimer,str(int(memory.ZN_MA_08_AA_BeamCannon_CDTimer-self.timeAlive))+"s","OK")}
text_zh:对空光束炮 %{select(self.timeAlive<=memory.ZN_MA_08_AA_BeamCannon_CDTimer,str(int(memory.ZN_MA_08_AA_BeamCannon_CDTimer-self.timeAlive))+"秒","OK")}
text_KP:100

displayType:infoOnly

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true

iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
highPriorityQueue:true

price:EN=${ZN_MA_08_AA_BeamCannon_EN}

onlyOneUnitAtATime:true

isVisible:if self.parent.hp<=0  

isGuiBlinking:"""
if self.timeAlive>memory.ZN_MA_08_AA_BeamCannon_CDTimer
