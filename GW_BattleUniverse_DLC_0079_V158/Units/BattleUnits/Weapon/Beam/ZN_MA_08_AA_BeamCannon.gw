barrelX:45
barrelY:0
idleDir:45

[turret_ZN_MA_08_AA_BeamCannon_L3]
@copyFromSection:turret_ZN_MA_08_AA_BeamCannon
barrelX:-45
barrelY:0
idleDir:-45

[turret_ZN_MA_08_AA_BeamCannon_R4]
