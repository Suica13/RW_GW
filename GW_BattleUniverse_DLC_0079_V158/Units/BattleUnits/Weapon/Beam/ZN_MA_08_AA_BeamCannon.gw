#========炮弹========#

[projectile_ZN_MA_08_AA_BeamCannon_Projectile]
#炮弹参数
directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0
#描画参数
lightSize:0.75
lightColor:#ffd53d
explodeEffect:none
#生成
spawnUnit:"""
Projectile_AP_BeamRifle_Yellow_Alpha0*1
(
    addResources=
    BeamDamage:2500
    |DpDamage:65
    |WeaponAccuracy=100
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=1.0
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:135
    |ProjectileSpread:1
    |ProjectileLife:4

    |ProjectileAttackTimes:3
    |ProjectileAttackTimesDamageModifier:0.5

    |EquipmentIndex=2
    |EquipmentIndex2=600
    |SubEquipmentIndex=1
)
"""

#========特效========#

#========1========#

[attachment_ZN_MA_08_AA_BeamCannon_BulletEffect_1]
x:15
y:5
isVisible:true
keepAliveWhenParentDies:false
canBeAttackedAndDamaged:false
isUnselectable:true
canAttack:false
showAllActionsFrom:true
onConvertKeepExistingUnitInSameSlot:true
idleDir:5
resetRotationWhenNotAttacking:true

[hiddenAction_ZN_MA_08_AA_BeamCannon_BulletEffect_1_AwakeSet]
autoTriggerOnEvent:created
alsoTriggerAction:"""
ZN_MA_08_AA_BeamCannon_BulletEffect_1_StartSet
"""
attachments_addNewUnits:HighBeamRifle_1_EffectUnit
attachments_onlyOnSlots:ZN_MA_08_AA_BeamCannon_BulletEffect_1

[hiddenAction_ZN_MA_08_AA_BeamCannon_BulletEffect_1_StartSet]
setUnitMemory:ZN_MA_08_AA_BeamCannon_BulletEffect_1=self.attachment(slot='ZN_MA_08_AA_BeamCannon_BulletEffect_1')
alsoTriggerAction:"""
ZN_MA_08_AA_BeamCannon_BulletEffect_1_SetColor,
ZN_MA_08_AA_BeamCannon_BulletEffect_1_SetSpeed
"""

[hiddenAction_ZN_MA_08_AA_BeamCannon_BulletEffect_1_SetColor]
sendMessageTo:memory.ZN_MA_08_AA_BeamCannon_BulletEffect_1
sendMessageWithTags:SetColor_Yellow
[hiddenAction_ZN_MA_08_AA_BeamCannon_BulletEffect_1_SetSpeed]
sendMessageTo:memory.ZN_MA_08_AA_BeamCannon_BulletEffect_1
sendMessageWithTags:SetSpeed
sendMessageWithData:Speed=5

[hiddenAction_ZN_MA_08_AA_BeamCannon_Fire_Step_BulletEffect_1]
requireConditional:if ${cantAction}==false
buildSpeed:0s
sendMessageTo:memory.ZN_MA_08_AA_BeamCannon_BulletEffect_1
sendMessageWithTags:PlayOneTime

[hiddenAction_ZN_MA_08_AA_BeamCannon_BulletEffect_1_StopPlay]
buildSpeed:0s
sendMessageTo:memory.ZN_MA_08_AA_BeamCannon_BulletEffect_1
sendMessageWithTags:StopPlay


