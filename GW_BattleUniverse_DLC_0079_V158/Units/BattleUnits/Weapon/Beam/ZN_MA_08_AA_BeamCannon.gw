#====================炮塔====================#

#========炮塔========#

[turret_ZN_MA_08_AA_BeamCannon]
x:0
y:0
#射击参数
canShoot:false
projectile:ZN_MA_08_AA_BeamCannon_Projectile
#实战参数
delay:0.3s
canAttackMaxAngle:15
barrelX:12
barrelY:5
idleDir:5
limitingRange:0
#后座力参数
aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0
#音效参数
shoot_sound:none
shoot_sound_vol:0
shoot_flame:none
[turret_ZN_MA_08_AA_BeamCannon_L]
@copyFromSection:turret_ZN_MA_08_AA_BeamCannon
barrelX:-12
idleDir:-5

[turret_ZN_MA_08_AA_BeamCannon_R2]
@copyFromSection:turret_ZN_MA_08_AA_BeamCannon
barrelX:30
barrelY:5
idleDir:20

[turret_ZN_MA_08_AA_BeamCannon_L2]
@copyFromSection:turret_ZN_MA_08_AA_BeamCannon
barrelX:-30
barrelY:5
idleDir:-20


