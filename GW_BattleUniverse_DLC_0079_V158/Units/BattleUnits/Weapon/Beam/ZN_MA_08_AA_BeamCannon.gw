#设置武器
[hiddenAction_ZN_MA_08_AA_BeamCannon_SetWeaponIndex]
isVisible:false

#第一发与后续连发
[hiddenAction_ZN_MA_08_AA_BeamCannon_Fire_Step_1]
requireConditional:if ${cantAction}==false
buildSpeed:0.25s
whenBuilding_cannotMove:true
playSoundAtUnit:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCharge_4.ogg:2.0
[hiddenAction_ZN_MA_08_AA_BeamCannon_Fire_Step_2]
requireConditional:if ${cantAction}==false
buildSpeed:2.5s
whenBuilding_cannotMove:true
alsoTriggerAction:PlayCommon_Cannon_Shoot_A_Step_1
playSoundAtUnit:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamCannon_1.ogg:1.5
[hiddenAction_ZN_MA_08_AA_BeamCannon_Fire_Step_3]
requireConditional:if ${cantAction}==false
buildSpeed:0.1s
whenBuilding_cannotMove:true
fireTurretXAtGround:ZN_MA_08_AA_BeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000,dirOffset=5)
