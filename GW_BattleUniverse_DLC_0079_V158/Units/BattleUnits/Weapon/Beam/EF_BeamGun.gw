[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory EF_BeamGun_CDTimer:float
@global EF_BeamGun_CD=1.25
@global EF_BeamGun_EN=25





[decal_EF_BeamGun]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Beam\Image\EF_BeamGun.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.85
xOffsetRelative: 0
yOffsetRelative: 15
dirOffset:0
[decal_EF_BeamGun_NotUsing]
@copyFromSection:decal_EF_BeamGun
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.8
xOffsetRelative:-1
yOffsetRelative:-9
dirOffset:-90








[turret_EF_BeamGun]
x:0
y:0

canShoot:false
projectile:EF_BeamGun_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:8
barrelY:17.5
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamGun_1.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Pink



[projectile_EF_BeamGun_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Pink*1
(
    addResources=
    BeamDamage:3750
    |DpDamage:150
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |PartBreakModifier=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:80
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""





[hiddenAction_EF_BeamGun_Trigger]
alsoTriggerAction:EF_BeamGun_Fire
[hiddenAction_EF_BeamGun_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_BeamGun_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:EF_BeamGun_CDTimer=self.timeAlive+${EF_BeamGun_CD}
addResources:EN=-${EF_BeamGun_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_BeamGun_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
EF_BeamGun_B1_Step_1
"""
[hiddenAction_EF_BeamGun_B1_Step_1]
alsoQueueAction:"""
EF_BeamGun_Fire_Step_1,
EF_BeamGun_Fire_Step_2,
EF_BeamGun_Fire_Step_Final
"""



[hiddenAction_EF_BeamGun_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_BeamGun_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_EF_BeamGun_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_BeamGun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_BeamGun_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

