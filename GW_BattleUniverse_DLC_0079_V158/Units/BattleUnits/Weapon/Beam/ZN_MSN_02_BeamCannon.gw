[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Charge/Beam_Charge_3_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory ZN_MSN_02_BeamCannon_CDTimer:float
@global ZN_MSN_02_BeamCannon_CD=7
@global ZN_MSN_02_BeamCannon_EN=120



[turret_ZN_MSN_02_BeamCannon]
x:0
y:0

canShoot:false
projectile:ZN_MSN_02_BeamCannon_Projectile

delay:0.05s
canAttackMaxAngle:15
barrelX:9
barrelY:7
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCannon_11.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Charge_3_Yellow
[turret_ZN_MSN_02_BeamCannon_L]
@copyFromSection:turret_ZN_MSN_02_BeamCannon
barrelX:-9
shoot_sound_vol:0




[projectile_ZN_MSN_02_BeamCannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamCannon_Yellow*1
(
    addResources=
    BeamDamage:10000
    |BeamAPDamage:7500
    |DpDamage:250
    |WeaponAccuracy=75
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:55
    |ProjectileSpread:1
    |ProjectileExplosionRange:40
    |ProjectileLife:35

    |ProjectileBlastRange:60
    |ProjectileBlastDamageModifier:0.20
    |ProjectileBlastDpModifier:1
)
"""








[hiddenAction_ZN_MSN_02_BeamCannon_Trigger]
alsoTriggerAction:ZN_MSN_02_BeamCannon_Fire
[hiddenAction_ZN_MSN_02_BeamCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MSN_02_BeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:ZN_MSN_02_BeamCannon_CDTimer=self.timeAlive+${ZN_MSN_02_BeamCannon_CD}
addResources:EN=-${ZN_MSN_02_BeamCannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_MSN_02_BeamCannon_SetWeaponIndex,
PlayCommon_Cannon_Shoot_A_Step_1,
ZN_MSN_02_BeamCannon_B1_Step_1
"""
[hiddenAction_ZN_MSN_02_BeamCannon_B1_Step_1]
alsoQueueAction:"""
ZN_MSN_02_BeamCannon_Fire_Step_1,
ZN_MSN_02_BeamCannon_Fire_Step_2,
ZN_MSN_02_BeamCannon_Fire_Step_3,
ZN_MSN_02_BeamCannon_Fire_Step_Final
"""




[hiddenAction_ZN_MSN_02_BeamCannon_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MSN_02_BeamCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.45s
[hiddenAction_ZN_MSN_02_BeamCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_MSN_02_BeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MSN_02_BeamCannon_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.01s
fireTurretXAtGround:ZN_MSN_02_BeamCannon_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MSN_02_BeamCannon_Fire_Step_Final]
buildSpeed:0.45s
alsoTriggerAction:SetAttackingOff


