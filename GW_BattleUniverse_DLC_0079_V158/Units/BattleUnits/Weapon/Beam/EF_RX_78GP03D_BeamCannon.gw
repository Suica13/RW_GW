[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Charge/Beam_Charge_3_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory EF_RX_78GP03D_BeamCannon_CDTimer:float
@global EF_RX_78GP03D_BeamCannon_CD=9
@global EF_RX_78GP03D_BeamCannon_EN=100



[turret_EF_RX_78GP03D_BeamCannon]
x:0
y:0

canShoot:false
projectile:EF_RX_78GP03D_BeamCannon_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:38
barrelY:100
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCannon_11.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Charge_3_Yellow



[projectile_EF_RX_78GP03D_BeamCannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_HighBeamCannon_Yellow*1
(
    addResources=
    BeamDamage:24000
    |BeamAPDamage:8000
    |DpDamage:900
    |WeaponAccuracy=75
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:55
    |ProjectileSpread:1
    |ProjectileExplosionRange:45
    |ProjectileLife:25

    |ProjectileAttackTimes:7
    |ProjectileAttackTimesDamageModifier:0.75

    |EquipmentIndex=2
    |EquipmentIndex2=750
),
Projectile_HighBeamCannon_Yellow_Effect*1
(
    addResources=
    ProjectileSpeed:0.75
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""








[hiddenAction_EF_RX_78GP03D_BeamCannon_Trigger]
alsoTriggerAction:EF_RX_78GP03D_BeamCannon_Fire
[hiddenAction_EF_RX_78GP03D_BeamCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RX_78GP03D_BeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:EF_RX_78GP03D_BeamCannon_CDTimer=self.timeAlive+${EF_RX_78GP03D_BeamCannon_CD}
addResources:EN=-${EF_RX_78GP03D_BeamCannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RX_78GP03D_BeamCannon_SetWeaponIndex,
PlayCommon_Cannon_Shoot_A_Step_1,
EF_RX_78GP03D_BeamCannon_B1_Step_1
"""
[hiddenAction_EF_RX_78GP03D_BeamCannon_B1_Step_1]
alsoQueueAction:"""
EF_RX_78GP03D_BeamCannon_Fire_Step_1,
EF_RX_78GP03D_BeamCannon_Fire_Step_2,
EF_RX_78GP03D_BeamCannon_Fire_Step_Final
"""




[hiddenAction_EF_RX_78GP03D_BeamCannon_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RX_78GP03D_BeamCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_EF_RX_78GP03D_BeamCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RX_78GP03D_BeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_RX_78GP03D_BeamCannon_Fire_Step_Final]
buildSpeed:0.35s
alsoTriggerAction:SetAttackingOff


