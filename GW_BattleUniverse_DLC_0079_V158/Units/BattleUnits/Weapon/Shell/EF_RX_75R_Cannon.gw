[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw
"""

@memory EF_RX_75R_Cannon_OnCD:bool
@memory EF_RX_75R_Cannon_CDTimer:float
@global EF_RX_75R_Cannon_CD=7
@global EF_RX_75R_Cannon_EN=35

@global EF_RX_75R_Cannon_Shoot=2
[resource_EF_RX_75R_Cannon_ShootTimer]
hidden:true






[turret_EF_RX_75R_Cannon]
x:0
y:0

canShoot:true
canOnlyAttackUnitsWithoutTags:AirUnit
onShoot_triggerActions:SendEnemyTryAttack_Shoot
canAttackCondition:"""
if ${onAttacking}==false and ${cantAction}==false and self.speed<0.2 and distanceBetween(self,self.attacking)>60 and ${onSkill}==false 
"""
showRangeUIGuide:false
projectile:EF_RX_75R_Cannon_Projectile
resourceUsage:EF_RX_75R_Cannon_ShootTimer=1,en=${EF_RX_75R_Cannon_EN}


delay:0.0s
canAttackMaxAngle:5
barrelX:4
barrelOffsetX_onOddShots:-8
barrelY:20
turnSpeed:1.0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0


shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\ShellCannon_1.ogg
shoot_sound_vol:0.6
shoot_flame:BZ_Fire_1

[turret_EF_RX_75R_Cannon_Fake]
x:0
y:0

canShoot:false
canAttackCondition:"""
if ${onAttacking}==false and ${cantAction}==false
"""
showRangeUIGuide:false
projectile:EF_RX_75R_Cannon_Projectile

delay:0.0s
canAttackMaxAngle:5
barrelX:4
barrelOffsetX_onOddShots:-8
barrelY:20
turnSpeed:1.0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\ShellCannon_1.ogg
shoot_sound_vol:0.6
shoot_flame:BZ_Fire_1



[projectile_EF_RX_75R_Cannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Mortar*1
(
    addResources=
    ShellDamage:3000
    |DpDamage:200
    |WeaponAccuracy=75
    |PartBreakModifier=0.5
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |AntiAqua=0.75
    |AntiAir=0.5 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=0.5
    |HeightHitRange=10
    |ProjectileSpeed:25
    |ProjectileSpread:0
    |ProjectileExplosionRange:30
    |ProjectileLife:50
    
    |ProjectileBlastRange:60
    |ProjectileBlastDamageModifier:0.35
    |ProjectileBlastDpModifier:1
)
"""



[hiddenAction_EF_RX_75R_Cannon_CDStart]
autoTrigger:"""
if memory.EF_RX_75R_Cannon_OnCD==false 
and 
(
    (
        self.resource.EF_RX_75R_Cannon_ShootTimer<=0 
    ) 
    or 
    (
        self.resource.EF_RX_75R_Cannon_ShootTimer<${EF_RX_75R_Cannon_Shoot} and not self.hasTags(includes='inBattle')
    )
)
"""
setUnitMemory:EF_RX_75R_Cannon_OnCD=true,EF_RX_75R_Cannon_CDTimer=self.timeAlive+${EF_RX_75R_Cannon_CD}

[hiddenAction_EF_RX_75R_Cannon_CDEnd]
autoTriggerOnEvent:created
autoTrigger:if memory.EF_RX_75R_Cannon_OnCD==true and self.timeAlive>memory.EF_RX_75R_Cannon_CDTimer
setUnitMemory:EF_RX_75R_Cannon_OnCD=false
setResourcesWithLogic:EF_RX_75R_Cannon_ShootTimer=${EF_RX_75R_Cannon_Shoot}
