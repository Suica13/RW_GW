[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/Railgun_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_Two_Handed_A.gw
"""


@memory EF_Railgun_79_D_RG_CDTimer:float
@global EF_Railgun_79_D_RG_CD=9
@global EF_Railgun_79_D_RG_EN=45





[decal_EF_Railgun_79_D_RG]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\EF_Railgun_79_D.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.85
xOffsetRelative: 0
yOffsetRelative: 12
dirOffset:0
[decal_EF_Railgun_79_D_RG_NotUsing]
@copyFromSection:decal_EF_Railgun_79_D_RG
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.75
xOffsetRelative:2
yOffsetRelative:-8.5
dirOffset:-90







[turret_EF_Railgun_79_D_RG]
x:0
y:0

canShoot:false
projectile:EF_Railgun_79_D_RG_Projectile

delay:0.125s
limitingRange:0

canAttackMaxAngle:15
barrelX:8
barrelY:24

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/Railgun_1.ogg
shoot_sound_vol:0.85
shoot_flame:Railgun_Fire_1



[projectile_EF_Railgun_79_D_RG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_RailShell*1
(
    addResources=
    ShellAPDamage:5000
    |ShellDamage:5000
    |DpDamage:250
    |WeaponAccuracy=85
    |PartBreakModifier=0.75
    |CockpitBreakModifier=1.25
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=1 
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=0.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:80
    |ProjectileSpread:1
    |ProjectileExplosionRange:30
    |ProjectileLife:25
)
"""






[hiddenAction_EF_Railgun_79_D_RG_Trigger]
alsoTriggerAction:EF_Railgun_79_D_RG_Fire
[hiddenAction_EF_Railgun_79_D_RG_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_Railgun_79_D_RG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_Railgun_79_D_RG_CDTimer=self.timeAlive+${EF_Railgun_79_D_RG_CD}
addResources:EN=-${EF_Railgun_79_D_RG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
PlayCommon_Shoot_Two_Handed_A_Step_1,
EF_Railgun_79_D_RG_SetWeaponIndex,
EF_Railgun_79_D_RG_B1_Step_1
"""
[hiddenAction_EF_Railgun_79_D_RG_B1_Step_1]
alsoQueueAction:"""
EF_Railgun_79_D_RG_Fire_Step_1,
EF_Railgun_79_D_RG_Fire_Step_2,
EF_Railgun_79_D_RG_Fire_Step_Final
"""





[hiddenAction_EF_Railgun_79_D_RG_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_Railgun_79_D_RG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_EF_Railgun_79_D_RG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_Railgun_79_D_RG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_Railgun_79_D_RG_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


