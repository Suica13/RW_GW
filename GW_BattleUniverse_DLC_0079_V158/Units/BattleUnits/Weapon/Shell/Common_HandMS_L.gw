[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""


@memory Common_HandMS_L_CDTimer:float
@global Common_HandMS_L_CD=5
@global Common_HandMS_L_EN=25











[turret_Common_HandMS_L]
x:0
y:0

canShoot:false
projectile:Common_HandMS_L_Projectile

delay:0.15s
limitingRange:0

canAttackMaxAngle:15
barrelX:16
barrelY:12

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1_S



[projectile_Common_HandMS_L_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS*1
(
    addResources=
    ShellDamage:1750
    |DpDamage:50
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=0.75
    |AntiAir=1.5
    |AntiLand=1
    |AntiSpace=1.0
    |HeightHitRange=20
    |HeightChangeSpeed=2
    |ProjectileSpeed:40
    |ProjectileTurnspeed:1.5
    |ProjectileSpread:0
    |ProjectileExplosionRange:40
    |ProjectileLife:40
)
"""






[hiddenAction_Common_HandMS_L_Trigger]
alsoTriggerAction:Common_HandMS_L_Fire
[hiddenAction_Common_HandMS_L_Fire]
requireConditional:"""
if self.timeAlive>memory.Common_HandMS_L_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:Common_HandMS_L_CDTimer=self.timeAlive+${Common_HandMS_L_CD}
addResources:EN=-${Common_HandMS_L_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
Common_HandMS_L_SetWeaponIndex,
Common_HandMS_L_B3_Step_1
"""
[hiddenAction_Common_HandMS_L_B3_Step_1]
alsoQueueAction:"""
Common_HandMS_L_Fire_Step_1,
Common_HandMS_L_Fire_Step_2,
Common_HandMS_L_Fire_Step_3,
Common_HandMS_L_Fire_Step_3,
Common_HandMS_L_Fire_Step_Final
"""





[hiddenAction_Common_HandMS_L_SetWeaponIndex]
isVisible:false


[hiddenAction_Common_HandMS_L_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_Common_HandMS_L_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:Common_HandMS_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_L_Step_1
[hiddenAction_Common_HandMS_L_Fire_Step_3]
@copyFromSection:hiddenAction_Common_HandMS_L_Fire_Step_2
buildSpeed:${turret_Common_HandMS_L.delay}
[hiddenAction_Common_HandMS_L_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


