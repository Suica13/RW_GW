[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw
"""


@memory Common_DoubleVulcan_SFU_X79_OnCD:bool
@memory Common_DoubleVulcan_SFU_X79_CDTimer:float
@global Common_DoubleVulcan_SFU_X79_CD=3

@global Common_DoubleVulcan_SFU_X79_Shoot=10
[resource_Common_DoubleVulcan_SFU_X79_ShootTimer]
hidden:true








[turret_Common_DoubleVulcan_SFU_X79]
x:0
y:0

canShoot:true
canAttackCondition:"""
if ${cantAction}==false 
"""
showRangeUIGuide:false
canOnlyAttackUnitsWithTags:CanBeTargetUnitFly
resourceUsage:Common_DoubleVulcan_SFU_X79_ShootTimer=1
projectile:Common_DoubleVulcan_SFU_X79_Projectile

delay:0.075s
limitingRange:1200
limitingAngle:3

canAttackMaxAngle:15
barrelX:28
barrelY:2
barrelOffsetX_onOddShots:-56

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/Vulcan_1.ogg
shoot_sound_vol:0.15
shoot_flame:MG_Fire_1_S



[projectile_Common_DoubleVulcan_SFU_X79_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Vulcan*1
(
    addResources=
    ShellDamage:100
    |DpDamage:10
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=25
    |ProjectileSpeed:75
    |ProjectileSpread:6
    |ProjectileLife:20
)
"""


[hiddenAction_Common_DoubleVulcan_SFU_X79_CDStart]
autoTrigger:"""
if memory.Common_DoubleVulcan_SFU_X79_OnCD==false 
and 
(
    (
        self.resource.Common_DoubleVulcan_SFU_X79_ShootTimer<=0 
    ) 
    or 
    (
        self.resource.Common_DoubleVulcan_SFU_X79_ShootTimer<${Common_DoubleVulcan_SFU_X79_Shoot} and not self.hasTags(includes='inBattle')
    )
)
"""
setUnitMemory:Common_DoubleVulcan_SFU_X79_OnCD=true,Common_DoubleVulcan_SFU_X79_CDTimer=self.timeAlive+${Common_DoubleVulcan_SFU_X79_CD}

[hiddenAction_Common_DoubleVulcan_SFU_X79_CDEnd]
autoTriggerOnEvent:created
autoTrigger:if memory.Common_DoubleVulcan_SFU_X79_OnCD==true and self.timeAlive>memory.Common_DoubleVulcan_SFU_X79_CDTimer
setUnitMemory:Common_DoubleVulcan_SFU_X79_OnCD=false
setResourcesWithLogic:Common_DoubleVulcan_SFU_X79_ShootTimer=${Common_DoubleVulcan_SFU_X79_Shoot}
