[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""


@memory ZN_MAM_07_AMS_CDTimer:float
@global ZN_MAM_07_AMS_CD=12
@global ZN_MAM_07_AMS_EN=35








[turret_ZN_MAM_07_AMS]
x:0
y:0

canShoot:false
projectile:ZN_MAM_07_AMS_Projectile

delay:0.15s
limitingRange:0

canAttackMaxAngle:15
barrelX:12
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.15
shoot_flame:BZ_Fire_1_S
[turret_ZN_MAM_07_AMS_L]
@copyFromSection:turret_ZN_MAM_07_AMS
barrelX:-12



[projectile_ZN_MAM_07_AMS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS*1
(
    addResources=
    ShellDamage:900
    |DpDamage:80
    |WeaponAccuracy=90
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=2
    |AntiAir=0.5 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=10
    |ProjectileSpeed:40
    |ProjectileTurnspeed:1.25
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:40
)
"""







[hiddenAction_ZN_MAM_07_AMS_Trigger]
alsoTriggerAction:ZN_MAM_07_AMS_Fire
[hiddenAction_ZN_MAM_07_AMS_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MAM_07_AMS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:ZN_MAM_07_AMS_CDTimer=self.timeAlive+${ZN_MAM_07_AMS_CD}
addResources:EN=-${ZN_MAM_07_AMS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_MAM_07_AMS_SetWeaponIndex,
ZN_MAM_07_AMS_B8_Step_1,
PlayCommon_Cannon_Shoot_A_Step_1
"""
[hiddenAction_ZN_MAM_07_AMS_B8_Step_1]
alsoQueueAction:"""
ZN_MAM_07_AMS_Fire_Step_1,
ZN_MAM_07_AMS_Fire_Step_2,
ZN_MAM_07_AMS_Fire_Step_3,
ZN_MAM_07_AMS_Fire_Step_2,
ZN_MAM_07_AMS_Fire_Step_3,
ZN_MAM_07_AMS_Fire_Step_2,
ZN_MAM_07_AMS_Fire_Step_3,
ZN_MAM_07_AMS_Fire_Step_2,
ZN_MAM_07_AMS_Fire_Step_3,
ZN_MAM_07_AMS_Fire_Step_Final
"""





[hiddenAction_ZN_MAM_07_AMS_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MAM_07_AMS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_ZN_MAM_07_AMS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false
"""
buildSpeed:0.05s
fireTurretXAtGround:ZN_MAM_07_AMS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MAM_07_AMS_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false
"""
buildSpeed:0s
fireTurretXAtGround:ZN_MAM_07_AMS_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MAM_07_AMS_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff


