[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw
"""


@memory Common_DoubleVulcan_FF_B2_CDTimer:float
@global Common_DoubleVulcan_FF_B2_CD=2.5
@global Common_DoubleVulcan_FF_B2_EN=5





[turret_Common_DoubleVulcan_FF_B2]
x:0
y:0

canShoot:false
showRangeUIGuide:false
projectile:Common_DoubleVulcan_FF_B2_Projectile

delay:0.125s
limitingRange:1200
limitingAngle:15

canAttackMaxAngle:15
barrelX:1
barrelY:20

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_1.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1
[turret_Common_DoubleVulcan_FF_B2_L]
@copyFromSection:turret_Common_DoubleVulcan_FF_B2
barrelX:-2



[projectile_Common_DoubleVulcan_FF_B2_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:300
    |DpDamage:20
    |WeaponAccuracy=85
    |PartBreakModifier=1.0
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1 
    |HeightChangeSpeed=2.0
    |HeightHitRange=25
    |ProjectileSpeed:100
    |ProjectileSpread:6
    |ProjectileLife:8
)
"""


[hiddenAction_Common_DoubleVulcan_FF_B2_Trigger]
alsoTriggerAction:Common_DoubleVulcan_FF_B2_Fire
[hiddenAction_Common_DoubleVulcan_FF_B2_Fire]
requireConditional:"""
if self.timeAlive>memory.Common_DoubleVulcan_FF_B2_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:Common_DoubleVulcan_FF_B2_CDTimer=self.timeAlive+${Common_DoubleVulcan_FF_B2_CD} 
addResources:EN=-${Common_DoubleVulcan_FF_B2_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
Common_DoubleVulcan_FF_B2_SetWeaponIndex,
Common_DoubleVulcan_FF_B2_B6_Step_1
"""
[hiddenAction_Common_DoubleVulcan_FF_B2_B6_Step_1]
alsoQueueAction:"""
Common_DoubleVulcan_FF_B2_Fire_Step_1,
Common_DoubleVulcan_FF_B2_Fire_Step_2,
Common_DoubleVulcan_FF_B2_Fire_Step_3,
Common_DoubleVulcan_FF_B2_Fire_Step_4,
Common_DoubleVulcan_FF_B2_Fire_Step_3,
Common_DoubleVulcan_FF_B2_Fire_Step_4,
Common_DoubleVulcan_FF_B2_Fire_Step_3,
Common_DoubleVulcan_FF_B2_Fire_Step_Final
"""




[hiddenAction_Common_DoubleVulcan_FF_B2_SetWeaponIndex]
isVisible:false


[hiddenAction_Common_DoubleVulcan_FF_B2_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
[hiddenAction_Common_DoubleVulcan_FF_B2_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:Common_DoubleVulcan_FF_B2
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_Common_DoubleVulcan_FF_B2_Fire_Step_3]
@copyFromSection:hiddenAction_Common_DoubleVulcan_FF_B2_Fire_Step_2
buildSpeed:${turret_Common_DoubleVulcan_FF_B2.delay}
[hiddenAction_Common_DoubleVulcan_FF_B2_Fire_Step_4]
@copyFromSection:hiddenAction_Common_DoubleVulcan_FF_B2_Fire_Step_3
