[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw
"""


@memory EF_AMS_Squad_AMS_CDTimer:float
@global EF_AMS_Squad_AMS_CD=8
@global EF_AMS_Squad_AMS_EN=75








[turret_EF_AMS_Squad_AMS]
x:0
y:0

canShoot:false
projectile:EF_AMS_Squad_AMS_Projectile

delay:0.3s
limitingRange:0

canAttackMaxAngle:15
barrelX:0
barrelY:5

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_EF_AMS_Squad_AMS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS_L_AMS*1
(
    addResources=
    |ShellDamage:3500
    |ShellAPDamage:3500
    |DpDamage:350
    |WeaponAccuracy=75
    |PartBreakModifier=0.1
    |CockpitBreakModifier=2.5
    |PilotDamageModifier=2.5
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:25
    |ProjectileTurnspeed:0.05
    |ProjectileSpread:0
    |ProjectileExplosionRange:40
    |ProjectileLife:45
)
"""








[hiddenAction_EF_AMS_Squad_AMS_Trigger]
alsoTriggerAction:EF_AMS_Squad_AMS_Fire
[hiddenAction_EF_AMS_Squad_AMS_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_AMS_Squad_AMS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:EF_AMS_Squad_AMS_CDTimer=self.timeAlive+${EF_AMS_Squad_AMS_CD}
addResources:EN=-${EF_AMS_Squad_AMS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_AMS_Squad_AMS_SetWeaponIndex,
EF_AMS_Squad_AMS_B1_Step_1
"""
[hiddenAction_EF_AMS_Squad_AMS_B1_Step_1]
alsoQueueAction:"""
EF_AMS_Squad_AMS_Fire_Step_1,
EF_AMS_Squad_AMS_Fire_Step_2,
EF_AMS_Squad_AMS_Fire_Step_Final
"""





[hiddenAction_EF_AMS_Squad_AMS_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_AMS_Squad_AMS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_EF_AMS_Squad_AMS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_AMS_Squad_AMS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_AMS_Squad_AMS_Fire_Step_3]
@copyFromSection:hiddenAction_EF_AMS_Squad_AMS_Fire_Step_2
buildSpeed:${turret_EF_AMS_Squad_AMS.delay}
[hiddenAction_EF_AMS_Squad_AMS_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


