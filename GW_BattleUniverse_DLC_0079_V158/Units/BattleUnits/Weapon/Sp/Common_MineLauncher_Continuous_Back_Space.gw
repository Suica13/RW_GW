[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory Common_MineLauncher_Continuous_Back_Space_CDTimer:float
@global Common_MineLauncher_Continuous_Back_Space_CD=180
@global Common_MineLauncher_Continuous_Back_Space_EN=150


[turret_Common_MineLauncher_Continuous_Back_Space]
x:0
y:0

canShoot:false
projectile:Common_MineLauncher_Continuous_Back_Space_Projectile

delay:0.2s
canAttackMaxAngle:15
limitingAngle:0
limitingRange:1200
barrelX:0
barrelY:-5
idleDir:-180

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/Bomb_1.ogg
shoot_sound_vol:0.5
shoot_flame:BZ_Fire_1_S




[projectile_Common_MineLauncher_Continuous_Back_Space_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Mine_1*1
(
    offsetRandomDir=35,
    addResources=
    ShellDamage:4000
    |DpDamage:400
    |WeaponAccuracy=50
    |PartBreakModifier=1
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=1.0
    |AntiAir=1.0
    |AntiLand=1.0
    |AntiSpace=1.0
    |AntiSizeLargeDamage=0.5
    |AntiSizeSmallDamage=0.5
    |AntiSizeLargeAccuracy=0.5
    |AntiSizeSmallAccuracy=0.5
    |AntiBuilding=0.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:0.5
    |ProjectileSpread:0
    |ProjectileExplosionRange:50
    |ProjectileLife:900

    |ProjectileBlastRange:60
    |ProjectileBlastDamageModifier:0.20
    |ProjectileBlastDpModifier:1
)
"""



[action_Common_MineLauncher_Continuous_Back_Space_Trigger]
pos:10
text:MineLauncher[Back] %{select(self.timeAlive<=memory.Common_MineLauncher_Continuous_Back_Space_CDTimer,str(int(memory.Common_MineLauncher_Continuous_Back_Space_CDTimer-self.timeAlive))+"s","OK")}
text_zh:地雷部署器[后方] %{select(self.timeAlive<=memory.Common_MineLauncher_Continuous_Back_Space_CDTimer,str(int(memory.Common_MineLauncher_Continuous_Back_Space_CDTimer-self.timeAlive))+"秒","OK")}
text_KP:100

description:Set Up Mine 12 times
description_zh:持续设置12枚地雷,期间无法攻击

displayType:infoOnly

price:EN=${Common_MineLauncher_Continuous_Back_Space_EN}

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true
ai_isDisabled:true

iconImage:ROOT:Resource/Image/Units/Button/Weapon/Grenade_3.png
highPriorityQueue:true

isVisible:if self.parent.hp<=0 
isGuiBlinking:"""
if self.timeAlive>memory.Common_MineLauncher_Continuous_Back_Space_CDTimer 
and ${cantAction}==false 
and ${onSkill}==false
"""

isLocked:if self.timeAlive<=memory.Common_MineLauncher_Continuous_Back_Space_CDTimer
isLockedMessage:In CD
isLockedMessage_zh:冷却中
isLockedAlt2:if ${cantAction}==true or ${onSkill}==true
isLockedAlt2Message:Cant Action
isLockedAlt2Message_zh:无法行动

alsoTriggerAction:"""
SetOnSkillOn,
Common_MineLauncher_Continuous_Back_Space_SetWeaponIndex,
Common_MineLauncher_Continuous_Back_Space_B12_Step_1,
PlayCommon_Cannon_Shoot_A_Step_1
"""
[hiddenAction_Common_MineLauncher_Continuous_Back_Space_B12_Step_1]
setUnitMemory:"""
Common_MineLauncher_Continuous_Back_Space_CDTimer=self.timeAlive+${Common_MineLauncher_Continuous_Back_Space_CD}
"""

alsoQueueAction:"""
Common_MineLauncher_Continuous_Back_Space_Fire_Step_1,
Common_MineLauncher_Continuous_Back_Space_Fire_Step_2,
Common_MineLauncher_Continuous_Back_Space_Fire_Step_2,
Common_MineLauncher_Continuous_Back_Space_Fire_Step_2,
Common_MineLauncher_Continuous_Back_Space_Fire_Step_2,
Common_MineLauncher_Continuous_Back_Space_Fire_Step_2,
Common_MineLauncher_Continuous_Back_Space_Fire_Step_2,
Common_MineLauncher_Continuous_Back_Space_Fire_Step_2,
Common_MineLauncher_Continuous_Back_Space_Fire_Step_2,
Common_MineLauncher_Continuous_Back_Space_Fire_Step_2,
Common_MineLauncher_Continuous_Back_Space_Fire_Step_2,
Common_MineLauncher_Continuous_Back_Space_Fire_Step_2,
Common_MineLauncher_Continuous_Back_Space_Fire_Step_Final
"""




[hiddenAction_Common_MineLauncher_Continuous_Back_Space_SetWeaponIndex]
isVisible:false


[hiddenAction_Common_MineLauncher_Continuous_Back_Space_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.5s
fireTurretXAtGround:Common_MineLauncher_Continuous_Back_Space
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=-10)

[hiddenAction_Common_MineLauncher_Continuous_Back_Space_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:1s
fireTurretXAtGround:Common_MineLauncher_Continuous_Back_Space
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=-10)

[hiddenAction_Common_MineLauncher_Continuous_Back_Space_Fire_Step_Final]
buildSpeed:0s
alsoTriggerAction:"""
SetOnSkillOff
"""