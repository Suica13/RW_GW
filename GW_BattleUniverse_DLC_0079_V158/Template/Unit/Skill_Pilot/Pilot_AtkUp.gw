[core]
dont_load:true
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Flash_1.gw
"""

@memory Pilot_AtkUp_Active:bool
@memory Pilot_AtkUp_ActiveTimer:float
@global Pilot_AtkUp_ActiveTime:15
@memory Pilot_AtkUp_CDTimer:float
@global Pilot_AtkUp_CD=90

@memory Pilot_AtkUp_Atk:float
@global Pilot_AtkUp_AtkUp:1.20





[hiddenAction_Pilot_AtkUp_Check]
autoTrigger:true
setUnitMemory:"""
Pilot_AtkUp_Atk=select(memory.Pilot_AtkUp_Active==true,${Pilot_AtkUp_AtkUp},1)
"""

[hiddenAction_Check_UnitBuffRule_AtkShoot]
setUnitMemory:pilotBuffRuleAtkShootModifier=1*memory.Pilot_AtkUp_Atk
[hiddenAction_Check_UnitBuffRule_AtkCqb]
setUnitMemory:pilotBuffRuleAtkCqbModifier=1*memory.Pilot_AtkUp_Atk

[action_Pilot_AtkUp_Trigger]
pos:10
text:"""
DamageUp 
%{
    select(memory.Pilot_AtkUp_Active==true,
    str(int(memory.Pilot_AtkUp_ActiveTimer-self.timeAlive))+"s",
    select(self.timeAlive<=memory.Pilot_AtkUp_CDTimer,"CD:" + str(int(memory.Pilot_AtkUp_CDTimer-self.timeAlive))+"s","OK"))
}
"""
text_zh:"""
伤害上升 
%{
    select(memory.Pilot_AtkUp_Active==true,
    str(int(memory.Pilot_AtkUp_ActiveTimer-self.timeAlive))+"秒",
    select(self.timeAlive<=memory.Pilot_AtkUp_CDTimer,"冷却中:" + str(int(memory.Pilot_AtkUp_CDTimer-self.timeAlive))+"秒","OK"))
}
"""
text_KP:100

description:Damage Up 15% in 25sec
description_zh:15秒内伤害提高20%

displayType:infoOnly

price:EN=100

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true
highPriorityQueue:true
ai_isDisabled:true

iconImage:ROOT:Resource/Image/Units/Button/Skill/Pilot_AtkUp_Cqb.png

isVisible:if not self.hasTags(includes='inHangar')



isGuiBlinking:"""
if self.timeAlive>memory.Pilot_AtkUp_CDTimer and memory.Pilot_AtkUp_Active==false
"""

isLocked:if self.timeAlive<=memory.Pilot_AtkUp_CDTimer
isLockedMessage:In CD
isLockedMessage_zh:冷却中
isLockedAlt:if memory.Pilot_AtkUp_Active==true
isLockedAltMessage:In Action
isLockedAltMessage_zh:行动中

alsoTriggerAction:"""
Pilot_AtkUp_Step_1
"""
[hiddenAction_Pilot_AtkUp_Step_1]
spawnEffects:Flash_1_N
playSoundAtUnit:ROOT:Resource/Sound/SE/Action/Common/Action_8.ogg:0.5

setUnitMemory:"""
Pilot_AtkUp_Active=true,
Pilot_AtkUp_ActiveTimer=self.timeAlive+${Pilot_AtkUp_ActiveTime}
"""

[hiddenAction_Pilot_AtkUp_CheckOver]
autoTrigger:"""
if memory.Pilot_AtkUp_Active==true 
and self.timeAlive>memory.Pilot_AtkUp_ActiveTimer
"""
setUnitMemory:"""
Pilot_AtkUp_Active=false,
Pilot_AtkUp_CDTimer=self.timeAlive+${Pilot_AtkUp_CD}
"""