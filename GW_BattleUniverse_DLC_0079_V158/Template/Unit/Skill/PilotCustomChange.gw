[core]
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Light_1.gw
"""
dont_load:false


[template_Start_PilotCustomChange_ToUnit]
removeAllQueuedItemsWithoutRefund:true
convertTo_keepCurrentTags:false
convertTo_keepCurrentFields:"""
selfRegenRate,
shieldRegen,
maxEnergy,
armour,
mass,
movespeed,
maxTurnSpeed,
maxAttackRange,
nanoRange,
fogOfWarSightRange,
nanoFactorySpeed,
targetHeight
"""
whenBuilding_triggerAction:SetAttackingOff
alsoTriggerAction:Send_TryClearQueued,Send_TryTransform_PilotCustomChange,Send_TryTransform_PilotCustomChange_Step2,Send_TryTransform_PilotCustomChange_Step3

[hiddenAction_Send_TryTransform_PilotCustomChange]
@copyFromSection:hiddenAction_Send_TryTransform
sendMessageWithData:"""
RecoverHp=0,
RecoverHpPer=0.25,
RecoverShield=0,
RecoverShieldPer=0.25,
RecoverEn=0,
RecoverEnPer=1,
ResetTags=1
"""

[hiddenAction_Send_TryTransform_PilotCustomChange_Step2]
sendMessageTo:memory.battleUnitCore
sendMessageWithTags:PilotCustomChange

[hiddenAction_Send_TryTransform_PilotCustomChange_Step3]
setUnitMemory:changePilotSkillsBool=false