[core]
dont_load:true
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Flash_1.gw
"""

@memory Pilot_LeaderShipUp_Active:bool
@memory Pilot_LeaderShipUp_ActiveTimer:float
@global Pilot_LeaderShipUp_ActiveTime:15
@memory Pilot_LeaderShipUp_CDTimer:float
@global Pilot_LeaderShipUp_CD=90

@memory Pilot_LeaderShipUp_LeaderShip:float
@global Pilot_LeaderShipUp_LeaderShipUp:2.0





[hiddenAction_Pilot_LeaderShipUp_Check]
autoTrigger:true
setUnitMemory:"""
Pilot_LeaderShipUp_LeaderShip=select(memory.Pilot_LeaderShipUp_Active==true,${Pilot_LeaderShipUp_LeaderShipUp},1)
"""

[hiddenAction_Check_UnitBuffRule_Leadership]
setUnitMemory:pilotBuffRuleLeaderShipModifier=1*memory.Pilot_LeaderShipUp_LeaderShip

[action_Pilot_LeaderShipUp_Trigger]
pos:10
text:"""
LeaderShipUp 
%{
    select(memory.Pilot_LeaderShipUp_Active==true,
    str(int(memory.Pilot_LeaderShipUp_ActiveTimer-self.timeAlive))+"s",
    select(self.timeAlive<=memory.Pilot_LeaderShipUp_CDTimer,"CD:" + str(int(memory.Pilot_LeaderShipUp_CDTimer-self.timeAlive))+"s","OK"))
}
"""
text_zh:"""
领导力上升 
%{
    select(memory.Pilot_LeaderShipUp_Active==true,
    str(int(memory.Pilot_LeaderShipUp_ActiveTimer-self.timeAlive))+"秒",
    select(self.timeAlive<=memory.Pilot_LeaderShipUp_CDTimer,"冷却中:" + str(int(memory.Pilot_LeaderShipUp_CDTimer-self.timeAlive))+"秒","OK"))
}
"""
text_KP:100

description:LeaderShip Up 100% in 15sec
description_zh:15秒内领导力提高100%

displayType:infoOnly

price:EN=100

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true
highPriorityQueue:true
ai_isDisabled:true

iconImage:ROOT:Resource/Image/Units/Button/Skill/Pilot_LeaderShipUp.png

isVisible:if not self.hasTags(includes='inHangar')



isGuiBlinking:"""
if self.timeAlive>memory.Pilot_LeaderShipUp_CDTimer and memory.Pilot_LeaderShipUp_Active==false
"""

isLocked:if self.timeAlive<=memory.Pilot_LeaderShipUp_CDTimer
isLockedMessage:In CD
isLockedMessage_zh:冷却中
isLockedAlt:if memory.Pilot_LeaderShipUp_Active==true
isLockedAltMessage:In Action
isLockedAltMessage_zh:行动中

alsoTriggerAction:"""
Pilot_LeaderShipUp_Step_1
"""
[hiddenAction_Pilot_LeaderShipUp_Step_1]
spawnEffects:Flash_1_N
playSoundAtUnit:ROOT:Resource/Sound/SE/Action/Common/Action_8.ogg:0.5

setUnitMemory:"""
Pilot_LeaderShipUp_Active=true,
Pilot_LeaderShipUp_ActiveTimer=self.timeAlive+${Pilot_LeaderShipUp_ActiveTime}
"""

[hiddenAction_Pilot_LeaderShipUp_CheckOver]
autoTrigger:"""
if memory.Pilot_LeaderShipUp_Active==true 
and self.timeAlive>memory.Pilot_LeaderShipUp_ActiveTimer
"""
setUnitMemory:"""
Pilot_LeaderShipUp_Active=false,
Pilot_LeaderShipUp_CDTimer=self.timeAlive+${Pilot_LeaderShipUp_CD}
"""