[core]
dont_load:true
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Flash_1.gw
"""

@memory Pilot_ReactionUp_Active:bool
@memory Pilot_ReactionUp_ActiveTimer:float
@global Pilot_ReactionUp_ActiveTime:15
@memory Pilot_ReactionUp_CDTimer:float
@global Pilot_ReactionUp_CD=90

@memory Pilot_ReactionUp_Reaction:float
@global Pilot_ReactionUp_ReactionUp:1.75





[hiddenAction_Pilot_ReactionUp_Check]
autoTrigger:true
setUnitMemory:"""
Pilot_ReactionUp_Reaction=select(memory.Pilot_ReactionUp_Active==true,${Pilot_ReactionUp_ReactionUp},1)
"""

[hiddenAction_Check_UnitBuffRule_Reaction]
setUnitMemory:pilotBuffRuleReactionModifier=1*memory.Pilot_ReactionUp_Reaction

[action_Pilot_ReactionUp_Trigger]
pos:10
text:"""
ReactionUp 
%{
    select(memory.Pilot_ReactionUp_Active==true,
    str(int(memory.Pilot_ReactionUp_ActiveTimer-self.timeAlive))+"s",
    select(self.timeAlive<=memory.Pilot_ReactionUp_CDTimer,"CD:" + str(int(memory.Pilot_ReactionUp_CDTimer-self.timeAlive))+"s","OK"))
}
"""
text_zh:"""
回避力上升 
%{
    select(memory.Pilot_ReactionUp_Active==true,
    str(int(memory.Pilot_ReactionUp_ActiveTimer-self.timeAlive))+"秒",
    select(self.timeAlive<=memory.Pilot_ReactionUp_CDTimer,"冷却中:" + str(int(memory.Pilot_ReactionUp_CDTimer-self.timeAlive))+"秒","OK"))
}
"""
text_KP:100

description:Reaction Up 75% in 15sec
description_zh:15秒内反应力提高75%

displayType:infoOnly

price:EN=100

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true
highPriorityQueue:true
ai_isDisabled:true

iconImage:ROOT:Resource/Image/Units/Button/Skill/Pilot_ReactionUp.png

isVisible:if not self.hasTags(includes='inHangar')



isGuiBlinking:"""
if self.timeAlive>memory.Pilot_ReactionUp_CDTimer and memory.Pilot_ReactionUp_Active==false
"""

isLocked:if self.timeAlive<=memory.Pilot_ReactionUp_CDTimer
isLockedMessage:In CD
isLockedMessage_zh:冷却中
isLockedAlt:if memory.Pilot_ReactionUp_Active==true
isLockedAltMessage:In Action
isLockedAltMessage_zh:行动中

alsoTriggerAction:"""
Pilot_ReactionUp_Step_1
"""
[hiddenAction_Pilot_ReactionUp_Step_1]
spawnEffects:Flash_1_N
playSoundAtUnit:ROOT:Resource/Sound/SE/Action/Common/Action_8.ogg:0.5

setUnitMemory:"""
Pilot_ReactionUp_Active=true,
Pilot_ReactionUp_ActiveTimer=self.timeAlive+${Pilot_ReactionUp_ActiveTime}
"""

[hiddenAction_Pilot_ReactionUp_CheckOver]
autoTrigger:"""
if memory.Pilot_ReactionUp_Active==true 
and self.timeAlive>memory.Pilot_ReactionUp_ActiveTimer
"""
setUnitMemory:"""
Pilot_ReactionUp_Active=false,
Pilot_ReactionUp_CDTimer=self.timeAlive+${Pilot_ReactionUp_CD}
"""