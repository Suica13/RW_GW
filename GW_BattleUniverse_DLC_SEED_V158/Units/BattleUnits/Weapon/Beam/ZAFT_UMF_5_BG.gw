[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Green.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory ZAFT_UMF_5_BG_CDTimer:float
@global ZAFT_UMF_5_BG_CD=2
@global ZAFT_UMF_5_BG_EN=15










[turret_ZAFT_UMF_5_BG]
x:0
y:0

canShoot:false
projectile:ZAFT_UMF_5_BG_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:14
barrelY:10
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamSprayGun_1.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Green_S



[projectile_ZAFT_UMF_5_BG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Green*1
(
    addResources=
    BeamDamage:5500
    |DpDamage:250
    |WeaponAccuracy=85
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=1
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""





[hiddenAction_ZAFT_UMF_5_BG_Trigger]
alsoTriggerAction:ZAFT_UMF_5_BG_Fire
[hiddenAction_ZAFT_UMF_5_BG_Fire]
requireConditional:"""
if self.timeAlive>memory.ZAFT_UMF_5_BG_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:ZAFT_UMF_5_BG_CDTimer=self.timeAlive+${ZAFT_UMF_5_BG_CD}
addResources:EN=-${ZAFT_UMF_5_BG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZAFT_UMF_5_BG_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
ZAFT_UMF_5_BG_B1_Step_1
"""
[hiddenAction_ZAFT_UMF_5_BG_B1_Step_1]
alsoQueueAction:"""
ZAFT_UMF_5_BG_Fire_Step_1,
ZAFT_UMF_5_BG_Fire_Step_2,
ZAFT_UMF_5_BG_Fire_Step_Final
"""



[hiddenAction_ZAFT_UMF_5_BG_SetWeaponIndex]
isVisible:false


[hiddenAction_ZAFT_UMF_5_BG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_ZAFT_UMF_5_BG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZAFT_UMF_5_BG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZAFT_UMF_5_BG_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

