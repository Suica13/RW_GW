[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""


@memory Common_ArmBR_Pink_L_CDTimer:float
@global Common_ArmBR_Pink_L_CD=3
@global Common_ArmBR_Pink_L_EN=25



[turret_Common_ArmBR_Pink_L]
x:0
y:0

canShoot:false
projectile:Common_ArmBR_Pink_L_Projectile

delay:0.1s
limitingRange:0

canAttackMaxAngle:15
barrelX:-14
barrelY:10

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamGun_1.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Fire_1_Pink



[projectile_Common_ArmBR_Pink_L_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Pink*1
(
    addResources=
    BeamDamage:2250
    |DpDamage:75
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |PartBreakModifier=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:80
    |ProjectileSpread:1
    |ProjectileLife:20
)
"""







[hiddenAction_Common_ArmBR_Pink_L_Trigger]
alsoTriggerAction:Common_ArmBR_Pink_L_Fire
[hiddenAction_Common_ArmBR_Pink_L_Fire]
requireConditional:"""
if self.timeAlive>memory.Common_ArmBR_Pink_L_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:Common_ArmBR_Pink_L_CDTimer=self.timeAlive+${Common_ArmBR_Pink_L_CD}
addResources:EN=-${Common_ArmBR_Pink_L_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
Common_ArmBR_Pink_L_SetWeaponIndex,
Common_ArmBR_Pink_L_B3_Step_1
"""
[hiddenAction_Common_ArmBR_Pink_L_B3_Step_1]
alsoQueueAction:"""
Common_ArmBR_Pink_L_Fire_Step_1,
Common_ArmBR_Pink_L_Fire_Step_2,
Common_ArmBR_Pink_L_Fire_Step_3,
Common_ArmBR_Pink_L_Fire_Step_3,
Common_ArmBR_Pink_L_Fire_Step_Final
"""





[hiddenAction_Common_ArmBR_Pink_L_SetWeaponIndex]
isVisible:false


[hiddenAction_Common_ArmBR_Pink_L_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.1s
[hiddenAction_Common_ArmBR_Pink_L_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:Common_ArmBR_Pink_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_L_Step_1
[hiddenAction_Common_ArmBR_Pink_L_Fire_Step_3]
@copyFromSection:hiddenAction_Common_ArmBR_Pink_L_Fire_Step_2
buildSpeed:${turret_Common_ArmBR_Pink_L.delay}
[hiddenAction_Common_ArmBR_Pink_L_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


