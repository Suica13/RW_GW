[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Red.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory OMNI_GAT_X303_MA_BeamCannon_CDTimer:float
@global OMNI_GAT_X303_MA_BeamCannon_CD=5
@global OMNI_GAT_X303_MA_BeamCannon_EN=120



[turret_OMNI_GAT_X303_MA_BeamCannon]
x:0
y:0

canShoot:false
projectile:OMNI_GAT_X303_MA_BeamCannon_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:0
barrelY:20
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCannon_2.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Fire_1_Red



[projectile_OMNI_GAT_X303_MA_BeamCannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_HighBeamCannon_Red*1
(
    addResources=
    BeamDamage:9000
    |BeamAPDamage:3000
    |DpDamage:600
    |WeaponAccuracy=65
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:55
    |ProjectileSpread:1
    |ProjectileExplosionRange:45
    |ProjectileLife:25

    |ProjectileAttackTimes:7
    |ProjectileAttackTimesDamageModifier:0.75
),
Projectile_HighBeamCannon_RedWhite_Effect*1
(
    addResources=
    ProjectileSpeed:0.75
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""








[hiddenAction_OMNI_GAT_X303_MA_BeamCannon_Trigger]
alsoTriggerAction:OMNI_GAT_X303_MA_BeamCannon_Fire
[hiddenAction_OMNI_GAT_X303_MA_BeamCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.OMNI_GAT_X303_MA_BeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:OMNI_GAT_X303_MA_BeamCannon_CDTimer=self.timeAlive+${OMNI_GAT_X303_MA_BeamCannon_CD}
addResources:EN=-${OMNI_GAT_X303_MA_BeamCannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
OMNI_GAT_X303_MA_BeamCannon_SetWeaponIndex,
PlayCommon_Cannon_Shoot_A_Step_1,
OMNI_GAT_X303_MA_BeamCannon_B1_Step_1
"""
[hiddenAction_OMNI_GAT_X303_MA_BeamCannon_B1_Step_1]
alsoQueueAction:"""
OMNI_GAT_X303_MA_BeamCannon_Fire_Step_1,
OMNI_GAT_X303_MA_BeamCannon_Fire_Step_2,
OMNI_GAT_X303_MA_BeamCannon_Fire_Step_Final
"""




[hiddenAction_OMNI_GAT_X303_MA_BeamCannon_SetWeaponIndex]
isVisible:false


[hiddenAction_OMNI_GAT_X303_MA_BeamCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.65s
[hiddenAction_OMNI_GAT_X303_MA_BeamCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:OMNI_GAT_X303_MA_BeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_OMNI_GAT_X303_MA_BeamCannon_Fire_Step_Final]
buildSpeed:0.65s
alsoTriggerAction:SetAttackingOff


