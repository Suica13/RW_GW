[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw
"""


@memory Common_Pilot_Pistol_CDTimer:float
@global Common_Pilot_Pistol_CD=2
@global Common_Pilot_Pistol_EN=10







[turret_Common_Pilot_Pistol]
x:0
y:0

canShoot:false
projectile:Common_Pilot_Pistol_Projectile

delay:0.15s
limitingRange:0

canAttackMaxAngle:15
barrelX:0.5
barrelY:6

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_2.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1_S



[projectile_Common_Pilot_Pistol_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Vulcan*1
(
    addResources=
    ShellDamage:45
    |DpDamage:5
    |WeaponAccuracy=150
    |PartBreakModifier=0.5
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=1
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=1
    |AntiBuilding=0.75
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:85
    |ProjectileSpread:3
    |ProjectileLife:10
)
"""







[hiddenAction_Common_Pilot_Pistol_Trigger]
alsoTriggerAction:Common_Pilot_Pistol_Fire
[hiddenAction_Common_Pilot_Pistol_Fire]
requireConditional:"""
if self.timeAlive>memory.Common_Pilot_Pistol_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and self.attacking.hp>0 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:Common_Pilot_Pistol_CDTimer=self.timeAlive+${Common_Pilot_Pistol_CD}
addResources:EN=-${Common_Pilot_Pistol_EN}
alsoTriggerAction:"""
SetAttackingOn,
Common_Pilot_Pistol_SetWeaponIndex,
Common_Pilot_Pistol_B3_Step_1
"""
[hiddenAction_Common_Pilot_Pistol_B3_Step_1]
alsoQueueAction:"""
Common_Pilot_Pistol_Fire_Step_1,
Common_Pilot_Pistol_Fire_Step_2,
Common_Pilot_Pistol_Fire_Step_3,
Common_Pilot_Pistol_Fire_Step_3,
Common_Pilot_Pistol_Fire_Step_Final
"""





[hiddenAction_Common_Pilot_Pistol_SetWeaponIndex]
isVisible:false


[hiddenAction_Common_Pilot_Pistol_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.1s
[hiddenAction_Common_Pilot_Pistol_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:Common_Pilot_Pistol
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_Common_Pilot_Pistol_Fire_Step_3]
@copyFromSection:hiddenAction_Common_Pilot_Pistol_Fire_Step_2
buildSpeed:${turret_Common_Pilot_Pistol.delay}
[hiddenAction_Common_Pilot_Pistol_Fire_Step_Final]
buildSpeed:0.1s
alsoTriggerAction:SetAttackingOff


