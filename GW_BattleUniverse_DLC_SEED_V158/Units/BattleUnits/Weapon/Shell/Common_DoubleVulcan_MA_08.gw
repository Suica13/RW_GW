[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw
"""

@memory Common_DoubleVulcan_MA_08_OnCD:bool
@memory Common_DoubleVulcan_MA_08_CDTimer:float
@global Common_DoubleVulcan_MA_08_CD=3

@global Common_DoubleVulcan_MA_08_Shoot=16
[resource_Common_DoubleVulcan_MA_08_ShootTimer]
hidden:true









[turret_Common_DoubleVulcan_MA_08]
x:0
y:0

canShoot:true
canAttackCondition:"""
if ${cantAction}==false 
"""
showRangeUIGuide:false
projectile:Common_DoubleVulcan_MA_08_Projectile
resourceUsage:Common_DoubleVulcan_MA_08_ShootTimer=1

delay:0.1s
limitingRange:1200
limitingAngle:3

canAttackMaxAngle:15
barrelX:8
barrelY:-8
barrelOffsetX_onOddShots:-16

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/Vulcan_2.ogg
shoot_sound_vol:0.25
shoot_flame:MG_Fire_1



[projectile_Common_DoubleVulcan_MA_08_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:800
    |DpDamage:25
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=1
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=1
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1.5 
    |AntiLand=1
    |AntiSpace=1 
    |HeightChangeSpeed=3
    |HeightHitRange=25
    |ProjectileSpeed:100
    |ProjectileSpread:3
    |ProjectileLife:20
)
"""



[hiddenAction_Common_DoubleVulcan_MA_08_CDStart]
autoTrigger:"""
if memory.Common_DoubleVulcan_MA_08_OnCD==false 
and 
(
    (
        self.resource.Common_DoubleVulcan_MA_08_ShootTimer<=0 
    ) 
    or 
    (
        self.resource.Common_DoubleVulcan_MA_08_ShootTimer<${Common_DoubleVulcan_MA_08_Shoot} and not self.hasTags(includes='inBattle')
    )
)
"""
setUnitMemory:Common_DoubleVulcan_MA_08_OnCD=true,Common_DoubleVulcan_MA_08_CDTimer=self.timeAlive+${Common_DoubleVulcan_MA_08_CD}

[hiddenAction_Common_DoubleVulcan_MA_08_CDEnd]
autoTriggerOnEvent:created
autoTrigger:if memory.Common_DoubleVulcan_MA_08_OnCD==true and self.timeAlive>memory.Common_DoubleVulcan_MA_08_CDTimer
setUnitMemory:Common_DoubleVulcan_MA_08_OnCD=false
setResourcesWithLogic:Common_DoubleVulcan_MA_08_ShootTimer=${Common_DoubleVulcan_MA_08_Shoot}
