[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""


@memory Common_ArmGL_CDTimer:float
@global Common_ArmGL_CD=4
@global Common_ArmGL_EN=25



[turret_Common_ArmGL]
x:0
y:0

canShoot:false
projectile:Common_ArmGL_Projectile

delay:0.2s
limitingRange:0

canAttackMaxAngle:15
barrelX:16
barrelY:12

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1_S



[projectile_Common_ArmGL_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_S*1
(
    addResources=
    ShellDamage:2750
    |DpDamage:135
    |WeaponAccuracy=85
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75
    |AntiLand=1 
    |AntiSpace=1 
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:60
    |ProjectileSpread:2
    |ProjectileExplosionRange:35
    |ProjectileLife:25
)
"""







[hiddenAction_Common_ArmGL_Trigger]
alsoTriggerAction:Common_ArmGL_Fire
[hiddenAction_Common_ArmGL_Fire]
requireConditional:"""
if self.timeAlive>memory.Common_ArmGL_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:Common_ArmGL_CDTimer=self.timeAlive+${Common_ArmGL_CD}
addResources:EN=-${Common_ArmGL_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
Common_ArmGL_SetWeaponIndex,
Common_ArmGL_B2_Step_1
"""
[hiddenAction_Common_ArmGL_B2_Step_1]
alsoQueueAction:"""
Common_ArmGL_Fire_Step_1,
Common_ArmGL_Fire_Step_2,
Common_ArmGL_Fire_Step_3,
Common_ArmGL_Fire_Step_Final
"""





[hiddenAction_Common_ArmGL_SetWeaponIndex]
isVisible:false


[hiddenAction_Common_ArmGL_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.1s
[hiddenAction_Common_ArmGL_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:Common_ArmGL
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_Common_ArmGL_Fire_Step_3]
@copyFromSection:hiddenAction_Common_ArmGL_Fire_Step_2
buildSpeed:${turret_Common_ArmGL.delay}
[hiddenAction_Common_ArmGL_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


