[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory ZAFT_ZGMF_1017_BZ_CDTimer:float
@global ZAFT_ZGMF_1017_BZ_CD=4.5
@global ZAFT_ZGMF_1017_BZ_EN=55





[decal_ZAFT_ZGMF_1017_BZ]
layer:beforeBody
order:6.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\ZAFT_ZGMF_1017_BZ.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.7
xOffsetRelative: 3
yOffsetRelative: 13
dirOffset:0
[decal_ZAFT_ZGMF_1017_BZ_NotUsing]
@copyFromSection:decal_ZAFT_ZGMF_1017_BZ
order:0
basePositionFromLegEnd:arm1
imageScale:0.6
imageScaleY:-1
xOffsetRelative:-1
yOffsetRelative:-9
dirOffset:90






[turret_ZAFT_ZGMF_1017_BZ]
x:0
y:0

canShoot:false
projectile:ZAFT_ZGMF_1017_BZ_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:10
barrelY:18
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Bazooka_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_ZAFT_ZGMF_1017_BZ_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka*1
(
    addResources=
    ShellDamage:8500
    |DpDamage:350
    |WeaponAccuracy=75
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:55
    |ProjectileSpread:1
    |ProjectileExplosionRange:30
    |ProjectileLife:22

    |ProjectileBlastRange:50
    |ProjectileBlastDamageModifier:0.20
    |ProjectileBlastDpModifier:1
)
"""








[hiddenAction_ZAFT_ZGMF_1017_BZ_Trigger]
alsoTriggerAction:ZAFT_ZGMF_1017_BZ_Fire
[hiddenAction_ZAFT_ZGMF_1017_BZ_Fire]
requireConditional:"""
if self.timeAlive>memory.ZAFT_ZGMF_1017_BZ_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:ZAFT_ZGMF_1017_BZ_CDTimer=self.timeAlive+${ZAFT_ZGMF_1017_BZ_CD}
addResources:EN=-${ZAFT_ZGMF_1017_BZ_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZAFT_ZGMF_1017_BZ_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
ZAFT_ZGMF_1017_BZ_B1_Step_1
"""
[hiddenAction_ZAFT_ZGMF_1017_BZ_B1_Step_1]
alsoQueueAction:"""
ZAFT_ZGMF_1017_BZ_Fire_Step_1,
ZAFT_ZGMF_1017_BZ_Fire_Step_2,
ZAFT_ZGMF_1017_BZ_Fire_Step_Final
"""




[hiddenAction_ZAFT_ZGMF_1017_BZ_SetWeaponIndex]
isVisible:false


[hiddenAction_ZAFT_ZGMF_1017_BZ_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_ZAFT_ZGMF_1017_BZ_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZAFT_ZGMF_1017_BZ
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZAFT_ZGMF_1017_BZ_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


