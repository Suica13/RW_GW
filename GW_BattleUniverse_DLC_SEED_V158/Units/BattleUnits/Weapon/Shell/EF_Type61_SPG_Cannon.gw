[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw
"""
@memory EF_Type61_SPG_Cannon_OnCD:bool
@memory EF_Type61_SPG_Cannon_CDTimer:float
@global EF_Type61_SPG_Cannon_CD=5
@global EF_Type61_SPG_Cannon_EN=30

@global EF_Type61_SPG_Cannon_Shoot=1
[resource_EF_Type61_SPG_Cannon_ShootTimer]
hidden:true







[turret_EF_Type61_SPG_Cannon]
x:0
y:0

canShoot:true
canOnlyAttackUnitsWithoutTags:AirUnit
canAttackCondition:"""
if ${onAttacking}==false and ${cantAction}==false and distanceBetween(self,self.attacking)>150 and ${onSkill}==false 
"""
showRangeUIGuide:false
projectile:EF_Type61_SPG_Cannon_Projectile
resourceUsage:EF_Type61_SPG_Cannon_ShootTimer=1,en=${EF_Type61_SPG_Cannon_EN}

delay:0.0s
canAttackMaxAngle:3
barrelX:0
barrelY:18
turnSpeed:1.0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\ShellCannon_1.ogg
shoot_sound_vol:0.5
shoot_flame:BZ_Fire_1





[projectile_EF_Type61_SPG_Cannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Mortar*1
(
    addResources=
    ShellDamage:3750
    |DpDamage:500
    |WeaponAccuracy=75
    |PartBreakModifier=0.5
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=0.5
    |HeightHitRange=10
    |ProjectileSpeed:30
    |ProjectileSpread:0
    |ProjectileExplosionRange:30
    |ProjectileLife:50
    
    |ProjectileBlastRange:50
    |ProjectileBlastDamageModifier:0.35
    |ProjectileBlastDpModifier:1
)
"""



[hiddenAction_EF_Type61_SPG_Cannon_CDStart]
autoTrigger:"""
if memory.EF_Type61_SPG_Cannon_OnCD==false 
and 
(
    (
        self.resource.EF_Type61_SPG_Cannon_ShootTimer<=0 
    ) 
    or 
    (
        self.resource.EF_Type61_SPG_Cannon_ShootTimer<${EF_Type61_SPG_Cannon_Shoot} and not self.hasTags(includes='inBattle')
    )
)
"""
setUnitMemory:EF_Type61_SPG_Cannon_OnCD=true,EF_Type61_SPG_Cannon_CDTimer=self.timeAlive+${EF_Type61_SPG_Cannon_CD}

[hiddenAction_EF_Type61_SPG_Cannon_CDEnd]
autoTriggerOnEvent:created
autoTrigger:if memory.EF_Type61_SPG_Cannon_OnCD==true and self.timeAlive>memory.EF_Type61_SPG_Cannon_CDTimer
setUnitMemory:EF_Type61_SPG_Cannon_OnCD=false
setResourcesWithLogic:EF_Type61_SPG_Cannon_ShootTimer=${EF_Type61_SPG_Cannon_Shoot}
