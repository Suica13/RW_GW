[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_StandShoot_A.gw
"""


@memory ZAFT_ZGMF_1017_D_MS_CDTimer:float
@global ZAFT_ZGMF_1017_D_MS_CD=5
@global ZAFT_ZGMF_1017_D_MS_EN=30








[turret_ZAFT_ZGMF_1017_D_MS]
x:0
y:0

canShoot:false
projectile:ZAFT_ZGMF_1017_D_MS_Projectile

delay:0.15s
limitingRange:0

canAttackMaxAngle:15
barrelX:11
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.15
shoot_flame:BZ_Fire_1_S
[turret_ZAFT_ZGMF_1017_D_MS_L]
@copyFromSection:turret_ZAFT_ZGMF_1017_D_MS
barrelX:-11



[projectile_ZAFT_ZGMF_1017_D_MS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS*1
(
    addResources=
    ShellDamage:750
    |DpDamage:50
    |WeaponAccuracy=85
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=2
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightHitRange=20
    |HeightChangeSpeed=2
    |ProjectileSpeed:30
    |ProjectileTurnspeed:1.5
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:50
)
"""







[hiddenAction_ZAFT_ZGMF_1017_D_MS_Trigger]
alsoTriggerAction:ZAFT_ZGMF_1017_D_MS_Fire
[hiddenAction_ZAFT_ZGMF_1017_D_MS_Fire]
requireConditional:"""
if self.timeAlive>memory.ZAFT_ZGMF_1017_D_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:ZAFT_ZGMF_1017_D_MS_CDTimer=self.timeAlive+${ZAFT_ZGMF_1017_D_MS_CD}
addResources:EN=-${ZAFT_ZGMF_1017_D_MS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZAFT_ZGMF_1017_D_MS_SetWeaponIndex,
ZAFT_ZGMF_1017_D_MS_B4_Step_1,
PlayCommon_StandShoot_A_Step_1
"""
[hiddenAction_ZAFT_ZGMF_1017_D_MS_B4_Step_1]
alsoQueueAction:"""
ZAFT_ZGMF_1017_D_MS_Fire_Step_1,
ZAFT_ZGMF_1017_D_MS_Fire_Step_2,
ZAFT_ZGMF_1017_D_MS_Fire_Step_3,
ZAFT_ZGMF_1017_D_MS_Fire_Step_2,
ZAFT_ZGMF_1017_D_MS_Fire_Step_3,
ZAFT_ZGMF_1017_D_MS_Fire_Step_Final
"""





[hiddenAction_ZAFT_ZGMF_1017_D_MS_SetWeaponIndex]
isVisible:false


[hiddenAction_ZAFT_ZGMF_1017_D_MS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_ZAFT_ZGMF_1017_D_MS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false
"""
buildSpeed:0.1s
fireTurretXAtGround:ZAFT_ZGMF_1017_D_MS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZAFT_ZGMF_1017_D_MS_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false
"""
buildSpeed:0.1s
fireTurretXAtGround:ZAFT_ZGMF_1017_D_MS_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZAFT_ZGMF_1017_D_MS_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff


