[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_StandShoot_A_Double.gw
"""


@memory OMNI_GAT_X105_L_MG_CDTimer:float
@global OMNI_GAT_X105_L_MG_CD=4
@global OMNI_GAT_X105_L_MG_EN=30




[turret_OMNI_GAT_X105_L_MG]
x:0
y:0

canShoot:false
projectile:OMNI_GAT_X105_L_MG_Projectile

delay:0.05s
limitingRange:0

canAttackMaxAngle:15
barrelX:16
barrelY:-2

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_2.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_OMNI_GAT_X105_L_MG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:500
    |DpDamage:25
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:6
    |ProjectileLife:20
)
"""







[hiddenAction_OMNI_GAT_X105_L_MG_Trigger]
alsoTriggerAction:OMNI_GAT_X105_L_MG_Fire
[hiddenAction_OMNI_GAT_X105_L_MG_Fire]
requireConditional:"""
if self.timeAlive>memory.OMNI_GAT_X105_L_MG_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:OMNI_GAT_X105_L_MG_CDTimer=self.timeAlive+${OMNI_GAT_X105_L_MG_CD}
addResources:EN=-${OMNI_GAT_X105_L_MG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
OMNI_GAT_X105_L_MG_SetWeaponIndex,
OMNI_GAT_X105_L_MG_B12_Step_1
"""
[hiddenAction_OMNI_GAT_X105_L_MG_B12_Step_1]
alsoQueueAction:"""
OMNI_GAT_X105_L_MG_Fire_Step_1,
OMNI_GAT_X105_L_MG_Fire_Step_2,
OMNI_GAT_X105_L_MG_Fire_Step_3,
OMNI_GAT_X105_L_MG_Fire_Step_3,
OMNI_GAT_X105_L_MG_Fire_Step_3,
OMNI_GAT_X105_L_MG_Fire_Step_3,
OMNI_GAT_X105_L_MG_Fire_Step_3,
OMNI_GAT_X105_L_MG_Fire_Step_3,
OMNI_GAT_X105_L_MG_Fire_Step_3,
OMNI_GAT_X105_L_MG_Fire_Step_3,
OMNI_GAT_X105_L_MG_Fire_Step_3,
OMNI_GAT_X105_L_MG_Fire_Step_3,
OMNI_GAT_X105_L_MG_Fire_Step_3,
OMNI_GAT_X105_L_MG_Fire_Step_Final
"""





[hiddenAction_OMNI_GAT_X105_L_MG_SetWeaponIndex]
isVisible:false


[hiddenAction_OMNI_GAT_X105_L_MG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.2s
[hiddenAction_OMNI_GAT_X105_L_MG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:OMNI_GAT_X105_L_MG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_StandShoot_A_Double_Step_1
[hiddenAction_OMNI_GAT_X105_L_MG_Fire_Step_3]
@copyFromSection:hiddenAction_OMNI_GAT_X105_L_MG_Fire_Step_2
buildSpeed:${turret_OMNI_GAT_X105_L_MG.delay}
[hiddenAction_OMNI_GAT_X105_L_MG_Fire_Step_Final]
buildSpeed:0.2s
alsoTriggerAction:SetAttackingOff


