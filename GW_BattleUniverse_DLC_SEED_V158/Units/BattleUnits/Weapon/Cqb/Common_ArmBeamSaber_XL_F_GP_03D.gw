[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Cqb/Common/Cqb_Fire_1_Pink_R_XXL.gw,
ROOT:Template/Unit/Animation/Cqb/Common_Melee_F_GP_03D.gw
"""

@memory Common_ArmBeamSaber_XL_F_GP_03D_CDTimer:float
@global Common_ArmBeamSaber_XL_F_GP_03D_CD=3.5




[decal_Common_ArmBeamSaber_XL_F_GP_03D]
layer:beforeBody
order:2
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Cqb\Image\Common_ArmBeamSaber_XL.png
isVisible:false
basePositionFromLegEnd:arm3
total_frames:5
frame:1
imageScale:1.5
imageScaleX:1.5
imageScaleY:1.35
xOffsetRelative:-18
yOffsetRelative:45
dirOffset:0



[turret_Common_ArmBeamSaber_XL_F_GP_03D]
x:0
y:0
invisible:true

canShoot:false

showRangeUIGuide:false
projectile:Common_ArmBeamSaber_XL_F_GP_03D_Projectile

delay:3s
limitingMinRange:0
limitingRange:0

canAttackMaxAngle:60
barrelX:0
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamSaber_1.ogg
shoot_sound_vol:0.5

[projectile_Common_ArmBeamSaber_XL_F_GP_03D_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Saber_XL_A_L*1
(
    addResources=
    CqbDamage:10000
    |CqbBeamDamage:10000
    |DpDamage:1500
    |WeaponAccuracy:100
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightHitRange:35
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileLife:1.5
    |ProjectileAttackTimes:9
)
"""






[hiddenAction_Common_ArmBeamSaber_XL_F_GP_03D_Trigger]
alsoTriggerAction:Common_ArmBeamSaber_XL_F_GP_03D_Fire
[hiddenAction_Common_ArmBeamSaber_XL_F_GP_03D_Fire]
requireConditional:"""
if self.timeAlive>memory.Common_ArmBeamSaber_XL_F_GP_03D_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) 
and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50
"""
setUnitMemory:Common_ArmBeamSaber_XL_F_GP_03D_CDTimer=self.timeAlive+${Common_ArmBeamSaber_XL_F_GP_03D_CD}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Cqb,
Common_ArmBeamSaber_XL_F_GP_03D_SetWeaponIndex,
PlayCommon_Melee_F_GP_03D_Step_1,
Common_ArmBeamSaber_XL_F_GP_03D_Step_1
"""
[hiddenAction_Common_ArmBeamSaber_XL_F_GP_03D_Step_1]
alsoQueueAction:"""
Common_ArmBeamSaber_XL_F_GP_03D_Fire_Step_1,
Common_ArmBeamSaber_XL_F_GP_03D_Fire_Step_2,
Common_ArmBeamSaber_XL_F_GP_03D_Fire_Step_Final
"""




[hiddenAction_Common_ArmBeamSaber_XL_F_GP_03D_SetWeaponIndex]
isVisible:false


[hiddenAction_Common_ArmBeamSaber_XL_F_GP_03D_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.5s
[hiddenAction_Common_ArmBeamSaber_XL_F_GP_03D_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:Common_ArmBeamSaber_XL_F_GP_03D
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_1_Pink_R_XXL
[hiddenAction_Common_ArmBeamSaber_XL_F_GP_03D_Fire_Step_Final]
buildSpeed:1.5s
alsoTriggerAction:SetAttackingOff

