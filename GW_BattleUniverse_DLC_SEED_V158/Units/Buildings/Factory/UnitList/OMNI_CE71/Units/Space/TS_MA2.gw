[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini



[hiddenAction_AutoProduce_TS_MA2]
@copyFromSection:template_AutoProduce
@define UnitID=TS_MA2
alsoTriggerAction:AutoProduce_TS_MA2_Step2

[hiddenAction_AutoProduce_TS_MA2_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=250
@define Resource=500
alsoQueueAction:Produce_TS_MA2_StandardSquad





[action_Produce_TS_MA2_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=TS_MA2
@define Money=500
@define Resource=1000
@define FactionVisible= (memory.Pannel_OMNI_CE71_DontShow==false)
buildSpeed:30s

alsoQueueAction:"""
Produce_TS_MA2_StandardSquad_1,
Produce_TS_MA2_StandardSquad_2,
Produce_TS_MA2_StandardSquad_3
"""
[hiddenAction_Produce_TS_MA2_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
TS_MA2*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_TS_MA2_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
TS_MA2*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_TS_MA2_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
TS_MA2*1(addResources=PilotType:1101|EquipmentIndex:0)
"""