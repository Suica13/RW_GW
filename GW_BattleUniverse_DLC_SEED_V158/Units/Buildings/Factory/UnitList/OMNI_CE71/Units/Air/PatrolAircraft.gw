[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini




[hiddenAction_AutoProduce_PatrolAircraft]
@copyFromSection:template_AutoProduce
@define UnitID=PatrolAircraft
alsoTriggerAction:AutoProduce_PatrolAircraft_Step2

[hiddenAction_AutoProduce_PatrolAircraft_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=250
@define Resource=500
alsoQueueAction:Produce_PatrolAircraft_StandardSquad



[action_Produce_PatrolAircraft_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=PatrolAircraft
@define Money=250
@define Resource=500
@define FactionVisible= (memory.Pannel_OMNI_CE71_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:25s

alsoQueueAction:"""
Produce_PatrolAircraft_StandardSquad_1
