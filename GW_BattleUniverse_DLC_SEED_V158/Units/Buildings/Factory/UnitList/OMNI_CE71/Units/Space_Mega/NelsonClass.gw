[action_Produce_NelsonClass]
@copyFromSection:template_Produce_Fast
@define UnitID=NelsonClass
@define Money=2000
@define Resource=4500
@define FactionVisible= (memory.Pannel_OMNI_CE71_DontShow==false)
buildSpeed:45s

alsoQueueAction:"""
Produce_NelsonClass_1
