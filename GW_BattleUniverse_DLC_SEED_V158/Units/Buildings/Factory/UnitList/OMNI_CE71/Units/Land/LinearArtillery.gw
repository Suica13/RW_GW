[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini





[hiddenAction_AutoProduce_LinearArtillery]
@copyFromSection:template_AutoProduce
@define UnitID=LinearArtillery
alsoTriggerAction:AutoProduce_LinearArtillery_Step2

[hiddenAction_AutoProduce_LinearArtillery_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=400
@define Resource=750
alsoQueueAction:Produce_LinearArtillery_StandardSquad



[action_Produce_LinearArtillery_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=LinearArtillery
@define Money=400
@define Resource=750
@define FactionVisible= (memory.Pannel_OMNI_CE71_DontShow==false)
buildSpeed:25s

alsoQueueAction:"""
Produce_LinearArtillery_StandardSquad_1,
Produce_LinearArtillery_StandardSquad_2,
Produce_LinearArtillery_StandardSquad_3
"""
[hiddenAction_Produce_LinearArtillery_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
LinearArtillery*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
