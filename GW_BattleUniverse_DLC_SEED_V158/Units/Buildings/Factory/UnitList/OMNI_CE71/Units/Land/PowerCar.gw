[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


[hiddenAction_AutoProduce_PowerCar]
@copyFromSection:template_AutoProduce
@define UnitID=PowerCar
alsoTriggerAction:AutoProduce_PowerCar_Step2

[hiddenAction_AutoProduce_PowerCar_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=150
@define Resource=400
alsoQueueAction:Produce_PowerCar_StandardSquad



[action_Produce_PowerCar_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=PowerCar
@define Money=300
@define Resource=600
@define FactionVisible= (memory.Pannel_OMNI_CE71_DontShow==false)
buildSpeed:25s

alsoQueueAction:"""
Produce_PowerCar_StandardSquad_1,
Produce_PowerCar_StandardSquad_2,
Produce_PowerCar_StandardSquad_3
"""
[hiddenAction_Produce_PowerCar_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
PowerCar*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_PowerCar_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
PowerCar*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_PowerCar_StandardSquad_3]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
PowerCar*1(addResources=PilotType:1101|EquipmentIndex:0)
"""