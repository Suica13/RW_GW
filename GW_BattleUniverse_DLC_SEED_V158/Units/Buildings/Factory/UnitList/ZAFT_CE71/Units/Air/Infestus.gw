[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini




[hiddenAction_AutoProduce_Infestus]
@copyFromSection:template_AutoProduce
@define UnitID=Infestus
alsoTriggerAction:AutoProduce_Infestus_Step2

[hiddenAction_AutoProduce_Infestus_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=300
@define Resource=700
alsoQueueAction:Produce_Infestus_StandardSquad



[action_Produce_Infestus_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=Infestus
@define Money=500
@define Resource=850
@define FactionVisible= (memory.Pannel_ZAFT_CE71_DontShow==false)
buildSpeed:35s

alsoQueueAction:"""
Produce_Infestus_StandardSquad_1,
Produce_Infestus_StandardSquad_2,
Produce_Infestus_StandardSquad_3
"""
[hiddenAction_Produce_Infestus_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
Infestus*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_Infestus_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
Infestus*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_Infestus_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
Infestus*1(addResources=PilotType:1101|EquipmentIndex:0)
"""