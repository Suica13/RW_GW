[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory AMF_101:bool


[hiddenAction_Pannel_Close_AMF_101]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:AMF_101=false



[hiddenAction_AutoProduce_AMF_101]
@copyFromSection:template_AutoProduce
@define UnitID=AMF_101
alsoTriggerAction:AutoProduce_AMF_101_Step2

[hiddenAction_AutoProduce_AMF_101_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1500
@define Resource=2500
alsoQueueAction:Produce_AMF_101_StandardSquad




[action_Produce_AMF_101_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=AMF_101
@define Money=1500
@define Resource=2500
@define FactionVisible= (memory.Pannel_ZAFT_CE71_DontShow==false)
buildSpeed:70s

alsoQueueAction:"""
Produce_AMF_101_StandardSquad_1,
Produce_AMF_101_StandardSquad_2,
Produce_AMF_101_StandardSquad_3
"""
[hiddenAction_Produce_AMF_101_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
AMF_101*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_AMF_101_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
AMF_101*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_AMF_101_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
AMF_101*1(addResources=PilotType:1101|EquipmentIndex:0)
"""


