[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


[hiddenAction_AutoProduce_SupplyTruck]
@copyFromSection:template_AutoProduce
@define UnitID=SupplyTruck
alsoTriggerAction:AutoProduce_SupplyTruck_Step2

[hiddenAction_AutoProduce_SupplyTruck_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=150
@define Resource=400
alsoQueueAction:Produce_SupplyTruck_StandardSquad



[action_Produce_SupplyTruck_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=SupplyTruck
@define Money=300
@define Resource=600
@define FactionVisible= (memory.Pannel_ZAFT_CE71_DontShow==false)
buildSpeed:35s

alsoQueueAction:"""
Produce_SupplyTruck_StandardSquad_1,
Produce_SupplyTruck_StandardSquad_2,
Produce_SupplyTruck_StandardSquad_3
"""
[hiddenAction_Produce_SupplyTruck_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
SupplyTruck*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_SupplyTruck_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
SupplyTruck*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_SupplyTruck_StandardSquad_3]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
SupplyTruck*1(addResources=PilotType:1101|EquipmentIndex:0)
"""