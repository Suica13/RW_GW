[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory ZGMF_1017:bool


[hiddenAction_Pannel_Close_ZGMF_1017]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:ZGMF_1017=false



[hiddenAction_AutoProduce_ZGMF_1017]
@copyFromSection:template_AutoProduce
@define UnitID=ZGMF_1017
alsoTriggerAction:AutoProduce_ZGMF_1017_Step2

[hiddenAction_AutoProduce_ZGMF_1017_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=800
@define Resource=1600
alsoTriggerAction:AutoProduce_ZGMF_1017_Random

[hiddenAction_AutoProduce_ZGMF_1017_Random]
alsoTriggerAction:"""
AutoProduce_ZGMF_1017_Random_A,
AutoProduce_ZGMF_1017_Random_B
"""
[hiddenAction_AutoProduce_ZGMF_1017_Random_A]
requireConditional:if memory.randomProduce<=750
alsoQueueAction:Produce_ZGMF_1017_StandardSquad

[hiddenAction_AutoProduce_ZGMF_1017_Random_B]
requireConditional:if memory.randomProduce>750
alsoQueueAction:Produce_ZGMF_1017_BazookaSquad




[action_Pannel_ZGMF_1017]
@copyFromSection:template_Pannel
@define UnitID=ZGMF_1017
@define FactionVisible= (memory.Pannel_ZAFT_CE71_DontShow==false)


[action_Produce_ZGMF_1017_StandardSquad]
