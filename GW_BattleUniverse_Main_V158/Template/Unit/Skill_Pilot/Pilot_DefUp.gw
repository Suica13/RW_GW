[core]
dont_load:true
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Flash_1.gw
"""

@memory Pilot_DefUp_Active:bool
@memory Pilot_DefUp_ActiveTimer:float
@global Pilot_DefUp_ActiveTime:15
@memory Pilot_DefUp_CDTimer:float
@global Pilot_DefUp_CD=90

@memory Pilot_DefUp_Def:float
@global Pilot_DefUp_DefUp:1.35





[hiddenAction_Pilot_DefUp_Check]
autoTrigger:true
setUnitMemory:"""
Pilot_DefUp_Def=select(memory.Pilot_DefUp_Active==true,${Pilot_DefUp_DefUp},1)
"""

[hiddenAction_Check_UnitBuffRule_Def]
setUnitMemory:pilotBuffRuleDefModifier=1*memory.Pilot_DefUp_Def

[action_Pilot_DefUp_Trigger]
pos:10
text:"""
DefUp 
%{
    select(memory.Pilot_DefUp_Active==true,
    str(int(memory.Pilot_DefUp_ActiveTimer-self.timeAlive))+"s",
    select(self.timeAlive<=memory.Pilot_DefUp_CDTimer,"CD:" + str(int(memory.Pilot_DefUp_CDTimer-self.timeAlive))+"s","OK"))
}
"""
text_zh:"""
防御力上升 
%{
    select(memory.Pilot_DefUp_Active==true,
    str(int(memory.Pilot_DefUp_ActiveTimer-self.timeAlive))+"秒",
    select(self.timeAlive<=memory.Pilot_DefUp_CDTimer,"冷却中:" + str(int(memory.Pilot_DefUp_CDTimer-self.timeAlive))+"秒","OK"))
}
"""
text_KP:100

description:Def Up 35% in 15sec
description_zh:15秒内防御力提高35%

displayType:infoOnly

price:EN=100

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true
highPriorityQueue:true
ai_isDisabled:true

iconImage:ROOT:Resource/Image/Units/Button/Skill/Pilot_DefUp.png

isVisible:if not self.hasTags(includes='inHangar')



isGuiBlinking:"""
if self.timeAlive>memory.Pilot_DefUp_CDTimer and memory.Pilot_DefUp_Active==false
"""

isLocked:if self.timeAlive<=memory.Pilot_DefUp_CDTimer
isLockedMessage:In CD
isLockedMessage_zh:冷却中
isLockedAlt:if memory.Pilot_DefUp_Active==true
isLockedAltMessage:In Action
isLockedAltMessage_zh:行动中

alsoTriggerAction:"""
Pilot_DefUp_Step_1
"""
[hiddenAction_Pilot_DefUp_Step_1]
spawnEffects:Flash_1_N
playSoundAtUnit:ROOT:Resource/Sound/SE/Action/Common/Action_8.ogg:0.5

setUnitMemory:"""
Pilot_DefUp_Active=true,
Pilot_DefUp_ActiveTimer=self.timeAlive+${Pilot_DefUp_ActiveTime}
"""

[hiddenAction_Pilot_DefUp_CheckOver]
autoTrigger:"""
if memory.Pilot_DefUp_Active==true 
and self.timeAlive>memory.Pilot_DefUp_ActiveTimer
"""
setUnitMemory:"""
Pilot_DefUp_Active=false,
Pilot_DefUp_CDTimer=self.timeAlive+${Pilot_DefUp_CD}
"""