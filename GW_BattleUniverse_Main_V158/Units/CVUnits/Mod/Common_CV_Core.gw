[core]
copyFrom:"""
ROOT:Template/UI/Common_UI.gw
"""


name:CV_Core

showInEditor:true

canNotBeDirectlyAttacked:true

@memory cvUnit:unit

[hiddenAction_InitializeStats]

[hiddenAction_Update]
setUnitMemory:"""
cvUnit=self.attachment(slot="CV_Slot")
"""

[template_CV_HQ]
pos:1
text:Noel Anderson
text_zh:诺埃尔·安德森
displayType:action
buildSpeed:0s
isVisible:if self.attachment(slot="CV_Slot").hp<=0
iconImage:ROOT:Resource/Image/Icon/CV_1.png
playSoundToPlayer:"""
ROOT:Resource/Sound/VC/EF_NOE/NOE_Pickup.ogg:1.25
"""

refundAllQueuedItems:true

attachments_addNewUnits:CV_HQ_EFSF_0079_NOE
attachments_onlyOnSlots:CV_Slot

[attachment_CV_Slot]
x:0
y:0
setDrawLayerOnBottom:false
isVisible:true
keepAliveWhenParentDies:false
canBeAttackedAndDamaged:false
isUnselectable:false
canAttack:false
showAllActionsFrom:true
prioritizeParentsMainTarget:true
smoothlyBlendPositionWhenExistingUnitAdded:false
onConvertKeepExistingUnitInSameSlot:true
onParentTeamChangeKeepCurrentTeam:false
onCreateSpawnUnitOf:CV_HQ_EFSF_0079_NOE


[decal_Core]
layer:beforeUI
order:1
onlyWhileAlive:true
onlyTeam:own
isVisible:true
image:ROOT:Resource/Image/Icon/CV_1.png
imageScale:0.25
xOffsetRelative:0
yOffsetRelative:0






