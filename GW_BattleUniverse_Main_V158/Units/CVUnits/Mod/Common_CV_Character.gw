[core]


name:CV_HQ

tags:CVUnit

showOnMinimap:false
showOnMinimapToEnemies:false
price: 5000
maxHp: 600
mass: 50000

disableAllUnitCollisions:true

buildSpeed: 0.001
radius: 10
fogOfWarSightRange:0

isUnselectable:true
canNotBeGivenOrdersByPlayer:false
canNotBeDamaged:true

disableDeathOnZeroHp:true

showInEditor:false
autoTriggerCooldownTime:0.1s

@memory priorityIndex:float
@memory priorityCDTimer:float

[action_Info]
pos:1
text: Now:${core.displayText}
text_zh: 当前:${core.displayText_zh}

highPriorityQueue:false
allowMultipleInQueue: false
alwaysSinglePress：true
ai_isDisabled:true
displayType:action
iconImage:ROOT:Resource/Image/Icon/CV_1.png

buildSpeed:0s
isVisible:"""
true
"""
[action_DeleteSelf]
pos:2
text: Delete
text_zh: 撤去

highPriorityQueue:false
allowMultipleInQueue: false
alwaysSinglePress：true
ai_isDisabled:true
displayType:action
iconImage:ROOT:Resource/Image/Units/Button/Misc/Exit_1.png

buildSpeed:0s
isVisible:"""
true
"""
deleteSelf:true






[hiddenAction_Check_PriorityCDTimer]
autoTrigger:true
requireConditional:if memory.priorityIndex>0 and self.timeAlive>memory.priorityCDTimer
setUnitMemory:priorityIndex=0




[hiddenAction_Get_Play_PickUp]
autoTriggerOnEvent:newMessage(withTag="Play_PickUp")
playSoundToPlayer:"""

"""

[hiddenAction_Get_Play_SelectUnit]
autoTriggerOnEvent:newMessage(withTag="Play_SelectUnit")
showQuickWarLogToPlayer:Please Select Units
showQuickWarLogToPlayer_zh:请选择出击机体

[hiddenAction_Get_Play_WaitStart]
autoTriggerOnEvent:newMessage(withTag="Play_WaitStart")
showQuickWarLogToPlayer:Please Wait Game Start
showQuickWarLogToPlayer_zh:请等待游戏开始

[hiddenAction_Get_Play_SelectCom]
autoTriggerOnEvent:newMessage(withTag="Play_SelectCom")
showQuickWarLogToPlayer:Please Select Your Team's Commander
showQuickWarLogToPlayer_zh:请投票选择我军指挥官

[hiddenAction_Get_Play_GameStart]
autoTriggerOnEvent:newMessage(withTag="Play_GameStart")
playSoundToPlayer:"""

"""
showQuickWarLogToPlayer:Game Start
showQuickWarLogToPlayer_zh:游戏开始

[hiddenAction_Get_Play_Win]
autoTriggerOnEvent:newMessage(withTag="Play_Win")

[hiddenAction_Get_Play_Lose]
autoTriggerOnEvent:newMessage(withTag="Play_Lose")

[hiddenAction_Get_Play_BaseUnderAttack]
autoTriggerOnEvent:newMessage(withTag="Play_BaseUnderAttack")
showQuickWarLogToPlayer:Base Under Attack
showQuickWarLogToPlayer_zh:基地遭到攻击
alsoTriggerAction:Get_Play_BaseUnderAttack_Step2
setUnitMemory:priorityIndex=1000,priorityCDTimer=self.timeAlive+7
requireConditional:if memory.priorityIndex<1000
[hiddenAction_Get_Play_BaseUnderAttack_Step2]
playSoundToPlayer:ROOT:Resource/Sound/SE/Environment/Warning_4.ogg:1.25

[hiddenAction_Get_Play_AllyACE]
autoTriggerOnEvent:newMessage(withTag="Play_AllyACE")
showQuickWarLogToPlayer:Ally ACE get into the battle
showQuickWarLogToPlayer_zh:我军ACE抵达战场
alsoTriggerAction:Get_Play_AllyACE_Step2
[hiddenAction_Get_Play_AllyACE_Step2]
setUnitMemory:priorityIndex=500,priorityCDTimer=self.timeAlive+7
requireConditional:if memory.priorityIndex<500

[hiddenAction_Get_Play_EnemyACE]
