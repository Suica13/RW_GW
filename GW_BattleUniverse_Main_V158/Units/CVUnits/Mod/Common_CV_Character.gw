[turret_Main_Turret]
x:0
y:0
canShoot:false
projectile:Main_Turret
aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0
shoot_flame:none

[projectile_Main_Turret]

directDamage: 0
life: 1
explodeOnEndOfLife:true
speed: 100
instant:true

explodeEffect:none




