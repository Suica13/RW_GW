requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.TITANS_PMX_000_MS_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.backpackBreaked==false)))) and self.resource.EN>=${TITANS_PMX_000_MS_EN}
