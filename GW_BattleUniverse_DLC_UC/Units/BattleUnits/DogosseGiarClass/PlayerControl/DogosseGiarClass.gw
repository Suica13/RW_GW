alsoTriggerAction:ManualShip_Hold_DogosseGiarClass_Turret_BeamCannon_M1,ManualShip_Hold_DogosseGiarClass_Turret_BeamCannon_M2,ManualShip_Hold_DogosseGiarClass_Turret_BeamCannon_M3,ManualShip_Hold_DogosseGiarClass_Turret_BeamCannon_M4,ManualShip_Hold_DogosseGiarClass_Turret_BeamCannon_M5,ManualShip_Hold_DogosseGiarClass_Turret_BeamCannon_M6,ManualShip_Hold_DogosseGiarClass_Turret_BeamCannon_M7,ManualShip_Hold_DogosseGiarClass_Turret_BeamCannon_M8,ManualShip_Hold_DogosseGiarClass_Turret_BeamCannonS_M1,ManualShip_Hold_DogosseGiarClass_Turret_BeamCannonS_M2,ManualShip_Hold_DogosseGiarClass_Turret_BeamCannonS_M3,ManualShip_Hold_DogosseGiarClass_Turret_BeamCannonS_M4,ManualShip_Hold_DogosseGiarClass_Turret_BeamCannonDB_M1,ManualShip_Hold_DogosseGiarClass_Turret_BeamCannonDB_M2,ManualShip_Hold_DogosseGiarClass_Turret_BeamCannonSB_M1,ManualShip_Hold_DogosseGiarClass_Turret_BeamCannonSB_M2,ManualShip_Hold_DogosseGiarClass_Turret_AA_M1,ManualShip_Hold_DogosseGiarClass_Turret_AA_M2,ManualShip_Hold_DogosseGiarClass_Turret_AA_M3,ManualShip_Hold_DogosseGiarClass_Turret_AA_M4,ManualShip_Hold_DogosseGiarClass_Turret_AA_M5,ManualShip_Hold_DogosseGiarClass_Turret_AA_M6,ManualShip_Hold_DogosseGiarClass_Turret_AA_M7,ManualShip_Hold_DogosseGiarClass_Turret_AA_M8,ManualShip_Hold_DogosseGiarClass_Turret_AA_M9,ManualShip_Hold_DogosseGiarClass_Turret_AA_M10,ManualShip_Hold_DogosseGiarClass_Turret_AA_M11,ManualShip_Hold_DogosseGiarClass_Turret_AA_M12,ManualShip_Hold_DogosseGiarClass_Turret_AA_M13,ManualShip_Hold_DogosseGiarClass_Turret_AA_M14,ManualShip_Hold_DogosseGiarClass_Turret_AA_M15,ManualShip_Hold_DogosseGiarClass_Turret_AA_M16

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:ManualShip_HoldAll,SetOnSkillOff

[action_ManualShip_ArcGroup]
@copyFromSection:template_ManualWeapon
pos:70
text:Firing arcs
text_zh:射界：%{select(memory.manualShipArcGroup==0,'光束炮齐射',select(memory.manualShipArcGroup==1,'防空点射','关闭'))}
description:Cycle firing-arc group / off. Only shown while selected.
description_zh:切换各炮组射界／关闭。仅选中时显示；装填中的炮位调暗。
isLocked:false
requireConditional:if ${manualControlReady}
setUnitMemory:manualShipArcGroup=(memory.manualShipArcGroup+1)%3

[hiddenAction_TryAttack]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_AttackMode_Cqb_WhenHasTarget]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_ResetTargetTags_Step2]
alsoTriggerAction:ManualControl_AfterTransform,ManualControl_RestoreGuard

[action_ChangeAttackRuleMode_Free]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==0 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Guard]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==1 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Hold]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==2 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Shoot]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==0 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Cqb]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==1 and not self.hasTags(includes='inHangar'))

[action_AllowAIOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAI}==false and not self.hasTags(includes='inHangar'))

[action_AllowAssignedOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAssigned}==false and not self.hasTags(includes='inHangar'))

