isVisible:if ${manualControlReady} and ((((true) and (memory.armRBreaked==true) and (memory.armLBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmBR_Yellow_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==true) and (memory.armLBreaked==false)))) and self.resource.EN>=${Common_ArmBR_Yellow_L_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmBR_Yellow_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==true) and (memory.armLBreaked==false)))) and self.resource.EN>=${Common_ArmBR_Yellow_L_EN}
alsoTriggerAction:Common_ArmBR_Yellow_L_Fire
displayType:action

