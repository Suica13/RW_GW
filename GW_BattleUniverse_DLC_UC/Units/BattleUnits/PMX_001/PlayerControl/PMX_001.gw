requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_ArmBR_Yellow_L_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmBR_Yellow_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==true) and (memory.armLBreaked==false)))) and self.resource.EN>=${Common_ArmBR_Yellow_L_EN})
