[core]
@global manualControlImplemented=true
copyFrom:"""
ROOT:Template/Unit/Skill/PlayerControl.gw
"""
dont_load:true

# Form-specific input adapters. Native damage, animations and firing queues are inherited.

[action_Manual_AEUG_MSZ_006A1_BR]
@copyFromSection:template_ManualWeapon
pos:2
text:Beam rifle
text_zh:光束步枪
description:CD: ${AEUG_MSZ_006A1_BR_CD}s
description_zh:冷却: ${AEUG_MSZ_006A1_BR_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady} and self.resource().EquipmentIndex==0
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.AEUG_MSZ_006A1_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and self.resource.EN>0) and (self.resource().EquipmentIndex==0 and memory.armRBreaked==false) and self.resource.EN>=${AEUG_MSZ_006A1_BR_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.AEUG_MSZ_006A1_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and self.resource.EN>0) and (self.resource().EquipmentIndex==0 and memory.armRBreaked==false) and self.resource.EN>=${AEUG_MSZ_006A1_BR_EN}
alsoTriggerAction:AEUG_MSZ_006A1_BR_Fire
displayType:action

[hiddenAction_AEUG_MSZ_006A1_BR_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.AEUG_MSZ_006A1_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.AEUG_MSZ_006A1_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and self.resource.EN>0) and (self.resource().EquipmentIndex==0 and memory.armRBreaked==false) and self.resource.EN>=${AEUG_MSZ_006A1_BR_EN})
addActionCooldownTime:${AEUG_MSZ_006A1_BR_CD}s
addActionCooldownApplyToActions:Manual_AEUG_MSZ_006A1_BR
setUnitMemory:AEUG_MSZ_006A1_BR_CDTimer=self.timeAlive+${AEUG_MSZ_006A1_BR_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[action_Manual_AEUG_MSZ_006A1_HML]
@copyFromSection:template_ManualWeapon
pos:2
text:Missiles
text_zh:导弹
description:CD: ${AEUG_MSZ_006A1_HML_CD}s
description_zh:冷却: ${AEUG_MSZ_006A1_HML_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
isVisible:if ${manualControlReady} and self.resource().EquipmentIndex==1
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.AEUG_MSZ_006A1_HML_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0) and (self.resource().EquipmentIndex==1 and memory.armRBreaked==false) and self.resource.EN>=${AEUG_MSZ_006A1_HML_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.AEUG_MSZ_006A1_HML_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0) and (self.resource().EquipmentIndex==1 and memory.armRBreaked==false) and self.resource.EN>=${AEUG_MSZ_006A1_HML_EN}
alsoTriggerAction:AEUG_MSZ_006A1_HML_Fire
displayType:action

[hiddenAction_AEUG_MSZ_006A1_HML_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.AEUG_MSZ_006A1_HML_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.AEUG_MSZ_006A1_HML_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0) and (self.resource().EquipmentIndex==1 and memory.armRBreaked==false) and self.resource.EN>=${AEUG_MSZ_006A1_HML_EN})
addActionCooldownTime:${AEUG_MSZ_006A1_HML_CD}s
addActionCooldownApplyToActions:Manual_AEUG_MSZ_006A1_HML
setUnitMemory:AEUG_MSZ_006A1_HML_CDTimer=self.timeAlive+${AEUG_MSZ_006A1_HML_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[action_Manual_AEUG_MSZ_006A1_MA_BeamGun]
@copyFromSection:template_ManualWeapon
pos:4
text:Beam guns
text_zh:光束枪
description:CD: ${AEUG_MSZ_006A1_MA_BeamGun_CD}s
description_zh:冷却: ${AEUG_MSZ_006A1_MA_BeamGun_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.AEUG_MSZ_006A1_MA_BeamGun_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0) and (${onAttacking}==false) and self.resource.EN>=${AEUG_MSZ_006A1_MA_BeamGun_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.AEUG_MSZ_006A1_MA_BeamGun_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0) and (${onAttacking}==false) and self.resource.EN>=${AEUG_MSZ_006A1_MA_BeamGun_EN}
alsoTriggerAction:AEUG_MSZ_006A1_MA_BeamGun_Fire
displayType:action

[hiddenAction_AEUG_MSZ_006A1_MA_BeamGun_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.AEUG_MSZ_006A1_MA_BeamGun_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  and not (directionBetween(self, self.attacking) < self.dir-35 or directionBetween(self, self.attacking) > self.dir+35)  and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.AEUG_MSZ_006A1_MA_BeamGun_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0) and (${onAttacking}==false) and self.resource.EN>=${AEUG_MSZ_006A1_MA_BeamGun_EN})
addActionCooldownTime:${AEUG_MSZ_006A1_MA_BeamGun_CD}s
addActionCooldownApplyToActions:Manual_AEUG_MSZ_006A1_MA_BeamGun
setUnitMemory:AEUG_MSZ_006A1_MA_BeamGun_CDTimer=self.timeAlive+${AEUG_MSZ_006A1_MA_BeamGun_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[hiddenAction_AEUG_MSZ_006A1_BR_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_AEUG_MSZ_006A1_BR_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_AEUG_MSZ_006A1_HML_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_AEUG_MSZ_006A1_MA_BeamGun_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_AEUG_MSZ_006A1_MA_BeamGun_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[action_ManualControl_TransformA]
@copyFromSection:action_Transform_LandFlyA
pos:0
autoTrigger:false
isVisible:if memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=0 and not self.hasTags(includes='inHangar'))
requireConditional:if ${manualControlReady} and (true) and not memory.cantTransform and self.timeAlive>=memory.changeTransform_LandFlyCD and ${cantAction}==false and ${onSkill}==false

[action_ManualControl_TransformB]
@copyFromSection:action_Transform_LandFlyB
pos:0
autoTrigger:false
isVisible:if memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=96 and memory.styleIndex!=100 and not self.hasTags(includes='inHangar'))
requireConditional:if ${manualControlReady} and (true) and not memory.cantTransform and self.timeAlive>=memory.changeTransform_LandFlyCD and ${cantAction}==false and ${onSkill}==false

[action_ManualControl_FirstSlot]
isVisible:false
