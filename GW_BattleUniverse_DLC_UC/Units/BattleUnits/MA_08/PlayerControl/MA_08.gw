[core]
@memory manualShipArcGroup:float
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:"""
ROOT:Template/Unit/Skill/PlayerControl.gw,
ROOT:Units/BattleUnits/MA_08/PlayerControl/Ships/Arcs_2644ea9ca929.gw
"""

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_ZN_MA_08_MegaBeamCannon_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false and ${onSkill}==false and self.timeAlive>memory.ZN_MA_08_MegaBeamCannon_CDTimer and not self.hasTags(includes='inHangar') and not parent.hasTags(includes='SFS_Slot') and self.resource.en>${ZN_MA_08_MegaBeamCannon_EN} and memory.ZN_MA_08_MegaBeamCannon_AimTarget.hp>0)

[hiddenAction_ZN_MA_08_MegaBeamCannon_Fire_Step_1]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MA_08_MegaBeamCannon_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

