[hiddenAction_ZN_MA_08_BeamCannon_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>90  and distanceBetween(self,self.attacking)<=memory.finalAttackRange)

[hiddenAction_ZN_MA_08_BeamCannon_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MA_08_Shock_A_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=90)

[hiddenAction_ZN_MA_08_Shock_A_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[action_ZN_MA_08_MegaBeamCannon_Trigger]
pos:65
requireConditional:if (true) and (not memory.manualControlEnabled or ${manualWeaponReady})

[action_ZN_MA_08_AA_BeamCannon_B1_Trigger]
pos:65

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:ManualShip_HoldAll,SetOnSkillOff

[action_Manual_ZN_MA_08_BeamCannon]
@copyFromSection:template_ManualWeapon
pos:2
text:Beam cannon
text_zh:光束炮
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
isVisible:if ${manualControlReady} and ((true))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MA_08_BeamCannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${ZN_MA_08_BeamCannon_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_MA_08_BeamCannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${ZN_MA_08_BeamCannon_EN}
alsoTriggerAction:ZN_MA_08_BeamCannon_Fire
displayType:action

[hiddenAction_ZN_MA_08_BeamCannon_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_MA_08_BeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MA_08_BeamCannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${ZN_MA_08_BeamCannon_EN})
setUnitMemory:ZN_MA_08_BeamCannon_CDTimer=self.timeAlive+${ZN_MA_08_BeamCannon_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZN_MA_08_BeamCannon_CD}s
addActionCooldownApplyToActions:Manual_ZN_MA_08_BeamCannon

[action_Manual_ZN_MA_08_Shock_A]
@copyFromSection:template_ManualWeapon
pos:3
text:Melee
text_zh:格斗攻击
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((true))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MA_08_Shock_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((true)))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_MA_08_Shock_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((true))
alsoTriggerAction:ZN_MA_08_Shock_A_Fire
displayType:action

[hiddenAction_ZN_MA_08_Shock_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_MA_08_Shock_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-60 or directionBetween(self, self.attacking) > self.dir+60) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MA_08_Shock_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((true)))
setUnitMemory:ZN_MA_08_Shock_A_CDTimer=self.timeAlive+${ZN_MA_08_Shock_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZN_MA_08_Shock_A_CD}s
addActionCooldownApplyToActions:Manual_ZN_MA_08_Shock_A

[turret_Common_DoubleVulcan_MA_08]
canAttackCondition:if (not memory.manualControlEnabled or (${manualAuxiliaryReady} and not memory.manualAutoVulcanOff)) and (${cantAction}==false)

[action_ManualAux_Common_DoubleVulcan_MA_08]
@copyFromSection:template_ManualWeapon
pos:40
text:Head Vulcan: %{select(memory.manualAutoVulcanOff,'OFF','ON')}
text_zh:头部火神炮：%{select(memory.manualAutoVulcanOff,'关闭','自动迎击')}
description:Toggle automatic interception. Uses native target selection, ammunition and reload; primary weapons remain available.
description_zh:开关自动迎击。沿用原生索敌、弹药和装填，可与主武器同时使用。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Ciws_1.png
isVisible:if ${manualControlReady}
isLocked:false
requireConditional:if ${manualControlReady}
alsoTriggerAction:NONE
displayType:action
setUnitMemory:manualAutoVulcanOff=not memory.manualAutoVulcanOff,manualVulcanSerial=memory.manualVulcanSerial+1

[hiddenAction_ManualAux_Common_DoubleVulcan_MA_08_Fire]
requireConditional:if (${manualAuxiliaryReady} and not memory.Common_DoubleVulcan_MA_08_OnCD and self.resource.Common_DoubleVulcan_MA_08_ShootTimer>0) and (${cantAction}==false)
setUnitMemory:manualVulcanRightNext=false,manualVulcanSerial=memory.manualVulcanSerial+1,Common_DoubleVulcan_MA_08_OnCD=true,Common_DoubleVulcan_MA_08_CDTimer=self.timeAlive+${Common_DoubleVulcan_MA_08_CD}+self.resource.Common_DoubleVulcan_MA_08_ShootTimer*0.075
spawnUnits:ManualAuxBurst_0079_Common_DoubleVulcan_MA_08

[hiddenAction_ManualAux_Common_DoubleVulcan_MA_08_Shot]
autoTriggerOnEvent:newMessage(withTag='ManualAuxShot_Common_DoubleVulcan_MA_08')
requireConditional:if (${manualAuxiliaryReady} and eventData('burstSerial',type='float')==memory.manualVulcanSerial  and self.resource.Common_DoubleVulcan_MA_08_ShootTimer>0) and (${cantAction}==false)
alsoTriggerAction:ManualAux_Common_DoubleVulcan_MA_08_Left,ManualAux_Common_DoubleVulcan_MA_08_Right,ManualAux_Common_DoubleVulcan_MA_08_Spend

[turret_ManualAux_Common_DoubleVulcan_MA_08_Left]
@copyFromSection:turret_Common_DoubleVulcan_MA_08
canShoot:false
barrelX:-8.0
barrelOffsetX_onOddShots:0

[hiddenAction_ManualAux_Common_DoubleVulcan_MA_08_Left]
requireConditional:if not memory.manualVulcanRightNext
fireTurretXAtGround:ManualAux_Common_DoubleVulcan_MA_08_Left
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[turret_ManualAux_Common_DoubleVulcan_MA_08_Right]
@copyFromSection:turret_Common_DoubleVulcan_MA_08
canShoot:false
barrelX:8.0
barrelOffsetX_onOddShots:0

[hiddenAction_ManualAux_Common_DoubleVulcan_MA_08_Right]
requireConditional:if memory.manualVulcanRightNext
fireTurretXAtGround:ManualAux_Common_DoubleVulcan_MA_08_Right
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_ManualAux_Common_DoubleVulcan_MA_08_Spend]
setUnitMemory:manualVulcanRightNext=not memory.manualVulcanRightNext
addResources:Common_DoubleVulcan_MA_08_ShootTimer=-1

