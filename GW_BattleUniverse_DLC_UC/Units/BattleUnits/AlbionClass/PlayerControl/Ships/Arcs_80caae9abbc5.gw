[core]
dont_load:true

[template_ManualShip_ArcLine]
layer:shadow
order:0
onlyTeam:own
onlyWhenSelectedByOwnPlayer:true
onlyOnNonPreview:true
onlyWhileAlive:true
lineWidth:1

[template_ManualShip_Arc_AlbionClass_Turret_BeamCannon_L1_turret_AlbionClass_Turret_BeamCannon]
@copyFromSection:template_ManualShip_ArcLine
color:#66AAFF
isVisible:if ${manualControlReady} and memory.hideUI==0 and memory.manualShipArcGroup==0 and self.attachment(slot='AlbionClass_Turret_BeamCannon_L1').hp>0 and not self.attachment(slot='AlbionClass_Turret_BeamCannon_L1').readUnitMemory('breaked',type='bool')
alpha:select(not self.attachment(slot='AlbionClass_Turret_BeamCannon_L1').readUnitMemory('AlbionClass_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='AlbionClass_Turret_BeamCannon_L1').resource.AlbionClass_Turret_BeamCannon_ShootTimer>0,0.55,0.15)

