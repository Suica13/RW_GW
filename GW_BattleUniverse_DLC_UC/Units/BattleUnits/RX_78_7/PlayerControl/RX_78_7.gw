isVisible:if ${manualControlReady} and ((((true) and (memory.armLBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmGL_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armLBreaked==false)))) and self.resource.EN>=${Common_ArmGL_L_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmGL_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armLBreaked==false)))) and self.resource.EN>=${Common_ArmGL_L_EN}
alsoTriggerAction:Common_ArmGL_L_Fire
displayType:action

[hiddenAction_Common_ArmGL_L_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_ArmGL_L_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmGL_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armLBreaked==false)))) and self.resource.EN>=${Common_ArmGL_L_EN})
setUnitMemory:Common_ArmGL_L_CDTimer=self.timeAlive+${Common_ArmGL_L_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
