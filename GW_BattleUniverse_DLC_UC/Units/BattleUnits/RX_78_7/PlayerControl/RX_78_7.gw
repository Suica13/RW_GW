iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((self.resource().EquipmentIndex2==0) and (memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSaber_AF_Fast_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((self.resource().EquipmentIndex2==0) and (memory.armRBreaked==false)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSaber_AF_Fast_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((self.resource().EquipmentIndex2==0) and (memory.armRBreaked==false))))
alsoTriggerAction:EF_BeamSaber_AF_Fast_Fire
displayType:action

[hiddenAction_EF_BeamSaber_AF_Fast_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_BeamSaber_AF_Fast_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSaber_AF_Fast_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((self.resource().EquipmentIndex2==0) and (memory.armRBreaked==false)))))
