[core]
dont_load:true
@global manualControlImplemented=true
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw
@memory manualVehicle_Common_DoubleMS_DEPP_ROG_Left:float
@memory manualVehicle_Common_DoubleMS_DEPP_ROG_Next:float

# Use native projectiles, costs, burst delays and reload actions; no weapon polling.

[hiddenAction_Common_Bomb_DEPP_ROG_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>=0  and distanceBetween(self,self.attacking)<=100 and not self.attacking.tags(includes='AirUnit') and self.resource().EquipmentIndex==0 and eventData("RandomWeapon",type="float")>25)

[hiddenAction_Common_Bomb_DEPP_ROG_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_Bomb_DEPP_ROG_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_DoubleMS_DEPP_ROG_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>=150   and distanceBetween(self,self.attacking)<=memory.finalAttackRange and self.resource().EquipmentIndex==0 and eventData("RandomWeapon",type="float")<=25)

[action_Manual_Common_Bomb_DEPP_ROG]
@copyFromSection:template_ManualWeapon
pos:2
text:Bombs
text_zh:炸弹
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
isVisible:if ${manualControlReady} and ((((self.resource().EquipmentIndex==0))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_Bomb_DEPP_ROG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==0)))) and self.resource.EN>=${Common_Bomb_DEPP_ROG_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_Bomb_DEPP_ROG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==0)))) and self.resource.EN>=${Common_Bomb_DEPP_ROG_EN}
alsoTriggerAction:Common_Bomb_DEPP_ROG_Fire

[hiddenAction_Common_Bomb_DEPP_ROG_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Bomb_DEPP_ROG_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  and self.attacking.hp>0 and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_Bomb_DEPP_ROG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==0)))) and self.resource.EN>=${Common_Bomb_DEPP_ROG_EN})
setUnitMemory:Common_Bomb_DEPP_ROG_CDTimer=self.timeAlive+${Common_Bomb_DEPP_ROG_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_Bomb_DEPP_ROG_CD}s
addActionCooldownApplyToActions:Manual_Common_Bomb_DEPP_ROG

[turret_Common_DoubleMS_DEPP_ROG]
canAttackCondition:if not memory.manualControlEnabled and (${cantAction}==false)

[action_ManualVehicle_Common_DoubleMS_DEPP_ROG]
temporarilyAddTags:inBattle
@copyFromSection:template_ManualWeapon
pos:4
text:Missiles
text_zh:导弹
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isLocked:if not (${manualAuxiliaryReady} and (${cantAction}==false) and self.resource.Common_DoubleMS_DEPP_ROG_ShootTimer>=1 and memory.manualVehicle_Common_DoubleMS_DEPP_ROG_Left<=0 and self.timeAlive>=memory.manualVehicle_Common_DoubleMS_DEPP_ROG_Next)
requireConditional:if ${manualAuxiliaryReady} and (${cantAction}==false) and self.resource.Common_DoubleMS_DEPP_ROG_ShootTimer>=1 and memory.manualVehicle_Common_DoubleMS_DEPP_ROG_Left<=0 and self.timeAlive>=memory.manualVehicle_Common_DoubleMS_DEPP_ROG_Next
setUnitMemory:manualVehicle_Common_DoubleMS_DEPP_ROG_Left=max(1,int(self.resource.Common_DoubleMS_DEPP_ROG_ShootTimer/(1)))
alsoTriggerAction:ManualVehicle_Common_DoubleMS_DEPP_ROG_Shot,ManualVehicle_Common_DoubleMS_DEPP_ROG_Continue,ManualVehicle_Common_DoubleMS_DEPP_ROG_Stop

[hiddenAction_ManualVehicle_Common_DoubleMS_DEPP_ROG_Shot]
addResources:Common_DoubleMS_DEPP_ROG_ShootTimer=-1
requireConditional:if ${manualAuxiliaryReady} and (${cantAction}==false) and self.resource.Common_DoubleMS_DEPP_ROG_ShootTimer>=1 and memory.manualVehicle_Common_DoubleMS_DEPP_ROG_Left>0
fireTurretXAtGround:Common_DoubleMS_DEPP_ROG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
setUnitMemory:manualVehicle_Common_DoubleMS_DEPP_ROG_Left=memory.manualVehicle_Common_DoubleMS_DEPP_ROG_Left-1,manualVehicle_Common_DoubleMS_DEPP_ROG_Next=self.timeAlive+0.1
alsoTriggerAction:Check_InBattle_Attack

[hiddenAction_ManualVehicle_Common_DoubleMS_DEPP_ROG_Wait]
highPriorityQueue:false
allowMultipleInQueue:true
buildSpeed:0.1s
alsoTriggerAction:ManualVehicle_Common_DoubleMS_DEPP_ROG_Shot,ManualVehicle_Common_DoubleMS_DEPP_ROG_Continue,ManualVehicle_Common_DoubleMS_DEPP_ROG_Stop

[hiddenAction_ManualVehicle_Common_DoubleMS_DEPP_ROG_Continue]
requireConditional:if ${manualAuxiliaryReady} and (${cantAction}==false) and self.resource.Common_DoubleMS_DEPP_ROG_ShootTimer>=1 and memory.manualVehicle_Common_DoubleMS_DEPP_ROG_Left>0
alsoQueueAction:ManualVehicle_Common_DoubleMS_DEPP_ROG_Wait

[hiddenAction_ManualVehicle_Common_DoubleMS_DEPP_ROG_Stop]
requireConditional:if not (${manualAuxiliaryReady} and (${cantAction}==false) and self.resource.Common_DoubleMS_DEPP_ROG_ShootTimer>=1) or memory.manualVehicle_Common_DoubleMS_DEPP_ROG_Left<=0
setUnitMemory:manualVehicle_Common_DoubleMS_DEPP_ROG_Left=0

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff
setUnitMemory:manualVehicle_Common_DoubleMS_DEPP_ROG_Left=0

[action_Set_AttackMode_Shoot]
autoTrigger:false
isLocked:true
isVisible:if not memory.manualControlEnabled and (memory.attackMode==0 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Cqb]
autoTrigger:false
isLocked:true
isVisible:if not memory.manualControlEnabled and (memory.attackMode==1 and not self.hasTags(includes='inHangar'))
