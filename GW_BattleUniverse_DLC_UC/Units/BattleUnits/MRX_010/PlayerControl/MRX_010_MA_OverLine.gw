[core]
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:"""
ROOT:Template/Unit/Skill/PlayerControl.gw
"""

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_TITANS_MRX_009_ArmBR_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_ArmBR_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_ArmBR_Fire_Step_4]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_ArmBR_Fire_Step_5]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_4]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_5]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_ChestBeam_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>90 and eventData("RandomWeapon",type="float")<=50)

[hiddenAction_TITANS_MRX_009_ChestBeam_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_BeamCannon_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>90 and eventData("RandomWeapon",type="float")>50)

[hiddenAction_TITANS_MRX_009_BeamCannon_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_BeamCannon_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_010_Funnel_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false and ${onSkill}==false and memory.close==false and self.resource.EN>${TITANS_MRX_010_Funnel_EN} and self.timeAlive>memory.TITANS_MRX_010_Funnel_CDTimer and self.parent.hp<=0  and self.attacking.hp>0 and memory.pilotUnit.readUnitMemory("pilotAwakeningSkillFinal",type="float")>=${TITANS_MRX_010_Funnel_PilotAwakeningSkill})

[hiddenAction_TITANS_MRX_010_Funnel_Fire_Step_1]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_010_Funnel_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_MegaBeamCannon_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false and ${onSkill}==false and self.timeAlive>memory.TITANS_MRX_009_MegaBeamCannon_CDTimer and not self.hasTags(includes='inHangar') and not parent.hasTags(includes='SFS_Slot') and self.resource.en>${TITANS_MRX_009_MegaBeamCannon_EN} and memory.TITANS_MRX_009_MegaBeamCannon_AimTarget.hp>0)

[hiddenAction_TITANS_MRX_009_MegaBeamCannon_Fire_Step_1]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_MegaBeamCannon_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[action_Transform_LandFlyB]
isVisible:if not memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=96 and memory.styleIndex!=100 and not self.hasTags(includes='inHangar'))
autoTrigger:if not memory.manualControlEnabled and (self.isControlledByAI()==true and ${allowAI}==true and memory.cantTransform==false and memory.close==false and not self.hasTags(includes='inHangar') and ${cantAction}==false and self.timeAlive>memory.changeTransform_LandFlyCD and memory.flyUnit!=1 and not self.tags(includes='inBattle'))

[action_ManualControl_Transform_LandFlyB]
@copyFromSection:action_Transform_LandFlyB
pos:0
autoTrigger:false
isVisible:if memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=96 and memory.styleIndex!=100 and not self.hasTags(includes='inHangar'))
requireConditional:if ${manualControlReady} and (true) and not memory.cantTransform and ${cantAction}==false and ${onSkill}==false and self.timeAlive>=memory.changeTransform_LandFlyCD

[action_Transform_LandFlyA]
isVisible:if not memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=0 and not self.hasTags(includes='inHangar'))
autoTrigger:if not memory.manualControlEnabled and (false)

[action_ManualControl_Transform_LandFlyA]
@copyFromSection:action_Transform_LandFlyA
pos:0
autoTrigger:false
isVisible:if memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=0 and not self.hasTags(includes='inHangar'))
requireConditional:if ${manualControlReady} and (true) and not memory.cantTransform and ${cantAction}==false and ${onSkill}==false and self.timeAlive>=memory.changeTransform_LandFlyCD

[action_TITANS_MRX_010_Funnel_Trigger]
pos:30
requireConditional:if (true) and (not memory.manualControlEnabled or ${manualWeaponReady})

[action_TITANS_MRX_009_MegaBeamCannon_Trigger]
pos:30
requireConditional:if (true) and (not memory.manualControlEnabled or ${manualWeaponReady})

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff

[action_Manual_TITANS_MRX_009_ChestBeam]
@copyFromSection:template_ManualWeapon
pos:2
text:Chest beam cannon
text_zh:胸部光束炮
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
isVisible:if ${manualControlReady} and ((true))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.TITANS_MRX_009_ChestBeam_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${TITANS_MRX_009_ChestBeam_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.TITANS_MRX_009_ChestBeam_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${TITANS_MRX_009_ChestBeam_EN}
alsoTriggerAction:TITANS_MRX_009_ChestBeam_Fire
displayType:action

[hiddenAction_TITANS_MRX_009_ChestBeam_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.TITANS_MRX_009_ChestBeam_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.TITANS_MRX_009_ChestBeam_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${TITANS_MRX_009_ChestBeam_EN})
setUnitMemory:TITANS_MRX_009_ChestBeam_CDTimer=self.timeAlive+${TITANS_MRX_009_ChestBeam_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${TITANS_MRX_009_ChestBeam_CD}s
addActionCooldownApplyToActions:Manual_TITANS_MRX_009_ChestBeam

[action_Manual_TITANS_MRX_009_BeamCannon]
@copyFromSection:template_ManualWeapon
pos:4
text:Beam cannon
text_zh:光束炮
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
isVisible:if ${manualControlReady} and ((true))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.TITANS_MRX_009_BeamCannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${TITANS_MRX_009_BeamCannon_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.TITANS_MRX_009_BeamCannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${TITANS_MRX_009_BeamCannon_EN}
alsoTriggerAction:TITANS_MRX_009_BeamCannon_Fire
displayType:action

[hiddenAction_TITANS_MRX_009_BeamCannon_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.TITANS_MRX_009_BeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.TITANS_MRX_009_BeamCannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${TITANS_MRX_009_BeamCannon_EN})
setUnitMemory:TITANS_MRX_009_BeamCannon_CDTimer=self.timeAlive+${TITANS_MRX_009_BeamCannon_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${TITANS_MRX_009_BeamCannon_CD}s
addActionCooldownApplyToActions:Manual_TITANS_MRX_009_BeamCannon

[hiddenAction_TryAttack]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_AttackMode_Cqb_WhenHasTarget]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_ResetTargetTags_Step2]
alsoTriggerAction:ManualControl_AfterTransform,ManualControl_RestoreGuard

[action_ChangeAttackRuleMode_Free]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==0 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Guard]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==1 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Hold]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==2 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Shoot]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==0 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Cqb]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==1 and not self.hasTags(includes='inHangar'))

[action_AllowAIOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAI}==false and not self.hasTags(includes='inHangar'))

[action_AllowAssignedOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAssigned}==false and not self.hasTags(includes='inHangar'))

[action_ManualControl_FirstSlot]
isVisible:false
