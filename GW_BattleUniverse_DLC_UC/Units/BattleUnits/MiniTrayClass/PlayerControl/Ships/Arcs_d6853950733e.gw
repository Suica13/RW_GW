[core]
dont_load:true

[template_ManualShip_ArcLine]
layer:shadow
order:0
onlyTeam:own
onlyWhenSelectedByOwnPlayer:true
onlyOnNonPreview:true
onlyWhileAlive:true
lineWidth:1

[template_ManualShip_Arc_MiniTrayClass_Turret_Cannon_L1_turret_MiniTrayClass_Turret_Cannon]
@copyFromSection:template_ManualShip_ArcLine
color:#E6D28C
isVisible:if ${manualControlReady} and memory.hideUI==0 and memory.manualShipArcGroup==0 and self.attachment(slot='MiniTrayClass_Turret_Cannon_L1').hp>0 and not self.attachment(slot='MiniTrayClass_Turret_Cannon_L1').readUnitMemory('breaked',type='bool')
alpha:select(not self.attachment(slot='MiniTrayClass_Turret_Cannon_L1').readUnitMemory('MiniTrayClass_Turret_Cannon_OnCD',type='bool') and self.attachment(slot='MiniTrayClass_Turret_Cannon_L1').resource.MiniTrayClass_Turret_Cannon_ShootTimer>0,0.55,0.15)

