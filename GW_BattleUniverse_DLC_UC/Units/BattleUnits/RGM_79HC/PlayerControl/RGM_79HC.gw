[turret_Common_DoubleVulcan_RGM_79HC]
canAttackCondition:if (not memory.manualControlEnabled or (${manualAuxiliaryReady} and not memory.manualAutoVulcanOff)) and (${cantAction}==false and distanceBetween(self,self.attacking)<=500 and memory.headBreaked==false and (    attacking.tags(includes='Aircraft')     or attacking.tags(includes='Tank')     or attacking.tags(includes='Pilot')     or (memory.attackMode==1 or memory.manualControlEnabled)))

[action_ManualAux_Common_DoubleVulcan_RGM_79HC]
@copyFromSection:template_ManualWeapon
pos:40
text:Head Vulcan: %{select(memory.manualAutoVulcanOff,'OFF','ON')}
text_zh:头部火神炮：%{select(memory.manualAutoVulcanOff,'关闭','自动迎击')}
description:Toggle automatic interception. Uses native target selection, ammunition and reload; primary weapons remain available.
description_zh:开关自动迎击。沿用原生索敌、弹药和装填，可与主武器同时使用。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Ciws_1.png
isVisible:if ${manualControlReady}
isLocked:false
requireConditional:if ${manualControlReady}
alsoTriggerAction:NONE
displayType:action
setUnitMemory:manualAutoVulcanOff=not memory.manualAutoVulcanOff,manualVulcanSerial=memory.manualVulcanSerial+1

[hiddenAction_ManualAux_Common_DoubleVulcan_RGM_79HC_Fire]
requireConditional:if (${manualAuxiliaryReady} and not memory.headBreaked and not memory.Common_DoubleVulcan_RGM_79HC_OnCD and self.resource.Common_DoubleVulcan_RGM_79HC_ShootTimer>0) and ((${cantAction}==false) and (memory.headBreaked==false))
setUnitMemory:manualVulcanRightNext=false,manualVulcanSerial=memory.manualVulcanSerial+1,Common_DoubleVulcan_RGM_79HC_OnCD=true,Common_DoubleVulcan_RGM_79HC_CDTimer=self.timeAlive+${Common_DoubleVulcan_RGM_79HC_CD}+self.resource.Common_DoubleVulcan_RGM_79HC_ShootTimer*0.075
spawnUnits:ManualAuxBurst_0079_Common_DoubleVulcan_RGM_79HC

[hiddenAction_ManualAux_Common_DoubleVulcan_RGM_79HC_Shot]
autoTriggerOnEvent:newMessage(withTag='ManualAuxShot_Common_DoubleVulcan_RGM_79HC')
requireConditional:if (${manualAuxiliaryReady} and eventData('burstSerial',type='float')==memory.manualVulcanSerial  and not memory.headBreaked and self.resource.Common_DoubleVulcan_RGM_79HC_ShootTimer>0) and ((${cantAction}==false) and (memory.headBreaked==false))
alsoTriggerAction:ManualAux_Common_DoubleVulcan_RGM_79HC_Left,ManualAux_Common_DoubleVulcan_RGM_79HC_Right,ManualAux_Common_DoubleVulcan_RGM_79HC_Spend

[turret_ManualAux_Common_DoubleVulcan_RGM_79HC_Left]
@copyFromSection:turret_Common_DoubleVulcan_RGM_79HC
canShoot:false
barrelX:-4.0
barrelOffsetX_onOddShots:0

[hiddenAction_ManualAux_Common_DoubleVulcan_RGM_79HC_Left]
requireConditional:if not memory.manualVulcanRightNext
fireTurretXAtGround:ManualAux_Common_DoubleVulcan_RGM_79HC_Left
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[turret_ManualAux_Common_DoubleVulcan_RGM_79HC_Right]
@copyFromSection:turret_Common_DoubleVulcan_RGM_79HC
canShoot:false
barrelX:4.0
barrelOffsetX_onOddShots:0

[hiddenAction_ManualAux_Common_DoubleVulcan_RGM_79HC_Right]
requireConditional:if memory.manualVulcanRightNext
fireTurretXAtGround:ManualAux_Common_DoubleVulcan_RGM_79HC_Right
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_ManualAux_Common_DoubleVulcan_RGM_79HC_Spend]
setUnitMemory:manualVulcanRightNext=not memory.manualVulcanRightNext
addResources:Common_DoubleVulcan_RGM_79HC_ShootTimer=-1

[hiddenAction_TryAttack]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_AttackMode_Cqb_WhenHasTarget]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_LowPartsForceCqbMode]
requireConditional:if not memory.manualControlEnabled and (memory.attackMode==0 and (memory.armLBreaked==true or self.shield<=0)and memory.armRBreaked==true)

[hiddenAction_ResetTargetTags_Step2]
alsoTriggerAction:ManualControl_AfterTransform,ManualControl_RestoreGuard

[action_ChangeAttackRuleMode_Free]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==0 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Guard]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==1 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Hold]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==2 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Shoot]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==0 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Cqb]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==1 and not self.hasTags(includes='inHangar'))

[action_AllowAIOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAI}==false and not self.hasTags(includes='inHangar'))

[action_AllowAssignedOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAssigned}==false and not self.hasTags(includes='inHangar'))
