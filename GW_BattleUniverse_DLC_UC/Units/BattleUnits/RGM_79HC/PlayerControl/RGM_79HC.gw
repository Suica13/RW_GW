isVisible:if ${manualControlReady} and ((((memory.armLBreaked==false) and (self.shield>0))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.EF_RGM_79HC_ShieldMG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0) and (self.shield>0)) and ((((memory.armLBreaked==false) and (self.shield>0)))) and self.resource.EN>=${EF_RGM_79HC_ShieldMG_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_RGM_79HC_ShieldMG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0) and (self.shield>0)) and ((((memory.armLBreaked==false) and (self.shield>0)))) and self.resource.EN>=${EF_RGM_79HC_ShieldMG_EN}
