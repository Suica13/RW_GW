displayType:action

[hiddenAction_EF_RGM_79HC_ShieldMG_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_RGM_79HC_ShieldMG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0 and self.shield>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.EF_RGM_79HC_ShieldMG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0) and (self.shield>0)) and ((((memory.armLBreaked==false) and (self.shield>0)))) and self.resource.EN>=${EF_RGM_79HC_ShieldMG_EN})
