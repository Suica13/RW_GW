[core]
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:"""
ROOT:Template/Unit/Skill/PlayerControl.gw
"""

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_Common_Push_A_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60   and memory.armRBreaked==true)

[hiddenAction_Common_Push_A_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_LongRangeBeamSniperRifle_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and memory.attackMode==0 and memory.armRBreaked==false  and eventData("RandomWeapon",type="float")>25)

[hiddenAction_ZN_LongRangeBeamSniperRifle_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_LongRangeBeamSniperRifle_Sniper_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false and ${onSkill}==false and self.timeAlive>memory.ZN_LongRangeBeamSniperRifle_Sniper_CDTimer and memory.armRBreaked==false and not self.hasTags(includes='inHangar') and not parent.hasTags(includes='SFS_Slot') and self.resource.en>${ZN_LongRangeBeamSniperRifle_Sniper_EN} and memory.ZN_LongRangeBeamSniperRifle_Sniper_AimTarget.hp>0 and ${ZN_LongRangeBeamSniperRifle_Sniper_CanUse})

[hiddenAction_ZN_LongRangeBeamSniperRifle_Sniper_Fire_Step_1]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_LongRangeBeamSniperRifle_Sniper_Attack]
requireConditional:if (memory.ZN_LongRangeBeamSniperRifle_Sniper_Active==true) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_LongRangeBeamSniperRifle_Sniper_Attack_T]
requireConditional:if (memory.armRBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_Shotgun_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=500 and memory.armRBreaked==false and eventData("RandomWeapon",type="float")<=25)

[hiddenAction_ZN_Shotgun_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_HeatHawk_F_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60 and memory.armRBreaked==false)

[hiddenAction_ZN_HeatHawk_F_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[action_ZN_LongRangeBeamSniperRifle_Sniper_Trigger]
pos:30
requireConditional:if (parent.hp<=0) and (not memory.manualControlEnabled or ${manualWeaponReady})

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff
setUnitMemory:ZN_LongRangeBeamSniperRifle_Sniper_Active=false

[action_Manual_Common_Push_A]
@copyFromSection:template_ManualWeapon
pos:4
text:Punch
text_zh:徒手格斗
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==true))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true))))
alsoTriggerAction:Common_Push_A_Fire
displayType:action

[hiddenAction_Common_Push_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
setUnitMemory:Common_Push_A_CDTimer=self.timeAlive+${Common_Push_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_Push_A_CD}s
addActionCooldownApplyToActions:Manual_Common_Push_A

[action_Manual_ZN_LongRangeBeamSniperRifle]
@copyFromSection:template_ManualWeapon
pos:2
text:Sniper rifle
text_zh:狙击步枪
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_LongRangeBeamSniperRifle_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${ZN_LongRangeBeamSniperRifle_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_LongRangeBeamSniperRifle_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${ZN_LongRangeBeamSniperRifle_EN}
alsoTriggerAction:ZN_LongRangeBeamSniperRifle_Fire
displayType:action

[hiddenAction_ZN_LongRangeBeamSniperRifle_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_LongRangeBeamSniperRifle_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_LongRangeBeamSniperRifle_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${ZN_LongRangeBeamSniperRifle_EN})
setUnitMemory:ZN_LongRangeBeamSniperRifle_CDTimer=self.timeAlive+${ZN_LongRangeBeamSniperRifle_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZN_LongRangeBeamSniperRifle_CD}s
addActionCooldownApplyToActions:Manual_ZN_LongRangeBeamSniperRifle

[action_Manual_ZN_Shotgun]
@copyFromSection:template_ManualWeapon
pos:5
text:Special weapon
text_zh:特殊武装
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_Shotgun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${ZN_Shotgun_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_Shotgun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${ZN_Shotgun_EN}
alsoTriggerAction:ZN_Shotgun_Fire
displayType:action

[hiddenAction_ZN_Shotgun_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_Shotgun_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_Shotgun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${ZN_Shotgun_EN})
setUnitMemory:ZN_Shotgun_CDTimer=self.timeAlive+${ZN_Shotgun_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZN_Shotgun_CD}s
addActionCooldownApplyToActions:Manual_ZN_Shotgun

[action_Manual_ZN_HeatHawk_F]
@copyFromSection:template_ManualWeapon
pos:3
text:Melee weapon
text_zh:近战武器
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_HeatHawk_F_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_HeatHawk_F_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false))))
alsoTriggerAction:ZN_HeatHawk_F_Fire
displayType:action

[hiddenAction_ZN_HeatHawk_F_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_HeatHawk_F_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_HeatHawk_F_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false)))))
setUnitMemory:ZN_HeatHawk_F_CDTimer=self.timeAlive+${ZN_HeatHawk_F_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZN_HeatHawk_F_CD}s
addActionCooldownApplyToActions:Manual_ZN_HeatHawk_F

[hiddenAction_TryAttack]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_AttackMode_Cqb_WhenHasTarget]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_LowPartsForceCqbMode]
requireConditional:if not memory.manualControlEnabled and (memory.attackMode==0 and memory.armRBreaked==true)

[hiddenAction_ResetTargetTags_Step2]
alsoTriggerAction:ManualControl_AfterTransform,ManualControl_RestoreGuard

[action_ChangeAttackRuleMode_Free]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==0 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Guard]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==1 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Hold]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==2 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Shoot]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==0 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Cqb]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==1 and not self.hasTags(includes='inHangar'))

[action_AllowAIOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAI}==false and not self.hasTags(includes='inHangar'))

[action_AllowAssignedOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAssigned}==false and not self.hasTags(includes='inHangar'))
