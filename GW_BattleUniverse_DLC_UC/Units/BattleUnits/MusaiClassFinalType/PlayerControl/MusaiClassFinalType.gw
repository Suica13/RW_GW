[action_ManualShip_Torpedo]
@copyFromSection:template_ManualWeapon
pos:3
text:Missile / torpedo salvo [%{select(self.attachment(slot='MusaiClassFinalType_Turret_MS_M1').hp>0 and not self.attachment(slot='MusaiClassFinalType_Turret_MS_M1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MusaiClassFinalType_Turret_MS_M1').readUnitMemory('MusaiClassFinalType_Turret_MS_OnCD',type='bool') and self.attachment(slot='MusaiClassFinalType_Turret_MS_M1').resource.MusaiClassFinalType_Turret_MS_ShootTimer>0,1,0)+select(self.attachment(slot='MusaiClassFinalType_Turret_MS_M2').hp>0 and not self.attachment(slot='MusaiClassFinalType_Turret_MS_M2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MusaiClassFinalType_Turret_MS_M2').readUnitMemory('MusaiClassFinalType_Turret_MS_OnCD',type='bool') and self.attachment(slot='MusaiClassFinalType_Turret_MS_M2').resource.MusaiClassFinalType_Turret_MS_ShootTimer>0,1,0)+select(self.attachment(slot='MusaiClassFinalType_Turret_MS_M3').hp>0 and not self.attachment(slot='MusaiClassFinalType_Turret_MS_M3').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MusaiClassFinalType_Turret_MS_M3').readUnitMemory('MusaiClassFinalType_Turret_MS_OnCD',type='bool') and self.attachment(slot='MusaiClassFinalType_Turret_MS_M3').resource.MusaiClassFinalType_Turret_MS_ShootTimer>0,1,0)}/3]
text_zh:导弹／鱼雷齐射 [%{select(self.attachment(slot='MusaiClassFinalType_Turret_MS_M1').hp>0 and not self.attachment(slot='MusaiClassFinalType_Turret_MS_M1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MusaiClassFinalType_Turret_MS_M1').readUnitMemory('MusaiClassFinalType_Turret_MS_OnCD',type='bool') and self.attachment(slot='MusaiClassFinalType_Turret_MS_M1').resource.MusaiClassFinalType_Turret_MS_ShootTimer>0,1,0)+select(self.attachment(slot='MusaiClassFinalType_Turret_MS_M2').hp>0 and not self.attachment(slot='MusaiClassFinalType_Turret_MS_M2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MusaiClassFinalType_Turret_MS_M2').readUnitMemory('MusaiClassFinalType_Turret_MS_OnCD',type='bool') and self.attachment(slot='MusaiClassFinalType_Turret_MS_M2').resource.MusaiClassFinalType_Turret_MS_ShootTimer>0,1,0)+select(self.attachment(slot='MusaiClassFinalType_Turret_MS_M3').hp>0 and not self.attachment(slot='MusaiClassFinalType_Turret_MS_M3').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MusaiClassFinalType_Turret_MS_M3').readUnitMemory('MusaiClassFinalType_Turret_MS_OnCD',type='bool') and self.attachment(slot='MusaiClassFinalType_Turret_MS_M3').resource.MusaiClassFinalType_Turret_MS_ShootTimer>0,1,0)}/3]
description:Order ready turrets to fire. Each turret aims at its own target; without a target it fires along its current barrel direction.
description_zh:命令就绪炮位开火；有目标时各自瞄准，无目标时沿炮塔当前朝向发射。损坏或装填中的炮位跳过。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
isLocked:if not ${manualAuxiliaryReady} or ${onSkill} or (select(self.attachment(slot='MusaiClassFinalType_Turret_MS_M1').hp>0 and not self.attachment(slot='MusaiClassFinalType_Turret_MS_M1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MusaiClassFinalType_Turret_MS_M1').readUnitMemory('MusaiClassFinalType_Turret_MS_OnCD',type='bool') and self.attachment(slot='MusaiClassFinalType_Turret_MS_M1').resource.MusaiClassFinalType_Turret_MS_ShootTimer>0,1,0)+select(self.attachment(slot='MusaiClassFinalType_Turret_MS_M2').hp>0 and not self.attachment(slot='MusaiClassFinalType_Turret_MS_M2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MusaiClassFinalType_Turret_MS_M2').readUnitMemory('MusaiClassFinalType_Turret_MS_OnCD',type='bool') and self.attachment(slot='MusaiClassFinalType_Turret_MS_M2').resource.MusaiClassFinalType_Turret_MS_ShootTimer>0,1,0)+select(self.attachment(slot='MusaiClassFinalType_Turret_MS_M3').hp>0 and not self.attachment(slot='MusaiClassFinalType_Turret_MS_M3').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MusaiClassFinalType_Turret_MS_M3').readUnitMemory('MusaiClassFinalType_Turret_MS_OnCD',type='bool') and self.attachment(slot='MusaiClassFinalType_Turret_MS_M3').resource.MusaiClassFinalType_Turret_MS_ShootTimer>0,1,0))<=0 or self.resource.EN<=0
requireConditional:if ${manualAuxiliaryReady} and ${onSkill}==false
alsoTriggerAction:ManualShip_Send_MusaiClassFinalType_Turret_MS_M1,ManualShip_Send_MusaiClassFinalType_Turret_MS_M2,ManualShip_Send_MusaiClassFinalType_Turret_MS_M3
displayType:action

[action_ManualShip_AA]
isVisible:false
requireConditional:false

