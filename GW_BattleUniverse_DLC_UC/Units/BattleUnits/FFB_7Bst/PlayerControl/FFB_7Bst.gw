requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Bomb_FFB_7Bst_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  and self.attacking.hp>0 and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_Bomb_FFB_7Bst_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==0)))) and self.resource.EN>=${Common_Bomb_FFB_7Bst_EN})
