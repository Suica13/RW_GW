[core]
dont_load:true
@global manualControlImplemented=true
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw


# Use native projectiles, costs, burst delays and reload actions; no weapon polling.

[hiddenAction_Common_DoubleMS_PublicClass_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>=50    and distanceBetween(self,self.attacking)<=memory.finalAttackRange and eventData("RandomWeapon",type="float")<=50)

[hiddenAction_Common_DoubleMS_PublicClass_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_DoubleMS_PublicClass_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_DoubleMS_PublicClass_Fire_Step_4]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_PublicClass_AntiShipMS_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_PublicClass_AntiShipMS_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_PublicClass_BeamDiffusionMS_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_PublicClass_BeamDiffusionMS_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[action_Manual_Common_DoubleMS_PublicClass]
@copyFromSection:template_ManualWeapon
pos:2
text:Missiles
text_zh:导弹
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady} and ((true))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_DoubleMS_PublicClass_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${Common_DoubleMS_PublicClass_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_DoubleMS_PublicClass_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${Common_DoubleMS_PublicClass_EN}
alsoTriggerAction:Common_DoubleMS_PublicClass_Fire

[hiddenAction_Common_DoubleMS_PublicClass_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_DoubleMS_PublicClass_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  and not (directionBetween(self, self.attacking) < self.dir-25 or directionBetween(self, self.attacking) > self.dir+25) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_DoubleMS_PublicClass_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${Common_DoubleMS_PublicClass_EN})
setUnitMemory:Common_DoubleMS_PublicClass_CDTimer=self.timeAlive+${Common_DoubleMS_PublicClass_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_DoubleMS_PublicClass_CD}s
addActionCooldownApplyToActions:Manual_Common_DoubleMS_PublicClass

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff

[action_Set_AttackMode_Shoot]
autoTrigger:false
isLocked:true
isVisible:if not memory.manualControlEnabled and (memory.attackMode==0 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Cqb]
autoTrigger:false
isLocked:true
isVisible:if not memory.manualControlEnabled and (memory.attackMode==1 and not self.hasTags(includes='inHangar'))
