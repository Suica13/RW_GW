[core]
dont_load:true
@global manualControlImplemented=true
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw
@memory manualVehicle_Common_DoubleVulcan_MTank_Left:float
@memory manualVehicle_Common_DoubleVulcan_MTank_Next:float
@memory manualVehicle_ZN_MTank_Cannon_Left:float
@memory manualVehicle_ZN_MTank_Cannon_Next:float

# Use native projectiles, costs, burst delays and reload actions; no weapon polling.

[turret_Common_DoubleVulcan_MTank]
canAttackCondition:if not memory.manualControlEnabled and (${onAttacking}==false and ${cantAction}==false)

[action_ManualVehicle_Common_DoubleVulcan_MTank]
temporarilyAddTags:inBattle
@copyFromSection:template_ManualWeapon
pos:2
text:Autocannon
text_zh:机炮
iconImage:ROOT:Resource/Image/Units/Button/Weapon/MachineGun_1.png
isLocked:if not (${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.Common_DoubleVulcan_MTank_ShootTimer>=1 and self.resource.en>=${Common_DoubleVulcan_MTank_EN} and memory.manualVehicle_Common_DoubleVulcan_MTank_Left<=0 and self.timeAlive>=memory.manualVehicle_Common_DoubleVulcan_MTank_Next)
requireConditional:if ${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.Common_DoubleVulcan_MTank_ShootTimer>=1 and self.resource.en>=${Common_DoubleVulcan_MTank_EN} and memory.manualVehicle_Common_DoubleVulcan_MTank_Left<=0 and self.timeAlive>=memory.manualVehicle_Common_DoubleVulcan_MTank_Next
setUnitMemory:manualVehicle_Common_DoubleVulcan_MTank_Left=max(1,int(self.resource.Common_DoubleVulcan_MTank_ShootTimer/(1)))
alsoTriggerAction:ManualVehicle_Common_DoubleVulcan_MTank_Shot,ManualVehicle_Common_DoubleVulcan_MTank_Continue,ManualVehicle_Common_DoubleVulcan_MTank_Stop

[hiddenAction_ManualVehicle_Common_DoubleVulcan_MTank_Shot]
addResources:Common_DoubleVulcan_MTank_ShootTimer=-1,en=-${Common_DoubleVulcan_MTank_EN}
requireConditional:if ${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.Common_DoubleVulcan_MTank_ShootTimer>=1 and self.resource.en>=${Common_DoubleVulcan_MTank_EN} and memory.manualVehicle_Common_DoubleVulcan_MTank_Left>0
fireTurretXAtGround:Common_DoubleVulcan_MTank
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
setUnitMemory:manualVehicle_Common_DoubleVulcan_MTank_Left=memory.manualVehicle_Common_DoubleVulcan_MTank_Left-1,manualVehicle_Common_DoubleVulcan_MTank_Next=self.timeAlive+0.1
alsoTriggerAction:Check_InBattle_Attack

[hiddenAction_ManualVehicle_Common_DoubleVulcan_MTank_Wait]
highPriorityQueue:false
allowMultipleInQueue:true
buildSpeed:0.1s
alsoTriggerAction:ManualVehicle_Common_DoubleVulcan_MTank_Shot,ManualVehicle_Common_DoubleVulcan_MTank_Continue,ManualVehicle_Common_DoubleVulcan_MTank_Stop

[hiddenAction_ManualVehicle_Common_DoubleVulcan_MTank_Continue]
requireConditional:if ${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.Common_DoubleVulcan_MTank_ShootTimer>=1 and self.resource.en>=${Common_DoubleVulcan_MTank_EN} and memory.manualVehicle_Common_DoubleVulcan_MTank_Left>0
alsoQueueAction:ManualVehicle_Common_DoubleVulcan_MTank_Wait

[hiddenAction_ManualVehicle_Common_DoubleVulcan_MTank_Stop]
requireConditional:if not (${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.Common_DoubleVulcan_MTank_ShootTimer>=1 and self.resource.en>=${Common_DoubleVulcan_MTank_EN}) or memory.manualVehicle_Common_DoubleVulcan_MTank_Left<=0
setUnitMemory:manualVehicle_Common_DoubleVulcan_MTank_Left=0

[turret_ZN_MTank_Cannon]
canAttackCondition:if not memory.manualControlEnabled and (${onAttacking}==false and ${cantAction}==false and distanceBetween(self,self.attacking)>150 and ${onSkill}==false)

[action_ManualVehicle_ZN_MTank_Cannon]
temporarilyAddTags:inBattle
@copyFromSection:template_ManualWeapon
pos:4
text:Cannon
text_zh:火炮
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
isLocked:if not (${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false)) and self.resource.ZN_MTank_Cannon_ShootTimer>=1 and self.resource.en>=${ZN_MTank_Cannon_EN} and memory.manualVehicle_ZN_MTank_Cannon_Left<=0 and self.timeAlive>=memory.manualVehicle_ZN_MTank_Cannon_Next)
requireConditional:if ${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false)) and self.resource.ZN_MTank_Cannon_ShootTimer>=1 and self.resource.en>=${ZN_MTank_Cannon_EN} and memory.manualVehicle_ZN_MTank_Cannon_Left<=0 and self.timeAlive>=memory.manualVehicle_ZN_MTank_Cannon_Next
setUnitMemory:manualVehicle_ZN_MTank_Cannon_Left=max(1,int(self.resource.ZN_MTank_Cannon_ShootTimer/(1)))
alsoTriggerAction:ManualVehicle_ZN_MTank_Cannon_Shot,ManualVehicle_ZN_MTank_Cannon_Continue,ManualVehicle_ZN_MTank_Cannon_Stop

[hiddenAction_ManualVehicle_ZN_MTank_Cannon_Shot]
addResources:ZN_MTank_Cannon_ShootTimer=-1,en=-${ZN_MTank_Cannon_EN}
requireConditional:if ${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false)) and self.resource.ZN_MTank_Cannon_ShootTimer>=1 and self.resource.en>=${ZN_MTank_Cannon_EN} and memory.manualVehicle_ZN_MTank_Cannon_Left>0
fireTurretXAtGround:ZN_MTank_Cannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
setUnitMemory:manualVehicle_ZN_MTank_Cannon_Left=memory.manualVehicle_ZN_MTank_Cannon_Left-1,manualVehicle_ZN_MTank_Cannon_Next=self.timeAlive+0.0
alsoTriggerAction:Check_InBattle_Attack

[hiddenAction_ManualVehicle_ZN_MTank_Cannon_Wait]
highPriorityQueue:false
allowMultipleInQueue:true
buildSpeed:0.016666666666666666s
alsoTriggerAction:ManualVehicle_ZN_MTank_Cannon_Shot,ManualVehicle_ZN_MTank_Cannon_Continue,ManualVehicle_ZN_MTank_Cannon_Stop

[hiddenAction_ManualVehicle_ZN_MTank_Cannon_Continue]
requireConditional:if ${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false)) and self.resource.ZN_MTank_Cannon_ShootTimer>=1 and self.resource.en>=${ZN_MTank_Cannon_EN} and memory.manualVehicle_ZN_MTank_Cannon_Left>0
alsoQueueAction:ManualVehicle_ZN_MTank_Cannon_Wait

[hiddenAction_ManualVehicle_ZN_MTank_Cannon_Stop]
requireConditional:if not (${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false)) and self.resource.ZN_MTank_Cannon_ShootTimer>=1 and self.resource.en>=${ZN_MTank_Cannon_EN}) or memory.manualVehicle_ZN_MTank_Cannon_Left<=0
setUnitMemory:manualVehicle_ZN_MTank_Cannon_Left=0

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff
setUnitMemory:manualVehicle_Common_DoubleVulcan_MTank_Left=0,manualVehicle_ZN_MTank_Cannon_Left=0

[action_Set_AttackMode_Shoot]
autoTrigger:false
isLocked:true
isVisible:if not memory.manualControlEnabled and (memory.attackMode==0 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Cqb]
autoTrigger:false
isLocked:true
isVisible:if not memory.manualControlEnabled and (memory.attackMode==1 and not self.hasTags(includes='inHangar'))
