[core]
@global manualControlImplemented=true
copyFrom:"""
ROOT:Template/Unit/Skill/PlayerControl.gw
"""
dont_load:true

# Form-specific input adapters. Native damage, animations and firing queues are inherited.

[action_Manual_AEUG_MSZ_006C1_BeamSmartGun]
@copyFromSection:template_ManualWeapon
pos:2
text:Beam smart gun
text_zh:光束精灵炮
description:CD: ${AEUG_MSZ_006C1_BeamSmartGun_CD}s
description_zh:冷却: ${AEUG_MSZ_006C1_BeamSmartGun_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.AEUG_MSZ_006C1_BeamSmartGun_CDTimer and ${onAttacking}==false and ${cantAction}==false and self.resource.EN>0) and (memory.armRBreaked==false) and self.resource.EN>=${AEUG_MSZ_006C1_BeamSmartGun_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.AEUG_MSZ_006C1_BeamSmartGun_CDTimer and ${onAttacking}==false and ${cantAction}==false and self.resource.EN>0) and (memory.armRBreaked==false) and self.resource.EN>=${AEUG_MSZ_006C1_BeamSmartGun_EN}
alsoTriggerAction:AEUG_MSZ_006C1_BeamSmartGun_Fire
displayType:action

[hiddenAction_AEUG_MSZ_006C1_BeamSmartGun_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.AEUG_MSZ_006C1_BeamSmartGun_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.AEUG_MSZ_006C1_BeamSmartGun_CDTimer and ${onAttacking}==false and ${cantAction}==false and self.resource.EN>0) and (memory.armRBreaked==false) and self.resource.EN>=${AEUG_MSZ_006C1_BeamSmartGun_EN})
addActionCooldownTime:${AEUG_MSZ_006C1_BeamSmartGun_CD}s
addActionCooldownApplyToActions:Manual_AEUG_MSZ_006C1_BeamSmartGun
setUnitMemory:AEUG_MSZ_006C1_BeamSmartGun_CDTimer=self.timeAlive+${AEUG_MSZ_006C1_BeamSmartGun_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[action_Manual_AEUG_MSZ_006A1_MA_BeamGun]
@copyFromSection:template_ManualWeapon
pos:4
text:Beam guns
text_zh:光束枪
description:CD: ${AEUG_MSZ_006A1_MA_BeamGun_CD}s
description_zh:冷却: ${AEUG_MSZ_006A1_MA_BeamGun_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.AEUG_MSZ_006A1_MA_BeamGun_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0) and (${onAttacking}==false) and self.resource.EN>=${AEUG_MSZ_006A1_MA_BeamGun_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.AEUG_MSZ_006A1_MA_BeamGun_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0) and (${onAttacking}==false) and self.resource.EN>=${AEUG_MSZ_006A1_MA_BeamGun_EN}
alsoTriggerAction:AEUG_MSZ_006A1_MA_BeamGun_Fire
displayType:action

[hiddenAction_AEUG_MSZ_006A1_MA_BeamGun_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.AEUG_MSZ_006A1_MA_BeamGun_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  and not (directionBetween(self, self.attacking) < self.dir-35 or directionBetween(self, self.attacking) > self.dir+35)  and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.AEUG_MSZ_006A1_MA_BeamGun_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0) and (${onAttacking}==false) and self.resource.EN>=${AEUG_MSZ_006A1_MA_BeamGun_EN})
addActionCooldownTime:${AEUG_MSZ_006A1_MA_BeamGun_CD}s
addActionCooldownApplyToActions:Manual_AEUG_MSZ_006A1_MA_BeamGun
setUnitMemory:AEUG_MSZ_006A1_MA_BeamGun_CDTimer=self.timeAlive+${AEUG_MSZ_006A1_MA_BeamGun_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[action_Manual_EF_BeamSaber_AF_Large_Blue]
@copyFromSection:template_ManualWeapon
pos:3
text:Beam saber
text_zh:光束军刀
description:CD: ${EF_BeamSaber_AF_Large_Blue_CD}s
description_zh:冷却: ${EF_BeamSaber_AF_Large_Blue_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.EF_BeamSaber_AF_Large_Blue_CDTimer and ${onAttacking}==false and ${cantAction}==false) and (memory.armRBreaked==false))
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.EF_BeamSaber_AF_Large_Blue_CDTimer and ${onAttacking}==false and ${cantAction}==false) and (memory.armRBreaked==false)
alsoTriggerAction:EF_BeamSaber_AF_Large_Blue_Fire
displayType:action

[hiddenAction_EF_BeamSaber_AF_Large_Blue_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_BeamSaber_AF_Large_Blue_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and (self.timeAlive>memory.EF_BeamSaber_AF_Large_Blue_CDTimer and ${onAttacking}==false and ${cantAction}==false) and (memory.armRBreaked==false))
addActionCooldownTime:${EF_BeamSaber_AF_Large_Blue_CD}s
addActionCooldownApplyToActions:Manual_EF_BeamSaber_AF_Large_Blue
setUnitMemory:EF_BeamSaber_AF_Large_Blue_CDTimer=self.timeAlive+${EF_BeamSaber_AF_Large_Blue_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[action_Manual_Common_Push_A]
@copyFromSection:template_ManualWeapon
pos:5
text:Punch
text_zh:徒手格斗
description:CD: ${Common_Push_A_CD}s
description_zh:冷却: ${Common_Push_A_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and memory.armRBreaked
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false) and (memory.armRBreaked==true))
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false) and (memory.armRBreaked==true)
alsoTriggerAction:Common_Push_A_Fire
displayType:action

[hiddenAction_Common_Push_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false) and (memory.armRBreaked==true))
addActionCooldownTime:${Common_Push_A_CD}s
addActionCooldownApplyToActions:Manual_Common_Push_A
setUnitMemory:Common_Push_A_CDTimer=self.timeAlive+${Common_Push_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[hiddenAction_AEUG_MSZ_006C1_BeamSmartGun_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_AEUG_MSZ_006A1_MA_BeamGun_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_AEUG_MSZ_006A1_MA_BeamGun_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_BeamSaber_AF_Large_Blue_Fire_Step_5]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_BeamSaber_AF_Large_Blue_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_Common_Push_A_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[action_AEUG_MSZ_006C1_BeamSmartGun_Sniper_Trigger]
pos:30
requireConditional:if (true) and (not memory.manualControlEnabled or ${manualWeaponReady})

[action_ManualControl_TransformA]
@copyFromSection:action_Transform_LandFlyA
pos:0
autoTrigger:false
isVisible:if memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=0 and not self.hasTags(includes='inHangar'))
requireConditional:if ${manualControlReady} and (true) and not memory.cantTransform and self.timeAlive>=memory.changeTransform_LandFlyCD and ${cantAction}==false and ${onSkill}==false

[action_ManualControl_TransformB]
@copyFromSection:action_Transform_LandFlyB
pos:0
autoTrigger:false
isVisible:if memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=96 and memory.styleIndex!=100 and not self.hasTags(includes='inHangar'))
requireConditional:if ${manualControlReady} and (true) and not memory.cantTransform and self.timeAlive>=memory.changeTransform_LandFlyCD and ${cantAction}==false and ${onSkill}==false

[hiddenAction_AEUG_MSZ_006C1_BeamSmartGun_Sniper_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false and ${onSkill}==false and memory.armRBreaked==false and self.timeAlive>memory.AEUG_MSZ_006C1_BeamSmartGun_Sniper_CDTimer and not self.hasTags(includes='inHangar') and not parent.hasTags(includes='SFS_Slot') and self.resource.en>${AEUG_MSZ_006C1_BeamSmartGun_Sniper_EN} and memory.AEUG_MSZ_006C1_BeamSmartGun_Sniper_AimTarget.hp>0 and ${AEUG_MSZ_006C1_BeamSmartGun_Sniper_CanUse})

[hiddenAction_AEUG_MSZ_006C1_BeamSmartGun_Sniper_Fire_Step_1]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_AEUG_MSZ_006C1_BeamSmartGun_Sniper_Attack_T]
requireConditional:if (memory.armRBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:if memory.AEUG_MSZ_006C1_BeamSmartGun_Sniper_Active
alsoTriggerAction:SetOnSkillOff
setUnitMemory:AEUG_MSZ_006C1_BeamSmartGun_Sniper_Active=false

[action_ManualControl_FirstSlot]
isVisible:false
