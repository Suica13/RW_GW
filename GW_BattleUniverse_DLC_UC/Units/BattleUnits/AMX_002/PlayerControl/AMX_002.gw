[core]
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:"""
ROOT:Template/Unit/Skill/PlayerControl.gw
"""

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_ZN_AMX_002_MegaBeamCannon_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false and ${onSkill}==false and self.timeAlive>memory.ZN_AMX_002_MegaBeamCannon_CDTimer and not self.hasTags(includes='inHangar') and not parent.hasTags(includes='SFS_Slot') and self.resource.en>${ZN_AMX_002_MegaBeamCannon_EN} and memory.ZN_AMX_002_MegaBeamCannon_AimTarget.hp>0)

[hiddenAction_ZN_AMX_002_MegaBeamCannon_Fire_Step_1]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_AMX_002_MegaBeamCannon_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_AMX_002_AntiShipMS_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_AMX_002_AntiShipMS_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_AMX_002_BeamCannon_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and eventData("RandomWeapon",type="float")>50)

[hiddenAction_ZN_AMX_002_BeamCannon_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_AMX_002_MS_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and eventData("RandomWeapon",type="float")<=50)

[hiddenAction_ZN_AMX_002_MS_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_AMX_002_MS_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_AMX_002_MS_Fire_Step_4]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_BeamSaber_Double_L_A_Fixed_AMX_002_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60)

[hiddenAction_EF_BeamSaber_Double_L_A_Fixed_AMX_002_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_BeamSaber_Double_L_A_Fixed_AMX_002_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[action_ZN_AMX_002_MegaBeamCannon_Trigger]
pos:30
requireConditional:if (true) and (not memory.manualControlEnabled or ${manualWeaponReady})

[action_ZN_AMX_002_AntiShipMS_Trigger]
pos:30
requireConditional:if (true) and (not memory.manualControlEnabled or ${manualWeaponReady})

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff

[action_Manual_ZN_AMX_002_BeamCannon]
@copyFromSection:template_ManualWeapon
pos:2
text:Beam cannon
text_zh:光束炮
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
isVisible:if ${manualControlReady} and ((true))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_AMX_002_BeamCannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${ZN_AMX_002_BeamCannon_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_AMX_002_BeamCannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${ZN_AMX_002_BeamCannon_EN}
alsoTriggerAction:ZN_AMX_002_BeamCannon_Fire
displayType:action

[hiddenAction_ZN_AMX_002_BeamCannon_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_AMX_002_BeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_AMX_002_BeamCannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${ZN_AMX_002_BeamCannon_EN})
setUnitMemory:ZN_AMX_002_BeamCannon_CDTimer=self.timeAlive+${ZN_AMX_002_BeamCannon_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZN_AMX_002_BeamCannon_CD}s
addActionCooldownApplyToActions:Manual_ZN_AMX_002_BeamCannon

[action_Manual_ZN_AMX_002_MS]
@copyFromSection:template_ManualWeapon
pos:4
text:Missiles
text_zh:导弹
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
isVisible:if ${manualControlReady} and ((true))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_AMX_002_MS_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${ZN_AMX_002_MS_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_AMX_002_MS_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${ZN_AMX_002_MS_EN}
alsoTriggerAction:ZN_AMX_002_MS_Fire
displayType:action

[hiddenAction_ZN_AMX_002_MS_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_AMX_002_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-60 or directionBetween(self, self.attacking) > self.dir+60)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_AMX_002_MS_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${ZN_AMX_002_MS_EN})
setUnitMemory:ZN_AMX_002_MS_CDTimer=self.timeAlive+${ZN_AMX_002_MS_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZN_AMX_002_MS_CD}s
addActionCooldownApplyToActions:Manual_ZN_AMX_002_MS

[action_Manual_EF_BeamSaber_Double_L_A_Fixed_AMX_002]
@copyFromSection:template_ManualWeapon
pos:3
text:Beam saber
text_zh:光束军刀
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((true))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSaber_Double_L_A_Fixed_AMX_002_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((true)))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSaber_Double_L_A_Fixed_AMX_002_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((true))
alsoTriggerAction:EF_BeamSaber_Double_L_A_Fixed_AMX_002_Fire
displayType:action

[hiddenAction_EF_BeamSaber_Double_L_A_Fixed_AMX_002_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_BeamSaber_Double_L_A_Fixed_AMX_002_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSaber_Double_L_A_Fixed_AMX_002_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((true)))
setUnitMemory:EF_BeamSaber_Double_L_A_Fixed_AMX_002_CDTimer=self.timeAlive+${EF_BeamSaber_Double_L_A_Fixed_AMX_002_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${EF_BeamSaber_Double_L_A_Fixed_AMX_002_CD}s
addActionCooldownApplyToActions:Manual_EF_BeamSaber_Double_L_A_Fixed_AMX_002

[hiddenAction_TryAttack]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_AttackMode_Cqb_WhenHasTarget]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_ResetTargetTags_Step2]
alsoTriggerAction:ManualControl_AfterTransform,ManualControl_RestoreGuard

[action_ChangeAttackRuleMode_Free]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==0 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Guard]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==1 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Hold]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==2 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Shoot]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==0 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Cqb]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==1 and not self.hasTags(includes='inHangar'))

[action_AllowAIOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAI}==false and not self.hasTags(includes='inHangar'))

[action_AllowAssignedOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAssigned}==false and not self.hasTags(includes='inHangar'))
