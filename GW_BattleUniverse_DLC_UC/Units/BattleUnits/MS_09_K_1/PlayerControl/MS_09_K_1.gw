requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_Cannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.backpackBreaked==false)))) and self.resource.EN>=${Common_Cannon_EN}
