isLockedMessage_zh:需完成本时代全部主线，并达到显示的累计科技点门槛。
requireConditional:if self.resource.FactionIndex==1010101 and (self.globalTeamTags(includes='Tech_EFSF_0079_BaseTech') and self.globalTeamTags(includes='Tech_EFSF_0079_AntiMSPlan') and self.globalTeamTags(includes='Tech_EFSF_0079_EarlyTypeMSDevelopmentPlan') and self.globalTeamTags(includes='Tech_EFSF_0079_OperationVDataRecoveryProject') and self.globalTeamTags(includes='Tech_EFSF_0079_GMDevelopmentPlan') and self.globalTeamTags(includes='Tech_EFSF_0079_T2_GMModularizationPlan') and self.globalTeamTags(includes='Tech_EFSF_0079_T2_Luna2TechnologyIntegrationPlan') and self.globalTeamTags(includes='Tech_EFSF_0079_T2_GundamNTCustomPlan') and self.globalTeamTags(includes='Tech_EFSF_0079_T2_GMKaiDevelopmentPlan') and self.globalTeamTags(includes='Tech_EFSF_0079_T2_GLineDevelopmentPlan') and self.globalTeamTags(includes='Tech_EFSF_0079_T2_GPProject')) and self.resource.TechPoint>=memory.ucEraTechBase+16200 and self.hasTags(includes='HQ_NotCaptured')
