[core]
dont_load:true

[template_PMC_BonusPurchase]
buildSpeed:0s
displayType:action
price:Money=5000
highPriorityQueue:true
allowMultipleInQueue:false
canPlayerCancel:false
alwaysSinglePress:true
ai_isDisabled:true
isVisible:if self.hasTags(includes='PMC') and self.hasTags(includes='HQ_NotCaptured')
isLockedMessage:Maximum purchases reached
isLockedMessage_zh:已达到购买上限
alsoTriggerAction:PMC_RefreshControlledBonuses
playSoundToPlayer:ROOT:Resource/Sound/SE/System/Button/Info_1.ogg

[hiddenAction_PMC_RefreshControlledBonuses]
sendMessageTo:memory.manualControlledUnit
sendMessageWithTags:ManualControl_BonusesChanged

[action_PMC_BuyCqb]
@copyFromSection:template_PMC_BonusPurchase
pos:10
text:Melee +5% [%{int(memory.pmcCqbPoints)}/5]
text_zh:格斗 +5% [%{int(memory.pmcCqbPoints)}/5]
description:Additional 5% while directly controlled; additive with base bonuses. 5000 Money per purchase, maximum 5. EN capacity upgrades do not refill EN.
description_zh:直接控制期间额外增加5%格斗，与基础加成相加。每次5000资金，最多购买5次。
iconImage:ROOT:Resource/Image/Units/Button/PowerCustom/ATK_Cqb.png
isLocked:if memory.pmcCqbPoints>=5
requireConditional:if self.hasTags(includes='PMC') and self.hasTags(includes='HQ_NotCaptured') and memory.pmcCqbPoints<5
setUnitMemory:pmcCqbPoints=min(5,memory.pmcCqbPoints+1)

[action_PMC_BuyShoot]
