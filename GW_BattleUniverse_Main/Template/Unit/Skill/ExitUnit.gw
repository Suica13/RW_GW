[core]
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Light_1.gw
"""
dont_load:false

@memory exitUnitBool:bool

[action_ExitUnit]
autoTrigger:"""
if ${allowAI}==true  
and self.hp<self.maxHp*0.25 and self.hp>0 
and not self.hasTags(includes='inHangar') 
and memory.exitUnitBool==false
"""

isVisible:if not self.hasTags(includes='inHangar')
addActionCooldownTime:0
buildSpeed:0s

pos:100
text:Armor Purge
text_zh:抛弃装甲
iconImage:ROOT:Resource/Image/Units/Button/Skill/ArmorPurge.png
displayType:infoOnly


ai_isDisabled:true
spawnEffects:Light_75_NotAttached
playSoundAtUnit:ROOT:Resource/Sound/SE/Action/Common/Transform_4.ogg:0.6


setUnitMemory:"""
selfDetectedTimer=0,
exitUnitBool=true
"""
temporarilyRemoveTags:CanBeDetected
temporarilyAddTags:UnDetected
alsoTriggerAction:"""
Send_ForceUnload_TransportUnits,
SetAttackingOff,
spawnBreakedExitUnitA,
spawnBreakedExitUnitB,
ExitUnit_Send
"""

[hiddenAction_ExitUnit_Send]
sendMessageTo:self
sendMessageWithTags:TryExitUnit

[hiddenAction_ExitUnit_Step2]
autoTriggerOnEvent:newMessage(withTag="TryExitUnit")
setUnitMemory:"""
styleIndex=0
"""
convertTo_keepCurrentTags:false
convertTo_keepCurrentFields:"""
selfRegenRate,
shieldRegen,
maxEnergy,
armour,
mass,
movespeed,
maxTurnSpeed,
maxAttackRange,
nanoRange,
fogOfWarSightRange,
nanoFactorySpeed,
targetHeight
"""
stopLastAnimation:true
alsoTriggerAction:Send_TryClearQueued,Send_TryTransform_ExitUnit


[hiddenAction_Send_TryTransform_ExitUnit]
@copyFromSection:hiddenAction_Send_TryTransform
sendMessageWithData:"""
RecoverHp=0,
RecoverHpPer=1,
RecoverShield=0,
RecoverShieldPer=1,
RecoverEn=0,
RecoverEnPer=1,
ResetTags=1,
ChangeType=0
"""


[effect_Light_75_NotAttached]
@copyFromSection:effect_Light_75
attachedToUnit:false


[hiddenAction_spawnBreakedExitUnitA]
requireConditional:if self.resource().tileMode==0
spawnEffects:"""
breakedExitUnit0_A,
breakedExitUnit1_A,
breakedExitUnit2_A,
breakedExitUnit3_A,
breakedExitUnit4_A,
breakedExitUnit5_A,
breakedExitUnit6_A,
breakedExitUnit7_A,
breakedExitUnit8_A
"""

[hiddenAction_spawnBreakedExitUnitB]
requireConditional:if self.resource().tileMode==1
spawnEffects:"""
breakedExitUnit0_B,
breakedExitUnit1_B,
breakedExitUnit2_B,
breakedExitUnit3_B,
breakedExitUnit4_B,
breakedExitUnit5_B,
breakedExitUnit6_B,
breakedExitUnit7_B,
breakedExitUnit8_B
"""


[effect_breakedExitUnit0_A]
image:SHARED:blank.png
attachedToUnit:false
life:3000
physics:true
physicsGravity:0.5
priority:high
liveAfterAttachedDies:true
dirOffsetRandom:180
drawUnderUnits:true
color:#bda89d
alpha:1
xSpeedRelativeRandom:2
ySpeedRelativeRandom:2
dirSpeedRandom:1
scaleFrom:0.75
scaleTo:0.5
createWhenOverLiquid:false
[effect_breakedExitUnit1_A]
@copyFromSection:effect_breakedExitUnit0_A
image:SHARED:blank.png
[effect_breakedExitUnit2_A]
@copyFromSection:effect_breakedExitUnit0_A
image:SHARED:blank.png
[effect_breakedExitUnit3_A]
@copyFromSection:effect_breakedExitUnit0_A
image:SHARED:blank.png

[effect_breakedExitUnit4_A]
@copyFromSection:effect_breakedExitUnit0_A
image:SHARED:blank.png

[effect_breakedExitUnit5_A]
@copyFromSection:effect_breakedExitUnit0_A
image:SHARED:blank.png

[effect_breakedExitUnit6_A]
@copyFromSection:effect_breakedExitUnit0_A
image:SHARED:blank.png

[effect_breakedExitUnit7_A]
@copyFromSection:effect_breakedExitUnit0_A
image:SHARED:blank.png

[effect_breakedExitUnit8_A]
@copyFromSection:effect_breakedExitUnit0_A
image:SHARED:blank.png



[effect_breakedExitUnit0_B]
image:${effect_breakedExitUnit0_A.image}
attachedToUnit:false
life:2000
priority:high
liveAfterAttachedDies:true
dirOffsetRandom:360
drawUnderUnits:true
color:#FFFFFF
alpha:1
hOffset:0
xSpeedRelativeRandom:0.5
ySpeedRelativeRandom:0.5
dirSpeedRandom:5
scaleFrom:0.65
scaleTo:0.45
createWhenOverLiquid:true
[effect_breakedExitUnit1_B]
@copyFromSection:effect_breakedExitUnit0_B
image:${effect_breakedExitUnit1_A.image}

[effect_breakedExitUnit2_B]
@copyFromSection:effect_breakedExitUnit0_B
image:${effect_breakedExitUnit2_A.image}

[effect_breakedExitUnit3_B]
@copyFromSection:effect_breakedExitUnit0_B
image:${effect_breakedExitUnit3_A.image}

[effect_breakedExitUnit4_B]
@copyFromSection:effect_breakedExitUnit0_B
image:${effect_breakedExitUnit4_A.image}

[effect_breakedExitUnit5_B]
@copyFromSection:effect_breakedExitUnit0_B
image:${effect_breakedExitUnit5_A.image}

[effect_breakedExitUnit6_B]
@copyFromSection:effect_breakedExitUnit0_B
image:${effect_breakedExitUnit6_A.image}

[effect_breakedExitUnit7_B]
@copyFromSection:effect_breakedExitUnit0_B
image:${effect_breakedExitUnit7_A.image}

[effect_breakedExitUnit8_B]
@copyFromSection:effect_breakedExitUnit0_B
image:${effect_breakedExitUnit8_A.image}











