isVisible:if memory.headBreaked==false and memory.close==false and memory.PSAActive==false

[decal_Head_Close]
isVisible:if memory.headBreaked==false and memory.close==true and memory.PSAActive==false

[decal_LeftFoot]
isVisible:if memory.legLBreaked==false and memory.PSAActive==false

[decal_LeftLeg]
isVisible:if memory.legLBreaked==false and memory.PSAActive==false

[decal_RightFoot]
isVisible:if memory.legRBreaked==false and memory.PSAActive==false

[decal_RightLeg]
isVisible:if memory.legRBreaked==false and memory.PSAActive==false





