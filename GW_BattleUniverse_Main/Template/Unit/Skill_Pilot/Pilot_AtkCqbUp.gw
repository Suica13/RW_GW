[core]
dont_load:true
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Flash_1.gw
"""

@memory Pilot_AtkCqbUp_Active:bool
@memory Pilot_AtkCqbUp_ActiveTimer:float
@global Pilot_AtkCqbUp_ActiveTime:15
@memory Pilot_AtkCqbUp_CDTimer:float
@global Pilot_AtkCqbUp_CD=90

@memory Pilot_AtkCqbUp_AtkCqb:float
@global Pilot_AtkCqbUp_AtkCqbUp:1.45





[hiddenAction_Pilot_AtkCqbUp_Check]
autoTrigger:true
setUnitMemory:"""
Pilot_AtkCqbUp_AtkCqb=select(memory.Pilot_AtkCqbUp_Active==true,${Pilot_AtkCqbUp_AtkCqbUp},1)
"""

[hiddenAction_Check_UnitBuffRule_AtkCqb]
setUnitMemory:pilotBuffRuleAtkCqbModifier=1*memory.Pilot_AtkCqbUp_AtkCqb

[action_Pilot_AtkCqbUp_Trigger]
pos:10
text:"""
CqbDamageUp 
%{
    select(memory.Pilot_AtkCqbUp_Active==true,
    str(int(memory.Pilot_AtkCqbUp_ActiveTimer-self.timeAlive))+"s",
    select(self.timeAlive<=memory.Pilot_AtkCqbUp_CDTimer,"CD:" + str(int(memory.Pilot_AtkCqbUp_CDTimer-self.timeAlive))+"s","OK"))
}
"""
text_zh:"""
格斗伤害上升 
%{
    select(memory.Pilot_AtkCqbUp_Active==true,
    str(int(memory.Pilot_AtkCqbUp_ActiveTimer-self.timeAlive))+"秒",
    select(self.timeAlive<=memory.Pilot_AtkCqbUp_CDTimer,"冷却中:" + str(int(memory.Pilot_AtkCqbUp_CDTimer-self.timeAlive))+"秒","OK"))
}
"""
text_KP:100

description:CqbDamage Up 45% in 15sec
description_zh:15秒内格斗伤害提高45%

displayType:infoOnly

price:EN=100

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true
highPriorityQueue:true
ai_isDisabled:true

iconImage:ROOT:Resource/Image/Units/Button/Skill/Pilot_AtkUp_Cqb.png

isVisible:if not self.hasTags(includes='inHangar')



isGuiBlinking:"""
if self.timeAlive>memory.Pilot_AtkCqbUp_CDTimer and memory.Pilot_AtkCqbUp_Active==false
"""

isLocked:if self.timeAlive<=memory.Pilot_AtkCqbUp_CDTimer
isLockedMessage:In CD
isLockedMessage_zh:冷却中
isLockedAlt:if memory.Pilot_AtkCqbUp_Active==true
isLockedAltMessage:In Action
isLockedAltMessage_zh:行动中

alsoTriggerAction:"""
Pilot_AtkCqbUp_Step_1
"""
[hiddenAction_Pilot_AtkCqbUp_Step_1]
spawnEffects:Flash_1_N
playSoundAtUnit:ROOT:Resource/Sound/SE/Action/Common/Action_8.ogg:0.5

setUnitMemory:"""
Pilot_AtkCqbUp_Active=true,
Pilot_AtkCqbUp_ActiveTimer=self.timeAlive+${Pilot_AtkCqbUp_ActiveTime}
"""

[hiddenAction_Pilot_AtkCqbUp_CheckOver]
autoTrigger:"""
if memory.Pilot_AtkCqbUp_Active==true 
and self.timeAlive>memory.Pilot_AtkCqbUp_ActiveTimer
"""
setUnitMemory:"""
Pilot_AtkCqbUp_Active=false,
Pilot_AtkCqbUp_CDTimer=self.timeAlive+${Pilot_AtkCqbUp_CD}
"""