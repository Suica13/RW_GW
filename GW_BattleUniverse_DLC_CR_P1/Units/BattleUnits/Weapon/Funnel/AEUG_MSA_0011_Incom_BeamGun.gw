[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Blue.gw
"""

@memory AEUG_MSA_0011_Incom_BeamGun_CDTimer:float
@global AEUG_MSA_0011_Incom_BeamGun_CD=1.5
@global AEUG_MSA_0011_Incom_BeamGun_EN=25


[turret_AEUG_MSA_0011_Incom_BeamGun]
x:0
y:0

canShoot:false
projectile:AEUG_MSA_0011_Incom_BeamGun_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:0 
barrelY:0
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamGun_3.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Fire_1_Blue_S




[projectile_AEUG_MSA_0011_Incom_BeamGun_Projectile]
directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Blue*1
(
    addResources=
    BeamDamage:6000
    |DpDamage:80
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:65
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""



[hiddenAction_AEUG_MSA_0011_Incom_BeamGun_Trigger]
alsoTriggerAction:"""
AEUG_MSA_0011_Incom_BeamGun_Fire
"""
[hiddenAction_AEUG_MSA_0011_Incom_BeamGun_Fire]
requireConditional:"""
if self.timeAlive>memory.AEUG_MSA_0011_Incom_BeamGun_CDTimer and memory.onAttacking==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:AEUG_MSA_0011_Incom_BeamGun_CDTimer=self.timeAlive+${AEUG_MSA_0011_Incom_BeamGun_CD}
addResources:EN=-${AEUG_MSA_0011_Incom_BeamGun_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
AEUG_MSA_0011_Incom_BeamGun_SetWeaponIndex,
AEUG_MSA_0011_Incom_BeamGun_B1_Step_1
"""
[hiddenAction_AEUG_MSA_0011_Incom_BeamGun_B1_Step_1]
setUnitMemory:"""
AEUG_MSA_0011_Incom_BeamGun_CDTimer=self.timeAlive+${AEUG_MSA_0011_Incom_BeamGun_CD}
"""

alsoQueueAction:"""
AEUG_MSA_0011_Incom_BeamGun_Fire_Step_1,
AEUG_MSA_0011_Incom_BeamGun_Fire_Step_Final
"""




[hiddenAction_AEUG_MSA_0011_Incom_BeamGun_SetWeaponIndex]
isVisible:false


[hiddenAction_AEUG_MSA_0011_Incom_BeamGun_Fire_Step_1]
buildSpeed:0.25s
fireTurretXAtGround:AEUG_MSA_0011_Incom_BeamGun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
whenBuilding_cannotMove:true
[hiddenAction_AEUG_MSA_0011_Incom_BeamGun_Fire_Step_Final]
buildSpeed:0s
alsoTriggerAction:"""
SetAttackingOff
"""