[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw
"""

@memory TITANS_BaseJabber_BeamCannon_CDTimer:float
@global TITANS_BaseJabber_BeamCannon_CD=6
@global TITANS_BaseJabber_BeamCannon_EN=50










[turret_TITANS_BaseJabber_BeamCannon]
x:0
y:0

canShoot:false
showRangeUIGuide:false
projectile:TITANS_BaseJabber_BeamCannon_Projectile

delay:0.1s
limitingRange:1200
limitingAngle:3

canAttackMaxAngle:15
barrelX:0
barrelY:10

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_1.ogg
shoot_sound_vol:0.35
shoot_flame:Beam_Fire_1_Pink_S



[projectile_TITANS_BaseJabber_BeamCannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Pink*1
(
    addResources=
    BeamDamage:3500
    |DpDamage:75
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=0.5
    |AntiAir=1.25
    |AntiLand=1
    |AntiSpace=1.25
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:60
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""




[hiddenAction_TITANS_BaseJabber_BeamCannon_Trigger]
alsoTriggerAction:TITANS_BaseJabber_BeamCannon_Fire
[hiddenAction_TITANS_BaseJabber_BeamCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.TITANS_BaseJabber_BeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  
and not (directionBetween(self, self.attacking) < self.dir-35 or directionBetween(self, self.attacking) > self.dir+35)  
and self.resource.EN>0
"""
setUnitMemory:TITANS_BaseJabber_BeamCannon_CDTimer=self.timeAlive+${TITANS_BaseJabber_BeamCannon_CD} 
addResources:EN=-${TITANS_BaseJabber_BeamCannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
TITANS_BaseJabber_BeamCannon_SetWeaponIndex,
TITANS_BaseJabber_BeamCannon_B3_Step_1
"""
[hiddenAction_TITANS_BaseJabber_BeamCannon_B3_Step_1]
alsoQueueAction:"""
TITANS_BaseJabber_BeamCannon_Fire_Step_1,
TITANS_BaseJabber_BeamCannon_Fire_Step_2,
TITANS_BaseJabber_BeamCannon_Fire_Step_3,
TITANS_BaseJabber_BeamCannon_Fire_Step_3,
TITANS_BaseJabber_BeamCannon_Fire_Step_Final
"""




[hiddenAction_TITANS_BaseJabber_BeamCannon_SetWeaponIndex]
isVisible:false


[hiddenAction_TITANS_BaseJabber_BeamCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
[hiddenAction_TITANS_BaseJabber_BeamCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.0s
fireTurretXAtGround:TITANS_BaseJabber_BeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_TITANS_BaseJabber_BeamCannon_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
fireTurretXAtGround:TITANS_BaseJabber_BeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_TITANS_BaseJabber_BeamCannon_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff