[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory EF_GroundTypeBeamRifle_Blue_CDTimer:float
@global EF_GroundTypeBeamRifle_Blue_CD=2.0
@global EF_GroundTypeBeamRifle_Blue_EN=35





[decal_EF_GroundTypeBeamRifle_Blue]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Beam\Image\EF_GroundTypeBeamRifle_Blue.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 1
yOffsetRelative: 15
dirOffset:0
[decal_EF_GroundTypeBeamRifle_Blue_NotUsing]
@copyFromSection:decal_EF_GroundTypeBeamRifle_Blue
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.9
xOffsetRelative:0
yOffsetRelative:-8.5
dirOffset:-90







[turret_EF_GroundTypeBeamRifle_Blue]
x:0
y:0

canShoot:false
projectile:EF_GroundTypeBeamRifle_Blue_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:9
barrelY:15
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_1.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Pink



[projectile_EF_GroundTypeBeamRifle_Blue_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamRifle_Pink*1
(
    addResources=
    BeamDamage:6000
    |DpDamage:200
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:75
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""





[hiddenAction_EF_GroundTypeBeamRifle_Blue_Trigger]
alsoTriggerAction:EF_GroundTypeBeamRifle_Blue_Fire
[hiddenAction_EF_GroundTypeBeamRifle_Blue_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_GroundTypeBeamRifle_Blue_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:EF_GroundTypeBeamRifle_Blue_CDTimer=self.timeAlive+${EF_GroundTypeBeamRifle_Blue_CD}
addResources:EN=-${EF_GroundTypeBeamRifle_Blue_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_GroundTypeBeamRifle_Blue_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
EF_GroundTypeBeamRifle_Blue_B1_Step_1
"""
[hiddenAction_EF_GroundTypeBeamRifle_Blue_B1_Step_1]
alsoQueueAction:"""
EF_GroundTypeBeamRifle_Blue_Fire_Step_1,
EF_GroundTypeBeamRifle_Blue_Fire_Step_2,
EF_GroundTypeBeamRifle_Blue_Fire_Step_Final
"""



[hiddenAction_EF_GroundTypeBeamRifle_Blue_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_GroundTypeBeamRifle_Blue_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_EF_GroundTypeBeamRifle_Blue_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_GroundTypeBeamRifle_Blue
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_GroundTypeBeamRifle_Blue_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

