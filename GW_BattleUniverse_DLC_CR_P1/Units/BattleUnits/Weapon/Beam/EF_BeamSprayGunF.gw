[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory EF_BeamSprayGunF_CDTimer:float
@global EF_BeamSprayGunF_CD=5
@global EF_BeamSprayGunF_EN=45





[decal_EF_BeamSprayGunF]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Beam\Image\EF_BeamSprayGunF.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 1
yOffsetRelative: 12
dirOffset:0
[decal_EF_BeamSprayGunF_NotUsing]
@copyFromSection:decal_EF_BeamSprayGunF
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.9
xOffsetRelative:1
yOffsetRelative:-8.5
dirOffset:-90





[turret_EF_BeamSprayGunF]
x:0
y:0

canShoot:false
projectile:EF_BeamSprayGunF_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:9
barrelY:8
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamSprayGun_1.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Pink_S



[projectile_EF_BeamSprayGunF_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Pink*1
(
    addResources=
    BeamDamage:2500
    |DpDamage:125
    |WeaponAccuracy=85
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""





[hiddenAction_EF_BeamSprayGunF_Trigger]
alsoTriggerAction:EF_BeamSprayGunF_Fire
[hiddenAction_EF_BeamSprayGunF_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_BeamSprayGunF_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:EF_BeamSprayGunF_CDTimer=self.timeAlive+${EF_BeamSprayGunF_CD}
addResources:EN=-${EF_BeamSprayGunF_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_BeamSprayGunF_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
EF_BeamSprayGunF_B3_Step_1
"""
[hiddenAction_EF_BeamSprayGunF_B3_Step_1]
alsoQueueAction:"""
EF_BeamSprayGunF_Fire_Step_1,
EF_BeamSprayGunF_Fire_Step_2,
EF_BeamSprayGunF_Fire_Step_3,
EF_BeamSprayGunF_Fire_Step_3,
EF_BeamSprayGunF_Fire_Step_Final
"""



[hiddenAction_EF_BeamSprayGunF_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_BeamSprayGunF_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_EF_BeamSprayGunF_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_BeamSprayGunF
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_BeamSprayGunF_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
fireTurretXAtGround:EF_BeamSprayGunF
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_BeamSprayGunF_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

