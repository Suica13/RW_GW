[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Blue.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory AEUG_MSZ_006C1_BeamSmartGun_CDTimer:float
@global AEUG_MSZ_006C1_BeamSmartGun_CD=5
@global AEUG_MSZ_006C1_BeamSmartGun_EN=90





[turret_AEUG_MSZ_006C1_BeamSmartGun]
x:0
y:0

canShoot:false
projectile:AEUG_MSZ_006C1_BeamSmartGun_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:9
barrelY:40
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamCannon_2.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Blue



[projectile_AEUG_MSZ_006C1_BeamSmartGun_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_AP_BeamRifle_Blue*1
(
    addResources=
    BeamDamage:10000
    |BeamAPDamage:5000
    |DpDamage:350
    |WeaponAccuracy=85
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1 
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1 
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=3
    |HeightHitRange=25
    |ProjectileSpeed:150
    |ProjectileSpread:1
    |ProjectileLife:30

    |ProjectileAttackTimes:3
    |ProjectileAttackTimesDamageModifier:0.75

    |EquipmentIndex=2
    |EquipmentIndex2=1000
),

Projectile_BeamSniper_Blue_Effect*1
(
    addResources=
    ProjectileSpeed:0.75
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""





[hiddenAction_AEUG_MSZ_006C1_BeamSmartGun_Trigger]
alsoTriggerAction:AEUG_MSZ_006C1_BeamSmartGun_Fire
[hiddenAction_AEUG_MSZ_006C1_BeamSmartGun_Fire]
requireConditional:"""
if self.timeAlive>memory.AEUG_MSZ_006C1_BeamSmartGun_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:AEUG_MSZ_006C1_BeamSmartGun_CDTimer=self.timeAlive+${AEUG_MSZ_006C1_BeamSmartGun_CD}
addResources:EN=-${AEUG_MSZ_006C1_BeamSmartGun_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
AEUG_MSZ_006C1_BeamSmartGun_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
AEUG_MSZ_006C1_BeamSmartGun_B1_Step_1
"""
[hiddenAction_AEUG_MSZ_006C1_BeamSmartGun_B1_Step_1]
alsoQueueAction:"""
AEUG_MSZ_006C1_BeamSmartGun_Fire_Step_1,
AEUG_MSZ_006C1_BeamSmartGun_Fire_Step_2,
AEUG_MSZ_006C1_BeamSmartGun_Fire_Step_Final
"""



[hiddenAction_AEUG_MSZ_006C1_BeamSmartGun_SetWeaponIndex]
isVisible:false


[hiddenAction_AEUG_MSZ_006C1_BeamSmartGun_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_AEUG_MSZ_006C1_BeamSmartGun_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:AEUG_MSZ_006C1_BeamSmartGun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_AEUG_MSZ_006C1_BeamSmartGun_Fire_Step_Final]
buildSpeed:0.35s
alsoTriggerAction:SetAttackingOff

