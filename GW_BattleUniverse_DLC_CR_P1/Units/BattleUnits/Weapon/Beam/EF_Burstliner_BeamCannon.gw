[hiddenAction_SetOnSkillOn_EF_Burstliner_BeamCannon]
@copyFromSection:hiddenAction_SetOnSkillOn
sendMessageWithData:"""
skillMoveSpeedBuff=1,
skillTurnSpeedBuff=1,
skillShootDefBuff=500.0,
skillSuperArmor=1.0
"""



[hiddenAction_EF_Burstliner_BeamCannon_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_Burstliner_BeamCannon_Fire_Step_1_AI]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:2.0s
spawnEffects:Flash_1_L
whenBuilding_cannotMove:true
playSoundAtUnit:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCannon_6.ogg:3.0
[hiddenAction_EF_Burstliner_BeamCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:2.0s

stopLastAnimation:true
fireTurretXAtGround:EF_Burstliner_BeamCannon
fireTurretXAtGround_count:0
fireTurretXAtGround_withTarget:memory.EF_Burstliner_BeamCannon_AimTarget

whenBuilding_cannotMove:true
whenBuilding_rotateTo_aimAtActionTarget:true
whenBuilding_rotateTo_waitTillRotated:true
playSoundAtUnit:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCannon_6.ogg:3.0
[hiddenAction_EF_Burstliner_BeamCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.1s
whenBuilding_cannotMove:true
fireTurretXAtGround:EF_Burstliner_BeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(x=select(self.dir>90 or self.dir<-90,25,-25),y=1000)
setResourcesWithLogic:"""
EN=self.resource().EN-5
"""

[hiddenAction_EF_Burstliner_BeamCannon_Fire_Step_Final]
buildSpeed:3.0s
whenBuilding_cannotMove:true
alsoTriggerAction:"""
SetAttackingOff,
SetOnSkillOff,
SetAttackingCantAimOff,
SetAttackingCantTurnOff
"""

