[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory EF_FA_78_2_BeamCannon_CDTimer:float
@global EF_FA_78_2_BeamCannon_CD=5.5
@global EF_FA_78_2_BeamCannon_EN=80




[turret_EF_FA_78_2_BeamCannon]
x:0
y:0

canShoot:false
projectile:EF_FA_78_2_BeamCannon_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:7
barrelY:16
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamCannon_2.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Pink



[projectile_EF_FA_78_2_BeamCannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_AP_BeamRifle_Pink*1
(
    addResources=
    BeamDamage:12000
    |BeamAPDamage:4000
    |DpDamage:400
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1 
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1 
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=3
    |HeightHitRange=25
    |ProjectileSpeed:85
    |ProjectileSpread:1
    |ProjectileLife:30

    |ProjectileAttackTimes:2
    |ProjectileAttackTimesDamageModifier:0.75
)
"""





[hiddenAction_EF_FA_78_2_BeamCannon_Trigger]
alsoTriggerAction:EF_FA_78_2_BeamCannon_Fire
[hiddenAction_EF_FA_78_2_BeamCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_FA_78_2_BeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:EF_FA_78_2_BeamCannon_CDTimer=self.timeAlive+${EF_FA_78_2_BeamCannon_CD}
addResources:EN=-${EF_FA_78_2_BeamCannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_FA_78_2_BeamCannon_SetWeaponIndex,
EF_FA_78_2_BeamCannon_B1_Step_1
"""
[hiddenAction_EF_FA_78_2_BeamCannon_B1_Step_1]
alsoQueueAction:"""
EF_FA_78_2_BeamCannon_Fire_Step_1,
EF_FA_78_2_BeamCannon_Fire_Step_2,
EF_FA_78_2_BeamCannon_Fire_Step_3,
EF_FA_78_2_BeamCannon_Fire_Step_Final
"""



[hiddenAction_EF_FA_78_2_BeamCannon_SetWeaponIndex]
isVisible:false



[hiddenAction_EF_FA_78_2_BeamCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
alsoTriggerAction:PlayCommon_Cannon_Shoot_A_Step_1
whenBuilding_cannotMove:true
[hiddenAction_EF_FA_78_2_BeamCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
whenBuilding_cannotMove:true
[hiddenAction_EF_FA_78_2_BeamCannon_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_FA_78_2_BeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_FA_78_2_BeamCannon_Fire_Step_Final]
buildSpeed:1.25s
whenBuilding_cannotMove:true
finishPlayingLastAnimation:true
alsoTriggerAction:SetAttackingOff

