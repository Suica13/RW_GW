[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory TITANS_PMX_001_BeamCannon_CDTimer:float
@global TITANS_PMX_001_BeamCannon_CD=7
@global TITANS_PMX_001_BeamCannon_EN=60





[turret_TITANS_PMX_001_BeamCannon]
x:0
y:0

canShoot:false
projectile:TITANS_PMX_001_BeamCannon_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:23
barrelY:18
idleDir:-5
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_3.ogg
shoot_sound_vol:0.45
shoot_flame:Beam_Fire_1_Yellow
[turret_TITANS_PMX_001_BeamCannon_L]
@copyFromSection:turret_TITANS_PMX_001_BeamCannon
barrelX:-23
idleDir:5


[projectile_TITANS_PMX_001_BeamCannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamShotGun_Yellow*6
(
    offsetRandomDir=9,
    addResources=
    BeamDamage:1500
    |DpDamage:100
    |WeaponAccuracy=90
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:60
    |ProjectileSpread:2
    |ProjectileLife:12
)
"""





[hiddenAction_TITANS_PMX_001_BeamCannon_Trigger]
alsoTriggerAction:TITANS_PMX_001_BeamCannon_Fire
[hiddenAction_TITANS_PMX_001_BeamCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.TITANS_PMX_001_BeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:TITANS_PMX_001_BeamCannon_CDTimer=self.timeAlive+${TITANS_PMX_001_BeamCannon_CD}
addResources:EN=-${TITANS_PMX_001_BeamCannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
PlayCommon_Cannon_Shoot_A_Step_1,
TITANS_PMX_001_BeamCannon_SetWeaponIndex,
TITANS_PMX_001_BeamCannon_B2_Step_1
"""
[hiddenAction_TITANS_PMX_001_BeamCannon_B2_Step_1]
alsoQueueAction:"""
TITANS_PMX_001_BeamCannon_Fire_Step_1,
TITANS_PMX_001_BeamCannon_Fire_Step_2,
TITANS_PMX_001_BeamCannon_Fire_Step_3,
TITANS_PMX_001_BeamCannon_Fire_Step_Final
"""



[hiddenAction_TITANS_PMX_001_BeamCannon_SetWeaponIndex]
isVisible:false


[hiddenAction_TITANS_PMX_001_BeamCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.15s
[hiddenAction_TITANS_PMX_001_BeamCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false 
"""
buildSpeed:0.25s
fireTurretXAtGround:TITANS_PMX_001_BeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_TITANS_PMX_001_BeamCannon_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false 
"""
buildSpeed:0.0s
fireTurretXAtGround:TITANS_PMX_001_BeamCannon_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_TITANS_PMX_001_BeamCannon_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

