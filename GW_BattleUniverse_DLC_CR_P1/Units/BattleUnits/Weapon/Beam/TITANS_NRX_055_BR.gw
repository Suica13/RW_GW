[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""

@memory TITANS_NRX_055_BR_CDTimer:float
@global TITANS_NRX_055_BR_CD=1.5
@global TITANS_NRX_055_BR_EN=40





[decal_TITANS_NRX_055_BR]
layer:beforeBody
order:4.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Beam\Image\TITANS_NRX_055_BR.png
isVisible:false
basePositionFromLegEnd:arm3
imageScale:1
xOffsetRelative: -3
yOffsetRelative: 22
dirOffset:0
[decal_TITANS_NRX_055_BR_NotUsing]
@copyFromSection:decal_TITANS_NRX_055_BR
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.85
xOffsetRelative:1
yOffsetRelative:-10
dirOffset:-90







[turret_TITANS_NRX_055_BR]
x:0
y:0

canShoot:false
projectile:TITANS_NRX_055_BR_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:-11
barrelY:34
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_3.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Yellow



[projectile_TITANS_NRX_055_BR_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_AP_BeamRifle_Yellow*1
(
    addResources=
    BeamDamage:7500
    |DpDamage:225
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:90
    |ProjectileSpread:1
    |ProjectileLife:30

    |ProjectileAttackTimes:2
    |ProjectileAttackTimesDamageModifier:0.5
)
"""





[hiddenAction_TITANS_NRX_055_BR_Trigger]
alsoTriggerAction:TITANS_NRX_055_BR_Fire
[hiddenAction_TITANS_NRX_055_BR_Fire]
requireConditional:"""
if self.timeAlive>memory.TITANS_NRX_055_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:TITANS_NRX_055_BR_CDTimer=self.timeAlive+${TITANS_NRX_055_BR_CD}
addResources:EN=-${TITANS_NRX_055_BR_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
TITANS_NRX_055_BR_SetWeaponIndex,
PlayCommon_Shoot_A_L_Step_1,
TITANS_NRX_055_BR_B3_Step_1
"""
[hiddenAction_TITANS_NRX_055_BR_B3_Step_1]
alsoQueueAction:"""
TITANS_NRX_055_BR_Fire_Step_1,
TITANS_NRX_055_BR_Fire_Step_2,
TITANS_NRX_055_BR_Fire_Step_3,
TITANS_NRX_055_BR_Fire_Step_3,
TITANS_NRX_055_BR_Fire_Step_Final
"""



[hiddenAction_TITANS_NRX_055_BR_SetWeaponIndex]
isVisible:false


[hiddenAction_TITANS_NRX_055_BR_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_TITANS_NRX_055_BR_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:TITANS_NRX_055_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_TITANS_NRX_055_BR_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
fireTurretXAtGround:TITANS_NRX_055_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)


[hiddenAction_TITANS_NRX_055_BR_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

