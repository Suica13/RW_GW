[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory NZN_AMX_003_BG_CDTimer:float
@global NZN_AMX_003_BG_CD=4.5
@global NZN_AMX_003_BG_EN=25










[turret_NZN_AMX_003_BG]
x:0
y:0

canShoot:false
projectile:NZN_AMX_003_BG_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:3
barrelY:0
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamSprayGun_1.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Fire_1_Yellow_S
[turret_NZN_AMX_003_BG_L]
@copyFromSection:turret_NZN_AMX_003_BG
barrelX:-3


[projectile_NZN_AMX_003_BG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Yellow*1
(
    addResources=
    BeamDamage:2000
    |DpDamage:150
    |WeaponAccuracy=85
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=1
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:80
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""





[hiddenAction_NZN_AMX_003_BG_Trigger]
alsoTriggerAction:NZN_AMX_003_BG_Fire
[hiddenAction_NZN_AMX_003_BG_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_AMX_003_BG_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:NZN_AMX_003_BG_CDTimer=self.timeAlive+${NZN_AMX_003_BG_CD}
addResources:EN=-${NZN_AMX_003_BG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
NZN_AMX_003_BG_SetWeaponIndex,
PlayCommon_Cannon_Shoot_A_Step_1,
NZN_AMX_003_BG_B6_Step_1
"""
[hiddenAction_NZN_AMX_003_BG_B6_Step_1]
alsoQueueAction:"""
NZN_AMX_003_BG_Fire_Step_1,
NZN_AMX_003_BG_Fire_Step_2,
NZN_AMX_003_BG_Fire_Step_4,
NZN_AMX_003_BG_Fire_Step_3,
NZN_AMX_003_BG_Fire_Step_4,
NZN_AMX_003_BG_Fire_Step_3,
NZN_AMX_003_BG_Fire_Step_4,
NZN_AMX_003_BG_Fire_Step_Final
"""



[hiddenAction_NZN_AMX_003_BG_SetWeaponIndex]
isVisible:false


[hiddenAction_NZN_AMX_003_BG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_NZN_AMX_003_BG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:NZN_AMX_003_BG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_NZN_AMX_003_BG_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.2s
fireTurretXAtGround:NZN_AMX_003_BG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_NZN_AMX_003_BG_Fire_Step_4]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.2s
fireTurretXAtGround:NZN_AMX_003_BG_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_NZN_AMX_003_BG_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

