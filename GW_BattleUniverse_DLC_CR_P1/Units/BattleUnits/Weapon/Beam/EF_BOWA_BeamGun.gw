[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory EF_BOWA_BeamGun_CDTimer:float
@global EF_BOWA_BeamGun_CD=1.25
@global EF_BOWA_BeamGun_EN=25





[decal_EF_BOWA_BeamGun]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Beam\Image\EF_BOWA_BeamGun.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 0
yOffsetRelative: 13
dirOffset:0
[decal_EF_BOWA_BeamGun_NotUsing]
@copyFromSection:decal_EF_BOWA_BeamGun
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.95
xOffsetRelative:-1
yOffsetRelative:-9.5
dirOffset:-90







[turret_EF_BOWA_BeamGun]
x:0
y:0

canShoot:false
projectile:EF_BOWA_BeamGun_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:8
barrelY:10
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamSprayGun_1.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Pink_S



[projectile_EF_BOWA_BeamGun_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Pink*1
(
    addResources=
    BeamDamage:4250
    |DpDamage:250
    |WeaponAccuracy=85
    |PartBreakModifier=1
    |CockpitBreakModifier=1.25
    |PilotDamageModifier=1.25
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""





[hiddenAction_EF_BOWA_BeamGun_Trigger]
alsoTriggerAction:EF_BOWA_BeamGun_Fire
[hiddenAction_EF_BOWA_BeamGun_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_BOWA_BeamGun_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:EF_BOWA_BeamGun_CDTimer=self.timeAlive+${EF_BOWA_BeamGun_CD}
addResources:EN=-${EF_BOWA_BeamGun_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_BOWA_BeamGun_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
EF_BOWA_BeamGun_B1_Step_1
"""
[hiddenAction_EF_BOWA_BeamGun_B1_Step_1]
alsoQueueAction:"""
EF_BOWA_BeamGun_Fire_Step_1,
EF_BOWA_BeamGun_Fire_Step_2,
EF_BOWA_BeamGun_Fire_Step_Final
"""



[hiddenAction_EF_BOWA_BeamGun_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_BOWA_BeamGun_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.15s
[hiddenAction_EF_BOWA_BeamGun_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_BOWA_BeamGun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_BOWA_BeamGun_Fire_Step_Final]
buildSpeed:0.15s
alsoTriggerAction:SetAttackingOff

