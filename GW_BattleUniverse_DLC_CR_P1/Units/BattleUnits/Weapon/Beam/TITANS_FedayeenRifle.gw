[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_Two_Handed_A.gw
"""

@memory TITANS_FedayeenRifle_CDTimer:float
@global TITANS_FedayeenRifle_CD=2.5
@global TITANS_FedayeenRifle_EN=80





[decal_TITANS_FedayeenRifle]
layer:beforeBody
order:4.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Weapon/Beam/Image/TITANS_FedayeenRifle.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 3
yOffsetRelative: 10
dirOffset:0
[decal_TITANS_FedayeenRifle_NotUsing]
@copyFromSection:decal_TITANS_FedayeenRifle
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.75
xOffsetRelative:11
yOffsetRelative:-9
dirOffset:-90








[turret_TITANS_FedayeenRifle]
x:0
y:0

canShoot:false
projectile:TITANS_FedayeenRifle_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:12
barrelY:35
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_3.ogg
shoot_sound_vol:0.75
shoot_flame:Beam_Fire_1_Yellow



[projectile_TITANS_FedayeenRifle_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_AP_BeamRifle_Yellow*1
(
    addResources=
    BeamDamage:17500
    |DpDamage:375
    |WeaponAccuracy=100
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=1
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:100
    |ProjectileSpread:1
    |ProjectileLife:25

    |ProjectileAttackTimes:2
    |ProjectileAttackTimesDamageModifier:0.75
)
"""





[hiddenAction_TITANS_FedayeenRifle_Trigger]
alsoTriggerAction:TITANS_FedayeenRifle_Fire
[hiddenAction_TITANS_FedayeenRifle_Fire]
requireConditional:"""
if self.timeAlive>memory.TITANS_FedayeenRifle_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:TITANS_FedayeenRifle_CDTimer=self.timeAlive+${TITANS_FedayeenRifle_CD}
addResources:EN=-${TITANS_FedayeenRifle_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
TITANS_FedayeenRifle_SetWeaponIndex,
PlayCommon_Shoot_Two_Handed_A_Step_1,
TITANS_FedayeenRifle_B1_Step_1
"""
[hiddenAction_TITANS_FedayeenRifle_B1_Step_1]
alsoQueueAction:"""
TITANS_FedayeenRifle_Fire_Step_1,
TITANS_FedayeenRifle_Fire_Step_2,
TITANS_FedayeenRifle_Fire_Step_Final
"""



[hiddenAction_TITANS_FedayeenRifle_SetWeaponIndex]
isVisible:false


[hiddenAction_TITANS_FedayeenRifle_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_TITANS_FedayeenRifle_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:TITANS_FedayeenRifle
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_TITANS_FedayeenRifle_Fire_Step_Final]
buildSpeed:0.35s
alsoTriggerAction:SetAttackingOff

