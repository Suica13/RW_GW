[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory NZN_AMX_101K_BeamCannon_CDTimer:float
@global NZN_AMX_101K_BeamCannon_CD=3.5
@global NZN_AMX_101K_BeamCannon_EN=60




[turret_NZN_AMX_101K_BeamCannon]
x:0
y:0

canShoot:false
projectile:NZN_AMX_101K_BeamCannon_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:-7
barrelY:16
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamCannon_2.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Yellow



[projectile_NZN_AMX_101K_BeamCannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_AP_BeamRifle_Yellow*1
(
    addResources=
    BeamDamage:12000
    |BeamAPDamage:4000
    |DpDamage:400
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1 
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1 
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=3
    |HeightHitRange=25
    |ProjectileSpeed:95
    |ProjectileSpread:1
    |ProjectileLife:30

    |ProjectileAttackTimes:2
    |ProjectileAttackTimesDamageModifier:0.75
)
"""





[hiddenAction_NZN_AMX_101K_BeamCannon_Trigger]
alsoTriggerAction:NZN_AMX_101K_BeamCannon_Fire
[hiddenAction_NZN_AMX_101K_BeamCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_AMX_101K_BeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:NZN_AMX_101K_BeamCannon_CDTimer=self.timeAlive+${NZN_AMX_101K_BeamCannon_CD}
addResources:EN=-${NZN_AMX_101K_BeamCannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
PlayCommon_Cannon_Shoot_A_Step_1,
NZN_AMX_101K_BeamCannon_SetWeaponIndex,
NZN_AMX_101K_BeamCannon_B1_Step_1
"""
[hiddenAction_NZN_AMX_101K_BeamCannon_B1_Step_1]
alsoQueueAction:"""
NZN_AMX_101K_BeamCannon_Fire_Step_1,
NZN_AMX_101K_BeamCannon_Fire_Step_2,
NZN_AMX_101K_BeamCannon_Fire_Step_Final
"""



[hiddenAction_NZN_AMX_101K_BeamCannon_SetWeaponIndex]
isVisible:false



[hiddenAction_NZN_AMX_101K_BeamCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.45s
[hiddenAction_NZN_AMX_101K_BeamCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:NZN_AMX_101K_BeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_NZN_AMX_101K_BeamCannon_Fire_Step_Final]
buildSpeed:1.0s
finishPlayingLastAnimation:true
alsoTriggerAction:SetAttackingOff

