[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_StandShoot_A.gw
"""

@memory TITANS_PMX_000_MegaBeamCannon_CDTimer:float
@global TITANS_PMX_000_MegaBeamCannon_CD=10
@global TITANS_PMX_000_MegaBeamCannon_EN=80

@memory TITANS_PMX_000_MegaBeamCannon_ChargeEffect_1:unit
@memory TITANS_PMX_000_MegaBeamCannon_BulletEffect_1:unit


[decal_TITANS_PMX_000_MegaBeamCannon_Range]
layer: inactive
order:0
onlyTeam:own
alpha:1
image:ROOT:Resource/Image/Ring/Ring150_Action.png
imageScale:3.5
basePosition:self
alwaysStartDirAtZero:true
onlyWhileAlive:true
isVisible:if true





[turret_TITANS_PMX_000_MegaBeamCannon]
x:0
y:0

canShoot:false
projectile:TITANS_PMX_000_MegaBeamCannon_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:0
barrelY:0
limitingAngle:0
limitingRange:500
limitingMinRange:300

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamCannon_2.ogg
shoot_sound_vol:0
shoot_flame:none



[projectile_TITANS_PMX_000_MegaBeamCannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_AP_BeamRifle_Yellow_Alpha0*1
(
    addResources=
    BeamDamage:3500
    |DpDamage:75
    |WeaponAccuracy=85
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=1.0
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:150
    |ProjectileSpread:1
    |ProjectileLife:3.75

    |ProjectileAttackTimes:7
    |ProjectileAttackTimesDamageModifier:0.5



    |EquipmentIndex=2
    |EquipmentIndex2=600
)
"""




[attachment_TITANS_PMX_000_MegaBeamCannon_ChargeEffect_1]
x:0
y:-5
isVisible:true
keepAliveWhenParentDies:false
canBeAttackedAndDamaged:false
isUnselectable:true
canAttack:false
showAllActionsFrom:true
onConvertKeepExistingUnitInSameSlot:true
idleDir:0
resetRotationWhenNotAttacking:true

[hiddenAction_TITANS_PMX_000_MegaBeamCannon_ChargeEffect_1_AwakeSet]
autoTriggerOnEvent:newMessage(withTag="UnitTurretSpawn")
alsoTriggerAction:"""
TITANS_PMX_000_MegaBeamCannon_ChargeEffect_1_StartSet
"""
attachments_addNewUnits:Beam_Charge_1_EffectUnit
attachments_onlyOnSlots:TITANS_PMX_000_MegaBeamCannon_ChargeEffect_1

[hiddenAction_TITANS_PMX_000_MegaBeamCannon_ChargeEffect_1_StartSet]
setUnitMemory:TITANS_PMX_000_MegaBeamCannon_ChargeEffect_1=self.attachment(slot='TITANS_PMX_000_MegaBeamCannon_ChargeEffect_1')
alsoTriggerAction:"""
TITANS_PMX_000_MegaBeamCannon_ChargeEffect_1_SetColor,
TITANS_PMX_000_MegaBeamCannon_ChargeEffect_1_SetSpeed
"""

[hiddenAction_TITANS_PMX_000_MegaBeamCannon_ChargeEffect_1_SetColor]
sendMessageTo:memory.TITANS_PMX_000_MegaBeamCannon_ChargeEffect_1
sendMessageWithTags:SetColor_Yellow
[hiddenAction_TITANS_PMX_000_MegaBeamCannon_ChargeEffect_1_SetSpeed]
sendMessageTo:memory.TITANS_PMX_000_MegaBeamCannon_ChargeEffect_1
sendMessageWithTags:SetSpeed
sendMessageWithData:Speed=5

[hiddenAction_TITANS_PMX_000_MegaBeamCannon_Fire_Step_ChargeEffect_1]
requireConditional:if ${cantAction}==false
buildSpeed:0s
sendMessageTo:memory.TITANS_PMX_000_MegaBeamCannon_ChargeEffect_1
sendMessageWithTags:PlayOneTime
playSoundAtUnit:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCharge_1.ogg:2.0


[attachment_TITANS_PMX_000_MegaBeamCannon_BulletEffect_1]
x:0
y:-5
isVisible:true
keepAliveWhenParentDies:false
canBeAttackedAndDamaged:false
isUnselectable:true
canAttack:false
showAllActionsFrom:true
onConvertKeepExistingUnitInSameSlot:true
idleDir:0
resetRotationWhenNotAttacking:true

[hiddenAction_TITANS_PMX_000_MegaBeamCannon_BulletEffect_1_AwakeSet]
autoTriggerOnEvent:newMessage(withTag="UnitTurretSpawn")
alsoTriggerAction:"""
TITANS_PMX_000_MegaBeamCannon_BulletEffect_1_StartSet
"""
attachments_addNewUnits:HighBeamRifle_1_Fast_EffectUnit
attachments_onlyOnSlots:TITANS_PMX_000_MegaBeamCannon_BulletEffect_1

[hiddenAction_TITANS_PMX_000_MegaBeamCannon_BulletEffect_1_StartSet]
setUnitMemory:TITANS_PMX_000_MegaBeamCannon_BulletEffect_1=self.attachment(slot='TITANS_PMX_000_MegaBeamCannon_BulletEffect_1')
alsoTriggerAction:"""
TITANS_PMX_000_MegaBeamCannon_BulletEffect_1_SetColor,
TITANS_PMX_000_MegaBeamCannon_BulletEffect_1_SetSpeed
"""

[hiddenAction_TITANS_PMX_000_MegaBeamCannon_BulletEffect_1_SetColor]
sendMessageTo:memory.TITANS_PMX_000_MegaBeamCannon_BulletEffect_1
sendMessageWithTags:SetColor_Yellow
[hiddenAction_TITANS_PMX_000_MegaBeamCannon_BulletEffect_1_SetSpeed]
sendMessageTo:memory.TITANS_PMX_000_MegaBeamCannon_BulletEffect_1
sendMessageWithTags:SetSpeed
sendMessageWithData:Speed=8

[hiddenAction_TITANS_PMX_000_MegaBeamCannon_Fire_Step_BulletEffect_1]
requireConditional:if ${cantAction}==false
buildSpeed:0s
sendMessageTo:memory.TITANS_PMX_000_MegaBeamCannon_BulletEffect_1
sendMessageWithTags:PlayOneTime

[hiddenAction_TITANS_PMX_000_MegaBeamCannon_BulletEffect_1_StopPlay]
buildSpeed:0s
sendMessageTo:memory.TITANS_PMX_000_MegaBeamCannon_BulletEffect_1
sendMessageWithTags:StopPlay









[hiddenAction_TITANS_PMX_000_MegaBeamCannon_Trigger]
alsoTriggerAction:TITANS_PMX_000_MegaBeamCannon_Fire
[hiddenAction_TITANS_PMX_000_MegaBeamCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.TITANS_PMX_000_MegaBeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:TITANS_PMX_000_MegaBeamCannon_CDTimer=self.timeAlive+${TITANS_PMX_000_MegaBeamCannon_CD}
addResources:EN=-${TITANS_PMX_000_MegaBeamCannon_EN}

alsoTriggerAction:"""
SetAttackingOn,
SetOnSkillOn_TITANS_PMX_000_MegaBeamCannon,
SendEnemyTryAttack_Shoot,
PlayCommon_StandShoot_A_Step_1,
TITANS_PMX_000_MegaBeamCannon_SetWeaponIndex,
TITANS_PMX_000_MegaBeamCannon_B1_Step_1
"""
[hiddenAction_TITANS_PMX_000_MegaBeamCannon_B1_Step_1]
alsoQueueAction:"""
TITANS_PMX_000_MegaBeamCannon_Fire_Step_ChargeEffect_1,
TITANS_PMX_000_MegaBeamCannon_Fire_Step_1,
TITANS_PMX_000_MegaBeamCannon_Fire_Step_BulletEffect_1,

TITANS_PMX_000_MegaBeamCannon_Fire_Step_2,
TITANS_PMX_000_MegaBeamCannon_Fire_Step_2,
TITANS_PMX_000_MegaBeamCannon_Fire_Step_2,
TITANS_PMX_000_MegaBeamCannon_Fire_Step_2,
TITANS_PMX_000_MegaBeamCannon_Fire_Step_2,
TITANS_PMX_000_MegaBeamCannon_Fire_Step_2,

TITANS_PMX_000_MegaBeamCannon_Fire_Step_Final,
TITANS_PMX_000_MegaBeamCannon_BulletEffect_1_StopPlay
"""





[hiddenAction_SetOnSkillOn_TITANS_PMX_000_MegaBeamCannon]
@copyFromSection:hiddenAction_SetOnSkillOn
sendMessageWithData:"""
skillMoveSpeedBuff=0.75,,
skillTurnSpeedBuff=0.05
"""




[hiddenAction_TITANS_PMX_000_MegaBeamCannon_SetWeaponIndex]
isVisible:false


[hiddenAction_TITANS_PMX_000_MegaBeamCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.65s

[hiddenAction_TITANS_PMX_000_MegaBeamCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.05s

fireTurretXAtGround:TITANS_PMX_000_MegaBeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:"""
PlayCommon_StandShoot_A_Step_1
"""
[hiddenAction_TITANS_PMX_000_MegaBeamCannon_Fire_Step_Final]
buildSpeed:1.5s
alsoTriggerAction:"""
SetAttackingOff,
SetOnSkillOff,
SetAttackingCantTurnOff
"""

