[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_StandShoot_A.gw
"""

@memory ZN_MS_10_MS_AMS_CDTimer:float
@global ZN_MS_10_MS_AMS_CD=12
@global ZN_MS_10_MS_AMS_EN=120





[decal_ZN_MS_10_MS_AMS]
layer:beforeBody
order:4.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\ZN_MS_10_MS.png
isVisible:false
basePositionFromLegEnd:arm4
total_frames:2
frame:1
imageScale:0.75
xOffsetRelative: -9
yOffsetRelative: 24
dirOffset:0






[turret_ZN_MS_10_MS_AMS]
x:0
y:0

canShoot:false
projectile:ZN_MS_10_MS_AMS_Projectile

delay:0.5s
canAttackMaxAngle:15
barrelX:-11
barrelY:22
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1

[turret_ZN_MS_10_MS_AMS_R]
@copyFromSection:turret_ZN_MS_10_MS_AMS
barrelX:11


[projectile_ZN_MS_10_MS_AMS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_ASP_BurningArea_B*1
(
    addResources=
    ShellDamage:3500
    |DpDamage:100
    |WeaponAccuracy=75
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.5
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.5
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:25
    |ProjectileSpread:0
    |ProjectileExplosionRange:55
    |ProjectileLife:50
)
"""








[hiddenAction_ZN_MS_10_MS_AMS_Trigger]
alsoTriggerAction:ZN_MS_10_MS_AMS_Fire
[hiddenAction_ZN_MS_10_MS_AMS_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MS_10_MS_AMS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:ZN_MS_10_MS_AMS_CDTimer=self.timeAlive+${ZN_MS_10_MS_AMS_CD}
addResources:EN=-${ZN_MS_10_MS_AMS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_MS_10_MS_AMS_SetWeaponIndex,
PlayCommon_StandShoot_A_Step_1,
ZN_MS_10_MS_AMS_B2_Step_1
"""
[hiddenAction_ZN_MS_10_MS_AMS_B2_Step_1]
alsoQueueAction:"""
ZN_MS_10_MS_AMS_Fire_Step_1,
ZN_MS_10_MS_AMS_Fire_Step_2,
ZN_MS_10_MS_AMS_Fire_Step_3,
ZN_MS_10_MS_AMS_Fire_Step_Final
"""




[hiddenAction_ZN_MS_10_MS_AMS_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MS_10_MS_AMS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_ZN_MS_10_MS_AMS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_MS_10_MS_AMS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MS_10_MS_AMS_Fire_Step_3]
@copyFromSection:hiddenAction_ZN_MS_10_MS_AMS_Fire_Step_2
buildSpeed:${turret_ZN_MS_10_MS_AMS.delay}
fireTurretXAtGround:ZN_MS_10_MS_AMS_R
[hiddenAction_ZN_MS_10_MS_AMS_Fire_Step_Final]
buildSpeed:0.35s
alsoTriggerAction:SetAttackingOff


