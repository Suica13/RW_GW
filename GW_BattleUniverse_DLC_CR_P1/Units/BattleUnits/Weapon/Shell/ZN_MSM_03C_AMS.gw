[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""

@memory ZN_MSM_03C_AMS_CDTimer:float
@global ZN_MSM_03C_AMS_CD=60
@global ZN_MSM_03C_AMS_EN=120








[turret_ZN_MSM_03C_AMS]
x:0
y:0

canShoot:false
projectile:ZN_MSM_03C_AMS_Projectile

delay:0.5s
canAttackMaxAngle:15
barrelX:-16
barrelY:14
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_ZN_MSM_03C_AMS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_ASP_BurningArea_B*1
(
    addResources=
    ShellDamage:8000
    |DpDamage:100
    |WeaponAccuracy=75
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.5
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.5
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:25
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:50
    
    |ProjectileBlastRange:60
    |ProjectileBlastDamageModifier:0.25
    |ProjectileBlastDpModifier:1
)
"""








[hiddenAction_ZN_MSM_03C_AMS_Trigger]
alsoTriggerAction:ZN_MSM_03C_AMS_Fire
[hiddenAction_ZN_MSM_03C_AMS_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MSM_03C_AMS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:ZN_MSM_03C_AMS_CDTimer=self.timeAlive+${ZN_MSM_03C_AMS_CD}
addResources:EN=-${ZN_MSM_03C_AMS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_MSM_03C_AMS_SetWeaponIndex,
PlayCommon_Shoot_A_L_Step_1,
ZN_MSM_03C_AMS_B1_Step_1
"""
[hiddenAction_ZN_MSM_03C_AMS_B1_Step_1]
alsoQueueAction:"""
ZN_MSM_03C_AMS_Fire_Step_1,
ZN_MSM_03C_AMS_Fire_Step_2,
ZN_MSM_03C_AMS_Fire_Step_Final
"""




[hiddenAction_ZN_MSM_03C_AMS_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MSM_03C_AMS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_ZN_MSM_03C_AMS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_MSM_03C_AMS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MSM_03C_AMS_Fire_Step_3]
@copyFromSection:hiddenAction_ZN_MSM_03C_AMS_Fire_Step_2
buildSpeed:${turret_ZN_MSM_03C_AMS.delay}
[hiddenAction_ZN_MSM_03C_AMS_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


