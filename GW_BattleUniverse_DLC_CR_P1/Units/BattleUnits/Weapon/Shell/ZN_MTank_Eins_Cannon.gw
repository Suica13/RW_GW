[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw
"""
@memory ZN_MTank_Eins_Cannon_OnCD:bool
@memory ZN_MTank_Eins_Cannon_CDTimer:float
@global ZN_MTank_Eins_Cannon_CD=3
@global ZN_MTank_Eins_Cannon_EN=20

@global ZN_MTank_Eins_Cannon_Shoot=1
[resource_ZN_MTank_Eins_Cannon_ShootTimer]
hidden:true







[turret_ZN_MTank_Eins_Cannon]
x:0
y:-3.5

canShoot:true
canAttackCondition:"""
if ${onAttacking}==false and ${cantAction}==false 
"""
showRangeUIGuide:false
projectile:ZN_MTank_Eins_Cannon_Projectile
resourceUsage:ZN_MTank_Eins_Cannon_ShootTimer=1,en=${ZN_MTank_Eins_Cannon_EN}

delay:0.0s
canAttackMaxAngle:3
barrelX:3
barrelOffsetX_onOddShots:-6
barrelY:15
turnSpeed:1.5

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Bazooka_1.ogg
shoot_sound_vol:0.35
shoot_flame:BZ_Fire_1





[projectile_ZN_MTank_Eins_Cannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_S*1
(
    addResources=
    ShellDamage:1750
    |DpDamage:100
    |WeaponAccuracy=75
    |PartBreakModifier=0.75
    |CockpitBreakModifier=2.35
    |PilotDamageModifier=2.35
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.2  
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:50
    |ProjectileSpread:4
    |ProjectileExplosionRange:30
    |ProjectileLife:25
)
"""



[hiddenAction_ZN_MTank_Eins_Cannon_CDStart]
autoTrigger:"""
if memory.ZN_MTank_Eins_Cannon_OnCD==false 
and 
(
    (
        self.resource.ZN_MTank_Eins_Cannon_ShootTimer<=0 
    ) 
    or 
    (
        self.resource.ZN_MTank_Eins_Cannon_ShootTimer<${ZN_MTank_Eins_Cannon_Shoot} and not self.hasTags(includes='inBattle')
    )
)
"""
setUnitMemory:ZN_MTank_Eins_Cannon_OnCD=true,ZN_MTank_Eins_Cannon_CDTimer=self.timeAlive+${ZN_MTank_Eins_Cannon_CD}

[hiddenAction_ZN_MTank_Eins_Cannon_CDEnd]
autoTriggerOnEvent:created
autoTrigger:if memory.ZN_MTank_Eins_Cannon_OnCD==true and self.timeAlive>memory.ZN_MTank_Eins_Cannon_CDTimer
setUnitMemory:ZN_MTank_Eins_Cannon_OnCD=false
setResourcesWithLogic:ZN_MTank_Eins_Cannon_ShootTimer=${ZN_MTank_Eins_Cannon_Shoot}
