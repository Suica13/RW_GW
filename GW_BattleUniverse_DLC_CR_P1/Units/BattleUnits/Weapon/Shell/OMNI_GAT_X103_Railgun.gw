[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/Railgun_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""


@memory OMNI_GAT_X103_Railgun_CDTimer:float
@global OMNI_GAT_X103_Railgun_CD=4
@global OMNI_GAT_X103_Railgun_EN=45





[decal_OMNI_GAT_X103_Railgun]
layer:beforeBody
order:4.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\OMNI_GAT_X103_RailGun.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.75
xOffsetRelative: 3
yOffsetRelative: 7
dirOffset:0





[turret_OMNI_GAT_X103_Railgun]
x:0
y:0

canShoot:false
projectile:OMNI_GAT_X103_Railgun_Projectile

delay:0.125s
limitingRange:0

canAttackMaxAngle:15
barrelX:11
barrelY:40

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/RailGun_1.ogg
shoot_sound_vol:0.85
shoot_flame:Railgun_Fire_1



[projectile_OMNI_GAT_X103_Railgun_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_RailShell*1
(
    addResources=
    ShellAPDamage:7500
    |ShellDamage:2500
    |DpDamage:200
    |WeaponAccuracy=85
    |PartBreakModifier=0.75
    |CockpitBreakModifier=1.25
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=1 
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=0.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:80
    |ProjectileSpread:1
    |ProjectileExplosionRange:30
    |ProjectileLife:25
)
"""






[hiddenAction_OMNI_GAT_X103_Railgun_Trigger]
alsoTriggerAction:OMNI_GAT_X103_Railgun_Fire
[hiddenAction_OMNI_GAT_X103_Railgun_Fire]
requireConditional:"""
if self.timeAlive>memory.OMNI_GAT_X103_Railgun_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:OMNI_GAT_X103_Railgun_CDTimer=self.timeAlive+${OMNI_GAT_X103_Railgun_CD}
addResources:EN=-${OMNI_GAT_X103_Railgun_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
PlayCommon_Shoot_A_Step_1,
OMNI_GAT_X103_Railgun_SetWeaponIndex,
OMNI_GAT_X103_Railgun_B1_Step_1
"""
[hiddenAction_OMNI_GAT_X103_Railgun_B1_Step_1]
alsoQueueAction:"""
OMNI_GAT_X103_Railgun_Fire_Step_1,
OMNI_GAT_X103_Railgun_Fire_Step_2,
OMNI_GAT_X103_Railgun_Fire_Step_Final
"""





[hiddenAction_OMNI_GAT_X103_Railgun_SetWeaponIndex]
isVisible:false


[hiddenAction_OMNI_GAT_X103_Railgun_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_OMNI_GAT_X103_Railgun_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:OMNI_GAT_X103_Railgun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_OMNI_GAT_X103_Railgun_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


