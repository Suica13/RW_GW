[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_StandShoot_A.gw
"""


@memory ZN_MSM_04G_HG_CDTimer:float
@global ZN_MSM_04G_HG_CD=5
@global ZN_MSM_04G_HG_EN=45


[turret_ZN_MSM_04G_HG]
x:0
y:0

canShoot:false
projectile:ZN_MSM_04G_HG_Projectile

delay:0.15s
limitingRange:0

canAttackMaxAngle:15
barrelX:21
barrelY:21

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.15
shoot_flame:BZ_Fire_1
[turret_ZN_MSM_04G_HG_L]
@copyFromSection:turret_ZN_MSM_04G_HG
barrelX:-21



[projectile_ZN_MSM_04G_HG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_S*1
(
    addResources=
    ShellDamage:2450
    |DpDamage:125
    |WeaponAccuracy=85
    |PartBreakModifier=0.75
    |CockpitBreakModifier=2.35
    |PilotDamageModifier=2.35
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=1 
    |AntiAir=0.5  
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:50
    |ProjectileSpread:4
    |ProjectileExplosionRange:30
    |ProjectileLife:25
)
"""







[hiddenAction_ZN_MSM_04G_HG_Trigger]
alsoTriggerAction:ZN_MSM_04G_HG_Fire
[hiddenAction_ZN_MSM_04G_HG_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MSM_04G_HG_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  
and not (directionBetween(self, self.attacking) < self.dir-45 or directionBetween(self, self.attacking) > self.dir+45)  
and self.resource.EN>0
"""
setUnitMemory:ZN_MSM_04G_HG_CDTimer=self.timeAlive+${ZN_MSM_04G_HG_CD}
addResources:EN=-${ZN_MSM_04G_HG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_MSM_04G_HG_SetWeaponIndex,
ZN_MSM_04G_HG_B6_Step_1,
PlayCommon_StandShoot_A_Step_1
"""
[hiddenAction_ZN_MSM_04G_HG_B6_Step_1]
alsoQueueAction:"""
ZN_MSM_04G_HG_Fire_Step_1,

ZN_MSM_04G_HG_Fire_Step_2,
ZN_MSM_04G_HG_Fire_Step_3,

ZN_MSM_04G_HG_Fire_Step_2,
ZN_MSM_04G_HG_Fire_Step_3,

ZN_MSM_04G_HG_Fire_Step_2,
ZN_MSM_04G_HG_Fire_Step_3,
ZN_MSM_04G_HG_Fire_Step_Final
"""





[hiddenAction_ZN_MSM_04G_HG_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MSM_04G_HG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_ZN_MSM_04G_HG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false
"""
buildSpeed:0.15s
fireTurretXAtGround:ZN_MSM_04G_HG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MSM_04G_HG_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false
"""
buildSpeed:0.15s
fireTurretXAtGround:ZN_MSM_04G_HG_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MSM_04G_HG_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


