"""

@global Common_DoubleVulcan_MS_Shoot=24
[turret_Common_DoubleVulcan_MS]
delay:0.075s
canAttackCondition:"""
if ${cantAction}==false 
and distanceBetween(self,self.attacking)<=600 
and memory.headBreaked==false 
and 
(
    attacking.tags(includes='Aircraft') 
    or attacking.tags(includes='Tank') 
    or attacking.tags(includes='Pilot') 
    or memory.attackMode==1 
    or self.resource().en<=0
)
"""


