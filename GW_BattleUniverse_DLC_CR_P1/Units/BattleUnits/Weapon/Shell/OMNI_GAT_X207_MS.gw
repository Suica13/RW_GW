[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""


@memory OMNI_GAT_X207_MS_CDTimer:float
@global OMNI_GAT_X207_MS_CD=7
@global OMNI_GAT_X207_MS_EN=50



[turret_OMNI_GAT_X207_MS]
x:0
y:0

canShoot:false
projectile:OMNI_GAT_X207_MS_Projectile

delay:0.125s
limitingRange:0

canAttackMaxAngle:15
barrelX:8
barrelY:24

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.25
shoot_flame:BZ_Fire_1_S



[projectile_OMNI_GAT_X207_MS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS*1
(
    addResources=
    ShellDamage:3000
    |ShellAPDamage:1500
    |DpDamage:100
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightHitRange=20
    |HeightChangeSpeed=2
    |ProjectileSpeed:40
    |ProjectileTurnspeed:1.5
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:45
)
"""






[hiddenAction_OMNI_GAT_X207_MS_Trigger]
alsoTriggerAction:OMNI_GAT_X207_MS_Fire
[hiddenAction_OMNI_GAT_X207_MS_Fire]
requireConditional:"""
if self.timeAlive>memory.OMNI_GAT_X207_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:OMNI_GAT_X207_MS_CDTimer=self.timeAlive+${OMNI_GAT_X207_MS_CD}
addResources:EN=-${OMNI_GAT_X207_MS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
OMNI_GAT_X207_MS_SetWeaponIndex,
OMNI_GAT_X207_MS_B4_Step_1
"""
[hiddenAction_OMNI_GAT_X207_MS_B4_Step_1]
alsoQueueAction:"""
OMNI_GAT_X207_MS_Fire_Step_1,
OMNI_GAT_X207_MS_Fire_Step_2,
OMNI_GAT_X207_MS_Fire_Step_3,
OMNI_GAT_X207_MS_Fire_Step_3,
OMNI_GAT_X207_MS_Fire_Step_3,
OMNI_GAT_X207_MS_Fire_Step_Final
"""





[hiddenAction_OMNI_GAT_X207_MS_SetWeaponIndex]
isVisible:false


[hiddenAction_OMNI_GAT_X207_MS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_OMNI_GAT_X207_MS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:OMNI_GAT_X207_MS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_OMNI_GAT_X207_MS_Fire_Step_3]
@copyFromSection:hiddenAction_OMNI_GAT_X207_MS_Fire_Step_2
buildSpeed:${turret_OMNI_GAT_X207_MS.delay}
[hiddenAction_OMNI_GAT_X207_MS_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


