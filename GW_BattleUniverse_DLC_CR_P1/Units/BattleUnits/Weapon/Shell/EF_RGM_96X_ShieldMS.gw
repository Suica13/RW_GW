[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""


@memory EF_RGM_96X_ShieldMS_CDTimer:float
@global EF_RGM_96X_ShieldMS_CD=9
@global EF_RGM_96X_ShieldMS_EN=25




[turret_EF_RGM_96X_ShieldMS]
x:0
y:0

canShoot:false
projectile:EF_RGM_96X_ShieldMS_Projectile

delay:0.15s
limitingRange:0

canAttackMaxAngle:15
barrelX:-18
barrelY:7

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_EF_RGM_96X_ShieldMS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS*1
(
    addResources=
    ShellDamage:5000
    |DpDamage:350
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=0.75
    |AntiAir=1.0 
    |AntiLand=1.0
    |AntiSpace=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=10
    |ProjectileSpeed:60
    |ProjectileTurnspeed:1.5
    |ProjectileSpread:0
    |ProjectileExplosionRange:40
    |ProjectileLife:40
)
"""






[hiddenAction_EF_RGM_96X_ShieldMS_Trigger]
alsoTriggerAction:EF_RGM_96X_ShieldMS_Fire
[hiddenAction_EF_RGM_96X_ShieldMS_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RGM_96X_ShieldMS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_RGM_96X_ShieldMS_CDTimer=self.timeAlive+${EF_RGM_96X_ShieldMS_CD}
addResources:EN=-${EF_RGM_96X_ShieldMS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RGM_96X_ShieldMS_SetWeaponIndex,
EF_RGM_96X_ShieldMS_B2_Step_1
"""
[hiddenAction_EF_RGM_96X_ShieldMS_B2_Step_1]
alsoQueueAction:"""
EF_RGM_96X_ShieldMS_Fire_Step_1,
EF_RGM_96X_ShieldMS_Fire_Step_2,
EF_RGM_96X_ShieldMS_Fire_Step_3,
EF_RGM_96X_ShieldMS_Fire_Step_3,
EF_RGM_96X_ShieldMS_Fire_Step_Final
"""





[hiddenAction_EF_RGM_96X_ShieldMS_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RGM_96X_ShieldMS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_EF_RGM_96X_ShieldMS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RGM_96X_ShieldMS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_L_Step_1
[hiddenAction_EF_RGM_96X_ShieldMS_Fire_Step_3]
@copyFromSection:hiddenAction_EF_RGM_96X_ShieldMS_Fire_Step_2
buildSpeed:${turret_EF_RGM_96X_ShieldMS.delay}
[hiddenAction_EF_RGM_96X_ShieldMS_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


