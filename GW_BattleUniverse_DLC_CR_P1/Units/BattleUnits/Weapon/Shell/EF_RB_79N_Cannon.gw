[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/Railgun_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory EF_RB_79N_Cannon_CDTimer:float
@global EF_RB_79N_Cannon_CD=4
@global EF_RB_79N_Cannon_EN=40










[turret_EF_RB_79N_Cannon]
x:0
y:0

canShoot:false
projectile:EF_RB_79N_Cannon_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:0
barrelY:16
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/RailGun_1.ogg
shoot_sound_vol:0.5
shoot_flame:Railgun_Fire_1



[projectile_EF_RB_79N_Cannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_RailShell*1
(
    addResources=
    ShellAPDamage:2000
    |ShellDamage:2000
    |DpDamage:200
    |WeaponAccuracy=75
    |PartBreakModifier=0.75
    |CockpitBreakModifier=1.25
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=2
    |AntiAir=0.5 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=0.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:1
    |ProjectileExplosionRange:30
    |ProjectileLife:30
)
"""








[hiddenAction_EF_RB_79N_Cannon_Trigger]
alsoTriggerAction:EF_RB_79N_Cannon_Fire
[hiddenAction_EF_RB_79N_Cannon_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RB_79N_Cannon_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:EF_RB_79N_Cannon_CDTimer=self.timeAlive+${EF_RB_79N_Cannon_CD}
addResources:EN=-${EF_RB_79N_Cannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RB_79N_Cannon_SetWeaponIndex,
PlayCommon_Cannon_Shoot_A_Step_1,
EF_RB_79N_Cannon_B1_Step_1
"""
[hiddenAction_EF_RB_79N_Cannon_B1_Step_1]
alsoQueueAction:"""
EF_RB_79N_Cannon_Fire_Step_1,
EF_RB_79N_Cannon_Fire_Step_2,
EF_RB_79N_Cannon_Fire_Step_Final
"""




[hiddenAction_EF_RB_79N_Cannon_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RB_79N_Cannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_EF_RB_79N_Cannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RB_79N_Cannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_RB_79N_Cannon_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


