[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""


@memory EF_GroundTypeMissileLauncher_CDTimer:float
@global EF_GroundTypeMissileLauncher_CD=5
@global EF_GroundTypeMissileLauncher_EN=45





[decal_EF_GroundTypeMissileLauncher]
layer:beforeBody
order:6.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\EF_GroundTypeMissileLauncher.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.7
xOffsetRelative: 1
yOffsetRelative: 8.5
dirOffset:0






[turret_EF_GroundTypeMissileLauncher]
x:0
y:0

canShoot:false
projectile:EF_GroundTypeMissileLauncher_Projectile

delay:0.3s
limitingRange:0

canAttackMaxAngle:15
barrelX:11
barrelY:5

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_EF_GroundTypeMissileLauncher_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS_L*1
(
    addResources=
    ShellDamage:3500
    |DpDamage:150
    |WeaponAccuracy=85
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiBuilding=1.5
    |AntiAqua=0.75
    |AntiAir=1.5
    |AntiLand=1
    |AntiSpace=1.0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:50
    |ProjectileTurnspeed:1.5
    |ProjectileSpread:0
    |ProjectileExplosionRange:40
    |ProjectileLife:30
)
"""








[hiddenAction_EF_GroundTypeMissileLauncher_Trigger]
alsoTriggerAction:EF_GroundTypeMissileLauncher_Fire
[hiddenAction_EF_GroundTypeMissileLauncher_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_GroundTypeMissileLauncher_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_GroundTypeMissileLauncher_CDTimer=self.timeAlive+${EF_GroundTypeMissileLauncher_CD}
addResources:EN=-${EF_GroundTypeMissileLauncher_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_GroundTypeMissileLauncher_SetWeaponIndex,
EF_GroundTypeMissileLauncher_B3_Step_1
"""
[hiddenAction_EF_GroundTypeMissileLauncher_B3_Step_1]
alsoQueueAction:"""
EF_GroundTypeMissileLauncher_Fire_Step_1,
EF_GroundTypeMissileLauncher_Fire_Step_2,
EF_GroundTypeMissileLauncher_Fire_Step_3,
EF_GroundTypeMissileLauncher_Fire_Step_3,
EF_GroundTypeMissileLauncher_Fire_Step_Final
"""





[hiddenAction_EF_GroundTypeMissileLauncher_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_GroundTypeMissileLauncher_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_EF_GroundTypeMissileLauncher_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_GroundTypeMissileLauncher
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_EF_GroundTypeMissileLauncher_Fire_Step_3]
@copyFromSection:hiddenAction_EF_GroundTypeMissileLauncher_Fire_Step_2
buildSpeed:${turret_EF_GroundTypeMissileLauncher.delay}
[hiddenAction_EF_GroundTypeMissileLauncher_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


