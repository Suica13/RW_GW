[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw
"""

@memory EF_MinigunAPC_MG_OnCD:bool
@memory EF_MinigunAPC_MG_CDTimer:float
@global EF_MinigunAPC_MG_CD=3

@global EF_MinigunAPC_MG_Shoot=12
[resource_EF_MinigunAPC_MG_ShootTimer]
hidden:true








[turret_EF_MinigunAPC_MG]
x:0
y:-4

canShoot:true
canAttackCondition:"""
if ${onAttacking}==false and ${cantAction}==false 
"""
showRangeUIGuide:false
projectile:EF_MinigunAPC_MG_Projectile
resourceUsage:EF_MinigunAPC_MG_ShootTimer=1

delay:0.075s
canAttackMaxAngle:10
barrelX:0.5
barrelY:18
turnSpeed:2.5

aimOffsetSpread:0
recoilOffset:0
recoilOutTime:0
recoilReturnTime:0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_2.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_EF_MinigunAPC_MG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:300
    |DpDamage:20
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=2
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:9
    |ProjectileLife:15
)
"""


[hiddenAction_EF_MinigunAPC_MG_CDStart]
autoTrigger:"""
if memory.EF_MinigunAPC_MG_OnCD==false 
and 
(
    (
        self.resource.EF_MinigunAPC_MG_ShootTimer<=0 
    ) 
    or 
    (
        self.resource.EF_MinigunAPC_MG_ShootTimer<${EF_MinigunAPC_MG_Shoot} and not self.hasTags(includes='inBattle')
    )
)
"""
setUnitMemory:EF_MinigunAPC_MG_OnCD=true,EF_MinigunAPC_MG_CDTimer=self.timeAlive+${EF_MinigunAPC_MG_CD}

[hiddenAction_EF_MinigunAPC_MG_CDEnd]
autoTriggerOnEvent:created
autoTrigger:if memory.EF_MinigunAPC_MG_OnCD==true and self.timeAlive>memory.EF_MinigunAPC_MG_CDTimer
setUnitMemory:EF_MinigunAPC_MG_OnCD=false
setResourcesWithLogic:EF_MinigunAPC_MG_ShootTimer=${EF_MinigunAPC_MG_Shoot}
