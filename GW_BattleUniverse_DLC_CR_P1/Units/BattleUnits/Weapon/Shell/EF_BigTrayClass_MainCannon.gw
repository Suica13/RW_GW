[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Flash_1.gw,
ROOT:Resource/Image/Fx/Weapon/Shell/Common/Cannon_Fire_1.gw
"""


@memory EF_BigTrayClass_MainCannon_AimTarget:unit
@memory EF_BigTrayClass_MainCannon_CDTimer:float
@global EF_BigTrayClass_MainCannon_CD=120




[decal_EF_BigTrayClass_MainCannon_Range]
layer: inactive
order:0
onlyTeam:own
alpha:1
image:ROOT:Resource/Image/Ring/Ring150_Action.png
imageScale:6
basePosition:self
alwaysStartDirAtZero:true
onlyWhileAlive:true
isVisible:if true




[turret_EF_BigTrayClass_MainCannon]
x:0
y:0

canShoot:false
projectile:EF_BigTrayClass_MainCannon_Projectile

delay:0.3s
canAttackMaxAngle:15
limitingAngle:0
limitingRange:900
limitingMinRange:300
barrelX:30
barrelY:75

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/ShellCannon_5.ogg
shoot_sound_vol:0.6
shoot_flame:Cannon_Fire_1
[turret_EF_BigTrayClass_MainCannon_L]
@copyFromSection:turret_EF_BigTrayClass_MainCannon
barrelX:-30



[projectile_EF_BigTrayClass_MainCannon_Projectile]

directDamage: 0
life: 500
explodeOnEndOfLife:true
speed: 10

lightSize:0
effectOnCreate:none
explodeEffect:none
drawSize:1.5
image:ROOT:Resource/Image/Bullet/Shell/Sniper_1.png

spawnUnit:"""
Projectile_Mortar_L_B*1
(
    addResources=
    ShellDamage:8000
    |DpDamage:500
    |WeaponAccuracy=75
    |PartBreakModifier=0.5
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiBuilding=3
    |AntiAqua=0.75
    |AntiAir=0.5 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |HeightChangeSpeed=0.5
    |HeightHitRange=10
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileExplosionRange:30
    |ProjectileLife:0

    |ProjectileBlastRange:60
    |ProjectileBlastDamageModifier:0.20
    |ProjectileBlastDpModifier:1
)
"""




[action_EF_BigTrayClass_MainCannon_Trigger]
pos:10
text:MainCannon %{select(self.timeAlive<=memory.EF_BigTrayClass_MainCannon_CDTimer,str(int(memory.EF_BigTrayClass_MainCannon_CDTimer-self.timeAlive))+"s","OK")}
text_zh:攻城炮 %{select(self.timeAlive<=memory.EF_BigTrayClass_MainCannon_CDTimer,str(int(memory.EF_BigTrayClass_MainCannon_CDTimer-self.timeAlive))+"秒","OK")}
text_KP:100

displayType:infoOnly

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true

iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_3.png
highPriorityQueue:true

isVisible:if self.parent.hp<=0  

isGuiBlinking:"""
if self.timeAlive>memory.EF_BigTrayClass_MainCannon_CDTimer
"""



isLocked:if self.timeAlive<=memory.EF_BigTrayClass_MainCannon_CDTimer
isLockedMessage:In CD
isLockedMessage_zh:冷却中
isLockedAlt2:if ${cantAction}==true or ${onSkill}==true 
isLockedAlt2Message:Cant Action
isLockedAlt2Message_zh:无法行动

fireTurretXAtGround:EF_BigTrayClass_MainCannon
fireTurretXAtGround_count:0
fireTurretXAtGround_showGuideDecals:EF_BigTrayClass_MainCannon_Range

clearAllWaypoints:true


alsoTriggerAction:"""
SendEnemyTryAttack_Shoot,
SetAttackingCantAimOn,
SetOnSkillOn,
EF_BigTrayClass_MainCannon_SetWeaponIndex,
EF_BigTrayClass_MainCannon_B1_Step_1
"""
clearAllWaypoints:true
[hiddenAction_EF_BigTrayClass_MainCannon_B1_Step_1]
setUnitMemory:"""
EF_BigTrayClass_MainCannon_AimTarget=thisActionTarget,
EF_BigTrayClass_MainCannon_CDTimer=self.timeAlive+${EF_BigTrayClass_MainCannon_CD}
"""

alsoTriggerAction:"""
SetAttackingCantAimOn
"""

alsoQueueAction:"""
EF_BigTrayClass_MainCannon_Fire_Step_1,

EF_BigTrayClass_MainCannon_Fire_Step_2,
EF_BigTrayClass_MainCannon_Fire_Step_3,

EF_BigTrayClass_MainCannon_Fire_Step_Final
"""



[hiddenAction_EF_BigTrayClass_MainCannon_SetWeaponIndex]
isVisible:false






[hiddenAction_EF_BigTrayClass_MainCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.1s
whenBuilding_cannotMove:true
fireTurretXAtGround:EF_BigTrayClass_MainCannon
fireTurretXAtGround_count:0
fireTurretXAtGround_withTarget:memory.EF_BigTrayClass_MainCannon_AimTarget

whenBuilding_rotateTo_aimAtActionTarget:true
whenBuilding_rotateTo_waitTillRotated:true

[hiddenAction_EF_BigTrayClass_MainCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.1s
spawnEffects:Flash_1_XL
whenBuilding_cannotMove:true
fireTurretXAtGround:EF_BigTrayClass_MainCannon
fireTurretXAtGround_count:0
fireTurretXAtGround_withTarget:memory.EF_BigTrayClass_MainCannon_AimTarget

whenBuilding_rotateTo_aimAtActionTarget:true
whenBuilding_rotateTo_waitTillRotated:true

[hiddenAction_EF_BigTrayClass_MainCannon_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:3s
whenBuilding_cannotMove:true
fireTurretXAtGround:EF_BigTrayClass_MainCannon
fireTurretXAtGround_withTarget:memory.EF_BigTrayClass_MainCannon_AimTarget

whenBuilding_rotateTo_aimAtActionTarget:true
whenBuilding_rotateTo_waitTillRotated:true

alsoTriggerAction:EF_BigTrayClass_MainCannon_Fire_Step_3_Sub
[hiddenAction_EF_BigTrayClass_MainCannon_Fire_Step_3_Sub]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
whenBuilding_cannotMove:true
fireTurretXAtGround:EF_BigTrayClass_MainCannon_L
fireTurretXAtGround_withTarget:memory.EF_BigTrayClass_MainCannon_AimTarget

[hiddenAction_EF_BigTrayClass_MainCannon_Fire_Step_Final]
buildSpeed:1.5s
whenBuilding_cannotMove:true
finishPlayingLastAnimation:true
alsoTriggerAction:"""
SetOnSkillOff,
SetAttackingOff,
SetAttackingCantTurnOff,
SetAttackingCantAimOff
"""
clearAllWaypoints:true





[hiddenAction_EF_BigTrayClass_MainCannon_Fire_Step_1_AI]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:1s
spawnEffects:Flash_1_XL
whenBuilding_cannotMove:true

[hiddenAction_EF_BigTrayClass_MainCannon_Fire_Step_2_AI]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:3s
whenBuilding_cannotMove:true
fireTurretXAtGround:EF_BigTrayClass_MainCannon
fireTurretXAtGround_withTarget:memory.EF_BigTrayClass_MainCannon_AimTarget

alsoTriggerAction:EF_BigTrayClass_MainCannon_Fire_Step_3_Sub

