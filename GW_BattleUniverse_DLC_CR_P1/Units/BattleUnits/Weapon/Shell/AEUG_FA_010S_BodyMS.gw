[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""


@memory AEUG_FA_010S_BodyMS_CDTimer:float
@global AEUG_FA_010S_BodyMS_CD=4
@global AEUG_FA_010S_BodyMS_EN=90










[turret_AEUG_FA_010S_BodyMS]
x:0
y:0

canShoot:false
projectile:AEUG_FA_010S_BodyMS_Projectile

delay:0.025s
limitingRange:0

canAttackMaxAngle:15
barrelX:7
barrelY:-16

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.25
shoot_flame:BZ_Fire_1_S
[turret_AEUG_FA_010S_BodyMS_L]
@copyFromSection:turret_AEUG_FA_010S_BodyMS
barrelX:-7

[turret_AEUG_FA_010S_BodyMS_R2]
@copyFromSection:turret_AEUG_FA_010S_BodyMS
barrelX:10
barrelY:-5
[turret_AEUG_FA_010S_BodyMS_L2]
@copyFromSection:turret_AEUG_FA_010S_BodyMS
barrelX:-10
barrelY:-5

[turret_AEUG_FA_010S_BodyMS_R3]
@copyFromSection:turret_AEUG_FA_010S_BodyMS
barrelX:3
barrelY:5

[turret_AEUG_FA_010S_BodyMS_L3]
@copyFromSection:turret_AEUG_FA_010S_BodyMS
barrelX:-3
barrelY:5



[projectile_AEUG_FA_010S_BodyMS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS_Red*2
(
    offsetRandomXY=3,
    offsetRandomDir=8,
    addResources=
    ShellDamage:2750
    |DpDamage:80
    |WeaponAccuracy=85
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightHitRange=20
    |HeightChangeSpeed=2
    |ProjectileSpeed:35
    |ProjectileTurnspeed:1.5
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:50

    |EquipmentIndex:1
    |EquipmentIndex2:300
)
"""







[hiddenAction_AEUG_FA_010S_BodyMS_Trigger]
alsoTriggerAction:AEUG_FA_010S_BodyMS_Fire
[hiddenAction_AEUG_FA_010S_BodyMS_Fire]
requireConditional:"""
if self.timeAlive>memory.AEUG_FA_010S_BodyMS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:AEUG_FA_010S_BodyMS_CDTimer=self.timeAlive+${AEUG_FA_010S_BodyMS_CD}
addResources:EN=-${AEUG_FA_010S_BodyMS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
AEUG_FA_010S_BodyMS_SetWeaponIndex,
AEUG_FA_010S_BodyMS_B24_Step_1
"""
[hiddenAction_AEUG_FA_010S_BodyMS_B24_Step_1]
alsoQueueAction:"""
AEUG_FA_010S_BodyMS_Fire_Step_1,
AEUG_FA_010S_BodyMS_Fire_Step_2,
AEUG_FA_010S_BodyMS_Fire_Step_3_L,
AEUG_FA_010S_BodyMS_Fire_Step_3_R2,
AEUG_FA_010S_BodyMS_Fire_Step_3_L2,
AEUG_FA_010S_BodyMS_Fire_Step_3_R3,
AEUG_FA_010S_BodyMS_Fire_Step_3_L3,

AEUG_FA_010S_BodyMS_Fire_Step_3,
AEUG_FA_010S_BodyMS_Fire_Step_3_L,
AEUG_FA_010S_BodyMS_Fire_Step_3_R2,
AEUG_FA_010S_BodyMS_Fire_Step_3_L2,
AEUG_FA_010S_BodyMS_Fire_Step_3_R3,
AEUG_FA_010S_BodyMS_Fire_Step_3_L3,

AEUG_FA_010S_BodyMS_Fire_Step_3,
AEUG_FA_010S_BodyMS_Fire_Step_3_L,
AEUG_FA_010S_BodyMS_Fire_Step_3_R2,
AEUG_FA_010S_BodyMS_Fire_Step_3_L2,
AEUG_FA_010S_BodyMS_Fire_Step_3_R3,
AEUG_FA_010S_BodyMS_Fire_Step_3_L3,

AEUG_FA_010S_BodyMS_Fire_Step_3,
AEUG_FA_010S_BodyMS_Fire_Step_3_L,
AEUG_FA_010S_BodyMS_Fire_Step_3_R2,
AEUG_FA_010S_BodyMS_Fire_Step_3_L2,
AEUG_FA_010S_BodyMS_Fire_Step_3_R3,
AEUG_FA_010S_BodyMS_Fire_Step_3_L3,

AEUG_FA_010S_BodyMS_Fire_Step_Final
"""





[hiddenAction_AEUG_FA_010S_BodyMS_SetWeaponIndex]
isVisible:false


[hiddenAction_AEUG_FA_010S_BodyMS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
alsoTriggerAction:PlayCommon_Cannon_Shoot_A_Step_1
[hiddenAction_AEUG_FA_010S_BodyMS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:AEUG_FA_010S_BodyMS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_AEUG_FA_010S_BodyMS_Fire_Step_3]
@copyFromSection:hiddenAction_AEUG_FA_010S_BodyMS_Fire_Step_2
buildSpeed:${turret_AEUG_FA_010S_BodyMS.delay}
[hiddenAction_AEUG_FA_010S_BodyMS_Fire_Step_3_L]
@copyFromSection:hiddenAction_AEUG_FA_010S_BodyMS_Fire_Step_2
fireTurretXAtGround:AEUG_FA_010S_BodyMS_L
buildSpeed:${turret_AEUG_FA_010S_BodyMS.delay}
[hiddenAction_AEUG_FA_010S_BodyMS_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff



[hiddenAction_AEUG_FA_010S_BodyMS_Fire_Step_3_R2]
@copyFromSection:hiddenAction_AEUG_FA_010S_BodyMS_Fire_Step_2
fireTurretXAtGround:AEUG_FA_010S_BodyMS_R2
buildSpeed:${turret_AEUG_FA_010S_BodyMS.delay}
[hiddenAction_AEUG_FA_010S_BodyMS_Fire_Step_3_L2]
@copyFromSection:hiddenAction_AEUG_FA_010S_BodyMS_Fire_Step_2
fireTurretXAtGround:AEUG_FA_010S_BodyMS_L2
buildSpeed:${turret_AEUG_FA_010S_BodyMS.delay}

[hiddenAction_AEUG_FA_010S_BodyMS_Fire_Step_3_R3]
@copyFromSection:hiddenAction_AEUG_FA_010S_BodyMS_Fire_Step_2
fireTurretXAtGround:AEUG_FA_010S_BodyMS_R3
buildSpeed:${turret_AEUG_FA_010S_BodyMS.delay}
[hiddenAction_AEUG_FA_010S_BodyMS_Fire_Step_3_L3]
@copyFromSection:hiddenAction_AEUG_FA_010S_BodyMS_Fire_Step_2
fireTurretXAtGround:AEUG_FA_010S_BodyMS_L3
buildSpeed:${turret_AEUG_FA_010S_BodyMS.delay}
