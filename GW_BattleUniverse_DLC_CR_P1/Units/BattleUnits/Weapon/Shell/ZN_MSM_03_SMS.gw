[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""


@memory ZN_MSM_03_SMS_CDTimer:float
@global ZN_MSM_03_SMS_CD=9
@global ZN_MSM_03_SMS_EN=35








[turret_ZN_MSM_03_SMS]
x:0
y:0

canShoot:false
projectile:ZN_MSM_03_SMS_Projectile

delay:0.15s
limitingRange:0

canAttackMaxAngle:15
barrelX:11
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.15
shoot_flame:BZ_Fire_1_S
[turret_ZN_MSM_03_SMS_L]
@copyFromSection:turret_ZN_MSM_03_SMS
barrelX:-11



[projectile_ZN_MSM_03_SMS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS*1
(
    addResources=
    ShellDamage:750
    |DpDamage:50
    |WeaponAccuracy=85
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=2
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightHitRange=20
    |HeightChangeSpeed=2
    |ProjectileSpeed:30
    |ProjectileTurnspeed:1.5
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:50
)
"""







[hiddenAction_ZN_MSM_03_SMS_Trigger]
alsoTriggerAction:ZN_MSM_03_SMS_Fire
[hiddenAction_ZN_MSM_03_SMS_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MSM_03_SMS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:ZN_MSM_03_SMS_CDTimer=self.timeAlive+${ZN_MSM_03_SMS_CD}
addResources:EN=-${ZN_MSM_03_SMS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_MSM_03_SMS_SetWeaponIndex,
ZN_MSM_03_SMS_B6_Step_1,
PlayCommon_Cannon_Shoot_A_Step_1
"""
[hiddenAction_ZN_MSM_03_SMS_B6_Step_1]
alsoQueueAction:"""
ZN_MSM_03_SMS_Fire_Step_1,
ZN_MSM_03_SMS_Fire_Step_2,
ZN_MSM_03_SMS_Fire_Step_3,
ZN_MSM_03_SMS_Fire_Step_2,
ZN_MSM_03_SMS_Fire_Step_3,
ZN_MSM_03_SMS_Fire_Step_2,
ZN_MSM_03_SMS_Fire_Step_3,
ZN_MSM_03_SMS_Fire_Step_Final
"""





[hiddenAction_ZN_MSM_03_SMS_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MSM_03_SMS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_ZN_MSM_03_SMS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false
"""
buildSpeed:0.1s
fireTurretXAtGround:ZN_MSM_03_SMS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MSM_03_SMS_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false
"""
buildSpeed:0.1s
fireTurretXAtGround:ZN_MSM_03_SMS_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MSM_03_SMS_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


