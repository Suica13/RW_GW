[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory ORB_MBF_P03_Bazooka_CDTimer:float
@global ORB_MBF_P03_Bazooka_CD=4
@global ORB_MBF_P03_Bazooka_EN=55





[decal_ORB_MBF_P03_Bazooka]
layer:beforeBody
order:6.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\ORB_MBF_P03_Bazooka.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.75
xOffsetRelative: 1
yOffsetRelative: 14
dirOffset:0
[decal_ORB_MBF_P03_Bazooka_NotUsing]
@copyFromSection:decal_ORB_MBF_P03_Bazooka
order:0
basePositionFromLegEnd:arm1
imageScale:0.7
imageScaleY:-1
xOffsetRelative:-1
yOffsetRelative:-9
dirOffset:90






[turret_ORB_MBF_P03_Bazooka]
x:0
y:0

canShoot:false
projectile:ORB_MBF_P03_Bazooka_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:10
barrelY:18
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Bazooka_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_ORB_MBF_P03_Bazooka_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka*1
(
    addResources=
    ShellDamage:8500
    |DpDamage:350
    |WeaponAccuracy=75
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:55
    |ProjectileSpread:1
    |ProjectileExplosionRange:30
    |ProjectileLife:35

    |ProjectileBlastRange:60
    |ProjectileBlastDamageModifier:0.20
    |ProjectileBlastDpModifier:1
)
"""








[hiddenAction_ORB_MBF_P03_Bazooka_Trigger]
alsoTriggerAction:ORB_MBF_P03_Bazooka_Fire
[hiddenAction_ORB_MBF_P03_Bazooka_Fire]
requireConditional:"""
if self.timeAlive>memory.ORB_MBF_P03_Bazooka_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:ORB_MBF_P03_Bazooka_CDTimer=self.timeAlive+${ORB_MBF_P03_Bazooka_CD}
addResources:EN=-${ORB_MBF_P03_Bazooka_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ORB_MBF_P03_Bazooka_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
ORB_MBF_P03_Bazooka_B1_Step_1
"""
[hiddenAction_ORB_MBF_P03_Bazooka_B1_Step_1]
alsoQueueAction:"""
ORB_MBF_P03_Bazooka_Fire_Step_1,
ORB_MBF_P03_Bazooka_Fire_Step_2,
ORB_MBF_P03_Bazooka_Fire_Step_Final
"""




[hiddenAction_ORB_MBF_P03_Bazooka_SetWeaponIndex]
isVisible:false


[hiddenAction_ORB_MBF_P03_Bazooka_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_ORB_MBF_P03_Bazooka_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ORB_MBF_P03_Bazooka
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ORB_MBF_P03_Bazooka_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


