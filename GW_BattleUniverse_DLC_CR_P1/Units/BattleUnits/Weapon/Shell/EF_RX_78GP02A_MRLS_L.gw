[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""


@memory EF_RX_78GP02A_MRLS_L_CDTimer:float
@global EF_RX_78GP02A_MRLS_L_CD=15
@global EF_RX_78GP02A_MRLS_L_EN=55










[turret_EF_RX_78GP02A_MRLS_L]
x:0
y:0

canShoot:false
projectile:EF_RX_78GP02A_MRLS_L_Projectile

delay:0.15s
limitingRange:0

canAttackMaxAngle:15
barrelX:5
barrelY:-12

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.25
shoot_flame:BZ_Fire_1_S
[turret_EF_RX_78GP02A_MRLS_L_L]
@copyFromSection:turret_EF_RX_78GP02A_MRLS_L
barrelX:-5



[projectile_EF_RX_78GP02A_MRLS_L_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_ASP_BurningArea_B*1
(
    addResources=
    ShellDamage:8000
    |DpDamage:250
    |WeaponAccuracy=75
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.5
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.5
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:25
    |ProjectileSpread:0
    |ProjectileExplosionRange:30
    |ProjectileLife:45
    
    |ProjectileBlastRange:60
    |ProjectileBlastDamageModifier:0.20
    |ProjectileBlastDpModifier:1
)
"""






[hiddenAction_EF_RX_78GP02A_MRLS_L_Trigger]
alsoTriggerAction:EF_RX_78GP02A_MRLS_L_Fire
[hiddenAction_EF_RX_78GP02A_MRLS_L_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RX_78GP02A_MRLS_L_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_RX_78GP02A_MRLS_L_CDTimer=self.timeAlive+${EF_RX_78GP02A_MRLS_L_CD}
addResources:EN=-${EF_RX_78GP02A_MRLS_L_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RX_78GP02A_MRLS_L_SetWeaponIndex,
EF_RX_78GP02A_MRLS_L_B2_Step_1
"""
[hiddenAction_EF_RX_78GP02A_MRLS_L_B2_Step_1]
alsoQueueAction:"""
EF_RX_78GP02A_MRLS_L_Fire_Step_1,
EF_RX_78GP02A_MRLS_L_Fire_Step_2,
EF_RX_78GP02A_MRLS_L_Fire_Step_Final
"""





[hiddenAction_EF_RX_78GP02A_MRLS_L_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RX_78GP02A_MRLS_L_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
alsoTriggerAction:PlayCommon_Cannon_Shoot_A_Step_1
[hiddenAction_EF_RX_78GP02A_MRLS_L_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RX_78GP02A_MRLS_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:EF_RX_78GP02A_MRLS_L_Fire_Step_Sub
[hiddenAction_EF_RX_78GP02A_MRLS_L_Fire_Step_3]
@copyFromSection:hiddenAction_EF_RX_78GP02A_MRLS_L_Fire_Step_2
buildSpeed:${turret_EF_RX_78GP02A_MRLS_L.delay}

[hiddenAction_EF_RX_78GP02A_MRLS_L_Fire_Step_Sub]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RX_78GP02A_MRLS_L_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_EF_RX_78GP02A_MRLS_L_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


