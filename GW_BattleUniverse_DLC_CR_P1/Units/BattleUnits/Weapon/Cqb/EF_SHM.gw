[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Cqb/Common_Melee_B.gw
"""

@memory EF_SHM_CDTimer:float
@global EF_SHM_CD=5


@memory EF_SHM_Unit:unit

[hiddenAction_Get_Spawn_EF_SHM]
autoTriggerOnEvent:newMessage(withTag="RodSpawn_EF_SHM")
setUnitMemory:EF_SHM_Unit=eventData("unitInfo",type="unit")




[decal_EF_SHM]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:Resource/Image/Bullet/Sp/EF_SHM.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.65
xOffsetRelative:1
yOffsetRelative:15
dirOffset:0
[decal_EF_SHM_NotUsing]
@copyFromSection:decal_EF_SHM
isVisible:false
order:5
basePositionFromLegEnd:arm2
imageScale:0.55
xOffsetRelative:-10
yOffsetRelative:-10.5
dirOffset:180

[decal_DrawLineTo_EF_SHM_Unit]
layer:beforeBody
order:4.5
alpha:1
basePositionFromLegEnd:arm4
drawLineTo:memory.EF_SHM_Unit
color:#333333
imageScale:1
lineWidth:5
xOffsetRelative: 2
yOffsetRelative: 8
onlyOnNonPreview:true
isVisible:if memory.EF_SHM_Unit.hp>0
onlyWhileAlive:true








[turret_EF_SHM]
x:0
y:0

canShoot:false
projectile:EF_SHM_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:11
barrelY:17
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/Fist_2.ogg
shoot_sound_vol:0.5



[projectile_EF_SHM_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_EF_SHM*1
(
    addResources=
    CqbDamage:6000
    |CqbShellDamage:6000
    |DpDamage:1000
    |WeaponAccuracy=85
    |PartBreakModifier=1.5
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=0.75

    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:1
    |ProjectileLife:6
)
"""








[hiddenAction_EF_SHM_Trigger]
alsoTriggerAction:EF_SHM_Fire
[hiddenAction_EF_SHM_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_SHM_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)
"""
setUnitMemory:EF_SHM_CDTimer=self.timeAlive+${EF_SHM_CD}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_SHM_SetWeaponIndex,
PlayCommon_Melee_B_Step_1,
EF_SHM_B1_Step_1
"""
[hiddenAction_EF_SHM_B1_Step_1]
alsoQueueAction:"""
EF_SHM_Fire_Step_1,
EF_SHM_Fire_Step_2,
EF_SHM_Fire_Step_Final
"""




[hiddenAction_EF_SHM_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_SHM_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.5s
[hiddenAction_EF_SHM_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_SHM
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_SHM_Fire_Step_Final]
buildSpeed:0.5s
alsoTriggerAction:SetAttackingOff


