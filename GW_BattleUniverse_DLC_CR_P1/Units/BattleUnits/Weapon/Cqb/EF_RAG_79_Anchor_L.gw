[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Cqb/Common_Melee_B_L.gw
"""

@memory EF_RAG_79_Anchor_L_CDTimer:float
@global EF_RAG_79_Anchor_L_CD=5


@memory EF_RAG_79_Anchor_L_Unit:unit

[hiddenAction_Get_Spawn_EF_RAG_79_Anchor_L]
autoTriggerOnEvent:newMessage(withTag="RodSpawn_EF_RAG_79_Anchor_L")
setUnitMemory:EF_RAG_79_Anchor_L_Unit=eventData("unitInfo",type="unit")




[decal_DrawLineTo_EF_RAG_79_Anchor_L_Unit]
layer:beforeBody
order:4.5
alpha:1
basePositionFromLegEnd:arm3
drawLineTo:memory.EF_RAG_79_Anchor_L_Unit
color:#333333
imageScale:1
lineWidth:5
xOffsetRelative: -6
yOffsetRelative: 6
onlyOnNonPreview:true
isVisible:if memory.EF_RAG_79_Anchor_L_Unit.hp>0
onlyWhileAlive:true








[turret_EF_RAG_79_Anchor_L]
x:0
y:0

canShoot:false
projectile:EF_RAG_79_Anchor_L_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:-11
barrelY:17
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/Fist_2.ogg
shoot_sound_vol:0.5



[projectile_EF_RAG_79_Anchor_L_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_EF_RAG_79_Anchor_L*1
(
    addResources=
    CqbDamage:3500
    |DpDamage:750
    |WeaponAccuracy=85
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=1.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=0.75
0
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:55
    |ProjectileSpread:1
    |ProjectileLife:10
)
"""








[hiddenAction_EF_RAG_79_Anchor_L_Trigger]
alsoTriggerAction:EF_RAG_79_Anchor_L_Fire
[hiddenAction_EF_RAG_79_Anchor_L_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RAG_79_Anchor_L_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)
"""
setUnitMemory:EF_RAG_79_Anchor_L_CDTimer=self.timeAlive+${EF_RAG_79_Anchor_L_CD}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RAG_79_Anchor_L_SetWeaponIndex,
PlayCommon_Melee_B_L_Step_1,
EF_RAG_79_Anchor_L_B1_Step_1
"""
[hiddenAction_EF_RAG_79_Anchor_L_B1_Step_1]
alsoQueueAction:"""
EF_RAG_79_Anchor_L_Fire_Step_1,
EF_RAG_79_Anchor_L_Fire_Step_2,
EF_RAG_79_Anchor_L_Fire_Step_Final
"""




[hiddenAction_EF_RAG_79_Anchor_L_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RAG_79_Anchor_L_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.5s
[hiddenAction_EF_RAG_79_Anchor_L_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RAG_79_Anchor_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_RAG_79_Anchor_L_Fire_Step_Final]
buildSpeed:0.5s
alsoTriggerAction:SetAttackingOff


