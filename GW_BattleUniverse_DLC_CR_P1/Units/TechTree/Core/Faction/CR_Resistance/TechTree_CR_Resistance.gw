[action_ShowTechTree_CR_Resistance]
@copyFromSection:template_ShowTechTree
text:Resistance[CR_P1]
text_zh:反抗[CR_P1]
iconImage:ROOT:Resource/Image/Icon/Faction_CR_Resistance_2.png
isVisible:if self.attachment(slot="CR_Resistance").hp>0 and memory.showTechTree==false and self.globalTeamTags(includes='Tech_CR_Resistance_Start')
isLocked:false
sendMessageTo:self.attachment(slot="CR_Resistance")

[attachment_CR_Resistance]
@copyFromSection:template_TechTree_Main
onCreateSpawnUnitOf:TechTree_UI_Main_CR_Resistance
