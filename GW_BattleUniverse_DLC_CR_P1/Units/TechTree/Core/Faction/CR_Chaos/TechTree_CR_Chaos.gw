[action_ShowTechTree_CR_Chaos]
@copyFromSection:template_ShowTechTree
text:Chaos[CR_P1]
text_zh:混沌[CR_P1]
iconImage:ROOT:Resource/Image/Icon/Faction_CR_Chaos_2.png
isVisible:if self.attachment(slot="CR_Chaos").hp>0 and memory.showTechTree==false and self.globalTeamTags(includes='Tech_CR_Chaos_Start')
isLocked:false
sendMessageTo:self.attachment(slot="CR_Chaos")

[attachment_CR_Chaos]
@copyFromSection:template_TechTree_Main
onCreateSpawnUnitOf:TechTree_UI_Main_CR_Chaos
