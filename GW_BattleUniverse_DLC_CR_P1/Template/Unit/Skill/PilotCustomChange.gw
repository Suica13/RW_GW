[core]
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Light_1.gw
"""
dont_load:false


[template_Start_PilotCustomChange_ToUnit]
removeAllQueuedItemsWithoutRefund:true
convertTo_keepCurrentTags:false
convertTo_keepCurrentFields:"""
selfRegenRate,
shieldRegen,
maxEnergy,
armour,
mass,
movespeed,
maxTurnSpeed,
maxAttackRange,
nanoRange,
fogOfWarSightRange,
nanoFactorySpeed,
targetHeight
"""
whenBuilding_triggerAction:SetAttackingOff
alsoTriggerAction:Send_TryClearQueued,Send_TryTransform_PilotCustomChange,Send_TryTransform_PilotCustomChange_Step2,Send_TryTransform_PilotCustomChange_Step3

[hiddenAction_Send_TryTransform_PilotCustomChange]
@copyFromSection:hiddenAction_Send_TryTransform
sendMessageWithData:"""
RecoverHp=0,
RecoverHpPer=0.25,
RecoverShield=0,
RecoverShieldPer=0.25,
RecoverEn=0,
RecoverEnPer=1,
ResetTags=1
"""

[hiddenAction_Send_TryTransform_PilotCustomChange_Step2]
# [ENGINE_WORKAROUND] Continue on a later frame, outside the current newMessage recursion chain.
setUnitMemory:pilotCustomContinuePending=true,pilotCustomContinueAt=self.timeAlive+0.1,pilotCustomRetryAt=self.timeAlive+1

[hiddenAction_Send_TryTransform_PilotCustomChange_Step3]
setUnitMemory:changePilotSkillsBool=false
[core]
@memory pilotCustomContinuePending:bool
@memory pilotCustomContinueAt:float
@memory pilotCustomRetryAt:float

# Only intermediate Pilot_CustomMarker units inherit this template; real pilots do not.
# [ORDER_DEPENDENT] Keep the core relay, but do not queue behind TryClearQueued.
[hiddenAction_PilotCustomContinue]
autoTrigger:if memory.pilotCustomContinuePending and self.timeAlive>memory.pilotCustomContinueAt and self.attachment(slot='BattleUnitCore').hp>0
setUnitMemory:pilotCustomContinuePending=false,pilotCustomRetryAt=self.timeAlive+1,battleUnitCore=self.attachment(slot='BattleUnitCore')
sendMessageTo:self.attachment(slot='BattleUnitCore')
sendMessageWithTags:PilotCustomChange

# [ENGINE_WORKAROUND] A lost created/converted event must not leave a permanent blank marker.
[hiddenAction_PilotCustomRepairCore]
autoTrigger:if self.timeAlive>0.5 and self.attachment(slot='BattleUnitCore').hp<=0 and customTarget1!=null
alsoTriggerAction:BattleUnitCore_Spawn,BattleUnitCore_Send_InitializeDone

[hiddenAction_PilotCustomRetry]
autoTrigger:if not memory.pilotCustomContinuePending and self.timeAlive>memory.pilotCustomRetryAt and self.timeAlive>0.5 and self.attachment(slot='BattleUnitCore').hp>0 and customTarget1!=null
setUnitMemory:pilotCustomRetryAt=self.timeAlive+1,battleUnitCore=self.attachment(slot='BattleUnitCore')
sendMessageTo:self
sendMessageWithTags:PilotCustomChange
