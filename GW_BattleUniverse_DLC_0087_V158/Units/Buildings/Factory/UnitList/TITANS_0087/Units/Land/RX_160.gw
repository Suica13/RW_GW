[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RX_160:bool


[hiddenAction_Pannel_Close_RX_160]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RX_160=false




[hiddenAction_AutoProduce_RX_160]
@copyFromSection:template_AutoProduce
@define UnitID=RX_160
alsoTriggerAction:AutoProduce_RX_160_Step2

[hiddenAction_AutoProduce_RX_160_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=4500
@define Resource=5500
alsoTriggerAction:AutoProduce_RX_160_Random



[hiddenAction_AutoProduce_RX_160_Random]
alsoTriggerAction:"""
AutoProduce_RX_160_Random_A
"""
[hiddenAction_AutoProduce_RX_160_Random_A]
requireConditional:"""
if true
"""
alsoQueueAction:Produce_RX_160_StandardSquad




[action_Produce_RX_160_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=RX_160
@define Money=4500
@define Resource=5500
@define FactionVisible= (memory.Pannel_TITANS_0087_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:55s

alsoQueueAction:"""
Produce_RX_160_StandardSquad_1
