[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RMS_106:bool


[hiddenAction_Pannel_Close_RMS_106]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RMS_106=false




[hiddenAction_AutoProduce_RMS_106]
@copyFromSection:template_AutoProduce
@define UnitID=RMS_106
alsoTriggerAction:AutoProduce_RMS_106_Step2

[hiddenAction_AutoProduce_RMS_106_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2250
@define Resource=2900
alsoTriggerAction:AutoProduce_RMS_106_Random



[hiddenAction_AutoProduce_RMS_106_Random]
alsoTriggerAction:"""
AutoProduce_RMS_106_Random_A,
AutoProduce_RMS_106_Random_B,
AutoProduce_RMS_106_Random_C
"""
[hiddenAction_AutoProduce_RMS_106_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RMS_106_StandardSquad

[hiddenAction_AutoProduce_RMS_106_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RMS_106_BazookaSquad

[hiddenAction_AutoProduce_RMS_106_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_RMS_106_BRSquad





[action_Pannel_RMS_106]
@copyFromSection:template_Pannel
@define UnitID=RMS_106
@define FactionVisible= (memory.Pannel_TITANS_0087_DontShow==false)

[action_Produce_RMS_106_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=RMS_106
@define Money=2250
@define Resource=2900
@define FactionVisible= (memory.Pannel_TITANS_0087_DontShow==false)
buildSpeed:50s

alsoQueueAction:"""
Produce_RMS_106_StandardSquad_1,
Produce_RMS_106_StandardSquad_2,
Produce_RMS_106_StandardSquad_3
"""
[hiddenAction_Produce_RMS_106_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RMS_106*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RMS_106_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RMS_106*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
