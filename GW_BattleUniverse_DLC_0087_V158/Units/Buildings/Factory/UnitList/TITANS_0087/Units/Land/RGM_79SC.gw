[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGM_79SC:bool


[hiddenAction_Pannel_Close_RGM_79SC]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGM_79SC=false




[hiddenAction_AutoProduce_RGM_79SC]
@copyFromSection:template_AutoProduce
@define UnitID=RGM_79SC
alsoTriggerAction:AutoProduce_RGM_79SC_Step2

[hiddenAction_AutoProduce_RGM_79SC_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3000
@define Resource=3500
alsoTriggerAction:AutoProduce_RGM_79SC_Random



[hiddenAction_AutoProduce_RGM_79SC_Random]
alsoTriggerAction:"""
AutoProduce_RGM_79SC_Random_A,
AutoProduce_RGM_79SC_Random_B
"""
[hiddenAction_AutoProduce_RGM_79SC_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RGM_79SC_StandardSquad

[hiddenAction_AutoProduce_RGM_79SC_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RGM_79SC_BazookaSquad





[action_Pannel_RGM_79SC]
@copyFromSection:template_Pannel
@define UnitID=RGM_79SC
@define FactionVisible= (memory.Pannel_TITANS_0087_DontShow==false)

[action_Produce_RGM_79SC_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=RGM_79SC
@define Money=3700
@define Resource=3800
@define FactionVisible= (memory.Pannel_TITANS_0087_DontShow==false)
buildSpeed:60s

alsoQueueAction:"""
Produce_RGM_79SC_StandardSquad_1,
Produce_RGM_79SC_StandardSquad_2,
Produce_RGM_79SC_StandardSquad_3
"""
[hiddenAction_Produce_RGM_79SC_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RGM_79SC*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RGM_79SC_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RGM_79SC*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RGM_79SC_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
RGM_79SC*1(addResources=PilotType:1101|EquipmentIndex:0)
"""


