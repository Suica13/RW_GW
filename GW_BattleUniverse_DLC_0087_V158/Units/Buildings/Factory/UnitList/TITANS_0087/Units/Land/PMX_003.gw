[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory PMX_003:bool


[hiddenAction_Pannel_Close_PMX_003]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:PMX_003=false




[hiddenAction_AutoProduce_PMX_003]
@copyFromSection:template_AutoProduce
@define UnitID=PMX_003
alsoTriggerAction:AutoProduce_PMX_003_Step2

[hiddenAction_AutoProduce_PMX_003_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=8500
@define Resource=10000
alsoTriggerAction:AutoProduce_PMX_003_Random



[hiddenAction_AutoProduce_PMX_003_Random]
alsoTriggerAction:"""
AutoProduce_PMX_003_Random_A
"""
[hiddenAction_AutoProduce_PMX_003_Random_A]
requireConditional:"""
if true
"""
alsoQueueAction:Produce_PMX_003_StandardSquad




[action_Produce_PMX_003_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=PMX_003
@define Money=8500
@define Resource=10000
@define FactionVisible= (memory.Pannel_TITANS_0087_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:70s

alsoQueueAction:"""
Produce_PMX_003_StandardSquad_1
"""
[hiddenAction_Produce_PMX_003_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
PMX_003*1(addResources=PilotType:1101|EquipmentIndex:0)
"""

