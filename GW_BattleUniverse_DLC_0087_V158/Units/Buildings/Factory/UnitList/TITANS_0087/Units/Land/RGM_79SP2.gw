[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGM_79SP2:bool


[hiddenAction_Pannel_Close_RGM_79SP2]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGM_79SP2=false




[hiddenAction_AutoProduce_RGM_79SP2]
@copyFromSection:template_AutoProduce
@define UnitID=RGM_79SP2
alsoTriggerAction:AutoProduce_RGM_79SP2_Step2

[hiddenAction_AutoProduce_RGM_79SP2_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=4500
@define Resource=5000
alsoTriggerAction:AutoProduce_RGM_79SP2_Random



[hiddenAction_AutoProduce_RGM_79SP2_Random]
alsoTriggerAction:"""
AutoProduce_RGM_79SP2_Random_A,
AutoProduce_RGM_79SP2_Random_B
"""
[hiddenAction_AutoProduce_RGM_79SP2_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RGM_79SP2_StandardSquad

[hiddenAction_AutoProduce_RGM_79SP2_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RGM_79SP2_BazookaSquad





[action_Pannel_RGM_79SP2]
@copyFromSection:template_Pannel
@define UnitID=RGM_79SP2
@define FactionVisible= (memory.Pannel_TITANS_0087_DontShow==false)

[action_Produce_RGM_79SP2_StandardSquad]
