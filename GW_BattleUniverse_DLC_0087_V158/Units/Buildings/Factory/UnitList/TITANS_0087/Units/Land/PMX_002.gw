[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory PMX_002:bool


[hiddenAction_Pannel_Close_PMX_002]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:PMX_002=false




[hiddenAction_AutoProduce_PMX_002]
@copyFromSection:template_AutoProduce
@define UnitID=PMX_002
alsoTriggerAction:AutoProduce_PMX_002_Step2

[hiddenAction_AutoProduce_PMX_002_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3500
@define Resource=5000
alsoTriggerAction:AutoProduce_PMX_002_Random



[hiddenAction_AutoProduce_PMX_002_Random]
alsoTriggerAction:"""
AutoProduce_PMX_002_Random_A
"""
[hiddenAction_AutoProduce_PMX_002_Random_A]
requireConditional:"""
if true
"""
alsoQueueAction:Produce_PMX_002_StandardSquad




[action_Produce_PMX_002_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=PMX_002
@define Money=3500
@define Resource=5000
@define FactionVisible= (memory.Pannel_TITANS_0087_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:60s

alsoQueueAction:"""
Produce_PMX_002_StandardSquad_1
"""
[hiddenAction_Produce_PMX_002_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
PMX_002*1(addResources=PilotType:1101|EquipmentIndex:0)
"""

