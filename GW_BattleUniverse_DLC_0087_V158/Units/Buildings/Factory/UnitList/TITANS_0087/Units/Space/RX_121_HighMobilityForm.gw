[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RX_121_HighMobilityForm:bool


[hiddenAction_Pannel_Close_RX_121_HighMobilityForm]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RX_121_HighMobilityForm=false




[hiddenAction_AutoProduce_RX_121_HighMobilityForm]
@copyFromSection:template_AutoProduce
@define UnitID=RX_121_HighMobilityForm
alsoTriggerAction:AutoProduce_RX_121_HighMobilityForm_Step2

[hiddenAction_AutoProduce_RX_121_HighMobilityForm_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3000
@define Resource=3000
alsoQueueAction:Produce_RX_121_HighMobilityForm_StandardSquad






[action_Produce_RX_121_HighMobilityForm_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=RX_121_HighMobilityForm
@define Money=3000
@define Resource=3000
@define FactionVisible= (memory.Pannel_TITANS_0087_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:45s

alsoQueueAction:"""
Produce_RX_121_HighMobilityForm_StandardSquad_1
"""
[hiddenAction_Produce_RX_121_HighMobilityForm_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RX_121_HighMobilityForm*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
