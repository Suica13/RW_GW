[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini





[hiddenAction_AutoProduce_RX_110]
@copyFromSection:template_AutoProduce
@define UnitID=RX_110
alsoTriggerAction:AutoProduce_RX_110_Step2

[hiddenAction_AutoProduce_RX_110_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=7500
@define Resource=8500
alsoQueueAction:Produce_RX_110_StandardSquad



[action_Produce_RX_110_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=RX_110
@define Money=7500
@define Resource=8500
@define FactionVisible= (memory.Pannel_TITANS_0087_DontShow==false)
buildSpeed:60s

alsoQueueAction:"""
Produce_RX_110_StandardSquad_1,
Produce_RX_110_StandardSquad_2,
Produce_RX_110_StandardSquad_3
"""
[hiddenAction_Produce_RX_110_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RX_110*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RX_110_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RX_110*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RX_110_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
RX_110*1(addResources=PilotType:1101|EquipmentIndex:0)
"""