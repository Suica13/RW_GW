[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini



@memory RMS_099:bool


[hiddenAction_Pannel_Close_RMS_099]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RMS_099=false




[hiddenAction_AutoProduce_RMS_099]
@copyFromSection:template_AutoProduce
@define UnitID=RMS_099
alsoTriggerAction:AutoProduce_RMS_099_Step2

[hiddenAction_AutoProduce_RMS_099_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=5500
@define Resource=7500
alsoTriggerAction:AutoProduce_RMS_099_Random



[hiddenAction_AutoProduce_RMS_099_Random]
alsoTriggerAction:"""
AutoProduce_RMS_099_Random_A,
AutoProduce_RMS_099_Random_B
"""
[hiddenAction_AutoProduce_RMS_099_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RMS_099_StandardSquad

[hiddenAction_AutoProduce_RMS_099_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RMS_099_BazookaSGSquad




[action_Pannel_RMS_099]
@copyFromSection:template_Pannel
@define UnitID=RMS_099
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)

[action_Produce_RMS_099_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=RMS_099
@define Money=6500
@define Resource=7500
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)
buildSpeed:60s

alsoQueueAction:"""
Produce_RMS_099_StandardSquad_1,
Produce_RMS_099_StandardSquad_2,
Produce_RMS_099_StandardSquad_3
"""
[hiddenAction_Produce_RMS_099_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RMS_099*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RMS_099_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RMS_099*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RMS_099_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
RMS_099*1(addResources=PilotType:1101|EquipmentIndex:0)
"""

