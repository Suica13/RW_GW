[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory MSZ_000:bool


[hiddenAction_Pannel_Close_MSZ_000]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MSZ_000=false




[hiddenAction_AutoProduce_MSZ_000]
@copyFromSection:template_AutoProduce
@define UnitID=MSZ_000
alsoTriggerAction:AutoProduce_MSZ_000_Step2

[hiddenAction_AutoProduce_MSZ_000_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=4200
@define Resource=4700
alsoTriggerAction:AutoProduce_MSZ_000_Random



[hiddenAction_AutoProduce_MSZ_000_Random]
alsoTriggerAction:"""
AutoProduce_MSZ_000_Random_A,
AutoProduce_MSZ_000_Random_B,
AutoProduce_MSZ_000_Random_C
"""
[hiddenAction_AutoProduce_MSZ_000_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MSZ_000_StandardSquad

[hiddenAction_AutoProduce_MSZ_000_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=750
"""
alsoQueueAction:Produce_MSZ_000_BazookaSquad

[hiddenAction_AutoProduce_MSZ_000_Random_C]
requireConditional:"""
if memory.randomProduce>750
"""
alsoQueueAction:Produce_MSZ_000_BazookaSGSquad




[action_Pannel_MSZ_000]
@copyFromSection:template_Pannel
@define UnitID=MSZ_000
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png

[action_Produce_MSZ_000_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MSZ_000
@define Money=4200
@define Resource=4700
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)
buildSpeed:55s

text:BR
text_zh:光束步枪

alsoQueueAction:"""
Produce_MSZ_000_StandardSquad_1
"""
[hiddenAction_Produce_MSZ_000_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MSZ_000*1(addResources=PilotType:1101|EquipmentIndex:0)
"""


