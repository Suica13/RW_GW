[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini





[hiddenAction_AutoProduce_MSA_005]
@copyFromSection:template_AutoProduce
@define UnitID=MSA_005
alsoTriggerAction:AutoProduce_MSA_005_Step2

[hiddenAction_AutoProduce_MSA_005_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=7000
@define Resource=8500
alsoQueueAction:Produce_MSA_005_StandardSquad



[action_Produce_MSA_005_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=MSA_005
@define Money=7000
@define Resource=8500
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)
buildSpeed:55s

alsoQueueAction:"""
Produce_MSA_005_StandardSquad_1,
Produce_MSA_005_StandardSquad_2,
Produce_MSA_005_StandardSquad_3
"""
[hiddenAction_Produce_MSA_005_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MSA_005*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MSA_005_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MSA_005*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MSA_005_StandardSquad_3]
