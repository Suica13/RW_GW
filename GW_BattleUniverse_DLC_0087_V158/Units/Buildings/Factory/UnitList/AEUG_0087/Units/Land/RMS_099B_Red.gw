[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini



@memory RMS_099B_Red:bool


[hiddenAction_Pannel_Close_RMS_099B_Red]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RMS_099B_Red=false




[hiddenAction_AutoProduce_RMS_099B_Red]
@copyFromSection:template_AutoProduce
@define UnitID=RMS_099B_Red
alsoTriggerAction:AutoProduce_RMS_099B_Red_Step2

[hiddenAction_AutoProduce_RMS_099B_Red_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=6500
@define Resource=9000
alsoTriggerAction:AutoProduce_RMS_099B_Red_Random



[hiddenAction_AutoProduce_RMS_099B_Red_Random]
alsoTriggerAction:"""
AutoProduce_RMS_099B_Red_Random_A,
AutoProduce_RMS_099B_Red_Random_B
"""
[hiddenAction_AutoProduce_RMS_099B_Red_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
