[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory MSA_004K:bool


[hiddenAction_Pannel_Close_MSA_004K]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MSA_004K=false




[hiddenAction_AutoProduce_MSA_004K]
@copyFromSection:template_AutoProduce
@define UnitID=MSA_004K
alsoTriggerAction:AutoProduce_MSA_004K_Step2

[hiddenAction_AutoProduce_MSA_004K_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=6500
@define Resource=6500
alsoTriggerAction:AutoProduce_MSA_004K_Random



[hiddenAction_AutoProduce_MSA_004K_Random]
alsoTriggerAction:"""
AutoProduce_MSA_004K_Random_A,
AutoProduce_MSA_004K_Random_B,
AutoProduce_MSA_004K_Random_C
"""
[hiddenAction_AutoProduce_MSA_004K_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MSA_004K_StandardSquad

[hiddenAction_AutoProduce_MSA_004K_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_MSA_004K_MGSquad

[hiddenAction_AutoProduce_MSA_004K_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_MSA_004K_BazookaSquad





[action_Pannel_MSA_004K]
@copyFromSection:template_Pannel
@define UnitID=MSA_004K
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)

[action_Produce_MSA_004K_StandardSquad]
