@define UnitID=MSA_004K
@define Money=6500
@define Resource=6500
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)
buildSpeed:60s

alsoQueueAction:"""
Produce_MSA_004K_StandardSquad_1,
Produce_MSA_004K_StandardSquad_2,
Produce_MSA_004K_StandardSquad_3
"""
[hiddenAction_Produce_MSA_004K_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MSA_004K*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
