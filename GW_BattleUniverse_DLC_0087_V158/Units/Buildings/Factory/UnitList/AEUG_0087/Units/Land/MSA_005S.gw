@define UnitID=MSA_005S
@define Money=8000
@define Resource=10000
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)
buildSpeed:55s

alsoQueueAction:"""
Produce_MSA_005S_StandardSquad_1,
Produce_MSA_005S_StandardSquad_2,
Produce_MSA_005S_StandardSquad_3
"""
