[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RX_178_AEUG_FlyingArmor:bool


[hiddenAction_Pannel_Close_RX_178_AEUG_FlyingArmor]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RX_178_AEUG_FlyingArmor=false




[hiddenAction_AutoProduce_RX_178_AEUG_FlyingArmor]
@copyFromSection:template_AutoProduce
@define UnitID=RX_178_AEUG_FlyingArmor
alsoTriggerAction:AutoProduce_RX_178_AEUG_FlyingArmor_Step2

[hiddenAction_AutoProduce_RX_178_AEUG_FlyingArmor_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3500
@define Resource=4250
alsoTriggerAction:AutoProduce_RX_178_AEUG_FlyingArmor_Random



[hiddenAction_AutoProduce_RX_178_AEUG_FlyingArmor_Random]
alsoTriggerAction:"""
AutoProduce_RX_178_AEUG_FlyingArmor_Random_A,
AutoProduce_RX_178_AEUG_FlyingArmor_Random_B,
AutoProduce_RX_178_AEUG_FlyingArmor_Random_C
"""
