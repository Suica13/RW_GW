[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_14F:bool


[hiddenAction_Pannel_Close_MS_14F]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_14F=false



[hiddenAction_AutoProduce_MS_14F]
@copyFromSection:template_AutoProduce
@define UnitID=MS_14F
alsoTriggerAction:AutoProduce_MS_14F_Step2

[hiddenAction_AutoProduce_MS_14F_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2850
@define Resource=3000
alsoTriggerAction:AutoProduce_MS_14F_Random



[hiddenAction_AutoProduce_MS_14F_Random]
alsoTriggerAction:"""
AutoProduce_MS_14F_Random_A,
AutoProduce_MS_14F_Random_B
"""
[hiddenAction_AutoProduce_MS_14F_Random_A]
requireConditional:"""
if memory.randomProduce<500
"""
alsoQueueAction:Produce_MS_14F_StandardSquad

[hiddenAction_AutoProduce_MS_14F_Random_B]
requireConditional:"""
if memory.randomProduce>500
"""
alsoQueueAction:Produce_MS_14F_BazookaSquad




[action_Pannel_MS_14F]
@copyFromSection:template_Pannel
@define UnitID=MS_14F
@define FactionVisible= (memory.Pannel_NEO_ZEON_0087_DontShow==false)


[action_Produce_MS_14F_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MS_14F
@define Money=2850
@define Resource=3000
@define FactionVisible= (memory.Pannel_NEO_ZEON_0087_DontShow==false)
buildSpeed:55s

alsoQueueAction:"""
Produce_MS_14F_StandardSquad_1,
Produce_MS_14F_StandardSquad_2,
Produce_MS_14F_StandardSquad_3
"""
[hiddenAction_Produce_MS_14F_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_14F*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_14F_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
