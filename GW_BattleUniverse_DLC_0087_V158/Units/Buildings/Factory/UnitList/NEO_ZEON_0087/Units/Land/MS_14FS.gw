[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory MS_14FS:bool


[hiddenAction_Pannel_Close_MS_14FS]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_14FS=false




[hiddenAction_AutoProduce_MS_14FS]
@copyFromSection:template_AutoProduce
@define UnitID=MS_14FS
alsoTriggerAction:AutoProduce_MS_14FS_Step2

[hiddenAction_AutoProduce_MS_14FS_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2450
@define Resource=2350
alsoTriggerAction:AutoProduce_MS_14FS_Random



[hiddenAction_AutoProduce_MS_14FS_Random]
alsoTriggerAction:"""
AutoProduce_MS_14FS_Random_A,
AutoProduce_MS_14FS_Random_B,
AutoProduce_MS_14FS_Random_C
"""
[hiddenAction_AutoProduce_MS_14FS_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MS_14FS_StandardSquad

[hiddenAction_AutoProduce_MS_14FS_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_MS_14FS_BMGSquad

[hiddenAction_AutoProduce_MS_14FS_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_MS_14FS_BazookaSquad





[action_Pannel_MS_14FS]
@copyFromSection:template_Pannel
@define UnitID=MS_14FS
@define FactionVisible= (memory.Pannel_NEO_ZEON_0087_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png

[action_Produce_MS_14FS_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MS_14FS
@define Money=1950
@define Resource=2450
@define FactionVisible= (memory.Pannel_NEO_ZEON_0087_DontShow==false)
buildSpeed:45s

text:BMG
text_zh:光束机枪

alsoQueueAction:"""
Produce_MS_14FS_StandardSquad_1
"""
[hiddenAction_Produce_MS_14FS_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_14FS*1(addResources=PilotType:1101|EquipmentIndex:0)
"""



[action_Produce_MS_14FS_BazookaSquad]
@copyFromSection:template_Produce
@define UnitID=MS_14FS
@define Money=1550
@define Resource=2050
@define FactionVisible= (memory.Pannel_NEO_ZEON_0087_DontShow==false)
buildSpeed:45s

text:Bazooka
text_zh:火箭筒

alsoQueueAction:"""
Produce_MS_14FS_BazookaSquad_1
"""
[hiddenAction_Produce_MS_14FS_BazookaSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_14FS*1(addResources=PilotType:1101|EquipmentIndex:1)
"""


[action_Produce_MS_14FS_BMGSquad]
@copyFromSection:template_Produce
@define UnitID=MS_14FS
@define Money=2150
@define Resource=2250
@define FactionVisible= (memory.Pannel_NEO_ZEON_0087_DontShow==false)
buildSpeed:45s

