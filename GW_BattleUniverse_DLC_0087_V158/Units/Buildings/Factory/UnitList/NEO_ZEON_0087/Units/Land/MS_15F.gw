[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_15F:bool


[hiddenAction_Pannel_Close_MS_15F]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_15F=false



[hiddenAction_AutoProduce_MS_15F]
@copyFromSection:template_AutoProduce
@define UnitID=MS_15F
alsoTriggerAction:AutoProduce_MS_15F_Step2

[hiddenAction_AutoProduce_MS_15F_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3550
@define Resource=4200
alsoTriggerAction:AutoProduce_MS_15F_Random



[hiddenAction_AutoProduce_MS_15F_Random]
alsoTriggerAction:"""
AutoProduce_MS_15F_Random_A
"""
[hiddenAction_AutoProduce_MS_15F_Random_A]
requireConditional:"""
if memory.randomProduce<1000
"""
alsoQueueAction:Produce_MS_15F_StandardSquad


[action_Produce_MS_15F_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=MS_15F
@define Money=3550
@define Resource=4200
@define FactionVisible= (memory.Pannel_NEO_ZEON_0087_DontShow==false)
buildSpeed:60s

alsoQueueAction:"""
Produce_MS_15F_StandardSquad_1,
Produce_MS_15F_StandardSquad_2,
Produce_MS_15F_StandardSquad_3
"""
[hiddenAction_Produce_MS_15F_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_15F*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_15F_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MS_15F*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_15F_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
MS_15F*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
