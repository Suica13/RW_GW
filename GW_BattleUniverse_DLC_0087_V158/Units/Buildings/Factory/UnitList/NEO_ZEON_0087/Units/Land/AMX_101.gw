@define Money=9500
@define Resource=9500
alsoQueueAction:Produce_AMX_101_StandardSquad



[action_Produce_AMX_101_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=AMX_101
@define Money=9500
@define Resource=9500
@define FactionVisible= (memory.Pannel_NEO_ZEON_0087_DontShow==false)
buildSpeed:65s

alsoQueueAction:"""
Produce_AMX_101_StandardSquad_1,
Produce_AMX_101_StandardSquad_2,
Produce_AMX_101_StandardSquad_3
"""
[hiddenAction_Produce_AMX_101_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
AMX_101*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
