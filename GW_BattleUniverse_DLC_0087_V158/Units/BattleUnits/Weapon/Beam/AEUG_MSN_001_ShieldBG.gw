[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""

@memory AEUG_MSN_001_ShieldBG_CDTimer:float
@global AEUG_MSN_001_ShieldBG_CD=3
@global AEUG_MSN_001_ShieldBG_EN=50










[turret_AEUG_MSN_001_ShieldBG]
x:0
y:0

canShoot:false
showRangeUIGuide:false
projectile:AEUG_MSN_001_ShieldBG_Projectile

delay:0.1s
limitingRange:1200
limitingAngle:3

canAttackMaxAngle:15
barrelX:-12
barrelY:6

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_1.ogg
shoot_sound_vol:0.35
shoot_flame:Beam_Fire_1_Yellow_S


[projectile_AEUG_MSN_001_ShieldBG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Yellow*1
(
    addResources=
    BeamDamage:4500
    |DpDamage:100
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=0.5
    |AntiAir=1.0
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:80
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""




[hiddenAction_AEUG_MSN_001_ShieldBG_Trigger]
alsoTriggerAction:AEUG_MSN_001_ShieldBG_Fire
[hiddenAction_AEUG_MSN_001_ShieldBG_Fire]
requireConditional:"""
if self.timeAlive>memory.AEUG_MSN_001_ShieldBG_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  
and not (directionBetween(self, self.attacking) < self.dir-35 or directionBetween(self, self.attacking) > self.dir+35)  
and self.resource.EN>0
"""
setUnitMemory:AEUG_MSN_001_ShieldBG_CDTimer=self.timeAlive+${AEUG_MSN_001_ShieldBG_CD} 
addResources:EN=-${AEUG_MSN_001_ShieldBG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
AEUG_MSN_001_ShieldBG_SetWeaponIndex,
PlayCommon_Shoot_A_L_Step_1,
AEUG_MSN_001_ShieldBG_B6_Step_1
"""
[hiddenAction_AEUG_MSN_001_ShieldBG_B6_Step_1]
alsoQueueAction:"""
AEUG_MSN_001_ShieldBG_Fire_Step_1,
AEUG_MSN_001_ShieldBG_Fire_Step_2,
AEUG_MSN_001_ShieldBG_Fire_Step_3,
AEUG_MSN_001_ShieldBG_Fire_Step_3,
AEUG_MSN_001_ShieldBG_Fire_Step_3,
AEUG_MSN_001_ShieldBG_Fire_Step_3,
AEUG_MSN_001_ShieldBG_Fire_Step_3,
AEUG_MSN_001_ShieldBG_Fire_Step_Final
"""




[hiddenAction_AEUG_MSN_001_ShieldBG_SetWeaponIndex]
isVisible:false


[hiddenAction_AEUG_MSN_001_ShieldBG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false and self.shield>0
"""
buildSpeed:0s
[hiddenAction_AEUG_MSN_001_ShieldBG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and self.shield>0
"""
buildSpeed:0.075s
fireTurretXAtGround:AEUG_MSN_001_ShieldBG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_AEUG_MSN_001_ShieldBG_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false and self.shield>0
"""
buildSpeed:0.075s
fireTurretXAtGround:AEUG_MSN_001_ShieldBG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_AEUG_MSN_001_ShieldBG_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff