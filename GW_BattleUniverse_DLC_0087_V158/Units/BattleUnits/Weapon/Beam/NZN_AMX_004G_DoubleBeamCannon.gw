[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory NZN_AMX_004G_DoubleBeamCannon_CDTimer:float
@global NZN_AMX_004G_DoubleBeamCannon_CD=3.5
@global NZN_AMX_004G_DoubleBeamCannon_EN=85








[turret_NZN_AMX_004G_DoubleBeamCannon]
x:0
y:0

canShoot:false
projectile:NZN_AMX_004G_DoubleBeamCannon_Projectile

delay:0.3s
canAttackMaxAngle:15
limitingAngle:0
barrelX:7
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamCannon_2.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Yellow
[turret_NZN_AMX_004G_DoubleBeamCannon_L]
@copyFromSection:turret_NZN_AMX_004G_DoubleBeamCannon
barrelX:-7
shoot_sound_vol:0



[projectile_NZN_AMX_004G_DoubleBeamCannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_AP_BeamRifle_Yellow*1
(
    addResources=
    BeamDamage:8000 
    |BeamAPDamage:2000
    |DpDamage:250
    |WeaponAccuracy=75
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1 
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1 
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2.5
    |HeightHitRange=25
    |ProjectileSpeed:95
    |ProjectileSpread:1
    |ProjectileLife:30

    |ProjectileAttackTimes:3
    |ProjectileAttackTimesDamageModifier:0.75
)
"""








[hiddenAction_NZN_AMX_004G_DoubleBeamCannon_Trigger]
alsoTriggerAction:NZN_AMX_004G_DoubleBeamCannon_Fire
[hiddenAction_NZN_AMX_004G_DoubleBeamCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_AMX_004G_DoubleBeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:NZN_AMX_004G_DoubleBeamCannon_CDTimer=self.timeAlive+${NZN_AMX_004G_DoubleBeamCannon_CD}
addResources:EN=-${NZN_AMX_004G_DoubleBeamCannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
PlayCommon_Cannon_Shoot_A_Step_1,
NZN_AMX_004G_DoubleBeamCannon_SetWeaponIndex,
NZN_AMX_004G_DoubleBeamCannon_B1_Step_1
"""
[hiddenAction_NZN_AMX_004G_DoubleBeamCannon_B1_Step_1]
alsoQueueAction:"""
NZN_AMX_004G_DoubleBeamCannon_Fire_Step_1,
NZN_AMX_004G_DoubleBeamCannon_Fire_Step_2,
NZN_AMX_004G_DoubleBeamCannon_Fire_Step_3,
NZN_AMX_004G_DoubleBeamCannon_Fire_Step_Final
"""






[hiddenAction_NZN_AMX_004G_DoubleBeamCannon_SetWeaponIndex]
isVisible:false


[hiddenAction_NZN_AMX_004G_DoubleBeamCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_NZN_AMX_004G_DoubleBeamCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:NZN_AMX_004G_DoubleBeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_NZN_AMX_004G_DoubleBeamCannon_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:NZN_AMX_004G_DoubleBeamCannon_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_NZN_AMX_004G_DoubleBeamCannon_Fire_Step_Final]
buildSpeed:1.0s
finishPlayingLastAnimation:true
alsoTriggerAction:SetAttackingOff


