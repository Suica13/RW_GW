ZN_MSM_10_HighBeamRifle_Fire_Step_2,
ZN_MSM_10_HighBeamRifle_Fire_Step_2,
ZN_MSM_10_HighBeamRifle_Fire_Step_2,
ZN_MSM_10_HighBeamRifle_Fire_Step_2,
ZN_MSM_10_HighBeamRifle_Fire_Step_Final,
ZN_MSM_10_HighBeamRifle_BulletEffect_1_StopPlay
"""




[hiddenAction_ZN_MSM_10_HighBeamRifle_B1_Step_1_AI]
requireConditional:if ${allowAI}==true
setUnitMemory:"""
ZN_MSM_10_HighBeamRifle_AimTarget=memory.ZN_MSM_10_HighBeamRifle_AimTarget.getOffsetRelative(),
ZN_MSM_10_HighBeamRifle_CDTimer=self.timeAlive+${ZN_MSM_10_HighBeamRifle_CD}
"""
setBodyRotation:directionBetween(self,memory.ZN_MSM_10_HighBeamRifle_AimTarget)

alsoTriggerAction:"""
SetAttackingCantTurnOn
"""

alsoQueueAction:"""
SetAttackingCantAimOn,
ZN_MSM_10_HighBeamRifle_Fire_Step_ChargeEffect_1,
ZN_MSM_10_HighBeamRifle_Fire_Step_1_AI,
ZN_MSM_10_HighBeamRifle_Fire_Step_BulletEffect_1,
