ZN_MSM_10_HighBeamRifle_Fire_Step_Final,
ZN_MSM_10_HighBeamRifle_BulletEffect_1_StopPlay
"""








[hiddenAction_ZN_MSM_10_HighBeamRifle_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MSM_10_HighBeamRifle_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.75s
spawnEffects:Flash_1_L

stopLastAnimation:true
fireTurretXAtGround:ZN_MSM_10_HighBeamRifle
fireTurretXAtGround_count:0
fireTurretXAtGround_withTarget:memory.ZN_MSM_10_HighBeamRifle_AimTarget

whenBuilding_cannotMove:true
