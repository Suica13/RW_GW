[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw
"""

@memory ZN_MS_09_ChestBeam_CDTimer:float
@global ZN_MS_09_ChestBeam_CD=10
@global ZN_MS_09_ChestBeam_EN=20










[turret_ZN_MS_09_ChestBeam]
x:0
y:0

canShoot:false
projectile:ZN_MS_09_ChestBeam_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:-6
barrelY:5
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource/Sound/SE/Weapon/Fire/BeamSprayGun_2.ogg
shoot_sound_vol:0.75
shoot_flame:Beam_Fire_1_Yellow_S



[projectile_ZN_MS_09_ChestBeam_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamShotGun_Yellow*8
(
    offsetRandomDir=8,
    addResources=
    BeamDamage:400
    |DpDamage:140
    |WeaponAccuracy=95
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1.0
    |PilotTrueDamage=0.0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.5 
    |AntiLand=1
    |AntiSpace=1
 
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:55
    |ProjectileSpread:1
    |ProjectileLife:10
)
"""





[hiddenAction_ZN_MS_09_ChestBeam_Trigger]
alsoTriggerAction:ZN_MS_09_ChestBeam_Fire
[hiddenAction_ZN_MS_09_ChestBeam_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MS_09_ChestBeam_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:ZN_MS_09_ChestBeam_CDTimer=self.timeAlive+${ZN_MS_09_ChestBeam_CD}
addResources:EN=-${ZN_MS_09_ChestBeam_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_MS_09_ChestBeam_SetWeaponIndex,
ZN_MS_09_ChestBeam_B1_Step_1
"""
[hiddenAction_ZN_MS_09_ChestBeam_B1_Step_1]
alsoQueueAction:"""
ZN_MS_09_ChestBeam_Fire_Step_1,
ZN_MS_09_ChestBeam_Fire_Step_2,
ZN_MS_09_ChestBeam_Fire_Step_Final
"""



[hiddenAction_ZN_MS_09_ChestBeam_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MS_09_ChestBeam_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.1s
[hiddenAction_ZN_MS_09_ChestBeam_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_MS_09_ChestBeam
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MS_09_ChestBeam_Fire_Step_3]
@copyFromSection:hiddenAction_ZN_MS_09_ChestBeam_Fire_Step_2
buildSpeed:${turret_ZN_MS_09_ChestBeam.delay}
[hiddenAction_ZN_MS_09_ChestBeam_Fire_Step_Final]
buildSpeed:0.1s
alsoTriggerAction:SetAttackingOff

