[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_Two_Handed_A.gw
"""

@memory AEUG_MSZ_006_HML_CDTimer:float
@global AEUG_MSZ_006_HML_CD=4
@global AEUG_MSZ_006_HML_EN=120



[decal_AEUG_MSZ_006_HML_Idle]
layer:beforeBody
order:6.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Weapon/Beam/Image/AEUG_MSZ_006_HML_2.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.9
xOffsetRelative: -16
yOffsetRelative: 14
dirOffset:-80
[decal_AEUG_MSZ_006_HML_Attack]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Weapon/Beam/Image/AEUG_MSZ_006_HML_1.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.9
xOffsetRelative: 0
yOffsetRelative: 30
dirOffset:0
[decal_AEUG_MSZ_006_HML_NotUsing]
@copyFromSection:decal_AEUG_MSZ_006_HML_Idle
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.8
xOffsetRelative:-8
yOffsetRelative:-10
dirOffset:-90






[turret_AEUG_MSZ_006_HML]
x:0
y:0

canShoot:false
projectile:AEUG_MSZ_006_HML_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:12
barrelY:32
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCannon_2.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Fire_1_Pink



[projectile_AEUG_MSZ_006_HML_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_HighBeamCannon_Pink*1
(
    addResources=
    BeamDamage:15000
    |BeamAPDamage:5000
    |DpDamage:900
    |WeaponAccuracy=75
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:1
    |ProjectileExplosionRange:45
    |ProjectileLife:25

    |ProjectileAttackTimes:7
    |ProjectileAttackTimesDamageModifier:0.75
),
Projectile_HighBeamCannon_Pink_Effect*1
(
    addResources=
    ProjectileSpeed:1.0
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""








[hiddenAction_AEUG_MSZ_006_HML_Trigger]
alsoTriggerAction:AEUG_MSZ_006_HML_Fire
[hiddenAction_AEUG_MSZ_006_HML_Fire]
requireConditional:"""
if self.timeAlive>memory.AEUG_MSZ_006_HML_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:AEUG_MSZ_006_HML_CDTimer=self.timeAlive+${AEUG_MSZ_006_HML_CD}
addResources:EN=-${AEUG_MSZ_006_HML_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
AEUG_MSZ_006_HML_SetWeaponIndex,
PlayCommon_Shoot_Two_Handed_A_Step_1,
AEUG_MSZ_006_HML_B1_Step_1
"""
[hiddenAction_AEUG_MSZ_006_HML_B1_Step_1]
alsoQueueAction:"""
AEUG_MSZ_006_HML_Fire_Step_1,
AEUG_MSZ_006_HML_Fire_Step_2,
AEUG_MSZ_006_HML_Fire_Step_Final
"""




[hiddenAction_AEUG_MSZ_006_HML_SetWeaponIndex]
isVisible:false


[hiddenAction_AEUG_MSZ_006_HML_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.45s
[hiddenAction_AEUG_MSZ_006_HML_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:AEUG_MSZ_006_HML
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_AEUG_MSZ_006_HML_Fire_Step_Final]
buildSpeed:0.65s
alsoTriggerAction:SetAttackingOff
stopLastAnimation:true


