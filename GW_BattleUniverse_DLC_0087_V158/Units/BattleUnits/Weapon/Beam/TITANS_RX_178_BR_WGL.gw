[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory TITANS_RX_178_BR_WGL_CDTimer:float
@global TITANS_RX_178_BR_WGL_CD=1.5
@global TITANS_RX_178_BR_WGL_EN=60





[decal_TITANS_RX_178_BR_WGL]
layer:beforeBody
order:4.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Beam\Image\TITANS_RX_178_BR_WGL.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1.0
xOffsetRelative: 1
yOffsetRelative: 14
dirOffset:0
[decal_TITANS_RX_178_BR_WGL_NotUsing]
@copyFromSection:decal_TITANS_RX_178_BR_WGL
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:1.0
xOffsetRelative:1
yOffsetRelative:-10
dirOffset:-90







[turret_TITANS_RX_178_BR_WGL]
x:0
y:0

canShoot:false
projectile:TITANS_RX_178_BR_WGL_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:9
barrelY:25
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_3.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Yellow
[turret_TITANS_RX_178_BR_WGL_GL]
@copyFromSection:turret_TITANS_RX_178_BR_WGL
barrelX:9
barrelY:25
projectile:TITANS_RX_178_BR_WGL_GL_Projectile

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1_S



[projectile_TITANS_RX_178_BR_WGL_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamRifle_Yellow*1
(
    addResources=
    BeamDamage:7500
    |DpDamage:250
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:90
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""

[projectile_TITANS_RX_178_BR_WGL_GL_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_S*1
(
    addResources=
    ShellDamage:3500
    |DpDamage:200
    |WeaponAccuracy=90
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75
    |AntiLand=1 
    |AntiSpace=1 
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:85
    |ProjectileSpread:2
    |ProjectileExplosionRange:35
    |ProjectileLife:25
)
"""




[hiddenAction_TITANS_RX_178_BR_WGL_Trigger]
alsoTriggerAction:TITANS_RX_178_BR_WGL_Fire
[hiddenAction_TITANS_RX_178_BR_WGL_Fire]
requireConditional:"""
if self.timeAlive>memory.TITANS_RX_178_BR_WGL_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:TITANS_RX_178_BR_WGL_CDTimer=self.timeAlive+${TITANS_RX_178_BR_WGL_CD}
addResources:EN=-${TITANS_RX_178_BR_WGL_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
TITANS_RX_178_BR_WGL_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
TITANS_RX_178_BR_WGL_B2_Step_1
"""
[hiddenAction_TITANS_RX_178_BR_WGL_B2_Step_1]
alsoQueueAction:"""
TITANS_RX_178_BR_WGL_Fire_Step_1,
TITANS_RX_178_BR_WGL_Fire_Step_2,
TITANS_RX_178_BR_WGL_Fire_Step_3,
TITANS_RX_178_BR_WGL_Fire_Step_4,
TITANS_RX_178_BR_WGL_Fire_Step_Final
"""



[hiddenAction_TITANS_RX_178_BR_WGL_SetWeaponIndex]
isVisible:false


[hiddenAction_TITANS_RX_178_BR_WGL_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_TITANS_RX_178_BR_WGL_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:TITANS_RX_178_BR_WGL
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_TITANS_RX_178_BR_WGL_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
fireTurretXAtGround:TITANS_RX_178_BR_WGL
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_TITANS_RX_178_BR_WGL_Fire_Step_4]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.05s
fireTurretXAtGround:TITANS_RX_178_BR_WGL_GL
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)


[hiddenAction_TITANS_RX_178_BR_WGL_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

