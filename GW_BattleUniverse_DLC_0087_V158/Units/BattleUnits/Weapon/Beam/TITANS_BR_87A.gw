[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory TITANS_BR_87A_CDTimer:float
@global TITANS_BR_87A_CD=1.5
@global TITANS_BR_87A_EN=40





[decal_TITANS_BR_87A]
layer:beforeBody
order:4.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Beam\Image\TITANS_BR_87A.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1.0
xOffsetRelative: 3
yOffsetRelative: 15
dirOffset:0
[decal_TITANS_BR_87A_NotUsing]
@copyFromSection:decal_TITANS_BR_87A
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.85
xOffsetRelative:3.5
yOffsetRelative:-8.5
dirOffset:-90







[turret_TITANS_BR_87A]
x:0
y:0

canShoot:false
projectile:TITANS_BR_87A_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:12
barrelY:28
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_3.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Yellow



[projectile_TITANS_BR_87A_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamRifle_Yellow*1
(
    addResources=
    BeamDamage:9000
    |DpDamage:250
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:90
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""





[hiddenAction_TITANS_BR_87A_Trigger]
alsoTriggerAction:TITANS_BR_87A_Fire
[hiddenAction_TITANS_BR_87A_Fire]
requireConditional:"""
if self.timeAlive>memory.TITANS_BR_87A_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:TITANS_BR_87A_CDTimer=self.timeAlive+${TITANS_BR_87A_CD}
addResources:EN=-${TITANS_BR_87A_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
TITANS_BR_87A_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
TITANS_BR_87A_B1_Step_1
"""
[hiddenAction_TITANS_BR_87A_B1_Step_1]
alsoQueueAction:"""
TITANS_BR_87A_Fire_Step_1,
TITANS_BR_87A_Fire_Step_2,
TITANS_BR_87A_Fire_Step_Final
"""



[hiddenAction_TITANS_BR_87A_SetWeaponIndex]
isVisible:false


[hiddenAction_TITANS_BR_87A_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_TITANS_BR_87A_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:TITANS_BR_87A
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_TITANS_BR_87A_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

