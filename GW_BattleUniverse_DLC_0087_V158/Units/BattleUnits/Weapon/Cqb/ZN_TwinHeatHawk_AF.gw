[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Cqb/Common/Cqb_Fire_1_Yellow_R.gw,
ROOT:Resource/Image/Fx/Weapon/Cqb/Common/Cqb_Fire_1_Yellow_L.gw,
ROOT:Template\Unit\Animation\Cqb\Common_Melee_A.gw,
ROOT:Template\Unit\Animation\Cqb\Common_Melee_F.gw
"""

@memory ZN_TwinHeatHawk_AF_CDTimer:float
@global ZN_TwinHeatHawk_AF_CD=3.5



[decal_ZN_TwinHeatHawk_AF]
layer:beforeBody
order:4.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Weapon/Cqb/Image/ZN_TwinHeatHawk.png
isVisible:false
basePositionFromLegEnd:arm11
imageScale:0.85
imageScaleX:-1
xOffsetRelative:12
yOffsetRelative:23
dirOffset:12



[turret_ZN_TwinHeatHawk_AF_A]
x:0
y:0
invisible:true

canShoot:false

showRangeUIGuide:false
projectile:ZN_TwinHeatHawk_AF_A_Projectile

delay:3s
limitingMinRange:0
limitingRange:0

canAttackMaxAngle:60
barrelX:0
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamSaber_1.ogg
shoot_sound_vol:0.5

[projectile_ZN_TwinHeatHawk_AF_A_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Saber_A*1
(
    addResources=
    CqbDamage:3250
    |CqbShellDamage:3250
    |DpDamage:750
    |WeaponAccuracy:125
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.35
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.35
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightHitRange:35
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileLife:0.25
    |ProjectileAttackTimes:2
)
"""
[projectile_ZN_TwinHeatHawk_AF_F_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Saber_A_L*1
(
    addResources=
    CqbDamage:3250
    |CqbShellDamage:3250
    |DpDamage:500
    |WeaponAccuracy:125
    |AntiSizeLargeDamage=1.35
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.35
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightHitRange:35
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileLife:0.25
    |ProjectileAttackTimes:1
)
"""







[hiddenAction_ZN_TwinHeatHawk_AF_Trigger]
alsoTriggerAction:ZN_TwinHeatHawk_AF_Fire
[hiddenAction_ZN_TwinHeatHawk_AF_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_TwinHeatHawk_AF_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) 
and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50
"""
setUnitMemory:ZN_TwinHeatHawk_AF_CDTimer=self.timeAlive+${ZN_TwinHeatHawk_AF_CD}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Cqb,
ZN_TwinHeatHawk_AF_A_SetWeaponIndex,
PlayCommon_Melee_A_Step_1,
ZN_TwinHeatHawk_AF_Step_1
"""
[hiddenAction_ZN_TwinHeatHawk_AF_Step_1]
alsoQueueAction:"""
ZN_TwinHeatHawk_AF_Fire_Step_1,
ZN_TwinHeatHawk_AF_Fire_Step_2,
ZN_TwinHeatHawk_AF_Fire_Step_3,
ZN_TwinHeatHawk_AF_Fire_Step_4,
ZN_TwinHeatHawk_AF_Fire_Step_5,
ZN_TwinHeatHawk_AF_Fire_Step_Final
"""







[hiddenAction_ZN_TwinHeatHawk_AF_A_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_TwinHeatHawk_AF_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.6s
[hiddenAction_ZN_TwinHeatHawk_AF_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_TwinHeatHawk_AF_A
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_1_Yellow_R
[hiddenAction_ZN_TwinHeatHawk_AF_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.6s
alsoTriggerAction:PlayCommon_Melee_F_Step_1
[hiddenAction_ZN_TwinHeatHawk_AF_Fire_Step_4]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_ZN_TwinHeatHawk_AF_Fire_Step_5]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_TwinHeatHawk_AF_A
fireTurretXAtGround_withProjectile:ZN_TwinHeatHawk_AF_F_Projectile
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_1_Yellow_L
[hiddenAction_ZN_TwinHeatHawk_AF_Fire_Step_Final]
buildSpeed:1.4s
alsoTriggerAction:SetAttackingOff

