[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw
"""

@memory EF_AMS_Squad_MG_OnCD:bool
@memory EF_AMS_Squad_MG_CDTimer:float
@global EF_AMS_Squad_MG_CD=2

@global EF_AMS_Squad_MG_Shoot=12
[resource_EF_AMS_Squad_MG_ShootTimer]
hidden:true








[turret_EF_AMS_Squad_MG]
x:3.5
y:7

canShoot:true
canAttackCondition:"""
if ${onAttacking}==false and ${cantAction}==false 
"""
showRangeUIGuide:false
projectile:EF_AMS_Squad_MG_Projectile
resourceUsage:EF_AMS_Squad_MG_ShootTimer=1

delay:0.1s
canAttackMaxAngle:3
barrelX:0.5
barrelY:3
turnSpeed:2.5

aimOffsetSpread:0
recoilOffset:0
recoilOutTime:0
recoilReturnTime:0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_2.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1_S



[projectile_EF_AMS_Squad_MG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Vulcan*1
(
    addResources=
    ShellDamage:50
    |DpDamage:5
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=1
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=1
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=25
    |ProjectileSpeed:85
    |ProjectileSpread:8
    |ProjectileLife:7
)
"""


[hiddenAction_EF_AMS_Squad_MG_CDStart]
autoTrigger:"""
if memory.EF_AMS_Squad_MG_OnCD==false 
and 
(
    (
        self.resource.EF_AMS_Squad_MG_ShootTimer<=0 
    ) 
    or 
    (
        self.resource.EF_AMS_Squad_MG_ShootTimer<${EF_AMS_Squad_MG_Shoot} and not self.hasTags(includes='inBattle')
    )
)
"""
setUnitMemory:EF_AMS_Squad_MG_OnCD=true,EF_AMS_Squad_MG_CDTimer=self.timeAlive+${EF_AMS_Squad_MG_CD}

[hiddenAction_EF_AMS_Squad_MG_CDEnd]
autoTriggerOnEvent:created
autoTrigger:if memory.EF_AMS_Squad_MG_OnCD==true and self.timeAlive>memory.EF_AMS_Squad_MG_CDTimer
setUnitMemory:EF_AMS_Squad_MG_OnCD=false
setResourcesWithLogic:EF_AMS_Squad_MG_ShootTimer=${EF_AMS_Squad_MG_Shoot}
