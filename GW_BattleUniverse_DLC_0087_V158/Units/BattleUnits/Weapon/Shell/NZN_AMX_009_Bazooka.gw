[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory NZN_AMX_009_Bazooka_CDTimer:float
@global NZN_AMX_009_Bazooka_CD=3.0
@global NZN_AMX_009_Bazooka_EN=45





[decal_NZN_AMX_009_Bazooka]
layer:beforeBody
order:6.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\NZN_AMX_009_Bazooka.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.9
xOffsetRelative: 2.5
yOffsetRelative: 12
dirOffset:0
[decal_NZN_AMX_009_Bazooka_NotUsing]
@copyFromSection:decal_NZN_AMX_009_Bazooka
order:0
basePositionFromLegEnd:arm1
imageScale:0.8
imageScaleY:-1
xOffsetRelative:-0.5
yOffsetRelative:-8
dirOffset:90








[turret_NZN_AMX_009_Bazooka]
x:0
y:0

canShoot:false
projectile:NZN_AMX_009_Bazooka_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:11
barrelY:27
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Bazooka_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_NZN_AMX_009_Bazooka_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka*1
(
    addResources=
    ShellDamage:22500
    |DpDamage:625
    |WeaponAccuracy=80
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:90
    |ProjectileSpread:1
    |ProjectileExplosionRange:30
    |ProjectileLife:35

    |ProjectileBlastRange:60
    |ProjectileBlastDamageModifier:0.20
    |ProjectileBlastDpModifier:1
)
"""








[hiddenAction_NZN_AMX_009_Bazooka_Trigger]
alsoTriggerAction:NZN_AMX_009_Bazooka_Fire
[hiddenAction_NZN_AMX_009_Bazooka_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_AMX_009_Bazooka_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:NZN_AMX_009_Bazooka_CDTimer=self.timeAlive+${NZN_AMX_009_Bazooka_CD}
addResources:EN=-${NZN_AMX_009_Bazooka_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
NZN_AMX_009_Bazooka_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
NZN_AMX_009_Bazooka_B1_Step_1
"""
[hiddenAction_NZN_AMX_009_Bazooka_B1_Step_1]
alsoQueueAction:"""
NZN_AMX_009_Bazooka_Fire_Step_1,
NZN_AMX_009_Bazooka_Fire_Step_2,
NZN_AMX_009_Bazooka_Fire_Step_Final
"""




[hiddenAction_NZN_AMX_009_Bazooka_SetWeaponIndex]
isVisible:false


[hiddenAction_NZN_AMX_009_Bazooka_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_NZN_AMX_009_Bazooka_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:NZN_AMX_009_Bazooka
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_NZN_AMX_009_Bazooka_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


