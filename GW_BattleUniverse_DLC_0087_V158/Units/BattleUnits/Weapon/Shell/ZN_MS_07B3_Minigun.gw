[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""


@memory ZN_MS_07B3_Minigun_CDTimer:float
@global ZN_MS_07B3_Minigun_CD=3
@global ZN_MS_07B3_Minigun_EN=40





[decal_ZN_MS_07B3_Minigun]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Shield/ZN_GattlingShield_Blue.png
isVisible:false
basePositionFromLegEnd:arm3
imageScale:1
xOffsetRelative: -8
yOffsetRelative: 27
dirOffset:0







[turret_ZN_MS_07B3_Minigun]
x:0
y:0

canShoot:false
projectile:ZN_MS_07B3_Minigun_Projectile

delay:0.1s
limitingRange:0

canAttackMaxAngle:15
barrelX:-16
barrelY:40

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:none
shoot_sound_vol:0
shoot_flame:MG_Fire_1



[projectile_ZN_MS_07B3_Minigun_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Vulcan*2
(
    offsetRandomXY=6,
    offsetDir=2.5,
    offsetRandomDir=7.5,
    addResources=
    ShellDamage:350
    |ShellAPDamage:150 
    |DpDamage:20
    |WeaponAccuracy=85
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=25
    |ProjectileSpeed:75
    |ProjectileSpread:8
    |ProjectileLife:15
)
"""







[hiddenAction_ZN_MS_07B3_Minigun_Trigger]
alsoTriggerAction:ZN_MS_07B3_Minigun_Fire
[hiddenAction_ZN_MS_07B3_Minigun_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MS_07B3_Minigun_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:ZN_MS_07B3_Minigun_CDTimer=self.timeAlive+${ZN_MS_07B3_Minigun_CD}
addResources:EN=-${ZN_MS_07B3_Minigun_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_MS_07B3_Minigun_SetWeaponIndex,
ZN_MS_07B3_Minigun_B15_Step_1
"""
[hiddenAction_ZN_MS_07B3_Minigun_B15_Step_1]
alsoQueueAction:"""
ZN_MS_07B3_Minigun_Fire_Step_1,
ZN_MS_07B3_Minigun_Fire_Step_2,
ZN_MS_07B3_Minigun_Fire_Step_3,
ZN_MS_07B3_Minigun_Fire_Step_3,
ZN_MS_07B3_Minigun_Fire_Step_3,
ZN_MS_07B3_Minigun_Fire_Step_3,
ZN_MS_07B3_Minigun_Fire_Step_3,
ZN_MS_07B3_Minigun_Fire_Step_3,
ZN_MS_07B3_Minigun_Fire_Step_3,
ZN_MS_07B3_Minigun_Fire_Step_3,
ZN_MS_07B3_Minigun_Fire_Step_3,
ZN_MS_07B3_Minigun_Fire_Step_3,
ZN_MS_07B3_Minigun_Fire_Step_3,
ZN_MS_07B3_Minigun_Fire_Step_3,
ZN_MS_07B3_Minigun_Fire_Step_3,
ZN_MS_07B3_Minigun_Fire_Step_3,
ZN_MS_07B3_Minigun_Fire_Step_Final
"""





[hiddenAction_ZN_MS_07B3_Minigun_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MS_07B3_Minigun_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false and self.Shield>0
"""
buildSpeed:0.3s
playSoundAtUnit:ROOT:Resource/Sound/SE/Weapon/Fire/Gatling_1.ogg:0.7
[hiddenAction_ZN_MS_07B3_Minigun_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and self.Shield>0
"""
buildSpeed:0s
fireTurretXAtGround:ZN_MS_07B3_Minigun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_L_Step_1
[hiddenAction_ZN_MS_07B3_Minigun_Fire_Step_3]
@copyFromSection:hiddenAction_ZN_MS_07B3_Minigun_Fire_Step_2
buildSpeed:${turret_ZN_MS_07B3_Minigun.delay}
[hiddenAction_ZN_MS_07B3_Minigun_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


