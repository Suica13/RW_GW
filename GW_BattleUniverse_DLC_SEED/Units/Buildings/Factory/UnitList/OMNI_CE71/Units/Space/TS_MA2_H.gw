[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory TS_MA2_H:bool


[hiddenAction_Pannel_Close_TS_MA2_H]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:TS_MA2_H=false



[hiddenAction_AutoProduce_TS_MA2_H]
@copyFromSection:template_AutoProduce
@define UnitID=TS_MA2_H
alsoTriggerAction:AutoProduce_TS_MA2_H_Step2

[hiddenAction_AutoProduce_TS_MA2_H_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=600
@define Resource=1200
alsoTriggerAction:AutoProduce_TS_MA2_H_Random

[hiddenAction_AutoProduce_TS_MA2_H_Random]
alsoTriggerAction:"""
AutoProduce_TS_MA2_H_Random_A,
AutoProduce_TS_MA2_H_Random_B
"""
[hiddenAction_AutoProduce_TS_MA2_H_Random_A]
requireConditional:if memory.randomProduce<=750
alsoQueueAction:Produce_TS_MA2_H_StandardSquad

[hiddenAction_AutoProduce_TS_MA2_H_Random_B]
requireConditional:if memory.randomProduce>750
alsoQueueAction:Produce_TS_MA2_H_AntiShipSquad




[action_Pannel_TS_MA2_H]
@copyFromSection:template_Pannel
@define UnitID=TS_MA2_H
@define FactionVisible= (memory.Pannel_OMNI_CE71_DontShow==false)


[action_Produce_TS_MA2_H_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=TS_MA2_H
@define Money=650
@define Resource=1250
@define FactionVisible= (memory.Pannel_OMNI_CE71_DontShow==false)
buildSpeed:30s

alsoQueueAction:"""
Produce_TS_MA2_H_StandardSquad_1,
Produce_TS_MA2_H_StandardSquad_2,
Produce_TS_MA2_H_StandardSquad_3
"""
[hiddenAction_Produce_TS_MA2_H_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
TS_MA2_H*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_TS_MA2_H_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
TS_MA2_H*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_TS_MA2_H_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
TS_MA2_H*1(addResources=PilotType:1101|EquipmentIndex:0)
"""



[action_Produce_TS_MA2_H_AntiShipSquad]
@copyFromSection:template_Produce
@define UnitID=TS_MA2_H
@define Money=650
@define Resource=1250
@define FactionVisible= (memory.Pannel_OMNI_CE71_DontShow==false)
buildSpeed:30s

text:AntiShip Squad
text_zh:对舰导弹小队

alsoQueueAction:"""
Produce_TS_MA2_H_AntiShipSquad_1,
Produce_TS_MA2_H_AntiShipSquad_2,
Produce_TS_MA2_H_AntiShipSquad_3
"""
[hiddenAction_Produce_TS_MA2_H_AntiShipSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
TS_MA2_H*1(addResources=PilotType:1101|EquipmentIndex:1)
"""
[hiddenAction_Produce_TS_MA2_H_AntiShipSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
TS_MA2_H*1(addResources=PilotType:1101|EquipmentIndex:1)
"""
[hiddenAction_Produce_TS_MA2_H_AntiShipSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
TS_MA2_H*1(addResources=PilotType:1101|EquipmentIndex:1)
"""


