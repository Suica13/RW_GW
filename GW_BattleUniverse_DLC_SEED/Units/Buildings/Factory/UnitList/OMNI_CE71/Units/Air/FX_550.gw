[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory FX_550:bool


[hiddenAction_Pannel_Close_FX_550]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:FX_550=false




[hiddenAction_AutoProduce_FX_550]
@copyFromSection:template_AutoProduce
@define UnitID=FX_550
alsoTriggerAction:AutoProduce_FX_550_Step2

[hiddenAction_AutoProduce_FX_550_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1250
@define Resource=1750
alsoTriggerAction:AutoProduce_FX_550_Random



[hiddenAction_AutoProduce_FX_550_Random]
alsoTriggerAction:"""
AutoProduce_FX_550_Random_A,
AutoProduce_FX_550_Random_B,
AutoProduce_FX_550_Random_C
"""
[hiddenAction_AutoProduce_FX_550_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_FX_550_ASquad

[hiddenAction_AutoProduce_FX_550_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_FX_550_LSquad

[hiddenAction_AutoProduce_FX_550_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_FX_550_SSquad





[action_Pannel_FX_550]
@copyFromSection:template_Pannel
@define UnitID=FX_550
@define FactionVisible= (memory.Pannel_OMNI_CE71_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png

[action_Produce_FX_550_ASquad]
@copyFromSection:template_Produce
@define UnitID=FX_550
@define Money=1250
@define Resource=1750
@define FactionVisible= (memory.Pannel_OMNI_CE71_DontShow==false)

buildSpeed:45s

text:Aile Backpack
text_zh:翔翼型背包

alsoQueueAction:"""
Produce_FX_550_ASquad_1
"""
[hiddenAction_Produce_FX_550_ASquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
FX_550*1(addResources=PilotType:1101|EquipmentIndex:1)
"""

