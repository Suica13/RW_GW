[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini




[hiddenAction_AutoProduce_VTOLFighter]
@copyFromSection:template_AutoProduce
@define UnitID=VTOLFighter
alsoTriggerAction:AutoProduce_VTOLFighter_Step2

[hiddenAction_AutoProduce_VTOLFighter_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=300
@define Resource=650
alsoQueueAction:Produce_VTOLFighter_StandardSquad



[action_Produce_VTOLFighter_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=VTOLFighter
@define Money=400
@define Resource=650
@define FactionVisible= (memory.Pannel_OMNI_CE71_DontShow==false)
buildSpeed:20s

alsoQueueAction:"""
Produce_VTOLFighter_StandardSquad_1,
Produce_VTOLFighter_StandardSquad_2,
Produce_VTOLFighter_StandardSquad_3
"""
[hiddenAction_Produce_VTOLFighter_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
VTOLFighter*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_VTOLFighter_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
VTOLFighter*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_VTOLFighter_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
VTOLFighter*1(addResources=PilotType:1101|EquipmentIndex:0)
"""