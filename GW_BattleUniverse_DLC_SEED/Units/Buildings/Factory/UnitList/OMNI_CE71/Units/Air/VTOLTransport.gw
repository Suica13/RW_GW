[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini




[hiddenAction_AutoProduce_VTOLTransport]
@copyFromSection:template_AutoProduce
@define UnitID=VTOLTransport
alsoTriggerAction:AutoProduce_VTOLTransport_Step2

[hiddenAction_AutoProduce_VTOLTransport_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=500
@define Resource=1000
alsoQueueAction:Produce_VTOLTransport_StandardSquad



[action_Produce_VTOLTransport_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=VTOLTransport
@define Money=500
@define Resource=1000
@define FactionVisible= (memory.Pannel_OMNI_CE71_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:25s

alsoQueueAction:"""
Produce_VTOLTransport_StandardSquad_1
