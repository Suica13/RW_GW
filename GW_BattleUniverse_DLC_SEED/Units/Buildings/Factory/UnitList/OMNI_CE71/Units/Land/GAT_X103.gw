[hiddenAction_AutoProduce_GAT_X103]
@copyFromSection:template_AutoProduce
@define UnitID=GAT_X103
alsoTriggerAction:AutoProduce_GAT_X103_Step2

[hiddenAction_AutoProduce_GAT_X103_Step2]
