[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory GAT_X105:bool


[hiddenAction_Pannel_Close_GAT_X105]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:GAT_X105=false




[hiddenAction_AutoProduce_GAT_X105]
@copyFromSection:template_AutoProduce
@define UnitID=GAT_X105
alsoTriggerAction:AutoProduce_GAT_X105_Step2

[hiddenAction_AutoProduce_GAT_X105_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3000
@define Resource=3950
alsoTriggerAction:AutoProduce_GAT_X105_Random



[hiddenAction_AutoProduce_GAT_X105_Random]
alsoTriggerAction:"""
AutoProduce_GAT_X105_Random_A,
AutoProduce_GAT_X105_Random_B,
AutoProduce_GAT_X105_Random_C
"""
[hiddenAction_AutoProduce_GAT_X105_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_GAT_X105_ASquad

[hiddenAction_AutoProduce_GAT_X105_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_GAT_X105_LSquad

[hiddenAction_AutoProduce_GAT_X105_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_GAT_X105_SSquad





[action_Pannel_GAT_X105]
