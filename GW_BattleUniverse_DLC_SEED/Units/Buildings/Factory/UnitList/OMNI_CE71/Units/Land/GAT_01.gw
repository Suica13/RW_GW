[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory GAT_01:bool


[hiddenAction_Pannel_Close_GAT_01]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:GAT_01=false




[hiddenAction_AutoProduce_GAT_01]
@copyFromSection:template_AutoProduce
@define UnitID=GAT_01
alsoTriggerAction:AutoProduce_GAT_01_Step2

[hiddenAction_AutoProduce_GAT_01_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2000
@define Resource=3450
alsoQueueAction:Produce_GAT_01_StandardSquad

[action_Produce_GAT_01_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=GAT_01
@define Money=2000
@define Resource=3450
@define FactionVisible= (memory.Pannel_OMNI_CE71_DontShow==false)
buildSpeed:50s

alsoQueueAction:"""
Produce_GAT_01_StandardSquad_1,
Produce_GAT_01_StandardSquad_2,
Produce_GAT_01_StandardSquad_3
"""
[hiddenAction_Produce_GAT_01_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
GAT_01*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_GAT_01_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
GAT_01*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_GAT_01_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
GAT_01*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
