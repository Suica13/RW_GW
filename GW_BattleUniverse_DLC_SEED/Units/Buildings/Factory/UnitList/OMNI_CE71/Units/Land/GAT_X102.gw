[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory GAT_X102:bool


[hiddenAction_Pannel_Close_GAT_X102]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:GAT_X102=false




[hiddenAction_AutoProduce_GAT_X102]
@copyFromSection:template_AutoProduce
@define UnitID=GAT_X102
alsoTriggerAction:AutoProduce_GAT_X102_Step2

[hiddenAction_AutoProduce_GAT_X102_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2550
@define Resource=3600
alsoTriggerAction:AutoProduce_GAT_X102_Random



[hiddenAction_AutoProduce_GAT_X102_Random]
alsoTriggerAction:"""
AutoProduce_GAT_X102_Random_A,
AutoProduce_GAT_X102_Random_B
"""
[hiddenAction_AutoProduce_GAT_X102_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_GAT_X102_StandardSquad

[hiddenAction_AutoProduce_GAT_X102_Random_B]
requireConditional:"""
if memory.randomProduce>500 
"""
alsoQueueAction:Produce_GAT_X102_BazookaSquad




[action_Pannel_GAT_X102]
