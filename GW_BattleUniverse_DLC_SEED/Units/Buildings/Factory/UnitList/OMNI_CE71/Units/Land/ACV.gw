[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini





[hiddenAction_AutoProduce_ACV]
@copyFromSection:template_AutoProduce
@define UnitID=ACV
alsoTriggerAction:AutoProduce_ACV_Step2

[hiddenAction_AutoProduce_ACV_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=200
@define Resource=400
alsoQueueAction:Produce_ACV_StandardSquad





[action_Produce_ACV_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=ACV
@define Money=200
@define Resource=400
@define FactionVisible= (memory.Pannel_OMNI_CE71_DontShow==false)
buildSpeed:20s

alsoQueueAction:"""
Produce_ACV_StandardSquad_1
