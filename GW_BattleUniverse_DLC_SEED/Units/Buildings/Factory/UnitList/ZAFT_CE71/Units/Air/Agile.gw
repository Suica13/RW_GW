[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini




[hiddenAction_AutoProduce_Agile]
@copyFromSection:template_AutoProduce
@define UnitID=Agile
alsoTriggerAction:AutoProduce_Agile_Step2

[hiddenAction_AutoProduce_Agile_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=300
@define Resource=650
alsoQueueAction:Produce_Agile_StandardSquad



[action_Produce_Agile_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=Agile
@define Money=400
@define Resource=650
@define FactionVisible= (memory.Pannel_ZAFT_CE71_DontShow==false)
buildSpeed:30s

alsoQueueAction:"""
Produce_Agile_StandardSquad_1,
Produce_Agile_StandardSquad_2,
Produce_Agile_StandardSquad_3
"""
[hiddenAction_Produce_Agile_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
Agile*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_Agile_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
Agile*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_Agile_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
Agile*1(addResources=PilotType:1101|EquipmentIndex:0)
"""