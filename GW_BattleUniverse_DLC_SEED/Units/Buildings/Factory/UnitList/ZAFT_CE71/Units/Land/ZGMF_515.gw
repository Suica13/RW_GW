[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory ZGMF_515:bool


[hiddenAction_Pannel_Close_ZGMF_515]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:ZGMF_515=false



[hiddenAction_AutoProduce_ZGMF_515]
@copyFromSection:template_AutoProduce
@define UnitID=ZGMF_515
alsoTriggerAction:AutoProduce_ZGMF_515_Step2

[hiddenAction_AutoProduce_ZGMF_515_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=900
@define Resource=1450
alsoQueueAction:Produce_ZGMF_515




[action_Produce_ZGMF_515]
@copyFromSection:template_Produce_Fast
@define UnitID=ZGMF_515
@define Money=900
@define Resource=1450
@define FactionVisible= (memory.Pannel_ZAFT_CE71_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:45s

alsoQueueAction:"""
Produce_ZGMF_515_StandardSquad_1
