[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory TMF_A_802:bool


[hiddenAction_Pannel_Close_TMF_A_802]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:TMF_A_802=false



[hiddenAction_AutoProduce_TMF_A_802]
@copyFromSection:template_AutoProduce
@define UnitID=TMF_A_802
alsoTriggerAction:AutoProduce_TMF_A_802_Step2

[hiddenAction_AutoProduce_TMF_A_802_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2000
@define Resource=3350
alsoTriggerAction:AutoProduce_TMF_A_802_Random



[hiddenAction_AutoProduce_TMF_A_802_Random]
alsoTriggerAction:"""
AutoProduce_TMF_A_802_Random_A,
AutoProduce_TMF_A_802_Random_B
"""
[hiddenAction_AutoProduce_TMF_A_802_Random_A]
requireConditional:"""
if memory.randomProduce<500
"""
alsoQueueAction:Produce_TMF_A_802_StandardSquad

[hiddenAction_AutoProduce_TMF_A_802_Random_B]
requireConditional:"""
if memory.randomProduce>500
"""
alsoQueueAction:Produce_TMF_A_802_MSSquad




[action_Pannel_TMF_A_802]
@copyFromSection:template_Pannel
@define UnitID=TMF_A_802
@define FactionVisible= (memory.Pannel_ZAFT_CE71_DontShow==false)


[action_Produce_TMF_A_802_StandardSquad]
