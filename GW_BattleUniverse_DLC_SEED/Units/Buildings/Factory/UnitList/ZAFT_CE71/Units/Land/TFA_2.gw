[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory TFA_2:bool


[hiddenAction_Pannel_Close_TFA_2]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:TFA_2=false



[hiddenAction_AutoProduce_TFA_2]
@copyFromSection:template_AutoProduce
@define UnitID=TFA_2
alsoTriggerAction:AutoProduce_TFA_2_Step2

[hiddenAction_AutoProduce_TFA_2_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3000
@define Resource=4500
alsoQueueAction:Produce_TFA_2_StandardSquad





[action_Produce_TFA_2_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=TFA_2
@define Money=3000
@define Resource=4500
@define FactionVisible= (memory.Pannel_ZAFT_CE71_DontShow==false)
buildSpeed:75s

alsoQueueAction:"""
Produce_TFA_2_StandardSquad_1,
Produce_TFA_2_StandardSquad_2,
Produce_TFA_2_StandardSquad_3
"""
[hiddenAction_Produce_TFA_2_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
TFA_2*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_TFA_2_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
TFA_2*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_TFA_2_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
TFA_2*1(addResources=PilotType:1101|EquipmentIndex:0)
"""


