[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Green.gw
"""

@memory OMNI_FX_550_BR_CDTimer:float
@global OMNI_FX_550_BR_CD=5
@global OMNI_FX_550_BR_EN=40










[turret_OMNI_FX_550_BR]
x:0
y:0

canShoot:false
showRangeUIGuide:false
projectile:OMNI_FX_550_BR_Projectile

delay:0.1s
limitingRange:1200
limitingAngle:3

canAttackMaxAngle:15
barrelX:0
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamRifle_2.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Green



[projectile_OMNI_FX_550_BR_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Green*1
(
    addResources=
    BeamDamage:3500
    |DpDamage:75
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=0.5
    |AntiAir=1.5
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""




[hiddenAction_OMNI_FX_550_BR_Trigger]
alsoTriggerAction:OMNI_FX_550_BR_Fire
[hiddenAction_OMNI_FX_550_BR_Fire]
requireConditional:"""
if self.timeAlive>memory.OMNI_FX_550_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  
and not (directionBetween(self, self.attacking) < self.dir-25 or directionBetween(self, self.attacking) > self.dir+25)  
and self.resource.EN>0
"""
setUnitMemory:OMNI_FX_550_BR_CDTimer=self.timeAlive+${OMNI_FX_550_BR_CD} 
addResources:EN=-${OMNI_FX_550_BR_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
OMNI_FX_550_BR_SetWeaponIndex,
OMNI_FX_550_BR_B1_Step_1
"""
[hiddenAction_OMNI_FX_550_BR_B1_Step_1]
alsoQueueAction:"""
OMNI_FX_550_BR_Fire_Step_1,
OMNI_FX_550_BR_Fire_Step_2,
OMNI_FX_550_BR_Fire_Step_Final
"""




[hiddenAction_OMNI_FX_550_BR_SetWeaponIndex]
isVisible:false


[hiddenAction_OMNI_FX_550_BR_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
[hiddenAction_OMNI_FX_550_BR_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:OMNI_FX_550_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_OMNI_FX_550_BR_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff