[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Green.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory ORB_MBF_M1_BR_CDTimer:float
@global ORB_MBF_M1_BR_CD=2
@global ORB_MBF_M1_BR_EN=40





[decal_ORB_MBF_M1_BR]
layer:beforeBody
order:4.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Weapon/Beam/Image/ORB_MBF_P02_BR.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.75
xOffsetRelative: 1
yOffsetRelative: 9
dirOffset:0
[decal_ORB_MBF_M1_BR_NotUsing]
@copyFromSection:decal_ORB_MBF_M1_BR
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.6
xOffsetRelative:5
yOffsetRelative:-6.5
dirOffset:-90







[turret_ORB_MBF_M1_BR]
x:0
y:0

canShoot:false
projectile:ORB_MBF_M1_BR_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:11
barrelY:25
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_1.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Green



[projectile_ORB_MBF_M1_BR_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamRifle_Green*1
(
    addResources=
    BeamDamage:7500
    |DpDamage:250
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:85
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""





[hiddenAction_ORB_MBF_M1_BR_Trigger]
alsoTriggerAction:ORB_MBF_M1_BR_Fire
[hiddenAction_ORB_MBF_M1_BR_Fire]
requireConditional:"""
if self.timeAlive>memory.ORB_MBF_M1_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:ORB_MBF_M1_BR_CDTimer=self.timeAlive+${ORB_MBF_M1_BR_CD}
addResources:EN=-${ORB_MBF_M1_BR_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ORB_MBF_M1_BR_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
ORB_MBF_M1_BR_B1_Step_1
"""
[hiddenAction_ORB_MBF_M1_BR_B1_Step_1]
alsoQueueAction:"""
ORB_MBF_M1_BR_Fire_Step_1,
ORB_MBF_M1_BR_Fire_Step_2,
ORB_MBF_M1_BR_Fire_Step_Final
"""



[hiddenAction_ORB_MBF_M1_BR_SetWeaponIndex]
isVisible:false


[hiddenAction_ORB_MBF_M1_BR_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_ORB_MBF_M1_BR_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ORB_MBF_M1_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ORB_MBF_M1_BR_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

