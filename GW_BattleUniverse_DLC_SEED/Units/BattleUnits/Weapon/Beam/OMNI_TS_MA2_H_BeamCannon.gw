[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Green.gw
"""

@memory OMNI_TS_MA2_H_BeamCannon_CDTimer:float
@global OMNI_TS_MA2_H_BeamCannon_CD=2
@global OMNI_TS_MA2_H_BeamCannon_EN=40





[turret_OMNI_TS_MA2_H_BeamCannon]
x:0
y:0

canShoot:false
projectile:OMNI_TS_MA2_H_BeamCannon_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:0
barrelY:20
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamRifle_2.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Green





[projectile_OMNI_TS_MA2_H_BeamCannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
explodeEffect:none

spawnUnit:"""
Projectile_BeamRifle_Green*1
(
    addResources=
    BeamDamage:4500
    |DpDamage:175
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:85
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""





[hiddenAction_OMNI_TS_MA2_H_BeamCannon_Trigger]
alsoTriggerAction:OMNI_TS_MA2_H_BeamCannon_Fire
[hiddenAction_OMNI_TS_MA2_H_BeamCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.OMNI_TS_MA2_H_BeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:OMNI_TS_MA2_H_BeamCannon_CDTimer=self.timeAlive+${OMNI_TS_MA2_H_BeamCannon_CD}
addResources:EN=-${OMNI_TS_MA2_H_BeamCannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
OMNI_TS_MA2_H_BeamCannon_SetWeaponIndex,
OMNI_TS_MA2_H_BeamCannon_B1_Step_1
"""
[hiddenAction_OMNI_TS_MA2_H_BeamCannon_B1_Step_1]
alsoQueueAction:"""
OMNI_TS_MA2_H_BeamCannon_Fire_Step_1,
OMNI_TS_MA2_H_BeamCannon_Fire_Step_2,
OMNI_TS_MA2_H_BeamCannon_Fire_Step_Final
"""



[hiddenAction_OMNI_TS_MA2_H_BeamCannon_SetWeaponIndex]
isVisible:false


[hiddenAction_OMNI_TS_MA2_H_BeamCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_OMNI_TS_MA2_H_BeamCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:OMNI_TS_MA2_H_BeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_OMNI_TS_MA2_H_BeamCannon_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff
