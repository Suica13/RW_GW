[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Cqb/Common/Cqb_Fire_2_Yellow_R.gw,
ROOT:Resource/Image/Fx/Weapon/Cqb/Common/Cqb_Fire_1_Yellow_L.gw,
ROOT:Template\Unit\Animation\Cqb\Common_Melee_B.gw,
ROOT:Template\Unit\Animation\Cqb\Common_Melee_F.gw
"""

@memory ZN_YMS_15_BeamSaber_BF_CDTimer:float
@global ZN_YMS_15_BeamSaber_BF_CD=3.5



[decal_ZN_YMS_15_BeamSaber_BF]
layer:beforeBody
order:4.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Weapon/Cqb/Image/ZN_YMS_15_BeamSaber.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
imageScaleX:-1
xOffsetRelative:0
yOffsetRelative:38
dirOffset:-10




[turret_ZN_YMS_15_BeamSaber_BF_B]
x:0
y:0
invisible:true

canShoot:false

showRangeUIGuide:false
projectile:ZN_YMS_15_BeamSaber_BF_B_Projectile

delay:3s
limitingMinRange:0
limitingRange:0

canAttackMaxAngle:60
barrelX:0
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamSaber_1.ogg
shoot_sound_vol:0.5

[projectile_ZN_YMS_15_BeamSaber_BF_B_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Saber_B*1
(
    addResources=
    CqbDamage:3000
    |CqbBeamDamage:3000
    |DpDamage:850
    |WeaponAccuracy:125
    |PartBreakModifier=0.75
    |CockpitBreakModifier=1.25
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightHitRange:35
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileLife:0.25
    |ProjectileAttackTimes:1
)
"""
[projectile_ZN_YMS_15_BeamSaber_BF_F_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Saber_A_L*1
(
    addResources=
    CqbDamage:3000
    |CqbBeamDamage:3000
    |DpDamage:600
    |WeaponAccuracy:125
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightHitRange:35
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileLife:0.25
    |ProjectileAttackTimes:1
)
"""







[hiddenAction_ZN_YMS_15_BeamSaber_BF_Trigger]
alsoTriggerAction:ZN_YMS_15_BeamSaber_BF_Fire
[hiddenAction_ZN_YMS_15_BeamSaber_BF_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_YMS_15_BeamSaber_BF_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) 
and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50
"""
setUnitMemory:ZN_YMS_15_BeamSaber_BF_CDTimer=self.timeAlive+${ZN_YMS_15_BeamSaber_BF_CD}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Cqb,
ZN_YMS_15_BeamSaber_BF_B_SetWeaponIndex,
PlayCommon_Melee_B_Step_1,
ZN_YMS_15_BeamSaber_BF_Step_1
"""
[hiddenAction_ZN_YMS_15_BeamSaber_BF_Step_1]
alsoQueueAction:"""
ZN_YMS_15_BeamSaber_BF_Fire_Step_1,
ZN_YMS_15_BeamSaber_BF_Fire_Step_2,
ZN_YMS_15_BeamSaber_BF_Fire_Step_3,
ZN_YMS_15_BeamSaber_BF_Fire_Step_4,
ZN_YMS_15_BeamSaber_BF_Fire_Step_5,
ZN_YMS_15_BeamSaber_BF_Fire_Step_Final
"""







[hiddenAction_ZN_YMS_15_BeamSaber_BF_B_SetWeaponIndex]
isVisible:false
[hiddenAction_ZN_YMS_15_BeamSaber_BF_F_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_YMS_15_BeamSaber_BF_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.4s
[hiddenAction_ZN_YMS_15_BeamSaber_BF_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_YMS_15_BeamSaber_BF_B
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_2_Yellow_R
[hiddenAction_ZN_YMS_15_BeamSaber_BF_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.6s
alsoTriggerAction:PlayCommon_Melee_F_Step_1,ZN_YMS_15_BeamSaber_BF_F_SetWeaponIndex
[hiddenAction_ZN_YMS_15_BeamSaber_BF_Fire_Step_4]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_ZN_YMS_15_BeamSaber_BF_Fire_Step_5]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_YMS_15_BeamSaber_BF_B
fireTurretXAtGround_withProjectile:ZN_YMS_15_BeamSaber_BF_F_Projectile
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_1_Yellow_L
[hiddenAction_ZN_YMS_15_BeamSaber_BF_Fire_Step_Final]
buildSpeed:1.4s
alsoTriggerAction:SetAttackingOff

