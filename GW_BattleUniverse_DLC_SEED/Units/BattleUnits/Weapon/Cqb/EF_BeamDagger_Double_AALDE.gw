[hiddenAction_EF_BeamDagger_Double_AALDE_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_BeamDagger_Double_AALDE_Fire_Step_1]
requireConditional:if ${cantAction}==false
buildSpeed:0s
alsoTriggerAction:PlayCommon_Melee_A_Step_1
[hiddenAction_EF_BeamDagger_Double_AALDE_Fire_Step_2]
requireConditional:if ${cantAction}==false and memory.armRBreaked==false
buildSpeed:0.2s
fireTurretXAtGround:EF_BeamDagger_Double_AALDE
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
fireTurretXAtGround_withProjectile:EF_BeamDagger_Double_AALDE_A_Projectile
spawnEffects:Cqb_Fire_1_Pink_R_S

[hiddenAction_EF_BeamDagger_Double_AALDE_Fire_Step_3]
requireConditional:if ${cantAction}==false
buildSpeed:0.2s
[hiddenAction_EF_BeamDagger_Double_AALDE_Fire_Step_4]
requireConditional:if ${cantAction}==false and memory.armLBreaked==false
buildSpeed:0.0s
alsoTriggerAction:PlayCommon_Melee_A_L_Step_1
[hiddenAction_EF_BeamDagger_Double_AALDE_Fire_Step_5]
requireConditional:if ${cantAction}==false and memory.armLBreaked==false
buildSpeed:0.2s
fireTurretXAtGround:EF_BeamDagger_Double_AALDE
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
fireTurretXAtGround_withProjectile:EF_BeamDagger_Double_AALDE_AL_Projectile
spawnEffects:Cqb_Fire_1_Pink_L_S
[hiddenAction_EF_BeamDagger_Double_AALDE_Fire_Step_6]
requireConditional:if ${cantAction}==false
buildSpeed:0.35s
[hiddenAction_EF_BeamDagger_Double_AALDE_Fire_Step_7]
requireConditional:if ${cantAction}==false
buildSpeed:0.0s
alsoTriggerAction:PlayCommon_Melee_Double_G_Step_1
[hiddenAction_EF_BeamDagger_Double_AALDE_Fire_Step_8]
requireConditional:if ${cantAction}==false and memory.armRBreaked==false
buildSpeed:0s
fireTurretXAtGround:EF_BeamDagger_Double_AALDE
fireTurretXAtGround_withProjectile:EF_BeamDagger_Double_AALDE_DE_Projectile
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_1_Pink_R_S
[hiddenAction_EF_BeamDagger_Double_AALDE_Fire_Step_9]
requireConditional:if ${cantAction}==false and memory.armLBreaked==false
buildSpeed:0s
fireTurretXAtGround:EF_BeamDagger_Double_AALDE
fireTurretXAtGround_withProjectile:EF_BeamDagger_Double_AALDE_DE_Projectile_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_1_Pink_L_S
[hiddenAction_EF_BeamDagger_Double_AALDE_Fire_Step_Final]
buildSpeed:1.0s
alsoTriggerAction:SetAttackingOff


[hiddenAction_EF_BeamDagger_Double_AALDE_Fire_Step_Rotation]
buildSpeed:0.02s
setBodyRotation:self.dir-20

[animation_Common_Melee_A]
KeyframeTimeScale:0.2

[animation_Common_Melee_A_L]
KeyframeTimeScale:0.2



[hiddenAction_EF_BeamDagger_Double_AALDE_Trigger]
alsoTriggerAction:EF_BeamDagger_Double_AALDE_Fire
[hiddenAction_EF_BeamDagger_Double_AALDE_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_BeamDagger_Double_AALDE_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) 
and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50
"""
setUnitMemory:EF_BeamDagger_Double_AALDE_CDTimer=self.timeAlive+${EF_BeamDagger_Double_AALDE_CD}

alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Cqb,
EF_BeamDagger_Double_AALDE_SetWeaponIndex,
EF_BeamDagger_Double_AALDE_Step_1
"""
[hiddenAction_EF_BeamDagger_Double_AALDE_Step_1]
alsoQueueAction:"""
EF_BeamDagger_Double_AALDE_Fire_Step_1,
EF_BeamDagger_Double_AALDE_Fire_Step_2,
