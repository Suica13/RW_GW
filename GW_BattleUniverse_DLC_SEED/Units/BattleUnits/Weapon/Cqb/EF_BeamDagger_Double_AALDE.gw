@memory EF_BeamDagger_Double_AALDE_CDTimer:float
@global EF_BeamDagger_Double_AALDE_CD=3





[decal_EF_BeamDagger_Double_AALDE]
layer:beforeBody
order:5.4
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Cqb\Image\EF_BeamDagger.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative:6
yOffsetRelative:22
dirOffset:0

[decal_EF_BeamDagger_Double_AALDE_L]
@copyFromSection:decal_EF_BeamDagger_Double_AALDE
basePositionFromLegEnd:arm3
imageScale:1
imageScaleX:-1
xOffsetRelative:-6
yOffsetRelative:22
dirOffset:0



[turret_EF_BeamDagger_Double_AALDE]
x:0
y:0
invisible:true

canShoot:false

showRangeUIGuide:false
projectile:EF_BeamDagger_Double_AALDE_A_Projectile

delay:3s
limitingMinRange:0
limitingRange:0

canAttackMaxAngle:60
barrelX:0
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamSaber_1.ogg
shoot_sound_vol:0.5

[projectile_EF_BeamDagger_Double_AALDE_A_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
explodeEffect:none

spawnUnit:"""
Projectile_Saber_A*1
(
    addResources=
    CqbDamage:1750
    |CqbBeamDamage:1750
    |DpDamage:750
    |WeaponAccuracy:125
