ROOT:Template\Unit\Animation\Cqb\Common_Melee_Double_A_Fixed.gw
"""

@memory EF_BeamSaber_Double_L_A_Fixed_AMX_002_CDTimer:float
@global EF_BeamSaber_Double_L_A_Fixed_AMX_002_CD=3



