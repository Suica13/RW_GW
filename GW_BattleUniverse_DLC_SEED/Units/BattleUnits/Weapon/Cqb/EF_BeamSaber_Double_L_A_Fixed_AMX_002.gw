[hiddenAction_EF_BeamSaber_Double_L_A_Fixed_AMX_002_Trigger]
alsoTriggerAction:EF_BeamSaber_Double_L_A_Fixed_AMX_002_Fire
[hiddenAction_EF_BeamSaber_Double_L_A_Fixed_AMX_002_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_BeamSaber_Double_L_A_Fixed_AMX_002_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) 
and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50
"""
setUnitMemory:EF_BeamSaber_Double_L_A_Fixed_AMX_002_CDTimer=self.timeAlive+${EF_BeamSaber_Double_L_A_Fixed_AMX_002_CD}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Cqb,
EF_BeamSaber_Double_L_A_Fixed_AMX_002_SetWeaponIndex,
PlayCommon_Melee_Double_A_Fixed_Step_1,
EF_BeamSaber_Double_L_A_Fixed_AMX_002_Step_1
"""
[hiddenAction_EF_BeamSaber_Double_L_A_Fixed_AMX_002_Step_1]
alsoQueueAction:"""
EF_BeamSaber_Double_L_A_Fixed_AMX_002_Fire_Step_1,
EF_BeamSaber_Double_L_A_Fixed_AMX_002_Fire_Step_2,
EF_BeamSaber_Double_L_A_Fixed_AMX_002_Fire_Step_3,
EF_BeamSaber_Double_L_A_Fixed_AMX_002_Fire_Step_Final
"""




[hiddenAction_EF_BeamSaber_Double_L_A_Fixed_AMX_002_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_BeamSaber_Double_L_A_Fixed_AMX_002_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.6s
[hiddenAction_EF_BeamSaber_Double_L_A_Fixed_AMX_002_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false
"""
