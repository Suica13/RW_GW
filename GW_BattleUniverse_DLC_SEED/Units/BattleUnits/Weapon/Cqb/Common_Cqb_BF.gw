[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Cqb/Common/Cqb_Fire_2_White_R.gw,
ROOT:Resource/Image/Fx/Weapon/Cqb/Common/Cqb_Fire_1_White_L.gw,
ROOT:Template\Unit\Animation\Cqb\Common_Melee_B.gw,
ROOT:Template\Unit\Animation\Cqb\Common_Melee_F.gw
"""

@memory Common_Cqb_BF_CDTimer:float
@global Common_Cqb_BF_CD=3.5






[turret_Common_Cqb_BF_B]
x:0
y:0
invisible:true

canShoot:false

showRangeUIGuide:false
projectile:Common_Cqb_BF_B_Projectile

delay:3s
limitingMinRange:0
limitingRange:0

canAttackMaxAngle:60
barrelX:0
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\HeatHawk_1.ogg
shoot_sound_vol:0.5

[projectile_Common_Cqb_BF_B_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Saber_S_B*1
(
    addResources=
    CqbDamage:2000
    |CqbShellDamage:2000
    |DpDamage:750
    |WeaponAccuracy:125
    |PartBreakModifier=0.5
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightHitRange:35
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileLife:0.25
    |ProjectileAttackTimes:1
)
"""
[projectile_Common_Cqb_BF_F_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Saber_S_A_L*1
(
    addResources=
    CqbDamage:2000
    |CqbShellDamage:2000
    |DpDamage:500
    |WeaponAccuracy:125
    |PartBreakModifier=1.0
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightHitRange:35
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileLife:0.25
    |ProjectileAttackTimes:1
)
"""







[hiddenAction_Common_Cqb_BF_Trigger]
alsoTriggerAction:Common_Cqb_BF_Fire
[hiddenAction_Common_Cqb_BF_Fire]
requireConditional:"""
if self.timeAlive>memory.Common_Cqb_BF_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) 
and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50
"""
setUnitMemory:Common_Cqb_BF_CDTimer=self.timeAlive+${Common_Cqb_BF_CD}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Cqb,
Common_Cqb_BF_B_SetWeaponIndex,
PlayCommon_Melee_B_Step_1,
Common_Cqb_BF_Step_1
"""
[hiddenAction_Common_Cqb_BF_Step_1]
alsoQueueAction:"""
Common_Cqb_BF_Fire_Step_1,
Common_Cqb_BF_Fire_Step_2,
Common_Cqb_BF_Fire_Step_3,
Common_Cqb_BF_Fire_Step_4,
Common_Cqb_BF_Fire_Step_5,
Common_Cqb_BF_Fire_Step_Final
"""







[hiddenAction_Common_Cqb_BF_B_SetWeaponIndex]
isVisible:false
[hiddenAction_Common_Cqb_BF_F_SetWeaponIndex]
isVisible:false


[hiddenAction_Common_Cqb_BF_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.4s
[hiddenAction_Common_Cqb_BF_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:Common_Cqb_BF_B
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_2_White_R_S
[hiddenAction_Common_Cqb_BF_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.6s
alsoTriggerAction:PlayCommon_Melee_F_Step_1,Common_Cqb_BF_F_SetWeaponIndex
[hiddenAction_Common_Cqb_BF_Fire_Step_4]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_Common_Cqb_BF_Fire_Step_5]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:Common_Cqb_BF_B
fireTurretXAtGround_withProjectile:Common_Cqb_BF_F_Projectile
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_1_White_L_S
[hiddenAction_Common_Cqb_BF_Fire_Step_Final]
buildSpeed:1.4s
alsoTriggerAction:SetAttackingOff

