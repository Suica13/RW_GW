[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory ZN_MAN_03_Funnel_CDTimer:float
@memory ZN_MAN_03_Funnel_Units:unit[]
@global ZN_MAN_03_Funnel_CD=24
@global ZN_MAN_03_Funnel_EN=250
@global ZN_MAN_03_Funnel_PilotAwakeningSkill=75

[hiddenAction_Get_FunnelSpawn_ZN_MAN_03_Funnel_1]
autoTriggerOnEvent:newMessage(withTag="FunnelSpawn_ZN_MAN_03_Funnel_1")
setUnitMemory:ZN_MAN_03_Funnel_Units[0]=eventData("unitInfo",type="unit")

[hiddenAction_Get_FunnelSpawn_ZN_MAN_03_Funnel_2]
autoTriggerOnEvent:newMessage(withTag="FunnelSpawn_ZN_MAN_03_Funnel_2")
setUnitMemory:ZN_MAN_03_Funnel_Units[1]=eventData("unitInfo",type="unit")

[hiddenAction_Get_FunnelSpawn_ZN_MAN_03_Funnel_3]
autoTriggerOnEvent:newMessage(withTag="FunnelSpawn_ZN_MAN_03_Funnel_3")
setUnitMemory:ZN_MAN_03_Funnel_Units[2]=eventData("unitInfo",type="unit")

[hiddenAction_Get_FunnelSpawn_ZN_MAN_03_Funnel_4]
autoTriggerOnEvent:newMessage(withTag="FunnelSpawn_ZN_MAN_03_Funnel_4")
setUnitMemory:ZN_MAN_03_Funnel_Units[3]=eventData("unitInfo",type="unit")


[decal_DrawLineTo_ZN_MAN_03_Funnel_Unit_HasLink_0]
layer:beforeBody
order:3
alpha:0.75
basePositionFromLegEnd:arm1
drawLineTo:memory.ZN_MAN_03_Funnel_Units[0].readUnitMemory("Incom_LinkUnits",type="unit[]")[0]
color:#333333
imageScale:0.75
lineWidth:1
xOffsetRelative: 0
yOffsetRelative: -40
onlyOnNonPreview:true
isVisible:if memory.ZN_MAN_03_Funnel_Units[0].hp>0
onlyWhileAlive:true

[decal_DrawLineTo_ZN_MAN_03_Funnel_Unit_NoLink_0]
layer:beforeBody
order:3
alpha:0.75
basePositionFromLegEnd:arm1
drawLineTo:memory.ZN_MAN_03_Funnel_Units[0]
color:#333333
imageScale:0.75
lineWidth:1
xOffsetRelative: 0
yOffsetRelative: -40
onlyOnNonPreview:true
isVisible:if memory.ZN_MAN_03_Funnel_Units[0].hp>0 and memory.ZN_MAN_03_Funnel_Units[0].readUnitMemory("Incom_LinkUnits",type="unit[]").size<=0
onlyWhileAlive:true


[decal_DrawLineTo_ZN_MAN_03_Funnel_Unit_HasLink_1]
@copyFromSection:decal_DrawLineTo_ZN_MAN_03_Funnel_Unit_HasLink_0
drawLineTo:memory.ZN_MAN_03_Funnel_Units[1].readUnitMemory("Incom_LinkUnits",type="unit[]")[0]
isVisible:if memory.ZN_MAN_03_Funnel_Units[1].hp>0
yOffsetRelative: 30

[decal_DrawLineTo_ZN_MAN_03_Funnel_Unit_NoLink_1]
@copyFromSection:decal_DrawLineTo_ZN_MAN_03_Funnel_Unit_NoLink_0
drawLineTo:memory.ZN_MAN_03_Funnel_Units[1]
isVisible:if memory.ZN_MAN_03_Funnel_Units[1].hp>0 and memory.ZN_MAN_03_Funnel_Units[1].readUnitMemory("Incom_LinkUnits",type="unit[]").size<=0
yOffsetRelative: 30


[decal_DrawLineTo_ZN_MAN_03_Funnel_Unit_HasLink_2]
@copyFromSection:decal_DrawLineTo_ZN_MAN_03_Funnel_Unit_HasLink_0
drawLineTo:memory.ZN_MAN_03_Funnel_Units[2].readUnitMemory("Incom_LinkUnits",type="unit[]")[0]
isVisible:if memory.ZN_MAN_03_Funnel_Units[2].hp>0
xOffsetRelative: -55
yOffsetRelative: 25

[decal_DrawLineTo_ZN_MAN_03_Funnel_Unit_NoLink_2]
@copyFromSection:decal_DrawLineTo_ZN_MAN_03_Funnel_Unit_NoLink_0
drawLineTo:memory.ZN_MAN_03_Funnel_Units[2]
isVisible:if memory.ZN_MAN_03_Funnel_Units[2].hp>0 and memory.ZN_MAN_03_Funnel_Units[2].readUnitMemory("Incom_LinkUnits",type="unit[]").size<=0
xOffsetRelative: -55
yOffsetRelative: 25




[decal_DrawLineTo_ZN_MAN_03_Funnel_Unit_HasLink_3]
@copyFromSection:decal_DrawLineTo_ZN_MAN_03_Funnel_Unit_HasLink_0
drawLineTo:memory.ZN_MAN_03_Funnel_Units[3].readUnitMemory("Incom_LinkUnits",type="unit[]")[0]
isVisible:if memory.ZN_MAN_03_Funnel_Units[3].hp>0
xOffsetRelative: 65
yOffsetRelative: 30

[decal_DrawLineTo_ZN_MAN_03_Funnel_Unit_NoLink_3]
@copyFromSection:decal_DrawLineTo_ZN_MAN_03_Funnel_Unit_NoLink_0
drawLineTo:memory.ZN_MAN_03_Funnel_Units[3]
isVisible:if memory.ZN_MAN_03_Funnel_Units[3].hp>0 and memory.ZN_MAN_03_Funnel_Units[3].readUnitMemory("Incom_LinkUnits",type="unit[]").size<=0
xOffsetRelative: 65
yOffsetRelative: 30




[turret_ZN_MAN_03_Funnel]
x:0
y:0

canShoot:false
projectile:ZN_MAN_03_Funnel_Projectile

delay:0.2s
canAttackMaxAngle:15
limitingAngle:0
limitingRange:1200
barrelX:0
barrelY:-50

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Action/Common/Transform_1.ogg
shoot_sound_vol:1.0
shoot_flame:BZ_Fire_1
[turret_ZN_MAN_03_Funnel_2]
@copyFromSection:turret_ZN_MAN_03_Funnel
barrelX:0
barrelY:40
projectile:ZN_MAN_03_Funnel_Projectile_2
shoot_sound_vol:0
[turret_ZN_MAN_03_Funnel_3]
@copyFromSection:turret_ZN_MAN_03_Funnel
barrelX:-65
barrelY:30
projectile:ZN_MAN_03_Funnel_Projectile_3
shoot_sound_vol:0
[turret_ZN_MAN_03_Funnel_4]
@copyFromSection:turret_ZN_MAN_03_Funnel
barrelX:65
barrelY:30
projectile:ZN_MAN_03_Funnel_Projectile_4
shoot_sound_vol:0



[projectile_ZN_MAN_03_Funnel_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
MAN_03_Funnel_1*1
"""
[projectile_ZN_MAN_03_Funnel_Projectile_2]
@copyFromSection:projectile_ZN_MAN_03_Funnel_Projectile
spawnUnit:"""
MAN_03_Funnel_2*1
"""
[projectile_ZN_MAN_03_Funnel_Projectile_3]
@copyFromSection:projectile_ZN_MAN_03_Funnel_Projectile
spawnUnit:"""
MAN_03_Funnel_3*1
"""
[projectile_ZN_MAN_03_Funnel_Projectile_4]
@copyFromSection:projectile_ZN_MAN_03_Funnel_Projectile
spawnUnit:"""
MAN_03_Funnel_4*1
"""



[hiddenAction_ZN_MAN_03_Funnel_Trigger_ByAI]
autoTrigger:"""
if ${allowAI}==true 
and ${cantAction}==false 
and ${onSkill}==false 
and memory.close==false 
and self.resource.EN>${ZN_MAN_03_Funnel_EN} 
and self.timeAlive>memory.ZN_MAN_03_Funnel_CDTimer 
and self.parent.hp<=0  
and self.attacking.hp>0 
and memory.pilotUnit.readUnitMemory("pilotAwakeningSkillFinal",type="float")>=${ZN_MAN_03_Funnel_PilotAwakeningSkill} 
"""
setResourcesWithLogic:EN=self.resource().EN-${ZN_MAN_03_Funnel_EN}
alsoTriggerAction:ZN_MAN_03_Funnel_Trigger

[action_ZN_MAN_03_Funnel_Trigger]
pos:10
text:Funnel[LockOn] %{select(self.timeAlive<=memory.ZN_MAN_03_Funnel_CDTimer,str(int(memory.ZN_MAN_03_Funnel_CDTimer-self.timeAlive))+"s","OK")}
text_zh:浮游炮[锁定] %{select(self.timeAlive<=memory.ZN_MAN_03_Funnel_CDTimer,str(int(memory.ZN_MAN_03_Funnel_CDTimer-self.timeAlive))+"秒","OK")}
text_KP:100

displayType:infoOnly

price:EN=${ZN_MAN_03_Funnel_EN} 

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true
ai_isDisabled:true

iconImage:ROOT:Resource/Image/Units/Button/Weapon/Funnel_3.png
highPriorityQueue:true

isVisible:if self.parent.hp<=0 
isGuiBlinking:"""
if self.timeAlive>memory.ZN_MAN_03_Funnel_CDTimer 
and ${cantAction}==false 
and ${onSkill}==false 
"""

isLocked:if self.timeAlive<=memory.ZN_MAN_03_Funnel_CDTimer
isLockedMessage:In CD
isLockedMessage_zh:冷却中

isLockedAlt:"""
if memory.pilotUnit.readUnitMemory("pilotAwakeningSkillFinal",type="float")<${ZN_MAN_03_Funnel_PilotAwakeningSkill}
"""
isLockedAltMessage:PilotAwakeningSkill Not Enough(%{${ZN_MAN_03_Funnel_PilotAwakeningSkill}})
isLockedAltMessage_zh:驾驶员觉醒能力不足(%{${ZN_MAN_03_Funnel_PilotAwakeningSkill}})

isLockedAlt2:"""
if 
(
    ${cantAction}==true or ${onSkill}==true or ${allowAI}==true 
)
or 
(
    memory.ZN_MAN_03_Funnel_Units[0].hp>0 
    or 
    memory.ZN_MAN_03_Funnel_Units[1].hp>0 
    or 
    memory.ZN_MAN_03_Funnel_Units[2].hp>0 
    or 
    memory.ZN_MAN_03_Funnel_Units[3].hp>0
) 
"""
isLockedAlt2Message:Cant Action
isLockedAlt2Message_zh:无法行动

alsoTriggerAction:"""
SetOnSkillOn,
ZN_MAN_03_Funnel_SetWeaponIndex,
ZN_MAN_03_Funnel_B1_Step_1,
PlayCommon_Cannon_Shoot_A_Step_1
"""
[hiddenAction_ZN_MAN_03_Funnel_B1_Step_1]
setUnitMemory:"""
ZN_MAN_03_Funnel_CDTimer=self.timeAlive+${ZN_MAN_03_Funnel_CD}
"""
shrinkArrays:ZN_MAN_03_Funnel_Units
alsoQueueAction:"""
ZN_MAN_03_Funnel_Fire_Step_1,
ZN_MAN_03_Funnel_Fire_Step_2,
ZN_MAN_03_Funnel_Fire_Step_3,
ZN_MAN_03_Funnel_Fire_Step_4,
ZN_MAN_03_Funnel_Fire_Step_Final
"""




[hiddenAction_ZN_MAN_03_Funnel_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MAN_03_Funnel_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
fireTurretXAtGround:ZN_MAN_03_Funnel
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MAN_03_Funnel_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.05s
fireTurretXAtGround:ZN_MAN_03_Funnel_2
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MAN_03_Funnel_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.05s
fireTurretXAtGround:ZN_MAN_03_Funnel_3
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MAN_03_Funnel_Fire_Step_4]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.05s
fireTurretXAtGround:ZN_MAN_03_Funnel_4
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MAN_03_Funnel_Fire_Step_Final]
buildSpeed:0s
alsoTriggerAction:"""
SetOnSkillOff
"""