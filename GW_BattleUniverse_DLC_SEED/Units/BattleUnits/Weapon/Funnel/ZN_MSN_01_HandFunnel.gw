[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory ZN_MSN_01_HandFunnel_CDTimer:float
@memory ZN_MSN_01_HandFunnel_Units:unit[]
@global ZN_MSN_01_HandFunnel_CD=18
@global ZN_MSN_01_HandFunnel_EN=100
@global ZN_MSN_01_HandFunnel_PilotAwakeningSkill=75

[hiddenAction_Get_FunnelSpawn_ZN_MSN_01_HandFunnel_L]
autoTriggerOnEvent:newMessage(withTag="FunnelSpawn_ZN_MSN_01_HandFunnel_L")
setUnitMemory:ZN_MSN_01_HandFunnel_Units[0]=eventData("unitInfo",type="unit")


[hiddenAction_Get_FunnelSpawn_ZN_MSN_01_HandFunnel_R]
autoTriggerOnEvent:newMessage(withTag="FunnelSpawn_ZN_MSN_01_HandFunnel_R")
setUnitMemory:ZN_MSN_01_HandFunnel_Units[1]=eventData("unitInfo",type="unit")



[decal_DrawLineTo_ZN_MSN_01_HandFunnel_Unit_HasLink_0]
layer:beforeBody
order:3
alpha:0.75
basePositionFromLegEnd:arm1
drawLineTo:memory.ZN_MSN_01_HandFunnel_Units[0].readUnitMemory("Incom_LinkUnits",type="unit[]")[0]
color:#333333
imageScale:0.75
lineWidth:1
xOffsetRelative: -10
yOffsetRelative: 0
onlyOnNonPreview:true
isVisible:if memory.ZN_MSN_01_HandFunnel_Units[0].hp>0
onlyWhileAlive:true

[decal_DrawLineTo_ZN_MSN_01_HandFunnel_Unit_NoLink_0]
layer:beforeBody
order:3
alpha:0.75
basePositionFromLegEnd:arm1
drawLineTo:memory.ZN_MSN_01_HandFunnel_Units[0]
color:#333333
imageScale:0.75
lineWidth:1
xOffsetRelative: -10
yOffsetRelative: 0
onlyOnNonPreview:true
isVisible:if memory.ZN_MSN_01_HandFunnel_Units[0].hp>0 and memory.ZN_MSN_01_HandFunnel_Units[0].readUnitMemory("Incom_LinkUnits",type="unit[]").size<=0
onlyWhileAlive:true


[decal_DrawLineTo_ZN_MSN_01_HandFunnel_Unit_HasLink_1]
@copyFromSection:decal_DrawLineTo_ZN_MSN_01_HandFunnel_Unit_HasLink_0
drawLineTo:memory.ZN_MSN_01_HandFunnel_Units[1].readUnitMemory("Incom_LinkUnits",type="unit[]")[0]
isVisible:if memory.ZN_MSN_01_HandFunnel_Units[1].hp>0
xOffsetRelative: 10

[decal_DrawLineTo_ZN_MSN_01_HandFunnel_Unit_NoLink_1]
@copyFromSection:decal_DrawLineTo_ZN_MSN_01_HandFunnel_Unit_NoLink_0
drawLineTo:memory.ZN_MSN_01_HandFunnel_Units[1]
isVisible:if memory.ZN_MSN_01_HandFunnel_Units[1].hp>0 and memory.ZN_MSN_01_HandFunnel_Units[1].readUnitMemory("Incom_LinkUnits",type="unit[]").size<=0
xOffsetRelative: 10






[turret_ZN_MSN_01_HandFunnel]
x:0
y:0

canShoot:false
projectile:ZN_MSN_01_HandFunnel_Projectile

delay:0.2s
canAttackMaxAngle:15
limitingAngle:0
limitingRange:1200
barrelX:-10
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Action/Common/Transform_1.ogg
shoot_sound_vol:1.0
shoot_flame:BZ_Fire_1_S
[turret_ZN_MSN_01_HandFunnel_R]
@copyFromSection:turret_ZN_MSN_01_HandFunnel
barrelX:10
projectile:ZN_MSN_01_HandFunnel_Projectile_R
shoot_sound_vol:0



[projectile_ZN_MSN_01_HandFunnel_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
MSN_01_HandFunnel_L*1
"""
[projectile_ZN_MSN_01_HandFunnel_Projectile_R]
@copyFromSection:projectile_ZN_MSN_01_HandFunnel_Projectile
spawnUnit:"""
MSN_01_HandFunnel_R*1
"""



[hiddenAction_ZN_MSN_01_HandFunnel_Trigger_ByAI]
autoTrigger:"""
if ${allowAI}==true 
and ${cantAction}==false 
and ${onSkill}==false 
and memory.close==false 
and self.resource.EN>${ZN_MSN_01_HandFunnel_EN} 
and self.timeAlive>memory.ZN_MSN_01_HandFunnel_CDTimer 
and self.parent.hp<=0  
and self.attacking.hp>0 
and memory.pilotUnit.readUnitMemory("pilotAwakeningSkillFinal",type="float")>=${ZN_MSN_01_HandFunnel_PilotAwakeningSkill} 
and not 
(
    memory.armLBreaked==true 
    and 
    memory.armRBreaked==true
) 
"""
setResourcesWithLogic:EN=self.resource().EN-${ZN_MSN_01_HandFunnel_EN}
alsoTriggerAction:ZN_MSN_01_HandFunnel_Trigger

[action_ZN_MSN_01_HandFunnel_Trigger]
pos:10
text:Funnel[LockOn] %{select(self.timeAlive<=memory.ZN_MSN_01_HandFunnel_CDTimer,str(int(memory.ZN_MSN_01_HandFunnel_CDTimer-self.timeAlive))+"s","OK")}
text_zh:浮游炮[锁定] %{select(self.timeAlive<=memory.ZN_MSN_01_HandFunnel_CDTimer,str(int(memory.ZN_MSN_01_HandFunnel_CDTimer-self.timeAlive))+"秒","OK")}
text_KP:100

displayType:infoOnly

price:EN=${ZN_MSN_01_HandFunnel_EN} 

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true
ai_isDisabled:true

iconImage:ROOT:Resource/Image/Units/Button/Weapon/Funnel_3.png
highPriorityQueue:true

isVisible:if self.parent.hp<=0 
isGuiBlinking:"""
if self.timeAlive>memory.ZN_MSN_01_HandFunnel_CDTimer 
and ${cantAction}==false 
and ${onSkill}==false 
and not 
(
    memory.armLBreaked==true 
    and 
    memory.armRBreaked==true
)
"""

isLocked:if self.timeAlive<=memory.ZN_MSN_01_HandFunnel_CDTimer
isLockedMessage:In CD
isLockedMessage_zh:冷却中

isLockedAlt:"""
if memory.pilotUnit.readUnitMemory("pilotAwakeningSkillFinal",type="float")<${ZN_MSN_01_HandFunnel_PilotAwakeningSkill}
"""
isLockedAltMessage:PilotAwakeningSkill Not Enough(%{${ZN_MSN_01_HandFunnel_PilotAwakeningSkill}})
isLockedAltMessage_zh:驾驶员觉醒能力不足(%{${ZN_MSN_01_HandFunnel_PilotAwakeningSkill}})

isLockedAlt2:"""
if 
(
    ${cantAction}==true or ${onSkill}==true or ${allowAI}==true 
)
or 
(
    memory.ZN_MSN_01_HandFunnel_Units[0].hp>0 
    or 
    memory.ZN_MSN_01_HandFunnel_Units[1].hp>0
) 
or 
(
    memory.armLBreaked==true 
    and 
    memory.armRBreaked==true
)
"""
isLockedAlt2Message:Cant Action
isLockedAlt2Message_zh:无法行动

alsoTriggerAction:"""
SetOnSkillOn,
ZN_MSN_01_HandFunnel_SetWeaponIndex,
ZN_MSN_01_HandFunnel_B1_Step_1,
PlayCommon_Cannon_Shoot_A_Step_1
"""
[hiddenAction_ZN_MSN_01_HandFunnel_B1_Step_1]
setUnitMemory:"""
ZN_MSN_01_HandFunnel_CDTimer=self.timeAlive+${ZN_MSN_01_HandFunnel_CD}
"""
shrinkArrays:ZN_MSN_01_HandFunnel_Units
alsoQueueAction:"""
ZN_MSN_01_HandFunnel_Fire_Step_1,
ZN_MSN_01_HandFunnel_Fire_Step_2,
ZN_MSN_01_HandFunnel_Fire_Step_Final
"""




[hiddenAction_ZN_MSN_01_HandFunnel_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MSN_01_HandFunnel_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false
"""
buildSpeed:0.25s
fireTurretXAtGround:ZN_MSN_01_HandFunnel
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MSN_01_HandFunnel_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false
"""
buildSpeed:0.05s
fireTurretXAtGround:ZN_MSN_01_HandFunnel_R
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MSN_01_HandFunnel_Fire_Step_Final]
buildSpeed:0s
alsoTriggerAction:"""
SetOnSkillOff
"""