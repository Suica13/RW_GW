[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""


@memory ZAFT_UWMF_S_1_MSL_CDTimer:float
@global ZAFT_UWMF_S_1_MSL_CD=4.5
@global ZAFT_UWMF_S_1_MSL_EN=55





[decal_ZAFT_UWMF_S_1_MSL]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\ZAFT_UWMF_S_1_MSL.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.7
xOffsetRelative: 4
yOffsetRelative: 12
dirOffset:0
[decal_ZAFT_UWMF_S_1_MSL_NotUsing]
@copyFromSection:decal_ZAFT_UWMF_S_1_MSL
order:0
basePositionFromLegEnd:arm1
imageScale:0.6
imageScaleY:-1
xOffsetRelative:2
yOffsetRelative:-11.5
dirOffset:90






[turret_ZAFT_UWMF_S_1_MSL]
x:0
y:0

canShoot:false
projectile:ZAFT_UWMF_S_1_MSL_Projectile

delay:0.3s
limitingRange:0

canAttackMaxAngle:15
barrelX:12
barrelY:18

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_ZAFT_UWMF_S_1_MSL_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS*1
(
    addResources=
    ShellDamage:2000
    |DpDamage:80
    |WeaponAccuracy=90
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=3
    |AntiAir=0.5 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=10
    |ProjectileSpeed:40
    |ProjectileTurnspeed:1.25
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:40
)
"""







[hiddenAction_ZAFT_UWMF_S_1_MSL_Trigger]
alsoTriggerAction:ZAFT_UWMF_S_1_MSL_Fire
[hiddenAction_ZAFT_UWMF_S_1_MSL_Fire]
requireConditional:"""
if self.timeAlive>memory.ZAFT_UWMF_S_1_MSL_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:ZAFT_UWMF_S_1_MSL_CDTimer=self.timeAlive+${ZAFT_UWMF_S_1_MSL_CD}
addResources:EN=-${ZAFT_UWMF_S_1_MSL_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZAFT_UWMF_S_1_MSL_SetWeaponIndex,
ZAFT_UWMF_S_1_MSL_B4_Step_1
"""
[hiddenAction_ZAFT_UWMF_S_1_MSL_B4_Step_1]
alsoQueueAction:"""
ZAFT_UWMF_S_1_MSL_Fire_Step_1,
ZAFT_UWMF_S_1_MSL_Fire_Step_2,
ZAFT_UWMF_S_1_MSL_Fire_Step_3,
ZAFT_UWMF_S_1_MSL_Fire_Step_3,
ZAFT_UWMF_S_1_MSL_Fire_Step_3,
ZAFT_UWMF_S_1_MSL_Fire_Step_Final
"""





[hiddenAction_ZAFT_UWMF_S_1_MSL_SetWeaponIndex]
isVisible:false


[hiddenAction_ZAFT_UWMF_S_1_MSL_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_ZAFT_UWMF_S_1_MSL_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZAFT_UWMF_S_1_MSL
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_ZAFT_UWMF_S_1_MSL_Fire_Step_3]
@copyFromSection:hiddenAction_ZAFT_UWMF_S_1_MSL_Fire_Step_2
buildSpeed:${turret_ZAFT_UWMF_S_1_MSL.delay}
[hiddenAction_ZAFT_UWMF_S_1_MSL_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


