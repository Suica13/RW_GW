[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""


@memory OMNI_52mmMG_CDTimer:float
@global OMNI_52mmMG_CD=2
@global OMNI_52mmMG_EN=20





[decal_OMNI_52mmMG]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\OMNI_52mmMG.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.75
xOffsetRelative: 1
yOffsetRelative: 12
dirOffset:0
[decal_OMNI_52mmMG_NotUsing]
@copyFromSection:decal_OMNI_52mmMG
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.65
xOffsetRelative:-1
yOffsetRelative:-5
dirOffset:-90






[turret_OMNI_52mmMG]
x:0
y:0

canShoot:false
projectile:OMNI_52mmMG_Projectile

delay:0.1s
limitingRange:0

canAttackMaxAngle:15
barrelX:8
barrelY:24

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_1.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_OMNI_52mmMG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:750
    |DpDamage:25
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:5
    |ProjectileLife:25
)
"""







[hiddenAction_OMNI_52mmMG_Trigger]
alsoTriggerAction:OMNI_52mmMG_Fire
[hiddenAction_OMNI_52mmMG_Fire]
requireConditional:"""
if self.timeAlive>memory.OMNI_52mmMG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:OMNI_52mmMG_CDTimer=self.timeAlive+${OMNI_52mmMG_CD}
addResources:EN=-${OMNI_52mmMG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
OMNI_52mmMG_SetWeaponIndex,
OMNI_52mmMG_B9_Step_1
"""
[hiddenAction_OMNI_52mmMG_B9_Step_1]
alsoQueueAction:"""
OMNI_52mmMG_Fire_Step_1,
OMNI_52mmMG_Fire_Step_2,
OMNI_52mmMG_Fire_Step_3,
OMNI_52mmMG_Fire_Step_3,
OMNI_52mmMG_Fire_Step_3,
OMNI_52mmMG_Fire_Step_3,
OMNI_52mmMG_Fire_Step_3,
OMNI_52mmMG_Fire_Step_3,
OMNI_52mmMG_Fire_Step_3,
OMNI_52mmMG_Fire_Step_3,
OMNI_52mmMG_Fire_Step_Final
"""





[hiddenAction_OMNI_52mmMG_SetWeaponIndex]
isVisible:false


[hiddenAction_OMNI_52mmMG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_OMNI_52mmMG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:OMNI_52mmMG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_OMNI_52mmMG_Fire_Step_3]
@copyFromSection:hiddenAction_OMNI_52mmMG_Fire_Step_2
buildSpeed:${turret_OMNI_52mmMG.delay}
alsoTriggerAction:PlayCommon_Shoot_A_FA_Step_1
[hiddenAction_OMNI_52mmMG_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


