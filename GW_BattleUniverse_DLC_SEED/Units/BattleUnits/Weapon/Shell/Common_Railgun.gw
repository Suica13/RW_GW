[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/Railgun_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory Common_Railgun_CDTimer:float
@global Common_Railgun_CD=7
@global Common_Railgun_EN=55








[turret_Common_Railgun]
x:0
y:0

canShoot:false
projectile:Common_Railgun_Projectile

delay:0.3s
canAttackMaxAngle:15
limitingAngle:0
barrelX:8
barrelY:6

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/Railgun_1.ogg
shoot_sound_vol:0.85
shoot_flame:Railgun_Fire_1



[projectile_Common_Railgun_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_RailShell*1
(
    addResources=
    ShellAPDamage:6000
    |ShellDamage:2000
    |DpDamage:200
    |WeaponAccuracy=85
    |PartBreakModifier=0.75
    |CockpitBreakModifier=1.25
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=1 
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=0.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:80
    |ProjectileSpread:1
    |ProjectileExplosionRange:30
    |ProjectileLife:25
)
"""








[hiddenAction_Common_Railgun_Trigger]
alsoTriggerAction:Common_Railgun_Fire
[hiddenAction_Common_Railgun_Fire]
requireConditional:"""
if self.timeAlive>memory.Common_Railgun_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:Common_Railgun_CDTimer=self.timeAlive+${Common_Railgun_CD}
addResources:EN=-${Common_Railgun_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
Common_Railgun_SetWeaponIndex,
Common_Railgun_B1_Step_1
"""
[hiddenAction_Common_Railgun_B1_Step_1]
alsoQueueAction:"""
Common_Railgun_Fire_Step_1,
Common_Railgun_Fire_Step_2,
Common_Railgun_Fire_Step_3,
Common_Railgun_Fire_Step_Final
"""






[hiddenAction_Common_Railgun_SetWeaponIndex]
isVisible:false


[hiddenAction_Common_Railgun_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
alsoTriggerAction:PlayCommon_Cannon_Shoot_A_Step_1
[hiddenAction_Common_Railgun_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_Common_Railgun_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:Common_Railgun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_Common_Railgun_Fire_Step_Final]
buildSpeed:1.25s
finishPlayingLastAnimation:true
alsoTriggerAction:SetAttackingOff


