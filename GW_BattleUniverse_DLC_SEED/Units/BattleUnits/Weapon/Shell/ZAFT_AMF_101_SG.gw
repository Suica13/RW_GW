[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""

@memory ZAFT_AMF_101_SG_CDTimer:float
@global ZAFT_AMF_101_SG_CD=3
@global ZAFT_AMF_101_SG_EN=25





[decal_ZAFT_AMF_101_SG]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Weapon/Shell/Image/ZAFT_AMF_101_SG.png
isVisible:false
basePositionFromLegEnd:arm3
imageScale:0.65
xOffsetRelative: -1
yOffsetRelative: 12
dirOffset:0







[turret_ZAFT_AMF_101_SG]
x:0
y:0

canShoot:false
projectile:ZAFT_AMF_101_SG_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:-11
barrelY:28
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/ShellShotGun_1.ogg
shoot_sound_vol:0.5
shoot_flame:BZ_Fire_1_S



[projectile_ZAFT_AMF_101_SG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_ShellShotGun*8
(
    offsetRandomDir=9,
    addResources=
    ShellDamage:400
    |ShellAPDamage:200
    |DpDamage:100
    |WeaponAccuracy=95
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.0
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.0
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:55
    |ProjectileSpread:2
    |ProjectileLife:12
)
"""





[hiddenAction_ZAFT_AMF_101_SG_Trigger]
alsoTriggerAction:ZAFT_AMF_101_SG_Fire
[hiddenAction_ZAFT_AMF_101_SG_Fire]
requireConditional:"""
if self.timeAlive>memory.ZAFT_AMF_101_SG_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:ZAFT_AMF_101_SG_CDTimer=self.timeAlive+${ZAFT_AMF_101_SG_CD}
addResources:EN=-${ZAFT_AMF_101_SG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZAFT_AMF_101_SG_SetWeaponIndex,
PlayCommon_Shoot_A_L_Step_1,
ZAFT_AMF_101_SG_B1_Step_1
"""
[hiddenAction_ZAFT_AMF_101_SG_B1_Step_1]
alsoQueueAction:"""
ZAFT_AMF_101_SG_Fire_Step_1,
ZAFT_AMF_101_SG_Fire_Step_2,
ZAFT_AMF_101_SG_Fire_Step_Final
"""



[hiddenAction_ZAFT_AMF_101_SG_SetWeaponIndex]
isVisible:false


[hiddenAction_ZAFT_AMF_101_SG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_ZAFT_AMF_101_SG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZAFT_AMF_101_SG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZAFT_AMF_101_SG_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

