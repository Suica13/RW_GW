[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw
"""

@memory Common_DemolitionChain_Back_Space_GP_03D_CDTimer:float
@global Common_DemolitionChain_Back_Space_GP_03D_CD=180
@global Common_DemolitionChain_Back_Space_GP_03D_EN=150


[turret_Common_DemolitionChain_Back_Space_GP_03D]
x:0
y:0

canShoot:false
projectile:Common_DemolitionChain_Back_Space_GP_03D_Projectile

delay:0.2s
canAttackMaxAngle:15
limitingAngle:0
limitingRange:1200
barrelX:0
barrelY:-50
idleDir:-180

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/Bomb_1.ogg
shoot_sound_vol:0
shoot_flame:BZ_Fire_1_S




[projectile_Common_DemolitionChain_Back_Space_GP_03D_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_DemolitionChain_1*1
(
    addResources=
    ShellDamage:2500
    |DpDamage:250
    |WeaponAccuracy=50
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=1.0
    |AntiAir=1.0
    |AntiLand=1.0
    |AntiSpace=1.0
    |AntiSizeLargeDamage=2.0
    |AntiSizeSmallDamage=0.5
    |AntiSizeLargeAccuracy=2.0
    |AntiSizeSmallAccuracy=0.5
    |AntiBuilding=0.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileExplosionRange:50
    |ProjectileLife:60

    |ProjectileBlastRange:60
    |ProjectileBlastDamageModifier:0.20
    |ProjectileBlastDpModifier:1
)
"""



[action_Common_DemolitionChain_Back_Space_GP_03D_Trigger]
pos:10
text:DemolitionChain[Back] %{select(self.timeAlive<=memory.Common_DemolitionChain_Back_Space_GP_03D_CDTimer,str(int(memory.Common_DemolitionChain_Back_Space_GP_03D_CDTimer-self.timeAlive))+"s","OK")}
text_zh:导爆索[后方] %{select(self.timeAlive<=memory.Common_DemolitionChain_Back_Space_GP_03D_CDTimer,str(int(memory.Common_DemolitionChain_Back_Space_GP_03D_CDTimer-self.timeAlive))+"秒","OK")}
text_KP:100


displayType:infoOnly

price:EN=${Common_DemolitionChain_Back_Space_GP_03D_EN}

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true
ai_isDisabled:true

iconImage:ROOT:Resource/Image/Units/Button/Weapon/Grenade_3.png
highPriorityQueue:true

isVisible:if self.parent.hp<=0 
isGuiBlinking:"""
if self.timeAlive>memory.Common_DemolitionChain_Back_Space_GP_03D_CDTimer 
and ${cantAction}==false 
and ${onSkill}==false
"""

isLocked:if self.timeAlive<=memory.Common_DemolitionChain_Back_Space_GP_03D_CDTimer
isLockedMessage:In CD
isLockedMessage_zh:冷却中
isLockedAlt2:if ${cantAction}==true or ${onSkill}==true
isLockedAlt2Message:Cant Action
isLockedAlt2Message_zh:无法行动

alsoTriggerAction:"""
SetOnSkillOn,
Common_DemolitionChain_Back_Space_GP_03D_SetWeaponIndex,
Common_DemolitionChain_Back_Space_GP_03D_B25_Step_1
"""
[hiddenAction_Common_DemolitionChain_Back_Space_GP_03D_B25_Step_1]
setUnitMemory:"""
Common_DemolitionChain_Back_Space_GP_03D_CDTimer=self.timeAlive+${Common_DemolitionChain_Back_Space_GP_03D_CD}
"""

alsoQueueAction:"""
Common_DemolitionChain_Back_Space_GP_03D_Fire_Step_1,
Common_DemolitionChain_Back_Space_GP_03D_Fire_Step_2,
Common_DemolitionChain_Back_Space_GP_03D_Fire_Step_2,
Common_DemolitionChain_Back_Space_GP_03D_Fire_Step_2,
