if ${cantAction}==false 
"""
buildSpeed:0.1s
fireTurretXAtGround:Common_DemolitionChain_Back_Space_GP_03D
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=-10)

[hiddenAction_Common_DemolitionChain_Back_Space_GP_03D_Fire_Step_Final]
