Common_DemolitionChain_Back_Space_GP_03D_Fire_Step_2,
Common_DemolitionChain_Back_Space_GP_03D_Fire_Step_Final
"""




[hiddenAction_Common_DemolitionChain_Back_Space_GP_03D_SetWeaponIndex]
isVisible:false


[hiddenAction_Common_DemolitionChain_Back_Space_GP_03D_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.5s
fireTurretXAtGround:Common_DemolitionChain_Back_Space_GP_03D
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=-10)

[hiddenAction_Common_DemolitionChain_Back_Space_GP_03D_Fire_Step_2]
