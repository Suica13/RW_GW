@copyFromSection:template_ManualShip_ArcLine
color:#66AAFF
isVisible:if ${manualControlReady} and memory.hideUI==0 and memory.manualShipArcGroup==0 and self.attachment(slot='ArchangelClass_Turret_BeamCannon_L1').hp>0 and not self.attachment(slot='ArchangelClass_Turret_BeamCannon_L1').readUnitMemory('breaked',type='bool')
alpha:select(not self.attachment(slot='ArchangelClass_Turret_BeamCannon_L1').readUnitMemory('ArchangelClass_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='ArchangelClass_Turret_BeamCannon_L1').resource.ArchangelClass_Turret_BeamCannon_ShootTimer>0,0.55,0.15)

