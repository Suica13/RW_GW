[core]
dont_load:true
@global manualControlImplemented=true
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw
@memory manualVehicle_EF_Type61_SPG_Cannon_Left:float
@memory manualVehicle_EF_Type61_SPG_Cannon_Next:float

# Use native projectiles, costs, burst delays and reload actions; no weapon polling.

[turret_EF_Type61_SPG_Cannon]
canAttackCondition:if not memory.manualControlEnabled and (${onAttacking}==false and ${cantAction}==false and distanceBetween(self,self.attacking)>150 and ${onSkill}==false)

[action_ManualVehicle_EF_Type61_SPG_Cannon]
temporarilyAddTags:inBattle
@copyFromSection:template_ManualWeapon
pos:2
text:Cannon
text_zh:火炮
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
isLocked:if not (${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false)) and self.resource.EF_Type61_SPG_Cannon_ShootTimer>=1 and self.resource.en>=${EF_Type61_SPG_Cannon_EN} and memory.manualVehicle_EF_Type61_SPG_Cannon_Left<=0 and self.timeAlive>=memory.manualVehicle_EF_Type61_SPG_Cannon_Next)
requireConditional:if ${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false)) and self.resource.EF_Type61_SPG_Cannon_ShootTimer>=1 and self.resource.en>=${EF_Type61_SPG_Cannon_EN} and memory.manualVehicle_EF_Type61_SPG_Cannon_Left<=0 and self.timeAlive>=memory.manualVehicle_EF_Type61_SPG_Cannon_Next
setUnitMemory:manualVehicle_EF_Type61_SPG_Cannon_Left=max(1,int(self.resource.EF_Type61_SPG_Cannon_ShootTimer/(1)))
alsoTriggerAction:ManualVehicle_EF_Type61_SPG_Cannon_Shot,ManualVehicle_EF_Type61_SPG_Cannon_Continue,ManualVehicle_EF_Type61_SPG_Cannon_Stop

[hiddenAction_ManualVehicle_EF_Type61_SPG_Cannon_Shot]
addResources:EF_Type61_SPG_Cannon_ShootTimer=-1,en=-${EF_Type61_SPG_Cannon_EN}
requireConditional:if ${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false)) and self.resource.EF_Type61_SPG_Cannon_ShootTimer>=1 and self.resource.en>=${EF_Type61_SPG_Cannon_EN} and memory.manualVehicle_EF_Type61_SPG_Cannon_Left>0
fireTurretXAtGround:EF_Type61_SPG_Cannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
setUnitMemory:manualVehicle_EF_Type61_SPG_Cannon_Left=memory.manualVehicle_EF_Type61_SPG_Cannon_Left-1,manualVehicle_EF_Type61_SPG_Cannon_Next=self.timeAlive+0.0
alsoTriggerAction:Check_InBattle_Attack

[hiddenAction_ManualVehicle_EF_Type61_SPG_Cannon_Wait]
highPriorityQueue:false
allowMultipleInQueue:true
buildSpeed:0.016666666666666666s
alsoTriggerAction:ManualVehicle_EF_Type61_SPG_Cannon_Shot,ManualVehicle_EF_Type61_SPG_Cannon_Continue,ManualVehicle_EF_Type61_SPG_Cannon_Stop

[hiddenAction_ManualVehicle_EF_Type61_SPG_Cannon_Continue]
requireConditional:if ${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false)) and self.resource.EF_Type61_SPG_Cannon_ShootTimer>=1 and self.resource.en>=${EF_Type61_SPG_Cannon_EN} and memory.manualVehicle_EF_Type61_SPG_Cannon_Left>0
alsoQueueAction:ManualVehicle_EF_Type61_SPG_Cannon_Wait

[hiddenAction_ManualVehicle_EF_Type61_SPG_Cannon_Stop]
requireConditional:if not (${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false)) and self.resource.EF_Type61_SPG_Cannon_ShootTimer>=1 and self.resource.en>=${EF_Type61_SPG_Cannon_EN}) or memory.manualVehicle_EF_Type61_SPG_Cannon_Left<=0
setUnitMemory:manualVehicle_EF_Type61_SPG_Cannon_Left=0

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff
setUnitMemory:manualVehicle_EF_Type61_SPG_Cannon_Left=0

[action_Set_AttackMode_Shoot]
autoTrigger:false
isLocked:true
isVisible:if not memory.manualControlEnabled and (memory.attackMode==0 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Cqb]
autoTrigger:false
isLocked:true
isVisible:if not memory.manualControlEnabled and (memory.attackMode==1 and not self.hasTags(includes='inHangar'))
