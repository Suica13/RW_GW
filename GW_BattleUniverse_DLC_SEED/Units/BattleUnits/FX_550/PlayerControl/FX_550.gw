[core]
dont_load:true
@global manualControlImplemented=true
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw


# Use native projectiles, costs, burst delays and reload actions; no weapon polling.

[hiddenAction_OMNI_FX_550_BR_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>=0  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and eventData("RandomWeapon",type="float")<=75 and eventData("RandomWeapon",type="float")>50)

[hiddenAction_OMNI_FX_550_BR_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_DoubleGun_FX_550_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>=0  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and eventData("RandomWeapon",type="float")<=50 and eventData("RandomWeapon",type="float")>25)

[hiddenAction_Common_DoubleGun_FX_550_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_DoubleGun_FX_550_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_DoubleGun_FX_550_Fire_Step_4]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_DoubleMS_FX_550_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>=0   and distanceBetween(self,self.attacking)<=memory.finalAttackRange and eventData("RandomWeapon",type="float")<=25)

[hiddenAction_Common_DoubleMS_FX_550_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_DoubleMS_FX_550_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_DoubleMS_FX_550_Fire_Step_4]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_OMNI_GAT_X105_BR_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and eventData("RandomWeapon",type="float")>75 and self.resource().EquipmentIndex==1)

[hiddenAction_OMNI_GAT_X105_BR_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_OMNI_GAT_X105_Launcher_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and eventData("RandomWeapon",type="float")>75 and self.resource().EquipmentIndex==2)

[hiddenAction_OMNI_GAT_X105_Launcher_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_OMNI_GAT_X105_S_RocketAnchor_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and eventData("RandomWeapon",type="float")>75 and self.resource().EquipmentIndex==3)

[hiddenAction_OMNI_GAT_X105_S_RocketAnchor_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[action_Manual_OMNI_FX_550_BR]
@copyFromSection:template_ManualWeapon
pos:2
text:Beam rifle
text_zh:光束步枪
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady} and ((true))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.OMNI_FX_550_BR_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${OMNI_FX_550_BR_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.OMNI_FX_550_BR_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${OMNI_FX_550_BR_EN}
alsoTriggerAction:OMNI_FX_550_BR_Fire

[hiddenAction_OMNI_FX_550_BR_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.OMNI_FX_550_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  and not (directionBetween(self, self.attacking) < self.dir-25 or directionBetween(self, self.attacking) > self.dir+25)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.OMNI_FX_550_BR_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${OMNI_FX_550_BR_EN})
setUnitMemory:OMNI_FX_550_BR_CDTimer=self.timeAlive+${OMNI_FX_550_BR_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${OMNI_FX_550_BR_CD}s
addActionCooldownApplyToActions:Manual_OMNI_FX_550_BR

