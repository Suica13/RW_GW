[core]
dont_load:true
@global manualControlImplemented=true
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw
@memory manualVehicle_OMNI_LinearGunTank_Cannon_Left:float
@memory manualVehicle_OMNI_LinearGunTank_Cannon_Next:float

# Use native projectiles, costs, burst delays and reload actions; no weapon polling.

[turret_OMNI_LinearGunTank_Cannon]
canAttackCondition:if not memory.manualControlEnabled and (${onAttacking}==false and ${cantAction}==false)

[action_ManualVehicle_OMNI_LinearGunTank_Cannon]
temporarilyAddTags:inBattle
@copyFromSection:template_ManualWeapon
pos:2
text:Linear cannon
text_zh:线性炮
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
isLocked:if not (${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.OMNI_LinearGunTank_Cannon_ShootTimer>=1 and self.resource.en>=${OMNI_LinearGunTank_Cannon_EN} and memory.manualVehicle_OMNI_LinearGunTank_Cannon_Left<=0 and self.timeAlive>=memory.manualVehicle_OMNI_LinearGunTank_Cannon_Next)
requireConditional:if ${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.OMNI_LinearGunTank_Cannon_ShootTimer>=1 and self.resource.en>=${OMNI_LinearGunTank_Cannon_EN} and memory.manualVehicle_OMNI_LinearGunTank_Cannon_Left<=0 and self.timeAlive>=memory.manualVehicle_OMNI_LinearGunTank_Cannon_Next
setUnitMemory:manualVehicle_OMNI_LinearGunTank_Cannon_Left=max(1,int(self.resource.OMNI_LinearGunTank_Cannon_ShootTimer/(1)))
alsoTriggerAction:ManualVehicle_OMNI_LinearGunTank_Cannon_Shot,ManualVehicle_OMNI_LinearGunTank_Cannon_Continue,ManualVehicle_OMNI_LinearGunTank_Cannon_Stop

[hiddenAction_ManualVehicle_OMNI_LinearGunTank_Cannon_Shot]
addResources:OMNI_LinearGunTank_Cannon_ShootTimer=-1,en=-${OMNI_LinearGunTank_Cannon_EN}
requireConditional:if ${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.OMNI_LinearGunTank_Cannon_ShootTimer>=1 and self.resource.en>=${OMNI_LinearGunTank_Cannon_EN} and memory.manualVehicle_OMNI_LinearGunTank_Cannon_Left>0
fireTurretXAtGround:OMNI_LinearGunTank_Cannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
setUnitMemory:manualVehicle_OMNI_LinearGunTank_Cannon_Left=memory.manualVehicle_OMNI_LinearGunTank_Cannon_Left-1,manualVehicle_OMNI_LinearGunTank_Cannon_Next=self.timeAlive+0.05
alsoTriggerAction:Check_InBattle_Attack

[hiddenAction_ManualVehicle_OMNI_LinearGunTank_Cannon_Wait]
highPriorityQueue:false
allowMultipleInQueue:true
buildSpeed:0.05s
alsoTriggerAction:ManualVehicle_OMNI_LinearGunTank_Cannon_Shot,ManualVehicle_OMNI_LinearGunTank_Cannon_Continue,ManualVehicle_OMNI_LinearGunTank_Cannon_Stop

[hiddenAction_ManualVehicle_OMNI_LinearGunTank_Cannon_Continue]
requireConditional:if ${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.OMNI_LinearGunTank_Cannon_ShootTimer>=1 and self.resource.en>=${OMNI_LinearGunTank_Cannon_EN} and memory.manualVehicle_OMNI_LinearGunTank_Cannon_Left>0
alsoQueueAction:ManualVehicle_OMNI_LinearGunTank_Cannon_Wait

[hiddenAction_ManualVehicle_OMNI_LinearGunTank_Cannon_Stop]
requireConditional:if not (${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.OMNI_LinearGunTank_Cannon_ShootTimer>=1 and self.resource.en>=${OMNI_LinearGunTank_Cannon_EN}) or memory.manualVehicle_OMNI_LinearGunTank_Cannon_Left<=0
setUnitMemory:manualVehicle_OMNI_LinearGunTank_Cannon_Left=0

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff
setUnitMemory:manualVehicle_OMNI_LinearGunTank_Cannon_Left=0

[action_Set_AttackMode_Shoot]
autoTrigger:false
isLocked:true
isVisible:if not memory.manualControlEnabled and (memory.attackMode==0 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Cqb]
autoTrigger:false
isLocked:true
isVisible:if not memory.manualControlEnabled and (memory.attackMode==1 and not self.hasTags(includes='inHangar'))
