[core]
copyFrom:"""
ROOT:Template/UI/Common_UI.gw
"""

tags:TechTree_Page
name:TechTree_UI_Page

showInEditor:false

@memory tipsIndexNow:float
@memory tipsIndexChangeTimer:float
@memory autoTech:float

@global tipsIndexMax=0


[hiddenAction_Start_Get_AutoTech]
autoTriggerOnEvent:created
setUnitMemory:autoTech=customTarget1.readUnitMemory('autoTech',type='float')

[hiddenAction_InitializeStats]


[hiddenAction_Update]




[hiddenAction_ClosePage]
autoTriggerOnEvent:newMessage(withTag="ClosePage")
sendMessageTo:parent
sendMessageWithTags:ClosePage
alsoTriggerAction:Delete

[hiddenAction_NextPage]
autoTriggerOnEvent:newMessage(withTag="NextPage")
sendMessageTo:parent
sendMessageWithTags:NextPage
alsoTriggerAction:Delete

[hiddenAction_LastPage]
autoTriggerOnEvent:newMessage(withTag="LastPage")
sendMessageTo:parent
sendMessageWithTags:LastPage
alsoTriggerAction:Delete


[hiddenAction_Delete]
deleteSelf:true


[attachment_CloseButton]
x:132.5
y:57.5
setDrawLayerOnBottom:false
isVisible:true
keepAliveWhenParentDies:false
canBeAttackedAndDamaged:false
isUnselectable:false
canAttack:false
showAllActionsFrom:false
prioritizeParentsMainTarget:true
smoothlyBlendPositionWhenExistingUnitAdded:false
onConvertKeepExistingUnitInSameSlot:true
onParentTeamChangeKeepCurrentTeam:false
onCreateSpawnUnitOf:TechTree_UI_Close*1


[attachment_NextPage]
x:135
y:-62
setDrawLayerOnBottom:false
isVisible:true
keepAliveWhenParentDies:false
canBeAttackedAndDamaged:false
isUnselectable:false
canAttack:false
showAllActionsFrom:false
prioritizeParentsMainTarget:true
smoothlyBlendPositionWhenExistingUnitAdded:false
onConvertKeepExistingUnitInSameSlot:true
onParentTeamChangeKeepCurrentTeam:false
onCreateSpawnUnitOf:TechTree_UI_NextPage*1

[attachment_LastPage]
x:-135
y:-62
setDrawLayerOnBottom:false
isVisible:true
keepAliveWhenParentDies:false
canBeAttackedAndDamaged:false
isUnselectable:false
canAttack:false
showAllActionsFrom:false
prioritizeParentsMainTarget:true
smoothlyBlendPositionWhenExistingUnitAdded:false
onConvertKeepExistingUnitInSameSlot:true
onParentTeamChangeKeepCurrentTeam:false
onCreateSpawnUnitOf:TechTree_UI_LastPage*1

[template_TechSlot]
x:0
y:0
isVisible:true
setDrawLayerOnTop:true
keepAliveWhenParentDies:false
canBeAttackedAndDamaged:false
isUnselectable:false
canAttack:false
showAllActionsFrom:false
prioritizeParentsMainTarget:true
smoothlyBlendPositionWhenExistingUnitAdded:false
onConvertKeepExistingUnitInSameSlot:true
onParentTeamChangeKeepCurrentTeam:false


[decal_Background]
layer:beforeUI
order:0
onlyWhileAlive:true
onlyTeam:ally
#onlyPlayersWithUnitControl:true
isVisible:true
imageScale:1
[decal_Background2]
@copyFromSection:decal_Background
imageScale:0.5
alpha:0.35

[decal_Faction_Icon]
layer:beforeUI
order:1
onlyWhileAlive:true
onlyTeam:ally
isVisible:true
imageScale:0.5
xOffsetRelative:-132.5
yOffsetRelative:57.5


[decal_Faction_Text]
layer:beforeUI
order:1
onlyWhileAlive:true
onlyTeam:ally
isVisible:true
imageScale:0.5
xOffsetRelative:-75
yOffsetRelative:55


[template_DrawLine]
layer:shadow
order:0
alpha:1
color:#FFFFFF
imageScale:1
lineWidth:4
onlyOnNonPreview:true
onlyTeam:ally
isVisible:true
onlyWhileAlive:true