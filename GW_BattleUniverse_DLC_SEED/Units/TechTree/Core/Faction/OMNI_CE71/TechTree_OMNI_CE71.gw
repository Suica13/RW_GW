

[action_ShowTechTree_OMNI_CE71]
@copyFromSection:template_ShowTechTree
text:OMNI[CE71]
text_zh:地球联合军[CE71]
iconImage:ROOT:Resource/Image/Icon/Faction_OMNI_CE71_2.png
isVisible:if self.attachment(slot="OMNI_CE71").hp>0 and memory.showTechTree==false and self.globalTeamTags(includes='Tech_OMNI_CE71_BaseTech')

isLocked:"""
if not self.globalTeamTags(includes='Tech_OMNI_CE71_BaseTech')
"""

sendMessageTo:self.attachment(slot="OMNI_CE71")


[attachment_OMNI_CE71]
@copyFromSection:template_TechTree_Main
onCreateSpawnUnitOf:TechTree_UI_Main_OMNI_CE71
