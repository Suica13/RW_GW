[core]
dont_load:true
@global manualControlImplemented=true
@memory manualShipArcGroup:float
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw,ROOT:Template/Unit/Skill/PlayerControl/Ships/Arcs_dc1dbe131c80.gw

[action_LaunchAllUnits]
pos:82

[action_Common_FullBoost_Trigger]
pos:65

[action_Common_ReEntry_Trigger]
pos:65

[action_Common_ReEntry_FromSpace_Trigger]
pos:65

[hiddenAction_ManualShip_Send_ArchangelClass_Turret_BeamCannon_L1]
sendMessageTo:self.attachment(slot='ArchangelClass_Turret_BeamCannon_L1')
sendMessageWithTags:ManualShip_0087_Beam
sendMessageWithData:owner=self,controller=memory.manualControlHQ,serial=memory.manualVulcanSerial

[hiddenAction_ManualShip_Send_ArchangelClass_Turret_BeamCannon_R1]
sendMessageTo:self.attachment(slot='ArchangelClass_Turret_BeamCannon_R1')
sendMessageWithTags:ManualShip_0087_Beam
sendMessageWithData:owner=self,controller=memory.manualControlHQ,serial=memory.manualVulcanSerial

[action_ManualShip_Beam]
@copyFromSection:template_ManualWeapon
pos:2
text:Beam cannon salvo [%{select(self.attachment(slot='ArchangelClass_Turret_BeamCannon_L1').hp>0 and not self.attachment(slot='ArchangelClass_Turret_BeamCannon_L1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='ArchangelClass_Turret_BeamCannon_L1').readUnitMemory('ArchangelClass_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='ArchangelClass_Turret_BeamCannon_L1').resource.ArchangelClass_Turret_BeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='ArchangelClass_Turret_BeamCannon_R1').hp>0 and not self.attachment(slot='ArchangelClass_Turret_BeamCannon_R1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='ArchangelClass_Turret_BeamCannon_R1').readUnitMemory('ArchangelClass_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='ArchangelClass_Turret_BeamCannon_R1').resource.ArchangelClass_Turret_BeamCannon_ShootTimer>0,1,0)}/2]
text_zh:光束炮齐射 [%{select(self.attachment(slot='ArchangelClass_Turret_BeamCannon_L1').hp>0 and not self.attachment(slot='ArchangelClass_Turret_BeamCannon_L1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='ArchangelClass_Turret_BeamCannon_L1').readUnitMemory('ArchangelClass_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='ArchangelClass_Turret_BeamCannon_L1').resource.ArchangelClass_Turret_BeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='ArchangelClass_Turret_BeamCannon_R1').hp>0 and not self.attachment(slot='ArchangelClass_Turret_BeamCannon_R1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='ArchangelClass_Turret_BeamCannon_R1').readUnitMemory('ArchangelClass_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='ArchangelClass_Turret_BeamCannon_R1').resource.ArchangelClass_Turret_BeamCannon_ShootTimer>0,1,0)}/2]
description:Order ready turrets to fire. Each turret aims at its own target; without a target it fires along its current barrel direction.
description_zh:命令就绪炮位开火；有目标时各自瞄准，无目标时沿炮塔当前朝向发射。损坏或装填中的炮位跳过。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
isLocked:if not ${manualAuxiliaryReady} or ${onSkill} or (select(self.attachment(slot='ArchangelClass_Turret_BeamCannon_L1').hp>0 and not self.attachment(slot='ArchangelClass_Turret_BeamCannon_L1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='ArchangelClass_Turret_BeamCannon_L1').readUnitMemory('ArchangelClass_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='ArchangelClass_Turret_BeamCannon_L1').resource.ArchangelClass_Turret_BeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='ArchangelClass_Turret_BeamCannon_R1').hp>0 and not self.attachment(slot='ArchangelClass_Turret_BeamCannon_R1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='ArchangelClass_Turret_BeamCannon_R1').readUnitMemory('ArchangelClass_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='ArchangelClass_Turret_BeamCannon_R1').resource.ArchangelClass_Turret_BeamCannon_ShootTimer>0,1,0))<=0 or self.resource.EN<=0
requireConditional:if ${manualAuxiliaryReady} and ${onSkill}==false
alsoTriggerAction:ManualShip_Send_ArchangelClass_Turret_BeamCannon_L1,ManualShip_Send_ArchangelClass_Turret_BeamCannon_R1

