iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
isVisible:if ${manualControlReady} and ((((not ((memory.armLBreaked==true) and (memory.armRBreaked==true))))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZAFT_UMF_4A_MS_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((not ((memory.armLBreaked==true) and (memory.armRBreaked==true)))))) and self.resource.EN>=${ZAFT_UMF_4A_MS_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZAFT_UMF_4A_MS_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((not ((memory.armLBreaked==true) and (memory.armRBreaked==true)))))) and self.resource.EN>=${ZAFT_UMF_4A_MS_EN}
alsoTriggerAction:ZAFT_UMF_4A_MS_Fire

[hiddenAction_ZAFT_UMF_4A_MS_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZAFT_UMF_4A_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZAFT_UMF_4A_MS_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((not ((memory.armLBreaked==true) and (memory.armRBreaked==true)))))) and self.resource.EN>=${ZAFT_UMF_4A_MS_EN})
setUnitMemory:ZAFT_UMF_4A_MS_CDTimer=self.timeAlive+${ZAFT_UMF_4A_MS_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
