[core]
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_Common_Push_A_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60   and memory.armRBreaked==true)

[hiddenAction_Common_Push_A_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZAFT_ZGMF_1017M_MG_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and self.resource().EquipmentIndex==0 and memory.armRBreaked==false)

[hiddenAction_ZAFT_ZGMF_1017M_MG_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZAFT_ZGMF_1017M_MG_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZAFT_ZGMF_1017_BZ_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and self.resource().EquipmentIndex==1 and memory.armRBreaked==false)

[hiddenAction_ZAFT_ZGMF_1017_BZ_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZAFT_ZGMF_1017_SB_BF_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60 and memory.armRBreaked==false)

[hiddenAction_ZAFT_ZGMF_1017_SB_BF_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZAFT_ZGMF_1017_SB_BF_Fire_Step_5]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[action_Common_FullBoost_Trigger]
pos:65

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff

[action_Manual_Common_Push_A]
@copyFromSection:template_ManualWeapon
pos:4
text:Punch
text_zh:徒手格斗
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==true))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true))))
alsoTriggerAction:Common_Push_A_Fire

[hiddenAction_Common_Push_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
setUnitMemory:Common_Push_A_CDTimer=self.timeAlive+${Common_Push_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_Push_A_CD}s
addActionCooldownApplyToActions:Manual_Common_Push_A

[action_Manual_ZAFT_ZGMF_1017M_MG]
@copyFromSection:template_ManualWeapon
pos:2
text:Machine gun
text_zh:机枪
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/MachineGun_1.png
isVisible:if ${manualControlReady} and ((((self.resource().EquipmentIndex==0) and (memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZAFT_ZGMF_1017M_MG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==0) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZAFT_ZGMF_1017M_MG_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZAFT_ZGMF_1017M_MG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==0) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZAFT_ZGMF_1017M_MG_EN}
alsoTriggerAction:ZAFT_ZGMF_1017M_MG_Fire

[hiddenAction_ZAFT_ZGMF_1017M_MG_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZAFT_ZGMF_1017M_MG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZAFT_ZGMF_1017M_MG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==0) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZAFT_ZGMF_1017M_MG_EN})
setUnitMemory:ZAFT_ZGMF_1017M_MG_CDTimer=self.timeAlive+${ZAFT_ZGMF_1017M_MG_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZAFT_ZGMF_1017M_MG_CD}s
addActionCooldownApplyToActions:Manual_ZAFT_ZGMF_1017M_MG

[action_Manual_ZAFT_ZGMF_1017_BZ]
@copyFromSection:template_ManualWeapon
pos:2
text:Bazooka
text_zh:火箭筒
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Bazooka_1.png
isVisible:if ${manualControlReady} and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZAFT_ZGMF_1017_BZ_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZAFT_ZGMF_1017_BZ_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZAFT_ZGMF_1017_BZ_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZAFT_ZGMF_1017_BZ_EN}
alsoTriggerAction:ZAFT_ZGMF_1017_BZ_Fire

[hiddenAction_ZAFT_ZGMF_1017_BZ_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZAFT_ZGMF_1017_BZ_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZAFT_ZGMF_1017_BZ_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZAFT_ZGMF_1017_BZ_EN})
setUnitMemory:ZAFT_ZGMF_1017_BZ_CDTimer=self.timeAlive+${ZAFT_ZGMF_1017_BZ_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZAFT_ZGMF_1017_BZ_CD}s
addActionCooldownApplyToActions:Manual_ZAFT_ZGMF_1017_BZ

[action_Manual_ZAFT_ZGMF_1017_SB_BF]
@copyFromSection:template_ManualWeapon
pos:3
text:Heavy blade strike
text_zh:重斩刀（重斩）
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZAFT_ZGMF_1017_SB_BF_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZAFT_ZGMF_1017_SB_BF_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false))))
alsoTriggerAction:ZAFT_ZGMF_1017_SB_BF_Fire

[hiddenAction_ZAFT_ZGMF_1017_SB_BF_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZAFT_ZGMF_1017_SB_BF_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZAFT_ZGMF_1017_SB_BF_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false)))))
setUnitMemory:ZAFT_ZGMF_1017_SB_BF_CDTimer=self.timeAlive+${ZAFT_ZGMF_1017_SB_BF_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
