[core]
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_Common_MortarDouble_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false and ${onSkill}==false and memory.close==false and self.resource.EN>${Common_MortarDouble_EN} and self.timeAlive>memory.Common_MortarDouble_CDTimer and self.resource.TileMode==0 and self.parent.hp<=0  and memory.Common_MortarDouble_AimTarget.hp>0 and memory.Common_MortarDouble_AimTarget.teamID>=0 and not memory.Common_MortarDouble_AimTarget.tags(includes='UnDetected') and distanceBetween(self, memory.Common_MortarDouble_AimTarget)>=300)

[hiddenAction_Common_MortarDouble_Fire_Step_4]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_MortarDouble_Fire_Step_5]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_Push_A_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60)

[hiddenAction_Common_Push_A_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_DoubleCannon_TFA_2_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and not (    memory.armLBreaked==true     and     memory.armRBreaked==true) and eventData("RandomWeapon",type="float")<=50)

[hiddenAction_Common_DoubleCannon_TFA_2_Fire_Step_3]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_DoubleCannon_TFA_2_Fire_Step_4]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZAFT_TFA_2_MG_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and memory.armRBreaked==false and eventData("RandomWeapon",type="float")>75)

[hiddenAction_ZAFT_TFA_2_MG_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZAFT_TFA_2_MG_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZAFT_TFA_2_DMG_L_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and memory.armLBreaked==false and eventData("RandomWeapon",type="float")>50 and eventData("RandomWeapon",type="float")<=75)

[hiddenAction_ZAFT_TFA_2_DMG_L_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZAFT_TFA_2_DMG_L_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[action_Transform_LandLand_TankB]
isVisible:if not memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=95 and memory.styleIndex!=100 and not self.hasTags(includes='inHangar'))

[action_ManualControl_Transform_LandLand_TankB]
@copyFromSection:action_Transform_LandLand_TankB
pos:80
autoTrigger:false
isVisible:if memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=95 and memory.styleIndex!=100 and not self.hasTags(includes='inHangar'))
requireConditional:if ${manualControlReady} and (true) and not memory.cantTransform and ${cantAction}==false and ${onSkill}==false

[action_Transform_LandLand_TankA]
isVisible:if not memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=0 and not self.hasTags(includes='inHangar'))

[action_ManualControl_Transform_LandLand_TankA]
@copyFromSection:action_Transform_LandLand_TankA
pos:80
autoTrigger:false
isVisible:if memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=0 and not self.hasTags(includes='inHangar'))
requireConditional:if ${manualControlReady} and (true) and not memory.cantTransform and ${cantAction}==false and ${onSkill}==false

[action_Common_MortarDouble_Trigger]
pos:30
requireConditional:if (true) and (not memory.manualControlEnabled or ${manualWeaponReady})

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff

[action_Manual_Common_Push_A]
@copyFromSection:template_ManualWeapon
pos:3
text:Punch
text_zh:徒手格斗
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((true))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((true)))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((true))
alsoTriggerAction:Common_Push_A_Fire

[hiddenAction_Common_Push_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((true)))
setUnitMemory:Common_Push_A_CDTimer=self.timeAlive+${Common_Push_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_Push_A_CD}s
addActionCooldownApplyToActions:Manual_Common_Push_A

[action_Manual_Common_DoubleCannon_TFA_2]
@copyFromSection:template_ManualWeapon
pos:4
text:Cannon
text_zh:火炮
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
isVisible:if ${manualControlReady} and ((((not ((memory.armLBreaked==true) and (memory.armRBreaked==true))))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_DoubleCannon_TFA_2_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((not ((memory.armLBreaked==true) and (memory.armRBreaked==true)))))) and self.resource.EN>=${Common_DoubleCannon_TFA_2_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_DoubleCannon_TFA_2_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((not ((memory.armLBreaked==true) and (memory.armRBreaked==true)))))) and self.resource.EN>=${Common_DoubleCannon_TFA_2_EN}
alsoTriggerAction:Common_DoubleCannon_TFA_2_Fire

[hiddenAction_Common_DoubleCannon_TFA_2_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_DoubleCannon_TFA_2_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_DoubleCannon_TFA_2_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((not ((memory.armLBreaked==true) and (memory.armRBreaked==true)))))) and self.resource.EN>=${Common_DoubleCannon_TFA_2_EN})
setUnitMemory:Common_DoubleCannon_TFA_2_CDTimer=self.timeAlive+${Common_DoubleCannon_TFA_2_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_DoubleCannon_TFA_2_CD}s
addActionCooldownApplyToActions:Manual_Common_DoubleCannon_TFA_2

[action_Manual_ZAFT_TFA_2_MG]
@copyFromSection:template_ManualWeapon
pos:2
text:Machine gun
text_zh:机枪
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/MachineGun_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZAFT_TFA_2_MG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${ZAFT_TFA_2_MG_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZAFT_TFA_2_MG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${ZAFT_TFA_2_MG_EN}
alsoTriggerAction:ZAFT_TFA_2_MG_Fire

[hiddenAction_ZAFT_TFA_2_MG_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZAFT_TFA_2_MG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZAFT_TFA_2_MG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${ZAFT_TFA_2_MG_EN})
setUnitMemory:ZAFT_TFA_2_MG_CDTimer=self.timeAlive+${ZAFT_TFA_2_MG_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZAFT_TFA_2_MG_CD}s
addActionCooldownApplyToActions:Manual_ZAFT_TFA_2_MG

[action_Manual_ZAFT_TFA_2_DMG_L]
@copyFromSection:template_ManualWeapon
pos:5
text:Machine gun (left)
text_zh:机枪（左）
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/MachineGun_1.png
isVisible:if ${manualControlReady} and ((((memory.armLBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZAFT_TFA_2_DMG_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armLBreaked==false)))) and self.resource.EN>=${ZAFT_TFA_2_DMG_L_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZAFT_TFA_2_DMG_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armLBreaked==false)))) and self.resource.EN>=${ZAFT_TFA_2_DMG_L_EN}
alsoTriggerAction:ZAFT_TFA_2_DMG_L_Fire

[hiddenAction_ZAFT_TFA_2_DMG_L_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZAFT_TFA_2_DMG_L_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZAFT_TFA_2_DMG_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armLBreaked==false)))) and self.resource.EN>=${ZAFT_TFA_2_DMG_L_EN})
setUnitMemory:ZAFT_TFA_2_DMG_L_CDTimer=self.timeAlive+${ZAFT_TFA_2_DMG_L_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZAFT_TFA_2_DMG_L_CD}s
addActionCooldownApplyToActions:Manual_ZAFT_TFA_2_DMG_L

[turret_Common_DoubleVulcan_MS_TFA_2]
canAttackCondition:if not memory.manualControlEnabled and (${cantAction}==false and distanceBetween(self,self.attacking)<=500 and memory.backpackBreaked==false and (    attacking.tags(includes='Aircraft')     or attacking.tags(includes='Tank')     or attacking.tags(includes='Pilot')     or memory.attackMode==1     or self.resource().en<=0))

[action_ManualAux_Common_DoubleVulcan_MS_TFA_2]
@copyFromSection:template_ManualWeapon
pos:40
text:Head Vulcan
text_zh:头部火神炮
description:Independent burst; primary weapons remain available.
description_zh:独立点射，可同时使用主武器。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Ciws_1.png
isVisible:if ${manualControlReady}
isLocked:if not ((${manualAuxiliaryReady} and not memory.headBreaked and not memory.Common_DoubleVulcan_MS_TFA_2_OnCD and self.resource.Common_DoubleVulcan_MS_TFA_2_ShootTimer>0) and ((${cantAction}==false) and (memory.backpackBreaked==false)))
requireConditional:if (${manualAuxiliaryReady} and not memory.headBreaked and not memory.Common_DoubleVulcan_MS_TFA_2_OnCD and self.resource.Common_DoubleVulcan_MS_TFA_2_ShootTimer>0) and ((${cantAction}==false) and (memory.backpackBreaked==false))
alsoTriggerAction:ManualAux_Common_DoubleVulcan_MS_TFA_2_Fire

[hiddenAction_ManualAux_Common_DoubleVulcan_MS_TFA_2_Fire]
requireConditional:if (${manualAuxiliaryReady} and not memory.headBreaked and not memory.Common_DoubleVulcan_MS_TFA_2_OnCD and self.resource.Common_DoubleVulcan_MS_TFA_2_ShootTimer>0) and ((${cantAction}==false) and (memory.backpackBreaked==false))
setUnitMemory:manualVulcanRightNext=false,manualVulcanSerial=memory.manualVulcanSerial+1,Common_DoubleVulcan_MS_TFA_2_OnCD=true,Common_DoubleVulcan_MS_TFA_2_CDTimer=self.timeAlive+${Common_DoubleVulcan_MS_TFA_2_CD}+self.resource.Common_DoubleVulcan_MS_TFA_2_ShootTimer*0.075
spawnUnits:ManualAuxBurst_SEED_Common_DoubleVulcan_MS_TFA_2

[hiddenAction_ManualAux_Common_DoubleVulcan_MS_TFA_2_Shot]
autoTriggerOnEvent:newMessage(withTag='ManualAuxShot_Common_DoubleVulcan_MS_TFA_2')
requireConditional:if (${manualAuxiliaryReady} and eventData('burstSerial',type='float')==memory.manualVulcanSerial  and not memory.headBreaked and self.resource.Common_DoubleVulcan_MS_TFA_2_ShootTimer>0) and ((${cantAction}==false) and (memory.backpackBreaked==false))
alsoTriggerAction:ManualAux_Common_DoubleVulcan_MS_TFA_2_Left,ManualAux_Common_DoubleVulcan_MS_TFA_2_Right,ManualAux_Common_DoubleVulcan_MS_TFA_2_Spend

[turret_ManualAux_Common_DoubleVulcan_MS_TFA_2_Left]
@copyFromSection:turret_Common_DoubleVulcan_MS_TFA_2
canShoot:false
barrelX:-3.0
barrelOffsetX_onOddShots:0

[hiddenAction_ManualAux_Common_DoubleVulcan_MS_TFA_2_Left]
requireConditional:if not memory.manualVulcanRightNext
fireTurretXAtGround:ManualAux_Common_DoubleVulcan_MS_TFA_2_Left
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[turret_ManualAux_Common_DoubleVulcan_MS_TFA_2_Right]
@copyFromSection:turret_Common_DoubleVulcan_MS_TFA_2
canShoot:false
barrelX:3.0
barrelOffsetX_onOddShots:0

[hiddenAction_ManualAux_Common_DoubleVulcan_MS_TFA_2_Right]
requireConditional:if memory.manualVulcanRightNext
fireTurretXAtGround:ManualAux_Common_DoubleVulcan_MS_TFA_2_Right
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_ManualAux_Common_DoubleVulcan_MS_TFA_2_Spend]
setUnitMemory:manualVulcanRightNext=not memory.manualVulcanRightNext
addResources:Common_DoubleVulcan_MS_TFA_2_ShootTimer=-1

[hiddenAction_TryAttack]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_AttackMode_Cqb_WhenHasTarget]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_LowPartsForceCqbMode]
requireConditional:if not memory.manualControlEnabled and (memory.attackMode==0 and memory.armLBreaked==true and memory.armRBreaked==true)

[hiddenAction_ResetTargetTags_Step2]
alsoTriggerAction:ManualControl_AfterTransform,ManualControl_RestoreGuard

[action_ChangeAttackRuleMode_Free]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==0 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Guard]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==1 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Hold]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==2 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Shoot]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==0 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Cqb]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==1 and not self.hasTags(includes='inHangar'))

[action_AllowAIOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAI}==false and not self.hasTags(includes='inHangar'))

[action_AllowAssignedOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAssigned}==false and not self.hasTags(includes='inHangar'))
