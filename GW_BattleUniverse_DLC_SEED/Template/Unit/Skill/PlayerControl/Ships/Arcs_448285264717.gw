[core]
dont_load:true

[template_ManualShip_ArcLine]
layer:shadow
order:0
onlyTeam:own
onlyWhenSelectedByOwnPlayer:true
onlyOnNonPreview:true
onlyWhileAlive:true
lineWidth:1

[template_ManualShip_Arc_TMF_A_802_Turret_M1_turret_TMF_A_802_Turret_Railgun]
@copyFromSection:template_ManualShip_ArcLine
color:#E6D28C
isVisible:if ${manualControlReady} and memory.hideUI==0 and memory.manualShipArcGroup==0 and self.attachment(slot='TMF_A_802_Turret_M1').hp>0 and not self.attachment(slot='TMF_A_802_Turret_M1').readUnitMemory('breaked',type='bool')
alpha:select(not self.attachment(slot='TMF_A_802_Turret_M1').readUnitMemory('TMF_A_802_Turret_Railgun_OnCD',type='bool') and self.attachment(slot='TMF_A_802_Turret_M1').resource.TMF_A_802_Turret_Railgun_ShootTimer>0,0.55,0.15)

[decal_ManualShip_Arc_TMF_A_802_Turret_M1_turret_TMF_A_802_Turret_Railgun_0]
@copyFromSection:template_ManualShip_Arc_TMF_A_802_Turret_M1_turret_TMF_A_802_Turret_Railgun
basePosition:self.attachment(slot='TMF_A_802_Turret_M1')
drawLineTo:self.getOffsetRelative(x=-600.0000,y=-18.0000)

