[core]
dont_load:false

copyFrom:"""
ROOT:Template/Unit/Skill/SupplyPoint.gw
"""

[hiddenAction_Supply_Active]
setUnitMemory:"""
supplyPointActive=select
(
    self.resource.en<=0,
    false,
    select(memory.pilotUnit.hp>0 and self.speed<=0.25,true,false)
)
"""

[hiddenAction_Supply_Unit]
requireConditional:if self.resource.EN>0

[hiddenAction_Supply_Unit_HP]
requireConditional:"""
if not thisActionTarget.tags(includes='inBattle') and thisActionTarget.parent!=self and thisActionTarget!=self and thisActionTarget.parent.parent!=self 
and distanceBetween(self, thisActionTarget)<=memory.supplyPointRange 
and thisActionTarget.hp<thisActionTarget.maxHp 
and thisActionTarget.hp>0
"""
setResourcesWithLogic:"""
EN=self.resource.EN-
(
    select(thisActionTarget.hp<thisActionTarget.maxHp,thisActionTarget.maxHp,0)*0.01
)*0.01
"""

[hiddenAction_Supply_Unit_EN]
requireConditional:"""
if thisActionTarget.parent!=self and thisActionTarget!=self and thisActionTarget.parent.parent!=self 
and distanceBetween(self, thisActionTarget)<=memory.supplyPointRange 
and self.resource.EN*0.95>thisActionTarget.resource.EN 
and thisActionTarget.hp>0
"""
setResourcesWithLogic:"""
EN=self.resource.EN-
(
    select(thisActionTarget.resource.EN<thisActionTarget.readUnitMemory("enMax",type="float"),thisActionTarget.readUnitMemory("enMax",type="float"),0)*0.01
)*0.01
"""