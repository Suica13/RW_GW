[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory AMS_119:bool


[hiddenAction_Pannel_Close_AMS_119]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:AMS_119=false




[hiddenAction_AutoProduce_AMS_119]
@copyFromSection:template_AutoProduce
@define UnitID=AMS_119
alsoTriggerAction:AutoProduce_AMS_119_Step2

[hiddenAction_AutoProduce_AMS_119_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3650
@define Resource=4700
alsoTriggerAction:AutoProduce_AMS_119_Random



[hiddenAction_AutoProduce_AMS_119_Random]
alsoTriggerAction:"""
AutoProduce_AMS_119_Random_A,
AutoProduce_AMS_119_Random_B,
AutoProduce_AMS_119_Random_C
"""
[hiddenAction_AutoProduce_AMS_119_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_AMS_119_StandardSquad

[hiddenAction_AutoProduce_AMS_119_Random_B]
requireConditional:if memory.randomProduce>500 and memory.randomProduce<=850
alsoQueueAction:Produce_AMS_119_StandardSquad

[hiddenAction_AutoProduce_AMS_119_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_AMS_119_StandardSquad





