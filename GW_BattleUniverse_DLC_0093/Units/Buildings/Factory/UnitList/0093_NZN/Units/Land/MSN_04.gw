[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory MSN_04:bool


[hiddenAction_Pannel_Close_MSN_04]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MSN_04=false




[hiddenAction_AutoProduce_MSN_04]
@copyFromSection:template_AutoProduce
@define UnitID=MSN_04
alsoTriggerAction:AutoProduce_MSN_04_Step2

[hiddenAction_AutoProduce_MSN_04_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3650
@define Resource=4700
alsoTriggerAction:AutoProduce_MSN_04_Random



[hiddenAction_AutoProduce_MSN_04_Random]
alsoTriggerAction:"""
AutoProduce_MSN_04_Random_A,
AutoProduce_MSN_04_Random_B,
AutoProduce_MSN_04_Random_C
"""
[hiddenAction_AutoProduce_MSN_04_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MSN_04_StandardSquad

[hiddenAction_AutoProduce_MSN_04_Random_B]
requireConditional:if memory.randomProduce>500 and memory.randomProduce<=850
alsoQueueAction:Produce_MSN_04_MGSquad

[hiddenAction_AutoProduce_MSN_04_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_MSN_04_BazookaSquad





[action_Pannel_MSN_04]
@copyFromSection:template_Pannel
@define UnitID=MSN_04
@define FactionVisible= (memory.Pannel_0093_NZN_DontShow==false)

[action_Produce_MSN_04_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MSN_04
@define Money=3650
@define Resource=4700
@define FactionVisible= (memory.Pannel_0093_NZN_DontShow==false)
buildSpeed:50s

alsoQueueAction:"""
Produce_MSN_04_StandardSquad_1,
Produce_MSN_04_StandardSquad_2,
Produce_MSN_04_StandardSquad_3
"""
[hiddenAction_Produce_MSN_04_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MSN_04*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MSN_04_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MSN_04*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MSN_04_StandardSquad_3]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MSN_04*1(addResources=PilotType:1101|EquipmentIndex:0)
"""

