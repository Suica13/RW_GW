[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGM_89:bool


[hiddenAction_Pannel_Close_RGM_89]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGM_89=false




[hiddenAction_AutoProduce_RGM_89]
@copyFromSection:template_AutoProduce
@define UnitID=RGM_89
alsoTriggerAction:AutoProduce_RGM_89_Step2

[hiddenAction_AutoProduce_RGM_89_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3650
@define Resource=4700
alsoTriggerAction:AutoProduce_RGM_89_Random



[hiddenAction_AutoProduce_RGM_89_Random]
alsoTriggerAction:"""
AutoProduce_RGM_89_Random_A,
AutoProduce_RGM_89_Random_B,
AutoProduce_RGM_89_Random_C
"""
[hiddenAction_AutoProduce_RGM_89_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RGM_89_StandardSquad

[hiddenAction_AutoProduce_RGM_89_Random_B]
requireConditional:if memory.randomProduce>500 and memory.randomProduce<=850
alsoQueueAction:Produce_RGM_89_BazookaSquad

[hiddenAction_AutoProduce_RGM_89_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_RGM_89_BazookaSquad





[action_Pannel_RGM_89]
@copyFromSection:template_Pannel
@define UnitID=RGM_89
@define FactionVisible= (memory.Pannel_0093_EFSF_DontShow==false)

[action_Produce_RGM_89_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=RGM_89
@define Money=3650
@define Resource=4700
@define FactionVisible= (memory.Pannel_0093_EFSF_DontShow==false)
buildSpeed:50s

alsoQueueAction:"""
Produce_RGM_89_StandardSquad_1,
Produce_RGM_89_StandardSquad_2,
Produce_RGM_89_StandardSquad_3
"""
[hiddenAction_Produce_RGM_89_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RGM_89*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RGM_89_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RGM_89*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RGM_89_StandardSquad_3]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RGM_89*1(addResources=PilotType:1101|EquipmentIndex:0)
"""

[action_Produce_RGM_89_MGSquad]
