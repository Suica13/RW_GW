@define Money=3650
@define Resource=4700
alsoTriggerAction:AutoProduce_RX_93_Random



[hiddenAction_AutoProduce_RX_93_Random]
alsoTriggerAction:"""
AutoProduce_RX_93_Random_A,
AutoProduce_RX_93_Random_B,
AutoProduce_RX_93_Random_C
"""
[hiddenAction_AutoProduce_RX_93_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
