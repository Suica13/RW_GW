[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGZ_91:bool


[hiddenAction_Pannel_Close_RGZ_91]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGZ_91=false




[hiddenAction_AutoProduce_RGZ_91]
@copyFromSection:template_AutoProduce
@define UnitID=RGZ_91
alsoTriggerAction:AutoProduce_RGZ_91_Step2

[hiddenAction_AutoProduce_RGZ_91_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3650
@define Resource=4700
alsoTriggerAction:AutoProduce_RGZ_91_Random



[hiddenAction_AutoProduce_RGZ_91_Random]
alsoTriggerAction:"""
AutoProduce_RGZ_91_Random_A,
AutoProduce_RGZ_91_Random_B,
AutoProduce_RGZ_91_Random_C
"""
[hiddenAction_AutoProduce_RGZ_91_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RGZ_91_StandardSquad

[hiddenAction_AutoProduce_RGZ_91_Random_B]
requireConditional:if memory.randomProduce>500 and memory.randomProduce<=850
alsoQueueAction:Produce_RGZ_91_StandardSquad

[hiddenAction_AutoProduce_RGZ_91_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_RGZ_91_StandardSquad





