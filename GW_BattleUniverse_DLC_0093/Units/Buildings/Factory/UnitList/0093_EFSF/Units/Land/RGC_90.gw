[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGC_90:bool


[hiddenAction_Pannel_Close_RGC_90]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGC_90=false




[hiddenAction_AutoProduce_RGC_90]
@copyFromSection:template_AutoProduce
@define UnitID=RGC_90
alsoTriggerAction:AutoProduce_RGC_90_Step2

[hiddenAction_AutoProduce_RGC_90_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3650
@define Resource=4700
alsoTriggerAction:AutoProduce_RGC_90_Random



[hiddenAction_AutoProduce_RGC_90_Random]
alsoTriggerAction:"""
AutoProduce_RGC_90_Random_A,
AutoProduce_RGC_90_Random_B,
AutoProduce_RGC_90_Random_C
"""
[hiddenAction_AutoProduce_RGC_90_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RGC_90_StandardSquad

[hiddenAction_AutoProduce_RGC_90_Random_B]
requireConditional:if memory.randomProduce>500 and memory.randomProduce<=850
alsoQueueAction:Produce_RGC_90_MGSquad

[hiddenAction_AutoProduce_RGC_90_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_RGC_90_BazookaSquad





[action_Pannel_RGC_90]
@copyFromSection:template_Pannel
@define UnitID=RGC_90
@define FactionVisible= (memory.Pannel_0093_EFSF_DontShow==false)

[action_Produce_RGC_90_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=RGC_90
@define Money=3650
@define Resource=4700
@define FactionVisible= (memory.Pannel_0093_EFSF_DontShow==false)
buildSpeed:50s

alsoQueueAction:"""
Produce_RGC_90_StandardSquad_1,
Produce_RGC_90_StandardSquad_2,
Produce_RGC_90_StandardSquad_3
"""
[hiddenAction_Produce_RGC_90_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RGC_90*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RGC_90_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RGC_90*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
