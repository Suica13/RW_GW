[core]
@global manualControlImplemented=true
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw
dont_load:true

# Form-specific input adapters. Native damage, animations and firing queues are inherited.

[action_Manual_EF_RGM_89_BR]
@copyFromSection:template_ManualWeapon
pos:2
text:Beam rifle
text_zh:光束步枪
description:CD: ${EF_RGM_89_BR_CD}s
description_zh:冷却: ${EF_RGM_89_BR_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady} and self.resource().EquipmentIndex==0
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.EF_RGM_89_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and self.resource.EN>0) and (self.resource().EquipmentIndex==0 and memory.armRBreaked==false) and self.resource.EN>=${EF_RGM_89_BR_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.EF_RGM_89_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and self.resource.EN>0) and (self.resource().EquipmentIndex==0 and memory.armRBreaked==false) and self.resource.EN>=${EF_RGM_89_BR_EN}
alsoTriggerAction:EF_RGM_89_BR_Fire
displayType:action

[hiddenAction_EF_RGM_89_BR_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_RGM_89_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.EF_RGM_89_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and self.resource.EN>0) and (self.resource().EquipmentIndex==0 and memory.armRBreaked==false) and self.resource.EN>=${EF_RGM_89_BR_EN})
addActionCooldownTime:${EF_RGM_89_BR_CD}s
addActionCooldownApplyToActions:Manual_EF_RGM_89_BR
setUnitMemory:EF_RGM_89_BR_CDTimer=self.timeAlive+${EF_RGM_89_BR_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[action_Manual_EF_GMRifle]
@copyFromSection:template_ManualWeapon
pos:2
text:GM rifle
text_zh:吉姆步枪
description:CD: ${EF_GMRifle_CD}s
description_zh:冷却: ${EF_GMRifle_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/MachineGun_1.png
isVisible:if ${manualControlReady} and self.resource().EquipmentIndex==1
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.EF_GMRifle_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0) and (self.resource().EquipmentIndex==1 and memory.armRBreaked==false) and self.resource.EN>=${EF_GMRifle_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.EF_GMRifle_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0) and (self.resource().EquipmentIndex==1 and memory.armRBreaked==false) and self.resource.EN>=${EF_GMRifle_EN}
alsoTriggerAction:EF_GMRifle_Fire
displayType:action

[hiddenAction_EF_GMRifle_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_GMRifle_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.EF_GMRifle_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0) and (self.resource().EquipmentIndex==1 and memory.armRBreaked==false) and self.resource.EN>=${EF_GMRifle_EN})
addActionCooldownTime:${EF_GMRifle_CD}s
addActionCooldownApplyToActions:Manual_EF_GMRifle
setUnitMemory:EF_GMRifle_CDTimer=self.timeAlive+${EF_GMRifle_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

