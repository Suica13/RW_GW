alsoTriggerAction:EF_RGM_89_BZ_Fire
displayType:action

[hiddenAction_EF_RGM_89_BZ_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_RGM_89_BZ_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.EF_RGM_89_BZ_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and ${onSkill}==false and self.resource.EN>0) and ((self.resource().EquipmentIndex==1 or self.resource().EquipmentIndex==2)) and self.resource.EN>=${EF_RGM_89_BZ_EN})
addActionCooldownTime:${EF_RGM_89_BZ_CD}s
addActionCooldownApplyToActions:Manual_EF_RGM_89_BZ
setUnitMemory:EF_RGM_89_BZ_CDTimer=self.timeAlive+${EF_RGM_89_BZ_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

