isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.EF_RGM_89_BZ_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and ${onSkill}==false and self.resource.EN>0) and ((self.resource().EquipmentIndex==1 or self.resource().EquipmentIndex==2)) and self.resource.EN>=${EF_RGM_89_BZ_EN})
