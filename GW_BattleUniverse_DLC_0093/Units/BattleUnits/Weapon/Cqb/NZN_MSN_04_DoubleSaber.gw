[core]
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Cqb/Common/Cqb_Fire_1_Yellow_R.gw,
ROOT:Resource/Image/Fx/Weapon/Cqb/Common/Cqb_Fire_1_Yellow_L.gw,
ROOT:Resource/Image/Fx/Weapon/Cqb/Common/Cqb_Fire_2_Yellow_R.gw,
ROOT:Resource/Image/Fx/Weapon/Cqb/Common/Cqb_Fire_2_Yellow_L.gw,
ROOT:Template/Unit/Animation/Cqb/Common_Melee_Double_B.gw,
ROOT:Template/Unit/Animation/Cqb/Common_Melee_Double_F.gw
"""
dont_load:false
@memory NZN_MSN_04_DoubleSaber_CDTimer:float
@global NZN_MSN_04_DoubleSaber_CD=3.5


#====================贴画====================#



[decal_NZN_MSN_04_DoubleSaber]
layer:beforeBody
order:5.4
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Weapon/Cqb/Image/NZN_MSN_04_Saber.png
isVisible:false
basePositionFromLegEnd:arm11
total_frames:1
frame:0
imageScale:0.85
xOffsetRelative:6
yOffsetRelative:22
dirOffset:-16



[decal_NZN_MSN_04_DoubleSaber_L]
@copyFromSection:decal_NZN_MSN_04_DoubleSaber
basePositionFromLegEnd:arm10
imageScale:0.85
imageScaleX:-1
xOffsetRelative:-6
yOffsetRelative:22
dirOffset:16

#========炮弹========#



[turret_NZN_MSN_04_DoubleSaber]
x:0
y:0
invisible:true
#射击参数
canShoot:false
showRangeUIGuide:false
projectile:NZN_MSN_04_DoubleSaber_DB_Projectile
#实战参数
delay:3s
limitingMinRange:0
limitingRange:0
#枪管参数
canAttackMaxAngle:60
barrelX:0
barrelY:0
#后座力参数
aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0
#音效参数
shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamSaber_1.ogg
shoot_sound_vol:0.5



[projectile_NZN_MSN_04_DoubleSaber_DB_Projectile]
directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0
#描画参数
lightSize:0.75
lightColor:#ff57e9
explodeEffect:none
#生成
spawnUnit:"""
Projectile_Saber_A*1
(
    addResources=
    CqbDamage:3250
    |CqbBeamDamage:3250
    |DpDamage:750
    |WeaponAccuracy:125
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightHitRange:35
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileLife:0.25
    |ProjectileAttackTimes:2
)
"""



[projectile_NZN_MSN_04_DoubleSaber_DB_L_Projectile]
@copyFromSection:projectile_NZN_MSN_04_DoubleSaber_DB_Projectile
spawnUnit:"""
Projectile_Saber_A_L*1
(
    addResources=
    CqbDamage:3250
    |CqbBeamDamage:3250
    |DpDamage:750
    |WeaponAccuracy:125
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightHitRange:35
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileLife:0.25
    |ProjectileAttackTimes:2
)
"""



[projectile_NZN_MSN_04_DoubleSaber_DF_Projectile]
@copyFromSection:projectile_NZN_MSN_04_DoubleSaber_DB_Projectile
spawnUnit:"""
Projectile_Saber_A*1
(
    addResources=
    CqbDamage:3250
    |CqbBeamDamage:3250
    |DpDamage:750
    |WeaponAccuracy:125
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightHitRange:35
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileLife:0.25
    |ProjectileAttackTimes:2
)
"""



[projectile_NZN_MSN_04_DoubleSaber_DF_L_Projectile]
@copyFromSection:projectile_NZN_MSN_04_DoubleSaber_DB_Projectile
spawnUnit:"""
Projectile_Saber_A_L*1
(
    addResources=
    CqbDamage:3250
    |CqbBeamDamage:3250
    |DpDamage:750
    |WeaponAccuracy:125
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightHitRange:35
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileLife:0.25
    |ProjectileAttackTimes:2
)
"""



[hiddenAction_NZN_MSN_04_DoubleSaber_Trigger]
alsoTriggerAction:NZN_MSN_04_DoubleSaber_Fire



[hiddenAction_NZN_MSN_04_DoubleSaber_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_MSN_04_DoubleSaber_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and memory.armLBreaked==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) 
and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50
"""
setUnitMemory:NZN_MSN_04_DoubleSaber_CDTimer=self.timeAlive+${NZN_MSN_04_DoubleSaber_CD}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Cqb,
NZN_MSN_04_DoubleSaber_DB_SetWeaponIndex,
PlayCommon_Melee_Double_B_Step_1,
NZN_MSN_04_DoubleSaber_Step_1
"""



[hiddenAction_NZN_MSN_04_DoubleSaber_Step_1]
alsoQueueAction:"""
NZN_MSN_04_DoubleSaber_Fire_Step_1,
NZN_MSN_04_DoubleSaber_Fire_Step_2,
NZN_MSN_04_DoubleSaber_Fire_Step_3,
NZN_MSN_04_DoubleSaber_Fire_Step_4,
NZN_MSN_04_DoubleSaber_Fire_Step_5,
NZN_MSN_04_DoubleSaber_Fire_Step_6,
NZN_MSN_04_DoubleSaber_Fire_Step_7,
NZN_MSN_04_DoubleSaber_Fire_Step_Final
"""

#设置武器



[hiddenAction_NZN_MSN_04_DoubleSaber_DB_SetWeaponIndex]
isVisible:false



[hiddenAction_NZN_MSN_04_DoubleSaber_DF_SetWeaponIndex]
isVisible:false

#格斗A



[hiddenAction_NZN_MSN_04_DoubleSaber_Fire_Step_1]
requireConditional:if ${cantAction}==false and memory.armRBreaked==false and memory.armLBreaked==false
buildSpeed:0.6s



[hiddenAction_NZN_MSN_04_DoubleSaber_Fire_Step_2]
requireConditional:if ${cantAction}==false and memory.armRBreaked==false and memory.armLBreaked==false and memory.armRBreaked==false
buildSpeed:0s
fireTurretXAtGround:NZN_MSN_04_DoubleSaber
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_2_Yellow_R



[hiddenAction_NZN_MSN_04_DoubleSaber_Fire_Step_3]
requireConditional:if ${cantAction}==false and memory.armRBreaked==false and memory.armLBreaked==false and memory.armLBreaked==false
buildSpeed:0s
fireTurretXAtGround:NZN_MSN_04_DoubleSaber
fireTurretXAtGround_withProjectile:NZN_MSN_04_DoubleSaber_DB_L_Projectile
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_2_Yellow_L



[hiddenAction_NZN_MSN_04_DoubleSaber_Fire_Step_4]
buildSpeed:0.4s
alsoTriggerAction:PlayCommon_Melee_Double_F_Step_1



[hiddenAction_NZN_MSN_04_DoubleSaber_Fire_Step_5]
buildSpeed:0.3s



[hiddenAction_NZN_MSN_04_DoubleSaber_Fire_Step_6]
requireConditional:if ${cantAction}==false and memory.armRBreaked==false and memory.armLBreaked==false and memory.armRBreaked==false
buildSpeed:0s
fireTurretXAtGround:NZN_MSN_04_DoubleSaber
fireTurretXAtGround_withProjectile:NZN_MSN_04_DoubleSaber_DF_Projectile
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_1_Yellow_R



[hiddenAction_NZN_MSN_04_DoubleSaber_Fire_Step_7]
requireConditional:if ${cantAction}==false and memory.armRBreaked==false and memory.armLBreaked==false and memory.armLBreaked==false
buildSpeed:0s
fireTurretXAtGround:NZN_MSN_04_DoubleSaber
fireTurretXAtGround_withProjectile:NZN_MSN_04_DoubleSaber_DF_L_Projectile
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_1_Yellow_L



[hiddenAction_NZN_MSN_04_DoubleSaber_Fire_Step_Final]
buildSpeed:1.0s
alsoTriggerAction:SetAttackingOff
