[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Cqb/Common_Melee_B_L.gw
"""

@memory NZN_AMS_119_SeaSerpent_CDTimer:float
@global NZN_AMS_119_SeaSerpent_CD=5


@memory NZN_AMS_119_SeaSerpent_Unit:unit

[hiddenAction_Get_Spawn_NZN_AMS_119_SeaSerpent]
autoTriggerOnEvent:newMessage(withTag="RodSpawn_NZN_AMS_119_SeaSerpent")
setUnitMemory:NZN_AMS_119_SeaSerpent_Unit=eventData("unitInfo",type="unit")




[decal_DrawLineTo_NZN_AMS_119_SeaSerpent_Unit]
layer:beforeBody
order:4.5
alpha:1
basePositionFromLegEnd:arm3
drawLineTo:memory.NZN_AMS_119_SeaSerpent_Unit
color:#333333
imageScale:1
lineWidth:5
xOffsetRelative: 6
yOffsetRelative: 6
onlyOnNonPreview:true
isVisible:if memory.NZN_AMS_119_SeaSerpent_Unit.hp>0
onlyWhileAlive:true








[turret_NZN_AMS_119_SeaSerpent]
x:0
y:0

canShoot:false
projectile:NZN_AMS_119_SeaSerpent_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:-11
barrelY:17
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/Fist_2.ogg
shoot_sound_vol:0.5



[projectile_NZN_AMS_119_SeaSerpent_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_NZN_AMS_119_SeaSerpent*1
(
    addResources=
    CqbDamage:4500
    |DpDamage:750
    |StunDamage=3
    |SpeedDownDamage=3
    |WeaponAccuracy=85
    |PartBreakModifier=3
    |CockpitBreakModifier=100
    |PilotDamageModifier=0.25
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:1
    |ProjectileLife:8
)
"""








[hiddenAction_NZN_AMS_119_SeaSerpent_Trigger]
alsoTriggerAction:NZN_AMS_119_SeaSerpent_Fire
[hiddenAction_NZN_AMS_119_SeaSerpent_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_AMS_119_SeaSerpent_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armLBreaked==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)
"""
setUnitMemory:NZN_AMS_119_SeaSerpent_CDTimer=self.timeAlive+${NZN_AMS_119_SeaSerpent_CD}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
NZN_AMS_119_SeaSerpent_SetWeaponIndex,
PlayCommon_Melee_B_L_Step_1,
NZN_AMS_119_SeaSerpent_B1_Step_1
"""
[hiddenAction_NZN_AMS_119_SeaSerpent_B1_Step_1]
alsoQueueAction:"""
NZN_AMS_119_SeaSerpent_Fire_Step_1,
NZN_AMS_119_SeaSerpent_Fire_Step_2,
NZN_AMS_119_SeaSerpent_Fire_Step_Final
"""




[hiddenAction_NZN_AMS_119_SeaSerpent_SetWeaponIndex]
isVisible:false


[hiddenAction_NZN_AMS_119_SeaSerpent_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false 
"""
buildSpeed:0.5s
[hiddenAction_NZN_AMS_119_SeaSerpent_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false 
"""
buildSpeed:0s
fireTurretXAtGround:NZN_AMS_119_SeaSerpent
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_NZN_AMS_119_SeaSerpent_Fire_Step_Final]
buildSpeed:0.5s
alsoTriggerAction:SetAttackingOff


