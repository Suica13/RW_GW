[core]
copyFrom:ROOT:Units/BattleUnits/Weapon/Cqb/EF_RX_93_BeamSaber_BF.gw
dont_load:true

# V5-style button; BU damage, EN, cooldown and firing steps are inherited.
[action_Manual_EF_RX_93_BeamSaber_BF]
@copyFromSection:template_ManualWeapon
pos:11
text:Beam saber
text_zh:光束军刀
description:CD: ${EF_RX_93_BeamSaber_BF_CD}s
description_zh:冷却: ${EF_RX_93_BeamSaber_BF_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
requireConditional:if ${manualWeaponReady} and not memory.armRBreaked and self.timeAlive>memory.EF_RX_93_BeamSaber_BF_CDTimer
isLocked:if not (${manualWeaponReady} and not memory.armRBreaked)
isLockedAlt2:if self.timeAlive<=memory.EF_RX_93_BeamSaber_BF_CDTimer
isLockedAlt2Message:Weapon cooling down
isLockedAlt2Message_zh:武器冷却中
alsoTriggerAction:EF_RX_93_BeamSaber_BF_Fire
displayType:action

[hiddenAction_EF_RX_93_BeamSaber_BF_Fire]
requireConditional:if self.timeAlive>memory.EF_RX_93_BeamSaber_BF_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and (memory.manualControlEnabled or not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)) and (memory.manualControlEnabled or max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive'))) and self.timeAlive>memory.manualInputBusyUntil
addActionCooldownTime:${EF_RX_93_BeamSaber_BF_CD}s
addActionCooldownApplyToActions:Manual_EF_RX_93_BeamSaber_BF
setUnitMemory:EF_RX_93_BeamSaber_BF_CDTimer=self.timeAlive+${EF_RX_93_BeamSaber_BF_CD},manualInputBusyUntil=self.timeAlive+0.15

[hiddenAction_EF_RX_93_BeamSaber_BF_Fire_Step_2]
requireConditional:if ${cantAction}==false and memory.armRBreaked==false and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_RX_93_BeamSaber_BF_Fire_Step_5]
requireConditional:if ${cantAction}==false and memory.armRBreaked==false and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))
