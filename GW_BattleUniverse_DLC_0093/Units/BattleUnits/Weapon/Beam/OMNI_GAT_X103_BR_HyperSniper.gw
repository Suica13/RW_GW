[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Resource/Image/Fx/Common/Common_Flash_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_Two_Handed_A.gw
"""

@memory OMNI_GAT_X103_BR_HyperSniper_CDTimer:float
@global OMNI_GAT_X103_BR_HyperSniper_CD=12
@global OMNI_GAT_X103_BR_HyperSniper_EN=75




[decal_OMNI_GAT_X103_HyperSniper_RailGun]
layer:beforeBody
order:4.4
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\OMNI_GAT_X103_RailGun.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.75
imageScaleX:1
xOffsetRelative: 3
yOffsetRelative: -7
dirOffset:0

[decal_OMNI_GAT_X103_HyperSniper_BR]
layer:beforeBody
order:4.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Beam\Image\OMNI_GAT_X103_BR.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.75
imageScaleX:1
xOffsetRelative: 1.5
yOffsetRelative: 20
dirOffset:0





[turret_OMNI_GAT_X103_BR_HyperSniper]
x:0
y:0

canShoot:false
projectile:OMNI_GAT_X103_BR_HyperSniper_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:11
barrelY:40
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCannon_1.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Yellow





[projectile_OMNI_GAT_X103_BR_HyperSniper_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
explodeEffect:none

spawnUnit:"""
Projectile_AP_BeamRifle_Yellow*1
(
    addResources=
    BeamDamage:10000
    |BeamAPDamage:2000
    |DpDamage:300
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1 
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1 
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=3
    |HeightHitRange=25
    |ProjectileSpeed:150
    |ProjectileSpread:1
    |ProjectileLife:30

    |ProjectileAttackTimes:3
    |ProjectileAttackTimesDamageModifier:0.75
),

Projectile_BeamSniper_Yellow_Effect*1
(
    addResources=
    ProjectileSpeed:0.75
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""





[hiddenAction_OMNI_GAT_X103_BR_HyperSniper_Trigger]
alsoTriggerAction:OMNI_GAT_X103_BR_HyperSniper_Fire
[hiddenAction_OMNI_GAT_X103_BR_HyperSniper_Fire]
requireConditional:"""
if self.timeAlive>memory.OMNI_GAT_X103_BR_HyperSniper_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:OMNI_GAT_X103_BR_HyperSniper_CDTimer=self.timeAlive+${OMNI_GAT_X103_BR_HyperSniper_CD}
addResources:EN=-${OMNI_GAT_X103_BR_HyperSniper_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
OMNI_GAT_X103_BR_HyperSniper_SetWeaponIndex,
PlayCommon_Shoot_Two_Handed_A_Step_1,
OMNI_GAT_X103_BR_HyperSniper_B1_Step_1
"""
[hiddenAction_OMNI_GAT_X103_BR_HyperSniper_B1_Step_1]
alsoQueueAction:"""
OMNI_GAT_X103_BR_HyperSniper_Fire_Step_1,
OMNI_GAT_X103_BR_HyperSniper_Fire_Step_2,
OMNI_GAT_X103_BR_HyperSniper_Fire_Step_Final
"""



[hiddenAction_OMNI_GAT_X103_BR_HyperSniper_SetWeaponIndex]
isVisible:false


[hiddenAction_OMNI_GAT_X103_BR_HyperSniper_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false
"""
buildSpeed:0.35s
whenBuilding_cannotMove:true
alsoTriggerAction:PlayCommon_Cannon_Shoot_A_Step_1
[hiddenAction_OMNI_GAT_X103_BR_HyperSniper_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false
"""
buildSpeed:0.25s
whenBuilding_cannotMove:true
fireTurretXAtGround:OMNI_GAT_X103_BR_HyperSniper
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_OMNI_GAT_X103_BR_HyperSniper_Fire_Step_Final]
buildSpeed:1.25s
whenBuilding_cannotMove:true
alsoTriggerAction:SetAttackingOff
