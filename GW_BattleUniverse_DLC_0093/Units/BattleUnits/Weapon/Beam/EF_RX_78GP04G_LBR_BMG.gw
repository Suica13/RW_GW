[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory EF_RX_78GP04G_LBR_BMG_CDTimer:float
@global EF_RX_78GP04G_LBR_BMG_CD=3.5
@global EF_RX_78GP04G_LBR_BMG_EN=50









[turret_EF_RX_78GP04G_LBR_BMG]
x:0
y:0

canShoot:false
projectile:EF_RX_78GP04G_LBR_BMG_Projectile

delay:0.1s
canAttackMaxAngle:15
barrelX:10
barrelY:30
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource/Sound/SE/Weapon/Fire/BeamGun_2.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Fire_1_Pink_S



[projectile_EF_RX_78GP04G_LBR_BMG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Pink*1
(
    addResources=
    BeamDamage:2000
    |DpDamage:50
    |WeaponAccuracy=95
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:80
    |ProjectileSpread:3
    |ProjectileLife:25
)
"""





[hiddenAction_EF_RX_78GP04G_LBR_BMG_Trigger]
alsoTriggerAction:EF_RX_78GP04G_LBR_BMG_Fire
[hiddenAction_EF_RX_78GP04G_LBR_BMG_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RX_78GP04G_LBR_BMG_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:EF_RX_78GP04G_LBR_BMG_CDTimer=self.timeAlive+${EF_RX_78GP04G_LBR_BMG_CD}
addResources:EN=-${EF_RX_78GP04G_LBR_BMG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RX_78GP04G_LBR_BMG_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
EF_RX_78GP04G_LBR_BMG_B9_Step_1
"""
[hiddenAction_EF_RX_78GP04G_LBR_BMG_B9_Step_1]
alsoQueueAction:"""
EF_RX_78GP04G_LBR_BMG_Fire_Step_1,
EF_RX_78GP04G_LBR_BMG_Fire_Step_2,
EF_RX_78GP04G_LBR_BMG_Fire_Step_3,

EF_RX_78GP04G_LBR_BMG_Fire_Step_3,
EF_RX_78GP04G_LBR_BMG_Fire_Step_3,
EF_RX_78GP04G_LBR_BMG_Fire_Step_3,

EF_RX_78GP04G_LBR_BMG_Fire_Step_3,
EF_RX_78GP04G_LBR_BMG_Fire_Step_3,
EF_RX_78GP04G_LBR_BMG_Fire_Step_3,
EF_RX_78GP04G_LBR_BMG_Fire_Step_Final
"""



[hiddenAction_EF_RX_78GP04G_LBR_BMG_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RX_78GP04G_LBR_BMG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_EF_RX_78GP04G_LBR_BMG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RX_78GP04G_LBR_BMG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_EF_RX_78GP04G_LBR_BMG_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.1s
fireTurretXAtGround:EF_RX_78GP04G_LBR_BMG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)


[hiddenAction_EF_RX_78GP04G_LBR_BMG_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

