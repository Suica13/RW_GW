[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""

@memory NZN_AMX_107_ShieldBSG_CDTimer:float
@global NZN_AMX_107_ShieldBSG_CD=4.5
@global NZN_AMX_107_ShieldBSG_EN=45









[turret_NZN_AMX_107_ShieldBSG]
x:0
y:0

canShoot:false
projectile:NZN_AMX_107_ShieldBSG_Projectile

delay:0.075s
limitingRange:0

canAttackMaxAngle:15
barrelX:-16
barrelY:-3

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamGun_1.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Yellow_S
[turret_NZN_AMX_107_ShieldBSG_L]
@copyFromSection:turret_NZN_AMX_107_ShieldBSG
barrelX:-10
barrelY:0



[projectile_NZN_AMX_107_ShieldBSG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamShotGun_Yellow*2
(
    offsetRandomXY=3,
    offsetDir=2.5,
    offsetRandomDir=3,
    addResources=
    BeamDamage:2750
    |DpDamage:75
    |WeaponAccuracy=85
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |PartBreakModifier=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:65
    |ProjectileSpread:3
    |ProjectileLife:10
)
"""







[hiddenAction_NZN_AMX_107_ShieldBSG_Trigger]
alsoTriggerAction:NZN_AMX_107_ShieldBSG_Fire
[hiddenAction_NZN_AMX_107_ShieldBSG_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_AMX_107_ShieldBSG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0 
and self.shield>0
"""
setUnitMemory:NZN_AMX_107_ShieldBSG_CDTimer=self.timeAlive+${NZN_AMX_107_ShieldBSG_CD}
addResources:EN=-${NZN_AMX_107_ShieldBSG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
NZN_AMX_107_ShieldBSG_SetWeaponIndex,
NZN_AMX_107_ShieldBSG_B8_Step_1
"""
[hiddenAction_NZN_AMX_107_ShieldBSG_B8_Step_1]
alsoQueueAction:"""
NZN_AMX_107_ShieldBSG_Fire_Step_1,
NZN_AMX_107_ShieldBSG_Fire_Step_2,
NZN_AMX_107_ShieldBSG_Fire_Step_4,
NZN_AMX_107_ShieldBSG_Fire_Step_3,
NZN_AMX_107_ShieldBSG_Fire_Step_4,
NZN_AMX_107_ShieldBSG_Fire_Step_3,
NZN_AMX_107_ShieldBSG_Fire_Step_4,
NZN_AMX_107_ShieldBSG_Fire_Step_3,
NZN_AMX_107_ShieldBSG_Fire_Step_4,
NZN_AMX_107_ShieldBSG_Fire_Step_Final
"""





[hiddenAction_NZN_AMX_107_ShieldBSG_SetWeaponIndex]
isVisible:false


[hiddenAction_NZN_AMX_107_ShieldBSG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false and self.shield>0
"""
buildSpeed:0.3s
alsoTriggerAction:PlayCommon_Shoot_A_L_Step_1
[hiddenAction_NZN_AMX_107_ShieldBSG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false and self.shield>0
"""
buildSpeed:0s
fireTurretXAtGround:NZN_AMX_107_ShieldBSG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_NZN_AMX_107_ShieldBSG_Fire_Step_3]
@copyFromSection:hiddenAction_NZN_AMX_107_ShieldBSG_Fire_Step_2
buildSpeed:${turret_NZN_AMX_107_ShieldBSG.delay}

[hiddenAction_NZN_AMX_107_ShieldBSG_Fire_Step_4]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false and self.shield>0
"""
buildSpeed:${turret_NZN_AMX_107_ShieldBSG.delay}
fireTurretXAtGround:NZN_AMX_107_ShieldBSG_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_NZN_AMX_107_ShieldBSG_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


