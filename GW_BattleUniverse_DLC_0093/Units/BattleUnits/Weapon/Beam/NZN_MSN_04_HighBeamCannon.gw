[core]
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""
dont_load:false
@memory NZN_MSN_04_HighBeamCannon_CDTimer:float
@global NZN_MSN_04_HighBeamCannon_CD=6
@global NZN_MSN_04_HighBeamCannon_EN=75



[turret_NZN_MSN_04_HighBeamCannon]
x:0
y:0
canShoot:false
projectile:NZN_MSN_04_HighBeamCannon_Projectile
delay:0.2s
canAttackMaxAngle:15
barrelX:0
barrelY:12
limitingRange:0
aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0
shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamCannon_2.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Yellow



[projectile_NZN_MSN_04_HighBeamCannon_Projectile]
directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0
lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none
spawnUnit:"""
Projectile_AP_BeamRifle_Yellow*1
(
    addResources=
    BeamDamage:10000
    |BeamAPDamage:5000
    |DpDamage:300
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1 
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1 
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=3
    |HeightHitRange=25
    |ProjectileSpeed:85
    |ProjectileSpread:1
    |ProjectileLife:30

    |ProjectileAttackTimes:2
    |ProjectileAttackTimesDamageModifier:0.75
)
"""



[hiddenAction_NZN_MSN_04_HighBeamCannon_Trigger]
alsoTriggerAction:NZN_MSN_04_HighBeamCannon_Fire



[hiddenAction_NZN_MSN_04_HighBeamCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_MSN_04_HighBeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:NZN_MSN_04_HighBeamCannon_CDTimer=self.timeAlive+${NZN_MSN_04_HighBeamCannon_CD}
addResources:EN=-${NZN_MSN_04_HighBeamCannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
NZN_MSN_04_HighBeamCannon_SetWeaponIndex,
NZN_MSN_04_HighBeamCannon_B1_Step_1
"""



[hiddenAction_NZN_MSN_04_HighBeamCannon_B1_Step_1]
alsoQueueAction:"""
NZN_MSN_04_HighBeamCannon_Fire_Step_1,
NZN_MSN_04_HighBeamCannon_Fire_Step_2,
NZN_MSN_04_HighBeamCannon_Fire_Step_3,
NZN_MSN_04_HighBeamCannon_Fire_Step_Final
"""



[hiddenAction_NZN_MSN_04_HighBeamCannon_SetWeaponIndex]
isVisible:false



[hiddenAction_NZN_MSN_04_HighBeamCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
alsoTriggerAction:PlayCommon_Cannon_Shoot_A_Step_1
whenBuilding_cannotMove:true



[hiddenAction_NZN_MSN_04_HighBeamCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
whenBuilding_cannotMove:true



[hiddenAction_NZN_MSN_04_HighBeamCannon_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:NZN_MSN_04_HighBeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)



[hiddenAction_NZN_MSN_04_HighBeamCannon_Fire_Step_Final]
buildSpeed:1.25s
whenBuilding_cannotMove:true
finishPlayingLastAnimation:true
alsoTriggerAction:SetAttackingOff
