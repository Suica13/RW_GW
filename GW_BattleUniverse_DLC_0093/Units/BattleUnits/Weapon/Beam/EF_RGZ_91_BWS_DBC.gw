[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw
"""

@memory EF_RGZ_91_BWS_DBC_CDTimer:float
@global EF_RGZ_91_BWS_DBC_CD=4
@global EF_RGZ_91_BWS_DBC_EN=50










[turret_EF_RGZ_91_BWS_DBC]
x:0
y:0

canShoot:false
showRangeUIGuide:false
projectile:EF_RGZ_91_BWS_DBC_Projectile

delay:0.1s
limitingRange:1200
limitingAngle:3

canAttackMaxAngle:15
barrelX:11
barrelY:-4

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_1.ogg
shoot_sound_vol:0.35
shoot_flame:Beam_Fire_1_Yellow_S

[turret_EF_RGZ_91_BWS_DBC_R]
@copyFromSection:turret_EF_RGZ_91_BWS_DBC
barrelX:-12



[projectile_EF_RGZ_91_BWS_DBC_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Yellow*1
(
    addResources=
    BeamDamage:3500
    |DpDamage:125
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=0.5
    |AntiAir=1.5
    |AntiLand=1
    |AntiSpace=1.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""




[hiddenAction_EF_RGZ_91_BWS_DBC_Trigger]
alsoTriggerAction:EF_RGZ_91_BWS_DBC_Fire
[hiddenAction_EF_RGZ_91_BWS_DBC_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RGZ_91_BWS_DBC_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.backpackBreaked==false and ${onSkill}==false  
and not (directionBetween(self, self.attacking) < self.dir-35 or directionBetween(self, self.attacking) > self.dir+35)  
and self.resource.EN>0
"""
setUnitMemory:EF_RGZ_91_BWS_DBC_CDTimer=self.timeAlive+${EF_RGZ_91_BWS_DBC_CD} 
addResources:EN=-${EF_RGZ_91_BWS_DBC_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RGZ_91_BWS_DBC_SetWeaponIndex,
EF_RGZ_91_BWS_DBC_B4_Step_1
"""
[hiddenAction_EF_RGZ_91_BWS_DBC_B4_Step_1]
alsoQueueAction:EF_RGZ_91_BWS_DBC_Fire_Step_1,EF_RGZ_91_BWS_DBC_Fire_Step_2,EF_RGZ_91_BWS_DBC_Fire_Step_3,EF_RGZ_91_BWS_DBC_Fire_Step_2,EF_RGZ_91_BWS_DBC_Fire_Step_3,EF_RGZ_91_BWS_DBC_Fire_Step_Final

[hiddenAction_EF_RGZ_91_BWS_DBC_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RGZ_91_BWS_DBC_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false and memory.backpackBreaked==false 
"""
buildSpeed:0s

[hiddenAction_EF_RGZ_91_BWS_DBC_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.backpackBreaked==false 
"""
buildSpeed:0.075s
fireTurretXAtGround:EF_RGZ_91_BWS_DBC
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_EF_RGZ_91_BWS_DBC_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false and memory.backpackBreaked==false 
"""
buildSpeed:0.075s
fireTurretXAtGround:EF_RGZ_91_BWS_DBC_R
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_EF_RGZ_91_BWS_DBC_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff