[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_DoubleShoot_A_Light.gw
"""

@memory TITANS_RX_160_BeamGun_CDTimer:float
@global TITANS_RX_160_BeamGun_CD=1.5
@global TITANS_RX_160_BeamGun_EN=45





[turret_TITANS_RX_160_BeamGun]
x:0
y:0

canShoot:false
projectile:TITANS_RX_160_BeamGun_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:33
barrelY:18
idleDir:-15
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamGun_1.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Yellow
[turret_TITANS_RX_160_BeamGun_L]
@copyFromSection:turret_TITANS_RX_160_BeamGun
barrelX:-33
idleDir:15


[projectile_TITANS_RX_160_BeamGun_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Yellow*1
(
    addResources=
    BeamDamage:4250
    |DpDamage:100
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |PartBreakModifier=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:90
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""





[hiddenAction_TITANS_RX_160_BeamGun_Trigger]
alsoTriggerAction:TITANS_RX_160_BeamGun_Fire
[hiddenAction_TITANS_RX_160_BeamGun_Fire]
requireConditional:"""
if self.timeAlive>memory.TITANS_RX_160_BeamGun_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:TITANS_RX_160_BeamGun_CDTimer=self.timeAlive+${TITANS_RX_160_BeamGun_CD}
addResources:EN=-${TITANS_RX_160_BeamGun_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
TITANS_RX_160_BeamGun_SetWeaponIndex,
TITANS_RX_160_BeamGun_B4_Step_1
"""
[hiddenAction_TITANS_RX_160_BeamGun_B4_Step_1]
alsoQueueAction:"""
TITANS_RX_160_BeamGun_Fire_Step_1,
TITANS_RX_160_BeamGun_Fire_Step_2,
TITANS_RX_160_BeamGun_Fire_Step_3,
TITANS_RX_160_BeamGun_Fire_Step_2,
TITANS_RX_160_BeamGun_Fire_Step_3,
TITANS_RX_160_BeamGun_Fire_Step_Final
"""



[hiddenAction_TITANS_RX_160_BeamGun_SetWeaponIndex]
isVisible:false


[hiddenAction_TITANS_RX_160_BeamGun_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.15s
[hiddenAction_TITANS_RX_160_BeamGun_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false 
"""
buildSpeed:0.15s
fireTurretXAtGround:TITANS_RX_160_BeamGun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_DoubleShoot_A_Light_R_Step_1
[hiddenAction_TITANS_RX_160_BeamGun_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false 
"""
buildSpeed:0.15s
fireTurretXAtGround:TITANS_RX_160_BeamGun_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_DoubleShoot_A_Light_L_Step_1
[hiddenAction_TITANS_RX_160_BeamGun_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

