[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory EF_FA_78_1_BR_CDTimer:float
@global EF_FA_78_1_BR_CD=2
@global EF_FA_78_1_BR_EN=60





[decal_EF_FA_78_1_BR]
layer:beforeBody
order:4.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Beam\Image\EF_FA_78_1_BR.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 3
yOffsetRelative: 12
dirOffset:0






[turret_EF_FA_78_1_BR]
x:0
y:0

canShoot:false
projectile:EF_FA_78_1_BR_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:11
barrelY:25
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_1.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Pink
[turret_EF_FA_78_1_BR_R]
@copyFromSection:turret_EF_FA_78_1_BR
barrelX:13
barrelY:24
shoot_sound_vol:0



[projectile_EF_FA_78_1_BR_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamRifle_Pink
(
    offsetRandomDir=3,
    addResources=
    BeamDamage:5000
    |DpDamage:200
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:75
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""





[hiddenAction_EF_FA_78_1_BR_Trigger]
alsoTriggerAction:EF_FA_78_1_BR_Fire
[hiddenAction_EF_FA_78_1_BR_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_FA_78_1_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:EF_FA_78_1_BR_CDTimer=self.timeAlive+${EF_FA_78_1_BR_CD}
addResources:EN=-${EF_FA_78_1_BR_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_FA_78_1_BR_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
EF_FA_78_1_BR_B1_Step_1
"""
[hiddenAction_EF_FA_78_1_BR_B1_Step_1]
alsoQueueAction:"""
EF_FA_78_1_BR_Fire_Step_1,
EF_FA_78_1_BR_Fire_Step_2,
EF_FA_78_1_BR_Fire_Step_3,
EF_FA_78_1_BR_Fire_Step_Final
"""



[hiddenAction_EF_FA_78_1_BR_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_FA_78_1_BR_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_EF_FA_78_1_BR_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_FA_78_1_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_FA_78_1_BR_Fire_Step_3]
@copyFromSection:hiddenAction_EF_FA_78_1_BR_Fire_Step_2
fireTurretXAtGround:EF_FA_78_1_BR_R
[hiddenAction_EF_FA_78_1_BR_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

