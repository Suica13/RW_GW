[core]
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""
dont_load:false
@memory EF_RX_93_ShieldBC_CDTimer:float
@global EF_RX_93_ShieldBC_CD=3
@global EF_RX_93_ShieldBC_EN=50



[turret_EF_RX_93_ShieldBC]
x:0
y:0
canShoot:false
showRangeUIGuide:false
projectile:EF_RX_93_ShieldBC_Projectile
delay:0.1s
limitingRange:1200
limitingAngle:3
canAttackMaxAngle:15
barrelX:-13
barrelY:20
aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0
shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_1.ogg
shoot_sound_vol:0.35
shoot_flame:Beam_Fire_1_Pink_S



[projectile_EF_RX_93_ShieldBC_Projectile]
directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0
lightSize:0
effectOnCreate:none
explodeEffect:none
spawnUnit:"""
Projectile_AP_BeamRifle_Pink*1
(
    addResources=
    BeamDamage:4500
    |DpDamage:100
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=0.5
    |AntiAir=1.0
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:80
    |ProjectileSpread:1
    |ProjectileLife:30
    |ProjectileAttackTimes:3
    |ProjectileAttackTimesDamageModifier:0.75
)
"""



[hiddenAction_EF_RX_93_ShieldBC_Trigger]
alsoTriggerAction:EF_RX_93_ShieldBC_Fire



[hiddenAction_EF_RX_93_ShieldBC_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RX_93_ShieldBC_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armLBreaked==false and self.shield>0 and ${onSkill}==false  
and not (directionBetween(self, self.attacking) < self.dir-35 or directionBetween(self, self.attacking) > self.dir+35)  
and self.resource.EN>0
"""
setUnitMemory:EF_RX_93_ShieldBC_CDTimer=self.timeAlive+${EF_RX_93_ShieldBC_CD} 
addResources:EN=-${EF_RX_93_ShieldBC_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RX_93_ShieldBC_SetWeaponIndex,
PlayCommon_Shoot_A_L_Step_1,
EF_RX_93_ShieldBC_B6_Step_1
"""



[hiddenAction_EF_RX_93_ShieldBC_B6_Step_1]
alsoQueueAction:EF_RX_93_ShieldBC_Fire_Step_1,EF_RX_93_ShieldBC_Fire_Step_2,EF_RX_93_ShieldBC_Fire_Step_Final



[hiddenAction_EF_RX_93_ShieldBC_SetWeaponIndex]
isVisible:false



[hiddenAction_EF_RX_93_ShieldBC_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false and self.shield>0 and self.shield>0
"""
buildSpeed:0s



[hiddenAction_EF_RX_93_ShieldBC_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false and self.shield>0 and self.shield>0
"""
buildSpeed:0.075s
fireTurretXAtGround:EF_RX_93_ShieldBC
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)



[hiddenAction_EF_RX_93_ShieldBC_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false and self.shield>0 and self.shield>0
"""
buildSpeed:0.075s
fireTurretXAtGround:EF_RX_93_ShieldBC
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)



[hiddenAction_EF_RX_93_ShieldBC_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff
