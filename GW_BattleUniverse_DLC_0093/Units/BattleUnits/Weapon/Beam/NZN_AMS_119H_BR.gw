[core]
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Green.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""
dont_load:false
@memory NZN_AMS_119H_BR_CDTimer:float
@global NZN_AMS_119H_BR_CD=3.5
@global NZN_AMS_119H_BR_EN=75



[decal_NZN_AMS_119H_BR]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Weapon/Beam/Image/NZN_AMS_119H_BR.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 4
yOffsetRelative: 22
dirOffset:0



[decal_NZN_AMS_119H_BR_NotUsing]
@copyFromSection:decal_NZN_AMS_119H_BR
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.85
xOffsetRelative:1
yOffsetRelative:-10
dirOffset:-90



[turret_NZN_AMS_119H_BR]
x:0
y:0
canShoot:false
projectile:NZN_AMS_119H_BR_Projectile
delay:0.1s
canAttackMaxAngle:15
barrelX:12
barrelY:28
limitingRange:0
aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0
shoot_sound:ROOT:\Resource/Sound/SE/Weapon/Fire/BeamGun_2.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Fire_1_Green_S



[projectile_NZN_AMS_119H_BR_Projectile]
directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0
lightSize:0.75
lightColor:#63ff57
effectOnCreate:none
explodeEffect:none
spawnUnit:"""
Projectile_BeamGun_Green*1
(
    addResources=
    BeamDamage:1750
    |DpDamage:50
    |WeaponAccuracy=95
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:80
    |ProjectileSpread:3
    |ProjectileLife:25
)
"""



[hiddenAction_NZN_AMS_119H_BR_Trigger]
alsoTriggerAction:NZN_AMS_119H_BR_Fire



[hiddenAction_NZN_AMS_119H_BR_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_AMS_119H_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:NZN_AMS_119H_BR_CDTimer=self.timeAlive+${NZN_AMS_119H_BR_CD}
addResources:EN=-${NZN_AMS_119H_BR_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
NZN_AMS_119H_BR_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
NZN_AMS_119H_BR_B9_Step_1
"""



[hiddenAction_NZN_AMS_119H_BR_B9_Step_1]
alsoQueueAction:"""
NZN_AMS_119H_BR_Fire_Step_1,
NZN_AMS_119H_BR_Fire_Step_2,
NZN_AMS_119H_BR_Fire_Step_3,

NZN_AMS_119H_BR_Fire_Step_3,
NZN_AMS_119H_BR_Fire_Step_3,
NZN_AMS_119H_BR_Fire_Step_3,

NZN_AMS_119H_BR_Fire_Step_3,
NZN_AMS_119H_BR_Fire_Step_3,
NZN_AMS_119H_BR_Fire_Step_3,
NZN_AMS_119H_BR_Fire_Step_Final
"""



[hiddenAction_NZN_AMS_119H_BR_SetWeaponIndex]
isVisible:false



[hiddenAction_NZN_AMS_119H_BR_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false 
"""
buildSpeed:0.25s



[hiddenAction_NZN_AMS_119H_BR_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false 
"""
buildSpeed:0s
fireTurretXAtGround:NZN_AMS_119H_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)



[hiddenAction_NZN_AMS_119H_BR_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false 
"""
buildSpeed:0.1s
fireTurretXAtGround:NZN_AMS_119H_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)



[hiddenAction_NZN_AMS_119H_BR_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff
