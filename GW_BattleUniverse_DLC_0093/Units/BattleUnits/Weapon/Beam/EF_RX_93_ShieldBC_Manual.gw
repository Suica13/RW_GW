[core]
copyFrom:ROOT:Units/BattleUnits/Weapon/Beam/EF_RX_93_ShieldBC.gw
dont_load:true

# V5-style button; BU damage, EN, cooldown and firing steps are inherited.
[action_Manual_EF_RX_93_ShieldBC]
@copyFromSection:template_ManualWeapon
pos:14
text:Shield beam cannon
text_zh:盾牌光束炮
description:CD: ${EF_RX_93_ShieldBC_CD}s
description_zh:冷却: ${EF_RX_93_ShieldBC_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
requireConditional:if ${manualWeaponReady} and not memory.armLBreaked and self.shield>0 and self.resource.EN>=${EF_RX_93_ShieldBC_EN} and self.timeAlive>memory.EF_RX_93_ShieldBC_CDTimer
isLocked:if not (${manualWeaponReady} and not memory.armLBreaked and self.shield>0 and self.resource.EN>=${EF_RX_93_ShieldBC_EN})
isLockedAlt2:if self.timeAlive<=memory.EF_RX_93_ShieldBC_CDTimer
isLockedAlt2Message:Weapon cooling down
isLockedAlt2Message_zh:武器冷却中
alsoTriggerAction:EF_RX_93_ShieldBC_Fire
displayType:action

[hiddenAction_EF_RX_93_ShieldBC_Fire]
requireConditional:if self.timeAlive>memory.EF_RX_93_ShieldBC_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armLBreaked==false and self.shield>0 and ${onSkill}==false and (memory.manualControlEnabled or not (directionBetween(self, self.attacking) < self.dir-35 or directionBetween(self, self.attacking) > self.dir+35)) and self.resource.EN>0 and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive'))) and self.timeAlive>memory.manualInputBusyUntil and self.resource.EN>=${EF_RX_93_ShieldBC_EN}
addActionCooldownTime:${EF_RX_93_ShieldBC_CD}s
addActionCooldownApplyToActions:Manual_EF_RX_93_ShieldBC
setUnitMemory:EF_RX_93_ShieldBC_CDTimer=self.timeAlive+${EF_RX_93_ShieldBC_CD} ,manualInputBusyUntil=self.timeAlive+0.15

[hiddenAction_EF_RX_93_ShieldBC_Fire_Step_2]
requireConditional:if ${cantAction}==false and memory.armLBreaked==false and self.shield>0 and self.shield>0 and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_RX_93_ShieldBC_Fire_Step_3]
requireConditional:if ${cantAction}==false and memory.armLBreaked==false and self.shield>0 and self.shield>0 and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))
