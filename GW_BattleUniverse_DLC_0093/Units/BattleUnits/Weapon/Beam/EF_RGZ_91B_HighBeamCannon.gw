[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory EF_RGZ_91B_HighBeamCannon_CDTimer:float
@global EF_RGZ_91B_HighBeamCannon_CD=12
@global EF_RGZ_91B_HighBeamCannon_EN=120




@memory EF_RGZ_91B_HighBeamCannon_ChargeEffect_1:unit

[turret_EF_RGZ_91B_HighBeamCannon]
x:0
y:0

canShoot:false
projectile:EF_RGZ_91B_HighBeamCannon_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:0
barrelY:30
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCannon_2.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Fire_1_Yellow

[projectile_EF_RGZ_91B_HighBeamCannon_Projectile]
directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_HighBeamCannon_Yellow*1
(
    addResources=
    BeamDamage:15000
    |BeamAPDamage:5000
    |DpDamage:900
    |WeaponAccuracy=75
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:1
    |ProjectileExplosionRange:45
    |ProjectileLife:25

    |ProjectileAttackTimes:4
    |ProjectileAttackTimesDamageModifier:0.75
),
Projectile_HighBeamCannon_Yellow_Effect*1
(
    addResources=
    ProjectileSpeed:1.0
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""

[hiddenAction_EF_RGZ_91B_HighBeamCannon_Trigger]
alsoTriggerAction:EF_RGZ_91B_HighBeamCannon_Fire

[hiddenAction_EF_RGZ_91B_HighBeamCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RGZ_91B_HighBeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.backpackBreaked==false   and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:EF_RGZ_91B_HighBeamCannon_CDTimer=self.timeAlive+${EF_RGZ_91B_HighBeamCannon_CD}
addResources:EN=-${EF_RGZ_91B_HighBeamCannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RGZ_91B_HighBeamCannon_SetWeaponIndex,

EF_RGZ_91B_HighBeamCannon_B1_Step_1
"""

[hiddenAction_EF_RGZ_91B_HighBeamCannon_B1_Step_1]
alsoQueueAction:"""
EF_RGZ_91B_HighBeamCannon_Fire_Step_ChargeEffect_1,
EF_RGZ_91B_HighBeamCannon_Fire_Step_1,
SetAttackingCantTurnOn,
EF_RGZ_91B_HighBeamCannon_Fire_Step_2,
SetAttackingCantTurnOff,
EF_RGZ_91B_HighBeamCannon_Fire_Step_Final
"""

[hiddenAction_EF_RGZ_91B_HighBeamCannon_SetWeaponIndex]
isVisible:false

[hiddenAction_EF_RGZ_91B_HighBeamCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false and memory.backpackBreaked==false  
"""
buildSpeed:0.70s

[hiddenAction_EF_RGZ_91B_HighBeamCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.backpackBreaked==false  
"""
buildSpeed:0s
fireTurretXAtGround:EF_RGZ_91B_HighBeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_EF_RGZ_91B_HighBeamCannon_Fire_Step_Final]
buildSpeed:0.5s
alsoTriggerAction:SetAttackingOff
stopLastAnimation:true

[attachment_EF_RGZ_91B_HighBeamCannon_ChargeEffect_1]
x:0
y:25
isVisible:true
keepAliveWhenParentDies:false
canBeAttackedAndDamaged:false
isUnselectable:true
canAttack:false
showAllActionsFrom:true
onConvertKeepExistingUnitInSameSlot:true
idleDir:0
resetRotationWhenNotAttacking:true

[hiddenAction_EF_RGZ_91B_HighBeamCannon_ChargeEffect_1_AwakeSet]
autoTriggerOnEvent:newMessage(withTag="UnitTurretSpawn")
alsoTriggerAction:"""
EF_RGZ_91B_HighBeamCannon_ChargeEffect_1_StartSet
"""
attachments_addNewUnits:Beam_Charge_1_EffectUnit
attachments_onlyOnSlots:EF_RGZ_91B_HighBeamCannon_ChargeEffect_1

[hiddenAction_EF_RGZ_91B_HighBeamCannon_ChargeEffect_1_StartSet]
setUnitMemory:EF_RGZ_91B_HighBeamCannon_ChargeEffect_1=self.attachment(slot='EF_RGZ_91B_HighBeamCannon_ChargeEffect_1')
alsoTriggerAction:"""
EF_RGZ_91B_HighBeamCannon_ChargeEffect_1_SetColor,
EF_RGZ_91B_HighBeamCannon_ChargeEffect_1_SetSpeed
"""

[hiddenAction_EF_RGZ_91B_HighBeamCannon_ChargeEffect_1_SetColor]
sendMessageTo:memory.EF_RGZ_91B_HighBeamCannon_ChargeEffect_1
sendMessageWithTags:SetColor_Yellow

[hiddenAction_EF_RGZ_91B_HighBeamCannon_ChargeEffect_1_SetSpeed]
sendMessageTo:memory.EF_RGZ_91B_HighBeamCannon_ChargeEffect_1
sendMessageWithTags:SetSpeed
sendMessageWithData:Speed=10

[hiddenAction_EF_RGZ_91B_HighBeamCannon_Fire_Step_ChargeEffect_1]
requireConditional:if ${cantAction}==false and memory.backpackBreaked==false 
buildSpeed:0s
sendMessageTo:memory.EF_RGZ_91B_HighBeamCannon_ChargeEffect_1
sendMessageWithTags:PlayOneTime
playSoundAtUnit:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCharge_1.ogg:2.0

