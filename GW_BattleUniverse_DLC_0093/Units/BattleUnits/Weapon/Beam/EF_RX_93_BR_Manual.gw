[core]
copyFrom:ROOT:Units/BattleUnits/Weapon/Beam/EF_RX_93_BR.gw
dont_load:true

# V5-style button; BU damage, EN, cooldown and firing steps are inherited.
[action_Manual_EF_RX_93_BR]
@copyFromSection:template_ManualWeapon
pos:10
text:Beam rifle
text_zh:光束步枪
description:CD: ${EF_RX_93_BR_CD}s
description_zh:冷却: ${EF_RX_93_BR_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
requireConditional:if ${manualWeaponReady} and not memory.armRBreaked and self.resource.EN>=${EF_RX_93_BR_EN} and self.timeAlive>memory.EF_RX_93_BR_CDTimer
isLocked:if not (${manualWeaponReady} and not memory.armRBreaked and self.resource.EN>=${EF_RX_93_BR_EN})
isLockedAlt2:if self.timeAlive<=memory.EF_RX_93_BR_CDTimer
isLockedAlt2Message:Weapon cooling down
isLockedAlt2Message_zh:武器冷却中
alsoTriggerAction:EF_RX_93_BR_Fire

[hiddenAction_EF_RX_93_BR_Fire]
requireConditional:if self.timeAlive>memory.EF_RX_93_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and (memory.manualControlEnabled or not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)) and self.resource.EN>0 and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive'))) and self.timeAlive>memory.manualInputBusyUntil and self.resource.EN>=${EF_RX_93_BR_EN}
addActionCooldownTime:${EF_RX_93_BR_CD}s
addActionCooldownApplyToActions:Manual_EF_RX_93_BR
setUnitMemory:EF_RX_93_BR_CDTimer=self.timeAlive+${EF_RX_93_BR_CD},manualInputBusyUntil=self.timeAlive+0.15

[hiddenAction_EF_RX_93_BR_Fire_Step_2]
requireConditional:if ${cantAction}==false and memory.armRBreaked==false and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_RX_93_BR_Fire_Step_3]
requireConditional:if ${cantAction}==false and memory.armRBreaked==false and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))
