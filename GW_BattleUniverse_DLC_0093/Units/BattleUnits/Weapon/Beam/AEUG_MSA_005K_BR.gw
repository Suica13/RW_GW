[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_Two_Handed_A.gw
"""

@memory AEUG_MSA_005K_BR_CDTimer:float
@global AEUG_MSA_005K_BR_CD=1.5
@global AEUG_MSA_005K_BR_EN=30





[decal_AEUG_MSA_005K_BR]
layer:beforeBody
order:4.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Beam\Image\AEUG_MSA_005K_BR.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 4
yOffsetRelative: 18
dirOffset:0
[decal_AEUG_MSA_005K_BR_NotUsing]
@copyFromSection:decal_AEUG_MSA_005K_BR
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.85
xOffsetRelative:1
yOffsetRelative:-10
dirOffset:-90







[turret_AEUG_MSA_005K_BR]
x:0
y:0

canShoot:false
projectile:AEUG_MSA_005K_BR_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:11
barrelY:25
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_3.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Pink
[turret_AEUG_MSA_005K_BR_GL]
@copyFromSection:turret_AEUG_MSA_005K_BR
barrelX:11
barrelY:25
projectile:AEUG_MSA_005K_BR_GL_Projectile

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1_S



[projectile_AEUG_MSA_005K_BR_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamRifle_Pink*1
(
    addResources=
    BeamDamage:6500
    |DpDamage:200
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:90
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""


[projectile_AEUG_MSA_005K_BR_GL_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_S*1
(
    addResources=
    ShellDamage:4500
    |DpDamage:200
    |WeaponAccuracy=90
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75
    |AntiLand=1 
    |AntiSpace=1 
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:85
    |ProjectileSpread:2
    |ProjectileExplosionRange:35
    |ProjectileLife:25
)
"""





[hiddenAction_AEUG_MSA_005K_BR_Trigger]
alsoTriggerAction:AEUG_MSA_005K_BR_Fire
[hiddenAction_AEUG_MSA_005K_BR_Fire]
requireConditional:"""
if self.timeAlive>memory.AEUG_MSA_005K_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:AEUG_MSA_005K_BR_CDTimer=self.timeAlive+${AEUG_MSA_005K_BR_CD}
addResources:EN=-${AEUG_MSA_005K_BR_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
AEUG_MSA_005K_BR_SetWeaponIndex,
PlayCommon_Shoot_Two_Handed_A_Step_1,
AEUG_MSA_005K_BR_B4_Step_1
"""
[hiddenAction_AEUG_MSA_005K_BR_B4_Step_1]
alsoQueueAction:"""
AEUG_MSA_005K_BR_Fire_Step_1,
AEUG_MSA_005K_BR_Fire_Step_2,
AEUG_MSA_005K_BR_Fire_Step_3,
AEUG_MSA_005K_BR_Fire_Step_3,
AEUG_MSA_005K_BR_Fire_Step_3,
AEUG_MSA_005K_BR_Fire_Step_4,
AEUG_MSA_005K_BR_Fire_Step_Final
"""



[hiddenAction_AEUG_MSA_005K_BR_SetWeaponIndex]
isVisible:false


[hiddenAction_AEUG_MSA_005K_BR_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_AEUG_MSA_005K_BR_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:AEUG_MSA_005K_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_AEUG_MSA_005K_BR_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
fireTurretXAtGround:AEUG_MSA_005K_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_AEUG_MSA_005K_BR_Fire_Step_4]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.15s
fireTurretXAtGround:AEUG_MSA_005K_BR_GL
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_AEUG_MSA_005K_BR_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

