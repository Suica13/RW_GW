[core]
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""
dont_load:false
@memory EF_RGZ_91B_CrotchBeamCannon_CDTimer:float
@global EF_RGZ_91B_CrotchBeamCannon_CD=7
@global EF_RGZ_91B_CrotchBeamCannon_EN=65

[turret_EF_RGZ_91B_CrotchBeamCannon]
x:0
y:0
canShoot:false
projectile:EF_RGZ_91B_CrotchBeamCannon_Projectile
delay:0.2s
canAttackMaxAngle:15
barrelX:12
barrelY:10
limitingRange:0
aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0
shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCannon_7.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Yellow

[projectile_EF_RGZ_91B_CrotchBeamCannon_Projectile]
directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0
lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none
spawnUnit:"""
Projectile_AP_BeamRifle_Yellow*1
(
    addResources=
    BeamDamage:7500
    |BeamAPDamage:0
    |DpDamage:300
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1 
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1 
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=3
    |HeightHitRange=25
    |ProjectileSpeed:80
    |ProjectileSpread:1
    |ProjectileLife:30

    |ProjectileAttackTimes:1
    |ProjectileAttackTimesDamageModifier:0.75
)
"""

[hiddenAction_EF_RGZ_91B_CrotchBeamCannon_Trigger]
alsoTriggerAction:EF_RGZ_91B_CrotchBeamCannon_Fire

[hiddenAction_EF_RGZ_91B_CrotchBeamCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RGZ_91B_CrotchBeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.backpackBreaked==false  
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:EF_RGZ_91B_CrotchBeamCannon_CDTimer=self.timeAlive+${EF_RGZ_91B_CrotchBeamCannon_CD}
addResources:EN=-${EF_RGZ_91B_CrotchBeamCannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RGZ_91B_CrotchBeamCannon_SetWeaponIndex,
EF_RGZ_91B_CrotchBeamCannon_B1_Step_1
"""

[hiddenAction_EF_RGZ_91B_CrotchBeamCannon_B1_Step_1]
alsoQueueAction:"""
EF_RGZ_91B_CrotchBeamCannon_Fire_Step_1,
EF_RGZ_91B_CrotchBeamCannon_Fire_Step_2,
EF_RGZ_91B_CrotchBeamCannon_Fire_Step_3,
EF_RGZ_91B_CrotchBeamCannon_Fire_Step_Final
"""

[hiddenAction_EF_RGZ_91B_CrotchBeamCannon_SetWeaponIndex]
isVisible:false

[hiddenAction_EF_RGZ_91B_CrotchBeamCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false and memory.backpackBreaked==false  
"""
buildSpeed:0.35s
alsoTriggerAction:PlayCommon_Cannon_Shoot_A_Step_1
whenBuilding_cannotMove:true

[hiddenAction_EF_RGZ_91B_CrotchBeamCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.backpackBreaked==false  
"""
buildSpeed:0s
whenBuilding_cannotMove:true

[hiddenAction_EF_RGZ_91B_CrotchBeamCannon_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false and memory.backpackBreaked==false  
"""
buildSpeed:0s
fireTurretXAtGround:EF_RGZ_91B_CrotchBeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)



alsoTriggerAction:EF_RGZ_91B_CrotchBeamCannon_Fire_Step_Sub

[hiddenAction_EF_RGZ_91B_CrotchBeamCannon_Fire_Step_Final]
buildSpeed:0.35s
whenBuilding_cannotMove:true
finishPlayingLastAnimation:true
alsoTriggerAction:SetAttackingOff

[turret_EF_RGZ_91B_CrotchBeamCannon_L]
@copyFromSection:turret_EF_RGZ_91B_CrotchBeamCannon
barrelX:-12

[hiddenAction_EF_RGZ_91B_CrotchBeamCannon_Fire_Step_Sub]
requireConditional:if ${cantAction}==false and memory.backpackBreaked==false
fireTurretXAtGround:EF_RGZ_91B_CrotchBeamCannon_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

