[core]
copyFrom:ROOT:Units/BattleUnits/Weapon/Shell/Common_DoubleVulcan_MS_Lv4.gw
dont_load:true
@memory manualVulcanRightNext:bool

[turret_Common_DoubleVulcan_MS]
canAttackCondition:if not memory.manualControlEnabled and (${cantAction}==false and distanceBetween(self,self.attacking)<=600 and memory.headBreaked==false and (    attacking.tags(includes='Aircraft')     or attacking.tags(includes='Tank')     or attacking.tags(includes='Pilot')     or memory.attackMode==1     or self.resource().en<=0))

[action_Manual_RX_93_Vulcan]
@copyFromSection:template_ManualWeapon
pos:40
text:Head Vulcan
text_zh:头部火神炮
description:28-round independent burst. Main weapons remain available.
description_zh:28发独立点射，可同时使用主武器，沿用原装填与弹药。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Ciws_1.png
isLocked:if not ${manualAuxiliaryReady} or memory.headBreaked or memory.Common_DoubleVulcan_MS_OnCD or self.resource.Common_DoubleVulcan_MS_ShootTimer<=0
requireConditional:if ${manualAuxiliaryReady} and not memory.headBreaked and not memory.Common_DoubleVulcan_MS_OnCD and self.resource.Common_DoubleVulcan_MS_ShootTimer>0
alsoTriggerAction:Manual_RX_93_Vulcan_Fire

[hiddenAction_Manual_RX_93_Vulcan_Fire]
requireConditional:if ${manualAuxiliaryReady} and not memory.headBreaked and not memory.Common_DoubleVulcan_MS_OnCD
setUnitMemory:manualVulcanRightNext=false,manualVulcanSerial=memory.manualVulcanSerial+1,Common_DoubleVulcan_MS_OnCD=true,Common_DoubleVulcan_MS_CDTimer=self.timeAlive+${Common_DoubleVulcan_MS_CD}+2.1
addActionCooldownTime:${Common_DoubleVulcan_MS_CD+2.1}s
addActionCooldownApplyToActions:Manual_RX_93_Vulcan
spawnUnits:ManualVulcanBurst_Lv4
# No root queue, attack-state flag, or main-weapon input lock is changed.

[hiddenAction_Manual_RX_93_Vulcan_Shot]
autoTriggerOnEvent:newMessage(withTag='ManualVulcanShot')
# [ENGINE_WORKAROUND] Forced shots skip native turret resourceUsage.
requireConditional:if ${manualAuxiliaryReady} and eventData('burstSerial',type='float')==memory.manualVulcanSerial and not memory.headBreaked and self.resource.Common_DoubleVulcan_MS_ShootTimer>0
alsoTriggerAction:Manual_Vulcan_Left,Manual_Vulcan_Right,Manual_Vulcan_Spend

[turret_Manual_Vulcan_Left]
@copyFromSection:turret_Common_DoubleVulcan_MS
canShoot:false
barrelX:-3
barrelOffsetX_onOddShots:0
[turret_Manual_Vulcan_Right]
@copyFromSection:turret_Manual_Vulcan_Left
barrelX:3

[hiddenAction_Manual_Vulcan_Left]
requireConditional:if not memory.manualVulcanRightNext
fireTurretXAtGround:Manual_Vulcan_Left
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_Manual_Vulcan_Right]
requireConditional:if memory.manualVulcanRightNext
fireTurretXAtGround:Manual_Vulcan_Right
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_Manual_Vulcan_Spend]
setUnitMemory:manualVulcanRightNext=not memory.manualVulcanRightNext
addResources:Common_DoubleVulcan_MS_ShootTimer=-1
