[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory EF_RX_93_Funnel_CDTimer:float
@memory EF_RX_93_Funnel_Units:unit[]
@global EF_RX_93_Funnel_CD=20
@global EF_RX_93_Funnel_EN=100
@global EF_RX_93_Funnel_PilotAwakeningSkill=0

[hiddenAction_Get_FunnelSpawn_EF_RX_93_Funnel]
autoTriggerOnEvent:newMessage(withTag="FunnelSpawn_EF_RX_93_Funnel")
setUnitMemory:EF_RX_93_Funnel_Units[memory.EF_RX_93_Funnel_Units.size]=eventData("unitInfo",type="unit")




[turret_EF_RX_93_Funnel]
x:0
y:0

canShoot:false
projectile:EF_RX_93_Funnel_Projectile

delay:0.2s
canAttackMaxAngle:15
limitingAngle:0
limitingRange:1200
barrelX:0
barrelY:-10

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Action/Common/Transform_1.ogg
shoot_sound_vol:0
shoot_flame:none


[projectile_EF_RX_93_Funnel_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
RX_93_Funnel*1
"""


[hiddenAction_EF_RX_93_Funnel_Trigger_ByAI]
autoTrigger:"""
if ${allowAI}==true 
and ${cantAction}==false and memory.backpackBreaked==false and memory.EF_RX_93_Funnel_Units.size==0 
and ${onSkill}==false 
and memory.close==false 
and self.resource.EN>${EF_RX_93_Funnel_EN} 
and self.timeAlive>memory.EF_RX_93_Funnel_CDTimer 
and self.parent.hp<=0  
and self.attacking.hp>0 
and memory.pilotUnit.readUnitMemory("pilotAwakeningSkillFinal",type="float")>=${EF_RX_93_Funnel_PilotAwakeningSkill} 
"""
setResourcesWithLogic:EN=self.resource().EN-${EF_RX_93_Funnel_EN}
alsoTriggerAction:EF_RX_93_Funnel_Trigger

[action_EF_RX_93_Funnel_Trigger]
pos:10
text:Funnel[LockOn] %{select(self.timeAlive<=memory.EF_RX_93_Funnel_CDTimer,str(int(memory.EF_RX_93_Funnel_CDTimer-self.timeAlive))+"s","OK")}
text_zh:浮游炮[锁定] %{select(self.timeAlive<=memory.EF_RX_93_Funnel_CDTimer,str(int(memory.EF_RX_93_Funnel_CDTimer-self.timeAlive))+"秒","OK")}
text_KP:100

displayType:infoOnly

price:EN=${EF_RX_93_Funnel_EN} 

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true
canPlayerCancel:false
ai_isDisabled:true

iconImage:ROOT:Resource/Image/Units/Button/Weapon/Funnel_3.png
highPriorityQueue:true

isVisible:if self.parent.hp<=0 
isGuiBlinking:"""
if self.timeAlive>memory.EF_RX_93_Funnel_CDTimer 
and ${cantAction}==false 
and ${onSkill}==false 
and not 
(
    memory.armLBreaked==true 
    and 
    memory.armRBreaked==true
)
"""

isLocked:if self.timeAlive<=memory.EF_RX_93_Funnel_CDTimer
isLockedMessage:In CD
isLockedMessage_zh:冷却中

isLockedAlt:"""
if memory.pilotUnit.readUnitMemory("pilotAwakeningSkillFinal",type="float")<${EF_RX_93_Funnel_PilotAwakeningSkill}
"""
isLockedAltMessage:PilotAwakeningSkill Not Enough(%{${EF_RX_93_Funnel_PilotAwakeningSkill}})
isLockedAltMessage_zh:驾驶员觉醒能力不足(%{${EF_RX_93_Funnel_PilotAwakeningSkill}})

isLockedAlt2:"""
if 
(
    ${cantAction}==true or ${onSkill}==true or ${allowAI}==true 
)
"""
isLockedAlt2Message:Cant Action
isLockedAlt2Message_zh:无法行动

alsoTriggerAction:"""
SetOnSkillOn,
EF_RX_93_Funnel_SetWeaponIndex,
EF_RX_93_Funnel_B10_Step_1,
PlayCommon_Cannon_Shoot_A_Step_1
"""

requireConditional:if ${cantAction}==false and ${onSkill}==false and memory.backpackBreaked==false and memory.EF_RX_93_Funnel_Units.size==0 and self.timeAlive>memory.EF_RX_93_Funnel_CDTimer



[hiddenAction_EF_RX_93_Funnel_B10_Step_1]
setUnitMemory:EF_RX_93_Funnel_CDTimer=self.timeAlive+${EF_RX_93_Funnel_CD}
shrinkArrays:EF_RX_93_Funnel_Units
alsoQueueAction:"""
EF_RX_93_Funnel_Fire_Step_1,
EF_RX_93_Funnel_Fire_Step_2,
EF_RX_93_Funnel_Fire_Step_2,
EF_RX_93_Funnel_Fire_Step_2,
EF_RX_93_Funnel_Fire_Step_2,
EF_RX_93_Funnel_Fire_Step_2,
EF_RX_93_Funnel_Fire_Step_Final
"""
playSoundAtUnit:ROOT:Resource/Sound/SE/Action/System/NewType_2.ogg



[hiddenAction_EF_RX_93_Funnel_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RX_93_Funnel_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false and memory.backpackBreaked==false 
"""
buildSpeed:0.15s
fireTurretXAtGround:EF_RX_93_Funnel
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)



[hiddenAction_EF_RX_93_Funnel_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.backpackBreaked==false 
"""
buildSpeed:0.05s
fireTurretXAtGround:EF_RX_93_Funnel
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)



[hiddenAction_EF_RX_93_Funnel_Fire_Step_Final]
buildSpeed:0s
alsoTriggerAction:"""
SetOnSkillOff
"""
[hiddenAction_Check_EF_RX_93_Funnel_Units]
autoTrigger:true
shrinkArrays:EF_RX_93_Funnel_Units



