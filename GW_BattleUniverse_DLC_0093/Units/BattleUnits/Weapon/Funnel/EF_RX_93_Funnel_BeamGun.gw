alsoTriggerAction:"""
EF_RX_93_Funnel_BeamGun_Fire
"""
[hiddenAction_EF_RX_93_Funnel_BeamGun_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RX_93_Funnel_BeamGun_CDTimer and memory.onAttacking==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:EF_RX_93_Funnel_BeamGun_CDTimer=self.timeAlive+${EF_RX_93_Funnel_BeamGun_CD}
