"""

@memory EF_RX_93_Funnel_BeamGun_CDTimer:float
@global EF_RX_93_Funnel_BeamGun_CD=2
@global EF_RX_93_Funnel_BeamGun_EN=30


[turret_EF_RX_93_Funnel_BeamGun]
