[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""


@memory EF_RAG_79_G1_HG_CDTimer:float
@global EF_RAG_79_G1_HG_CD=5
@global EF_RAG_79_G1_HG_EN=40








[turret_EF_RAG_79_G1_HG]
x:0
y:0

canShoot:false
projectile:EF_RAG_79_G1_HG_Projectile

delay:0.3s
limitingRange:0

canAttackMaxAngle:15
barrelX:-15
barrelY:8

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_EF_RAG_79_G1_HG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_Target_Harpoon_RAG_79_G1_HG*1
(
    addResources=
    ShellDamage:3250
    |DpDamage:325
    |WeaponAccuracy=100
    |PartBreakModifier=0.75
    |CockpitBreakModifier=1.25
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=0.5
    |AntiAqua=2.5
    |AntiAir=0.5 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:60
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:30
)
"""








[hiddenAction_EF_RAG_79_G1_HG_Trigger]
alsoTriggerAction:EF_RAG_79_G1_HG_Fire
[hiddenAction_EF_RAG_79_G1_HG_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RAG_79_G1_HG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_RAG_79_G1_HG_CDTimer=self.timeAlive+${EF_RAG_79_G1_HG_CD}
addResources:EN=-${EF_RAG_79_G1_HG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RAG_79_G1_HG_SetWeaponIndex,
EF_RAG_79_G1_HG_B2_Step_1
"""
[hiddenAction_EF_RAG_79_G1_HG_B2_Step_1]
alsoQueueAction:"""
EF_RAG_79_G1_HG_Fire_Step_1,
EF_RAG_79_G1_HG_Fire_Step_2,
EF_RAG_79_G1_HG_Fire_Step_3,
EF_RAG_79_G1_HG_Fire_Step_Final
"""





[hiddenAction_EF_RAG_79_G1_HG_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RAG_79_G1_HG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_EF_RAG_79_G1_HG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RAG_79_G1_HG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_L_Step_1
[hiddenAction_EF_RAG_79_G1_HG_Fire_Step_3]
@copyFromSection:hiddenAction_EF_RAG_79_G1_HG_Fire_Step_2
buildSpeed:${turret_EF_RAG_79_G1_HG.delay}
[hiddenAction_EF_RAG_79_G1_HG_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


