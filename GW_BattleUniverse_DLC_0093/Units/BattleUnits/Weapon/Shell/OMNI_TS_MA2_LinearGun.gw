[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw
"""

@memory OMNI_TS_MA2_LinearGun_CDTimer:float
@global OMNI_TS_MA2_LinearGun_CD=2
@global OMNI_TS_MA2_LinearGun_EN=45




[turret_OMNI_TS_MA2_LinearGun]
x:0
y:0

canShoot:false
projectile:OMNI_TS_MA2_LinearGun_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:0
barrelY:12
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Bazooka_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_OMNI_TS_MA2_LinearGun_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_S*1
(
    addResources=
    ShellDamage:2500
    |DpDamage:150
    |WeaponAccuracy=95
    |PartBreakModifier=0.75
    |CockpitBreakModifier=2.35
    |PilotDamageModifier=2.35
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.25  
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:60
    |ProjectileSpread:2
    |ProjectileExplosionRange:30
    |ProjectileLife:25
)
"""








[hiddenAction_OMNI_TS_MA2_LinearGun_Trigger]
alsoTriggerAction:OMNI_TS_MA2_LinearGun_Fire
[hiddenAction_OMNI_TS_MA2_LinearGun_Fire]
requireConditional:"""
if self.timeAlive>memory.OMNI_TS_MA2_LinearGun_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:OMNI_TS_MA2_LinearGun_CDTimer=self.timeAlive+${OMNI_TS_MA2_LinearGun_CD}
addResources:EN=-${OMNI_TS_MA2_LinearGun_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
OMNI_TS_MA2_LinearGun_SetWeaponIndex,
OMNI_TS_MA2_LinearGun_B1_Step_1
"""
[hiddenAction_OMNI_TS_MA2_LinearGun_B1_Step_1]
alsoQueueAction:"""
OMNI_TS_MA2_LinearGun_Fire_Step_1,
OMNI_TS_MA2_LinearGun_Fire_Step_2,
OMNI_TS_MA2_LinearGun_Fire_Step_Final
"""




[hiddenAction_OMNI_TS_MA2_LinearGun_SetWeaponIndex]
isVisible:false


[hiddenAction_OMNI_TS_MA2_LinearGun_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_OMNI_TS_MA2_LinearGun_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:OMNI_TS_MA2_LinearGun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_OMNI_TS_MA2_LinearGun_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


