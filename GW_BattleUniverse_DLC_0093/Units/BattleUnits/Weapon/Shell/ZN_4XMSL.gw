[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory ZN_4XMSL_CDTimer:float
@global ZN_4XMSL_CD=12
@global ZN_4XMSL_EN=120





[decal_ZN_4XMSL]
layer:beforeBody
order:6.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\ZN_4XMSL.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.9
xOffsetRelative: 2
yOffsetRelative: 6
dirOffset:0
[decal_ZN_4XMSL_NotUsing]
@copyFromSection:decal_ZN_4XMSL
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\ZN_4XMSL_Backpack.png
order:5.5
basePositionFromLegEnd:arm2
imageScale:0.8
imageScaleY:1
xOffsetRelative:-8
yOffsetRelative:-16
dirOffset:0








[turret_ZN_4XMSL]
x:0
y:0

canShoot:false
projectile:ZN_4XMSL_Projectile

delay:0.5s
canAttackMaxAngle:15
barrelX:11
barrelY:22
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_ZN_4XMSL_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_ASP_BurningArea_B*1
(
    addResources=
    ShellDamage:5500
    |DpDamage:150
    |WeaponAccuracy=75
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.5
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.5
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:30
    |ProjectileSpread:0
    |ProjectileExplosionRange:30
    |ProjectileLife:50
    
    |ProjectileBlastRange:60
    |ProjectileBlastDamageModifier:0.20
    |ProjectileBlastDpModifier:1
)
"""








[hiddenAction_ZN_4XMSL_Trigger]
alsoTriggerAction:ZN_4XMSL_Fire
[hiddenAction_ZN_4XMSL_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_4XMSL_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:ZN_4XMSL_CDTimer=self.timeAlive+${ZN_4XMSL_CD}
addResources:EN=-${ZN_4XMSL_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_4XMSL_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
ZN_4XMSL_B2_Step_1
"""
[hiddenAction_ZN_4XMSL_B2_Step_1]
alsoQueueAction:"""
ZN_4XMSL_Fire_Step_1,
ZN_4XMSL_Fire_Step_2,
ZN_4XMSL_Fire_Step_3,
ZN_4XMSL_Fire_Step_Final
"""




[hiddenAction_ZN_4XMSL_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_4XMSL_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_ZN_4XMSL_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_4XMSL
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_4XMSL_Fire_Step_3]
@copyFromSection:hiddenAction_ZN_4XMSL_Fire_Step_2
buildSpeed:${turret_ZN_4XMSL.delay}
[hiddenAction_ZN_4XMSL_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


