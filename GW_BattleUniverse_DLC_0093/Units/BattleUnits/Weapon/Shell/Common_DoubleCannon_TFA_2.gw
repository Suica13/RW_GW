[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory Common_DoubleCannon_TFA_2_CDTimer:float
@global Common_DoubleCannon_TFA_2_CD=9
@global Common_DoubleCannon_TFA_2_EN=55








[turret_Common_DoubleCannon_TFA_2]
x:0
y:0

canShoot:false
projectile:Common_DoubleCannon_TFA_2_Projectile

delay:0.3s
canAttackMaxAngle:15
limitingAngle:0
barrelX:7
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\ShellCannon_1.ogg
shoot_sound_vol:0.45
shoot_flame:BZ_Fire_1
[turret_Common_DoubleCannon_TFA_2_L]
@copyFromSection:turret_Common_DoubleCannon_TFA_2
barrelX:-7



[projectile_Common_DoubleCannon_TFA_2_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Mortar_L*2
(
    offsetRandomXY=6,
    offsetDir=2.5,
    offsetRandomDir=7.5,
    addResources=
    ShellDamage:3000
    |DpDamage:150
    |WeaponAccuracy=75
    |PartBreakModifier=0.5
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |AntiAqua=0.75
    |AntiAir=0.5 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=0.5
    |HeightHitRange=10
    |ProjectileSpeed:45
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:70

    |ProjectileBlastRange:60
    |ProjectileBlastDamageModifier:0.35
    |ProjectileBlastDpModifier:1
)
"""








[hiddenAction_Common_DoubleCannon_TFA_2_Trigger]
alsoTriggerAction:Common_DoubleCannon_TFA_2_Fire
[hiddenAction_Common_DoubleCannon_TFA_2_Fire]
requireConditional:"""
if self.timeAlive>memory.Common_DoubleCannon_TFA_2_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:Common_DoubleCannon_TFA_2_CDTimer=self.timeAlive+${Common_DoubleCannon_TFA_2_CD}
addResources:EN=-${Common_DoubleCannon_TFA_2_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
Common_DoubleCannon_TFA_2_SetWeaponIndex,
Common_DoubleCannon_TFA_2_B1_Step_1
"""
[hiddenAction_Common_DoubleCannon_TFA_2_B1_Step_1]
alsoQueueAction:"""
Common_DoubleCannon_TFA_2_Fire_Step_1,
Common_DoubleCannon_TFA_2_Fire_Step_2,
Common_DoubleCannon_TFA_2_Fire_Step_3,
Common_DoubleCannon_TFA_2_Fire_Step_4,
Common_DoubleCannon_TFA_2_Fire_Step_Final
"""






[hiddenAction_Common_DoubleCannon_TFA_2_SetWeaponIndex]
isVisible:false


[hiddenAction_Common_DoubleCannon_TFA_2_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
alsoTriggerAction:PlayCommon_Cannon_Shoot_A_Step_1
whenBuilding_cannotMove:true
[hiddenAction_Common_DoubleCannon_TFA_2_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
whenBuilding_cannotMove:true
[hiddenAction_Common_DoubleCannon_TFA_2_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false
"""
buildSpeed:0s
whenBuilding_cannotMove:true
fireTurretXAtGround:Common_DoubleCannon_TFA_2
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_Common_DoubleCannon_TFA_2_Fire_Step_4]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false
"""
buildSpeed:0s
whenBuilding_cannotMove:true
fireTurretXAtGround:Common_DoubleCannon_TFA_2_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_Common_DoubleCannon_TFA_2_Fire_Step_Final]
buildSpeed:1.25s
whenBuilding_cannotMove:true
finishPlayingLastAnimation:true
alsoTriggerAction:SetAttackingOff


