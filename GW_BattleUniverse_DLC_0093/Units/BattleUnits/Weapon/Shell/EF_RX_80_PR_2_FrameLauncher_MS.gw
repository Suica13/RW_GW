[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""


@memory EF_RX_80_PR_2_FrameLauncher_MS_CDTimer:float
@global EF_RX_80_PR_2_FrameLauncher_MS_CD=12
@global EF_RX_80_PR_2_FrameLauncher_MS_EN=50





[decal_EF_RX_80_PR_2_FrameLauncher_MS]
layer:beforeBody
order:4.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\EF_RX_80_PR_2_FrameLauncher.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1.0
xOffsetRelative: 2
yOffsetRelative: 15
dirOffset:0
[decal_EF_RX_80_PR_2_FrameLauncher_MS_NotUsing]
@copyFromSection:decal_EF_RX_80_PR_2_FrameLauncher_MS
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.9
xOffsetRelative:2
yOffsetRelative:-8.5
dirOffset:-90







[turret_EF_RX_80_PR_2_FrameLauncher_MS]
x:0
y:0

canShoot:false
projectile:EF_RX_80_PR_2_FrameLauncher_MS_Projectile

delay:0.15s
limitingRange:0

canAttackMaxAngle:15
barrelX:11
barrelY:30

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.25
shoot_flame:BZ_Fire_1_S



[projectile_EF_RX_80_PR_2_FrameLauncher_MS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS*1
(
    addResources=
    ShellDamage:2500
    |DpDamage:100
    |WeaponAccuracy=85
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightHitRange=20
    |HeightChangeSpeed=2
    |ProjectileSpeed:30
    |ProjectileTurnspeed:1.5
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:50
)
"""






[hiddenAction_EF_RX_80_PR_2_FrameLauncher_MS_Trigger]
alsoTriggerAction:EF_RX_80_PR_2_FrameLauncher_MS_Fire
[hiddenAction_EF_RX_80_PR_2_FrameLauncher_MS_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RX_80_PR_2_FrameLauncher_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_RX_80_PR_2_FrameLauncher_MS_CDTimer=self.timeAlive+${EF_RX_80_PR_2_FrameLauncher_MS_CD}
addResources:EN=-${EF_RX_80_PR_2_FrameLauncher_MS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
PlayCommon_Shoot_A_Step_1,
EF_RX_80_PR_2_FrameLauncher_MS_SetWeaponIndex,
EF_RX_80_PR_2_FrameLauncher_MS_B4_Step_1
"""
[hiddenAction_EF_RX_80_PR_2_FrameLauncher_MS_B4_Step_1]
alsoQueueAction:"""
EF_RX_80_PR_2_FrameLauncher_MS_Fire_Step_1,
EF_RX_80_PR_2_FrameLauncher_MS_Fire_Step_2,
EF_RX_80_PR_2_FrameLauncher_MS_Fire_Step_3,
EF_RX_80_PR_2_FrameLauncher_MS_Fire_Step_3,
EF_RX_80_PR_2_FrameLauncher_MS_Fire_Step_3,
EF_RX_80_PR_2_FrameLauncher_MS_Fire_Step_Final
"""





[hiddenAction_EF_RX_80_PR_2_FrameLauncher_MS_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RX_80_PR_2_FrameLauncher_MS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_EF_RX_80_PR_2_FrameLauncher_MS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RX_80_PR_2_FrameLauncher_MS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_RX_80_PR_2_FrameLauncher_MS_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.2s
fireTurretXAtGround:EF_RX_80_PR_2_FrameLauncher_MS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_RX_80_PR_2_FrameLauncher_MS_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff


