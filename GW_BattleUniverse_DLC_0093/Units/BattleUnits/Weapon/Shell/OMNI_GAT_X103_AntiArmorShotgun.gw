[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_Two_Handed_A_L.gw
"""

@memory OMNI_GAT_X103_AntiArmorShotgun_CDTimer:float
@global OMNI_GAT_X103_AntiArmorShotgun_CD=12
@global OMNI_GAT_X103_AntiArmorShotgun_EN=75





[decal_OMNI_GAT_X103_AntiArmorShotgun_RailGun]
layer:beforeBody
order:4.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\OMNI_GAT_X103_RailGun.png
isVisible:false
basePositionFromLegEnd:arm3
imageScale:0.75
imageScaleX:-1
xOffsetRelative: -3
yOffsetRelative: 12
dirOffset:0

[decal_OMNI_GAT_X103_AntiArmorShotgun_BR]
layer:beforeBody
order:4.4
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Beam\Image\OMNI_GAT_X103_BR.png
isVisible:false
basePositionFromLegEnd:arm3
imageScale:0.75
imageScaleX:-1
xOffsetRelative: -1.5
yOffsetRelative: -8
dirOffset:0




[turret_OMNI_GAT_X103_AntiArmorShotgun]
x:0
y:0

canShoot:false
projectile:OMNI_GAT_X103_AntiArmorShotgun_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:-10
barrelY:30
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Bazooka_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_OMNI_GAT_X103_AntiArmorShotgun_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_ShotgunMode*1
(
    addResources=
    ShellDamage:3500
    |DpDamage:150
    |WeaponAccuracy=85
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:40
    |ProjectileSpread:1
    |ProjectileExplosionRange:30
    |ProjectileLife:3

    |ProjectileBlastRange:60
    |ProjectileBlastDamageModifier:0.20
    |ProjectileBlastDpModifier:1
)
"""








[hiddenAction_OMNI_GAT_X103_AntiArmorShotgun_Trigger]
alsoTriggerAction:OMNI_GAT_X103_AntiArmorShotgun_Fire
[hiddenAction_OMNI_GAT_X103_AntiArmorShotgun_Fire]
requireConditional:"""
if self.timeAlive>memory.OMNI_GAT_X103_AntiArmorShotgun_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:OMNI_GAT_X103_AntiArmorShotgun_CDTimer=self.timeAlive+${OMNI_GAT_X103_AntiArmorShotgun_CD}
addResources:EN=-${OMNI_GAT_X103_AntiArmorShotgun_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
OMNI_GAT_X103_AntiArmorShotgun_SetWeaponIndex,
PlayCommon_Shoot_Two_Handed_A_L_Step_1,
OMNI_GAT_X103_AntiArmorShotgun_B1_Step_1
"""
[hiddenAction_OMNI_GAT_X103_AntiArmorShotgun_B1_Step_1]
alsoQueueAction:"""
OMNI_GAT_X103_AntiArmorShotgun_Fire_Step_1,
OMNI_GAT_X103_AntiArmorShotgun_Fire_Step_2,
OMNI_GAT_X103_AntiArmorShotgun_Fire_Step_Final
"""




[hiddenAction_OMNI_GAT_X103_AntiArmorShotgun_SetWeaponIndex]
isVisible:false


[hiddenAction_OMNI_GAT_X103_AntiArmorShotgun_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false
"""
buildSpeed:0.35s
whenBuilding_cannotMove:true
[hiddenAction_OMNI_GAT_X103_AntiArmorShotgun_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false
"""
buildSpeed:0.25s
whenBuilding_cannotMove:true
fireTurretXAtGround:OMNI_GAT_X103_AntiArmorShotgun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_OMNI_GAT_X103_AntiArmorShotgun_Fire_Step_Final]
buildSpeed:1.25s
whenBuilding_cannotMove:true
alsoTriggerAction:SetAttackingOff


