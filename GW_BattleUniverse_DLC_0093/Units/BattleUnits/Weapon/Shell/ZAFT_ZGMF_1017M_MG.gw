[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""


@memory ZAFT_ZGMF_1017M_MG_CDTimer:float
@global ZAFT_ZGMF_1017M_MG_CD=2
@global ZAFT_ZGMF_1017M_MG_EN=20





[decal_ZAFT_ZGMF_1017M_MG]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\ZAFT_ZGMF_1017M_MG.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.7
xOffsetRelative: 1
yOffsetRelative: 14
dirOffset:0
[decal_ZAFT_ZGMF_1017M_MG_NotUsing]
@copyFromSection:decal_ZAFT_ZGMF_1017M_MG
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.65
xOffsetRelative:2
yOffsetRelative:-8.5
dirOffset:-90







[turret_ZAFT_ZGMF_1017M_MG]
x:0
y:0

canShoot:false
projectile:ZAFT_ZGMF_1017M_MG_Projectile

delay:0.1s
limitingRange:0

canAttackMaxAngle:15
barrelX:12
barrelY:32

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_1.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_ZAFT_ZGMF_1017M_MG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:550
    |ShellAPDamage:125
    |DpDamage:30
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:80
    |ProjectileSpread:5
    |ProjectileLife:25
)
"""







[hiddenAction_ZAFT_ZGMF_1017M_MG_Trigger]
alsoTriggerAction:ZAFT_ZGMF_1017M_MG_Fire
[hiddenAction_ZAFT_ZGMF_1017M_MG_Fire]
requireConditional:"""
if self.timeAlive>memory.ZAFT_ZGMF_1017M_MG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:ZAFT_ZGMF_1017M_MG_CDTimer=self.timeAlive+${ZAFT_ZGMF_1017M_MG_CD}
addResources:EN=-${ZAFT_ZGMF_1017M_MG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZAFT_ZGMF_1017M_MG_SetWeaponIndex,
ZAFT_ZGMF_1017M_MG_B12_Step_1
"""
[hiddenAction_ZAFT_ZGMF_1017M_MG_B12_Step_1]
alsoQueueAction:"""
ZAFT_ZGMF_1017M_MG_Fire_Step_1,
ZAFT_ZGMF_1017M_MG_Fire_Step_2,
ZAFT_ZGMF_1017M_MG_Fire_Step_3,
ZAFT_ZGMF_1017M_MG_Fire_Step_3,
ZAFT_ZGMF_1017M_MG_Fire_Step_3,
ZAFT_ZGMF_1017M_MG_Fire_Step_3,
ZAFT_ZGMF_1017M_MG_Fire_Step_3,
ZAFT_ZGMF_1017M_MG_Fire_Step_3,
ZAFT_ZGMF_1017M_MG_Fire_Step_3,
ZAFT_ZGMF_1017M_MG_Fire_Step_3,
ZAFT_ZGMF_1017M_MG_Fire_Step_3,
ZAFT_ZGMF_1017M_MG_Fire_Step_3,
ZAFT_ZGMF_1017M_MG_Fire_Step_3,
ZAFT_ZGMF_1017M_MG_Fire_Step_Final
"""





[hiddenAction_ZAFT_ZGMF_1017M_MG_SetWeaponIndex]
isVisible:false


[hiddenAction_ZAFT_ZGMF_1017M_MG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_ZAFT_ZGMF_1017M_MG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZAFT_ZGMF_1017M_MG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_ZAFT_ZGMF_1017M_MG_Fire_Step_3]
@copyFromSection:hiddenAction_ZAFT_ZGMF_1017M_MG_Fire_Step_2
buildSpeed:${turret_ZAFT_ZGMF_1017M_MG.delay}
[hiddenAction_ZAFT_ZGMF_1017M_MG_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


