[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_StandShoot_A.gw
"""

@memory ZN_MS_07C_MG_CDTimer:float
@global ZN_MS_07C_MG_CD=3









[turret_ZN_MS_07C_MG]
x:0
y:0

canShoot:false
projectile:ZN_MS_07C_MG_Projectile

delay:0.1s
limitingRange:0

canAttackMaxAngle:15
barrelX:14
barrelY:10

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_2.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1
[turret_ZN_MS_07C_MG_L]
@copyFromSection:turret_ZN_MS_07C_MG
barrelX:-14



[projectile_ZN_MS_07C_MG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:475
    |DpDamage:40
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=25
    |ProjectileSpeed:85
    |ProjectileSpread:8
    |ProjectileLife:20
)
"""







[hiddenAction_ZN_MS_07C_MG_Trigger]
alsoTriggerAction:ZN_MS_07C_MG_Fire
[hiddenAction_ZN_MS_07C_MG_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MS_07C_MG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:ZN_MS_07C_MG_CDTimer=self.timeAlive+${ZN_MS_07C_MG_CD}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_MS_07C_MG_SetWeaponIndex,
ZN_MS_07C_MG_B10_Step_1
"""
[hiddenAction_ZN_MS_07C_MG_B10_Step_1]
alsoQueueAction:"""
ZN_MS_07C_MG_Fire_Step_1,
ZN_MS_07C_MG_Fire_Step_2,
ZN_MS_07C_MG_Fire_Step_3,
ZN_MS_07C_MG_Fire_Step_3,
ZN_MS_07C_MG_Fire_Step_3,
ZN_MS_07C_MG_Fire_Step_3,
ZN_MS_07C_MG_Fire_Step_3,
ZN_MS_07C_MG_Fire_Step_Final
"""





[hiddenAction_ZN_MS_07C_MG_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MS_07C_MG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
alsoTriggerAction:PlayCommon_StandShoot_A_Step_1
[hiddenAction_ZN_MS_07C_MG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_MS_07C_MG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:ZN_MS_07C_MG_Fire_Step_Sub
[hiddenAction_ZN_MS_07C_MG_Fire_Step_3]
@copyFromSection:hiddenAction_ZN_MS_07C_MG_Fire_Step_2
buildSpeed:${turret_ZN_MS_07C_MG.delay}

[hiddenAction_ZN_MS_07C_MG_Fire_Step_Sub]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_MS_07C_MG_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_ZN_MS_07C_MG_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


