[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_Two_Handed_A.gw
"""

@memory EF_Minigun_CDTimer:float
@global EF_Minigun_CD=7
@global EF_Minigun_EN=50




[decal_EF_Minigun]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Weapon/Shell/Image/EF_Minigun.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.85
xOffsetRelative: 1
yOffsetRelative: 20
dirOffset:0





[turret_EF_Minigun]
x:0
y:0

canShoot:false
projectile:EF_Minigun_Projectile

delay:0.05s
limitingRange:0

canAttackMaxAngle:15
barrelX:12
barrelY:35

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_2.ogg
shoot_sound_vol:0
shoot_flame:MG_Fire_1
[turret_EF_Minigun_L]
@copyFromSection:turret_EF_Minigun
barrelX:9
barrelY:35



[projectile_EF_Minigun_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:750
    |ShellAPDamage:250
    |DpDamage:55
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:85
    |ProjectileSpread:7
    |ProjectileLife:20
)
"""







[hiddenAction_EF_Minigun_Trigger]
alsoTriggerAction:EF_Minigun_Fire
[hiddenAction_EF_Minigun_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_Minigun_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0 
"""
setUnitMemory:EF_Minigun_CDTimer=self.timeAlive+${EF_Minigun_CD}
addResources:EN=-${EF_Minigun_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_Minigun_SetWeaponIndex,
EF_Minigun_B30_Step_1
"""
[hiddenAction_EF_Minigun_B30_Step_1]
alsoQueueAction:"""
EF_Minigun_Fire_Step_1,
EF_Minigun_Fire_Step_2,
EF_Minigun_Fire_Step_4,

EF_Minigun_Fire_Step_3,
EF_Minigun_Fire_Step_4,

EF_Minigun_Fire_Step_3,
EF_Minigun_Fire_Step_4,

EF_Minigun_Fire_Step_3,
EF_Minigun_Fire_Step_4,

EF_Minigun_Fire_Step_3,
EF_Minigun_Fire_Step_4,

EF_Minigun_Fire_Step_3,
EF_Minigun_Fire_Step_4,

EF_Minigun_Fire_Step_3,
EF_Minigun_Fire_Step_4,

EF_Minigun_Fire_Step_3,
EF_Minigun_Fire_Step_4,

EF_Minigun_Fire_Step_3,
EF_Minigun_Fire_Step_4,

EF_Minigun_Fire_Step_3,
EF_Minigun_Fire_Step_4,

EF_Minigun_Fire_Step_3,
EF_Minigun_Fire_Step_4,

EF_Minigun_Fire_Step_3,
EF_Minigun_Fire_Step_4,

EF_Minigun_Fire_Step_3,
EF_Minigun_Fire_Step_4,

EF_Minigun_Fire_Step_3,
EF_Minigun_Fire_Step_4,

EF_Minigun_Fire_Step_3,
EF_Minigun_Fire_Step_4,
EF_Minigun_Fire_Step_Final
"""





[hiddenAction_EF_Minigun_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_Minigun_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
playSoundAtUnit:ROOT:Resource/Sound/SE/Weapon/Fire/Gatling_1.ogg:0.7
alsoTriggerAction:PlayCommon_Shoot_Two_Handed_A_Step_1
[hiddenAction_EF_Minigun_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_Minigun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_Minigun_Fire_Step_3]
@copyFromSection:hiddenAction_EF_Minigun_Fire_Step_2
buildSpeed:${turret_EF_Minigun.delay}

[hiddenAction_EF_Minigun_Fire_Step_4]
@copyFromSection:hiddenAction_EF_Minigun_Fire_Step_2
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:${turret_EF_Minigun.delay}
fireTurretXAtGround:EF_Minigun_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_EF_Minigun_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


