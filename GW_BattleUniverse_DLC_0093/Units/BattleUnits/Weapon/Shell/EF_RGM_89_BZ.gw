[core]
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""
dont_load:false
@memory EF_RGM_89_BZ_CDTimer:float
@global EF_RGM_89_BZ_CD=3.5
@global EF_RGM_89_BZ_EN=40



[decal_EF_RGM_89_BZ]
layer:beforeBody
order:6.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\EF_RGM_89_BZ_0.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.85
xOffsetRelative: 1
yOffsetRelative: 7
dirOffset:0



[decal_EF_RGM_89_BZ_NotUsing]
@copyFromSection:decal_EF_RGM_89_BZ
order:0
basePositionFromLegEnd:arm1
imageScale:0.75
imageScaleY:-1
xOffsetRelative:0
yOffsetRelative:-9.5
dirOffset:90




image:ROOT:Units/BattleUnits/Weapon/Shell/Image/EF_RGM_89_BZ_0.png



[turret_EF_RGM_89_BZ]
x:0
y:0
canShoot:false
projectile:EF_RGM_89_BZ_Projectile
delay:0.3s
canAttackMaxAngle:15
barrelX:10
barrelY:17
limitingRange:0
aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0
shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Bazooka_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_EF_RGM_89_BZ_Projectile]
directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0
lightSize:0
effectOnCreate:none
explodeEffect:none
spawnUnit:"""
Projectile_Bazooka*1
(
    addResources=
    ShellDamage:20000
    |DpDamage:600
    |WeaponAccuracy=80
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:90
    |ProjectileSpread:1
    |ProjectileExplosionRange:30
    |ProjectileLife:35

    |ProjectileBlastRange:60
    |ProjectileBlastDamageModifier:0.20
    |ProjectileBlastDpModifier:1
)
"""



[hiddenAction_EF_RGM_89_BZ_Trigger]
alsoTriggerAction:EF_RGM_89_BZ_Fire



[hiddenAction_EF_RGM_89_BZ_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RGM_89_BZ_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:EF_RGM_89_BZ_CDTimer=self.timeAlive+${EF_RGM_89_BZ_CD}
addResources:EN=-${EF_RGM_89_BZ_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RGM_89_BZ_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
EF_RGM_89_BZ_B1_Step_1
"""



[hiddenAction_EF_RGM_89_BZ_B1_Step_1]
alsoQueueAction:"""
EF_RGM_89_BZ_Fire_Step_1,
EF_RGM_89_BZ_Fire_Step_2,
EF_RGM_89_BZ_Fire_Step_Final
"""



[hiddenAction_EF_RGM_89_BZ_SetWeaponIndex]
isVisible:false



[hiddenAction_EF_RGM_89_BZ_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false 
"""
buildSpeed:0.35s



[hiddenAction_EF_RGM_89_BZ_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RGM_89_BZ
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)



[hiddenAction_EF_RGM_89_BZ_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff
