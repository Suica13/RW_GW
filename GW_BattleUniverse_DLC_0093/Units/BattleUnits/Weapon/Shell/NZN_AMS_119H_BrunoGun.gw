[core]
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/Cannon_Fire_1.gw,
ROOT:Resource/Image/Fx/Common/Common_Flash_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_Two_Handed_A.gw
"""
dont_load:false
@memory NZN_AMS_119H_BrunoGun_CDTimer:float
@global NZN_AMS_119H_BrunoGun_CD=8
@global NZN_AMS_119H_BrunoGun_EN=40



[decal_NZN_AMS_119H_BrunoGun]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\NZN_AMS_119H_BrunoGun.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 4
yOffsetRelative: 20
dirOffset:0



[turret_NZN_AMS_119H_BrunoGun]
x:0
y:0
canShoot:false
projectile:NZN_AMS_119H_BrunoGun_Projectile
delay:0.3s
canAttackMaxAngle:15
barrelX:14
barrelY:38
limitingRange:0
aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0
shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/RailGun_2.ogg
shoot_sound_vol:0.4
shoot_flame:Cannon_Fire_1



[projectile_NZN_AMS_119H_BrunoGun_Projectile]
directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0
lightSize:0
effectOnCreate:none
explodeEffect:none
spawnUnit:"""
Projectile_NZN_AMS_119H_BrunoShell*1
(
    addResources=
    ShellDamage:20000
    |DpDamage:1500
    |WeaponAccuracy=80
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:90
    |ProjectileSpread:0
    |ProjectileExplosionRange:75
    |ProjectileLife:35

    |ProjectileBlastRange:60
    |ProjectileBlastDamageModifier:0.20
    |ProjectileBlastDpModifier:1
)
"""



[hiddenAction_NZN_AMS_119H_BrunoGun_Trigger]
alsoTriggerAction:NZN_AMS_119H_BrunoGun_Fire



[hiddenAction_NZN_AMS_119H_BrunoGun_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_AMS_119H_BrunoGun_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and memory.armLBreaked==false and memory.backpackBreaked==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:NZN_AMS_119H_BrunoGun_CDTimer=self.timeAlive+${NZN_AMS_119H_BrunoGun_CD}
addResources:EN=-${NZN_AMS_119H_BrunoGun_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
NZN_AMS_119H_BrunoGun_SetWeaponIndex,
PlayCommon_Shoot_Two_Handed_A_Step_1,
NZN_AMS_119H_BrunoGun_B1_Step_1
"""



[hiddenAction_NZN_AMS_119H_BrunoGun_B1_Step_1]
alsoQueueAction:"""
NZN_AMS_119H_BrunoGun_Fire_Step_1,
NZN_AMS_119H_BrunoGun_Fire_Step_2,
NZN_AMS_119H_BrunoGun_Fire_Step_Final
"""




spawnEffects:Flash_1_S



[hiddenAction_NZN_AMS_119H_BrunoGun_SetWeaponIndex]
isVisible:false



[hiddenAction_NZN_AMS_119H_BrunoGun_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false and memory.armLBreaked==false and memory.backpackBreaked==false 
"""
buildSpeed:0.75s




whenBuilding_cannotMove:true



[hiddenAction_NZN_AMS_119H_BrunoGun_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false and memory.armLBreaked==false and memory.backpackBreaked==false 
"""
buildSpeed:0s
fireTurretXAtGround:NZN_AMS_119H_BrunoGun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)




whenBuilding_cannotMove:true



[hiddenAction_NZN_AMS_119H_BrunoGun_Fire_Step_Final]
buildSpeed:0.75s
alsoTriggerAction:SetAttackingOff

whenBuilding_cannotMove:true
stopLastAnimation:true



