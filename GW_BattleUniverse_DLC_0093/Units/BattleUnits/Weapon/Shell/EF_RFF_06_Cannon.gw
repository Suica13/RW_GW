[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_Two_Handed_A.gw
"""

@memory EF_RFF_06_Cannon_CDTimer:float
@global EF_RFF_06_Cannon_CD=5
@global EF_RFF_06_Cannon_EN=35





[decal_EF_RFF_06_Cannon]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\EF_RFF_06_Cannon.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.55
xOffsetRelative: 0
yOffsetRelative: 12
dirOffset:0
[decal_EF_RFF_06_Cannon_NotUsing]
@copyFromSection:decal_EF_RFF_06_Cannon
#image:ROOT:Units/BattleUnits/Weapon/Shell/Image/EF_RFF_06_Cannon_Backpack.png
order:0
basePositionFromLegEnd:arm1
imageScale:0.45
imageScaleX:-1
xOffsetRelative:5
yOffsetRelative:-9
dirOffset:-90







[turret_EF_RFF_06_Cannon]
x:0
y:0

canShoot:false
projectile:EF_RFF_06_Cannon_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:10
barrelY:25
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Bazooka_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_EF_RFF_06_Cannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_S_Target*1
(
    addResources=
    ShellDamage:5500
    |DpDamage:200
    |WeaponAccuracy=75
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:70
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:30
)
"""








[hiddenAction_EF_RFF_06_Cannon_Trigger]
alsoTriggerAction:EF_RFF_06_Cannon_Fire
[hiddenAction_EF_RFF_06_Cannon_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RFF_06_Cannon_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:EF_RFF_06_Cannon_CDTimer=self.timeAlive+${EF_RFF_06_Cannon_CD}
addResources:EN=-${EF_RFF_06_Cannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RFF_06_Cannon_SetWeaponIndex,
PlayCommon_Shoot_Two_Handed_A_Step_1,
EF_RFF_06_Cannon_B1_Step_1
"""
[hiddenAction_EF_RFF_06_Cannon_B1_Step_1]
alsoQueueAction:"""
EF_RFF_06_Cannon_Fire_Step_1,
EF_RFF_06_Cannon_Fire_Step_2,
EF_RFF_06_Cannon_Fire_Step_Final
"""




[hiddenAction_EF_RFF_06_Cannon_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RFF_06_Cannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
whenBuilding_cannotMove:true
[hiddenAction_EF_RFF_06_Cannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
whenBuilding_cannotMove:true
fireTurretXAtGround:EF_RFF_06_Cannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_RFF_06_Cannon_Fire_Step_Final]
buildSpeed:0.3s
whenBuilding_cannotMove:true
alsoTriggerAction:SetAttackingOff


