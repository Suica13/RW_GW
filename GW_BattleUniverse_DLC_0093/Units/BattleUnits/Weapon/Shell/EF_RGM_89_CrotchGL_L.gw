[core]
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""
dont_load:false
@memory EF_RGM_89_CrotchGL_L_CDTimer:float
@global EF_RGM_89_CrotchGL_L_CD=6
@global EF_RGM_89_CrotchGL_L_EN=25



[turret_EF_RGM_89_CrotchGL_L]
x:0
y:0
canShoot:false
projectile:EF_RGM_89_CrotchGL_L_Projectile
delay:0.2s
limitingRange:0
canAttackMaxAngle:15
barrelX:-10
barrelY:0
aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0
shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1_S



[projectile_EF_RGM_89_CrotchGL_L_Projectile]
directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0
lightSize:0
effectOnCreate:none
explodeEffect:none
spawnUnit:"""
Projectile_Bazooka_S*1
(
    addResources=
    ShellDamage:4500
    |DpDamage:135
    |WeaponAccuracy=85
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75
    |AntiLand=1 
    |AntiSpace=1 
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:60
    |ProjectileSpread:2
    |ProjectileExplosionRange:35
    |ProjectileLife:25
)
"""



[hiddenAction_EF_RGM_89_CrotchGL_L_Trigger]
alsoTriggerAction:EF_RGM_89_CrotchGL_L_Fire



[hiddenAction_EF_RGM_89_CrotchGL_L_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RGM_89_CrotchGL_L_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_RGM_89_CrotchGL_L_CDTimer=self.timeAlive+${EF_RGM_89_CrotchGL_L_CD}
addResources:EN=-${EF_RGM_89_CrotchGL_L_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RGM_89_CrotchGL_L_SetWeaponIndex,
EF_RGM_89_CrotchGL_L_B2_Step_1
"""



[hiddenAction_EF_RGM_89_CrotchGL_L_B2_Step_1]
alsoQueueAction:"""
EF_RGM_89_CrotchGL_L_Fire_Step_1,
EF_RGM_89_CrotchGL_L_Fire_Step_2,
EF_RGM_89_CrotchGL_L_Fire_Step_3,
EF_RGM_89_CrotchGL_L_Fire_Step_Final
"""



[hiddenAction_EF_RGM_89_CrotchGL_L_SetWeaponIndex]
isVisible:false



[hiddenAction_EF_RGM_89_CrotchGL_L_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.1s



[hiddenAction_EF_RGM_89_CrotchGL_L_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RGM_89_CrotchGL_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:EF_RGM_89_CrotchGL_L_SetWeaponIndex



[hiddenAction_EF_RGM_89_CrotchGL_L_Fire_Step_3]
@copyFromSection:hiddenAction_EF_RGM_89_CrotchGL_L_Fire_Step_2
buildSpeed:${turret_EF_RGM_89_CrotchGL_L.delay}



[hiddenAction_EF_RGM_89_CrotchGL_L_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff
