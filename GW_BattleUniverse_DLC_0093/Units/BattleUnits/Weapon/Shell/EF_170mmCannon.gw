[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_Two_Handed_A.gw
"""

@memory EF_170mmCannon_CDTimer:float
@global EF_170mmCannon_CD=2.5
@global EF_170mmCannon_EN=30





[decal_EF_170mmCannon]
layer:beforeBody
order:3.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\EF_170mmCannon.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.85
xOffsetRelative: 1
yOffsetRelative: 18
dirOffset:0
[decal_EF_170mmCannon_NotUsing]
@copyFromSection:decal_EF_170mmCannon
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\EF_170mmCannon.png
order:0
basePositionFromLegEnd:arm1
imageScale:0.9
imageScaleX:-1
xOffsetRelative:-2
yOffsetRelative:-10
dirOffset:-90







[turret_EF_170mmCannon]
x:0
y:0

canShoot:false
projectile:EF_170mmCannon_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:10
barrelY:20
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Bazooka_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_EF_170mmCannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_S_Target*1
(
    addResources=
    ShellDamage:8000
    |ShellAPDamage:3000
    |DpDamage:450
    |WeaponAccuracy=95
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:95
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:30
)
"""








[hiddenAction_EF_170mmCannon_Trigger]
alsoTriggerAction:EF_170mmCannon_Fire
[hiddenAction_EF_170mmCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_170mmCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:EF_170mmCannon_CDTimer=self.timeAlive+${EF_170mmCannon_CD}
addResources:EN=-${EF_170mmCannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_170mmCannon_SetWeaponIndex,
PlayCommon_Shoot_Two_Handed_A_Step_1,
EF_170mmCannon_B1_Step_1
"""
[hiddenAction_EF_170mmCannon_B1_Step_1]
alsoQueueAction:"""
EF_170mmCannon_Fire_Step_1,
EF_170mmCannon_Fire_Step_2,
EF_170mmCannon_Fire_Step_Final
"""




[hiddenAction_EF_170mmCannon_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_170mmCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
whenBuilding_cannotMove:true
[hiddenAction_EF_170mmCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
whenBuilding_cannotMove:true
fireTurretXAtGround:EF_170mmCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_170mmCannon_Fire_Step_Final]
buildSpeed:0.3s
whenBuilding_cannotMove:true
alsoTriggerAction:SetAttackingOff


