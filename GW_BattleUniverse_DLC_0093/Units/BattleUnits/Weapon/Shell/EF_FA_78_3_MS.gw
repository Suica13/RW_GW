[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""


@memory EF_FA_78_3_MS_CDTimer:float
@global EF_FA_78_3_MS_CD=15
@global EF_FA_78_3_MS_EN=50










[turret_EF_FA_78_3_MS]
x:0
y:0

canShoot:false
projectile:EF_FA_78_3_MS_Projectile

delay:0.075s
limitingRange:0

canAttackMaxAngle:15
barrelX:8
barrelY:-10
idleDir:15

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.25
shoot_flame:BZ_Fire_1_S
[turret_EF_FA_78_3_MS_L]
@copyFromSection:turret_EF_FA_78_3_MS
barrelX:-8
idleDir:-15



[projectile_EF_FA_78_3_MS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS*1
(
    offsetRandomDir=15,
    addResources=
    ShellDamage:2200
    |DpDamage:50
    |WeaponAccuracy=85
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightHitRange=20
    |HeightChangeSpeed=2
    |ProjectileSpeed:35
    |ProjectileTurnspeed:1.5
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:30

    |EquipmentIndex:1
    |EquipmentIndex2:150
)
"""







[hiddenAction_EF_FA_78_3_MS_Trigger]
alsoTriggerAction:EF_FA_78_3_MS_Fire
[hiddenAction_EF_FA_78_3_MS_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_FA_78_3_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_FA_78_3_MS_CDTimer=self.timeAlive+${EF_FA_78_3_MS_CD}
addResources:EN=-${EF_FA_78_3_MS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_FA_78_3_MS_SetWeaponIndex,
EF_FA_78_3_MS_B12_Step_1
"""
[hiddenAction_EF_FA_78_3_MS_B12_Step_1]
alsoQueueAction:"""
EF_FA_78_3_MS_Fire_Step_1,

EF_FA_78_3_MS_Fire_Step_2,
EF_FA_78_3_MS_Fire_Step_4,
EF_FA_78_3_MS_Fire_Step_3,
EF_FA_78_3_MS_Fire_Step_4,
EF_FA_78_3_MS_Fire_Step_3,
EF_FA_78_3_MS_Fire_Step_4,
EF_FA_78_3_MS_Fire_Step_3,
EF_FA_78_3_MS_Fire_Step_4,

EF_FA_78_3_MS_Fire_Step_5,

EF_FA_78_3_MS_Fire_Step_3,
EF_FA_78_3_MS_Fire_Step_4,
EF_FA_78_3_MS_Fire_Step_3,
EF_FA_78_3_MS_Fire_Step_4,

EF_FA_78_3_MS_Fire_Step_Final
"""





[hiddenAction_EF_FA_78_3_MS_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_FA_78_3_MS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
alsoTriggerAction:PlayCommon_Cannon_Shoot_A_Step_1
[hiddenAction_EF_FA_78_3_MS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_FA_78_3_MS
fireTurretXAtGround_withTarget:self.getOffsetRelative(x=250,y=1000)
[hiddenAction_EF_FA_78_3_MS_Fire_Step_3]
@copyFromSection:hiddenAction_EF_FA_78_3_MS_Fire_Step_2
buildSpeed:${turret_EF_FA_78_3_MS.delay}

[hiddenAction_EF_FA_78_3_MS_Fire_Step_4]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_FA_78_3_MS_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(x=-250,y=1000)

[hiddenAction_EF_FA_78_3_MS_Fire_Step_5]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s

[hiddenAction_EF_FA_78_3_MS_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


