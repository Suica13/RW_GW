[core]
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""
dont_load:false
@memory NZN_AMS_119_BR_GL_CDTimer:float
@global NZN_AMS_119_BR_GL_CD=4
@global NZN_AMS_119_BR_GL_EN=25



[turret_NZN_AMS_119_BR_GL]
x:0
y:0
canShoot:false
projectile:NZN_AMS_119_BR_GL_Projectile
delay:0.2s
limitingRange:0
canAttackMaxAngle:15
barrelX:12
barrelY:28
aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0
shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1_S



[projectile_NZN_AMS_119_BR_GL_Projectile]
directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0
lightSize:0
effectOnCreate:none
explodeEffect:none
spawnUnit:"""
Projectile_Bazooka_S*1
(
    addResources=
    ShellDamage:8000
    |DpDamage:250
    |WeaponAccuracy=90
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75
    |AntiLand=1 
    |AntiSpace=1 
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:90
    |ProjectileSpread:2
    |ProjectileExplosionRange:35
    |ProjectileLife:25
)
"""



[hiddenAction_NZN_AMS_119_BR_GL_Trigger]
alsoTriggerAction:NZN_AMS_119_BR_GL_Fire



[hiddenAction_NZN_AMS_119_BR_GL_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_AMS_119_BR_GL_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:NZN_AMS_119_BR_GL_CDTimer=self.timeAlive+${NZN_AMS_119_BR_GL_CD}
addResources:EN=-${NZN_AMS_119_BR_GL_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
NZN_AMS_119_BR_GL_SetWeaponIndex,
NZN_AMS_119_BR_GL_B2_Step_1
"""



[hiddenAction_NZN_AMS_119_BR_GL_B2_Step_1]
alsoQueueAction:"""
NZN_AMS_119_BR_GL_Fire_Step_1,
NZN_AMS_119_BR_GL_Fire_Step_2,
NZN_AMS_119_BR_GL_Fire_Step_3,
NZN_AMS_119_BR_GL_Fire_Step_Final
"""



[hiddenAction_NZN_AMS_119_BR_GL_SetWeaponIndex]
isVisible:false



[hiddenAction_NZN_AMS_119_BR_GL_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false 
"""
buildSpeed:0.1s



[hiddenAction_NZN_AMS_119_BR_GL_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false 
"""
buildSpeed:0s
fireTurretXAtGround:NZN_AMS_119_BR_GL
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_Step_1



[hiddenAction_NZN_AMS_119_BR_GL_Fire_Step_3]
@copyFromSection:hiddenAction_NZN_AMS_119_BR_GL_Fire_Step_2
buildSpeed:${turret_NZN_AMS_119_BR_GL.delay}



[hiddenAction_NZN_AMS_119_BR_GL_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff
