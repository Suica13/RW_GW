[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""


@memory EF_RGZ_91B_MS_CDTimer:float
@global EF_RGZ_91B_MS_CD=20
@global EF_RGZ_91B_MS_EN=60

[turret_EF_RGZ_91B_MS]
x:0
y:0

canShoot:false
projectile:EF_RGZ_91B_MS_Projectile

delay:0.075s
limitingRange:0

canAttackMaxAngle:15
barrelX:16
barrelY:-14

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.15
shoot_flame:BZ_Fire_1_S

[turret_EF_RGZ_91B_MS_L]
@copyFromSection:turret_EF_RGZ_91B_MS
barrelX:-17



projectile:EF_RGZ_91B_MS_Projectile_L

[projectile_EF_RGZ_91B_MS_Projectile]
directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS_Red*1
(
    addResources=
    ShellDamage:1500
    |DpDamage:40
    |WeaponAccuracy=85
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightHitRange=20
    |HeightChangeSpeed=2
    |ProjectileSpeed:25
    |ProjectileTurnspeed:0.75
    |ProjectileSpread:15
    |ProjectileExplosionRange:35
    |ProjectileLife:40

    |EquipmentIndex:1
    |EquipmentIndex2:150
)
"""

[hiddenAction_EF_RGZ_91B_MS_Trigger]
alsoTriggerAction:EF_RGZ_91B_MS_Fire

[hiddenAction_EF_RGZ_91B_MS_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RGZ_91B_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.backpackBreaked==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_RGZ_91B_MS_CDTimer=self.timeAlive+${EF_RGZ_91B_MS_CD}
addResources:EN=-${EF_RGZ_91B_MS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RGZ_91B_MS_SetWeaponIndex,
EF_RGZ_91B_MS_B2_Step_1,
PlayCommon_Cannon_Shoot_A_Step_1
"""

[hiddenAction_EF_RGZ_91B_MS_B2_Step_1]
alsoQueueAction:"""
EF_RGZ_91B_MS_Fire_Step_1,
EF_RGZ_91B_MS_Fire_Step_2,
EF_RGZ_91B_MS_Fire_Step_3,
EF_RGZ_91B_MS_Fire_Step_2,
EF_RGZ_91B_MS_Fire_Step_3,
EF_RGZ_91B_MS_Fire_Step_2,
EF_RGZ_91B_MS_Fire_Step_3,
EF_RGZ_91B_MS_Fire_Step_2,
EF_RGZ_91B_MS_Fire_Step_3,
EF_RGZ_91B_MS_Fire_Step_2,
EF_RGZ_91B_MS_Fire_Step_3,
EF_RGZ_91B_MS_Fire_Step_2,
EF_RGZ_91B_MS_Fire_Step_3,
EF_RGZ_91B_MS_Fire_Step_Final
"""

[hiddenAction_EF_RGZ_91B_MS_SetWeaponIndex]
isVisible:false

[hiddenAction_EF_RGZ_91B_MS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false and memory.backpackBreaked==false 
"""
buildSpeed:0.3s

[hiddenAction_EF_RGZ_91B_MS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false  and memory.backpackBreaked==false
"""
buildSpeed:0.075s
fireTurretXAtGround:EF_RGZ_91B_MS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_EF_RGZ_91B_MS_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false  and memory.backpackBreaked==false
"""
buildSpeed:0.075s
fireTurretXAtGround:EF_RGZ_91B_MS_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_EF_RGZ_91B_MS_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff

[projectile_EF_RGZ_91B_MS_Projectile_L]
@copyFromSection:projectile_EF_RGZ_91B_MS_Projectile
spawnUnit:"""
Projectile_MS_Red*1
(
    addResources=
    ShellDamage:1500
    |DpDamage:40
    |WeaponAccuracy=85
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightHitRange=20
    |HeightChangeSpeed=2
    |ProjectileSpeed:25
    |ProjectileTurnspeed:0.75
    |ProjectileSpread:-15
    |ProjectileExplosionRange:35
    |ProjectileLife:40

    |EquipmentIndex:1
    |EquipmentIndex2:150
)
"""

