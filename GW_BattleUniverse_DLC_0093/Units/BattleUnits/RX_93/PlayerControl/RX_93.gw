requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.EF_RX_93_ShieldBC_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armLBreaked==false and self.shield>0 and ${onSkill}==false and self.resource.EN>0) and (true) and self.resource.EN>=${EF_RX_93_ShieldBC_EN}
