requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.EF_RX_93_BZ_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and ${onSkill}==false and self.resource.EN>0) and (true) and self.resource.EN>=${EF_RX_93_BZ_EN}
alsoTriggerAction:EF_RX_93_BZ_Fire
