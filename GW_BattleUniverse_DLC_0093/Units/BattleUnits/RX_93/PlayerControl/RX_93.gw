[hiddenAction_Common_Push_A_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_RX_93_BR_Fire_Step_3]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_RX_93_BR_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_RX_93_BZ_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_RX_93_ShieldBC_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false and self.shield>0 and self.shield>0) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_RX_93_ShieldMS_Fire_Step_3]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false and self.shield>0 and self.shield>0) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_RX_93_ShieldMS_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false and self.shield>0 and self.shield>0) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_RX_93_BeamSaber_BF_Fire_Step_5]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_RX_93_BeamSaber_BF_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_RX_93_Funnel_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false and memory.backpackBreaked==false and memory.EF_RX_93_Funnel_Units.size==0 and ${onSkill}==false and memory.close==false and self.resource.EN>${EF_RX_93_Funnel_EN} and self.timeAlive>memory.EF_RX_93_Funnel_CDTimer and self.parent.hp<=0  and self.attacking.hp>0 and memory.pilotUnit.readUnitMemory("pilotAwakeningSkillFinal",type="float")>=${EF_RX_93_Funnel_PilotAwakeningSkill})

[action_EF_RX_93_Funnel_Trigger]
pos:30
requireConditional:if (${cantAction}==false and ${onSkill}==false and memory.backpackBreaked==false and memory.EF_RX_93_Funnel_Units.size==0 and self.timeAlive>memory.EF_RX_93_Funnel_CDTimer) and (not memory.manualControlEnabled or ${manualWeaponReady})

[hiddenAction_EF_RX_93_Funnel_Fire_Step_1]
requireConditional:if (${cantAction}==false and memory.backpackBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_RX_93_Funnel_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.backpackBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:if ${onSkill}
alsoTriggerAction:SetOnSkillOff
