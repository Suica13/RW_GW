isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.EF_RX_93_BeamSaber_BF_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false) and (true))
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.EF_RX_93_BeamSaber_BF_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false) and (true)
alsoTriggerAction:EF_RX_93_BeamSaber_BF_Fire
displayType:action

[hiddenAction_EF_RX_93_BeamSaber_BF_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_RX_93_BeamSaber_BF_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and (self.timeAlive>memory.EF_RX_93_BeamSaber_BF_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false) and (true))
