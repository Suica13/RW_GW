[core]
@global manualControlImplemented=true
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw
dont_load:true

# Form-specific input adapters. Native damage, animations and firing queues are inherited.

[action_Manual_NZN_AMX_101_BR]
@copyFromSection:template_ManualWeapon
pos:2
text:Beam rifle
text_zh:光束步枪
description:CD: ${NZN_AMX_101_BR_CD}s
description_zh:冷却: ${NZN_AMX_101_BR_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.NZN_AMX_101_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and self.resource.EN>0) and (memory.armRBreaked==false) and self.resource.EN>=${NZN_AMX_101_BR_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.NZN_AMX_101_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and self.resource.EN>0) and (memory.armRBreaked==false) and self.resource.EN>=${NZN_AMX_101_BR_EN}
alsoTriggerAction:NZN_AMX_101_BR_Fire
displayType:action

[hiddenAction_NZN_AMX_101_BR_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.NZN_AMX_101_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.NZN_AMX_101_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and self.resource.EN>0) and (memory.armRBreaked==false) and self.resource.EN>=${NZN_AMX_101_BR_EN})
addActionCooldownTime:${NZN_AMX_101_BR_CD}s
addActionCooldownApplyToActions:Manual_NZN_AMX_101_BR
setUnitMemory:NZN_AMX_101_BR_CDTimer=self.timeAlive+${NZN_AMX_101_BR_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[action_Manual_NZN_AMX_101_BR_MS]
@copyFromSection:template_ManualWeapon
pos:4
text:Rifle missile
text_zh:步枪导弹
description:CD: ${NZN_AMX_101_BR_MS_CD}s
description_zh:冷却: ${NZN_AMX_101_BR_MS_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.NZN_AMX_101_BR_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0) and (memory.armRBreaked==false) and self.resource.EN>=${NZN_AMX_101_BR_MS_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.NZN_AMX_101_BR_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0) and (memory.armRBreaked==false) and self.resource.EN>=${NZN_AMX_101_BR_MS_EN}
alsoTriggerAction:NZN_AMX_101_BR_MS_Fire
displayType:action

[hiddenAction_NZN_AMX_101_BR_MS_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.NZN_AMX_101_BR_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.NZN_AMX_101_BR_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0) and (memory.armRBreaked==false) and self.resource.EN>=${NZN_AMX_101_BR_MS_EN})
addActionCooldownTime:${NZN_AMX_101_BR_MS_CD}s
addActionCooldownApplyToActions:Manual_NZN_AMX_101_BR_MS
setUnitMemory:NZN_AMX_101_BR_MS_CDTimer=self.timeAlive+${NZN_AMX_101_BR_MS_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

