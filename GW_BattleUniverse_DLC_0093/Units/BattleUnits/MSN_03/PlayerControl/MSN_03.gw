[core]
@global manualControlImplemented=true
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw
dont_load:true

# Form-specific input adapters. Native damage, animations and firing queues are inherited.

[action_Manual_NZN_MSN_03_BR_WGL]
@copyFromSection:template_ManualWeapon
pos:2
text:Beam machine gun
text_zh:光束机枪
description:CD: ${NZN_MSN_03_BR_WGL_CD}s
description_zh:冷却: ${NZN_MSN_03_BR_WGL_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.NZN_MSN_03_BR_WGL_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and self.resource.EN>0) and (true) and self.resource.EN>=${NZN_MSN_03_BR_WGL_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.NZN_MSN_03_BR_WGL_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and self.resource.EN>0) and (true) and self.resource.EN>=${NZN_MSN_03_BR_WGL_EN}
alsoTriggerAction:NZN_MSN_03_BR_WGL_Fire
displayType:action

[hiddenAction_NZN_MSN_03_BR_WGL_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.NZN_MSN_03_BR_WGL_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.NZN_MSN_03_BR_WGL_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and self.resource.EN>0) and (true) and self.resource.EN>=${NZN_MSN_03_BR_WGL_EN})
addActionCooldownTime:${NZN_MSN_03_BR_WGL_CD}s
addActionCooldownApplyToActions:Manual_NZN_MSN_03_BR_WGL
setUnitMemory:NZN_MSN_03_BR_WGL_CDTimer=self.timeAlive+${NZN_MSN_03_BR_WGL_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[action_Manual_NZN_MSN_03_BR_GL]
@copyFromSection:template_ManualWeapon
pos:4
text:Rifle grenade
text_zh:枪榴弹
description:CD: ${NZN_MSN_03_BR_GL_CD}s
description_zh:冷却: ${NZN_MSN_03_BR_GL_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.NZN_MSN_03_BR_GL_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and ${onSkill}==false and self.resource.EN>0) and (true) and self.resource.EN>=${NZN_MSN_03_BR_GL_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.NZN_MSN_03_BR_GL_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and ${onSkill}==false and self.resource.EN>0) and (true) and self.resource.EN>=${NZN_MSN_03_BR_GL_EN}
alsoTriggerAction:NZN_MSN_03_BR_GL_Fire
displayType:action

[hiddenAction_NZN_MSN_03_BR_GL_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.NZN_MSN_03_BR_GL_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.NZN_MSN_03_BR_GL_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and ${onSkill}==false and self.resource.EN>0) and (true) and self.resource.EN>=${NZN_MSN_03_BR_GL_EN})
addActionCooldownTime:${NZN_MSN_03_BR_GL_CD}s
addActionCooldownApplyToActions:Manual_NZN_MSN_03_BR_GL
setUnitMemory:NZN_MSN_03_BR_GL_CDTimer=self.timeAlive+${NZN_MSN_03_BR_GL_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[action_Manual_NZN_MSN_03_ShieldBSG]
@copyFromSection:template_ManualWeapon
pos:5
text:Shield beam cannon
text_zh:盾牌光束炮
description:CD: ${NZN_MSN_03_ShieldBSG_CD}s
description_zh:冷却: ${NZN_MSN_03_ShieldBSG_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.NZN_MSN_03_ShieldBSG_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0 and self.shield>0 and memory.armLBreaked==false) and (true) and self.resource.EN>=${NZN_MSN_03_ShieldBSG_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.NZN_MSN_03_ShieldBSG_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0 and self.shield>0 and memory.armLBreaked==false) and (true) and self.resource.EN>=${NZN_MSN_03_ShieldBSG_EN}
alsoTriggerAction:NZN_MSN_03_ShieldBSG_Fire
displayType:action

[hiddenAction_NZN_MSN_03_ShieldBSG_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.NZN_MSN_03_ShieldBSG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0 and self.shield>0 and memory.armLBreaked==false)) or (${manualWeaponReady} and (self.timeAlive>memory.NZN_MSN_03_ShieldBSG_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0 and self.shield>0 and memory.armLBreaked==false) and (true) and self.resource.EN>=${NZN_MSN_03_ShieldBSG_EN})
addActionCooldownTime:${NZN_MSN_03_ShieldBSG_CD}s
addActionCooldownApplyToActions:Manual_NZN_MSN_03_ShieldBSG
setUnitMemory:NZN_MSN_03_ShieldBSG_CDTimer=self.timeAlive+${NZN_MSN_03_ShieldBSG_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[action_Manual_NZN_MSN_03_BeamSaber_AF_Green]
@copyFromSection:template_ManualWeapon
pos:3
text:Beam saber
text_zh:光束军刀
description:CD: ${NZN_MSN_03_BeamSaber_AF_Green_CD}s
description_zh:冷却: ${NZN_MSN_03_BeamSaber_AF_Green_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.NZN_MSN_03_BeamSaber_AF_Green_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false) and (true))
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.NZN_MSN_03_BeamSaber_AF_Green_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false) and (true)
alsoTriggerAction:NZN_MSN_03_BeamSaber_AF_Green_Fire
displayType:action

[hiddenAction_NZN_MSN_03_BeamSaber_AF_Green_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.NZN_MSN_03_BeamSaber_AF_Green_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and (self.timeAlive>memory.NZN_MSN_03_BeamSaber_AF_Green_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false) and (true))
addActionCooldownTime:${NZN_MSN_03_BeamSaber_AF_Green_CD}s
addActionCooldownApplyToActions:Manual_NZN_MSN_03_BeamSaber_AF_Green
setUnitMemory:NZN_MSN_03_BeamSaber_AF_Green_CDTimer=self.timeAlive+${NZN_MSN_03_BeamSaber_AF_Green_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[hiddenAction_NZN_MSN_03_BR_WGL_Fire_Step_3]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_MSN_03_BR_WGL_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_MSN_03_BR_GL_Fire_Step_3]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_MSN_03_BR_GL_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_MSN_03_ShieldBSG_Fire_Step_4]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false and self.shield>0) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_MSN_03_ShieldBSG_Fire_Step_3]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false and self.shield>0) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_MSN_03_ShieldBSG_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false and self.shield>0) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_MSN_03_BeamSaber_AF_Green_Fire_Step_5]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_MSN_03_BeamSaber_AF_Green_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_MSN_03_Funnel_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false and memory.backpackBreaked==false and memory.NZN_MSN_03_Funnel_Units.size==0 and ${onSkill}==false and memory.close==false and self.resource.EN>${NZN_MSN_03_Funnel_EN} and self.timeAlive>memory.NZN_MSN_03_Funnel_CDTimer and self.parent.hp<=0  and self.attacking.hp>0 and memory.pilotUnit.readUnitMemory("pilotAwakeningSkillFinal",type="float")>=${NZN_MSN_03_Funnel_PilotAwakeningSkill})

[action_NZN_MSN_03_Funnel_Trigger]
pos:30
requireConditional:if (${cantAction}==false and ${onSkill}==false and memory.backpackBreaked==false and memory.NZN_MSN_03_Funnel_Units.size==0 and self.timeAlive>memory.NZN_MSN_03_Funnel_CDTimer) and (not memory.manualControlEnabled or ${manualWeaponReady})

[hiddenAction_NZN_MSN_03_Funnel_Fire_Step_1]
requireConditional:if (${cantAction}==false and memory.backpackBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_MSN_03_Funnel_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.backpackBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:if ${onSkill}
alsoTriggerAction:SetOnSkillOff
