[core]
@global manualControlImplemented=true
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw
dont_load:true

# Form-specific input adapters. Native damage, animations and firing queues are inherited.

[action_Manual_EF_RGZ_91_BWS_DBC]
@copyFromSection:template_ManualWeapon
pos:2
text:Twin beam cannon
text_zh:双联光束炮
description:CD: ${EF_RGZ_91_BWS_DBC_CD}s
description_zh:冷却: ${EF_RGZ_91_BWS_DBC_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.EF_RGZ_91_BWS_DBC_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.backpackBreaked==false and ${onSkill}==false and self.resource.EN>0) and (true) and self.resource.EN>=${EF_RGZ_91_BWS_DBC_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.EF_RGZ_91_BWS_DBC_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.backpackBreaked==false and ${onSkill}==false and self.resource.EN>0) and (true) and self.resource.EN>=${EF_RGZ_91_BWS_DBC_EN}
alsoTriggerAction:EF_RGZ_91_BWS_DBC_Fire
displayType:action

[hiddenAction_EF_RGZ_91_BWS_DBC_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_RGZ_91_BWS_DBC_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.backpackBreaked==false and ${onSkill}==false  and not (directionBetween(self, self.attacking) < self.dir-35 or directionBetween(self, self.attacking) > self.dir+35)  and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.EF_RGZ_91_BWS_DBC_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.backpackBreaked==false and ${onSkill}==false and self.resource.EN>0) and (true) and self.resource.EN>=${EF_RGZ_91_BWS_DBC_EN})
addActionCooldownTime:${EF_RGZ_91_BWS_DBC_CD}s
addActionCooldownApplyToActions:Manual_EF_RGZ_91_BWS_DBC
setUnitMemory:EF_RGZ_91_BWS_DBC_CDTimer=self.timeAlive+${EF_RGZ_91_BWS_DBC_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[action_Manual_EF_RGZ_91B_HighBeamCannon]
@copyFromSection:template_ManualWeapon
pos:4
text:Mega particle cannon
text_zh:大口径米加粒子炮
description:CD: ${EF_RGZ_91B_HighBeamCannon_CD}s
description_zh:冷却: ${EF_RGZ_91B_HighBeamCannon_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.EF_RGZ_91B_HighBeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.backpackBreaked==false and ${onSkill}==false and self.resource.EN>0) and (true) and self.resource.EN>=${EF_RGZ_91B_HighBeamCannon_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.EF_RGZ_91B_HighBeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.backpackBreaked==false and ${onSkill}==false and self.resource.EN>0) and (true) and self.resource.EN>=${EF_RGZ_91B_HighBeamCannon_EN}
alsoTriggerAction:EF_RGZ_91B_HighBeamCannon_Fire
displayType:action

[hiddenAction_EF_RGZ_91B_HighBeamCannon_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_RGZ_91B_HighBeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.backpackBreaked==false   and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.EF_RGZ_91B_HighBeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.backpackBreaked==false and ${onSkill}==false and self.resource.EN>0) and (true) and self.resource.EN>=${EF_RGZ_91B_HighBeamCannon_EN})
addActionCooldownTime:${EF_RGZ_91B_HighBeamCannon_CD}s
addActionCooldownApplyToActions:Manual_EF_RGZ_91B_HighBeamCannon
setUnitMemory:EF_RGZ_91B_HighBeamCannon_CDTimer=self.timeAlive+${EF_RGZ_91B_HighBeamCannon_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[action_Manual_EF_RGZ_91B_MS]
@copyFromSection:template_ManualWeapon
pos:5
text:Missiles
text_zh:导弹
description:CD: ${EF_RGZ_91B_MS_CD}s
description_zh:冷却: ${EF_RGZ_91B_MS_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.EF_RGZ_91B_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.backpackBreaked==false and ${onSkill}==false and self.resource.EN>0) and (true) and self.resource.EN>=${EF_RGZ_91B_MS_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.EF_RGZ_91B_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.backpackBreaked==false and ${onSkill}==false and self.resource.EN>0) and (true) and self.resource.EN>=${EF_RGZ_91B_MS_EN}
alsoTriggerAction:EF_RGZ_91B_MS_Fire
displayType:action

[hiddenAction_EF_RGZ_91B_MS_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_RGZ_91B_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.backpackBreaked==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.EF_RGZ_91B_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.backpackBreaked==false and ${onSkill}==false and self.resource.EN>0) and (true) and self.resource.EN>=${EF_RGZ_91B_MS_EN})
addActionCooldownTime:${EF_RGZ_91B_MS_CD}s
addActionCooldownApplyToActions:Manual_EF_RGZ_91B_MS
setUnitMemory:EF_RGZ_91B_MS_CDTimer=self.timeAlive+${EF_RGZ_91B_MS_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[hiddenAction_EF_RGZ_91_BWS_DBC_Fire_Step_3]
requireConditional:if (${cantAction}==false and memory.backpackBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_RGZ_91_BWS_DBC_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.backpackBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_RGZ_91B_HighBeamCannon_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.backpackBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_RGZ_91B_MS_Fire_Step_3]
requireConditional:if (${cantAction}==false  and memory.backpackBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_EF_RGZ_91B_MS_Fire_Step_2]
requireConditional:if (${cantAction}==false  and memory.backpackBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[action_ManualControl_TransformA]
@copyFromSection:action_Transform_LandFlyA
pos:0
autoTrigger:false
isVisible:if memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=0 and not self.hasTags(includes='inHangar'))
requireConditional:if ${manualControlReady} and (true) and not memory.cantTransform and self.timeAlive>=memory.changeTransform_LandFlyCD and ${cantAction}==false and ${onSkill}==false

[action_ManualControl_TransformB]
@copyFromSection:action_Transform_LandFlyB
pos:0
autoTrigger:false
isVisible:if memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=96 and memory.styleIndex!=100 and not self.hasTags(includes='inHangar'))
requireConditional:if ${manualControlReady} and (true) and not memory.cantTransform and self.timeAlive>=memory.changeTransform_LandFlyCD and ${cantAction}==false and ${onSkill}==false

[action_ManualControl_FirstSlot]
isVisible:false
