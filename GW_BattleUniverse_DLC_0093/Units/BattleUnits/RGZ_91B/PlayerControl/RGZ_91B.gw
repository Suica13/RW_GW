[core]
@global manualControlImplemented=true
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw
dont_load:true

# Form-specific input adapters. Native damage, animations and firing queues are inherited.

[action_Manual_Common_ArmGL_L]
@copyFromSection:template_ManualWeapon
pos:4
text:Arm grenade launcher
text_zh:腕部榴弹
description:CD: ${Common_ArmGL_L_CD}s
description_zh:冷却: ${Common_ArmGL_L_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.Common_ArmGL_L_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armLBreaked==false and ${onSkill}==false and self.resource.EN>0) and (true) and self.resource.EN>=${Common_ArmGL_L_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.Common_ArmGL_L_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armLBreaked==false and ${onSkill}==false and self.resource.EN>0) and (true) and self.resource.EN>=${Common_ArmGL_L_EN}
alsoTriggerAction:Common_ArmGL_L_Fire
displayType:action

[hiddenAction_Common_ArmGL_L_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_ArmGL_L_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armLBreaked==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.Common_ArmGL_L_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armLBreaked==false and ${onSkill}==false and self.resource.EN>0) and (true) and self.resource.EN>=${Common_ArmGL_L_EN})
addActionCooldownTime:${Common_ArmGL_L_CD}s
addActionCooldownApplyToActions:Manual_Common_ArmGL_L
setUnitMemory:Common_ArmGL_L_CDTimer=self.timeAlive+${Common_ArmGL_L_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[action_Manual_EF_RGZ_91B_BeamSaber_AF_Large_Yellow]
@copyFromSection:template_ManualWeapon
pos:3
text:Beam saber
text_zh:光束军刀
description:CD: ${EF_RGZ_91B_BeamSaber_AF_Large_Yellow_CD}s
description_zh:冷却: ${EF_RGZ_91B_BeamSaber_AF_Large_Yellow_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.EF_RGZ_91B_BeamSaber_AF_Large_Yellow_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false) and (true))
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.EF_RGZ_91B_BeamSaber_AF_Large_Yellow_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false) and (true)
alsoTriggerAction:EF_RGZ_91B_BeamSaber_AF_Large_Yellow_Fire
displayType:action

[hiddenAction_EF_RGZ_91B_BeamSaber_AF_Large_Yellow_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_RGZ_91B_BeamSaber_AF_Large_Yellow_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false  and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and (self.timeAlive>memory.EF_RGZ_91B_BeamSaber_AF_Large_Yellow_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false) and (true))
addActionCooldownTime:${EF_RGZ_91B_BeamSaber_AF_Large_Yellow_CD}s
addActionCooldownApplyToActions:Manual_EF_RGZ_91B_BeamSaber_AF_Large_Yellow
setUnitMemory:EF_RGZ_91B_BeamSaber_AF_Large_Yellow_CDTimer=self.timeAlive+${EF_RGZ_91B_BeamSaber_AF_Large_Yellow_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[action_Manual_Common_Push_A]
@copyFromSection:template_ManualWeapon
pos:5
text:Punch
text_zh:徒手格斗
description:CD: ${Common_Push_A_CD}s
description_zh:冷却: ${Common_Push_A_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and memory.armRBreaked
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false) and (memory.armRBreaked==true))
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false) and (memory.armRBreaked==true)
alsoTriggerAction:Common_Push_A_Fire
displayType:action

[hiddenAction_Common_Push_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false) and (memory.armRBreaked==true))
addActionCooldownTime:${Common_Push_A_CD}s
addActionCooldownApplyToActions:Manual_Common_Push_A
setUnitMemory:Common_Push_A_CDTimer=self.timeAlive+${Common_Push_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

