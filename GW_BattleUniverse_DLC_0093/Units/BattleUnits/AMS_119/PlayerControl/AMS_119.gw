[core]
@global manualControlImplemented=true
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw
dont_load:true

# Form-specific input adapters. Native damage, animations and firing queues are inherited.

[action_Manual_Common_Push_A]
@copyFromSection:template_ManualWeapon
pos:4
text:Punch
text_zh:徒手格斗
description:CD: ${Common_Push_A_CD}s
description_zh:冷却: ${Common_Push_A_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and memory.armRBreaked
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false) and (memory.armRBreaked==true))
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false) and (memory.armRBreaked==true)
alsoTriggerAction:Common_Push_A_Fire
displayType:action

[hiddenAction_Common_Push_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false) and (memory.armRBreaked==true))
addActionCooldownTime:${Common_Push_A_CD}s
addActionCooldownApplyToActions:Manual_Common_Push_A
setUnitMemory:Common_Push_A_CDTimer=self.timeAlive+${Common_Push_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[action_Manual_NZN_AMS_119_BR_WGL]
@copyFromSection:template_ManualWeapon
pos:2
text:Beam machine gun
text_zh:光束机枪
description:CD: ${NZN_AMS_119_BR_WGL_CD}s
description_zh:冷却: ${NZN_AMS_119_BR_WGL_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.NZN_AMS_119_BR_WGL_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and self.resource.EN>0) and (true) and self.resource.EN>=${NZN_AMS_119_BR_WGL_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.NZN_AMS_119_BR_WGL_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and self.resource.EN>0) and (true) and self.resource.EN>=${NZN_AMS_119_BR_WGL_EN}
alsoTriggerAction:NZN_AMS_119_BR_WGL_Fire
displayType:action

[hiddenAction_NZN_AMS_119_BR_WGL_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.NZN_AMS_119_BR_WGL_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.NZN_AMS_119_BR_WGL_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and self.resource.EN>0) and (true) and self.resource.EN>=${NZN_AMS_119_BR_WGL_EN})
addActionCooldownTime:${NZN_AMS_119_BR_WGL_CD}s
addActionCooldownApplyToActions:Manual_NZN_AMS_119_BR_WGL
setUnitMemory:NZN_AMS_119_BR_WGL_CDTimer=self.timeAlive+${NZN_AMS_119_BR_WGL_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

