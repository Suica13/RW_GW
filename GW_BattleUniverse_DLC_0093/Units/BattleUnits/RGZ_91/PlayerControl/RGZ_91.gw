addActionCooldownApplyToActions:Manual_Common_ArmGL_L
setUnitMemory:Common_ArmGL_L_CDTimer=self.timeAlive+${Common_ArmGL_L_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

