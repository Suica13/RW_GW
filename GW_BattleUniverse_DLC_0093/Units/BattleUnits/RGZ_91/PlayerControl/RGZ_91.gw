[core]
@global manualControlImplemented=true
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw
dont_load:true

# Form-specific input adapters. Native damage, animations and firing queues are inherited.

[action_Manual_EF_RGZ_91_BR]
@copyFromSection:template_ManualWeapon
pos:2
text:Beam rifle
text_zh:光束步枪
description:CD: ${EF_RGZ_91_BR_CD}s
description_zh:冷却: ${EF_RGZ_91_BR_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.EF_RGZ_91_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and self.resource.EN>0) and (true) and self.resource.EN>=${EF_RGZ_91_BR_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.EF_RGZ_91_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and self.resource.EN>0) and (true) and self.resource.EN>=${EF_RGZ_91_BR_EN}
alsoTriggerAction:EF_RGZ_91_BR_Fire
displayType:action

[hiddenAction_EF_RGZ_91_BR_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_RGZ_91_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.EF_RGZ_91_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and self.resource.EN>0) and (true) and self.resource.EN>=${EF_RGZ_91_BR_EN})
addActionCooldownTime:${EF_RGZ_91_BR_CD}s
addActionCooldownApplyToActions:Manual_EF_RGZ_91_BR
setUnitMemory:EF_RGZ_91_BR_CDTimer=self.timeAlive+${EF_RGZ_91_BR_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[action_Manual_Common_ArmGL_L]
