isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.Common_ArmGL_L_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armLBreaked==false and ${onSkill}==false and self.resource.EN>0) and (${onAttacking}==false) and self.resource.EN>=${Common_ArmGL_L_EN})
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.Common_ArmGL_L_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armLBreaked==false and ${onSkill}==false and self.resource.EN>0) and (${onAttacking}==false) and self.resource.EN>=${Common_ArmGL_L_EN}
alsoTriggerAction:Common_ArmGL_L_Fire
displayType:action

[hiddenAction_Common_ArmGL_L_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_ArmGL_L_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armLBreaked==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and (self.timeAlive>memory.Common_ArmGL_L_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armLBreaked==false and ${onSkill}==false and self.resource.EN>0) and (${onAttacking}==false) and self.resource.EN>=${Common_ArmGL_L_EN})
