[core]
dont_load:true
@memory manualShipArcGroup:float

[action_ManualShip_ArcGroup]
@copyFromSection:template_ManualWeapon
pos:70
text:Arcs: %{select(memory.manualShipArcGroup==0,'Beam',select(memory.manualShipArcGroup==1,'Torpedo',select(memory.manualShipArcGroup==2,'AA','Off')))}
text_zh:射界：%{select(memory.manualShipArcGroup==0,'光束炮',select(memory.manualShipArcGroup==1,'鱼雷',select(memory.manualShipArcGroup==2,'防空','关闭')))}
description:Cycle beam / torpedo / AA / off. Shown only while selected. Reloading mounts are dimmed.
description_zh:切换光束炮／鱼雷／防空／关闭。仅选中时显示；装填中的炮位调暗。
isLocked:false
requireConditional:if ${manualControlReady}
setUnitMemory:manualShipArcGroup=(memory.manualShipArcGroup+1)%4

[template_ManualShip_ArcLine]
layer:shadow
order:0
onlyTeam:own
onlyWhenSelectedByOwnPlayer:true
onlyOnNonPreview:true
onlyWhileAlive:true
lineWidth:1

[template_ManualShip_Arc_SalamisClassKai_0093_EFSF_Turret_BeamCannon_M1]
@copyFromSection:template_ManualShip_ArcLine
color:#66AAFF
isVisible:if ${manualControlReady} and memory.hideUI==0 and memory.manualShipArcGroup==0 and self.attachment(slot='SalamisClassKai_0093_EFSF_Turret_BeamCannon_M1').hp>0 and not self.attachment(slot='SalamisClassKai_0093_EFSF_Turret_BeamCannon_M1').readUnitMemory('breaked',type='bool')
alpha:select(not self.attachment(slot='SalamisClassKai_0093_EFSF_Turret_BeamCannon_M1').readUnitMemory('SalamisClassKai_0093_EFSF_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='SalamisClassKai_0093_EFSF_Turret_BeamCannon_M1').resource.SalamisClassKai_0093_EFSF_Turret_BeamCannon_ShootTimer>0,0.55,0.15)

