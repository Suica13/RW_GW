[hiddenAction_NZN_AMX_107_ShieldBSG_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.NZN_AMX_107_ShieldBSG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0 and self.shield>0)) or (${manualWeaponReady} and (self.timeAlive>memory.NZN_AMX_107_ShieldBSG_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>0 and self.shield>0) and (memory.armLBreaked==false and self.shield>0) and self.resource.EN>=${NZN_AMX_107_ShieldBSG_EN})
