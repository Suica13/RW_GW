[action_Manual_EF_BeamSaber_AF_Large_Yellow]
@copyFromSection:template_ManualWeapon
pos:3
text:Beam saber
text_zh:光束军刀
description:CD: ${EF_BeamSaber_AF_Large_Yellow_CD}s
description_zh:冷却: ${EF_BeamSaber_AF_Large_Yellow_CD}秒
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualWeaponReady} and (self.timeAlive>memory.EF_BeamSaber_AF_Large_Yellow_CDTimer and ${onAttacking}==false and ${cantAction}==false) and (memory.armRBreaked==false))
requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.EF_BeamSaber_AF_Large_Yellow_CDTimer and ${onAttacking}==false and ${cantAction}==false) and (memory.armRBreaked==false)
alsoTriggerAction:EF_BeamSaber_AF_Large_Yellow_Fire
displayType:action

[hiddenAction_EF_BeamSaber_AF_Large_Yellow_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_BeamSaber_AF_Large_Yellow_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and (self.timeAlive>memory.EF_BeamSaber_AF_Large_Yellow_CDTimer and ${onAttacking}==false and ${cantAction}==false) and (memory.armRBreaked==false))
addActionCooldownTime:${EF_BeamSaber_AF_Large_Yellow_CD}s
addActionCooldownApplyToActions:Manual_EF_BeamSaber_AF_Large_Yellow
