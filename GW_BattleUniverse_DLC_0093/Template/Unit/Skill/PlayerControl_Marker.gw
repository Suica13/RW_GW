[core]
dont_load:true

# Ground-anchored control marker: own green, other allies yellow, enemies red.
# Native fog visibility still applies; no extra attachment or unit is created.
[template_ManualControl_Star]
layer:shadow
order:-10000
onlyTeam:allyNotOwn
onlyOnNonPreview:true
onlyWhileAlive:true
onlyWhenSelectedByOwnPlayer:false
color:#FFD45A
alpha:0.95
lineWidth:3
isVisible:if ${manualControlReady}

[decal_ManualControl_Star_0]
@copyFromSection:template_ManualControl_Star
basePosition:self.getOffsetAbsolute(x=0.000000*select(self.hasTags(includes='Ship'),90,42),y=-1.000000*select(self.hasTags(includes='Ship'),90,42),height=-self.height)
drawLineTo:self.getOffsetAbsolute(x=0.224514*select(self.hasTags(includes='Ship'),90,42),y=-0.309017*select(self.hasTags(includes='Ship'),90,42),height=-self.height)

