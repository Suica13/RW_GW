[core]
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Light_1.gw
"""
dont_load:false


[hiddenAction_FuseUnit_A]

addActionCooldownTime:0
buildSpeed:0s

pos:1000
spawnEffects:Light_75_NotAttached
playSoundAtUnit:ROOT:Resource/Sound/SE/Action/Common/Transform_4.ogg:0.6


setUnitMemory:"""
selfDetectedTimer=0
"""
temporarilyRemoveTags:CanBeDetected
temporarilyAddTags:UnDetected
alsoTriggerAction:"""
Send_ForceUnload_TransportUnits,
SetAttackingOff,
FuseUnit_A_Send
"""

[hiddenAction_FuseUnit_A_Send]
sendMessageTo:self
sendMessageWithTags:TryFuseUnit_A

[hiddenAction_FuseUnit_A_Step2]
autoTriggerOnEvent:newMessage(withTag="TryFuseUnit_A")
convertTo_keepCurrentTags:false
convertTo_keepCurrentFields:"""
selfRegenRate,
shieldRegen,
maxEnergy,
armour,
mass,
movespeed,
maxTurnSpeed,
maxAttackRange,
nanoRange,
fogOfWarSightRange,
nanoFactorySpeed,
targetHeight
"""
stopLastAnimation:true
alsoTriggerAction:Send_TryClearQueued,Send_TryTransform_FuseUnit_A


[hiddenAction_Send_TryTransform_FuseUnit_A]
@copyFromSection:hiddenAction_Send_TryTransform
sendMessageWithData:"""
RecoverHp=0,
RecoverHpPer=1,
RecoverShield=0,
RecoverShieldPer=1,
RecoverEn=0,
RecoverEnPer=1,
ResetTags=1,
ChangeType=0
"""


[effect_Light_75_NotAttached]
