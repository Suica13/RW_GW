[core]
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Light_1.gw
"""
dont_load:false


[action_EnterDeployMode]
pos:1

buildSpeed:3s
tags:Upgrade

highPriorityQueue:true
allowMultipleInQueue:false
canPlayerCancel:true
alwaysSinglePress:true
ai_isDisabled:true
extraLagHidingInUI:true

displayType:infoOnly

text:Enter Deploy Mode
text_zh:进入部署模式

isVisible:if memory.close==false and memory.styleIndex!=98 and not self.hasTags(includes='inHangar')

iconImage:ROOT:Resource/Image/Units/Button/Action/Transform_1.png

spawnEffects:Light_50

isLockedAlt2:if ${cantAction}==true 
isLockedAlt2Message:Cant Action
isLockedAlt2Message_zh:无法行动

#convertTo:
convertTo_keepCurrentTags:true
convertTo_keepCurrentFields:"""
selfRegenRate,
shieldRegen,
maxEnergy,
armour,
mass,
movespeed,
maxTurnSpeed,
maxAttackRange,
nanoRange,
fogOfWarSightRange,
nanoFactorySpeed,
targetHeight
"""

setUnitMemory:styleIndex=98

clearAllWaypoints:true

whenBuilding_triggerAction:SetAttackingOff
alsoTriggerAction:Send_TryClearQueued,Send_TryTransform

[action_ExitDeployMode]
@copyFromSection:action_EnterDeployMode

text:Exit Deploy Mode
text_zh:退出部署模式

isVisible:if memory.close==false and memory.styleIndex!=0 and memory.styleIndex!=100 and not self.hasTags(includes='inHangar')
iconImage:ROOT:Resource/Image/Units/Button/Action/Transform_2.png

#convertTo:

setUnitMemory:styleIndex=0