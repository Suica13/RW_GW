isLocked:if not ${manualAuxiliaryReady} or ${onSkill} or (select(self.attachment(slot='SalamisClassKai_0093_EFSF_Turret_AMS_L1').hp>0 and self.attachment(slot='SalamisClassKai_0093_EFSF_Turret_AMS_L1').attacking.hp>0 and not self.attachment(slot='SalamisClassKai_0093_EFSF_Turret_AMS_L1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClassKai_0093_EFSF_Turret_AMS_L1').readUnitMemory('SalamisClassKai_0093_EFSF_Turret_AMS_OnCD',type='bool') and self.attachment(slot='SalamisClassKai_0093_EFSF_Turret_AMS_L1').resource.SalamisClassKai_0093_EFSF_Turret_AMS_ShootTimer>0,1,0)+select(self.attachment(slot='SalamisClassKai_0093_EFSF_Turret_AMS_R1').hp>0 and self.attachment(slot='SalamisClassKai_0093_EFSF_Turret_AMS_R1').attacking.hp>0 and not self.attachment(slot='SalamisClassKai_0093_EFSF_Turret_AMS_R1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClassKai_0093_EFSF_Turret_AMS_R1').readUnitMemory('SalamisClassKai_0093_EFSF_Turret_AMS_OnCD',type='bool') and self.attachment(slot='SalamisClassKai_0093_EFSF_Turret_AMS_R1').resource.SalamisClassKai_0093_EFSF_Turret_AMS_ShootTimer>0,1,0))<=0 or self.resource.EN<=0
requireConditional:if ${manualAuxiliaryReady} and ${onSkill}==false
alsoTriggerAction:ManualShip_Send_SalamisClassKai_0093_EFSF_Turret_AMS_L1,ManualShip_Send_SalamisClassKai_0093_EFSF_Turret_AMS_R1

[hiddenAction_ManualShip_Send_SalamisClassKai_0093_EFSF_Turret_AMS_L1]
sendMessageTo:self.attachment(slot='SalamisClassKai_0093_EFSF_Turret_AMS_L1')
sendMessageWithTags:ManualShip_Torpedo
sendMessageWithData:owner=self,controller=memory.manualControlHQ,serial=memory.manualVulcanSerial

[hiddenAction_ManualShip_Send_SalamisClassKai_0093_EFSF_Turret_AMS_R1]
sendMessageTo:self.attachment(slot='SalamisClassKai_0093_EFSF_Turret_AMS_R1')
sendMessageWithTags:ManualShip_Torpedo
sendMessageWithData:owner=self,controller=memory.manualControlHQ,serial=memory.manualVulcanSerial

[attachment_SalamisClassKai_0093_EFSF_Turret_AMS_L1]
resetRotationWhenNotAttacking:true

[attachment_SalamisClassKai_0093_EFSF_Turret_AMS_R1]
resetRotationWhenNotAttacking:true

