[core]
dont_load:true
@memory manualShipTarget:unit
@memory manualShipHQ:unit
@memory manualShipSerial:float
@memory manualShipOrderUntil:float
@memory manualShipRemaining:float
@memory manualShipNextShotAt:float
@memory manualShipReserved:bool
@memory manualShipPermitControlled:bool
@global manualShipAuthorized=(parent.hp>0 and self.hp>0 and not memory.breaked and parent.teamId==self.teamId and parent.hasTags(includes='ManualControlled') and not parent.hasTags(includes='inHangar') and memory.manualShipHQ.hp>0 and memory.manualShipHQ.teamId==self.teamId and memory.manualShipHQ.hasTags(includes='HQ_NotCaptured') and memory.manualShipHQ.readUnitMemory('manualControlledUnit',type='unit')==parent and parent.readUnitMemory('manualControlHQ',type='unit')==memory.manualShipHQ and parent.readUnitMemory('manualVulcanSerial',type='float')==memory.manualShipSerial and not parent.readUnitMemory('battleUnitCore',type='unit').readUnitMemory('cantAction',type='bool') and not parent.readUnitMemory('battleUnitCore',type='unit').readUnitMemory('onSkill',type='bool'))
@global manualShipOrderReady=((parent.hp>0 and self.hp>0 and not memory.breaked and parent.teamId==self.teamId and parent.hasTags(includes='ManualControlled') and not parent.hasTags(includes='inHangar') and memory.manualShipHQ.hp>0 and memory.manualShipHQ.teamId==self.teamId and memory.manualShipHQ.hasTags(includes='HQ_NotCaptured') and memory.manualShipHQ.readUnitMemory('manualControlledUnit',type='unit')==parent and parent.readUnitMemory('manualControlHQ',type='unit')==memory.manualShipHQ and parent.readUnitMemory('manualVulcanSerial',type='float')==memory.manualShipSerial and not parent.readUnitMemory('battleUnitCore',type='unit').readUnitMemory('cantAction',type='bool') and not parent.readUnitMemory('battleUnitCore',type='unit').readUnitMemory('onSkill',type='bool')) and self.timeAlive<memory.manualShipOrderUntil and memory.manualShipRemaining>0 and (self.attacking.hp<=0 or (self.attacking.hp>0 and not self.attacking.hasTags(includes='UnDetected') and distanceBetween(self,self.attacking)<=600 and (cos(directionBetween(self,self.attacking)-self.dir)>=cos(90)))))

[resource_ManualShipShotPermit]
hidden:true

[turret_SalamisClassKai_0093_EFSF_Turret_AA_2]
canAttackCondition:if (not parent.hasTags(includes='ManualControlled') or self.timeAlive>=memory.manualShipNextShotAt) and (${onAttacking}==false and ${cantAction}==false  and (parent.resource().en>0 or memory.manualShipReserved) and (not memory.manualShipReserved or not parent.hasTags(includes='ManualControlled') or ${manualShipOrderReady}))
resourceUsage:SalamisClassKai_0093_EFSF_Turret_AA_2_ShootTimer=1,ManualShipShotPermit=1
onShoot_triggerActions:ManualShip_Consumed

[hiddenAction_ManualShip_Order]
autoTriggerOnEvent:newMessage(withTag='ManualShip_AA')
requireConditional:if eventData('owner',type='unit')==parent and parent.hasTags(includes='ManualControlled') and eventData('controller',type='unit').hp>0 and eventData('controller',type='unit').readUnitMemory('manualControlledUnit',type='unit')==parent and eventData('serial',type='float')==parent.readUnitMemory('manualVulcanSerial',type='float') and self.hp>0 and not memory.breaked and not memory.SalamisClassKai_0093_EFSF_Turret_AA_2_OnCD and self.resource.SalamisClassKai_0093_EFSF_Turret_AA_2_ShootTimer>0 and memory.manualShipRemaining<=0
setUnitMemory:manualShipTarget=self.attacking,manualShipHQ=eventData('controller',type='unit'),manualShipSerial=eventData('serial',type='float'),manualShipOrderUntil=self.timeAlive+5,manualShipRemaining=self.resource.SalamisClassKai_0093_EFSF_Turret_AA_2_ShootTimer

# Native resourceUsage is checked at firing, separately from native target/arc selection.
# Prepay one shot atomically; cancelled unused permission returns the same EN cost.
[hiddenAction_ManualShip_ReserveShot]
autoTriggerCheckRate:everyFrame
autoTrigger:if (not parent.hasTags(includes='ManualControlled') or self.timeAlive>=memory.manualShipNextShotAt) and self.hp>0 and parent.hp>0 and not memory.breaked and not parent.hasTags(includes='inHangar') and not memory.manualShipReserved and self.resource.ManualShipShotPermit<=0 and (self.attacking.hp>0 and not self.attacking.hasTags(includes='UnDetected') and distanceBetween(self,self.attacking)<=600 or (parent.hasTags(includes='ManualControlled') and self.attacking.hp<=0)) and not memory.SalamisClassKai_0093_EFSF_Turret_AA_2_OnCD and self.resource.SalamisClassKai_0093_EFSF_Turret_AA_2_ShootTimer>0 and (${onAttacking}==false and ${cantAction}==false  and parent.resource().en>0) and (not parent.hasTags(includes='ManualControlled') or ${manualShipOrderReady})
takeResources:EN=${SalamisClassKai_0093_EFSF_Turret_AA_2_EN}
takeResources_includeParent:true
takeResources_excludeUnitsWithoutAllResources:true
takeResources_discardCollected:true
takeResources_maxUnits:1
takeResources_triggerActionIfAnyCollected:ManualShip_Permit

[hiddenAction_ManualShip_Permit]
setUnitMemory:manualShipReserved=true,manualShipPermitControlled=parent.hasTags(includes='ManualControlled')
setResourcesWithLogic:ManualShipShotPermit=1

alsoTriggerAction:ManualShip_BlindShot

[hiddenAction_ManualShip_Consumed]
setUnitMemory:manualShipReserved=false,manualShipRemaining=max(0,memory.manualShipRemaining-1),manualShipNextShotAt=self.timeAlive+0.2

[hiddenAction_ManualShip_Refund]
requireConditional:if memory.manualShipReserved and self.resource.ManualShipShotPermit>0
sendMessageTo:parent
sendMessageWithTags:UseEN
sendMessageWithData:useEN=-${SalamisClassKai_0093_EFSF_Turret_AA_2_EN}
setUnitMemory:manualShipReserved=false
setResourcesWithLogic:ManualShipShotPermit=0

[hiddenAction_ManualShip_Hold]
autoTriggerOnEvent:newMessage(withTag='ManualShip_Hold')
requireConditional:if eventData('owner',type='unit')==parent
setUnitMemory:manualShipOrderUntil=0,manualShipRemaining=0
alsoTriggerAction:ManualShip_Refund

[hiddenAction_ManualShip_Cancel]
autoTriggerCheckRate:everyFrame
autoTrigger:if (memory.manualShipOrderUntil>0 and (not ${manualShipOrderReady})) or (memory.manualShipReserved and (self.hp<=0 or parent.hp<=0 or memory.breaked or (not parent.hasTags(includes='ManualControlled') and (self.attacking.hp<=0 or self.attacking.hasTags(includes='UnDetected') or distanceBetween(self,self.attacking)>600)) or parent.hasTags(includes='inHangar') or memory.manualShipPermitControlled!=parent.hasTags(includes='ManualControlled')))
setUnitMemory:manualShipOrderUntil=0,manualShipRemaining=0
alsoTriggerAction:ManualShip_Refund

# No target: force the original muzzle to fire, preserving the engine's actual turret angle.
# Forced shots bypass resourceUsage and native shot-delay timers, so account for both explicitly.
[hiddenAction_ManualShip_BlindShot]
autoTriggerCheckRate:everyFrame
autoTrigger:if self.attacking.hp<=0 and memory.manualShipReserved and self.resource.ManualShipShotPermit>0 and self.timeAlive>=memory.manualShipNextShotAt and ${manualShipOrderReady} and (${onAttacking}==false and ${cantAction}==false  and (parent.resource().en>0 or memory.manualShipReserved) and (not memory.manualShipReserved or not parent.hasTags(includes='ManualControlled') or ${manualShipOrderReady}))
requireConditional:if self.attacking.hp<=0 and memory.manualShipReserved and self.resource.ManualShipShotPermit>0 and self.resource.SalamisClassKai_0093_EFSF_Turret_AA_2_ShootTimer>0 and self.timeAlive>=memory.manualShipNextShotAt and ${manualShipOrderReady} and (${onAttacking}==false and ${cantAction}==false  and (parent.resource().en>0 or memory.manualShipReserved) and (not memory.manualShipReserved or not parent.hasTags(includes='ManualControlled') or ${manualShipOrderReady}))
addResources:SalamisClassKai_0093_EFSF_Turret_AA_2_ShootTimer=-1,ManualShipShotPermit=-1
fireTurretXAtGround:SalamisClassKai_0093_EFSF_Turret_AA_2
fireTurretXAtGround_withTarget:self
fireTurretXAtGround_withProjectile:ManualShip_Blind_SalamisClassKai_0093_EFSF_Turret_AA_2_Projectile

# Native firing seeds az from the turret barrel. Prevent the zero-life emitter from turning
# toward the dummy ground coordinate before it spawns the unchanged Battle Universe projectile unit.
[projectile_ManualShip_Blind_SalamisClassKai_0093_EFSF_Turret_AA_2_Projectile]
@copyFromSection:projectile_SalamisClassKai_0093_EFSF_Turret_AA_2_Projectile
turnSpeed:0
turnSpeedWhenNear:0
