[hiddenAction_NZN_MSN_04_DoubleSaber_Fire_Step_3]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false and memory.armLBreaked==false and memory.armLBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_MSN_04_DoubleSaber_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false and memory.armLBreaked==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_MSN_04_Funnel_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false and memory.backpackBreaked==false and memory.NZN_MSN_04_Funnel_Units.size==0 and ${onSkill}==false and memory.close==false and self.resource.EN>${NZN_MSN_04_Funnel_EN} and self.timeAlive>memory.NZN_MSN_04_Funnel_CDTimer and self.parent.hp<=0  and self.attacking.hp>0 and memory.pilotUnit.readUnitMemory("pilotAwakeningSkillFinal",type="float")>=${NZN_MSN_04_Funnel_PilotAwakeningSkill})

[action_NZN_MSN_04_Funnel_Trigger]
pos:30
requireConditional:if (${cantAction}==false and ${onSkill}==false and memory.backpackBreaked==false and memory.NZN_MSN_04_Funnel_Units.size==0 and self.timeAlive>memory.NZN_MSN_04_Funnel_CDTimer) and (not memory.manualControlEnabled or ${manualWeaponReady})

[hiddenAction_NZN_MSN_04_Funnel_Fire_Step_1]
requireConditional:if (${cantAction}==false and memory.backpackBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_MSN_04_Funnel_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.backpackBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:if ${onSkill}
alsoTriggerAction:SetOnSkillOff
