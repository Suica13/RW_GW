requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.NZN_AMS_119H_Panzerfaust_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armLBreaked==false and self.shield>0 and ${onSkill}==false and self.resource.EN>0) and (true) and self.resource.EN>=${NZN_AMS_119H_Panzerfaust_EN}
