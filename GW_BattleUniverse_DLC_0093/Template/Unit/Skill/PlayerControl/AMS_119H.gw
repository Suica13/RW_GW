addActionCooldownApplyToActions:Manual_NZN_AMS_119H_Panzerfaust
setUnitMemory:manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)

[action_Manual_NZN_AMS_119H_BeamSaber_AF]
