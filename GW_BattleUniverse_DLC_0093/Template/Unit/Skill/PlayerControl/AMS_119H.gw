requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.NZN_AMS_119H_BeamSaber_AF_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and (self.timeAlive>memory.NZN_AMS_119H_BeamSaber_AF_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false) and (true))
