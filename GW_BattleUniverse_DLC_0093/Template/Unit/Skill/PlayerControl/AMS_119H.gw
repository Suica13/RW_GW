requireConditional:if ${manualWeaponReady} and (self.timeAlive>memory.NZN_AMS_119H_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and memory.armRBreaked==false and self.resource.EN>0) and (true) and self.resource.EN>=${NZN_AMS_119H_BR_EN}
