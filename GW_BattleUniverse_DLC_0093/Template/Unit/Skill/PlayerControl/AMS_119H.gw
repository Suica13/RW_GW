[hiddenAction_Common_Push_A_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_AMS_119H_BrunoGun_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false and memory.armLBreaked==false and memory.backpackBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_AMS_119H_BR_Fire_Step_3]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_AMS_119H_BR_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_AMS_119H_Panzerfaust_Fire_Step_3]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false and self.shield>0) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_AMS_119H_Panzerfaust_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false and self.shield>0) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_AMS_119H_BeamSaber_AF_Fire_Step_5]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))

[hiddenAction_NZN_AMS_119H_BeamSaber_AF_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or (${manualControlReady} and not self.hasTags(includes='ManualGuardActive')))
