[core]
dont_load:true

# Independent of the scenario ChoseFaction template: no faction unlock marker is created.
[action_ChoseFaction_PMC]
pos:203
text:PMC
text_zh:PMC
description:Independent contractor HQ. No starting units, construction or research. Borrow an allied unit for direct control.
description_zh:独立 PMC 指挥部。无初始部队、无建筑建造、科技树暂为空白。可临时借用友军单位进行直接控制。
iconImage:ROOT:Resource/Image/Units/Button/Action/AI_2.png
buildSpeed:0s
displayType:action
highPriorityQueue:true
allowMultipleInQueue:false
canPlayerCancel:false
alwaysSinglePress:true
ai_isDisabled:true
isAlsoViewableByAllies:true
isVisible:if memory.gameReady and (not memory.readyOK or self.resource.FactionIndex==9900101) and self.resource.GameStart==0
requireConditional:if not memory.readyOK and self.resource.GameStart==0
setResourcesWithLogic:FactionIndex=9900101
temporarilyAddTags:PMC
addGlobalTeamTags:PMC
alsoTriggerAction:ReadyOK

# Do not depend on the scenario ConvertToFaction chain: it may have set its one-shot flag already.
[hiddenAction_ConvertToFaction_PMC]
autoTrigger:if self.resource.GameStart==1 and self.resource.FactionIndex==9900101
convertTo:HQ_PMC
attachments_addNewUnits:TechTree_Core_PMC
attachments_onlyOnSlots:TechTreeMarkerSlot
setUnitMemory:gameStartChangeFaction=true
