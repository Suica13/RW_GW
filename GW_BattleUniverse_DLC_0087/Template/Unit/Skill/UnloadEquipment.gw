[core]
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Light_1.gw
"""
dont_load:false


[action_UnloadEquipment]
pos:1

buildSpeed:0s
tags:Upgrade

highPriorityQueue:true
allowMultipleInQueue:false
canPlayerCancel:true
alwaysSinglePress:true
ai_isDisabled:true
extraLagHidingInUI:true

displayType:infoOnly

text:Unload Equipment
text_zh:卸载装备

isVisible:if memory.close==false and not self.hasTags(includes='inHangar')

iconImage:ROOT:Resource/Image/Units/Button/Action/Transform_1.png

spawnEffects:Light_50

isLockedAlt2:if ${cantAction}==true 
isLockedAlt2Message:Cant Action
isLockedAlt2Message_zh:无法行动

#convertTo:
convertTo_keepCurrentTags:true
convertTo_keepCurrentFields:"""
selfRegenRate,
shieldRegen,
maxEnergy,
armour,
mass,
movespeed,
maxTurnSpeed,
maxAttackRange,
nanoRange,
fogOfWarSightRange,
nanoFactorySpeed,
targetHeight
"""


#clearAllWaypoints:true

whenBuilding_triggerAction:SetAttackingOff
alsoTriggerAction:Send_TryClearQueued,Send_TryTransform_UnloadEquipment


[hiddenAction_Send_TryTransform_UnloadEquipment]
@copyFromSection:hiddenAction_Send_TryTransform
sendMessageWithData:"""
RecoverHp=0,
RecoverHpPer=0,
RecoverShield=0,
RecoverShieldPer=0,
RecoverEn=0,
RecoverEnPer=0.5
"""