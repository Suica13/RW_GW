setUnitMemory:EF_HypeBazookaKai_0087_CDTimer=self.timeAlive+${EF_HypeBazookaKai_0087_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
