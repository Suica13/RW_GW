requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_HypeBazookaKai_0087_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false)))) and self.resource.EN>=${EF_HypeBazookaKai_0087_EN}
