[turret_Common_DoubleVulcan_MS_Beam_Blue]
canAttackCondition:if not memory.manualControlEnabled and (${cantAction}==false and distanceBetween(self,self.attacking)<=600  and memory.headBreaked==false and (    attacking.tags(includes='Aircraft')     or attacking.tags(includes='Tank')     or attacking.tags(includes='Pilot')     or memory.attackMode==1))

[action_ManualAux_Common_DoubleVulcan_MS_Beam_Blue]
@copyFromSection:template_ManualWeapon
pos:40
text:Head beam guns
text_zh:头部光束炮
description:Independent burst; primary weapons remain available.
description_zh:独立点射，可同时使用主武器。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Ciws_1.png
isVisible:if ${manualControlReady}
isLocked:if not (${manualAuxiliaryReady} and not memory.headBreaked and not memory.Common_DoubleVulcan_MS_Beam_Blue_OnCD and self.resource.Common_DoubleVulcan_MS_Beam_Blue_ShootTimer>0)
requireConditional:if ${manualAuxiliaryReady} and not memory.headBreaked and not memory.Common_DoubleVulcan_MS_Beam_Blue_OnCD and self.resource.Common_DoubleVulcan_MS_Beam_Blue_ShootTimer>0
alsoTriggerAction:ManualAux_Common_DoubleVulcan_MS_Beam_Blue_Fire

[hiddenAction_ManualAux_Common_DoubleVulcan_MS_Beam_Blue_Fire]
requireConditional:if ${manualAuxiliaryReady} and not memory.headBreaked and not memory.Common_DoubleVulcan_MS_Beam_Blue_OnCD and self.resource.Common_DoubleVulcan_MS_Beam_Blue_ShootTimer>0
setUnitMemory:manualVulcanRightNext=false,manualVulcanSerial=memory.manualVulcanSerial+1,Common_DoubleVulcan_MS_Beam_Blue_OnCD=true,Common_DoubleVulcan_MS_Beam_Blue_CDTimer=self.timeAlive+${Common_DoubleVulcan_MS_Beam_Blue_CD}+self.resource.Common_DoubleVulcan_MS_Beam_Blue_ShootTimer*0.075
spawnUnits:ManualAuxBurst_0087_Common_DoubleVulcan_MS_Beam_Blue

[hiddenAction_ManualAux_Common_DoubleVulcan_MS_Beam_Blue_Shot]
autoTriggerOnEvent:newMessage(withTag='ManualAuxShot_Common_DoubleVulcan_MS_Beam_Blue')
requireConditional:if ${manualAuxiliaryReady} and eventData('burstSerial',type='float')==memory.manualVulcanSerial and not memory.headBreaked and self.resource.Common_DoubleVulcan_MS_Beam_Blue_ShootTimer>0
alsoTriggerAction:ManualAux_Common_DoubleVulcan_MS_Beam_Blue_Left,ManualAux_Common_DoubleVulcan_MS_Beam_Blue_Right,ManualAux_Common_DoubleVulcan_MS_Beam_Blue_Spend

[turret_ManualAux_Common_DoubleVulcan_MS_Beam_Blue_Left]
@copyFromSection:turret_Common_DoubleVulcan_MS_Beam_Blue
canShoot:false
barrelX:-3
barrelOffsetX_onOddShots:0

[hiddenAction_ManualAux_Common_DoubleVulcan_MS_Beam_Blue_Left]
requireConditional:if not memory.manualVulcanRightNext
fireTurretXAtGround:ManualAux_Common_DoubleVulcan_MS_Beam_Blue_Left
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[turret_ManualAux_Common_DoubleVulcan_MS_Beam_Blue_Right]
@copyFromSection:turret_Common_DoubleVulcan_MS_Beam_Blue
canShoot:false
barrelX:3
barrelOffsetX_onOddShots:0

[hiddenAction_ManualAux_Common_DoubleVulcan_MS_Beam_Blue_Right]
requireConditional:if memory.manualVulcanRightNext
fireTurretXAtGround:ManualAux_Common_DoubleVulcan_MS_Beam_Blue_Right
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_ManualAux_Common_DoubleVulcan_MS_Beam_Blue_Spend]
setUnitMemory:manualVulcanRightNext=not memory.manualVulcanRightNext
addResources:Common_DoubleVulcan_MS_Beam_Blue_ShootTimer=-1

[hiddenAction_TryAttack]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_AttackMode_Cqb_WhenHasTarget]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_LowPartsForceCqbMode]
requireConditional:if not memory.manualControlEnabled and (memory.attackMode==0 and memory.armRBreaked==true and memory.armLBreaked==true)

[hiddenAction_ResetTargetTags_Step2]
alsoTriggerAction:ManualControl_AfterTransform,ManualControl_RestoreGuard

[action_ChangeAttackRuleMode_Free]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==0 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Guard]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==1 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Hold]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==2 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Shoot]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==0 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Cqb]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==1 and not self.hasTags(includes='inHangar'))

[action_AllowAIOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAI}==false and not self.hasTags(includes='inHangar'))

[action_AllowAssignedOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAssigned}==false and not self.hasTags(includes='inHangar'))
