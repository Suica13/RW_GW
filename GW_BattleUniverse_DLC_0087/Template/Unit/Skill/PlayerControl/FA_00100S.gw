isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSaber_Double_BBLDF_Yellow_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((not ((memory.armRBreaked==true) and (memory.armLBreaked==true)))))))
