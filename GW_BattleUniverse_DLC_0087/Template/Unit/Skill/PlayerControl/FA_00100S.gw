requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.AEUG_FA_00100S_MS_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.backpackBreaked==false)))) and self.resource.EN>=${AEUG_FA_00100S_MS_EN}
