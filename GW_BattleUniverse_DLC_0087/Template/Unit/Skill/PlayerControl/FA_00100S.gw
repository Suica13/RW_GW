[core]
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_AEUG_FA_00100S_MegaBeamCannon_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false and ${onSkill}==false and self.timeAlive>memory.AEUG_FA_00100S_MegaBeamCannon_CDTimer and not self.hasTags(includes='inHangar') and not parent.hasTags(includes='SFS_Slot') and self.resource.en>${AEUG_FA_00100S_MegaBeamCannon_EN} and memory.AEUG_FA_00100S_MegaBeamCannon_AimTarget.hp>0)

[hiddenAction_AEUG_FA_00100S_MegaBeamCannon_Fire_Step_1]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_AEUG_FA_00100S_MegaBeamCannon_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_Push_A_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60   and memory.armRBreaked==true)

[hiddenAction_Common_Push_A_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_AEUG_FA_00100S_DoubleBeamCannon_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>120 and distanceBetween(self,self.attacking)<=memory.finalAttackRange and memory.backpackBreaked==false and eventData("RandomWeapon",type="float")<=30)

[hiddenAction_AEUG_FA_00100S_DoubleBeamCannon_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_AEUG_FA_00100S_DoubleBeamCannon_Fire_Step_4]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_AEUG_FA_00100S_MS_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>120 and distanceBetween(self,self.attacking)<=memory.finalAttackRange and memory.backpackBreaked==false and eventData("RandomWeapon",type="float")<=45  and eventData("RandomWeapon",type="float")>30)

[hiddenAction_AEUG_FA_00100S_MS_Fire_Step_2]
requireConditional:if (${cantAction}==false  and memory.backpackBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_AEUG_FA_00100S_MS_Fire_Step_3]
requireConditional:if (${cantAction}==false  and memory.backpackBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_AEUG_FA_00100S_BR_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and memory.armRBreaked==false and eventData("RandomWeapon",type="float")>45)

[hiddenAction_AEUG_FA_00100S_BR_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_AEUG_FA_00100S_BR_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_BeamSaber_Double_BBLDF_Yellow_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60   and not (    memory.armRBreaked==true     and     memory.armLBreaked==true))

[hiddenAction_EF_BeamSaber_Double_BBLDF_Yellow_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_BeamSaber_Double_BBLDF_Yellow_Fire_Step_5]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_BeamSaber_Double_BBLDF_Yellow_Fire_Step_8]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_BeamSaber_Double_BBLDF_Yellow_Fire_Step_9]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[action_ExitUnit]
pos:81

[action_AEUG_FA_00100S_MegaBeamCannon_Trigger]
pos:30
requireConditional:if (true) and (not memory.manualControlEnabled or ${manualWeaponReady})

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff

[action_Manual_Common_Push_A]
@copyFromSection:template_ManualWeapon
pos:4
text:Punch
text_zh:徒手格斗
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==true))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true))))
alsoTriggerAction:Common_Push_A_Fire

[hiddenAction_Common_Push_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
setUnitMemory:Common_Push_A_CDTimer=self.timeAlive+${Common_Push_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_Push_A_CD}s
addActionCooldownApplyToActions:Manual_Common_Push_A

[action_Manual_AEUG_FA_00100S_DoubleBeamCannon]
@copyFromSection:template_ManualWeapon
pos:5
text:Beam cannon
text_zh:光束炮
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
isVisible:if ${manualControlReady} and ((((memory.backpackBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.AEUG_FA_00100S_DoubleBeamCannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.backpackBreaked==false)))) and self.resource.EN>=${AEUG_FA_00100S_DoubleBeamCannon_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.AEUG_FA_00100S_DoubleBeamCannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.backpackBreaked==false)))) and self.resource.EN>=${AEUG_FA_00100S_DoubleBeamCannon_EN}
alsoTriggerAction:AEUG_FA_00100S_DoubleBeamCannon_Fire

[hiddenAction_AEUG_FA_00100S_DoubleBeamCannon_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.AEUG_FA_00100S_DoubleBeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.AEUG_FA_00100S_DoubleBeamCannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.backpackBreaked==false)))) and self.resource.EN>=${AEUG_FA_00100S_DoubleBeamCannon_EN})
setUnitMemory:AEUG_FA_00100S_DoubleBeamCannon_CDTimer=self.timeAlive+${AEUG_FA_00100S_DoubleBeamCannon_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${AEUG_FA_00100S_DoubleBeamCannon_CD}s
addActionCooldownApplyToActions:Manual_AEUG_FA_00100S_DoubleBeamCannon

