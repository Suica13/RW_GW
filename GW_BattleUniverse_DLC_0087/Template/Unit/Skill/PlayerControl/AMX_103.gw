[core]
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_Common_Push_A_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60   and memory.armRBreaked==true)

[hiddenAction_Common_Push_A_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_ArmBR_Yellow_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and ${onAttacking}==false and memory.armRBreaked==false and eventData("RandomWeapon",type="float")>50)

[hiddenAction_Common_ArmBR_Yellow_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_ArmBR_Yellow_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_ArmBR_Yellow_L_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and ${onAttacking}==false and memory.armRBreaked==true and memory.armLBreaked==false and eventData("RandomWeapon",type="float")>50)

[hiddenAction_Common_ArmBR_Yellow_L_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_ArmBR_Yellow_L_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_NZN_AMX_103_ShieldBSG_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and memory.armLBreaked==false and self.shield>0 and eventData("RandomWeapon",type="float")<=50)

[hiddenAction_NZN_AMX_103_ShieldBSG_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false and self.shield>0) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_NZN_AMX_103_ShieldBSG_Fire_Step_3]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false and self.shield>0) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_NZN_AMX_103_ShieldBSG_Fire_Step_4]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false and self.shield>0) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_BeamSaber_AF_Large_Yellow_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60   and memory.armRBreaked==false)

[hiddenAction_EF_BeamSaber_AF_Large_Yellow_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_BeamSaber_AF_Large_Yellow_Fire_Step_5]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff

[action_Manual_Common_Push_A]
@copyFromSection:template_ManualWeapon
pos:4
text:Punch
text_zh:徒手格斗
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==true))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true))))
alsoTriggerAction:Common_Push_A_Fire

[hiddenAction_Common_Push_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
setUnitMemory:Common_Push_A_CDTimer=self.timeAlive+${Common_Push_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_Push_A_CD}s
addActionCooldownApplyToActions:Manual_Common_Push_A

[action_Manual_Common_ArmBR_Yellow]
@copyFromSection:template_ManualWeapon
pos:2
text:Arm beam gun
text_zh:手臂光束枪
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady} and ((((true) and (memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmBR_Yellow_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==false)))) and self.resource.EN>=${Common_ArmBR_Yellow_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmBR_Yellow_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==false)))) and self.resource.EN>=${Common_ArmBR_Yellow_EN}
alsoTriggerAction:Common_ArmBR_Yellow_Fire

[hiddenAction_Common_ArmBR_Yellow_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_ArmBR_Yellow_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmBR_Yellow_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==false)))) and self.resource.EN>=${Common_ArmBR_Yellow_EN})
setUnitMemory:Common_ArmBR_Yellow_CDTimer=self.timeAlive+${Common_ArmBR_Yellow_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_ArmBR_Yellow_CD}s
addActionCooldownApplyToActions:Manual_Common_ArmBR_Yellow

[action_Manual_Common_ArmBR_Yellow_L]
@copyFromSection:template_ManualWeapon
pos:5
text:Arm beam gun (left)
text_zh:手臂光束枪（左）
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady} and ((((true) and (memory.armRBreaked==true) and (memory.armLBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmBR_Yellow_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==true) and (memory.armLBreaked==false)))) and self.resource.EN>=${Common_ArmBR_Yellow_L_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmBR_Yellow_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==true) and (memory.armLBreaked==false)))) and self.resource.EN>=${Common_ArmBR_Yellow_L_EN}
alsoTriggerAction:Common_ArmBR_Yellow_L_Fire

[hiddenAction_Common_ArmBR_Yellow_L_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_ArmBR_Yellow_L_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmBR_Yellow_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==true) and (memory.armLBreaked==false)))) and self.resource.EN>=${Common_ArmBR_Yellow_L_EN})
setUnitMemory:Common_ArmBR_Yellow_L_CDTimer=self.timeAlive+${Common_ArmBR_Yellow_L_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_ArmBR_Yellow_L_CD}s
addActionCooldownApplyToActions:Manual_Common_ArmBR_Yellow_L

[action_Manual_NZN_AMX_103_ShieldBSG]
@copyFromSection:template_ManualWeapon
pos:6
text:Beam cannon
text_zh:光束炮
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
isVisible:if ${manualControlReady} and ((((memory.armLBreaked==false) and (self.shield>0))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.NZN_AMX_103_ShieldBSG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0) and (self.shield>0)) and ((((memory.armLBreaked==false) and (self.shield>0)))) and self.resource.EN>=${NZN_AMX_103_ShieldBSG_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.NZN_AMX_103_ShieldBSG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0) and (self.shield>0)) and ((((memory.armLBreaked==false) and (self.shield>0)))) and self.resource.EN>=${NZN_AMX_103_ShieldBSG_EN}
alsoTriggerAction:NZN_AMX_103_ShieldBSG_Fire

[hiddenAction_NZN_AMX_103_ShieldBSG_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.NZN_AMX_103_ShieldBSG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0 and self.shield>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.NZN_AMX_103_ShieldBSG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0) and (self.shield>0)) and ((((memory.armLBreaked==false) and (self.shield>0)))) and self.resource.EN>=${NZN_AMX_103_ShieldBSG_EN})
setUnitMemory:NZN_AMX_103_ShieldBSG_CDTimer=self.timeAlive+${NZN_AMX_103_ShieldBSG_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${NZN_AMX_103_ShieldBSG_CD}s
addActionCooldownApplyToActions:Manual_NZN_AMX_103_ShieldBSG

[action_Manual_EF_BeamSaber_AF_Large_Yellow]
@copyFromSection:template_ManualWeapon
pos:3
text:Beam saber
text_zh:光束军刀
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSaber_AF_Large_Yellow_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSaber_AF_Large_Yellow_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false))))
alsoTriggerAction:EF_BeamSaber_AF_Large_Yellow_Fire

[hiddenAction_EF_BeamSaber_AF_Large_Yellow_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_BeamSaber_AF_Large_Yellow_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSaber_AF_Large_Yellow_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false)))))
setUnitMemory:EF_BeamSaber_AF_Large_Yellow_CDTimer=self.timeAlive+${EF_BeamSaber_AF_Large_Yellow_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
