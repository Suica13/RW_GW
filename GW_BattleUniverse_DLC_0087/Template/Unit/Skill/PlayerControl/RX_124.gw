isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.TITANS_ShieldBoostedRifle_Winch_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.TITANS_ShieldBoostedRifle_Winch_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false))))
alsoTriggerAction:TITANS_ShieldBoostedRifle_Winch_Fire

[hiddenAction_TITANS_ShieldBoostedRifle_Winch_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.TITANS_ShieldBoostedRifle_Winch_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15))) or (${manualWeaponReady} and ((self.timeAlive>memory.TITANS_ShieldBoostedRifle_Winch_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false)))))
setUnitMemory:TITANS_ShieldBoostedRifle_Winch_CDTimer=self.timeAlive+${TITANS_ShieldBoostedRifle_Winch_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
