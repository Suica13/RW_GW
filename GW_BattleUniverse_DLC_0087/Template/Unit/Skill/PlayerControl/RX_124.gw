requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.TITANS_ShieldBoostedRifle_Cqb_BF_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false) and (memory.TITANS_ShieldBoostedRifle_Winch_Unit.hp<=0))))
