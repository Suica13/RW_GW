isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSaber_BF_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false) and (memory.TITANS_ShieldBoostedRifle_Winch_Unit.hp>0)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSaber_BF_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false) and (memory.TITANS_ShieldBoostedRifle_Winch_Unit.hp>0))))
alsoTriggerAction:EF_BeamSaber_BF_Fire

[hiddenAction_EF_BeamSaber_BF_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_BeamSaber_BF_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSaber_BF_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false) and (memory.TITANS_ShieldBoostedRifle_Winch_Unit.hp>0)))))
setUnitMemory:EF_BeamSaber_BF_CDTimer=self.timeAlive+${EF_BeamSaber_BF_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
