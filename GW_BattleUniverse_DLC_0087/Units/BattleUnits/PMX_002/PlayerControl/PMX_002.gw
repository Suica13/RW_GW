iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((memory.armLBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.TITANS_PMX_002_BeamHawk_A_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armLBreaked==false)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.TITANS_PMX_002_BeamHawk_A_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armLBreaked==false))))
alsoTriggerAction:TITANS_PMX_002_BeamHawk_A_L_Fire
displayType:action

[hiddenAction_TITANS_PMX_002_BeamHawk_A_L_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.TITANS_PMX_002_BeamHawk_A_L_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.TITANS_PMX_002_BeamHawk_A_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armLBreaked==false)))))
setUnitMemory:TITANS_PMX_002_BeamHawk_A_L_CDTimer=self.timeAlive+${TITANS_PMX_002_BeamHawk_A_L_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
