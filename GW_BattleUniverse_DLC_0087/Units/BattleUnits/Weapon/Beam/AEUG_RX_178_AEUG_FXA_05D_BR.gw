[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory AEUG_RX_178_AEUG_FXA_05D_BR_CDTimer:float
@global AEUG_RX_178_AEUG_FXA_05D_BR_CD=4
@global AEUG_RX_178_AEUG_FXA_05D_BR_EN=75



[decal_AEUG_RX_178_AEUG_FXA_05D_BR]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Weapon/Beam/Image/AEUG_RX_178_AEUG_FXA_05D_BR.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.85
imageScaleX:1.15
xOffsetRelative: 1
yOffsetRelative: 22
dirOffset:0


[turret_AEUG_RX_178_AEUG_FXA_05D_BR]
x:0
y:0

canShoot:false
projectile:AEUG_RX_178_AEUG_FXA_05D_BR_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:9
barrelY:40
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamCannon_2.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Pink



[projectile_AEUG_RX_178_AEUG_FXA_05D_BR_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_AP_BeamRifle_Pink*1
(
    addResources=
    BeamDamage:12000
    |BeamAPDamage:6000
    |DpDamage:500
    |WeaponAccuracy=100
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:100
    |ProjectileSpread:1
    |ProjectileLife:25

    |ProjectileAttackTimes:3
    |ProjectileAttackTimesDamageModifier:0.75
)
"""





[hiddenAction_AEUG_RX_178_AEUG_FXA_05D_BR_Trigger]
alsoTriggerAction:AEUG_RX_178_AEUG_FXA_05D_BR_Fire
[hiddenAction_AEUG_RX_178_AEUG_FXA_05D_BR_Fire]
requireConditional:"""
if self.timeAlive>memory.AEUG_RX_178_AEUG_FXA_05D_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:AEUG_RX_178_AEUG_FXA_05D_BR_CDTimer=self.timeAlive+${AEUG_RX_178_AEUG_FXA_05D_BR_CD}
addResources:EN=-${AEUG_RX_178_AEUG_FXA_05D_BR_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
AEUG_RX_178_AEUG_FXA_05D_BR_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
AEUG_RX_178_AEUG_FXA_05D_BR_B1_Step_1
"""
[hiddenAction_AEUG_RX_178_AEUG_FXA_05D_BR_B1_Step_1]
alsoQueueAction:"""
AEUG_RX_178_AEUG_FXA_05D_BR_Fire_Step_1,
AEUG_RX_178_AEUG_FXA_05D_BR_Fire_Step_2,
AEUG_RX_178_AEUG_FXA_05D_BR_Fire_Step_Final
"""



[hiddenAction_AEUG_RX_178_AEUG_FXA_05D_BR_SetWeaponIndex]
isVisible:false


[hiddenAction_AEUG_RX_178_AEUG_FXA_05D_BR_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_AEUG_RX_178_AEUG_FXA_05D_BR_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:AEUG_RX_178_AEUG_FXA_05D_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_AEUG_RX_178_AEUG_FXA_05D_BR_Fire_Step_Final]
buildSpeed:0.35s
alsoTriggerAction:SetAttackingOff

