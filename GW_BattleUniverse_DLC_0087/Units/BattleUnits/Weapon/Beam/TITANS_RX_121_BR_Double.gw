[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/Common_DoubleShoot_A_Light.gw
"""

@memory TITANS_RX_121_BR_Double_CDTimer:float
@global TITANS_RX_121_BR_Double_CD=2
@global TITANS_RX_121_BR_Double_EN=45





[decal_TITANS_RX_121_BR_Double]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Weapon/Beam/Image/TITANS_RX_121_BR.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 1
yOffsetRelative: 13
dirOffset:0
[decal_TITANS_RX_121_BR_Double_L]
@copyFromSection:decal_TITANS_RX_121_BR_Double
basePositionFromLegEnd:arm3
xOffsetRelative: -1






[turret_TITANS_RX_121_BR_Double]
x:0
y:0

canShoot:false
projectile:TITANS_RX_121_BR_Double_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:9
barrelY:20
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_3.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Fire_1_Pink
[turret_TITANS_RX_121_BR_Double_L]
@copyFromSection:turret_TITANS_RX_121_BR_Double
barrelX:-9


[projectile_TITANS_RX_121_BR_Double_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamRifle_Pink*1
(
    addResources=
    BeamDamage:4000
    |DpDamage:175
    |WeaponAccuracy=85
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:85
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""





[hiddenAction_TITANS_RX_121_BR_Double_Trigger]
alsoTriggerAction:TITANS_RX_121_BR_Double_Fire
[hiddenAction_TITANS_RX_121_BR_Double_Fire]
requireConditional:"""
if self.timeAlive>memory.TITANS_RX_121_BR_Double_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:TITANS_RX_121_BR_Double_CDTimer=self.timeAlive+${TITANS_RX_121_BR_Double_CD}
addResources:EN=-${TITANS_RX_121_BR_Double_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
TITANS_RX_121_BR_Double_SetWeaponIndex,
TITANS_RX_121_BR_Double_B4_Step_1
"""
[hiddenAction_TITANS_RX_121_BR_Double_B4_Step_1]
alsoQueueAction:"""
TITANS_RX_121_BR_Double_Fire_Step_1,
TITANS_RX_121_BR_Double_Fire_Step_2,
TITANS_RX_121_BR_Double_Fire_Step_3,
TITANS_RX_121_BR_Double_Fire_Step_2,
TITANS_RX_121_BR_Double_Fire_Step_3,
TITANS_RX_121_BR_Double_Fire_Step_Final
"""



[hiddenAction_TITANS_RX_121_BR_Double_SetWeaponIndex]
isVisible:false


[hiddenAction_TITANS_RX_121_BR_Double_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.15s
[hiddenAction_TITANS_RX_121_BR_Double_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false 
"""
buildSpeed:0.15s
fireTurretXAtGround:TITANS_RX_121_BR_Double
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_DoubleShoot_A_Light_R_Step_1
[hiddenAction_TITANS_RX_121_BR_Double_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false 
"""
buildSpeed:0.15s
fireTurretXAtGround:TITANS_RX_121_BR_Double_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_DoubleShoot_A_Light_L_Step_1
[hiddenAction_TITANS_RX_121_BR_Double_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

