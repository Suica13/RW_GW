[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory AEUG_FA_010S_MegaBeamCannon_CDTimer:float
@global AEUG_FA_010S_MegaBeamCannon_CD=6
@global AEUG_FA_010S_MegaBeamCannon_EN=75







[turret_AEUG_FA_010S_MegaBeamCannon]
x:0
y:0

canShoot:false
projectile:AEUG_FA_010S_MegaBeamCannon_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:0
barrelY:10
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCannon_2.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Fire_1_Pink



[projectile_AEUG_FA_010S_MegaBeamCannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_HighBeamCannon_Pink*1
(
    addResources=
    BeamDamage:20000
    |BeamAPDamage:7500
    |DpDamage:900
    |WeaponAccuracy=75
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:1
    |ProjectileExplosionRange:45
    |ProjectileLife:25

    |ProjectileAttackTimes:7
    |ProjectileAttackTimesDamageModifier:0.75

    |EquipmentIndex=2
    |EquipmentIndex2=750
),
Projectile_HighBeamCannon_Pink_Effect*1
(
    addResources=
    ProjectileSpeed:1.0
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""








[hiddenAction_AEUG_FA_010S_MegaBeamCannon_Trigger]
alsoTriggerAction:AEUG_FA_010S_MegaBeamCannon_Fire
[hiddenAction_AEUG_FA_010S_MegaBeamCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.AEUG_FA_010S_MegaBeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:AEUG_FA_010S_MegaBeamCannon_CDTimer=self.timeAlive+${AEUG_FA_010S_MegaBeamCannon_CD}
addResources:EN=-${AEUG_FA_010S_MegaBeamCannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
AEUG_FA_010S_MegaBeamCannon_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
AEUG_FA_010S_MegaBeamCannon_B1_Step_1
"""
[hiddenAction_AEUG_FA_010S_MegaBeamCannon_B1_Step_1]
alsoQueueAction:"""
AEUG_FA_010S_MegaBeamCannon_Fire_Step_1,
AEUG_FA_010S_MegaBeamCannon_Fire_Step_2,
AEUG_FA_010S_MegaBeamCannon_Fire_Step_Final
"""




[hiddenAction_AEUG_FA_010S_MegaBeamCannon_SetWeaponIndex]
isVisible:false


[hiddenAction_AEUG_FA_010S_MegaBeamCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_AEUG_FA_010S_MegaBeamCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:AEUG_FA_010S_MegaBeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_AEUG_FA_010S_MegaBeamCannon_Fire_Step_Final]
buildSpeed:0.35s
alsoTriggerAction:SetAttackingOff


