[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""

@memory ZN_MSN_01_BG_L_CDTimer:float
@global ZN_MSN_01_BG_L_CD=2
@global ZN_MSN_01_BG_L_EN=40





[turret_ZN_MSN_01_BG_L]
x:0
y:0

canShoot:false
projectile:ZN_MSN_01_BG_L_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:-7 
barrelY:0
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamGun_3.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Fire_1_Yellow_S
[turret_ZN_MSN_01_BG_L_2]
@copyFromSection:turret_ZN_MSN_01_BG_L
barrelX:-9
barrelY:2
shoot_sound_vol:0
[turret_ZN_MSN_01_BG_L_3]
@copyFromSection:turret_ZN_MSN_01_BG_L
barrelX:-12
barrelY:4
shoot_sound_vol:0
[turret_ZN_MSN_01_BG_L_4]
@copyFromSection:turret_ZN_MSN_01_BG_L
barrelX:-15
barrelY:2
shoot_sound_vol:0
[turret_ZN_MSN_01_BG_L_5]
@copyFromSection:turret_ZN_MSN_01_BG_L
barrelX:-17
barrelY:0
shoot_sound_vol:0



[projectile_ZN_MSN_01_BG_L_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Yellow*1
(
    addResources=
    BeamDamage:1500
    |DpDamage:50
    |WeaponAccuracy=85
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:55
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""





[hiddenAction_ZN_MSN_01_BG_L_Trigger]
alsoTriggerAction:ZN_MSN_01_BG_L_Fire
[hiddenAction_ZN_MSN_01_BG_L_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MSN_01_BG_L_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:ZN_MSN_01_BG_L_CDTimer=self.timeAlive+${ZN_MSN_01_BG_L_CD}
addResources:EN=-${ZN_MSN_01_BG_L_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_MSN_01_BG_L_SetWeaponIndex,
PlayCommon_Shoot_A_L_Step_1,
ZN_MSN_01_BG_L_B1_Step_1
"""
[hiddenAction_ZN_MSN_01_BG_L_B1_Step_1]
alsoQueueAction:"""
ZN_MSN_01_BG_L_Fire_Step_1,
ZN_MSN_01_BG_L_Fire_Step_2,
ZN_MSN_01_BG_L_Fire_Step_3,
ZN_MSN_01_BG_L_Fire_Step_4,
ZN_MSN_01_BG_L_Fire_Step_5,
ZN_MSN_01_BG_L_Fire_Step_6,
ZN_MSN_01_BG_L_Fire_Step_Final
"""



[hiddenAction_ZN_MSN_01_BG_L_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MSN_01_BG_L_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_ZN_MSN_01_BG_L_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_MSN_01_BG_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
whenBuilding_cannotMove:true
[hiddenAction_ZN_MSN_01_BG_L_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.02s
fireTurretXAtGround:ZN_MSN_01_BG_L_2
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
whenBuilding_cannotMove:true
[hiddenAction_ZN_MSN_01_BG_L_Fire_Step_4]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.02s
fireTurretXAtGround:ZN_MSN_01_BG_L_3
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
whenBuilding_cannotMove:true
[hiddenAction_ZN_MSN_01_BG_L_Fire_Step_5]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.02s
fireTurretXAtGround:ZN_MSN_01_BG_L_4
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
whenBuilding_cannotMove:true
[hiddenAction_ZN_MSN_01_BG_L_Fire_Step_6]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.02s
fireTurretXAtGround:ZN_MSN_01_BG_L_5
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
whenBuilding_cannotMove:true
[hiddenAction_ZN_MSN_01_BG_L_Fire_Step_Final]
buildSpeed:0s
alsoTriggerAction:"""
SetAttackingOff
"""