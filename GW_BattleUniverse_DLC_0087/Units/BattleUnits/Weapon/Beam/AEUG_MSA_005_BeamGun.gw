[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_DoubleShoot_A_Light.gw
"""

@memory AEUG_MSA_005_BeamGun_CDTimer:float
@global AEUG_MSA_005_BeamGun_CD=1.5
@global AEUG_MSA_005_BeamGun_EN=45





[decal_AEUG_MSA_005_BeamGun]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Weapon/Beam/Image/AEUG_BeamPistol_MSA_005.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 4
yOffsetRelative: 17
dirOffset:0
[decal_AEUG_MSA_005_BeamGun_L]
@copyFromSection:decal_AEUG_MSA_005_BeamGun
basePositionFromLegEnd:arm3
imageScaleX:-1
xOffsetRelative: -4
yOffsetRelative: 17






[turret_AEUG_MSA_005_BeamGun]
x:0
y:0

canShoot:false
projectile:AEUG_MSA_005_BeamGun_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:8
barrelY:18
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamGun_1.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Yellow
[turret_AEUG_MSA_005_BeamGun_L]
@copyFromSection:turret_AEUG_MSA_005_BeamGun
barrelX:-8


[projectile_AEUG_MSA_005_BeamGun_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Yellow*1
(
    addResources=
    BeamDamage:3000
    |DpDamage:100
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |PartBreakModifier=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:90
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""





[hiddenAction_AEUG_MSA_005_BeamGun_Trigger]
alsoTriggerAction:AEUG_MSA_005_BeamGun_Fire
[hiddenAction_AEUG_MSA_005_BeamGun_Fire]
requireConditional:"""
if self.timeAlive>memory.AEUG_MSA_005_BeamGun_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:AEUG_MSA_005_BeamGun_CDTimer=self.timeAlive+${AEUG_MSA_005_BeamGun_CD}
addResources:EN=-${AEUG_MSA_005_BeamGun_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
AEUG_MSA_005_BeamGun_SetWeaponIndex,
AEUG_MSA_005_BeamGun_B4_Step_1
"""
[hiddenAction_AEUG_MSA_005_BeamGun_B4_Step_1]
alsoQueueAction:"""
AEUG_MSA_005_BeamGun_Fire_Step_1,
AEUG_MSA_005_BeamGun_Fire_Step_2,
AEUG_MSA_005_BeamGun_Fire_Step_3,
AEUG_MSA_005_BeamGun_Fire_Step_2,
AEUG_MSA_005_BeamGun_Fire_Step_3,
AEUG_MSA_005_BeamGun_Fire_Step_Final
"""



[hiddenAction_AEUG_MSA_005_BeamGun_SetWeaponIndex]
isVisible:false


[hiddenAction_AEUG_MSA_005_BeamGun_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.15s
[hiddenAction_AEUG_MSA_005_BeamGun_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false 
"""
buildSpeed:0.15s
fireTurretXAtGround:AEUG_MSA_005_BeamGun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_DoubleShoot_A_Light_R_Step_1
[hiddenAction_AEUG_MSA_005_BeamGun_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false 
"""
buildSpeed:0.15s
fireTurretXAtGround:AEUG_MSA_005_BeamGun_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_DoubleShoot_A_Light_L_Step_1
[hiddenAction_AEUG_MSA_005_BeamGun_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

