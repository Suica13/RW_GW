[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Charge/Beam_Charge_3_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory TITANS_MRX_009_BeamCannon_CDTimer:float
@global TITANS_MRX_009_BeamCannon_CD=15
@global TITANS_MRX_009_BeamCannon_EN=200



[turret_TITANS_MRX_009_BeamCannon]
x:0
y:0

canShoot:false
projectile:TITANS_MRX_009_BeamCannon_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:0
barrelY:20
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCannon_11.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Charge_3_Yellow



[projectile_TITANS_MRX_009_BeamCannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_HighBeamCannon_Yellow*1
(
    addResources=
    BeamDamage:12000
    |BeamAPDamage:6000
    |DpDamage:600
    |WeaponAccuracy=75
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:55
    |ProjectileSpread:1
    |ProjectileExplosionRange:45
    |ProjectileLife:25

    |ProjectileAttackTimes:7
    |ProjectileAttackTimesDamageModifier:0.75

    |EquipmentIndex=2
    |EquipmentIndex2=750
),
Projectile_HighBeamCannon_Yellow_Effect*1
(
    addResources=
    ProjectileSpeed:0.75
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""








[hiddenAction_TITANS_MRX_009_BeamCannon_Trigger]
alsoTriggerAction:TITANS_MRX_009_BeamCannon_Fire
[hiddenAction_TITANS_MRX_009_BeamCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.TITANS_MRX_009_BeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:TITANS_MRX_009_BeamCannon_CDTimer=self.timeAlive+${TITANS_MRX_009_BeamCannon_CD}
addResources:EN=-${TITANS_MRX_009_BeamCannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
TITANS_MRX_009_BeamCannon_SetWeaponIndex,
PlayCommon_Cannon_Shoot_A_Step_1,
TITANS_MRX_009_BeamCannon_B3_Step_1
"""
[hiddenAction_TITANS_MRX_009_BeamCannon_B3_Step_1]
alsoQueueAction:"""
TITANS_MRX_009_BeamCannon_Fire_Step_1,
TITANS_MRX_009_BeamCannon_Fire_Step_2,
TITANS_MRX_009_BeamCannon_Fire_Step_3,
TITANS_MRX_009_BeamCannon_Fire_Step_3,
TITANS_MRX_009_BeamCannon_Fire_Step_Final
"""




[hiddenAction_TITANS_MRX_009_BeamCannon_SetWeaponIndex]
isVisible:false


[hiddenAction_TITANS_MRX_009_BeamCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.75s
[hiddenAction_TITANS_MRX_009_BeamCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:TITANS_MRX_009_BeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_TITANS_MRX_009_BeamCannon_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.45s
fireTurretXAtGround:TITANS_MRX_009_BeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_TITANS_MRX_009_BeamCannon_Fire_Step_Final]
buildSpeed:1.5s
alsoTriggerAction:SetAttackingOff


