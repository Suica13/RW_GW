[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_DoubleShoot_A_Light.gw
"""

@memory NZN_AMX_01X_BR_Double_CDTimer:float
@global NZN_AMX_01X_BR_Double_CD=3
@global NZN_AMX_01X_BR_Double_EN=45





[turret_NZN_AMX_01X_BR_Double]
x:0
y:0

canShoot:false
projectile:NZN_AMX_01X_BR_Double_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:9
barrelY:20
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_3.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Fire_1_Yellow
[turret_NZN_AMX_01X_BR_Double_L]
@copyFromSection:turret_NZN_AMX_01X_BR_Double
barrelX:-9


[projectile_NZN_AMX_01X_BR_Double_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamRifle_Yellow*1
(
    addResources=
    BeamDamage:3500
    |DpDamage:150
    |WeaponAccuracy=85
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:90
    |ProjectileSpread:2
    |ProjectileLife:25
)
"""





[hiddenAction_NZN_AMX_01X_BR_Double_Trigger]
alsoTriggerAction:NZN_AMX_01X_BR_Double_Fire
[hiddenAction_NZN_AMX_01X_BR_Double_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_AMX_01X_BR_Double_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:NZN_AMX_01X_BR_Double_CDTimer=self.timeAlive+${NZN_AMX_01X_BR_Double_CD}
addResources:EN=-${NZN_AMX_01X_BR_Double_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
NZN_AMX_01X_BR_Double_SetWeaponIndex,
NZN_AMX_01X_BR_Double_B6_Step_1
"""
[hiddenAction_NZN_AMX_01X_BR_Double_B6_Step_1]
alsoQueueAction:"""
NZN_AMX_01X_BR_Double_Fire_Step_1,
NZN_AMX_01X_BR_Double_Fire_Step_2,
NZN_AMX_01X_BR_Double_Fire_Step_3,
NZN_AMX_01X_BR_Double_Fire_Step_2,
NZN_AMX_01X_BR_Double_Fire_Step_3,
NZN_AMX_01X_BR_Double_Fire_Step_2,
NZN_AMX_01X_BR_Double_Fire_Step_3,
NZN_AMX_01X_BR_Double_Fire_Step_Final
"""



[hiddenAction_NZN_AMX_01X_BR_Double_SetWeaponIndex]
isVisible:false


[hiddenAction_NZN_AMX_01X_BR_Double_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.15s
[hiddenAction_NZN_AMX_01X_BR_Double_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false 
"""
buildSpeed:0.15s
fireTurretXAtGround:NZN_AMX_01X_BR_Double
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_DoubleShoot_A_Light_R_Step_1
[hiddenAction_NZN_AMX_01X_BR_Double_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false 
"""
buildSpeed:0.15s
fireTurretXAtGround:NZN_AMX_01X_BR_Double_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_DoubleShoot_A_Light_L_Step_1
[hiddenAction_NZN_AMX_01X_BR_Double_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

