[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_DoubleShoot_A_Light.gw
"""

@memory TITANS_ORX_005_BeamCannon_CDTimer:float
@global TITANS_ORX_005_BeamCannon_CD=2.5
@global TITANS_ORX_005_BeamCannon_EN=80





[turret_TITANS_ORX_005_BeamCannon]
x:0
y:0

canShoot:false
projectile:TITANS_ORX_005_BeamCannon_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:23
barrelY:18
idleDir:-5
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_3.ogg
shoot_sound_vol:0.45
shoot_flame:Beam_Fire_1_Yellow
[turret_TITANS_ORX_005_BeamCannon_L]
@copyFromSection:turret_TITANS_ORX_005_BeamCannon
barrelX:-23
idleDir:5


[projectile_TITANS_ORX_005_BeamCannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_AP_BeamRifle_Yellow*1
(
    addResources=
    BeamDamage:5500
    |DpDamage:125
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |PartBreakModifier=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:90
    |ProjectileSpread:1
    |ProjectileLife:30

    |ProjectileAttackTimes:2
    |ProjectileAttackTimesDamageModifier:0.5
)
"""





[hiddenAction_TITANS_ORX_005_BeamCannon_Trigger]
alsoTriggerAction:TITANS_ORX_005_BeamCannon_Fire
[hiddenAction_TITANS_ORX_005_BeamCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.TITANS_ORX_005_BeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:TITANS_ORX_005_BeamCannon_CDTimer=self.timeAlive+${TITANS_ORX_005_BeamCannon_CD}
addResources:EN=-${TITANS_ORX_005_BeamCannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
TITANS_ORX_005_BeamCannon_SetWeaponIndex,
TITANS_ORX_005_BeamCannon_B6_Step_1
"""
[hiddenAction_TITANS_ORX_005_BeamCannon_B6_Step_1]
alsoQueueAction:"""
TITANS_ORX_005_BeamCannon_Fire_Step_1,
TITANS_ORX_005_BeamCannon_Fire_Step_2,
TITANS_ORX_005_BeamCannon_Fire_Step_3,
TITANS_ORX_005_BeamCannon_Fire_Step_2,
TITANS_ORX_005_BeamCannon_Fire_Step_3,
TITANS_ORX_005_BeamCannon_Fire_Step_2,
TITANS_ORX_005_BeamCannon_Fire_Step_3,
TITANS_ORX_005_BeamCannon_Fire_Step_Final
"""



[hiddenAction_TITANS_ORX_005_BeamCannon_SetWeaponIndex]
isVisible:false


[hiddenAction_TITANS_ORX_005_BeamCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.15s
[hiddenAction_TITANS_ORX_005_BeamCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false 
"""
buildSpeed:0.20s
fireTurretXAtGround:TITANS_ORX_005_BeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_DoubleShoot_A_Light_R_Step_1
[hiddenAction_TITANS_ORX_005_BeamCannon_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false 
"""
buildSpeed:0.20s
fireTurretXAtGround:TITANS_ORX_005_BeamCannon_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_DoubleShoot_A_Light_L_Step_1
[hiddenAction_TITANS_ORX_005_BeamCannon_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

