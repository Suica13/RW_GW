[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory ZN_ACT_Zaku_BR_CDTimer:float
@global ZN_ACT_Zaku_BR_CD=1.5
@global ZN_ACT_Zaku_BR_EN=25





[decal_ZN_ACT_Zaku_BR]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Beam\Image\ZN_ACT_Zaku_BR.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 3.5
yOffsetRelative: 18.5
dirOffset:0
[decal_ZN_ACT_Zaku_BR_NotUsing]
@copyFromSection:decal_ZN_ACT_Zaku_BR
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.9
xOffsetRelative:0
yOffsetRelative:-9
dirOffset:-90








[turret_ZN_ACT_Zaku_BR]
x:0
y:0

canShoot:false
projectile:ZN_ACT_Zaku_BR_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:9
barrelY:18.5
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_1.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Yellow



[projectile_ZN_ACT_Zaku_BR_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamRifle_Yellow*1
(
    addResources=
    BeamDamage:4500
    |DpDamage:275
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""





[hiddenAction_ZN_ACT_Zaku_BR_Trigger]
alsoTriggerAction:ZN_ACT_Zaku_BR_Fire
[hiddenAction_ZN_ACT_Zaku_BR_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_ACT_Zaku_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:ZN_ACT_Zaku_BR_CDTimer=self.timeAlive+${ZN_ACT_Zaku_BR_CD}
addResources:EN=-${ZN_ACT_Zaku_BR_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_ACT_Zaku_BR_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
ZN_ACT_Zaku_BR_B1_Step_1
"""
[hiddenAction_ZN_ACT_Zaku_BR_B1_Step_1]
alsoQueueAction:"""
ZN_ACT_Zaku_BR_Fire_Step_1,
ZN_ACT_Zaku_BR_Fire_Step_2,
ZN_ACT_Zaku_BR_Fire_Step_Final
"""



[hiddenAction_ZN_ACT_Zaku_BR_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_ACT_Zaku_BR_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_ZN_ACT_Zaku_BR_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_ACT_Zaku_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_ACT_Zaku_BR_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

