[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/Common_DoubleShoot_A_Light.gw
"""

@memory EF_RX_77D_4_BeamGun_CDTimer:float
@global EF_RX_77D_4_BeamGun_CD=2
@global EF_RX_77D_4_BeamGun_EN=45



[turret_EF_RX_77D_4_BeamGun]
x:0
y:0

canShoot:false
projectile:EF_RX_77D_4_BeamGun_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:9
barrelY:20
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_3.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Fire_1_Pink
[turret_EF_RX_77D_4_BeamGun_L]
@copyFromSection:turret_EF_RX_77D_4_BeamGun
barrelX:-9


[projectile_EF_RX_77D_4_BeamGun_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamRifle_Pink*1
(
    addResources=
    BeamDamage:3500
    |DpDamage:125
    |WeaponAccuracy=75
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:75
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""





[hiddenAction_EF_RX_77D_4_BeamGun_Trigger]
alsoTriggerAction:EF_RX_77D_4_BeamGun_Fire
[hiddenAction_EF_RX_77D_4_BeamGun_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RX_77D_4_BeamGun_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:EF_RX_77D_4_BeamGun_CDTimer=self.timeAlive+${EF_RX_77D_4_BeamGun_CD}
addResources:EN=-${EF_RX_77D_4_BeamGun_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RX_77D_4_BeamGun_SetWeaponIndex,
EF_RX_77D_4_BeamGun_B4_Step_1
"""
[hiddenAction_EF_RX_77D_4_BeamGun_B4_Step_1]
alsoQueueAction:"""
EF_RX_77D_4_BeamGun_Fire_Step_1,
EF_RX_77D_4_BeamGun_Fire_Step_2,
EF_RX_77D_4_BeamGun_Fire_Step_3,
EF_RX_77D_4_BeamGun_Fire_Step_2,
EF_RX_77D_4_BeamGun_Fire_Step_3,
EF_RX_77D_4_BeamGun_Fire_Step_Final
"""



[hiddenAction_EF_RX_77D_4_BeamGun_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RX_77D_4_BeamGun_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.15s
[hiddenAction_EF_RX_77D_4_BeamGun_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false 
"""
buildSpeed:0.15s
fireTurretXAtGround:EF_RX_77D_4_BeamGun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_DoubleShoot_A_Light_R_Step_1
[hiddenAction_EF_RX_77D_4_BeamGun_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false 
"""
buildSpeed:0.15s
fireTurretXAtGround:EF_RX_77D_4_BeamGun_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_DoubleShoot_A_Light_L_Step_1
[hiddenAction_EF_RX_77D_4_BeamGun_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

