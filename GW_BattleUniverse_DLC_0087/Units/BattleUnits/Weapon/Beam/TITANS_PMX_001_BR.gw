[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory TITANS_PMX_001_BR_CDTimer:float
@global TITANS_PMX_001_BR_CD=1.5
@global TITANS_PMX_001_BR_EN=75





[turret_TITANS_PMX_001_BR]
x:0
y:0

canShoot:false
projectile:TITANS_PMX_001_BR_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:22
barrelY:32
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_3.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Yellow
[turret_TITANS_PMX_001_BR_R]
@copyFromSection:turret_TITANS_PMX_001_BR
barrelX:24
barrelY:34
shoot_sound_vol:0
[turret_TITANS_PMX_001_BR_M]
@copyFromSection:turret_TITANS_PMX_001_BR
barrelX:23
barrelY:33
projectile:TITANS_PMX_001_BR_GL_Projectile

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1_S




[projectile_TITANS_PMX_001_BR_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_AP_BeamRifle_Yellow
(
    offsetRandomDir=3,
    addResources=
    BeamDamage:9000
    |DpDamage:225
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:85
    |ProjectileSpread:1
    |ProjectileLife:25

    |ProjectileAttackTimes:2
    |ProjectileAttackTimesDamageModifier:0.5
)
"""


[projectile_TITANS_PMX_001_BR_GL_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_S*1
(
    addResources=
    ShellDamage:5000
    |DpDamage:200
    |WeaponAccuracy=90
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75
    |AntiLand=1 
    |AntiSpace=1 
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:85
    |ProjectileSpread:2
    |ProjectileExplosionRange:35
    |ProjectileLife:25
)
"""




[hiddenAction_TITANS_PMX_001_BR_Trigger]
alsoTriggerAction:TITANS_PMX_001_BR_Fire
[hiddenAction_TITANS_PMX_001_BR_Fire]
requireConditional:"""
if self.timeAlive>memory.TITANS_PMX_001_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:TITANS_PMX_001_BR_CDTimer=self.timeAlive+${TITANS_PMX_001_BR_CD}
addResources:EN=-${TITANS_PMX_001_BR_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
TITANS_PMX_001_BR_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
TITANS_PMX_001_BR_B1_Step_1
"""
[hiddenAction_TITANS_PMX_001_BR_B1_Step_1]
alsoQueueAction:"""
TITANS_PMX_001_BR_Fire_Step_1,
TITANS_PMX_001_BR_Fire_Step_2,
TITANS_PMX_001_BR_Fire_Step_3,
TITANS_PMX_001_BR_Fire_Step_4,
TITANS_PMX_001_BR_Fire_Step_Final
"""



[hiddenAction_TITANS_PMX_001_BR_SetWeaponIndex]
isVisible:false


[hiddenAction_TITANS_PMX_001_BR_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_TITANS_PMX_001_BR_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:TITANS_PMX_001_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_TITANS_PMX_001_BR_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.05s
fireTurretXAtGround:TITANS_PMX_001_BR_R
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_TITANS_PMX_001_BR_Fire_Step_4]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.05s
fireTurretXAtGround:TITANS_PMX_001_BR_M
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
fireTurretXAtGround_withProjectile:TITANS_PMX_001_BR_GL_Projectile
[hiddenAction_TITANS_PMX_001_BR_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

