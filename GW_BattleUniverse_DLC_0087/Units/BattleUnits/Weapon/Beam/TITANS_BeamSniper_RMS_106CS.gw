[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Resource/Image/Fx/Common/Common_Flash_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_Two_Handed_A.gw
"""

@memory TITANS_BeamSniper_RMS_106CS_CDTimer:float
@global TITANS_BeamSniper_RMS_106CS_CD=2.5
@global TITANS_BeamSniper_RMS_106CS_EN=35





[decal_TITANS_BeamSniper_RMS_106CS_Idle]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Beam\Image\TITANS_BeamSniper_RMS_106CS.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 4
yOffsetRelative: 14
dirOffset:0
[decal_TITANS_BeamSniper_RMS_106CS_Attack]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Beam\Image\TITANS_BeamSniper_RMS_106CS.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 4
yOffsetRelative: 14
dirOffset:0

[decal_TITANS_BeamSniper_RMS_106CS_NotUsing]
layer:beforeBody
order:1
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Beam\Image\TITANS_BeamSniper_RMS_106CS.png
isVisible:false
basePositionFromLegEnd:arm1
imageScale:0.85
xOffsetRelative: 0
yOffsetRelative: -7
dirOffset:-90





[turret_TITANS_BeamSniper_RMS_106CS]
x:0
y:0

canShoot:false
projectile:TITANS_BeamSniper_RMS_106CS_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:11
barrelY:37
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCannon_1.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Yellow





[projectile_TITANS_BeamSniper_RMS_106CS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
explodeEffect:none

spawnUnit:"""
Projectile_Target_BeamRifle_Yellow*1
(
    addResources=
    BeamDamage:8000 
    |BeamAPDamage:4000
    |DpDamage:250
    |WeaponAccuracy=125
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=0.75
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1

    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:100
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""





[hiddenAction_TITANS_BeamSniper_RMS_106CS_Trigger]
alsoTriggerAction:TITANS_BeamSniper_RMS_106CS_Fire
[hiddenAction_TITANS_BeamSniper_RMS_106CS_Fire]
requireConditional:"""
if self.timeAlive>memory.TITANS_BeamSniper_RMS_106CS_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:TITANS_BeamSniper_RMS_106CS_CDTimer=self.timeAlive+${TITANS_BeamSniper_RMS_106CS_CD}
addResources:EN=-${TITANS_BeamSniper_RMS_106CS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
TITANS_BeamSniper_RMS_106CS_SetWeaponIndex,
PlayCommon_Shoot_Two_Handed_A_Step_1,
TITANS_BeamSniper_RMS_106CS_B1_Step_1
"""
[hiddenAction_TITANS_BeamSniper_RMS_106CS_B1_Step_1]
alsoQueueAction:"""
TITANS_BeamSniper_RMS_106CS_Fire_Step_1,
TITANS_BeamSniper_RMS_106CS_Fire_Step_2,
TITANS_BeamSniper_RMS_106CS_Fire_Step_Final
"""



[hiddenAction_TITANS_BeamSniper_RMS_106CS_SetWeaponIndex]
isVisible:false


[hiddenAction_TITANS_BeamSniper_RMS_106CS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
whenBuilding_cannotMove:true
[hiddenAction_TITANS_BeamSniper_RMS_106CS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
whenBuilding_cannotMove:true
fireTurretXAtGround:TITANS_BeamSniper_RMS_106CS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_TITANS_BeamSniper_RMS_106CS_Fire_Step_Final]
buildSpeed:1.0s
whenBuilding_cannotMove:true
stopLastAnimation:true
alsoTriggerAction:SetAttackingOff
