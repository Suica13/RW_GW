[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""


@memory TITANS_MRX_009_ArmBR_L_CDTimer:float
@global TITANS_MRX_009_ArmBR_L_CD=4.5
@global TITANS_MRX_009_ArmBR_L_EN=60



[turret_TITANS_MRX_009_ArmBR_L]
x:0
y:0

canShoot:false
projectile:TITANS_MRX_009_ArmBR_L_Projectile

delay:0.1s
limitingRange:0

canAttackMaxAngle:15
barrelX:-29
barrelY:52

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_3.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Yellow
[turret_TITANS_MRX_009_ArmBR_L_2]
@copyFromSection:turret_TITANS_MRX_009_ArmBR_L
barrelX:-30
barrelY:52
[turret_TITANS_MRX_009_ArmBR_L_3]
@copyFromSection:turret_TITANS_MRX_009_ArmBR_L
barrelX:-31
barrelY:52
[turret_TITANS_MRX_009_ArmBR_L_4]
@copyFromSection:turret_TITANS_MRX_009_ArmBR_L
barrelX:-32
barrelY:52
[turret_TITANS_MRX_009_ArmBR_L_5]
@copyFromSection:turret_TITANS_MRX_009_ArmBR_L
barrelX:-33
barrelY:52



[projectile_TITANS_MRX_009_ArmBR_L_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamRifle_Yellow*1
(
    addResources=
    BeamDamage:8000
    |DpDamage:90
    |WeaponAccuracy=85
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:60
    |ProjectileSpread:8
    |ProjectileLife:30
)
"""







[hiddenAction_TITANS_MRX_009_ArmBR_L_Trigger]
alsoTriggerAction:TITANS_MRX_009_ArmBR_L_Fire
[hiddenAction_TITANS_MRX_009_ArmBR_L_Fire]
requireConditional:"""
if self.timeAlive>memory.TITANS_MRX_009_ArmBR_L_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:TITANS_MRX_009_ArmBR_L_CDTimer=self.timeAlive+${TITANS_MRX_009_ArmBR_L_CD}
addResources:EN=-${TITANS_MRX_009_ArmBR_L_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
PlayCommon_Shoot_A_L_Step_1,
TITANS_MRX_009_ArmBR_L_SetWeaponIndex,
TITANS_MRX_009_ArmBR_L_B5_Step_1
"""
[hiddenAction_TITANS_MRX_009_ArmBR_L_B5_Step_1]
alsoQueueAction:"""
TITANS_MRX_009_ArmBR_L_Fire_Step_1,
TITANS_MRX_009_ArmBR_L_Fire_Step_2,
TITANS_MRX_009_ArmBR_L_Fire_Step_3,
TITANS_MRX_009_ArmBR_L_Fire_Step_4,
TITANS_MRX_009_ArmBR_L_Fire_Step_5,
TITANS_MRX_009_ArmBR_L_Fire_Step_Final
"""





[hiddenAction_TITANS_MRX_009_ArmBR_L_SetWeaponIndex]
isVisible:false


[hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:TITANS_MRX_009_ArmBR_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_3]
@copyFromSection:hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_2
buildSpeed:0.075s
fireTurretXAtGround:TITANS_MRX_009_ArmBR_L_2
[hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_4]
@copyFromSection:hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_2
buildSpeed:0.075s
fireTurretXAtGround:TITANS_MRX_009_ArmBR_L_3
[hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_5]
@copyFromSection:hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_2
buildSpeed:0.075s
fireTurretXAtGround:TITANS_MRX_009_ArmBR_L_4
[hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_5]
@copyFromSection:hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_2
buildSpeed:0.075s
fireTurretXAtGround:TITANS_MRX_009_ArmBR_L_5

[hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_Final]
buildSpeed:0.75s
alsoTriggerAction:SetAttackingOff


