[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Flash_1.gw,
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw
"""

@memory TITANS_MRX_009_MegaBeamCannon_AimTarget:unit
@memory TITANS_MRX_009_MegaBeamCannon_CDTimer:float
@global TITANS_MRX_009_MegaBeamCannon_CD=180
@global TITANS_MRX_009_MegaBeamCannon_EN=150
@global TITANS_MRX_009_MegaBeamCannon_Range=1000

@memory TITANS_MRX_009_MegaBeamCannon_ChargeEffect_1:unit
@memory TITANS_MRX_009_MegaBeamCannon_BulletEffect_1:unit



[decal_TITANS_MRX_009_MegaBeamCannon_Range]
layer: inactive
order:0
onlyTeam:own
alpha:1
image:ROOT:Resource/Image/Ring/Ring150_Action.png
imageScale:${TITANS_MRX_009_MegaBeamCannon_Range}/150
basePosition:self
alwaysStartDirAtZero:true
onlyWhileAlive:true
isVisible:if true



[turret_TITANS_MRX_009_MegaBeamCannon]
x:0
y:0

canShoot:false
projectile:TITANS_MRX_009_MegaBeamCannon_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:0
barrelY:15
limitingAngle:0
limitingRange:${TITANS_MRX_009_MegaBeamCannon_Range}
limitingMinRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamCannon_2.ogg
shoot_sound_vol:0
shoot_flame:none



[projectile_TITANS_MRX_009_MegaBeamCannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_AP_MegaBeamCannon_Yellow_Alpha0*1
(
    addResources=
    BeamDamage:4000
    |BeamAPDamage:2000
    |DpDamage:250
    |WeaponAccuracy=100
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.0
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.0
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=1.0
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=0
    |HeightHitRange=50
    |ProjectileExplosionRange:40
    |ProjectileSpeed:200
    |ProjectileSpread:0
    |ProjectileLife:5

    |ProjectileAttackTimes:9
    |ProjectileAttackTimesDamageModifier:0.75

    |EquipmentIndex=2
    |EquipmentIndex2=1000
    |SubEquipmentIndex=1
)
"""




[attachment_TITANS_MRX_009_MegaBeamCannon_ChargeEffect_1]
x:0
y:15
isVisible:true
keepAliveWhenParentDies:false
canBeAttackedAndDamaged:false
isUnselectable:true
canAttack:false
showAllActionsFrom:true
onConvertKeepExistingUnitInSameSlot:true
idleDir:0
resetRotationWhenNotAttacking:true

[hiddenAction_TITANS_MRX_009_MegaBeamCannon_ChargeEffect_1_AwakeSet]
autoTriggerOnEvent:newMessage(withTag="UnitTurretSpawn")
alsoTriggerAction:"""
TITANS_MRX_009_MegaBeamCannon_ChargeEffect_1_StartSet
"""
attachments_addNewUnits:Beam_Charge_1_EffectUnit
attachments_onlyOnSlots:TITANS_MRX_009_MegaBeamCannon_ChargeEffect_1

[hiddenAction_TITANS_MRX_009_MegaBeamCannon_ChargeEffect_1_StartSet]
setUnitMemory:TITANS_MRX_009_MegaBeamCannon_ChargeEffect_1=self.attachment(slot='TITANS_MRX_009_MegaBeamCannon_ChargeEffect_1')
alsoTriggerAction:"""
TITANS_MRX_009_MegaBeamCannon_ChargeEffect_1_SetColor,
TITANS_MRX_009_MegaBeamCannon_ChargeEffect_1_SetSpeed
"""

[hiddenAction_TITANS_MRX_009_MegaBeamCannon_ChargeEffect_1_SetColor]
sendMessageTo:memory.TITANS_MRX_009_MegaBeamCannon_ChargeEffect_1
sendMessageWithTags:SetColor_Yellow
[hiddenAction_TITANS_MRX_009_MegaBeamCannon_ChargeEffect_1_SetSpeed]
sendMessageTo:memory.TITANS_MRX_009_MegaBeamCannon_ChargeEffect_1
sendMessageWithTags:SetSpeed
sendMessageWithData:Speed=3.25

[hiddenAction_TITANS_MRX_009_MegaBeamCannon_Fire_Step_ChargeEffect_1]
requireConditional:if ${cantAction}==false
buildSpeed:0s
sendMessageTo:memory.TITANS_MRX_009_MegaBeamCannon_ChargeEffect_1
sendMessageWithTags:PlayOneTime
playSoundAtUnit:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCharge_4.ogg:2.0


[attachment_TITANS_MRX_009_MegaBeamCannon_BulletEffect_1]
x:0
y:15
isVisible:true
keepAliveWhenParentDies:false
canBeAttackedAndDamaged:false
isUnselectable:true
canAttack:false
showAllActionsFrom:true
onConvertKeepExistingUnitInSameSlot:true
idleDir:0
resetRotationWhenNotAttacking:true

[hiddenAction_TITANS_MRX_009_MegaBeamCannon_BulletEffect_1_AwakeSet]
autoTriggerOnEvent:newMessage(withTag="UnitTurretSpawn")
alsoTriggerAction:"""
TITANS_MRX_009_MegaBeamCannon_BulletEffect_1_StartSet
"""
attachments_addNewUnits:HighMegaCannon_1_EffectUnit
attachments_onlyOnSlots:TITANS_MRX_009_MegaBeamCannon_BulletEffect_1

[hiddenAction_TITANS_MRX_009_MegaBeamCannon_BulletEffect_1_StartSet]
setUnitMemory:TITANS_MRX_009_MegaBeamCannon_BulletEffect_1=self.attachment(slot='TITANS_MRX_009_MegaBeamCannon_BulletEffect_1')
alsoTriggerAction:"""
TITANS_MRX_009_MegaBeamCannon_BulletEffect_1_SetColor,
TITANS_MRX_009_MegaBeamCannon_BulletEffect_1_SetSpeed
"""

[hiddenAction_TITANS_MRX_009_MegaBeamCannon_BulletEffect_1_SetColor]
sendMessageTo:memory.TITANS_MRX_009_MegaBeamCannon_BulletEffect_1
sendMessageWithTags:SetColor_Yellow
[hiddenAction_TITANS_MRX_009_MegaBeamCannon_BulletEffect_1_SetSpeed]
sendMessageTo:memory.TITANS_MRX_009_MegaBeamCannon_BulletEffect_1
sendMessageWithTags:SetSpeed
sendMessageWithData:Speed=4

[hiddenAction_TITANS_MRX_009_MegaBeamCannon_Fire_Step_BulletEffect_1]
requireConditional:if ${cantAction}==false
buildSpeed:0s
sendMessageTo:memory.TITANS_MRX_009_MegaBeamCannon_BulletEffect_1
sendMessageWithTags:PlayOneTime

[hiddenAction_TITANS_MRX_009_MegaBeamCannon_BulletEffect_1_StopPlay]
buildSpeed:0s
sendMessageTo:memory.TITANS_MRX_009_MegaBeamCannon_BulletEffect_1
sendMessageWithTags:StopPlay



[hiddenAction_TITANS_MRX_009_MegaBeamCannon_Trigger_ByAI]
autoTrigger:"""
if ${allowAI}==true 
and ${cantAction}==false and ${onSkill}==false 
and self.timeAlive>memory.TITANS_MRX_009_MegaBeamCannon_CDTimer 
and not self.hasTags(includes='inHangar') 
and not parent.hasTags(includes='SFS_Slot') 
and self.resource.en>${TITANS_MRX_009_MegaBeamCannon_EN} 
and memory.TITANS_MRX_009_MegaBeamCannon_AimTarget.hp>0 
"""
setResourcesWithLogic:en=self.resource.en-${TITANS_MRX_009_MegaBeamCannon_EN}
alsoTriggerAction:TITANS_MRX_009_MegaBeamCannon_Trigger

[hiddenAction_TITANS_MRX_009_MegaBeamCannon_FindTarget]
autoTrigger:if memory.TITANS_MRX_009_MegaBeamCannon_AimTarget.hp<=0 and ${onSkill}==false 
takeResources_includeUnitsWithinRange:1000
takeResources_includeUnitsWithinRange_team:enemy
takeResources_excludeUnitsWithoutTags:CanBeTargetUnit
takeResources_searchOnly:true
takeResources_maxUnits:100
takeResources_triggerActionForEach:TITANS_MRX_009_MegaBeamCannon_FindTarget_Step2
[hiddenAction_TITANS_MRX_009_MegaBeamCannon_FindTarget_Step2]
requireConditional:if memory.TITANS_MRX_009_MegaBeamCannon_AimTarget.hp<=0 and not thisActionTarget.tags(includes='UnDetected')
setUnitMemory:TITANS_MRX_009_MegaBeamCannon_AimTarget=thisActionTarget

[hiddenAction_TITANS_MRX_009_MegaBeamCannon_MissTarget]
autoTrigger:"""
if memory.TITANS_MRX_009_MegaBeamCannon_AimTarget.hp>0 
and 
(
    distanceBetween(self, memory.TITANS_MRX_009_MegaBeamCannon_AimTarget)>${TITANS_MRX_009_MegaBeamCannon_Range} 
    or 
    distanceBetween(self, memory.TITANS_MRX_009_MegaBeamCannon_AimTarget)<300 
    or 
    memory.TITANS_MRX_009_MegaBeamCannon_AimTarget.hasTags(includes='UnDetected')
)
"""
setUnitMemory:TITANS_MRX_009_MegaBeamCannon_AimTarget=null



[action_TITANS_MRX_009_MegaBeamCannon_Trigger]
pos:10
text:MegaBeamCannon %{select(self.timeAlive<=memory.TITANS_MRX_009_MegaBeamCannon_CDTimer,str(int(memory.TITANS_MRX_009_MegaBeamCannon_CDTimer-self.timeAlive))+"s","OK")}
text_zh:MEGA粒子炮 %{select(self.timeAlive<=memory.TITANS_MRX_009_MegaBeamCannon_CDTimer,str(int(memory.TITANS_MRX_009_MegaBeamCannon_CDTimer-self.timeAlive))+"秒","OK")}
text_KP:100

displayType:infoOnly

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true

iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
highPriorityQueue:true

price:EN=${TITANS_MRX_009_MegaBeamCannon_EN}

onlyOneUnitAtATime:true

isVisible:if self.parent.hp<=0  

isGuiBlinking:"""
if self.timeAlive>memory.TITANS_MRX_009_MegaBeamCannon_CDTimer
"""



isLocked:if self.timeAlive<=memory.TITANS_MRX_009_MegaBeamCannon_CDTimer
isLockedMessage:In CD
isLockedMessage_zh:冷却中
isLockedAlt2:if ${cantAction}==true or ${onSkill}==true or ${allowAI}==true 
isLockedAlt2Message:Cant Action
isLockedAlt2Message_zh:无法行动

fireTurretXAtGround:TITANS_MRX_009_MegaBeamCannon
fireTurretXAtGround_count:0
fireTurretXAtGround_showGuideDecals:TITANS_MRX_009_MegaBeamCannon_Range

clearAllWaypoints:true


alsoTriggerAction:"""
