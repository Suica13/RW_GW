[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Flash_1.gw,
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/AEUG_MSZ_010_Pose.gw
"""

@memory AEUG_MSZ_010_HighMegaCannon_AimTarget:unit
@memory AEUG_MSZ_010_HighMegaCannon_CDTimer:float
@global AEUG_MSZ_010_HighMegaCannon_CD=240
@global AEUG_MSZ_010_HighMegaCannon_EN=400
@global AEUG_MSZ_010_HighMegaCannon_Range=1000

@memory AEUG_MSZ_010_HighMegaCannon_ChargeEffect_1:unit
@memory AEUG_MSZ_010_HighMegaCannon_BulletEffect_1:unit


[decal_AEUG_MSZ_010_HighMegaCannon_Range]
layer: inactive
order:0
onlyTeam:own
alpha:1
image:ROOT:Resource/Image/Ring/Ring150_Action.png
imageScale:${AEUG_MSZ_010_HighMegaCannon_Range}/150
basePosition:self
alwaysStartDirAtZero:true
onlyWhileAlive:true
isVisible:if true





[turret_AEUG_MSZ_010_HighMegaCannon]
x:0
y:0

canShoot:false
projectile:AEUG_MSZ_010_HighMegaCannon_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:0
barrelY:0
limitingAngle:0
limitingRange:${AEUG_MSZ_010_HighMegaCannon_Range}
limitingMinRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamCannon_2.ogg
shoot_sound_vol:0
shoot_flame:none



[projectile_AEUG_MSZ_010_HighMegaCannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_AP_HighMegaCannon_Pink_Alpha0*1
(
    addResources=
    BeamDamage:5000
    |BeamAPDamage:2000
    |DpDamage:300
    |WeaponAccuracy=75
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=0.75
    |AntiAqua=1.0
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=0
    |HeightHitRange=50
    |ProjectileExplosionRange:50
    |ProjectileSpeed:200
    |ProjectileSpread:0
    |ProjectileLife:5.5

    |ProjectileAttackTimes:12
    |ProjectileAttackTimesDamageModifier:0.75

    |EquipmentIndex=2
    |EquipmentIndex2=1000
    |SubEquipmentIndex=1
)
"""




[attachment_AEUG_MSZ_010_HighMegaCannon_ChargeEffect_1]
x:0
y:0
isVisible:true
keepAliveWhenParentDies:false
canBeAttackedAndDamaged:false
isUnselectable:true
canAttack:false
showAllActionsFrom:true
onConvertKeepExistingUnitInSameSlot:true
idleDir:0
resetRotationWhenNotAttacking:true

[hiddenAction_AEUG_MSZ_010_HighMegaCannon_ChargeEffect_1_AwakeSet]
autoTriggerOnEvent:newMessage(withTag="UnitTurretSpawn")
alsoTriggerAction:"""
AEUG_MSZ_010_HighMegaCannon_ChargeEffect_1_StartSet
"""
attachments_addNewUnits:Beam_Charge_1_EffectUnit
attachments_onlyOnSlots:AEUG_MSZ_010_HighMegaCannon_ChargeEffect_1

[hiddenAction_AEUG_MSZ_010_HighMegaCannon_ChargeEffect_1_StartSet]
setUnitMemory:AEUG_MSZ_010_HighMegaCannon_ChargeEffect_1=self.attachment(slot='AEUG_MSZ_010_HighMegaCannon_ChargeEffect_1')
alsoTriggerAction:"""
AEUG_MSZ_010_HighMegaCannon_ChargeEffect_1_SetColor,
AEUG_MSZ_010_HighMegaCannon_ChargeEffect_1_SetSpeed
"""

[hiddenAction_AEUG_MSZ_010_HighMegaCannon_ChargeEffect_1_SetColor]
sendMessageTo:memory.AEUG_MSZ_010_HighMegaCannon_ChargeEffect_1
sendMessageWithTags:SetColor_Pink
[hiddenAction_AEUG_MSZ_010_HighMegaCannon_ChargeEffect_1_SetSpeed]
sendMessageTo:memory.AEUG_MSZ_010_HighMegaCannon_ChargeEffect_1
sendMessageWithTags:SetSpeed
sendMessageWithData:Speed=3.25

[hiddenAction_AEUG_MSZ_010_HighMegaCannon_Fire_Step_ChargeEffect_1]
requireConditional:if ${cantAction}==false
buildSpeed:0s
sendMessageTo:memory.AEUG_MSZ_010_HighMegaCannon_ChargeEffect_1
sendMessageWithTags:PlayOneTime
playSoundAtUnit:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCharge_4.ogg:2.0


[attachment_AEUG_MSZ_010_HighMegaCannon_BulletEffect_1]
x:0
y:0
isVisible:true
keepAliveWhenParentDies:false
canBeAttackedAndDamaged:false
isUnselectable:true
canAttack:false
showAllActionsFrom:true
onConvertKeepExistingUnitInSameSlot:true
idleDir:0
resetRotationWhenNotAttacking:true

[hiddenAction_AEUG_MSZ_010_HighMegaCannon_BulletEffect_1_AwakeSet]
autoTriggerOnEvent:newMessage(withTag="UnitTurretSpawn")
alsoTriggerAction:"""
AEUG_MSZ_010_HighMegaCannon_BulletEffect_1_StartSet
"""
attachments_addNewUnits:LargeHighMegaCannon_1_EffectUnit
attachments_onlyOnSlots:AEUG_MSZ_010_HighMegaCannon_BulletEffect_1

[hiddenAction_AEUG_MSZ_010_HighMegaCannon_BulletEffect_1_StartSet]
setUnitMemory:AEUG_MSZ_010_HighMegaCannon_BulletEffect_1=self.attachment(slot='AEUG_MSZ_010_HighMegaCannon_BulletEffect_1')
alsoTriggerAction:"""
AEUG_MSZ_010_HighMegaCannon_BulletEffect_1_SetColor,
AEUG_MSZ_010_HighMegaCannon_BulletEffect_1_SetSpeed
"""

[hiddenAction_AEUG_MSZ_010_HighMegaCannon_BulletEffect_1_SetColor]
sendMessageTo:memory.AEUG_MSZ_010_HighMegaCannon_BulletEffect_1
sendMessageWithTags:SetColor_Pink
[hiddenAction_AEUG_MSZ_010_HighMegaCannon_BulletEffect_1_SetSpeed]
sendMessageTo:memory.AEUG_MSZ_010_HighMegaCannon_BulletEffect_1
sendMessageWithTags:SetSpeed
sendMessageWithData:Speed=4

[hiddenAction_AEUG_MSZ_010_HighMegaCannon_Fire_Step_BulletEffect_1]
requireConditional:if ${cantAction}==false
buildSpeed:0s
sendMessageTo:memory.AEUG_MSZ_010_HighMegaCannon_BulletEffect_1
sendMessageWithTags:PlayOneTime

[hiddenAction_AEUG_MSZ_010_HighMegaCannon_BulletEffect_1_StopPlay]
buildSpeed:0s
sendMessageTo:memory.AEUG_MSZ_010_HighMegaCannon_BulletEffect_1
sendMessageWithTags:StopPlay



[hiddenAction_AEUG_MSZ_010_HighMegaCannon_Trigger_ByAI]
autoTrigger:"""
if ${allowAI}==true 
and ${cantAction}==false and ${onSkill}==false 
and self.timeAlive>memory.AEUG_MSZ_010_HighMegaCannon_CDTimer 
and not self.hasTags(includes='inHangar') 
and not parent.hasTags(includes='SFS_Slot') 
and self.resource.en>${AEUG_MSZ_010_HighMegaCannon_EN} 
and memory.AEUG_MSZ_010_HighMegaCannon_AimTarget.hp>0 
"""
setResourcesWithLogic:en=self.resource.en-${AEUG_MSZ_010_HighMegaCannon_EN}
alsoTriggerAction:AEUG_MSZ_010_HighMegaCannon_Trigger

[hiddenAction_AEUG_MSZ_010_HighMegaCannon_FindTarget]
autoTrigger:if memory.AEUG_MSZ_010_HighMegaCannon_AimTarget.hp<=0 and ${onSkill}==false 
takeResources_includeUnitsWithinRange:1000
takeResources_includeUnitsWithinRange_team:enemy
takeResources_excludeUnitsWithoutTags:CanBeTargetUnit
takeResources_searchOnly:true
takeResources_maxUnits:100
takeResources_triggerActionForEach:AEUG_MSZ_010_HighMegaCannon_FindTarget_Step2
[hiddenAction_AEUG_MSZ_010_HighMegaCannon_FindTarget_Step2]
requireConditional:if memory.AEUG_MSZ_010_HighMegaCannon_AimTarget.hp<=0 and not thisActionTarget.tags(includes='UnDetected')
setUnitMemory:AEUG_MSZ_010_HighMegaCannon_AimTarget=thisActionTarget

[hiddenAction_AEUG_MSZ_010_HighMegaCannon_MissTarget]
autoTrigger:"""
if memory.AEUG_MSZ_010_HighMegaCannon_AimTarget.hp>0 
and 
(
    distanceBetween(self, memory.AEUG_MSZ_010_HighMegaCannon_AimTarget)>${AEUG_MSZ_010_HighMegaCannon_Range} 
    or 
    distanceBetween(self, memory.AEUG_MSZ_010_HighMegaCannon_AimTarget)<300 
    or 
    memory.AEUG_MSZ_010_HighMegaCannon_AimTarget.hasTags(includes='UnDetected')
)
"""
setUnitMemory:AEUG_MSZ_010_HighMegaCannon_AimTarget=null



[action_AEUG_MSZ_010_HighMegaCannon_Trigger]
pos:10
text:MegaBeamCannon %{select(self.timeAlive<=memory.AEUG_MSZ_010_HighMegaCannon_CDTimer,str(int(memory.AEUG_MSZ_010_HighMegaCannon_CDTimer-self.timeAlive))+"s","OK")}
text_zh:MEGA粒子炮 %{select(self.timeAlive<=memory.AEUG_MSZ_010_HighMegaCannon_CDTimer,str(int(memory.AEUG_MSZ_010_HighMegaCannon_CDTimer-self.timeAlive))+"秒","OK")}
text_KP:100

displayType:infoOnly

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true

iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
highPriorityQueue:true

price:EN=${AEUG_MSZ_010_HighMegaCannon_EN}

onlyOneUnitAtATime:true

isVisible:if self.parent.hp<=0  

isGuiBlinking:"""
if self.timeAlive>memory.AEUG_MSZ_010_HighMegaCannon_CDTimer
"""



isLocked:if self.timeAlive<=memory.AEUG_MSZ_010_HighMegaCannon_CDTimer
isLockedMessage:In CD
isLockedMessage_zh:冷却中
isLockedAlt:if memory.headBreaked==true
isLockedAltMessage:Head Breaked
isLockedAltMessage_zh:头部损害
isLockedAlt2:if ${cantAction}==true or ${onSkill}==true or ${allowAI}==true
isLockedAlt2Message:Cant Action
isLockedAlt2Message_zh:无法行动

fireTurretXAtGround:AEUG_MSZ_010_HighMegaCannon
fireTurretXAtGround_count:0
fireTurretXAtGround_showGuideDecals:AEUG_MSZ_010_HighMegaCannon_Range

alsoTriggerAction:"""
