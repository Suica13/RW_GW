[hiddenAction_NZN_AMX_014_BeamCannon_Trigger]
alsoTriggerAction:NZN_AMX_014_BeamCannon_Fire
[hiddenAction_NZN_AMX_014_BeamCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_AMX_014_BeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:NZN_AMX_014_BeamCannon_CDTimer=self.timeAlive+${NZN_AMX_014_BeamCannon_CD}
addResources:EN=-${NZN_AMX_014_BeamCannon_EN}

alsoTriggerAction:"""
SetAttackingOn,
SetOnSkillOn_NZN_AMX_014_BeamCannon,
SendEnemyTryAttack_Shoot,
PlayCommon_Cannon_Shoot_A_Step_1,
NZN_AMX_014_BeamCannon_SetWeaponIndex,
NZN_AMX_014_BeamCannon_B1_Step_1
"""
[hiddenAction_NZN_AMX_014_BeamCannon_B1_Step_1]
alsoQueueAction:"""
NZN_AMX_014_BeamCannon_Fire_Step_ChargeEffect_1,
NZN_AMX_014_BeamCannon_Fire_Step_ChargeEffect_2,
NZN_AMX_014_BeamCannon_Fire_Step_1,
NZN_AMX_014_BeamCannon_Fire_Step_BulletEffect_1,
NZN_AMX_014_BeamCannon_Fire_Step_BulletEffect_2,

NZN_AMX_014_BeamCannon_Fire_Step_2,
NZN_AMX_014_BeamCannon_Fire_Step_2,
NZN_AMX_014_BeamCannon_Fire_Step_2,
NZN_AMX_014_BeamCannon_Fire_Step_2,
NZN_AMX_014_BeamCannon_Fire_Step_2,
NZN_AMX_014_BeamCannon_Fire_Step_2,
NZN_AMX_014_BeamCannon_Fire_Step_2,
NZN_AMX_014_BeamCannon_Fire_Step_2,

NZN_AMX_014_BeamCannon_Fire_Step_Final,
NZN_AMX_014_BeamCannon_BulletEffect_1_StopPlay
"""





[hiddenAction_SetOnSkillOn_NZN_AMX_014_BeamCannon]
@copyFromSection:hiddenAction_SetOnSkillOn
sendMessageWithData:"""
skillMoveSpeedBuff=0.75,
skillTurnSpeedBuff=0.05
"""




[hiddenAction_NZN_AMX_014_BeamCannon_SetWeaponIndex]
isVisible:false

[hiddenAction_NZN_AMX_014_BeamCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.65s

playSoundAtUnit:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamCannon_2.ogg

[hiddenAction_NZN_AMX_014_BeamCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.1s

fireTurretXAtGround:NZN_AMX_014_BeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:"""
PlayCommon_Cannon_Shoot_A_Step_1,
NZN_AMX_014_BeamCannon_Fire_Step_2_Sub
"""
[hiddenAction_NZN_AMX_014_BeamCannon_Fire_Step_2_Sub]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s

fireTurretXAtGround:NZN_AMX_014_BeamCannon_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_NZN_AMX_014_BeamCannon_Fire_Step_Final]
buildSpeed:1.5s
alsoTriggerAction:"""
SetAttackingOff,
SetOnSkillOff,
SetAttackingCantTurnOff
"""

