[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory NZN_AMX_014_BeamCannon_CDTimer:float
@global NZN_AMX_014_BeamCannon_CD=10
@global NZN_AMX_014_BeamCannon_EN=120

@memory NZN_AMX_014_BeamCannon_ChargeEffect_1:unit
@memory NZN_AMX_014_BeamCannon_BulletEffect_1:unit

@memory NZN_AMX_014_BeamCannon_ChargeEffect_2:unit
@memory NZN_AMX_014_BeamCannon_BulletEffect_2:unit




[turret_NZN_AMX_014_BeamCannon]
x:0
y:0

canShoot:false
projectile:NZN_AMX_014_BeamCannon_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:15
barrelY:-5
limitingAngle:0
limitingRange:500
limitingMinRange:300

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamCannon_2.ogg
shoot_sound_vol:0
shoot_flame:none

[turret_NZN_AMX_014_BeamCannon_L]
@copyFromSection:turret_NZN_AMX_014_BeamCannon
barrelX:-15
barrelY:-5


[projectile_NZN_AMX_014_BeamCannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_AP_BeamRifle_Yellow_Alpha0*1
(
    addResources=
    BeamDamage:3000
    |BeamAPDamage:500
    |DpDamage:50
    |WeaponAccuracy=85
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=1.0
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:150
    |ProjectileSpread:1
    |ProjectileLife:3.75

    |ProjectileAttackTimes:7
    |ProjectileAttackTimesDamageModifier:0.5


    |EquipmentIndex=2
    |EquipmentIndex2=600
)
"""




[attachment_NZN_AMX_014_BeamCannon_ChargeEffect_1]
x:15
y:-5
isVisible:true
keepAliveWhenParentDies:false
canBeAttackedAndDamaged:false
isUnselectable:true
canAttack:false
showAllActionsFrom:true
onConvertKeepExistingUnitInSameSlot:true
idleDir:0
resetRotationWhenNotAttacking:true

[hiddenAction_NZN_AMX_014_BeamCannon_ChargeEffect_1_AwakeSet]
autoTriggerOnEvent:newMessage(withTag="UnitTurretSpawn")
alsoTriggerAction:"""
NZN_AMX_014_BeamCannon_ChargeEffect_1_StartSet
"""
attachments_addNewUnits:Beam_Charge_1_EffectUnit
attachments_onlyOnSlots:NZN_AMX_014_BeamCannon_ChargeEffect_1

[hiddenAction_NZN_AMX_014_BeamCannon_ChargeEffect_1_StartSet]
setUnitMemory:NZN_AMX_014_BeamCannon_ChargeEffect_1=self.attachment(slot='NZN_AMX_014_BeamCannon_ChargeEffect_1')
alsoTriggerAction:"""
NZN_AMX_014_BeamCannon_ChargeEffect_1_SetColor,
NZN_AMX_014_BeamCannon_ChargeEffect_1_SetSpeed
"""

[hiddenAction_NZN_AMX_014_BeamCannon_ChargeEffect_1_SetColor]
sendMessageTo:memory.NZN_AMX_014_BeamCannon_ChargeEffect_1
sendMessageWithTags:SetColor_Yellow
[hiddenAction_NZN_AMX_014_BeamCannon_ChargeEffect_1_SetSpeed]
sendMessageTo:memory.NZN_AMX_014_BeamCannon_ChargeEffect_1
sendMessageWithTags:SetSpeed
sendMessageWithData:Speed=5

[hiddenAction_NZN_AMX_014_BeamCannon_Fire_Step_ChargeEffect_1]
requireConditional:if ${cantAction}==false
buildSpeed:0s
sendMessageTo:memory.NZN_AMX_014_BeamCannon_ChargeEffect_1
sendMessageWithTags:PlayOneTime
playSoundAtUnit:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCharge_1.ogg:2.0


[attachment_NZN_AMX_014_BeamCannon_ChargeEffect_2]
x:-15
y:-5
isVisible:true
keepAliveWhenParentDies:false
canBeAttackedAndDamaged:false
isUnselectable:true
canAttack:false
showAllActionsFrom:true
onConvertKeepExistingUnitInSameSlot:true
