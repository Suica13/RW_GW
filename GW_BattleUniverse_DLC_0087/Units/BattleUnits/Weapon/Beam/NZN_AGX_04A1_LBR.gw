[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory NZN_AGX_04A1_LBR_CDTimer:float
@global NZN_AGX_04A1_LBR_CD=3.5
@global NZN_AGX_04A1_LBR_EN=80






[decal_NZN_AGX_04A1_LBR]
layer:beforeBody
order:4.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Weapon/Beam/Image/ZN_AGX_04_LBR.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1.0
xOffsetRelative: 0
yOffsetRelative: 18
dirOffset:0
[decal_NZN_AGX_04A1_LBR_NotUsing]
@copyFromSection:decal_NZN_AGX_04A1_LBR
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.85
xOffsetRelative:2
yOffsetRelative:-9
dirOffset:-90





[turret_NZN_AGX_04A1_LBR]
x:0
y:0

canShoot:false
projectile:NZN_AGX_04A1_LBR_Projectile

delay:0.075s
canAttackMaxAngle:15
barrelX:10
barrelY:30
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource/Sound/SE/Weapon/Fire/BeamGun_2.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Fire_1_Yellow_S



[projectile_NZN_AGX_04A1_LBR_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Yellow*1
(
    addResources=
    BeamDamage:2500
    |DpDamage:70
    |WeaponAccuracy=95
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:90
    |ProjectileSpread:3
    |ProjectileLife:25
)
"""





[hiddenAction_NZN_AGX_04A1_LBR_Trigger]
alsoTriggerAction:NZN_AGX_04A1_LBR_Fire
[hiddenAction_NZN_AGX_04A1_LBR_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_AGX_04A1_LBR_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:NZN_AGX_04A1_LBR_CDTimer=self.timeAlive+${NZN_AGX_04A1_LBR_CD}
addResources:EN=-${NZN_AGX_04A1_LBR_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
NZN_AGX_04A1_LBR_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
NZN_AGX_04A1_LBR_B12_Step_1
"""
[hiddenAction_NZN_AGX_04A1_LBR_B12_Step_1]
alsoQueueAction:"""
NZN_AGX_04A1_LBR_Fire_Step_1,
NZN_AGX_04A1_LBR_Fire_Step_2,
NZN_AGX_04A1_LBR_Fire_Step_3,

NZN_AGX_04A1_LBR_Fire_Step_3,
NZN_AGX_04A1_LBR_Fire_Step_3,
NZN_AGX_04A1_LBR_Fire_Step_3,

NZN_AGX_04A1_LBR_Fire_Step_3,
NZN_AGX_04A1_LBR_Fire_Step_3,
NZN_AGX_04A1_LBR_Fire_Step_3,

NZN_AGX_04A1_LBR_Fire_Step_3,
NZN_AGX_04A1_LBR_Fire_Step_3,
NZN_AGX_04A1_LBR_Fire_Step_3,
NZN_AGX_04A1_LBR_Fire_Step_Final
"""



[hiddenAction_NZN_AGX_04A1_LBR_SetWeaponIndex]
isVisible:false


[hiddenAction_NZN_AGX_04A1_LBR_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_NZN_AGX_04A1_LBR_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:NZN_AGX_04A1_LBR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_NZN_AGX_04A1_LBR_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.075s
fireTurretXAtGround:NZN_AGX_04A1_LBR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)


[hiddenAction_NZN_AGX_04A1_LBR_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

