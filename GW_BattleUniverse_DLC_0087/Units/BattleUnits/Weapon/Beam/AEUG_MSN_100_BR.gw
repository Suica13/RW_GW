[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory AEUG_MSN_100_BR_CDTimer:float
@global AEUG_MSN_100_BR_CD=1.5
@global AEUG_MSN_100_BR_EN=45





[decal_AEUG_MSN_100_BR]
layer:beforeBody
order:4.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Beam\Image\AEUG_MSN_100_BR.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.75
xOffsetRelative: 1
yOffsetRelative: 18
dirOffset:0
[decal_AEUG_MSN_100_BR_NotUsing]
@copyFromSection:decal_AEUG_MSN_100_BR
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.75
xOffsetRelative:1
yOffsetRelative:-10
dirOffset:-90







[turret_AEUG_MSN_100_BR]
x:0
y:0

canShoot:false
projectile:AEUG_MSN_100_BR_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:9
barrelY:25
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_3.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Yellow



[projectile_AEUG_MSN_100_BR_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_AP_BeamRifle_Yellow*1
(
    addResources=
    BeamDamage:8500
    |DpDamage:275
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:95
    |ProjectileSpread:1
    |ProjectileLife:30

    |ProjectileAttackTimes:2
    |ProjectileAttackTimesDamageModifier:0.75
)
"""





[hiddenAction_AEUG_MSN_100_BR_Trigger]
alsoTriggerAction:AEUG_MSN_100_BR_Fire
[hiddenAction_AEUG_MSN_100_BR_Fire]
requireConditional:"""
if self.timeAlive>memory.AEUG_MSN_100_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:AEUG_MSN_100_BR_CDTimer=self.timeAlive+${AEUG_MSN_100_BR_CD}
addResources:EN=-${AEUG_MSN_100_BR_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
AEUG_MSN_100_BR_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
AEUG_MSN_100_BR_B2_Step_1
"""
[hiddenAction_AEUG_MSN_100_BR_B2_Step_1]
alsoQueueAction:"""
AEUG_MSN_100_BR_Fire_Step_1,
AEUG_MSN_100_BR_Fire_Step_2,
AEUG_MSN_100_BR_Fire_Step_3,
AEUG_MSN_100_BR_Fire_Step_Final
"""



[hiddenAction_AEUG_MSN_100_BR_SetWeaponIndex]
isVisible:false


[hiddenAction_AEUG_MSN_100_BR_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_AEUG_MSN_100_BR_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:AEUG_MSN_100_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_AEUG_MSN_100_BR_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
fireTurretXAtGround:AEUG_MSN_100_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)


[hiddenAction_AEUG_MSN_100_BR_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

