[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory NZN_AMX_109_BSG_CDTimer:float
@global NZN_AMX_109_BSG_CD=6
@global NZN_AMX_109_BSG_EN=90










[turret_NZN_AMX_109_BSG]
x:0
y:0

canShoot:false
projectile:NZN_AMX_109_BSG_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:0
barrelY:5
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamShotGun_1.ogg
shoot_sound_vol:0.85
shoot_flame:Beam_Fire_1_Yellow



[projectile_NZN_AMX_109_BSG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamShotGun_Yellow*8
(
    offsetRandomDir=9,
    addResources=
    BeamDamage:2750
    |DpDamage:125
    |WeaponAccuracy=90
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:60
    |ProjectileSpread:2
    |ProjectileLife:9
)
"""





[hiddenAction_NZN_AMX_109_BSG_Trigger]
alsoTriggerAction:NZN_AMX_109_BSG_Fire
[hiddenAction_NZN_AMX_109_BSG_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_AMX_109_BSG_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:NZN_AMX_109_BSG_CDTimer=self.timeAlive+${NZN_AMX_109_BSG_CD}
addResources:EN=-${NZN_AMX_109_BSG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
PlayCommon_Cannon_Shoot_A_Step_1,
NZN_AMX_109_BSG_SetWeaponIndex,
NZN_AMX_109_BSG_B1_Step_1
"""
[hiddenAction_NZN_AMX_109_BSG_B1_Step_1]
alsoQueueAction:"""
NZN_AMX_109_BSG_Fire_Step_1,
NZN_AMX_109_BSG_Fire_Step_2,
NZN_AMX_109_BSG_Fire_Step_Final
"""



[hiddenAction_NZN_AMX_109_BSG_SetWeaponIndex]
isVisible:false


[hiddenAction_NZN_AMX_109_BSG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_NZN_AMX_109_BSG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:NZN_AMX_109_BSG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_NZN_AMX_109_BSG_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

