[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""


@memory Common_ArmBMG_Yellow_CDTimer:float
@global Common_ArmBMG_Yellow_CD=3
@global Common_ArmBMG_Yellow_EN=25



[turret_Common_ArmBMG_Yellow]
x:0
y:0

canShoot:false
projectile:Common_ArmBMG_Yellow_Projectile

delay:0.075s
limitingRange:0

canAttackMaxAngle:15
barrelX:14
barrelY:10

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamGun_1.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Fire_1_Yellow



[projectile_Common_ArmBMG_Yellow_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Yellow*1
(
    addResources=
    BeamDamage:1450
    |DpDamage:45
    |WeaponAccuracy=85
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=1
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=1
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |PartBreakModifier=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:80
    |ProjectileSpread:3
    |ProjectileLife:20
)
"""







[hiddenAction_Common_ArmBMG_Yellow_Trigger]
alsoTriggerAction:Common_ArmBMG_Yellow_Fire
[hiddenAction_Common_ArmBMG_Yellow_Fire]
requireConditional:"""
if self.timeAlive>memory.Common_ArmBMG_Yellow_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:Common_ArmBMG_Yellow_CDTimer=self.timeAlive+${Common_ArmBMG_Yellow_CD}
addResources:EN=-${Common_ArmBMG_Yellow_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
Common_ArmBMG_Yellow_SetWeaponIndex,
Common_ArmBMG_Yellow_B6_Step_1
"""
[hiddenAction_Common_ArmBMG_Yellow_B6_Step_1]
alsoQueueAction:"""
Common_ArmBMG_Yellow_Fire_Step_1,
Common_ArmBMG_Yellow_Fire_Step_2,
Common_ArmBMG_Yellow_Fire_Step_3,
Common_ArmBMG_Yellow_Fire_Step_3,
Common_ArmBMG_Yellow_Fire_Step_3,
Common_ArmBMG_Yellow_Fire_Step_3,
Common_ArmBMG_Yellow_Fire_Step_3,
Common_ArmBMG_Yellow_Fire_Step_Final
"""





[hiddenAction_Common_ArmBMG_Yellow_SetWeaponIndex]
isVisible:false


[hiddenAction_Common_ArmBMG_Yellow_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.1s
[hiddenAction_Common_ArmBMG_Yellow_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:Common_ArmBMG_Yellow
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_Common_ArmBMG_Yellow_Fire_Step_3]
@copyFromSection:hiddenAction_Common_ArmBMG_Yellow_Fire_Step_2
buildSpeed:${turret_Common_ArmBMG_Yellow.delay}
[hiddenAction_Common_ArmBMG_Yellow_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


