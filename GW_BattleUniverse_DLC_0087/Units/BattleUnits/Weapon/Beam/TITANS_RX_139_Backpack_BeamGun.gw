[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw
"""

@memory TITANS_RX_139_Backpack_BeamGun_CDTimer:float
@global TITANS_RX_139_Backpack_BeamGun_CD=4
@global TITANS_RX_139_Backpack_BeamGun_EN=50










[turret_TITANS_RX_139_Backpack_BeamGun]
x:0
y:0

canShoot:false
showRangeUIGuide:false
projectile:TITANS_RX_139_Backpack_BeamGun_Projectile

delay:0.1s
limitingRange:1200
limitingAngle:3

canAttackMaxAngle:15
barrelX:-6
barrelY:-10

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_1.ogg
shoot_sound_vol:0.35
shoot_flame:Beam_Fire_1_Yellow_S

[turret_TITANS_RX_139_Backpack_BeamGun_R]
@copyFromSection:turret_TITANS_RX_139_Backpack_BeamGun
barrelX:6



[projectile_TITANS_RX_139_Backpack_BeamGun_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamRifle_Yellow*1
(
    addResources=
    BeamDamage:4500
    |DpDamage:200
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:90
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""




[hiddenAction_TITANS_RX_139_Backpack_BeamGun_Trigger]
alsoTriggerAction:TITANS_RX_139_Backpack_BeamGun_Fire
[hiddenAction_TITANS_RX_139_Backpack_BeamGun_Fire]
requireConditional:"""
if self.timeAlive>memory.TITANS_RX_139_Backpack_BeamGun_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  
and not (directionBetween(self, self.attacking) < self.dir-35 or directionBetween(self, self.attacking) > self.dir+35)  
and self.resource.EN>0
"""
setUnitMemory:TITANS_RX_139_Backpack_BeamGun_CDTimer=self.timeAlive+${TITANS_RX_139_Backpack_BeamGun_CD} 
addResources:EN=-${TITANS_RX_139_Backpack_BeamGun_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
TITANS_RX_139_Backpack_BeamGun_SetWeaponIndex,
TITANS_RX_139_Backpack_BeamGun_B3_Step_1
"""
[hiddenAction_TITANS_RX_139_Backpack_BeamGun_B3_Step_1]
alsoQueueAction:"""
TITANS_RX_139_Backpack_BeamGun_Fire_Step_1,
TITANS_RX_139_Backpack_BeamGun_Fire_Step_2,
TITANS_RX_139_Backpack_BeamGun_Fire_Step_3,
TITANS_RX_139_Backpack_BeamGun_Fire_Step_3,
TITANS_RX_139_Backpack_BeamGun_Fire_Step_Final
"""




[hiddenAction_TITANS_RX_139_Backpack_BeamGun_SetWeaponIndex]
isVisible:false


[hiddenAction_TITANS_RX_139_Backpack_BeamGun_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
[hiddenAction_TITANS_RX_139_Backpack_BeamGun_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.075s
fireTurretXAtGround:TITANS_RX_139_Backpack_BeamGun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_TITANS_RX_139_Backpack_BeamGun_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.075s
fireTurretXAtGround:TITANS_RX_139_Backpack_BeamGun_R
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_TITANS_RX_139_Backpack_BeamGun_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff