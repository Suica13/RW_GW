"""





[hiddenAction_AEUG_MSR_00100S_BeamMinigun_SetWeaponIndex]
isVisible:false


[hiddenAction_AEUG_MSR_00100S_BeamMinigun_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
alsoTriggerAction:PlayCommon_StandShoot_A_Step_1
[hiddenAction_AEUG_MSR_00100S_BeamMinigun_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:AEUG_MSR_00100S_BeamMinigun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_AEUG_MSR_00100S_BeamMinigun_Fire_Step_3]
