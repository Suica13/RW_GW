[core]
dont_load:true
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Flash_1.gw,
ROOT:Resource/Image/Fx/Common/Common_SpeedLine_1.gw,
ROOT:Template/Unit/Animation/Cqb/Common_Dash_A.gw
"""

@memory Common_Dash_Attack_Active:bool
@memory Common_Dash_Attack_AimTarget:unit
@memory Common_Dash_Attack_ActiveTimer:float
@global Common_Dash_Attack_ActiveTime:2
@memory Common_Dash_Attack_CDTimer:float
@global Common_Dash_Attack_CD=10





[decal_Common_Dash_Attack_BotEffect]
layer:beforeBody
order:1
onlyWhileAlive:true
image:ROOT:Resource/Image/Fx/Weapon/Sp/Image/Dash_Orange_1.png
isVisible:false
imageScale:1
alpha:0.75
xOffsetRelative:0
yOffsetRelative:0
dirOffset:0

[decal_Common_Dash_Attack_Boost]
@copyFromSection:decal_Boost
image:ROOT:\Resource\Image\Fx\Unit\Image\Boost_1.png

[decal_Common_Dash_Attack_SpeedLine_1]
@copyFromSection:decal_SpeedLine_1
isVisible:false



[turret_Common_Dash_Attack]
x:0
y:0
invisible:true

canShoot:false

showRangeUIGuide:false
projectile:Common_Dash_Attack_Projectile

delay:3s
limitingMinRange:0
limitingRange:0

canAttackMaxAngle:60
barrelX:0
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/Fist_2.ogg
shoot_sound_vol:0.5

[projectile_Common_Dash_Attack_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Saber_S_B*1
(
    addResources=
    CqbDamage:3500
    |CqbShellDamage:3500
    |DpDamage:750
    |WeaponAccuracy:125
    |PartBreakModifier=0.75
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=1.0
    |AntiAir=0.5
    |HeightHitRange:35
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileLife:1.5
    |ProjectileAttackTimes:1
)
"""







[hiddenAction_Common_Dash_Attack_Trigger_ByAI]
autoTrigger:"""
if ${allowAI}==true 
and ${cantAction}==false 
and ${onSkill}==false 
and self.timeAlive>memory.Common_Dash_Attack_CDTimer 
and self.parent.hp<=0  
and self.attacking.hp>0 
and memory.Common_Dash_Attack_Active==false 
and distanceBetween(self, memory.Common_Dash_Attack_AimTarget)<200  
and not (directionBetween(self, memory.Common_Dash_Attack_AimTarget) < self.dir-15 or directionBetween(self, memory.Common_Dash_Attack_AimTarget) > self.dir+15) 
"""
alsoTriggerAction:Common_Dash_Attack_Trigger
[hiddenAction_Common_Dash_FindTarget]
autoTrigger:"""
if ${allowAI}==true and self.attacking.hp>0
"""
setUnitMemory:Common_Dash_Attack_AimTarget=self.attacking.getOffsetRelative()



[action_Common_Dash_Attack_Trigger]
pos:10
text:DashAttack %{select(self.timeAlive<=memory.Common_Dash_Attack_CDTimer,str(int(memory.Common_Dash_Attack_CDTimer-self.timeAlive))+"s","OK")}
text_zh:冲刺打击 %{select(self.timeAlive<=memory.Common_Dash_Attack_CDTimer,str(int(memory.Common_Dash_Attack_CDTimer-self.timeAlive))+"秒","OK")}
text_KP:100

displayType:action

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true

iconImage:ROOT:Resource\Image\Units\Button\Weapon\Cqb_10.png
isVisible:if self.parent.hp<=0  
highPriorityQueue:true


isGuiBlinking:"""
if self.timeAlive>memory.Common_Dash_Attack_CDTimer
"""

isLocked:if self.timeAlive<=memory.Common_Dash_Attack_CDTimer
isLockedMessage:In CD
isLockedMessage_zh:冷却中
isLockedAlt:if self.attacking.hp<=0
isLockedAltMessage:No Target
isLockedAltMessage_zh:没有目标
isLockedAlt2:if ${cantAction}==true or ${onSkill}==true  or ${allowAI}==true
isLockedAlt2Message:Cant Action
isLockedAlt2Message_zh:无法行动

alsoTriggerAction:"""
Common_Dash_Attack_SetOnSkillOn,
Common_Dash_Attack_SetWeaponIndex,
PlayCommon_Dash_A_Step_1,
Common_Dash_Attack_Step_1
"""
[hiddenAction_Common_Dash_Attack_Step_1]
spawnEffects:Flash_1_N


setUnitMemory:"""
Common_Dash_Attack_AimTarget=self.attacking.getOffsetRelative(),
Common_Dash_Attack_ActiveTimer=self.timeAlive+${Common_Dash_Attack_ActiveTime},
Common_Dash_Attack_CDTimer=self.timeAlive+${Common_Dash_Attack_CD}
"""


alsoQueueAction:"""
SetAttackingCantTurnOn,
SetAttackingCantAimOn,
Common_Dash_Attack_Fire_Step_1,
Common_Dash_Attack_Fire_Step_2
"""







[hiddenAction_Common_Dash_Attack_SetWeaponIndex]
isVisible:false


[hiddenAction_Common_Dash_Attack_SetOnSkillOn]
@copyFromSection:hiddenAction_SetOnSkillOn
sendMessageWithData:"""
skillShootDefBuff=1.5,
skillCqbDefBuff=1.5,
skillMoraleDef=1.0
"""


[hiddenAction_Common_Dash_Attack_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.0s
clearAllWaypoints:true

fireTurretXAtGround:Common_Dash_Attack
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

setUnitMemory:Common_Dash_Attack_Active=true
setBodyRotation:directionBetween(self,memory.Common_Dash_Attack_AimTarget)
whenBuilding_cannotMove:true
[hiddenAction_Common_Dash_Attack_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
whenBuilding_cannotMove:true


[hiddenAction_Common_Dash_Attack_Fire_Step_Active]
autoTrigger:if memory.Common_Dash_Attack_Active==true
alsoTriggerAction:"""
Common_Dash_Attack_Fire_Step_Forward_CD,
Common_Dash_Attack_Fire_Step_CheckStop
"""


[hiddenAction_Common_Dash_Attack_Fire_Step_Forward_CD]
requireConditional:"""
if self.queueSize(withActionTag='Common_Dash_Attack_Move')<1
"""
buildSpeed:0s
alsoQueueAction:"""
Common_Dash_Attack_Fire_Step_Forward
"""


[hiddenAction_Common_Dash_Attack_Fire_Step_Forward]
tags:Common_Dash_Attack_Move
buildSpeed:0.02s
teleportTo:self.getOffsetRelative(y=2+1.5*memory.nowMoveSpeed*self.resource.bulletSpeed)
whenBuilding_cannotMove:true


[hiddenAction_Common_Dash_Attack_Fire_Step_CheckStop]
requireConditional:"""
if 
(
    not self.getOffsetRelative(y=20).getAsMarker().isInMap() 
    or self.getOffsetRelative(y=20).getAsMarker().numberOfUnitsInAllTeams(withTag="BlockLand",greaterThan=0,withinrange=20) 
    or (self.getOffsetRelative(y=20).getAsMarker().isOverLiquid() and not self.getOffsetRelative(y=20).getAsMarker().isOverwater()) 
    or ${cantAction}==true 
) 
or self.timeAlive>memory.Common_Dash_Attack_ActiveTimer
"""
alsoTriggerAction:"""
Common_Dash_Attack_Fire_Step_Final
"""

[hiddenAction_Common_Dash_Attack_Fire_Step_Final]
buildSpeed:0s
whenBuilding_cannotMove:true
clearAllWaypoints:true
setUnitMemory:Common_Dash_Attack_Active=false
alsoTriggerAction:"""
SetOnSkillOff,
SetAttackingCantAimOff,
SetAttackingCantTurnOff
"""