[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Cqb/Common/Cqb_Fire_2_Yellow_R.gw,
ROOT:Template\Unit\Animation\Cqb\Common_Melee_B2.gw
"""

@memory ZN_MS_15B_BeamLance_B2_CDTimer:float
@global ZN_MS_15B_BeamLance_B2_CD=3.5



[decal_ZN_MS_15B_BeamLance_B2]
layer:beforeBody
order:4.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Weapon/Cqb/Image/ZN_MS_15B_BeamLance.png
isVisible:false
basePositionFromLegEnd:arm11
imageScale:0.95
xOffsetRelative:13
yOffsetRelative:35
dirOffset:-5



[turret_ZN_MS_15B_BeamLance_B2]
x:0
y:0
invisible:true

canShoot:false

showRangeUIGuide:false
projectile:ZN_MS_15B_BeamLance_B2_Projectile

delay:3s
limitingMinRange:0
limitingRange:0

canAttackMaxAngle:60
barrelX:0
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamSaber_1.ogg
shoot_sound_vol:0.5

[projectile_ZN_MS_15B_BeamLance_B2_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Saber_L_B*1
(
    addResources=
    CqbDamage:3750
    |CqbBeamDamage:3750
    |DpDamage:750
    |WeaponAccuracy:100
    |PartBreakModifier=0.75
    |CockpitBreakModifier=1.25
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=1.0
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightHitRange:35
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileLife:0.25
    |ProjectileAttackTimes:1
)
"""









[hiddenAction_ZN_MS_15B_BeamLance_B2_Trigger]
alsoTriggerAction:ZN_MS_15B_BeamLance_B2_Fire
[hiddenAction_ZN_MS_15B_BeamLance_B2_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MS_15B_BeamLance_B2_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) 
and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50
"""
setUnitMemory:ZN_MS_15B_BeamLance_B2_CDTimer=self.timeAlive+${ZN_MS_15B_BeamLance_B2_CD}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Cqb,
ZN_MS_15B_BeamLance_B2_SetWeaponIndex,
PlayCommon_Melee_B2_Step_1,
ZN_MS_15B_BeamLance_B2_Step_1
"""
[hiddenAction_ZN_MS_15B_BeamLance_B2_Step_1]
alsoQueueAction:"""
ZN_MS_15B_BeamLance_B2_Fire_Step_1,
ZN_MS_15B_BeamLance_B2_Fire_Step_2,
ZN_MS_15B_BeamLance_B2_Fire_Step_3,
ZN_MS_15B_BeamLance_B2_Fire_Step_Final
"""







[hiddenAction_ZN_MS_15B_BeamLance_B2_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MS_15B_BeamLance_B2_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_ZN_MS_15B_BeamLance_B2_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_MS_15B_BeamLance_B2
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_2_Yellow_R_S
[hiddenAction_ZN_MS_15B_BeamLance_B2_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
fireTurretXAtGround:ZN_MS_15B_BeamLance_B2
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_2_Yellow_R_S
[hiddenAction_ZN_MS_15B_BeamLance_B2_Fire_Step_Final]
buildSpeed:1.5s
alsoTriggerAction:SetAttackingOff

