[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Cqb/Common/Cqb_Fire_2_White_R.gw,
ROOT:Template\Unit\Animation\Cqb\Common_Melee_B.gw
"""

@memory EF_HarpoonGun_Cqb_B_CDTimer:float
@global EF_HarpoonGun_Cqb_B_CD=3



[decal_EF_HarpoonGun_Cqb_B]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\EF_HarpoonGun.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.75
xOffsetRelative: 1
yOffsetRelative: 5.5
dirOffset:0
[decal_EF_HarpoonGun_Cqb_B_Harpoon_1]
@copyFromSection:decal_EF_HarpoonGun_Cqb_B
image:ROOT:Resource/Image/Bullet/Shell/Harpoon_1.png
imageScale:0.65
xOffsetRelative: 2.5
yOffsetRelative: 31
[decal_EF_HarpoonGun_Cqb_B_Harpoon_2]
@copyFromSection:decal_EF_HarpoonGun_Cqb_B
imageScale:0.65
xOffsetRelative: -0.5
yOffsetRelative: 31
image:ROOT:Resource/Image/Bullet/Shell/Harpoon_1.png



[turret_EF_HarpoonGun_Cqb_B]
x:0
y:0
invisible:true

canShoot:false

showRangeUIGuide:false
projectile:EF_HarpoonGun_Cqb_B_Projectile

delay:3s
limitingMinRange:0
limitingRange:0

canAttackMaxAngle:60
barrelX:0
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/Fist_2.ogg
shoot_sound_vol:0.5

[projectile_EF_HarpoonGun_Cqb_B_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Saber_B*1
(
    addResources=
    CqbDamage:2750
    |CqbShellDamage:2750
    |DpDamage:750
    |WeaponAccuracy:125
    |PartBreakModifier=0.75
    |CockpitBreakModifier=1.25
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightHitRange:35
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileLife:0.25
    |ProjectileAttackTimes:1
)
"""









[hiddenAction_EF_HarpoonGun_Cqb_B_Trigger]
alsoTriggerAction:EF_HarpoonGun_Cqb_B_Fire
[hiddenAction_EF_HarpoonGun_Cqb_B_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_HarpoonGun_Cqb_B_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) 
and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50
"""
setUnitMemory:EF_HarpoonGun_Cqb_B_CDTimer=self.timeAlive+${EF_HarpoonGun_Cqb_B_CD}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Cqb,
EF_HarpoonGun_Cqb_B_SetWeaponIndex,
PlayCommon_Melee_B_Step_1,
EF_HarpoonGun_Cqb_B_Step_1
"""
[hiddenAction_EF_HarpoonGun_Cqb_B_Step_1]
alsoQueueAction:"""
EF_HarpoonGun_Cqb_B_Fire_Step_1,
EF_HarpoonGun_Cqb_B_Fire_Step_2,
EF_HarpoonGun_Cqb_B_Fire_Step_Final
"""







[hiddenAction_EF_HarpoonGun_Cqb_B_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_HarpoonGun_Cqb_B_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.4s
[hiddenAction_EF_HarpoonGun_Cqb_B_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_HarpoonGun_Cqb_B
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_2_White_R
[hiddenAction_EF_HarpoonGun_Cqb_B_Fire_Step_Final]
buildSpeed:1.0s
alsoTriggerAction:SetAttackingOff

