"""







[hiddenAction_TITANS_ShieldBoostedRifle_Cqb_BF_Blue_Trigger]
alsoTriggerAction:TITANS_ShieldBoostedRifle_Cqb_BF_Blue_Fire
[hiddenAction_TITANS_ShieldBoostedRifle_Cqb_BF_Blue_Fire]
requireConditional:"""
if self.timeAlive>memory.TITANS_ShieldBoostedRifle_Cqb_BF_Blue_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) 
and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50
"""
setUnitMemory:TITANS_ShieldBoostedRifle_Cqb_BF_Blue_CDTimer=self.timeAlive+${TITANS_ShieldBoostedRifle_Cqb_BF_Blue_CD}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Cqb,
TITANS_ShieldBoostedRifle_Cqb_BF_Blue_B_SetWeaponIndex,
PlayCommon_Melee_B_Step_1,
TITANS_ShieldBoostedRifle_Cqb_BF_Blue_Step_1
"""
[hiddenAction_TITANS_ShieldBoostedRifle_Cqb_BF_Blue_Step_1]
