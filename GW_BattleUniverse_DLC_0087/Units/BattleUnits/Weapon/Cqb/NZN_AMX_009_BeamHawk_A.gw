[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Cqb/Common/Cqb_Fire_1_Yellow_R.gw,
ROOT:Template/Unit/Animation/Cqb/Common_Melee_TwoHanded_A.gw
"""

@memory NZN_AMX_009_BeamHawk_A_CDTimer:float
@global NZN_AMX_009_BeamHawk_A_CD=3.5



[decal_NZN_AMX_009_BeamHawk_A]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Cqb\Image\NZN_AMX_009_BeamHawk.png
isVisible:false
basePositionFromLegEnd:arm3
imageScale:1
imageScaleY:1.1
imageScaleX:1.0
xOffsetRelative:2
yOffsetRelative:25
dirOffset:45


[turret_NZN_AMX_009_BeamHawk_A_A]
x:0
y:0
invisible:true

canShoot:false

showRangeUIGuide:false
projectile:NZN_AMX_009_BeamHawk_A_A_Projectile

delay:3s
limitingMinRange:0
limitingRange:0

canAttackMaxAngle:60
barrelX:0
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\HeatHawk_1.ogg
shoot_sound_vol:0.5

[projectile_NZN_AMX_009_BeamHawk_A_A_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Saber_L_A*1
(
    addResources=
    CqbDamage:9000
    |CqbBeamDamage:9000
    |DpDamage:1250
    |WeaponAccuracy:100
    |PartBreakModifier=1.5
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightHitRange:35
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileLife:0.25
    |ProjectileAttackTimes:4
)
"""







[hiddenAction_NZN_AMX_009_BeamHawk_A_Trigger]
alsoTriggerAction:NZN_AMX_009_BeamHawk_A_Fire
[hiddenAction_NZN_AMX_009_BeamHawk_A_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_AMX_009_BeamHawk_A_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) 
and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50
"""
setUnitMemory:NZN_AMX_009_BeamHawk_A_CDTimer=self.timeAlive+${NZN_AMX_009_BeamHawk_A_CD}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Cqb,
NZN_AMX_009_BeamHawk_A_SetWeaponIndex,
PlayCommon_Melee_TwoHanded_A_Step_1,
NZN_AMX_009_BeamHawk_A_Step_1
"""
[hiddenAction_NZN_AMX_009_BeamHawk_A_Step_1]
alsoQueueAction:"""
NZN_AMX_009_BeamHawk_A_Fire_Step_1,
NZN_AMX_009_BeamHawk_A_Fire_Step_2,
NZN_AMX_009_BeamHawk_A_Fire_Step_Final
"""







[hiddenAction_NZN_AMX_009_BeamHawk_A_SetWeaponIndex]
isVisible:false


[hiddenAction_NZN_AMX_009_BeamHawk_A_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.6s
[hiddenAction_NZN_AMX_009_BeamHawk_A_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false
"""
buildSpeed:0s
fireTurretXAtGround:NZN_AMX_009_BeamHawk_A_A
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_1_Yellow_R_L
[hiddenAction_NZN_AMX_009_BeamHawk_A_Fire_Step_Final]
buildSpeed:1.5s
alsoTriggerAction:SetAttackingOff

