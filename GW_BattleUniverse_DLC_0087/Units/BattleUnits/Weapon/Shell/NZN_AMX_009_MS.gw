[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""


@memory NZN_AMX_009_MS_CDTimer:float
@global NZN_AMX_009_MS_CD=9
@global NZN_AMX_009_MS_EN=25




[turret_NZN_AMX_009_MS]
x:0
y:0

canShoot:false
projectile:NZN_AMX_009_MS_Projectile

delay:0.15s
limitingRange:0

canAttackMaxAngle:15
barrelX:0
barrelY:-15

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_NZN_AMX_009_MS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS_NZN_AMX_009*1
(
    addResources=
    ShellDamage:6000
    |DpDamage:250
    |WeaponAccuracy=85
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=0.75
    |AntiAir=1.0 
    |AntiLand=1.0
    |AntiSpace=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=15
    |ProjectileSpeed:45
    |ProjectileTurnspeed:1.75
    |ProjectileSpread:0
    |ProjectileExplosionRange:40
    |ProjectileLife:40
)
"""






[hiddenAction_NZN_AMX_009_MS_Trigger]
alsoTriggerAction:NZN_AMX_009_MS_Fire
[hiddenAction_NZN_AMX_009_MS_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_AMX_009_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:NZN_AMX_009_MS_CDTimer=self.timeAlive+${NZN_AMX_009_MS_CD}
addResources:EN=-${NZN_AMX_009_MS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
NZN_AMX_009_MS_SetWeaponIndex,
NZN_AMX_009_MS_B2_Step_1
"""
[hiddenAction_NZN_AMX_009_MS_B2_Step_1]
alsoQueueAction:"""
NZN_AMX_009_MS_Fire_Step_1,
NZN_AMX_009_MS_Fire_Step_2,
NZN_AMX_009_MS_Fire_Step_3,
NZN_AMX_009_MS_Fire_Step_3,
NZN_AMX_009_MS_Fire_Step_Final
"""





[hiddenAction_NZN_AMX_009_MS_SetWeaponIndex]
isVisible:false


[hiddenAction_NZN_AMX_009_MS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_NZN_AMX_009_MS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:NZN_AMX_009_MS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_L_Step_1
[hiddenAction_NZN_AMX_009_MS_Fire_Step_3]
@copyFromSection:hiddenAction_NZN_AMX_009_MS_Fire_Step_2
buildSpeed:${turret_NZN_AMX_009_MS.delay}
[hiddenAction_NZN_AMX_009_MS_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


