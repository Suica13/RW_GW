[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""


@memory TITANS_120mmMGKai_CDTimer:float
@global TITANS_120mmMGKai_CD=2
@global TITANS_120mmMGKai_EN=20





[decal_TITANS_120mmMGKai]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\TITANS_120mmMGKai.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 2
yOffsetRelative: 15
dirOffset:0
[decal_TITANS_120mmMGKai_NotUsing]
@copyFromSection:decal_TITANS_120mmMGKai
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.9
xOffsetRelative:1
yOffsetRelative:-8.5
dirOffset:-90








[turret_TITANS_120mmMGKai]
x:0
y:0

canShoot:false
projectile:TITANS_120mmMGKai_Projectile

delay:0.125s
limitingRange:0

canAttackMaxAngle:15
barrelX:11
barrelY:30

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_2.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_TITANS_120mmMGKai_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:900
    |ShellAPDamage:300
    |DpDamage:40
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:90
    |ProjectileSpread:5
    |ProjectileLife:20
)
"""







[hiddenAction_TITANS_120mmMGKai_Trigger]
alsoTriggerAction:TITANS_120mmMGKai_Fire
[hiddenAction_TITANS_120mmMGKai_Fire]
requireConditional:"""
if self.timeAlive>memory.TITANS_120mmMGKai_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)   
and self.resource.EN>0
"""
setUnitMemory:TITANS_120mmMGKai_CDTimer=self.timeAlive+${TITANS_120mmMGKai_CD}
addResources:EN=-${TITANS_120mmMGKai_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
TITANS_120mmMGKai_SetWeaponIndex,
TITANS_120mmMGKai_B8_Step_1
"""
[hiddenAction_TITANS_120mmMGKai_B8_Step_1]
alsoQueueAction:"""
TITANS_120mmMGKai_Fire_Step_1,
TITANS_120mmMGKai_Fire_Step_2,
TITANS_120mmMGKai_Fire_Step_3,
TITANS_120mmMGKai_Fire_Step_3,
TITANS_120mmMGKai_Fire_Step_3,
TITANS_120mmMGKai_Fire_Step_3,
TITANS_120mmMGKai_Fire_Step_3,
TITANS_120mmMGKai_Fire_Step_3,
TITANS_120mmMGKai_Fire_Step_3,
TITANS_120mmMGKai_Fire_Step_Final
"""





[hiddenAction_TITANS_120mmMGKai_SetWeaponIndex]
isVisible:false


[hiddenAction_TITANS_120mmMGKai_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_TITANS_120mmMGKai_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:TITANS_120mmMGKai
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_TITANS_120mmMGKai_Fire_Step_3]
@copyFromSection:hiddenAction_TITANS_120mmMGKai_Fire_Step_2
buildSpeed:${turret_TITANS_120mmMGKai.delay}
[hiddenAction_TITANS_120mmMGKai_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


