[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""


@memory NZN_AMA_01X_MS_CDTimer:float
@global NZN_AMA_01X_MS_CD=4
@global NZN_AMA_01X_MS_EN=60










[turret_NZN_AMA_01X_MS]
x:0
y:0

canShoot:false
projectile:NZN_AMA_01X_MS_Projectile

delay:0.125s
limitingRange:0

canAttackMaxAngle:15
barrelX:5
barrelY:-10

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.25
shoot_flame:BZ_Fire_1_S
[turret_NZN_AMA_01X_MS_L]
@copyFromSection:turret_NZN_AMA_01X_MS
barrelX:-5



[projectile_NZN_AMA_01X_MS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS_Red*1
(
    addResources=
    ShellDamage:3500
    |DpDamage:70
    |WeaponAccuracy=85
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightHitRange=20
    |HeightChangeSpeed=2
    |ProjectileSpeed:35
    |ProjectileTurnspeed:1.5
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:40

    |EquipmentIndex:1
    |EquipmentIndex2:150
)
"""







[hiddenAction_NZN_AMA_01X_MS_Trigger]
alsoTriggerAction:NZN_AMA_01X_MS_Fire
[hiddenAction_NZN_AMA_01X_MS_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_AMA_01X_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:NZN_AMA_01X_MS_CDTimer=self.timeAlive+${NZN_AMA_01X_MS_CD}
addResources:EN=-${NZN_AMA_01X_MS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
NZN_AMA_01X_MS_SetWeaponIndex,
NZN_AMA_01X_MS_B8_Step_1
"""
[hiddenAction_NZN_AMA_01X_MS_B8_Step_1]
alsoQueueAction:"""
NZN_AMA_01X_MS_Fire_Step_1,
NZN_AMA_01X_MS_Fire_Step_2,
NZN_AMA_01X_MS_Fire_Step_3,
NZN_AMA_01X_MS_Fire_Step_3,
NZN_AMA_01X_MS_Fire_Step_3,
NZN_AMA_01X_MS_Fire_Step_3,
NZN_AMA_01X_MS_Fire_Step_Final
"""





[hiddenAction_NZN_AMA_01X_MS_SetWeaponIndex]
isVisible:false


[hiddenAction_NZN_AMA_01X_MS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
alsoTriggerAction:PlayCommon_Cannon_Shoot_A_Step_1
[hiddenAction_NZN_AMA_01X_MS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false
"""
buildSpeed:0s
fireTurretXAtGround:NZN_AMA_01X_MS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:NZN_AMA_01X_MS_Fire_Step_Sub
[hiddenAction_NZN_AMA_01X_MS_Fire_Step_3]
@copyFromSection:hiddenAction_NZN_AMA_01X_MS_Fire_Step_2
buildSpeed:${turret_NZN_AMA_01X_MS.delay}

[hiddenAction_NZN_AMA_01X_MS_Fire_Step_Sub]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false
"""
buildSpeed:0s
fireTurretXAtGround:NZN_AMA_01X_MS_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_NZN_AMA_01X_MS_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


