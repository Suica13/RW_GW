[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""


@memory EF_100mmMG_Blue_CDTimer:float
@global EF_100mmMG_Blue_CD=3
@global EF_100mmMG_Blue_EN=20





[decal_EF_100mmMG_Blue]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\EF_100mmMG_Blue.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.85
xOffsetRelative: 0
yOffsetRelative: 14
dirOffset:0
[decal_EF_100mmMG_Blue_NotUsing]
@copyFromSection:decal_EF_100mmMG_Blue
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.75
xOffsetRelative:-1
yOffsetRelative:-8.5
dirOffset:-90







[turret_EF_100mmMG_Blue]
x:0
y:0

canShoot:false
projectile:EF_100mmMG_Blue_Projectile

delay:0.075s
limitingRange:0

canAttackMaxAngle:15
barrelX:8
barrelY:24

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_2.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_EF_100mmMG_Blue_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:1500
    |DpDamage:45
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:85
    |ProjectileSpread:3
    |ProjectileLife:25
)
"""







[hiddenAction_EF_100mmMG_Blue_Trigger]
alsoTriggerAction:EF_100mmMG_Blue_Fire
[hiddenAction_EF_100mmMG_Blue_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_100mmMG_Blue_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_100mmMG_Blue_CDTimer=self.timeAlive+${EF_100mmMG_Blue_CD}
addResources:EN=-${EF_100mmMG_Blue_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_100mmMG_Blue_SetWeaponIndex,
EF_100mmMG_Blue_B9_Step_1
"""
[hiddenAction_EF_100mmMG_Blue_B9_Step_1]
alsoQueueAction:"""
EF_100mmMG_Blue_Fire_Step_1,
EF_100mmMG_Blue_Fire_Step_2,
EF_100mmMG_Blue_Fire_Step_3,
EF_100mmMG_Blue_Fire_Step_3,
EF_100mmMG_Blue_Fire_Step_4,

EF_100mmMG_Blue_Fire_Step_3,
EF_100mmMG_Blue_Fire_Step_3,
EF_100mmMG_Blue_Fire_Step_3,
EF_100mmMG_Blue_Fire_Step_4,

EF_100mmMG_Blue_Fire_Step_3,
EF_100mmMG_Blue_Fire_Step_3,
EF_100mmMG_Blue_Fire_Step_3,
EF_100mmMG_Blue_Fire_Step_Final
"""





[hiddenAction_EF_100mmMG_Blue_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_100mmMG_Blue_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_EF_100mmMG_Blue_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_100mmMG_Blue
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_EF_100mmMG_Blue_Fire_Step_3]
@copyFromSection:hiddenAction_EF_100mmMG_Blue_Fire_Step_2
buildSpeed:${turret_EF_100mmMG_Blue.delay}
[hiddenAction_EF_100mmMG_Blue_Fire_Step_4]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.1s
[hiddenAction_EF_100mmMG_Blue_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


