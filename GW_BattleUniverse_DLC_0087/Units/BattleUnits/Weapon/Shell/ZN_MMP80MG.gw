[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""


@memory ZN_MMP80MG_CDTimer:float
@global ZN_MMP80MG_CD=2
@global ZN_MMP80MG_EN=20





[decal_ZN_MMP80MG]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\ZN_MMP80MG.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.9
xOffsetRelative: 3.5
yOffsetRelative: 14
dirOffset:0
[decal_ZN_MMP80MG_NotUsing]
@copyFromSection:decal_ZN_MMP80MG
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.75
xOffsetRelative:2
yOffsetRelative:-8.5
dirOffset:-90







[turret_ZN_MMP80MG]
x:0
y:0

canShoot:false
projectile:ZN_MMP80MG_Projectile

delay:0.1s
limitingRange:0

canAttackMaxAngle:15
barrelX:13
barrelY:32

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_1.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_ZN_MMP80MG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:725
    |DpDamage:30
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:5
    |ProjectileLife:25
)
"""







[hiddenAction_ZN_MMP80MG_Trigger]
alsoTriggerAction:ZN_MMP80MG_Fire
[hiddenAction_ZN_MMP80MG_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MMP80MG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:ZN_MMP80MG_CDTimer=self.timeAlive+${ZN_MMP80MG_CD}
addResources:EN=-${ZN_MMP80MG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_MMP80MG_SetWeaponIndex,
ZN_MMP80MG_B9_Step_1
"""
[hiddenAction_ZN_MMP80MG_B9_Step_1]
alsoQueueAction:"""
ZN_MMP80MG_Fire_Step_1,
ZN_MMP80MG_Fire_Step_2,
ZN_MMP80MG_Fire_Step_3,
ZN_MMP80MG_Fire_Step_3,
ZN_MMP80MG_Fire_Step_3,
ZN_MMP80MG_Fire_Step_3,
ZN_MMP80MG_Fire_Step_3,
ZN_MMP80MG_Fire_Step_3,
ZN_MMP80MG_Fire_Step_3,
ZN_MMP80MG_Fire_Step_3,
ZN_MMP80MG_Fire_Step_Final
"""





[hiddenAction_ZN_MMP80MG_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MMP80MG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_ZN_MMP80MG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_MMP80MG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_ZN_MMP80MG_Fire_Step_3]
@copyFromSection:hiddenAction_ZN_MMP80MG_Fire_Step_2
buildSpeed:${turret_ZN_MMP80MG.delay}
[hiddenAction_ZN_MMP80MG_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


