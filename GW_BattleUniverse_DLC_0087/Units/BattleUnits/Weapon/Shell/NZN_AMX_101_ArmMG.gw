[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""


@memory NZN_AMX_101_ArmMG_CDTimer:float
@global NZN_AMX_101_ArmMG_CD=3
@global NZN_AMX_101_ArmMG_EN=20



[turret_NZN_AMX_101_ArmMG]
x:0
y:0

canShoot:false
projectile:NZN_AMX_101_ArmMG_Projectile

delay:0.05s
limitingRange:0

canAttackMaxAngle:15
barrelX:-12
barrelY:12

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_1.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_NZN_AMX_101_ArmMG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:950
    |ShellAPDamage:250
    |DpDamage:35
    |WeaponAccuracy=110
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:90
    |ProjectileSpread:5
    |ProjectileLife:25
)
"""







[hiddenAction_NZN_AMX_101_ArmMG_Trigger]
alsoTriggerAction:NZN_AMX_101_ArmMG_Fire
[hiddenAction_NZN_AMX_101_ArmMG_Fire]
requireConditional:"""
if self.timeAlive>memory.NZN_AMX_101_ArmMG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:NZN_AMX_101_ArmMG_CDTimer=self.timeAlive+${NZN_AMX_101_ArmMG_CD}
addResources:EN=-${NZN_AMX_101_ArmMG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
NZN_AMX_101_ArmMG_SetWeaponIndex,
NZN_AMX_101_ArmMG_B10_Step_1
"""
[hiddenAction_NZN_AMX_101_ArmMG_B10_Step_1]
alsoQueueAction:"""
NZN_AMX_101_ArmMG_Fire_Step_1,
NZN_AMX_101_ArmMG_Fire_Step_2,
NZN_AMX_101_ArmMG_Fire_Step_3,
NZN_AMX_101_ArmMG_Fire_Step_3,
NZN_AMX_101_ArmMG_Fire_Step_3,
NZN_AMX_101_ArmMG_Fire_Step_3,
NZN_AMX_101_ArmMG_Fire_Step_3,
NZN_AMX_101_ArmMG_Fire_Step_3,
NZN_AMX_101_ArmMG_Fire_Step_3,
NZN_AMX_101_ArmMG_Fire_Step_3,
NZN_AMX_101_ArmMG_Fire_Step_Final
"""





[hiddenAction_NZN_AMX_101_ArmMG_SetWeaponIndex]
isVisible:false


[hiddenAction_NZN_AMX_101_ArmMG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.1s
[hiddenAction_NZN_AMX_101_ArmMG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:NZN_AMX_101_ArmMG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_L_Step_1
[hiddenAction_NZN_AMX_101_ArmMG_Fire_Step_3]
@copyFromSection:hiddenAction_NZN_AMX_101_ArmMG_Fire_Step_2
buildSpeed:${turret_NZN_AMX_101_ArmMG.delay}
alsoTriggerAction:PlayCommon_Shoot_A_FA_Step_1
[hiddenAction_NZN_AMX_101_ArmMG_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


