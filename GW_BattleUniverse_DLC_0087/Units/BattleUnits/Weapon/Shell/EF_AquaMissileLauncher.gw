[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""


@memory EF_AquaMissileLauncher_CDTimer:float
@global EF_AquaMissileLauncher_CD=6
@global EF_AquaMissileLauncher_EN=90





[decal_EF_AquaMissileLauncher]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\EF_AquaMissileLauncher.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 1
yOffsetRelative: 8
dirOffset:0
[decal_EF_AquaMissileLauncher_NotUsing]
@copyFromSection:decal_EF_AquaMissileLauncher
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.9
xOffsetRelative:5
yOffsetRelative:-12
dirOffset:-90











[turret_EF_AquaMissileLauncher]
x:0
y:0

canShoot:false
projectile:EF_AquaMissileLauncher_Projectile

delay:0.3s
limitingRange:0

canAttackMaxAngle:15
barrelX:10
barrelY:18

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_EF_AquaMissileLauncher_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS*1
(
    addResources=
    ShellDamage:1750
    |DpDamage:60
    |WeaponAccuracy=90
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=1.5
    |AntiAir=0.5 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=10
    |ProjectileSpeed:40
    |ProjectileTurnspeed:1.25
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:40
)
"""

[projectile_EF_AquaMissileLauncher_Projectile_L]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS_L*1
(
    addResources=
    ShellDamage:3500
    |DpDamage:50
    |WeaponAccuracy=90
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=1.5
    |AntiAir=0.5 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=10
    |ProjectileSpeed:40
    |ProjectileTurnspeed:1.25
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:40
)
"""






[hiddenAction_EF_AquaMissileLauncher_Trigger]
alsoTriggerAction:EF_AquaMissileLauncher_Fire
[hiddenAction_EF_AquaMissileLauncher_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_AquaMissileLauncher_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_AquaMissileLauncher_CDTimer=self.timeAlive+${EF_AquaMissileLauncher_CD}
addResources:EN=-${EF_AquaMissileLauncher_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_AquaMissileLauncher_SetWeaponIndex,
EF_AquaMissileLauncher_B3_Step_1
"""
[hiddenAction_EF_AquaMissileLauncher_B3_Step_1]
alsoQueueAction:"""
EF_AquaMissileLauncher_Fire_Step_1,
EF_AquaMissileLauncher_Fire_Step_2,
EF_AquaMissileLauncher_Fire_Step_3,
EF_AquaMissileLauncher_Fire_Step_3,
EF_AquaMissileLauncher_Fire_Step_4,
EF_AquaMissileLauncher_Fire_Step_Final
"""





[hiddenAction_EF_AquaMissileLauncher_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_AquaMissileLauncher_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_EF_AquaMissileLauncher_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_AquaMissileLauncher
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_EF_AquaMissileLauncher_Fire_Step_3]
@copyFromSection:hiddenAction_EF_AquaMissileLauncher_Fire_Step_2
buildSpeed:${turret_EF_AquaMissileLauncher.delay}
[hiddenAction_EF_AquaMissileLauncher_Fire_Step_4]
@copyFromSection:hiddenAction_EF_AquaMissileLauncher_Fire_Step_2
buildSpeed:${turret_EF_AquaMissileLauncher.delay}
fireTurretXAtGround_withProjectile:EF_AquaMissileLauncher_Projectile_L
[hiddenAction_EF_AquaMissileLauncher_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


