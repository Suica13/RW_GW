[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""


@memory AEUG_RX_178_AEUG_FXA_05D_MS_CDTimer:float
@global AEUG_RX_178_AEUG_FXA_05D_MS_CD=4
@global AEUG_RX_178_AEUG_FXA_05D_MS_EN=60










[turret_AEUG_RX_178_AEUG_FXA_05D_MS]
x:0
y:0

canShoot:false
projectile:AEUG_RX_178_AEUG_FXA_05D_MS_Projectile

delay:0.125s
limitingRange:0

canAttackMaxAngle:15
barrelX:15
barrelY:-20

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.25
shoot_flame:BZ_Fire_1_S
[turret_AEUG_RX_178_AEUG_FXA_05D_MS_L]
@copyFromSection:turret_AEUG_RX_178_AEUG_FXA_05D_MS
barrelX:-15



[projectile_AEUG_RX_178_AEUG_FXA_05D_MS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS_Red*1
(
    addResources=
    ShellDamage:2500
    |DpDamage:75
    |WeaponAccuracy=85
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightHitRange=20
    |HeightChangeSpeed=2
    |ProjectileSpeed:35
    |ProjectileTurnspeed:1.5
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:50

    |EquipmentIndex:1
    |EquipmentIndex2:150
)
"""







[hiddenAction_AEUG_RX_178_AEUG_FXA_05D_MS_Trigger]
alsoTriggerAction:AEUG_RX_178_AEUG_FXA_05D_MS_Fire
[hiddenAction_AEUG_RX_178_AEUG_FXA_05D_MS_Fire]
requireConditional:"""
if self.timeAlive>memory.AEUG_RX_178_AEUG_FXA_05D_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:AEUG_RX_178_AEUG_FXA_05D_MS_CDTimer=self.timeAlive+${AEUG_RX_178_AEUG_FXA_05D_MS_CD}
addResources:EN=-${AEUG_RX_178_AEUG_FXA_05D_MS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
AEUG_RX_178_AEUG_FXA_05D_MS_SetWeaponIndex,
AEUG_RX_178_AEUG_FXA_05D_MS_B12_Step_1
"""
[hiddenAction_AEUG_RX_178_AEUG_FXA_05D_MS_B12_Step_1]
alsoQueueAction:"""
AEUG_RX_178_AEUG_FXA_05D_MS_Fire_Step_1,
AEUG_RX_178_AEUG_FXA_05D_MS_Fire_Step_2,
AEUG_RX_178_AEUG_FXA_05D_MS_Fire_Step_3,
AEUG_RX_178_AEUG_FXA_05D_MS_Fire_Step_3,
AEUG_RX_178_AEUG_FXA_05D_MS_Fire_Step_3,
AEUG_RX_178_AEUG_FXA_05D_MS_Fire_Step_3,
AEUG_RX_178_AEUG_FXA_05D_MS_Fire_Step_3,
AEUG_RX_178_AEUG_FXA_05D_MS_Fire_Step_3,
AEUG_RX_178_AEUG_FXA_05D_MS_Fire_Step_Final
"""





[hiddenAction_AEUG_RX_178_AEUG_FXA_05D_MS_SetWeaponIndex]
isVisible:false


[hiddenAction_AEUG_RX_178_AEUG_FXA_05D_MS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
alsoTriggerAction:PlayCommon_Cannon_Shoot_A_Step_1
[hiddenAction_AEUG_RX_178_AEUG_FXA_05D_MS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:AEUG_RX_178_AEUG_FXA_05D_MS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:AEUG_RX_178_AEUG_FXA_05D_MS_Fire_Step_Sub
[hiddenAction_AEUG_RX_178_AEUG_FXA_05D_MS_Fire_Step_3]
@copyFromSection:hiddenAction_AEUG_RX_178_AEUG_FXA_05D_MS_Fire_Step_2
buildSpeed:${turret_AEUG_RX_178_AEUG_FXA_05D_MS.delay}

[hiddenAction_AEUG_RX_178_AEUG_FXA_05D_MS_Fire_Step_Sub]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:AEUG_RX_178_AEUG_FXA_05D_MS_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_AEUG_RX_178_AEUG_FXA_05D_MS_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


