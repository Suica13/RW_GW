[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory TITANS_PMX_001_AntiShipMS_CDTimer:float
@global TITANS_PMX_001_AntiShipMS_CD=300
@global TITANS_PMX_001_AntiShipMS_EN=150





[turret_TITANS_PMX_001_AntiShipMS]
x:0
y:0

canShoot:false
showRangeUIGuide:false
projectile:TITANS_PMX_001_AntiShipMS_Projectile

delay:0.1s
limitingRange:600
limitingAngle:15

canAttackMaxAngle:15
barrelX:25
barrelY:-10

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.15
shoot_flame:BZ_Fire_1_S
[turret_TITANS_PMX_001_AntiShipMS_L]
@copyFromSection:turret_TITANS_PMX_001_AntiShipMS
barrelX:-25



[projectile_TITANS_PMX_001_AntiShipMS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_TITANS_PMX_001_AntiShipMS_BurningArea_B*1
(
    addResources=
    ShellDamage:6500
    |DpDamage:125
    |WeaponAccuracy=75
    |PartBreakModifier=1.25
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.5
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.5
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightHitRange=20
    |HeightChangeSpeed=2
    |ProjectileSpeed:30
    |ProjectileTurnspeed:0.5
    |ProjectileSpread:0
    |ProjectileExplosionRange:55
    |ProjectileLife:25
)
"""


[action_TITANS_PMX_001_AntiShipMS_Trigger]
pos:10
text:AntiShipMS %{select(self.timeAlive<=memory.TITANS_PMX_001_AntiShipMS_CDTimer,str(int(memory.TITANS_PMX_001_AntiShipMS_CDTimer-self.timeAlive))+"s","OK")}
text_zh:对舰导弹 %{select(self.timeAlive<=memory.TITANS_PMX_001_AntiShipMS_CDTimer,str(int(memory.TITANS_PMX_001_AntiShipMS_CDTimer-self.timeAlive))+"秒","OK")}
text_KP:100

displayType:infoOnly

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true

iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_3.png
highPriorityQueue:true

price:EN=${TITANS_PMX_001_AntiShipMS_EN}


isVisible:if self.parent.hp<=0  

isGuiBlinking:"""
if self.timeAlive>memory.TITANS_PMX_001_AntiShipMS_CDTimer
"""

isLocked:if self.timeAlive<=memory.TITANS_PMX_001_AntiShipMS_CDTimer
isLockedMessage:In CD
isLockedMessage_zh:冷却中
isLockedAlt2:if ${cantAction}==true or ${onSkill}==true or ${allowAI}==true
isLockedAlt2Message:Cant Action
isLockedAlt2Message_zh:无法行动

alsoTriggerAction:TITANS_PMX_001_AntiShipMS_Fire
[hiddenAction_TITANS_PMX_001_AntiShipMS_Fire]
alsoTriggerAction:"""
SetAttackingOn,
SetOnSkillOn,
SendEnemyTryAttack_Shoot,
PlayCommon_Cannon_Shoot_A_Step_1,
TITANS_PMX_001_AntiShipMS_SetWeaponIndex,
TITANS_PMX_001_AntiShipMS_B8_Step_1
"""
[hiddenAction_TITANS_PMX_001_AntiShipMS_B8_Step_1]
alsoQueueAction:"""
TITANS_PMX_001_AntiShipMS_Fire_Step_1,
TITANS_PMX_001_AntiShipMS_Fire_Step_2,
TITANS_PMX_001_AntiShipMS_Fire_Step_3,
TITANS_PMX_001_AntiShipMS_Fire_Step_2,
TITANS_PMX_001_AntiShipMS_Fire_Step_3,
TITANS_PMX_001_AntiShipMS_Fire_Step_2,
TITANS_PMX_001_AntiShipMS_Fire_Step_3,
TITANS_PMX_001_AntiShipMS_Fire_Step_2,
TITANS_PMX_001_AntiShipMS_Fire_Step_3,
TITANS_PMX_001_AntiShipMS_Fire_Step_Final
"""




[hiddenAction_TITANS_PMX_001_AntiShipMS_SetWeaponIndex]
isVisible:false


[hiddenAction_TITANS_PMX_001_AntiShipMS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.45s
setUnitMemory:TITANS_PMX_001_AntiShipMS_CDTimer=self.timeAlive+${TITANS_PMX_001_AntiShipMS_CD}
addResourcesWithLogic:EN=-select(self.isControlledByAI(),${TITANS_PMX_001_AntiShipMS_EN},0)
[hiddenAction_TITANS_PMX_001_AntiShipMS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.01s
fireTurretXAtGround:TITANS_PMX_001_AntiShipMS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_TITANS_PMX_001_AntiShipMS_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.01s
fireTurretXAtGround:TITANS_PMX_001_AntiShipMS_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_TITANS_PMX_001_AntiShipMS_Fire_Step_Final]
buildSpeed:1.0s
alsoTriggerAction:"""
SetOnSkillOff,
SetAttackingOff
"""