[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A2.gw
"""


@memory EF_90mmMG_79D_CDTimer:float
@global EF_90mmMG_79D_CD=3
@global EF_90mmMG_79D_EN=20





[decal_EF_90mmMG_79D]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\EF_90mmMG_79D.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.85
xOffsetRelative: 0
yOffsetRelative: 12
dirOffset:0
[decal_EF_90mmMG_79D_NotUsing]
@copyFromSection:decal_EF_90mmMG_79D
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.75
xOffsetRelative:2
yOffsetRelative:-8.5
dirOffset:-90







[turret_EF_90mmMG_79D]
x:0
y:0

canShoot:false
projectile:EF_90mmMG_79D_Projectile

delay:0.075s
limitingRange:0

canAttackMaxAngle:15
barrelX:8
barrelY:24

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_1.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_EF_90mmMG_79D_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:750
    |ShellAPDamage:300
    |DpDamage:25
    |WeaponAccuracy=75
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:7
    |ProjectileLife:25
)
"""
[projectile_EF_90mmMG_79D_Projectile_GD]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_S*1
(
    addResources=
    ShellDamage:1500
    |DpDamage:150
    |WeaponAccuracy=85
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75
    |AntiLand=1 
    |AntiSpace=1 
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:55
    |ProjectileSpread:2
    |ProjectileExplosionRange:35
    |ProjectileLife:25
)
"""






[hiddenAction_EF_90mmMG_79D_Trigger]
alsoTriggerAction:EF_90mmMG_79D_Fire
[hiddenAction_EF_90mmMG_79D_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_90mmMG_79D_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_90mmMG_79D_CDTimer=self.timeAlive+${EF_90mmMG_79D_CD}
addResources:EN=-${EF_90mmMG_79D_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_90mmMG_79D_SetWeaponIndex,
EF_90mmMG_79D_B12_Step_1
"""
[hiddenAction_EF_90mmMG_79D_B12_Step_1]
alsoQueueAction:"""
EF_90mmMG_79D_Fire_Step_1,
EF_90mmMG_79D_Fire_Step_2,
EF_90mmMG_79D_Fire_Step_3,
EF_90mmMG_79D_Fire_Step_3,
EF_90mmMG_79D_Fire_Step_3,
EF_90mmMG_79D_Fire_Step_3,
EF_90mmMG_79D_Fire_Step_3,
EF_90mmMG_79D_Fire_Step_3,
EF_90mmMG_79D_Fire_Step_3,
EF_90mmMG_79D_Fire_Step_3,
EF_90mmMG_79D_Fire_Step_3,
EF_90mmMG_79D_Fire_Step_3,
EF_90mmMG_79D_Fire_Step_3,
EF_90mmMG_79D_Fire_Step_4,
EF_90mmMG_79D_Fire_Step_Final
"""





[hiddenAction_EF_90mmMG_79D_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_90mmMG_79D_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_EF_90mmMG_79D_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_90mmMG_79D
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A2_Step_1
[hiddenAction_EF_90mmMG_79D_Fire_Step_3]
@copyFromSection:hiddenAction_EF_90mmMG_79D_Fire_Step_2
buildSpeed:${turret_EF_90mmMG_79D.delay}
[hiddenAction_EF_90mmMG_79D_Fire_Step_4]
@copyFromSection:hiddenAction_EF_90mmMG_79D_Fire_Step_2
buildSpeed:${turret_EF_90mmMG_79D.delay}
fireTurretXAtGround_withProjectile:EF_90mmMG_79D_Projectile_GD
[hiddenAction_EF_90mmMG_79D_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


