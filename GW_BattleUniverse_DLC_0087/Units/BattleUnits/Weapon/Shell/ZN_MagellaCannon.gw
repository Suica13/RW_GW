[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_Two_Handed_A.gw
"""

@memory ZN_MagellaCannon_CDTimer:float
@global ZN_MagellaCannon_CD=6
@global ZN_MagellaCannon_EN=45





[decal_ZN_MagellaCannon]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\ZN_MagellaCannon.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.85
xOffsetRelative: 2
yOffsetRelative: 30
dirOffset:0
[decal_ZN_MagellaCannon_NotUsing]
@copyFromSection:decal_ZN_MagellaCannon
image:ROOT:Units/BattleUnits/Weapon/Shell/Image/ZN_MagellaCannon_Backpack.png
order:0
basePositionFromLegEnd:arm2
imageScale:0.9
imageScaleX:-1
xOffsetRelative:-2
yOffsetRelative:-10
dirOffset:-90









[turret_ZN_MagellaCannon]
x:0
y:0

canShoot:false
projectile:ZN_MagellaCannon_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:12
barrelY:35
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Bazooka_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_ZN_MagellaCannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_S_Target*1
(
    addResources=
    ShellDamage:6000
    |DpDamage:500
    |WeaponAccuracy=85
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:65
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:30
)
"""








[hiddenAction_ZN_MagellaCannon_Trigger]
alsoTriggerAction:ZN_MagellaCannon_Fire
[hiddenAction_ZN_MagellaCannon_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MagellaCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:ZN_MagellaCannon_CDTimer=self.timeAlive+${ZN_MagellaCannon_CD}
addResources:EN=-${ZN_MagellaCannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
ZN_MagellaCannon_SetWeaponIndex,
PlayCommon_Shoot_Two_Handed_A_Step_1,
ZN_MagellaCannon_B1_Step_1
"""
[hiddenAction_ZN_MagellaCannon_B1_Step_1]
alsoQueueAction:"""
ZN_MagellaCannon_Fire_Step_1,
ZN_MagellaCannon_Fire_Step_2,
ZN_MagellaCannon_Fire_Step_Final
"""




[hiddenAction_ZN_MagellaCannon_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MagellaCannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
whenBuilding_cannotMove:true
[hiddenAction_ZN_MagellaCannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
whenBuilding_cannotMove:true
fireTurretXAtGround:ZN_MagellaCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MagellaCannon_Fire_Step_Final]
buildSpeed:0.3s
whenBuilding_cannotMove:true
alsoTriggerAction:SetAttackingOff


