[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory EF_180mmCannon_PR_CDTimer:float
@global EF_180mmCannon_PR_CD=5
@global EF_180mmCannon_PR_EN=35





[decal_EF_180mmCannon_PR]
layer:beforeBody
order:3.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\EF_180mmCannon.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.85
xOffsetRelative: 1
yOffsetRelative: 25
dirOffset:0
[decal_EF_180mmCannon_PR_NotUsing]
@copyFromSection:decal_EF_180mmCannon_PR
#image:ROOT:Units/BattleUnits/Weapon/Shell/Image/EF_180mmCannon_PR_Backpack.png
order:0
basePositionFromLegEnd:arm1
imageScale:0.9
imageScaleX:-1
xOffsetRelative:-2
yOffsetRelative:-10
dirOffset:-90







[turret_EF_180mmCannon_PR]
x:0
y:0

canShoot:false
projectile:EF_180mmCannon_PR_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:10
barrelY:25
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Bazooka_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_EF_180mmCannon_PR_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_S_Target*1
(
    addResources=
    ShellDamage:10000
    |DpDamage:500
    |WeaponAccuracy=95
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:70
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:30
)
"""








[hiddenAction_EF_180mmCannon_PR_Trigger]
alsoTriggerAction:EF_180mmCannon_PR_Fire
[hiddenAction_EF_180mmCannon_PR_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_180mmCannon_PR_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:EF_180mmCannon_PR_CDTimer=self.timeAlive+${EF_180mmCannon_PR_CD}
addResources:EN=-${EF_180mmCannon_PR_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_180mmCannon_PR_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
EF_180mmCannon_PR_B1_Step_1
"""
[hiddenAction_EF_180mmCannon_PR_B1_Step_1]
alsoQueueAction:"""
EF_180mmCannon_PR_Fire_Step_1,
EF_180mmCannon_PR_Fire_Step_2,
EF_180mmCannon_PR_Fire_Step_Final
"""




[hiddenAction_EF_180mmCannon_PR_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_180mmCannon_PR_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_EF_180mmCannon_PR_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_180mmCannon_PR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_180mmCannon_PR_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


