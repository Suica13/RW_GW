[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""


@memory ZN_MS_07B_HandMG_CDTimer:float
@global ZN_MS_07B_HandMG_CD=2
@global ZN_MS_07B_HandMG_EN=20











[turret_ZN_MS_07B_HandMG]
x:0
y:0

canShoot:false
projectile:ZN_MS_07B_HandMG_Projectile

delay:0.075s
limitingRange:0

canAttackMaxAngle:15
barrelX:-13
barrelY:18

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/Vulcan_1.ogg
shoot_sound_vol:0.2
shoot_flame:MG_Fire_1_S



[projectile_ZN_MS_07B_HandMG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Vulcan*1
(
    addResources=
    ShellDamage:375
    |DpDamage:35
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=25
    |ProjectileSpeed:85
    |ProjectileSpread:8
    |ProjectileLife:20
)
"""






[hiddenAction_ZN_MS_07B_HandMG_Trigger]
alsoTriggerAction:ZN_MS_07B_HandMG_Fire
[hiddenAction_ZN_MS_07B_HandMG_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MS_07B_HandMG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:ZN_MS_07B_HandMG_CDTimer=self.timeAlive+${ZN_MS_07B_HandMG_CD}
addResources:EN=-${ZN_MS_07B_HandMG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_MS_07B_HandMG_SetWeaponIndex,
ZN_MS_07B_HandMG_B8_Step_1
"""
[hiddenAction_ZN_MS_07B_HandMG_B8_Step_1]
alsoQueueAction:"""
ZN_MS_07B_HandMG_Fire_Step_1,
ZN_MS_07B_HandMG_Fire_Step_2,
ZN_MS_07B_HandMG_Fire_Step_3,
ZN_MS_07B_HandMG_Fire_Step_3,
ZN_MS_07B_HandMG_Fire_Step_3,
ZN_MS_07B_HandMG_Fire_Step_3,
ZN_MS_07B_HandMG_Fire_Step_3,
ZN_MS_07B_HandMG_Fire_Step_3,
ZN_MS_07B_HandMG_Fire_Step_3,
ZN_MS_07B_HandMG_Fire_Step_Final
"""





[hiddenAction_ZN_MS_07B_HandMG_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MS_07B_HandMG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_ZN_MS_07B_HandMG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_MS_07B_HandMG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_L_Step_1
[hiddenAction_ZN_MS_07B_HandMG_Fire_Step_3]
@copyFromSection:hiddenAction_ZN_MS_07B_HandMG_Fire_Step_2
buildSpeed:${turret_ZN_MS_07B_HandMG.delay}
[hiddenAction_ZN_MS_07B_HandMG_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


