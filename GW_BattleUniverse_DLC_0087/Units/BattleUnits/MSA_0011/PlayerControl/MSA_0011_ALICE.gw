[action_Manual_AEUG_MSA_0011_MA_BeamGun]
@copyFromSection:template_ManualWeapon
pos:6
text:Beam cannon
text_zh:光束枪
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
isVisible:if ${manualControlReady} and ((((true))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.AEUG_MSA_0011_MA_BeamGun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false)))) and self.resource.EN>=${AEUG_MSA_0011_MA_BeamGun_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.AEUG_MSA_0011_MA_BeamGun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false)))) and self.resource.EN>=${AEUG_MSA_0011_MA_BeamGun_EN}
alsoTriggerAction:AEUG_MSA_0011_MA_BeamGun_Fire
