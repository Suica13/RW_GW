requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.NZN_AMA_01X_MS_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.backpackBreaked==false)))) and self.resource.EN>=${NZN_AMA_01X_MS_EN}
