setUnitMemory:NZN_AMA_01X_MS_CDTimer=self.timeAlive+${NZN_AMA_01X_MS_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
