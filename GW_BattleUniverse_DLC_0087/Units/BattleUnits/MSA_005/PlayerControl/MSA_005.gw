[core]
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_Common_DetectArea_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false  and memory.Common_DetectArea_Switch==false and self.resource.en>${Common_DetectArea_EN} and not self.hasTags(includes='inHangar'))

[hiddenAction_Common_DetectArea_On]
requireConditional:if (true) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_CameraGun_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false  and self.attacking.hp<=0 and self.timeAlive>memory.Common_CameraGun_CDTimer and self.resource.en>${Common_CameraGun_EN} and not self.hasTags(includes='inHangar'))

[hiddenAction_Common_CameraGun_Fire_Step_1]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_Push_A_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60   and memory.armRBreaked==true)

[hiddenAction_Common_Push_A_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_AEUG_MSA_005_BeamGun_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange  and eventData("RandomWeapon",type="float")>25 and not (    memory.armRBreaked==true     and     memory.armLBreaked==true ))

[hiddenAction_AEUG_MSA_005_BeamGun_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_AEUG_MSA_005_BeamGun_Fire_Step_3]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_ArmGL_L_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and ${onAttacking}==false and memory.armRBreaked==true and memory.armLBreaked==false and eventData("RandomWeapon",type="float")<=25)

[hiddenAction_Common_ArmGL_L_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_ArmGL_L_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_ArmGL_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and ${onAttacking}==false and memory.armRBreaked==false and eventData("RandomWeapon",type="float")<=25)

[hiddenAction_Common_ArmGL_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_ArmGL_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_BeamSaber_BF_Yellow_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60   and memory.armRBreaked==false)

[hiddenAction_EF_BeamSaber_BF_Yellow_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_BeamSaber_BF_Yellow_Fire_Step_5]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[action_Transform_LandFlyB]
isVisible:if not memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=96 and memory.styleIndex!=100 and not self.hasTags(includes='inHangar'))
autoTrigger:if not memory.manualControlEnabled and (self.isControlledByAI()==true and ${allowAI}==true and memory.cantTransform==false and memory.close==false and not self.hasTags(includes='inHangar') and ${cantAction}==false and self.timeAlive>memory.changeTransform_LandFlyCD and memory.flyUnit!=1 and not self.tags(includes='inBattle'))

[action_ManualControl_Transform_LandFlyB]
@copyFromSection:action_Transform_LandFlyB
pos:0
autoTrigger:false
isVisible:if memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=96 and memory.styleIndex!=100 and not self.hasTags(includes='inHangar'))
requireConditional:if ${manualControlReady} and (true) and not memory.cantTransform and ${cantAction}==false and ${onSkill}==false and self.timeAlive>=memory.changeTransform_LandFlyCD

[action_Transform_LandFlyA]
isVisible:if not memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=0 and not self.hasTags(includes='inHangar'))
autoTrigger:if not memory.manualControlEnabled and (false)

[action_ManualControl_Transform_LandFlyA]
@copyFromSection:action_Transform_LandFlyA
pos:0
autoTrigger:false
isVisible:if memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=0 and not self.hasTags(includes='inHangar'))
requireConditional:if ${manualControlReady} and (true) and not memory.cantTransform and ${cantAction}==false and ${onSkill}==false and self.timeAlive>=memory.changeTransform_LandFlyCD

[action_Common_DetectArea_Trigger]
pos:65

[action_Common_CameraGun_Trigger]
pos:65

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff

[action_Manual_Common_Push_A]
@copyFromSection:template_ManualWeapon
pos:4
text:Punch
text_zh:徒手格斗
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==true))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true))))
alsoTriggerAction:Common_Push_A_Fire
displayType:action

[hiddenAction_Common_Push_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
setUnitMemory:Common_Push_A_CDTimer=self.timeAlive+${Common_Push_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_Push_A_CD}s
addActionCooldownApplyToActions:Manual_Common_Push_A

[action_Manual_AEUG_MSA_005_BeamGun]
@copyFromSection:template_ManualWeapon
pos:2
text:Beam cannon
text_zh:光束枪
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
isVisible:if ${manualControlReady} and ((((not ((memory.armRBreaked==true) and (memory.armLBreaked==true))))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.AEUG_MSA_005_BeamGun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((not ((memory.armRBreaked==true) and (memory.armLBreaked==true)))))) and self.resource.EN>=${AEUG_MSA_005_BeamGun_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.AEUG_MSA_005_BeamGun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((not ((memory.armRBreaked==true) and (memory.armLBreaked==true)))))) and self.resource.EN>=${AEUG_MSA_005_BeamGun_EN}
alsoTriggerAction:AEUG_MSA_005_BeamGun_Fire
displayType:action

[hiddenAction_AEUG_MSA_005_BeamGun_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.AEUG_MSA_005_BeamGun_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.AEUG_MSA_005_BeamGun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((not ((memory.armRBreaked==true) and (memory.armLBreaked==true)))))) and self.resource.EN>=${AEUG_MSA_005_BeamGun_EN})
setUnitMemory:AEUG_MSA_005_BeamGun_CDTimer=self.timeAlive+${AEUG_MSA_005_BeamGun_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${AEUG_MSA_005_BeamGun_CD}s
addActionCooldownApplyToActions:Manual_AEUG_MSA_005_BeamGun

[action_Manual_Common_ArmGL_L]
@copyFromSection:template_ManualWeapon
pos:5
text:Arm grenade launcher
text_zh:腕部榴弹
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady} and ((((true) and (memory.armRBreaked==true) and (memory.armLBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmGL_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==true) and (memory.armLBreaked==false)))) and self.resource.EN>=${Common_ArmGL_L_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmGL_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==true) and (memory.armLBreaked==false)))) and self.resource.EN>=${Common_ArmGL_L_EN}
alsoTriggerAction:Common_ArmGL_L_Fire
displayType:action

[hiddenAction_Common_ArmGL_L_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_ArmGL_L_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmGL_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==true) and (memory.armLBreaked==false)))) and self.resource.EN>=${Common_ArmGL_L_EN})
setUnitMemory:Common_ArmGL_L_CDTimer=self.timeAlive+${Common_ArmGL_L_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_ArmGL_L_CD}s
addActionCooldownApplyToActions:Manual_Common_ArmGL_L

[action_Manual_Common_ArmGL]
@copyFromSection:template_ManualWeapon
pos:6
text:Arm grenade launcher
text_zh:腕部榴弹
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady} and ((((true) and (memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmGL_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==false)))) and self.resource.EN>=${Common_ArmGL_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmGL_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==false)))) and self.resource.EN>=${Common_ArmGL_EN}
alsoTriggerAction:Common_ArmGL_Fire
displayType:action

[hiddenAction_Common_ArmGL_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_ArmGL_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmGL_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==false)))) and self.resource.EN>=${Common_ArmGL_EN})
setUnitMemory:Common_ArmGL_CDTimer=self.timeAlive+${Common_ArmGL_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_ArmGL_CD}s
addActionCooldownApplyToActions:Manual_Common_ArmGL

[action_Manual_EF_BeamSaber_BF_Yellow]
@copyFromSection:template_ManualWeapon
pos:3
text:Beam saber
text_zh:光束军刀
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSaber_BF_Yellow_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSaber_BF_Yellow_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false))))
alsoTriggerAction:EF_BeamSaber_BF_Yellow_Fire
displayType:action

[hiddenAction_EF_BeamSaber_BF_Yellow_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_BeamSaber_BF_Yellow_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSaber_BF_Yellow_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false)))))
setUnitMemory:EF_BeamSaber_BF_Yellow_CDTimer=self.timeAlive+${EF_BeamSaber_BF_Yellow_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${EF_BeamSaber_BF_Yellow_CD}s
addActionCooldownApplyToActions:Manual_EF_BeamSaber_BF_Yellow

[hiddenAction_TryAttack]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_AttackMode_Cqb_WhenHasTarget]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_LowPartsForceCqbMode]
requireConditional:if not memory.manualControlEnabled and (memory.attackMode==0 and memory.armRBreaked==true)

[hiddenAction_ResetTargetTags_Step2]
alsoTriggerAction:ManualControl_AfterTransform,ManualControl_RestoreGuard

[action_ChangeAttackRuleMode_Free]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==0 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Guard]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==1 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Hold]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==2 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Shoot]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==0 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Cqb]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==1 and not self.hasTags(includes='inHangar'))

[action_AllowAIOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAI}==false and not self.hasTags(includes='inHangar'))

[action_AllowAssignedOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAssigned}==false and not self.hasTags(includes='inHangar'))

[action_ManualControl_FirstSlot]
isVisible:false
