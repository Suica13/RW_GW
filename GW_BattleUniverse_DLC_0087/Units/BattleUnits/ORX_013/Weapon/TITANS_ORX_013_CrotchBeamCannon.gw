[core]
copyFrom:ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
dont_load:true
@memory TITANS_ORX_013_CrotchBeamCannon_CDTimer:float
@global TITANS_ORX_013_CrotchBeamCannon_CD=4
@global TITANS_ORX_013_CrotchBeamCannon_EN=50

[turret_TITANS_ORX_013_CrotchBeamCannon]
x:0
y:0
canShoot:false
projectile:TITANS_ORX_013_CrotchBeamCannon_Projectile
delay:0.3s
canAttackMaxAngle:15
barrelX:15
barrelY:5
limitingRange:0
aimOffsetSpread:0
recoilOffset:0
recoilOutTime:0
recoilReturnTime:0
shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_3.ogg
shoot_sound_vol:0.35
shoot_flame:Beam_Fire_1_Pink_S

[turret_TITANS_ORX_013_CrotchBeamCannon_L]
@copyFromSection:turret_TITANS_ORX_013_CrotchBeamCannon
barrelX:-15

[projectile_TITANS_ORX_013_CrotchBeamCannon_Projectile]
directDamage:0
life:0
explodeOnEndOfLife:true
speed:0
lightSize:0.75
lightColor:#ffd53d
explodeEffect:none
spawnUnit:"""
Projectile_BeamRifle_Pink*1(addResources=DpDamage:83.33333333
    |BeamDamage:2666.666667
    |ProjectileSpeed:75
    |ProjectileSpread:2
    |ProjectileLife:15
    |WeaponAccuracy:90
    |PartBreakModifier:1
    |CockpitBreakModifier:1
    |PilotDamageModifier:1
    |PilotTrueDamage:0
    |AntiSizeLargeDamage:1
    |AntiSizeSmallDamage:0.75
    |AntiSizeLargeAccuracy:1
    |AntiSizeSmallAccuracy:0.75
    |AntiBuilding:1.0
    |AntiAqua:0.5
    |AntiAir:1.5
    |AntiLand:1
    |AntiSpace:1.5
    |HeightChangeSpeed:2
    |HeightHitRange:25)
"""

[hiddenAction_TITANS_ORX_013_CrotchBeamCannon_Fire_Step_1]
requireConditional:if ${cantAction}==false
buildSpeed:0.25s
alsoTriggerAction:PlayCommon_Cannon_Shoot_A_Step_1

[hiddenAction_TITANS_ORX_013_CrotchBeamCannon_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (memory.headBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})
buildSpeed:0s
fireTurretXAtGround:TITANS_ORX_013_CrotchBeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:TITANS_ORX_013_CrotchBeamCannon_Fire_Step_Sub

[hiddenAction_TITANS_ORX_013_CrotchBeamCannon_Fire_Step_3]
@copyFromSection:hiddenAction_TITANS_ORX_013_CrotchBeamCannon_Fire_Step_2
buildSpeed:${turret_TITANS_ORX_013_CrotchBeamCannon.delay}

[hiddenAction_TITANS_ORX_013_CrotchBeamCannon_Fire_Step_Sub]
requireConditional:if (${cantAction}==false) and (memory.headBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})
fireTurretXAtGround:TITANS_ORX_013_CrotchBeamCannon_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
buildSpeed:0.0s

[hiddenAction_TITANS_ORX_013_CrotchBeamCannon_Fire_Step_Final]
setUnitMemory:nowSubWeaponIndex=0
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff

[hiddenAction_TITANS_ORX_013_CrotchBeamCannon_Fire]
requireConditional:if (self.timeAlive>memory.TITANS_ORX_013_CrotchBeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>=${TITANS_ORX_013_CrotchBeamCannon_EN} and (memory.headBreaked==false)) and ((not memory.manualControlEnabled and self.attacking.hp>0 and not (directionBetween(self,self.attacking)<self.dir-30 or directionBetween(self,self.attacking)>self.dir+30)) or (${manualWeaponReady}))
setUnitMemory:"""
TITANS_ORX_013_CrotchBeamCannon_CDTimer=self.timeAlive+${TITANS_ORX_013_CrotchBeamCannon_CD},
manualInputBusyUntil=select(memory.manualControlEnabled,
self.timeAlive+0.15,
memory.manualInputBusyUntil)
"""
addResources:EN=-${TITANS_ORX_013_CrotchBeamCannon_EN}
addActionCooldownTime:${TITANS_ORX_013_CrotchBeamCannon_CD}s
addActionCooldownApplyToActions:Manual_TITANS_ORX_013_CrotchBeamCannon
alsoTriggerAction:SetAttackingOn,SendEnemyTryAttack_Shoot,TITANS_ORX_013_CrotchBeamCannon_SetWeaponIndex,TITANS_ORX_013_CrotchBeamCannon_Queue

[hiddenAction_TITANS_ORX_013_CrotchBeamCannon_Queue]
alsoQueueAction:"""
TITANS_ORX_013_CrotchBeamCannon_Fire_Step_1,
TITANS_ORX_013_CrotchBeamCannon_Fire_Step_2,
TITANS_ORX_013_CrotchBeamCannon_Fire_Step_3,
TITANS_ORX_013_CrotchBeamCannon_Fire_Step_3,
TITANS_ORX_013_CrotchBeamCannon_Fire_Step_Final
"""

[hiddenAction_TITANS_ORX_013_CrotchBeamCannon_SetWeaponIndex]
setUnitMemory:nowWeaponIndex=0,nowSubWeaponIndex=1

