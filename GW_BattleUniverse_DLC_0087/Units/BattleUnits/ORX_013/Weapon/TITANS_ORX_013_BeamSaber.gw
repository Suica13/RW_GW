@global TITANS_ORX_013_BeamSaber_CD=3.5
@global TITANS_ORX_013_BeamSaber_EN=0

[decal_TITANS_ORX_013_BeamSaber]
layer:beforeBody
order:5.4
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Cqb\Image\EF_BeamSaber.png
isVisible:if memory.nowWeaponIndex==1
basePositionFromLegEnd:arm11
total_frames:5
frame:1
imageScale:1.0
imageScaleY:1.35
xOffsetRelative:11
yOffsetRelative:34
dirOffset:-16

