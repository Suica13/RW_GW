shoot_sound_vol:0.5

[projectile_TITANS_ORX_013_BeamSaber_DB_Projectile]
directDamage:0
life:0
explodeOnEndOfLife:true
speed:0
lightSize:0.75
lightColor:#ff57e9
explodeEffect:none
spawnUnit:"""
Projectile_Saber_L_B*1(addResources=CqbDamage:4250
    |CqbBeamDamage:4250
    |DpDamage:950
