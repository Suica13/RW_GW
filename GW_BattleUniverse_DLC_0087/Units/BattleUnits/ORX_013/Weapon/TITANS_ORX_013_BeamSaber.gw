[hiddenAction_TITANS_ORX_013_BeamSaber_Trigger]
alsoTriggerAction:TITANS_ORX_013_BeamSaber_Fire

[hiddenAction_TITANS_ORX_013_BeamSaber_Fire]
requireConditional:if (self.timeAlive>memory.TITANS_ORX_013_BeamSaber_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>=${TITANS_ORX_013_BeamSaber_EN} and (memory.armRBreaked==false)) and ((not memory.manualControlEnabled and self.attacking.hp>0 and not (directionBetween(self,self.attacking)<self.dir-30 or directionBetween(self,self.attacking)>self.dir+30)) or (${manualWeaponReady}))
setUnitMemory:"""
TITANS_ORX_013_BeamSaber_CDTimer=self.timeAlive+${TITANS_ORX_013_BeamSaber_CD},
manualInputBusyUntil=select(memory.manualControlEnabled,
self.timeAlive+0.15,
memory.manualInputBusyUntil)
"""
alsoTriggerAction:SetAttackingOn,SendEnemyTryAttack_Cqb,TITANS_ORX_013_BeamSaber_DB_SetWeaponIndex,PlayCommon_Melee_Double_B_Step_1,TITANS_ORX_013_BeamSaber_Step_1
addResources:EN=-${TITANS_ORX_013_BeamSaber_EN}
addActionCooldownTime:${TITANS_ORX_013_BeamSaber_CD}s
addActionCooldownApplyToActions:Manual_TITANS_ORX_013_BeamSaber

[hiddenAction_TITANS_ORX_013_BeamSaber_Step_1]
alsoQueueAction:"""
TITANS_ORX_013_BeamSaber_Fire_Step_1,
TITANS_ORX_013_BeamSaber_Fire_Step_2,
TITANS_ORX_013_BeamSaber_Fire_Step_3,
TITANS_ORX_013_BeamSaber_Fire_Step_4,
TITANS_ORX_013_BeamSaber_Fire_Step_5,
TITANS_ORX_013_BeamSaber_Fire_Step_6,
TITANS_ORX_013_BeamSaber_Fire_Step_7,
TITANS_ORX_013_BeamSaber_Fire_Step_Final
"""

[hiddenAction_TITANS_ORX_013_BeamSaber_DB_SetWeaponIndex]
isVisible:false
setUnitMemory:nowWeaponIndex=1,nowSubWeaponIndex=0

[hiddenAction_TITANS_ORX_013_BeamSaber_DF_SetWeaponIndex]
isVisible:false
setUnitMemory:nowWeaponIndex=1,nowSubWeaponIndex=0

[hiddenAction_TITANS_ORX_013_BeamSaber_Fire_Step_1]
requireConditional:if ${cantAction}==false
buildSpeed:0.6s

[hiddenAction_TITANS_ORX_013_BeamSaber_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (memory.armRBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})
buildSpeed:0s
fireTurretXAtGround:TITANS_ORX_013_BeamSaber
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_2_Pink_R_L

[hiddenAction_TITANS_ORX_013_BeamSaber_Fire_Step_3]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false) and (memory.armRBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})
buildSpeed:0s
fireTurretXAtGround:TITANS_ORX_013_BeamSaber
fireTurretXAtGround_withProjectile:TITANS_ORX_013_BeamSaber_DB_L_Projectile
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_2_Pink_L_L

[hiddenAction_TITANS_ORX_013_BeamSaber_Fire_Step_4]
buildSpeed:0.4s
alsoTriggerAction:PlayCommon_Melee_Double_F_Step_1

[hiddenAction_TITANS_ORX_013_BeamSaber_Fire_Step_5]
buildSpeed:0.3s

[hiddenAction_TITANS_ORX_013_BeamSaber_Fire_Step_6]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (memory.armRBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})
buildSpeed:0s
fireTurretXAtGround:TITANS_ORX_013_BeamSaber
fireTurretXAtGround_withProjectile:TITANS_ORX_013_BeamSaber_DF_Projectile
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_1_Pink_R_L

[hiddenAction_TITANS_ORX_013_BeamSaber_Fire_Step_7]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false) and (memory.armRBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})
buildSpeed:0s
fireTurretXAtGround:TITANS_ORX_013_BeamSaber
fireTurretXAtGround_withProjectile:TITANS_ORX_013_BeamSaber_DF_L_Projectile
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_1_Pink_L_L

[hiddenAction_TITANS_ORX_013_BeamSaber_Fire_Step_Final]
buildSpeed:1.0s
alsoTriggerAction:SetAttackingOff

[hiddenAction_TITANS_ORX_013_BeamSaber_SetWeaponIndex]
setUnitMemory:nowWeaponIndex=1,nowSubWeaponIndex=0

