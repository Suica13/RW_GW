color:#66AAFF
isVisible:if ${manualControlReady} and memory.hideUI==0 and memory.manualShipArcGroup==0 and self.attachment(slot='IrishClass_Turret_BeamCannon_M1').hp>0 and not self.attachment(slot='IrishClass_Turret_BeamCannon_M1').readUnitMemory('breaked',type='bool')
alpha:select(not self.attachment(slot='IrishClass_Turret_BeamCannon_M1').readUnitMemory('IrishClass_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='IrishClass_Turret_BeamCannon_M1').resource.IrishClass_Turret_BeamCannon_ShootTimer>0,0.55,0.15)

