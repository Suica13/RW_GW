[core]
dont_load:true
@memory manualShipTarget:unit
@memory manualShipHQ:unit
@memory manualShipSerial:float
@memory manualShipOrderUntil:float
@memory manualShipRemaining:float
@memory manualShipNextShotAt:float
@memory manualShipReserved:bool
@memory manualShipPermitControlled:bool
@global manualShipAuthorized=(parent.hp>0 and self.hp>0 and not memory.breaked and parent.teamId==self.teamId and parent.hasTags(includes='ManualControlled') and not parent.hasTags(includes='inHangar') and memory.manualShipHQ.hp>0 and memory.manualShipHQ.teamId==self.teamId and memory.manualShipHQ.hasTags(includes='HQ_NotCaptured') and memory.manualShipHQ.readUnitMemory('manualControlledUnit',type='unit')==parent and parent.readUnitMemory('manualControlHQ',type='unit')==memory.manualShipHQ and parent.readUnitMemory('manualVulcanSerial',type='float')==memory.manualShipSerial and not parent.readUnitMemory('battleUnitCore',type='unit').readUnitMemory('cantAction',type='bool') and not parent.readUnitMemory('battleUnitCore',type='unit').readUnitMemory('onSkill',type='bool'))
@global manualShipOrderReady=((parent.hp>0 and self.hp>0 and not memory.breaked and parent.teamId==self.teamId and parent.hasTags(includes='ManualControlled') and not parent.hasTags(includes='inHangar') and memory.manualShipHQ.hp>0 and memory.manualShipHQ.teamId==self.teamId and memory.manualShipHQ.hasTags(includes='HQ_NotCaptured') and memory.manualShipHQ.readUnitMemory('manualControlledUnit',type='unit')==parent and parent.readUnitMemory('manualControlHQ',type='unit')==memory.manualShipHQ and parent.readUnitMemory('manualVulcanSerial',type='float')==memory.manualShipSerial and not parent.readUnitMemory('battleUnitCore',type='unit').readUnitMemory('cantAction',type='bool') and not parent.readUnitMemory('battleUnitCore',type='unit').readUnitMemory('onSkill',type='bool')) and self.timeAlive<memory.manualShipOrderUntil and memory.manualShipRemaining>0 and (self.attacking.hp<=0 or (self.attacking.hp>0 and not self.attacking.hasTags(includes='UnDetected') and distanceBetween(self,self.attacking)<=600)))

[resource_ManualShipShotPermit]
hidden:true

[hiddenAction_ManualShip_Order]
autoTriggerOnEvent:newMessage(withTag='ManualShip_0087_AA')
requireConditional:false
setUnitMemory:manualShipTarget=self.attacking,manualShipHQ=eventData('controller',type='unit'),manualShipSerial=eventData('serial',type='float'),manualShipOrderUntil=self.timeAlive+5,manualShipRemaining=self.resource.TivvayClass_Turret_AA_ShootTimer

# Native resourceUsage is checked at firing, separately from native target/arc selection.
# Prepay one shot atomically; cancelled unused permission returns the same EN cost.
[hiddenAction_ManualShip_ReserveShot]
autoTriggerCheckRate:everyFrame
autoTrigger:if self.hp>0 and parent.hp>0 and not memory.breaked and not parent.hasTags(includes='inHangar') and not memory.manualShipReserved and self.resource.ManualShipShotPermit<=0 and (self.attacking.hp>0 and not self.attacking.hasTags(includes='UnDetected') and distanceBetween(self,self.attacking)<=600) and not memory.TivvayClass_Turret_AA_OnCD and self.resource.TivvayClass_Turret_AA_ShootTimer>0 and (${onAttacking}==false and ${cantAction}==false  and parent.resource().en>0) and (not parent.hasTags(includes='ManualControlled') or (not parent.readUnitMemory('manualAutoAAOff',type='bool') and parent.readUnitMemory('manualControlHQ',type='unit').hp>0 and parent.readUnitMemory('manualControlHQ',type='unit').teamId==parent.teamId and parent.readUnitMemory('manualControlHQ',type='unit').hasTags(includes='HQ_NotCaptured') and parent.readUnitMemory('manualControlHQ',type='unit').readUnitMemory('manualControlledUnit',type='unit')==parent))
takeResources:EN=${TivvayClass_Turret_AA_EN}
takeResources_includeParent:true
takeResources_excludeUnitsWithoutAllResources:true
takeResources_discardCollected:true
takeResources_maxUnits:1
takeResources_triggerActionIfAnyCollected:ManualShip_Permit

[hiddenAction_ManualShip_Permit]
setUnitMemory:manualShipReserved=true,manualShipPermitControlled=parent.hasTags(includes='ManualControlled')
setResourcesWithLogic:ManualShipShotPermit=1

alsoTriggerAction:ManualShip_BlindShot

[hiddenAction_ManualShip_Consumed]
setUnitMemory:manualShipReserved=false,manualShipRemaining=max(0,memory.manualShipRemaining-1),manualShipNextShotAt=self.timeAlive+0.2

[hiddenAction_ManualShip_Refund]
requireConditional:if memory.manualShipReserved and self.resource.ManualShipShotPermit>0
sendMessageTo:parent
sendMessageWithTags:UseEN
sendMessageWithData:useEN=-${TivvayClass_Turret_AA_EN}
setUnitMemory:manualShipReserved=false
setResourcesWithLogic:ManualShipShotPermit=0

[hiddenAction_ManualShip_Hold]
autoTriggerOnEvent:newMessage(withTag='ManualShip_Hold')
requireConditional:if eventData('owner',type='unit')==parent
setUnitMemory:manualShipOrderUntil=0,manualShipRemaining=0
alsoTriggerAction:ManualShip_Refund

[hiddenAction_ManualShip_Cancel]
autoTriggerCheckRate:everyFrame
autoTrigger:if memory.manualShipReserved and (self.hp<=0 or parent.hp<=0 or memory.breaked or parent.hasTags(includes='inHangar') or self.attacking.hp<=0 or self.attacking.hasTags(includes='UnDetected') or distanceBetween(self,self.attacking)>600 or not (not parent.hasTags(includes='ManualControlled') or (not parent.readUnitMemory('manualAutoAAOff',type='bool') and parent.readUnitMemory('manualControlHQ',type='unit').hp>0 and parent.readUnitMemory('manualControlHQ',type='unit').teamId==parent.teamId and parent.readUnitMemory('manualControlHQ',type='unit').hasTags(includes='HQ_NotCaptured') and parent.readUnitMemory('manualControlHQ',type='unit').readUnitMemory('manualControlledUnit',type='unit')==parent)) or memory.manualShipPermitControlled!=parent.hasTags(includes='ManualControlled'))
setUnitMemory:manualShipOrderUntil=0,manualShipRemaining=0
alsoTriggerAction:ManualShip_Refund

[turret_TivvayClass_Turret_AA]
canAttackCondition:if ((${onAttacking}==false and ${cantAction}==false  and (parent.resource().en>0 or memory.manualShipReserved))) and (not parent.hasTags(includes='ManualControlled') or (not parent.readUnitMemory('manualAutoAAOff',type='bool') and parent.readUnitMemory('manualControlHQ',type='unit').hp>0 and parent.readUnitMemory('manualControlHQ',type='unit').teamId==parent.teamId and parent.readUnitMemory('manualControlHQ',type='unit').hasTags(includes='HQ_NotCaptured') and parent.readUnitMemory('manualControlHQ',type='unit').readUnitMemory('manualControlledUnit',type='unit')==parent))
resourceUsage:TivvayClass_Turret_AA_ShootTimer=1,ManualShipShotPermit=1
onShoot_triggerActions:ManualShip_Consumed

[hiddenAction_TivvayClass_Turret_AA_CDStart]
autoTrigger:if (memory.TivvayClass_Turret_AA_OnCD==false and (    (        self.resource.TivvayClass_Turret_AA_ShootTimer<=0     )     or     (        self.resource.TivvayClass_Turret_AA_ShootTimer<${TivvayClass_Turret_AA_Shoot} and not self.hasTags(includes='inBattle')    ))) and (not parent.hasTags(includes='ManualControlled') or memory.manualShipRemaining<=0 or self.timeAlive>=memory.manualShipOrderUntil)

# No target: force the original muzzle to fire, preserving the engine's actual turret angle.
# Forced shots bypass resourceUsage and native shot-delay timers, so account for both explicitly.
[hiddenAction_ManualShip_BlindShot]
autoTriggerCheckRate:everyFrame
autoTrigger:false
requireConditional:false
addResources:TivvayClass_Turret_AA_ShootTimer=-1,ManualShipShotPermit=-1
fireTurretXAtGround:TivvayClass_Turret_AA
fireTurretXAtGround_withTarget:self
fireTurretXAtGround_withProjectile:ManualShip_Blind_TivvayClass_Turret_AA_Projectile

# Native firing seeds az from the turret barrel. Prevent the zero-life emitter from turning
# toward the dummy ground coordinate before it spawns the unchanged Battle Universe projectile unit.
[projectile_ManualShip_Blind_TivvayClass_Turret_AA_Projectile]
@copyFromSection:projectile_TivvayClass_Turret_AA_Projectile
turnSpeed:0
turnSpeedWhenNear:0
