[core]
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_Common_Push_A_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60   and memory.armRBreaked==true)

[hiddenAction_Common_Push_A_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_ArmMG_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>90  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and ${onAttacking}==false and memory.armRBreaked==false and eventData("RandomWeapon",type="float")<=50)

[hiddenAction_Common_ArmMG_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_ArmMG_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_ArmMG_L_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>90  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and ${onAttacking}==false and memory.armRBreaked==true and memory.armLBreaked==false and eventData("RandomWeapon",type="float")<=50)

[hiddenAction_Common_ArmMG_L_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_ArmMG_L_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MS_15B_ShieldRocket_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>90  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and self.shield>0  and eventData("RandomWeapon",type="float")>50)

[hiddenAction_ZN_MS_15B_ShieldRocket_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MS_15B_ShieldRocket_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MS_15B_ShieldRocket_Fire_Step_4]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MS_15B_BeamLance_BF_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=90   and memory.armRBreaked==false and eventData("RandomWeapon",type="float")>50)

[hiddenAction_ZN_MS_15B_BeamLance_BF_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MS_15B_BeamLance_BF_Fire_Step_5]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff

[action_Manual_Common_Push_A]
@copyFromSection:template_ManualWeapon
pos:3
text:Punch
text_zh:徒手格斗
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==true))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true))))
alsoTriggerAction:Common_Push_A_Fire
displayType:action

[hiddenAction_Common_Push_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
setUnitMemory:Common_Push_A_CDTimer=self.timeAlive+${Common_Push_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_Push_A_CD}s
addActionCooldownApplyToActions:Manual_Common_Push_A

[action_Manual_Common_ArmMG]
@copyFromSection:template_ManualWeapon
pos:2
text:Machine gun
text_zh:机枪
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/MachineGun_1.png
isVisible:if ${manualControlReady} and ((((true) and (memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmMG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==false)))) and self.resource.EN>=${Common_ArmMG_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmMG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==false)))) and self.resource.EN>=${Common_ArmMG_EN}
alsoTriggerAction:Common_ArmMG_Fire
displayType:action

[hiddenAction_Common_ArmMG_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_ArmMG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmMG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==false)))) and self.resource.EN>=${Common_ArmMG_EN})
setUnitMemory:Common_ArmMG_CDTimer=self.timeAlive+${Common_ArmMG_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_ArmMG_CD}s
addActionCooldownApplyToActions:Manual_Common_ArmMG

[action_Manual_Common_ArmMG_L]
@copyFromSection:template_ManualWeapon
pos:4
text:Machine gun (left)
text_zh:机枪（左）
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/MachineGun_1.png
isVisible:if ${manualControlReady} and ((((true) and (memory.armRBreaked==true) and (memory.armLBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmMG_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==true) and (memory.armLBreaked==false)))) and self.resource.EN>=${Common_ArmMG_L_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmMG_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==true) and (memory.armLBreaked==false)))) and self.resource.EN>=${Common_ArmMG_L_EN}
alsoTriggerAction:Common_ArmMG_L_Fire
displayType:action

[hiddenAction_Common_ArmMG_L_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_ArmMG_L_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmMG_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((${onAttacking}==false) and (memory.armRBreaked==true) and (memory.armLBreaked==false)))) and self.resource.EN>=${Common_ArmMG_L_EN})
setUnitMemory:Common_ArmMG_L_CDTimer=self.timeAlive+${Common_ArmMG_L_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_ArmMG_L_CD}s
addActionCooldownApplyToActions:Manual_Common_ArmMG_L

[action_Manual_ZN_MS_15B_ShieldRocket]
@copyFromSection:template_ManualWeapon
pos:5
text:Bazooka
text_zh:火箭筒
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Bazooka_1.png
isVisible:if ${manualControlReady} and ((((self.shield>0))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MS_15B_ShieldRocket_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.shield>0)))) and self.resource.EN>=${ZN_MS_15B_ShieldRocket_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_MS_15B_ShieldRocket_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.shield>0)))) and self.resource.EN>=${ZN_MS_15B_ShieldRocket_EN}
alsoTriggerAction:ZN_MS_15B_ShieldRocket_Fire
displayType:action

[hiddenAction_ZN_MS_15B_ShieldRocket_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_MS_15B_ShieldRocket_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MS_15B_ShieldRocket_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.shield>0)))) and self.resource.EN>=${ZN_MS_15B_ShieldRocket_EN})
setUnitMemory:ZN_MS_15B_ShieldRocket_CDTimer=self.timeAlive+${ZN_MS_15B_ShieldRocket_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
