isVisible:if ${manualControlReady} and ((true))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.TITANS_MRX_009_ArmBR_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${TITANS_MRX_009_ArmBR_L_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.TITANS_MRX_009_ArmBR_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${TITANS_MRX_009_ArmBR_L_EN}
alsoTriggerAction:TITANS_MRX_009_ArmBR_L_Fire
