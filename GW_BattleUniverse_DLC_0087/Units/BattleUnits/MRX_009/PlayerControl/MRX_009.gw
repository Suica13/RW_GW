requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.TITANS_MRX_009_ChestBeam_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${TITANS_MRX_009_ChestBeam_EN}
