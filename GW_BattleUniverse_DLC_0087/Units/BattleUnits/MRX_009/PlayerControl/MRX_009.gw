[action_Manual_TITANS_MRX_009_Shock_A]
@copyFromSection:template_ManualWeapon
pos:3
text:Melee
text_zh:格斗攻击
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((true))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.TITANS_MRX_009_Shock_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((true)))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.TITANS_MRX_009_Shock_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((true))
alsoTriggerAction:TITANS_MRX_009_Shock_A_Fire
displayType:action

[hiddenAction_TITANS_MRX_009_Shock_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.TITANS_MRX_009_Shock_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-60 or directionBetween(self, self.attacking) > self.dir+60) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.TITANS_MRX_009_Shock_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((true)))
setUnitMemory:TITANS_MRX_009_Shock_A_CDTimer=self.timeAlive+${TITANS_MRX_009_Shock_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
