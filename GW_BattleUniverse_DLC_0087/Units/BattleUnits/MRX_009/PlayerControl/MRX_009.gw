[core]
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_Common_Push_A_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_ArmBR_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>90 and eventData("RandomWeapon",type="float")>50 and eventData("RandomWeapon",type="float")<=75)

[hiddenAction_TITANS_MRX_009_ArmBR_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_ArmBR_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_ArmBR_Fire_Step_4]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_ArmBR_Fire_Step_5]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_ArmBR_L_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>90 and eventData("RandomWeapon",type="float")>75)

[hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_4]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_ArmBR_L_Fire_Step_5]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_ChestBeam_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>90 and eventData("RandomWeapon",type="float")<=50 and eventData("RandomWeapon",type="float")>25)

[hiddenAction_TITANS_MRX_009_ChestBeam_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_BeamCannon_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>90 and eventData("RandomWeapon",type="float")<=25)

[hiddenAction_TITANS_MRX_009_BeamCannon_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_BeamCannon_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_MegaBeamCannon_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false and ${onSkill}==false and self.timeAlive>memory.TITANS_MRX_009_MegaBeamCannon_CDTimer and not self.hasTags(includes='inHangar') and not parent.hasTags(includes='SFS_Slot') and self.resource.en>${TITANS_MRX_009_MegaBeamCannon_EN} and memory.TITANS_MRX_009_MegaBeamCannon_AimTarget.hp>0)

[hiddenAction_TITANS_MRX_009_MegaBeamCannon_Fire_Step_1]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_MegaBeamCannon_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_TITANS_MRX_009_Shock_A_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=90)

[hiddenAction_TITANS_MRX_009_Shock_A_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[action_Transform_LandFlyB]
isVisible:if not memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=96 and memory.styleIndex!=100 and not self.hasTags(includes='inHangar'))
autoTrigger:if not memory.manualControlEnabled and (false)

[action_ManualControl_Transform_LandFlyB]
@copyFromSection:action_Transform_LandFlyB
pos:0
autoTrigger:false
isVisible:if memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=96 and memory.styleIndex!=100 and not self.hasTags(includes='inHangar'))
requireConditional:if ${manualControlReady} and (true) and not memory.cantTransform and ${cantAction}==false and ${onSkill}==false and self.timeAlive>=memory.changeTransform_LandFlyCD

[action_Transform_LandFlyA]
isVisible:if not memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=0 and not self.hasTags(includes='inHangar'))
autoTrigger:if not memory.manualControlEnabled and (false)

[action_ManualControl_Transform_LandFlyA]
@copyFromSection:action_Transform_LandFlyA
pos:0
autoTrigger:false
isVisible:if memory.manualControlEnabled and (memory.close==false and memory.styleIndex!=0 and not self.hasTags(includes='inHangar'))
requireConditional:if ${manualControlReady} and (true) and not memory.cantTransform and ${cantAction}==false and ${onSkill}==false and self.timeAlive>=memory.changeTransform_LandFlyCD

[action_TITANS_MRX_009_MegaBeamCannon_Trigger]
pos:30
requireConditional:if (true) and (not memory.manualControlEnabled or ${manualWeaponReady})

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff

[action_Manual_TITANS_MRX_009_ArmBR]
@copyFromSection:template_ManualWeapon
pos:2
text:Arm beam gun
text_zh:手臂光束枪
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady} and ((true))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.TITANS_MRX_009_ArmBR_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${TITANS_MRX_009_ArmBR_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.TITANS_MRX_009_ArmBR_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${TITANS_MRX_009_ArmBR_EN}
alsoTriggerAction:TITANS_MRX_009_ArmBR_Fire
displayType:action

[hiddenAction_TITANS_MRX_009_ArmBR_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.TITANS_MRX_009_ArmBR_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.TITANS_MRX_009_ArmBR_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${TITANS_MRX_009_ArmBR_EN})
setUnitMemory:TITANS_MRX_009_ArmBR_CDTimer=self.timeAlive+${TITANS_MRX_009_ArmBR_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${TITANS_MRX_009_ArmBR_CD}s
addActionCooldownApplyToActions:Manual_TITANS_MRX_009_ArmBR

[action_Manual_TITANS_MRX_009_ArmBR_L]
@copyFromSection:template_ManualWeapon
pos:4
