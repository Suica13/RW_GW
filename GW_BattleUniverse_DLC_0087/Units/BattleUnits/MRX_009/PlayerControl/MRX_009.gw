[hiddenAction_TITANS_MRX_009_ArmBR_L_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.TITANS_MRX_009_ArmBR_L_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.TITANS_MRX_009_ArmBR_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${TITANS_MRX_009_ArmBR_L_EN})
setUnitMemory:TITANS_MRX_009_ArmBR_L_CDTimer=self.timeAlive+${TITANS_MRX_009_ArmBR_L_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
