[hiddenAction_SetOnSkillOn_NahelArgamaClass_HighMegaCannon]
@copyFromSection:hiddenAction_SetOnSkillOn
sendMessageWithData:"""
skillMoveSpeedBuff=1,
skillTurnSpeedBuff=1,
skillShootDefBuff=500.0,
skillSuperArmor=1.0
"""






[hiddenAction_NahelArgamaClass_HighMegaCannon_SetWeaponIndex]
isVisible:false


[hiddenAction_NahelArgamaClass_HighMegaCannon_Fire_Step_1_AI]
requireConditional:if ${cantAction}==false and memory.close==false and (not memory.manualControlEnabled or ${manualControlReady})
buildSpeed:2.0s
spawnEffects:NahelArgamaClass_HighMegaCannon_Flash
whenBuilding_cannotMove:true
playSoundAtUnit:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCannon_6.ogg:3.0
[hiddenAction_NahelArgamaClass_HighMegaCannon_Fire_Step_1]
requireConditional:if ${cantAction}==false and memory.close==false and (not memory.manualControlEnabled or ${manualControlReady})
buildSpeed:2.0s

fireTurretXAtGround:NahelArgamaClass_HighMegaCannon
fireTurretXAtGround_count:0
fireTurretXAtGround_withTarget:memory.NahelArgamaClass_HighMegaCannon_AimTarget

whenBuilding_cannotMove:true
whenBuilding_rotateTo_aimAtActionTarget:true
whenBuilding_rotateTo_waitTillRotated:true
playSoundAtUnit:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCannon_6.ogg:3.0
[hiddenAction_NahelArgamaClass_HighMegaCannon_Fire_Step_2]
requireConditional:if ${cantAction}==false and memory.close==false and (not memory.manualControlEnabled or ${manualControlReady})
buildSpeed:0.1s
whenBuilding_cannotMove:true
fireTurretXAtGround:NahelArgamaClass_HighMegaCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

setResourcesWithLogic:en=self.resource.en-15

[hiddenAction_NahelArgamaClass_HighMegaCannon_Fire_Step_Final]
buildSpeed:3.0s
whenBuilding_cannotMove:true
alsoTriggerAction:"""
SetAttackingOff,
SetOnSkillOff,
SetAttackingCantAimOff,
SetAttackingCantTurnOff
"""


[hiddenAction_NahelArgamaClass_HighMegaCannon_ChargeEffect_StopPlay]
sendMessageTo:memory.NahelArgamaClass_HighMegaCannon_ChargeEffect_1
sendMessageWithTags:StopPlay

[effect_NahelArgamaClass_HighMegaCannon_Flash]
@copyFromSection:effect_Flash_1_L
xOffsetRelative:0
yOffsetRelative:80
drawUnderUnits:true
