requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.TITANS_RX_121_BodyMS_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.backpackBreaked==false)))) and self.resource.EN>=${TITANS_RX_121_BodyMS_EN}
