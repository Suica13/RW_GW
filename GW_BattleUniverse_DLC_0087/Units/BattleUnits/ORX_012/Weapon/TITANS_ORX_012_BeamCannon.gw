[core]
@memory TITANS_ORX_012_BeamCannon_BulletEffect_1:unit
copyFrom:ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
dont_load:true
@memory TITANS_ORX_012_BeamCannon_CDTimer:float
@global TITANS_ORX_012_BeamCannon_CD=4.5
@global TITANS_ORX_012_BeamCannon_EN=120

[turret_TITANS_ORX_012_BeamCannon]
x:0
y:0
canShoot:false
projectile:TITANS_ORX_012_BeamCannon_Projectile
delay:0.3s
canAttackMaxAngle:15
barrelX:11
barrelY:-8
limitingRange:0
aimOffsetSpread:0
recoilOffset:0
recoilOutTime:0
recoilReturnTime:0
shoot_sound:none
shoot_sound_vol:0
shoot_flame:none

[projectile_TITANS_ORX_012_BeamCannon_Projectile]
directDamage:0
life:0
explodeOnEndOfLife:true
speed:0
lightSize:0.75
lightColor:#ffd53d
explodeEffect:none
spawnUnit:"""
Projectile_AP_HighMegaCannon_Pink_Alpha0*1(addResources=DpDamage:75
    |BeamDamage:1250
    |ProjectileSpeed:200
    |ProjectileSpread:0
    |projectileExplosionRange:30
    |ProjectileAttackTimes:3
    |ProjectileLife:3
    |WeaponAccuracy:75
    |PartBreakModifier:1.25
    |CockpitBreakModifier:0.75
    |PilotDamageModifier:1
    |PilotTrueDamage:0
    |AntiSizeLargeDamage:1.25
    |AntiSizeSmallDamage:0.75
    |AntiSizeLargeAccuracy:1.25
    |AntiSizeSmallAccuracy:0.75
    |AntiBuilding:1.5
    |AntiAqua:0.75
    |AntiAir:0.75
    |AntiLand:1
    |AntiSpace:1
    |HeightChangeSpeed:2
    |HeightHitRange:25
    |BeamAPDamage:416.6666667)
"""

[attachment_TITANS_ORX_012_BeamCannon_BulletEffect_1]
x:11
y:-8
isVisible:true
keepAliveWhenParentDies:false
canBeAttackedAndDamaged:false
isUnselectable:true
canAttack:false
showAllActionsFrom:true
onConvertKeepExistingUnitInSameSlot:true
idleDir:0
resetRotationWhenNotAttacking:true

[hiddenAction_TITANS_ORX_012_BeamCannon_BulletEffect_1_AwakeSet]
autoTriggerOnEvent:newMessage(withTag="UnitTurretSpawn")
alsoTriggerAction:TITANS_ORX_012_BeamCannon_BulletEffect_1_StartSet
attachments_addNewUnits:HighBeamRifle_1_Fast_EffectUnit
attachments_onlyOnSlots:TITANS_ORX_012_BeamCannon_BulletEffect_1

[hiddenAction_TITANS_ORX_012_BeamCannon_BulletEffect_1_StartSet]
setUnitMemory:TITANS_ORX_012_BeamCannon_BulletEffect_1=self.attachment(slot='TITANS_ORX_012_BeamCannon_BulletEffect_1')
alsoTriggerAction:TITANS_ORX_012_BeamCannon_BulletEffect_1_SetColor,TITANS_ORX_012_BeamCannon_BulletEffect_1_SetSpeed

[hiddenAction_TITANS_ORX_012_BeamCannon_BulletEffect_1_SetColor]
sendMessageTo:memory.TITANS_ORX_012_BeamCannon_BulletEffect_1
sendMessageWithTags:SetColor_Pink

[hiddenAction_TITANS_ORX_012_BeamCannon_BulletEffect_1_SetSpeed]
sendMessageTo:memory.TITANS_ORX_012_BeamCannon_BulletEffect_1
sendMessageWithTags:SetSpeed
sendMessageWithData:Speed=5

[hiddenAction_TITANS_ORX_012_BeamCannon_Fire_Step_BulletEffect_1]
requireConditional:if ${cantAction}==false
buildSpeed:0s
sendMessageTo:memory.TITANS_ORX_012_BeamCannon_BulletEffect_1
sendMessageWithTags:PlayOneTime

[hiddenAction_TITANS_ORX_012_BeamCannon_BulletEffect_1_StopPlay]
buildSpeed:0s
sendMessageTo:memory.TITANS_ORX_012_BeamCannon_BulletEffect_1
sendMessageWithTags:StopPlay

[hiddenAction_TITANS_ORX_012_BeamCannon_Fire_Step_1]
requireConditional:if ${cantAction}==false
buildSpeed:0.15s
alsoTriggerAction:PlayCommon_Cannon_Shoot_A_Step_1

[hiddenAction_TITANS_ORX_012_BeamCannon_Fire_Step_2]
requireConditional:if ${cantAction}==false
buildSpeed:0.15s
playSoundAtUnit:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamCannon_1.ogg:1.5

[hiddenAction_TITANS_ORX_012_BeamCannon_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (memory.headBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})
buildSpeed:0.1s
fireTurretXAtGround:TITANS_ORX_012_BeamCannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_TITANS_ORX_012_BeamCannon_Fire_Step_Final]
buildSpeed:0.75s
finishPlayingLastAnimation:true
alsoTriggerAction:SetAttackingOff
setUnitMemory:nowSubWeaponIndex=0

[hiddenAction_TITANS_ORX_012_BeamCannon_Fire]
requireConditional:if (self.timeAlive>memory.TITANS_ORX_012_BeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>=${TITANS_ORX_012_BeamCannon_EN} and (memory.headBreaked==false)) and ((not memory.manualControlEnabled and self.attacking.hp>0 and not (directionBetween(self,self.attacking)<self.dir-30 or directionBetween(self,self.attacking)>self.dir+30)) or (${manualWeaponReady}))
setUnitMemory:"""
TITANS_ORX_012_BeamCannon_CDTimer=self.timeAlive+${TITANS_ORX_012_BeamCannon_CD},
manualInputBusyUntil=select(memory.manualControlEnabled,
self.timeAlive+0.15,
memory.manualInputBusyUntil)
"""
addResources:EN=-${TITANS_ORX_012_BeamCannon_EN}
addActionCooldownTime:${TITANS_ORX_012_BeamCannon_CD}s
addActionCooldownApplyToActions:Manual_TITANS_ORX_012_BeamCannon
alsoTriggerAction:SetAttackingOn,SendEnemyTryAttack_Shoot,TITANS_ORX_012_BeamCannon_SetWeaponIndex,TITANS_ORX_012_BeamCannon_Queue

[hiddenAction_TITANS_ORX_012_BeamCannon_Queue]
alsoQueueAction:"""
TITANS_ORX_012_BeamCannon_Fire_Step_1,
TITANS_ORX_012_BeamCannon_Fire_Step_2,
TITANS_ORX_012_BeamCannon_Fire_Step_BulletEffect_1,
TITANS_ORX_012_BeamCannon_Fire_Step_3,
TITANS_ORX_012_BeamCannon_Fire_Step_3,
TITANS_ORX_012_BeamCannon_Fire_Step_3,
TITANS_ORX_012_BeamCannon_Fire_Step_3,
TITANS_ORX_012_BeamCannon_Fire_Step_3,
TITANS_ORX_012_BeamCannon_Fire_Step_3,
TITANS_ORX_012_BeamCannon_Fire_Step_3,
TITANS_ORX_012_BeamCannon_Fire_Step_3,
TITANS_ORX_012_BeamCannon_Fire_Step_3,
TITANS_ORX_012_BeamCannon_Fire_Step_3,
TITANS_ORX_012_BeamCannon_Fire_Step_3,
TITANS_ORX_012_BeamCannon_Fire_Step_3,
TITANS_ORX_012_BeamCannon_BulletEffect_1_StopPlay,
TITANS_ORX_012_BeamCannon_Fire_Step_Final
"""

[hiddenAction_TITANS_ORX_012_BeamCannon_SetWeaponIndex]
setUnitMemory:nowWeaponIndex=0,nowSubWeaponIndex=1

