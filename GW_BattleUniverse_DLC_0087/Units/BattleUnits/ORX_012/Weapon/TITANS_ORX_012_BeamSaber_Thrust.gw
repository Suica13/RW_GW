[core]
dont_load:true
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Cqb/Common/Cqb_Fire_1_Pink_L.gw,
ROOT:Resource/Image/Fx/Common/Common_Flash_1.gw,
ROOT:Units/BattleUnits/ORX_012/Weapon/Common_Melee_I.gw
"""
@memory TITANS_ORX_012_BeamSaber_Thrust_CDTimer:float
@global TITANS_ORX_012_BeamSaber_Thrust_CD=3.5
@global TITANS_ORX_012_BeamSaber_Thrust_EN=0

[decal_TITANS_ORX_012_BeamSaber_Thrust]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Cqb\Image\EF_BeamSaber.png
isVisible:if memory.nowWeaponIndex==3
basePositionFromLegEnd:arm11
total_frames:5
frame:1
imageScale:1.0
imageScaleY:1.35
xOffsetRelative:9
yOffsetRelative:30
dirOffset:-16

[turret_TITANS_ORX_012_BeamSaber_Thrust]
x:0
y:0
invisible:true
canShoot:false
showRangeUIGuide:false
projectile:TITANS_ORX_012_BeamSaber_Thrust_Projectile
delay:3s
limitingMinRange:0
limitingRange:0
canAttackMaxAngle:60
barrelX:0
barrelY:0
aimOffsetSpread:0
recoilOffset:0
recoilOutTime:0
recoilReturnTime:0
shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamSaber_1.ogg
shoot_sound_vol:0.5

[projectile_TITANS_ORX_012_BeamSaber_Thrust_Projectile]
directDamage:0
life:0
explodeOnEndOfLife:true
speed:0
lightSize:0.75
lightColor:#ff57e9
explodeEffect:none
spawnUnit:"""
Projectile_Saber_L_A_L*1(addResources=DpDamage:950
    |CqbDamage:4250
    |CqbBeamDamage:4250
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileLife:0.25
    |ProjectileAttackTimes:3
    |WeaponAccuracy:125
    |PartBreakModifier:1.25
    |CockpitBreakModifier:0.75
    |PilotDamageModifier:1
    |PilotTrueDamage:0
    |AntiSizeLargeDamage:1.25
    |AntiSizeSmallDamage:0.75
    |AntiSizeLargeAccuracy:1.25
    |AntiSizeSmallAccuracy:0.75
    |AntiBuilding:1
    |AntiAqua:0.75
    |AntiAir:0.75
    |AntiLand:1
    |AntiSpace:1
    |HeightChangeSpeed:2
    |HeightHitRange:25)
"""

[hiddenAction_TITANS_ORX_012_BeamSaber_Thrust_SetWeaponIndex]
isVisible:false
setUnitMemory:nowWeaponIndex=3,nowSubWeaponIndex=0

[hiddenAction_TITANS_ORX_012_BeamSaber_Thrust_Fire_Step_1]
requireConditional:if ${cantAction}==false
buildSpeed:0.5s

[hiddenAction_TITANS_ORX_012_BeamSaber_Thrust_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (memory.armRBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})
buildSpeed:0.0s
fireTurretXAtGround:TITANS_ORX_012_BeamSaber_Thrust
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_1_Pink_L_L
alsoTriggerAction:PlayCommon_Melee_I_B_Step_1

[hiddenAction_TITANS_ORX_012_BeamSaber_Thrust_Fire_Step_Final]
buildSpeed:1.0s
alsoTriggerAction:SetAttackingOff,SetAttackingCantTurnOff

[hiddenAction_TITANS_ORX_012_BeamSaber_Thrust_Fire_Step_Rotation_A]
buildSpeed:0.0s
setBodyRotation:self.dir-40

[hiddenAction_TITANS_ORX_012_BeamSaber_Thrust_Fire_Step_Rotation_B]
buildSpeed:0.02s
setBodyRotation:self.dir+10

[hiddenAction_TITANS_ORX_012_BeamSaber_Thrust_Fire_Step_Rotation_C]
buildSpeed:0.02s
setBodyRotation:self.dir+10

[hiddenAction_TITANS_ORX_012_BeamSaber_Thrust_Fire]
requireConditional:if (self.timeAlive>memory.TITANS_ORX_012_BeamSaber_Thrust_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>=${TITANS_ORX_012_BeamSaber_Thrust_EN} and (memory.armRBreaked==false)) and ((not memory.manualControlEnabled and self.attacking.hp>0 and not (directionBetween(self,self.attacking)<self.dir-30 or directionBetween(self,self.attacking)>self.dir+30)) or (${manualWeaponReady}))
setUnitMemory:"""
TITANS_ORX_012_BeamSaber_Thrust_CDTimer=self.timeAlive+${TITANS_ORX_012_BeamSaber_Thrust_CD},
manualInputBusyUntil=select(memory.manualControlEnabled,
self.timeAlive+0.15,
memory.manualInputBusyUntil)
"""
addResources:EN=-${TITANS_ORX_012_BeamSaber_Thrust_EN}
addActionCooldownTime:${TITANS_ORX_012_BeamSaber_Thrust_CD}s
addActionCooldownApplyToActions:Manual_TITANS_ORX_012_BeamSaber_Thrust
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Cqb,
TITANS_ORX_012_BeamSaber_Thrust_SetWeaponIndex,
PlayCommon_Melee_I_A_Step_1,
TITANS_ORX_012_BeamSaber_Thrust_Queue
"""

[hiddenAction_TITANS_ORX_012_BeamSaber_Thrust_Queue]
alsoQueueAction:"""
SetAttackingCantTurnOn,
TITANS_ORX_012_BeamSaber_Thrust_Fire_Step_Rotation_A,
TITANS_ORX_012_BeamSaber_Thrust_Fire_Step_1,
TITANS_ORX_012_BeamSaber_Thrust_Fire_Step_Rotation_B,
TITANS_ORX_012_BeamSaber_Thrust_Fire_Step_Rotation_B,
TITANS_ORX_012_BeamSaber_Thrust_Fire_Step_2,
TITANS_ORX_012_BeamSaber_Thrust_Fire_Step_Rotation_C,
TITANS_ORX_012_BeamSaber_Thrust_Fire_Step_Rotation_C,
TITANS_ORX_012_BeamSaber_Thrust_Fire_Step_Rotation_C,
TITANS_ORX_012_BeamSaber_Thrust_Fire_Step_Rotation_C,
TITANS_ORX_012_BeamSaber_Thrust_Fire_Step_Rotation_C,
TITANS_ORX_012_BeamSaber_Thrust_Fire_Step_Rotation_C,
TITANS_ORX_012_BeamSaber_Thrust_Fire_Step_Final
"""

