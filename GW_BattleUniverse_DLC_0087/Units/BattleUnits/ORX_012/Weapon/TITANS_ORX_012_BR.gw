[core]
copyFrom:ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
dont_load:true
@memory TITANS_ORX_012_BR_CDTimer:float
@global TITANS_ORX_012_BR_CD=2
@global TITANS_ORX_012_BR_EN=50

[decal_TITANS_ORX_012_BR]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/ORX_012/Image/TITANS_ORX_012_BR.png
isVisible:if memory.nowWeaponIndex==0
basePositionFromLegEnd:arm4
imageScale:0.9
xOffsetRelative:4
yOffsetRelative:27
dirOffset:0

[turret_TITANS_ORX_012_BR]
x:0
y:0
canShoot:false
projectile:TITANS_ORX_012_BR_Projectile
delay:0.2s
canAttackMaxAngle:15
barrelX:13
barrelY:40
limitingRange:0
aimOffsetSpread:0
recoilOffset:0
recoilOutTime:0
recoilReturnTime:0
shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_3.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Pink

[projectile_TITANS_ORX_012_BR_Projectile]
directDamage:0
life:0
explodeOnEndOfLife:true
speed:0
lightSize:0.75
lightColor:#ff57e9
explodeEffect:none
spawnUnit:"""
Projectile_BeamRifle_Pink*1(addResources=DpDamage:375
    |BeamDamage:9000
    |ProjectileSpeed:80
    |ProjectileSpread:1
    |ProjectileLife:20
    |WeaponAccuracy:90
    |PartBreakModifier:1
    |CockpitBreakModifier:1
    |PilotDamageModifier:1
    |PilotTrueDamage:0
    |AntiSizeLargeDamage:1
    |AntiSizeSmallDamage:0.75
    |AntiSizeLargeAccuracy:1
    |AntiSizeSmallAccuracy:0.75
    |AntiBuilding:1
    |AntiAqua:0.75
    |AntiAir:0.75
    |AntiLand:1
    |AntiSpace:1
    |HeightChangeSpeed:2
    |HeightHitRange:25)
"""

[hiddenAction_TITANS_ORX_012_BR_Fire_Step_1]
requireConditional:if ${cantAction}==false
buildSpeed:0.15s

[hiddenAction_TITANS_ORX_012_BR_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (memory.armRBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})
buildSpeed:0s
fireTurretXAtGround:TITANS_ORX_012_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_TITANS_ORX_012_BR_Fire_Step_Final]
buildSpeed:0.15s
alsoTriggerAction:SetAttackingOff

[hiddenAction_TITANS_ORX_012_BR_Fire]
requireConditional:if (self.timeAlive>memory.TITANS_ORX_012_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and self.resource.EN>=${TITANS_ORX_012_BR_EN} and (memory.armRBreaked==false)) and ((not memory.manualControlEnabled and self.attacking.hp>0 and not (directionBetween(self,self.attacking)<self.dir-30 or directionBetween(self,self.attacking)>self.dir+30)) or (${manualWeaponReady}))
setUnitMemory:"""
TITANS_ORX_012_BR_CDTimer=self.timeAlive+${TITANS_ORX_012_BR_CD},
manualInputBusyUntil=select(memory.manualControlEnabled,
self.timeAlive+0.15,
memory.manualInputBusyUntil)
"""
addResources:EN=-${TITANS_ORX_012_BR_EN}
addActionCooldownTime:${TITANS_ORX_012_BR_CD}s
addActionCooldownApplyToActions:Manual_TITANS_ORX_012_BR
alsoTriggerAction:SetAttackingOn,SendEnemyTryAttack_Shoot,TITANS_ORX_012_BR_SetWeaponIndex,PlayCommon_Shoot_A_Step_1,TITANS_ORX_012_BR_Queue

[hiddenAction_TITANS_ORX_012_BR_Queue]
alsoQueueAction:TITANS_ORX_012_BR_Fire_Step_1,TITANS_ORX_012_BR_Fire_Step_2,TITANS_ORX_012_BR_Fire_Step_Final

[hiddenAction_TITANS_ORX_012_BR_SetWeaponIndex]
setUnitMemory:nowWeaponIndex=0,nowSubWeaponIndex=0

