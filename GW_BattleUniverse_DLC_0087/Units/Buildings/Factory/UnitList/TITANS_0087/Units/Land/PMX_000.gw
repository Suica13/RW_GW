[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory PMX_000:bool


[hiddenAction_Pannel_Close_PMX_000]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:PMX_000=false




[hiddenAction_AutoProduce_PMX_000]
@copyFromSection:template_AutoProduce
@define UnitID=PMX_000
alsoTriggerAction:AutoProduce_PMX_000_Step2

[hiddenAction_AutoProduce_PMX_000_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=6500
@define Resource=7500
alsoTriggerAction:AutoProduce_PMX_000_Random



[hiddenAction_AutoProduce_PMX_000_Random]
alsoTriggerAction:"""
AutoProduce_PMX_000_Random_A
"""
[hiddenAction_AutoProduce_PMX_000_Random_A]
requireConditional:"""
if true
"""
alsoQueueAction:Produce_PMX_000_StandardSquad




[action_Produce_PMX_000_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=PMX_000
@define Money=6500
@define Resource=7500
@define FactionVisible= (memory.Pannel_TITANS_0087_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:60s

alsoQueueAction:"""
Produce_PMX_000_StandardSquad_1
"""
[hiddenAction_Produce_PMX_000_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
PMX_000*1(addResources=PilotType:1101|EquipmentIndex:0)
"""

