[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RX_178:bool


[hiddenAction_Pannel_Close_RX_178]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RX_178=false




[hiddenAction_AutoProduce_RX_178]
@copyFromSection:template_AutoProduce
@define UnitID=RX_178
alsoTriggerAction:AutoProduce_RX_178_Step2

[hiddenAction_AutoProduce_RX_178_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3000
@define Resource=3500
alsoTriggerAction:AutoProduce_RX_178_Random



[hiddenAction_AutoProduce_RX_178_Random]
alsoTriggerAction:"""
AutoProduce_RX_178_Random_A,
AutoProduce_RX_178_Random_B,
AutoProduce_RX_178_Random_C
"""
[hiddenAction_AutoProduce_RX_178_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RX_178_StandardSquad

[hiddenAction_AutoProduce_RX_178_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=750
"""
alsoQueueAction:Produce_RX_178_BazookaSquad

[hiddenAction_AutoProduce_RX_178_Random_C]
requireConditional:"""
if memory.randomProduce>750
"""
alsoQueueAction:Produce_RX_178_BazookaSGSquad




[action_Pannel_RX_178]
