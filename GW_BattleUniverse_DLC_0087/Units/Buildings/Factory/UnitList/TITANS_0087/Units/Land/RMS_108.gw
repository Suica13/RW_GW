[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RMS_108:bool


[hiddenAction_Pannel_Close_RMS_108]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RMS_108=false




[hiddenAction_AutoProduce_RMS_108]
@copyFromSection:template_AutoProduce
@define UnitID=RMS_108
alsoTriggerAction:AutoProduce_RMS_108_Step2

[hiddenAction_AutoProduce_RMS_108_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=4200
@define Resource=5000
alsoTriggerAction:AutoProduce_RMS_108_Random



[hiddenAction_AutoProduce_RMS_108_Random]
alsoTriggerAction:"""
AutoProduce_RMS_108_Random_A,
AutoProduce_RMS_108_Random_B
"""
[hiddenAction_AutoProduce_RMS_108_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RMS_108_StandardSquad

[hiddenAction_AutoProduce_RMS_108_Random_B]
requireConditional:"""
if memory.randomProduce>500
"""
alsoQueueAction:Produce_RMS_108_FRSquad





[action_Pannel_RMS_108]
@copyFromSection:template_Pannel
@define UnitID=RMS_108
@define FactionVisible= (memory.Pannel_TITANS_0087_DontShow==false)

[action_Produce_RMS_108_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=RMS_108
@define Money=3800
@define Resource=4800
@define FactionVisible= (memory.Pannel_TITANS_0087_DontShow==false)
buildSpeed:55s

alsoQueueAction:"""
Produce_RMS_108_StandardSquad_1,
Produce_RMS_108_StandardSquad_2,
Produce_RMS_108_StandardSquad_3
"""
[hiddenAction_Produce_RMS_108_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RMS_108*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RMS_108_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RMS_108*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RMS_108_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
RMS_108*1(addResources=PilotType:1101|EquipmentIndex:0)
"""


