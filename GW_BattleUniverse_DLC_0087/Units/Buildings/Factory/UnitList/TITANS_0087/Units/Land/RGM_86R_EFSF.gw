[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGM_86R_EFSF:bool


[hiddenAction_Pannel_Close_RGM_86R_EFSF]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGM_86R_EFSF=false




[hiddenAction_AutoProduce_RGM_86R_EFSF]
@copyFromSection:template_AutoProduce
@define UnitID=RGM_86R_EFSF
alsoTriggerAction:AutoProduce_RGM_86R_EFSF_Step2

[hiddenAction_AutoProduce_RGM_86R_EFSF_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3650
@define Resource=4700
alsoTriggerAction:AutoProduce_RGM_86R_EFSF_Random



[hiddenAction_AutoProduce_RGM_86R_EFSF_Random]
alsoTriggerAction:"""
AutoProduce_RGM_86R_EFSF_Random_A,
AutoProduce_RGM_86R_EFSF_Random_B,
AutoProduce_RGM_86R_EFSF_Random_C
"""
[hiddenAction_AutoProduce_RGM_86R_EFSF_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RGM_86R_EFSF_StandardSquad

[hiddenAction_AutoProduce_RGM_86R_EFSF_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RGM_86R_EFSF_MGSquad

[hiddenAction_AutoProduce_RGM_86R_EFSF_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_RGM_86R_EFSF_BazookaSquad





[action_Pannel_RGM_86R_EFSF]
@copyFromSection:template_Pannel
@define UnitID=RGM_86R_EFSF
@define FactionVisible= (memory.Pannel_TITANS_0087_DontShow==false)

[action_Produce_RGM_86R_EFSF_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=RGM_86R_EFSF
@define Money=3650
@define Resource=4700
@define FactionVisible= (memory.Pannel_TITANS_0087_DontShow==false)
buildSpeed:50s

alsoQueueAction:"""
Produce_RGM_86R_EFSF_StandardSquad_1,
Produce_RGM_86R_EFSF_StandardSquad_2,
Produce_RGM_86R_EFSF_StandardSquad_3
"""
[hiddenAction_Produce_RGM_86R_EFSF_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RGM_86R_EFSF*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RGM_86R_EFSF_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
