[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGM_79C_Space:bool


[hiddenAction_Pannel_Close_RGM_79C_Space]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGM_79C_Space=false




[hiddenAction_AutoProduce_RGM_79C_Space]
@copyFromSection:template_AutoProduce
@define UnitID=RGM_79C_Space
alsoTriggerAction:AutoProduce_RGM_79C_Space_Step2

[hiddenAction_AutoProduce_RGM_79C_Space_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1650
@define Resource=2000
alsoTriggerAction:AutoProduce_RGM_79C_Space_Random



[hiddenAction_AutoProduce_RGM_79C_Space_Random]
alsoTriggerAction:"""
AutoProduce_RGM_79C_Space_Random_A,
AutoProduce_RGM_79C_Space_Random_B,
AutoProduce_RGM_79C_Space_Random_C
"""
[hiddenAction_AutoProduce_RGM_79C_Space_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RGM_79C_Space_StandardSquad

[hiddenAction_AutoProduce_RGM_79C_Space_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RGM_79C_Space_BeamSprayGunSquad

[hiddenAction_AutoProduce_RGM_79C_Space_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_RGM_79C_Space_BazookaSquad





[action_Pannel_RGM_79C_Space]
