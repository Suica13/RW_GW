[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RMS_154:bool


[hiddenAction_Pannel_Close_RMS_154]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RMS_154=false




[hiddenAction_AutoProduce_RMS_154]
@copyFromSection:template_AutoProduce
@define UnitID=RMS_154
alsoTriggerAction:AutoProduce_RMS_154_Step2

[hiddenAction_AutoProduce_RMS_154_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=5300
@define Resource=5600
alsoTriggerAction:AutoProduce_RMS_154_Random



[hiddenAction_AutoProduce_RMS_154_Random]
alsoTriggerAction:"""
AutoProduce_RMS_154_Random_A,
AutoProduce_RMS_154_Random_B,
AutoProduce_RMS_154_Random_C
"""
[hiddenAction_AutoProduce_RMS_154_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RMS_154_StandardSquad

[hiddenAction_AutoProduce_RMS_154_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RMS_154_BazookaSquad

[hiddenAction_AutoProduce_RMS_154_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_RMS_154_BazookaSGSquad





[action_Pannel_RMS_154]
@copyFromSection:template_Pannel
@define UnitID=RMS_154
@define FactionVisible= (memory.Pannel_TITANS_0087_DontShow==false)

[action_Produce_RMS_154_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=RMS_154
@define Money=5300
@define Resource=5600
@define FactionVisible= (memory.Pannel_TITANS_0087_DontShow==false)
buildSpeed:60s

alsoQueueAction:"""
Produce_RMS_154_StandardSquad_1,
Produce_RMS_154_StandardSquad_2,
Produce_RMS_154_StandardSquad_3
"""
[hiddenAction_Produce_RMS_154_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RMS_154*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RMS_154_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RMS_154*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RMS_154_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
RMS_154*1(addResources=PilotType:1101|EquipmentIndex:0)
"""


