[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RX_121_2A:bool


[hiddenAction_Pannel_Close_RX_121_2A]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RX_121_2A=false




[hiddenAction_AutoProduce_RX_121_2A]
@copyFromSection:template_AutoProduce
@define UnitID=RX_121_2A
alsoTriggerAction:AutoProduce_RX_121_2A_Step2

[hiddenAction_AutoProduce_RX_121_2A_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3000
@define Resource=3500
alsoTriggerAction:AutoProduce_RX_121_2A_Random



[hiddenAction_AutoProduce_RX_121_2A_Random]
alsoTriggerAction:"""
AutoProduce_RX_121_2A_Random_A,
AutoProduce_RX_121_2A_Random_B,
AutoProduce_RX_121_2A_Random_C
"""
[hiddenAction_AutoProduce_RX_121_2A_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
