[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RMS_154_Kai:bool


[hiddenAction_Pannel_Close_RMS_154_Kai]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RMS_154_Kai=false




[hiddenAction_AutoProduce_RMS_154_Kai]
@copyFromSection:template_AutoProduce
@define UnitID=RMS_154_Kai
alsoTriggerAction:AutoProduce_RMS_154_Kai_Step2

[hiddenAction_AutoProduce_RMS_154_Kai_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=9300
@define Resource=9300
alsoTriggerAction:AutoProduce_RMS_154_Kai_Random



[hiddenAction_AutoProduce_RMS_154_Kai_Random]
alsoTriggerAction:"""
AutoProduce_RMS_154_Kai_Random_A,
AutoProduce_RMS_154_Kai_Random_B,
AutoProduce_RMS_154_Kai_Random_C
"""
[hiddenAction_AutoProduce_RMS_154_Kai_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
