[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGM_79Q:bool


[hiddenAction_Pannel_Close_RGM_79Q]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGM_79Q=false




[hiddenAction_AutoProduce_RGM_79Q]
@copyFromSection:template_AutoProduce
@define UnitID=RGM_79Q
alsoTriggerAction:AutoProduce_RGM_79Q_Step2

[hiddenAction_AutoProduce_RGM_79Q_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3200
@define Resource=3500
alsoTriggerAction:AutoProduce_RGM_79Q_Random



[hiddenAction_AutoProduce_RGM_79Q_Random]
alsoTriggerAction:"""
AutoProduce_RGM_79Q_Random_A,
AutoProduce_RGM_79Q_Random_B,
AutoProduce_RGM_79Q_Random_C
"""
[hiddenAction_AutoProduce_RGM_79Q_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RGM_79Q_StandardSquad

[hiddenAction_AutoProduce_RGM_79Q_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RGM_79Q_BeamGunSquad

[hiddenAction_AutoProduce_RGM_79Q_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_RGM_79Q_BazookaSquad





[action_Pannel_RGM_79Q]
@copyFromSection:template_Pannel
@define UnitID=RGM_79Q
@define FactionVisible= (memory.Pannel_TITANS_0087_DontShow==false)

[action_Produce_RGM_79Q_StandardSquad]
