[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGM_79Q_ChobamArmor:bool


[hiddenAction_Pannel_Close_RGM_79Q_ChobamArmor]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGM_79Q_ChobamArmor=false




[hiddenAction_AutoProduce_RGM_79Q_ChobamArmor]
@copyFromSection:template_AutoProduce
@define UnitID=RGM_79Q_ChobamArmor
alsoTriggerAction:AutoProduce_RGM_79Q_ChobamArmor_Step2

[hiddenAction_AutoProduce_RGM_79Q_ChobamArmor_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3200
@define Resource=4000
alsoTriggerAction:AutoProduce_RGM_79Q_ChobamArmor_Random



[hiddenAction_AutoProduce_RGM_79Q_ChobamArmor_Random]
alsoTriggerAction:"""
AutoProduce_RGM_79Q_ChobamArmor_Random_A,
AutoProduce_RGM_79Q_ChobamArmor_Random_B,
AutoProduce_RGM_79Q_ChobamArmor_Random_C
"""
[hiddenAction_AutoProduce_RGM_79Q_ChobamArmor_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RGM_79Q_ChobamArmor_StandardSquad

[hiddenAction_AutoProduce_RGM_79Q_ChobamArmor_Random_B]
