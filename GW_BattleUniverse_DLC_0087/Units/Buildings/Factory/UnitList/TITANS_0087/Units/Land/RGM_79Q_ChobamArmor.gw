if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RGM_79Q_ChobamArmor_BeamGunSquad

[hiddenAction_AutoProduce_RGM_79Q_ChobamArmor_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_RGM_79Q_ChobamArmor_BazookaSquad





