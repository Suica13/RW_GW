@define Resource=12000
alsoQueueAction:Produce_IrishClass



[action_Produce_IrishClass]
@copyFromSection:template_Produce_Fast
@define UnitID=IrishClass
@define Money=7000
@define Resource=12000
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)
buildSpeed:70s

alsoQueueAction:"""
Produce_IrishClass_1
