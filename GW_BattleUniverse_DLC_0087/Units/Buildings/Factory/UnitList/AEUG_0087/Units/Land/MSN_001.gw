[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory MSN_001:bool


[hiddenAction_Pannel_Close_MSN_001]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MSN_001=false




[hiddenAction_AutoProduce_MSN_001]
@copyFromSection:template_AutoProduce
@define UnitID=MSN_001
alsoTriggerAction:AutoProduce_MSN_001_Step2

[hiddenAction_AutoProduce_MSN_001_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=10000
@define Resource=10000
alsoQueueAction:Produce_MSN_001_StandardSquad


[action_Produce_MSN_001_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=MSN_001
@define Money=10000
@define Resource=10000
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:75s

alsoQueueAction:"""
Produce_MSN_001_StandardSquad_1
"""
[hiddenAction_Produce_MSN_001_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MSN_001*1(addResources=PilotType:1101|EquipmentIndex:0)
