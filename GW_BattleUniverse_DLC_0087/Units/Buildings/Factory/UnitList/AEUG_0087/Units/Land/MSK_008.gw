[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory MSK_008:bool


[hiddenAction_Pannel_Close_MSK_008]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MSK_008=false




[hiddenAction_AutoProduce_MSK_008]
@copyFromSection:template_AutoProduce
@define UnitID=MSK_008
alsoTriggerAction:AutoProduce_MSK_008_Step2

[hiddenAction_AutoProduce_MSK_008_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3800
@define Resource=5000
alsoTriggerAction:AutoProduce_MSK_008_Random



[hiddenAction_AutoProduce_MSK_008_Random]
alsoTriggerAction:"""
AutoProduce_MSK_008_Random_A,
AutoProduce_MSK_008_Random_B,
AutoProduce_MSK_008_Random_C
"""
[hiddenAction_AutoProduce_MSK_008_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MSK_008_StandardSquad

[hiddenAction_AutoProduce_MSK_008_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=750
"""
alsoQueueAction:Produce_MSK_008_BazookaSquad

[hiddenAction_AutoProduce_MSK_008_Random_C]
requireConditional:"""
if memory.randomProduce>750
"""
alsoQueueAction:Produce_MSK_008_BazookaSGSquad




[action_Pannel_MSK_008]
@copyFromSection:template_Pannel
@define UnitID=MSK_008
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png

[action_Produce_MSK_008_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MSK_008
@define Money=3400
@define Resource=5000
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)
buildSpeed:50s

text:BR
text_zh:光束步枪

alsoQueueAction:"""
Produce_MSK_008_StandardSquad_1
"""
[hiddenAction_Produce_MSK_008_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MSK_008*1(addResources=PilotType:1101|EquipmentIndex:0)
"""


[action_Produce_MSK_008_BazookaSquad]
@copyFromSection:template_Produce
@define UnitID=MSK_008
@define Money=3200
@define Resource=4800
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)
buildSpeed:50s

text:Bazooka
text_zh:火箭筒

alsoQueueAction:"""
Produce_MSK_008_BazookaSquad_1
"""
[hiddenAction_Produce_MSK_008_BazookaSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MSK_008*1(addResources=PilotType:1101|EquipmentIndex:1)
"""


