[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory MSA_003:bool


[hiddenAction_Pannel_Close_MSA_003]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MSA_003=false




[hiddenAction_AutoProduce_MSA_003]
@copyFromSection:template_AutoProduce
@define UnitID=MSA_003
alsoTriggerAction:AutoProduce_MSA_003_Step2

[hiddenAction_AutoProduce_MSA_003_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3300
@define Resource=4300
alsoTriggerAction:AutoProduce_MSA_003_Random



[hiddenAction_AutoProduce_MSA_003_Random]
alsoTriggerAction:"""
AutoProduce_MSA_003_Random_A,
AutoProduce_MSA_003_Random_B,
AutoProduce_MSA_003_Random_C
"""
[hiddenAction_AutoProduce_MSA_003_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MSA_003_StandardSquad

[hiddenAction_AutoProduce_MSA_003_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_MSA_003_MGSquad

[hiddenAction_AutoProduce_MSA_003_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_MSA_003_BazookaSquad





[action_Pannel_MSA_003]
@copyFromSection:template_Pannel
@define UnitID=MSA_003
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)

[action_Produce_MSA_003_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MSA_003
@define Money=3300
@define Resource=4300
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)
buildSpeed:55s

alsoQueueAction:"""
Produce_MSA_003_StandardSquad_1,
Produce_MSA_003_StandardSquad_2,
Produce_MSA_003_StandardSquad_3
"""
[hiddenAction_Produce_MSA_003_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MSA_003*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MSA_003_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MSA_003*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MSA_003_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
MSA_003*1(addResources=PilotType:1101|EquipmentIndex:0)
"""

