[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory MSA_003_Cannon:bool


[hiddenAction_Pannel_Close_MSA_003_Cannon]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MSA_003_Cannon=false




[hiddenAction_AutoProduce_MSA_003_Cannon]
@copyFromSection:template_AutoProduce
@define UnitID=MSA_003_Cannon
alsoTriggerAction:AutoProduce_MSA_003_Cannon_Step2

[hiddenAction_AutoProduce_MSA_003_Cannon_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2900
@define Resource=3700
alsoTriggerAction:AutoProduce_MSA_003_Cannon_Random



[hiddenAction_AutoProduce_MSA_003_Cannon_Random]
