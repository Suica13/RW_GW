text_zh:米加粒子发射器

alsoQueueAction:"""
Produce_MSZ_006_HMLSquad_1
"""
[hiddenAction_Produce_MSZ_006_HMLSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MSZ_006*1(addResources=PilotType:1101|EquipmentIndex:1)
"""

