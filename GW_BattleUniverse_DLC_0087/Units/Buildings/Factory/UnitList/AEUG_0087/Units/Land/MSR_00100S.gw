[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory MSR_00100S:bool


[hiddenAction_Pannel_Close_MSR_00100S]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MSR_00100S=false




[hiddenAction_AutoProduce_MSR_00100S]
@copyFromSection:template_AutoProduce
@define UnitID=MSR_00100S
alsoTriggerAction:AutoProduce_MSR_00100S_Step2

[hiddenAction_AutoProduce_MSR_00100S_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=5700
@define Resource=7000
alsoTriggerAction:AutoProduce_MSR_00100S_Random



[hiddenAction_AutoProduce_MSR_00100S_Random]
alsoTriggerAction:"""
AutoProduce_MSR_00100S_Random_A,
AutoProduce_MSR_00100S_Random_B,
AutoProduce_MSR_00100S_Random_C
"""
[hiddenAction_AutoProduce_MSR_00100S_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MSR_00100S_StandardSquad

[hiddenAction_AutoProduce_MSR_00100S_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=750
"""
alsoQueueAction:Produce_MSR_00100S_BazookaSquad

[hiddenAction_AutoProduce_MSR_00100S_Random_C]
requireConditional:"""
if memory.randomProduce>750
"""
alsoQueueAction:Produce_MSR_00100S_BazookaSGSquad




[action_Pannel_MSR_00100S]
@copyFromSection:template_Pannel
@define UnitID=MSR_00100S
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png

[action_Produce_MSR_00100S_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MSR_00100S
@define Money=5700
@define Resource=7000
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)
buildSpeed:55s

text:BR
text_zh:光束步枪

alsoQueueAction:"""
Produce_MSR_00100S_StandardSquad_1
"""
[hiddenAction_Produce_MSR_00100S_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MSR_00100S*1(addResources=PilotType:1101|EquipmentIndex:0)
"""


