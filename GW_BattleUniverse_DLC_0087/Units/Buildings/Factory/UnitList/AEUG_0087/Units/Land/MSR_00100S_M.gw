@define UnitID=MSR_00100S_M
@define Money=12000
@define Resource=14000
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)
buildSpeed:70s

alsoQueueAction:"""
Produce_MSR_00100S_M_StandardSquad_1,
Produce_MSR_00100S_M_StandardSquad_2,
Produce_MSR_00100S_M_StandardSquad_3
"""
[hiddenAction_Produce_MSR_00100S_M_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MSR_00100S_M*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MSR_00100S_M_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
