[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory MSR_00100S_M:bool


[hiddenAction_Pannel_Close_MSR_00100S_M]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MSR_00100S_M=false




[hiddenAction_AutoProduce_MSR_00100S_M]
@copyFromSection:template_AutoProduce
@define UnitID=MSR_00100S_M
alsoTriggerAction:AutoProduce_MSR_00100S_M_Step2

[hiddenAction_AutoProduce_MSR_00100S_M_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=12000
@define Resource=14000
alsoTriggerAction:AutoProduce_MSR_00100S_M_Random



[hiddenAction_AutoProduce_MSR_00100S_M_Random]
alsoTriggerAction:"""
AutoProduce_MSR_00100S_M_Random_A,
AutoProduce_MSR_00100S_M_Random_B,
AutoProduce_MSR_00100S_M_Random_C
"""
[hiddenAction_AutoProduce_MSR_00100S_M_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MSR_00100S_M_StandardSquad

[hiddenAction_AutoProduce_MSR_00100S_M_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_MSR_00100S_M_BazookaSquad

[hiddenAction_AutoProduce_MSR_00100S_M_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_MSR_00100S_M_BazookaSGSquad





[action_Pannel_MSR_00100S_M]
@copyFromSection:template_Pannel
@define UnitID=MSR_00100S_M
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)

[action_Produce_MSR_00100S_M_StandardSquad]
