[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory MSA_003_HM:bool


[hiddenAction_Pannel_Close_MSA_003_HM]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MSA_003_HM=false




[hiddenAction_AutoProduce_MSA_003_HM]
@copyFromSection:template_AutoProduce
@define UnitID=MSA_003_HM
alsoTriggerAction:AutoProduce_MSA_003_HM_Step2

[hiddenAction_AutoProduce_MSA_003_HM_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3400
@define Resource=3500
alsoTriggerAction:AutoProduce_MSA_003_HM_Random



[hiddenAction_AutoProduce_MSA_003_HM_Random]
alsoTriggerAction:"""
AutoProduce_MSA_003_HM_Random_A,
AutoProduce_MSA_003_HM_Random_B,
AutoProduce_MSA_003_HM_Random_C
"""
[hiddenAction_AutoProduce_MSA_003_HM_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MSA_003_HM_StandardSquad

[hiddenAction_AutoProduce_MSA_003_HM_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=750
"""
alsoQueueAction:Produce_MSA_003_HM_BazookaSquad

[hiddenAction_AutoProduce_MSA_003_HM_Random_C]
requireConditional:"""
if memory.randomProduce>750
"""
alsoQueueAction:Produce_MSA_003_HM_BazookaSGSquad




[action_Pannel_MSA_003_HM]
@copyFromSection:template_Pannel
@define UnitID=MSA_003_HM
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png

[action_Produce_MSA_003_HM_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MSA_003_HM
@define Money=3400
@define Resource=3500
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)
buildSpeed:45s

text:BR
text_zh:光束步枪

alsoQueueAction:"""
Produce_MSA_003_HM_StandardSquad_1
"""
[hiddenAction_Produce_MSA_003_HM_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MSA_003_HM*1(addResources=PilotType:1101|EquipmentIndex:0)
"""


[action_Produce_MSA_003_HM_BazookaSquad]
@copyFromSection:template_Produce
@define UnitID=MSA_003_HM
@define Money=3200
@define Resource=3300
@define FactionVisible= (memory.Pannel_AEUG_0087_DontShow==false)
buildSpeed:45s

text:Bazooka
text_zh:火箭筒

alsoQueueAction:"""
Produce_MSA_003_HM_BazookaSquad_1
"""
[hiddenAction_Produce_MSA_003_HM_BazookaSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MSA_003_HM*1(addResources=PilotType:1101|EquipmentIndex:1)
"""


