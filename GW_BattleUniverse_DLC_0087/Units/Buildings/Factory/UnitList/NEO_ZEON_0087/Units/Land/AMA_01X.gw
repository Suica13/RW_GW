[hiddenAction_AutoProduce_AMA_01X]
@copyFromSection:template_AutoProduce
@define UnitID=AMA_01X
alsoTriggerAction:AutoProduce_AMA_01X_Step2

[hiddenAction_AutoProduce_AMA_01X_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=5000
@define Resource=6500
alsoTriggerAction:AutoProduce_AMA_01X_Random



[hiddenAction_AutoProduce_AMA_01X_Random]
alsoTriggerAction:"""
AutoProduce_AMA_01X_Random_A
"""
[hiddenAction_AutoProduce_AMA_01X_Random_A]
