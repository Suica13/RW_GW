[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_14J:bool


[hiddenAction_Pannel_Close_MS_14J]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_14J=false



[hiddenAction_AutoProduce_MS_14J]
@copyFromSection:template_AutoProduce
@define UnitID=MS_14J
alsoTriggerAction:AutoProduce_MS_14J_Step2

[hiddenAction_AutoProduce_MS_14J_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=5200
@define Resource=6700
alsoTriggerAction:AutoProduce_MS_14J_Random



[hiddenAction_AutoProduce_MS_14J_Random]
alsoTriggerAction:"""
AutoProduce_MS_14J_Random_A,
AutoProduce_MS_14J_Random_B
"""
[hiddenAction_AutoProduce_MS_14J_Random_A]
requireConditional:"""
if memory.randomProduce<500
"""
alsoQueueAction:Produce_MS_14J_StandardSquad

[hiddenAction_AutoProduce_MS_14J_Random_B]
requireConditional:"""
if memory.randomProduce>500
"""
alsoQueueAction:Produce_MS_14J_BazookaSquad




[action_Pannel_MS_14J]
@copyFromSection:template_Pannel
@define UnitID=MS_14J
@define FactionVisible= (memory.Pannel_NEO_ZEON_0087_DontShow==false)


[action_Produce_MS_14J_StandardSquad]
