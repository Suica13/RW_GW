buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
AMX_006*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_AMX_006_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
