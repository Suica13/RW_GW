@define UnitID=AMX_006
alsoTriggerAction:AutoProduce_AMX_006_Step2

[hiddenAction_AutoProduce_AMX_006_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=4000
@define Resource=5000
alsoQueueAction:Produce_AMX_006_StandardSquad



[action_Produce_AMX_006_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=AMX_006
@define Money=4000
@define Resource=5000
@define FactionVisible= (memory.Pannel_NEO_ZEON_0087_DontShow==false)
buildSpeed:55s

alsoQueueAction:"""
Produce_AMX_006_StandardSquad_1,
Produce_AMX_006_StandardSquad_2,
Produce_AMX_006_StandardSquad_3
"""
