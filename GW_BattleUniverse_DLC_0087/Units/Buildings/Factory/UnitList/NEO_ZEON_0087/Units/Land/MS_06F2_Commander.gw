[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory MS_06F2_Commander:bool


[hiddenAction_Pannel_Close_MS_06F2_Commander]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_06F2_Commander=false




[hiddenAction_AutoProduce_MS_06F2_Commander]
@copyFromSection:template_AutoProduce
@define UnitID=MS_06F2_Commander
alsoTriggerAction:AutoProduce_MS_06F2_Commander_Step2

[hiddenAction_AutoProduce_MS_06F2_Commander_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=650
@define Resource=750
alsoTriggerAction:AutoProduce_MS_06F2_Commander_Random



[hiddenAction_AutoProduce_MS_06F2_Commander_Random]
alsoTriggerAction:"""
AutoProduce_MS_06F2_Commander_Random_A,
AutoProduce_MS_06F2_Commander_Random_B,
AutoProduce_MS_06F2_Commander_Random_C
"""
[hiddenAction_AutoProduce_MS_06F2_Commander_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MS_06F2_Commander_StandardSquad

[hiddenAction_AutoProduce_MS_06F2_Commander_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_MS_06F2_Commander_AntiAirSquad

[hiddenAction_AutoProduce_MS_06F2_Commander_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_MS_06F2_Commander_BazookaSquad





