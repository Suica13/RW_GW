[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini





[hiddenAction_AutoProduce_MS_15K]
@copyFromSection:template_AutoProduce
@define UnitID=MS_15K
alsoTriggerAction:AutoProduce_MS_15K_Step2

[hiddenAction_AutoProduce_MS_15K_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=4650
@define Resource=5000
alsoQueueAction:Produce_MS_15K_StandardSquad



[action_Produce_MS_15K_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=MS_15K
@define Money=4650
@define Resource=5000
@define FactionVisible= (memory.Pannel_NEO_ZEON_0087_DontShow==false)
buildSpeed:65s

alsoQueueAction:"""
Produce_MS_15K_StandardSquad_1,
Produce_MS_15K_StandardSquad_2,
Produce_MS_15K_StandardSquad_3
"""
[hiddenAction_Produce_MS_15K_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_15K*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_15K_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MS_15K*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_15K_StandardSquad_3]
