[core]
dont_load:true
@memory manualShipTarget:unit
@memory manualShipHQ:unit
@memory manualShipSerial:float
@memory manualShipOrderUntil:float
@memory manualShipRemaining:float
@memory manualShipReserved:bool
@memory manualShipPermitControlled:bool
@global manualShipAuthorized=(parent.hp>0 and self.hp>0 and not memory.breaked and parent.teamId==self.teamId and parent.hasTags(includes='ManualControlled') and not parent.hasTags(includes='inHangar') and memory.manualShipHQ.hp>0 and memory.manualShipHQ.teamId==self.teamId and memory.manualShipHQ.hasTags(includes='HQ_NotCaptured') and memory.manualShipHQ.readUnitMemory('manualControlledUnit',type='unit')==parent and parent.readUnitMemory('manualControlHQ',type='unit')==memory.manualShipHQ and parent.readUnitMemory('manualVulcanSerial',type='float')==memory.manualShipSerial and not parent.readUnitMemory('battleUnitCore',type='unit').readUnitMemory('cantAction',type='bool') and not parent.readUnitMemory('battleUnitCore',type='unit').readUnitMemory('onSkill',type='bool'))
@global manualShipOrderReady=((parent.hp>0 and self.hp>0 and not memory.breaked and parent.teamId==self.teamId and parent.hasTags(includes='ManualControlled') and not parent.hasTags(includes='inHangar') and memory.manualShipHQ.hp>0 and memory.manualShipHQ.teamId==self.teamId and memory.manualShipHQ.hasTags(includes='HQ_NotCaptured') and memory.manualShipHQ.readUnitMemory('manualControlledUnit',type='unit')==parent and parent.readUnitMemory('manualControlHQ',type='unit')==memory.manualShipHQ and parent.readUnitMemory('manualVulcanSerial',type='float')==memory.manualShipSerial and not parent.readUnitMemory('battleUnitCore',type='unit').readUnitMemory('cantAction',type='bool') and not parent.readUnitMemory('battleUnitCore',type='unit').readUnitMemory('onSkill',type='bool')) and self.timeAlive<memory.manualShipOrderUntil and memory.manualShipRemaining>0 and memory.manualShipTarget.hp>0 and self.attacking==memory.manualShipTarget and not memory.manualShipTarget.hasTags(includes='UnDetected') and distanceBetween(self,memory.manualShipTarget)<=1200)

[resource_ManualShipShotPermit]
hidden:true

# Shared 0079/0087 turret IDs must use the same existing fire-order message protocol.
[hiddenAction_ManualShip_Order]
autoTriggerOnEvent:newMessage(withTag='ManualShip_0087_Beam')
requireConditional:if eventData('owner',type='unit')==parent and parent.hasTags(includes='ManualControlled') and eventData('controller',type='unit').hp>0 and eventData('controller',type='unit').readUnitMemory('manualControlledUnit',type='unit')==parent and eventData('serial',type='float')==parent.readUnitMemory('manualVulcanSerial',type='float') and self.hp>0 and not memory.breaked and self.attacking.hp>0 and not self.attacking.hasTags(includes='UnDetected') and not memory.GwanzanClass_Turret_BeamCannon_OnCD and self.resource.GwanzanClass_Turret_BeamCannon_ShootTimer>0 and memory.manualShipRemaining<=0
setUnitMemory:manualShipTarget=self.attacking,manualShipHQ=eventData('controller',type='unit'),manualShipSerial=eventData('serial',type='float'),manualShipOrderUntil=self.timeAlive+5,manualShipRemaining=self.resource.GwanzanClass_Turret_BeamCannon_ShootTimer

# Native resourceUsage is checked at firing, separately from native target/arc selection.
# Prepay one shot atomically; cancelled unused permission returns the same EN cost.
[hiddenAction_ManualShip_ReserveShot]
autoTriggerCheckRate:everyFrame
autoTrigger:if self.hp>0 and parent.hp>0 and not memory.breaked and not parent.hasTags(includes='inHangar') and not memory.manualShipReserved and self.resource.ManualShipShotPermit<=0 and self.attacking.hp>0 and not self.attacking.hasTags(includes='UnDetected') and distanceBetween(self,self.attacking)<=1200 and not memory.GwanzanClass_Turret_BeamCannon_OnCD and self.resource.GwanzanClass_Turret_BeamCannon_ShootTimer>0 and (${onAttacking}==false and ${cantAction}==false  and parent.resource().en>0) and (not parent.hasTags(includes='ManualControlled') or ${manualShipOrderReady})
takeResources:EN=${GwanzanClass_Turret_BeamCannon_EN}
takeResources_includeParent:true
takeResources_excludeUnitsWithoutAllResources:true
takeResources_discardCollected:true
takeResources_maxUnits:1
takeResources_triggerActionIfAnyCollected:ManualShip_Permit

[hiddenAction_ManualShip_Permit]
setUnitMemory:manualShipReserved=true,manualShipPermitControlled=parent.hasTags(includes='ManualControlled')
setResourcesWithLogic:ManualShipShotPermit=1

[hiddenAction_ManualShip_Consumed]
setUnitMemory:manualShipReserved=false,manualShipRemaining=max(0,memory.manualShipRemaining-1)

[hiddenAction_ManualShip_Refund]
requireConditional:if memory.manualShipReserved and self.resource.ManualShipShotPermit>0
sendMessageTo:parent
sendMessageWithTags:UseEN
sendMessageWithData:useEN=-${GwanzanClass_Turret_BeamCannon_EN}
setUnitMemory:manualShipReserved=false
setResourcesWithLogic:ManualShipShotPermit=0

[hiddenAction_ManualShip_Hold]
autoTriggerOnEvent:newMessage(withTag='ManualShip_Hold')
requireConditional:if eventData('owner',type='unit')==parent
setUnitMemory:manualShipOrderUntil=0,manualShipRemaining=0
alsoTriggerAction:ManualShip_Refund

[hiddenAction_ManualShip_Cancel]
autoTriggerCheckRate:everyFrame
autoTrigger:if (memory.manualShipOrderUntil>0 and (not ${manualShipOrderReady})) or (memory.manualShipReserved and (self.hp<=0 or parent.hp<=0 or memory.breaked or self.attacking.hp<=0 or self.attacking.hasTags(includes='UnDetected') or distanceBetween(self,self.attacking)>1200 or parent.hasTags(includes='inHangar') or memory.manualShipPermitControlled!=parent.hasTags(includes='ManualControlled')))
setUnitMemory:manualShipOrderUntil=0,manualShipRemaining=0
alsoTriggerAction:ManualShip_Refund

[turret_GwanzanClass_Turret_BeamCannon]
canAttackCondition:if (${onAttacking}==false and ${cantAction}==false  and (parent.resource().en>0 or memory.manualShipReserved)) and (not memory.manualShipReserved or not parent.hasTags(includes='ManualControlled') or ${manualShipOrderReady})
resourceUsage:GwanzanClass_Turret_BeamCannon_ShootTimer=1,ManualShipShotPermit=1
onShoot_triggerActions:SendEnemyTryAttack_Shoot,ManualShip_Consumed

[hiddenAction_GwanzanClass_Turret_BeamCannon_CDStart]
autoTrigger:if (memory.GwanzanClass_Turret_BeamCannon_OnCD==false and (    (        self.resource.GwanzanClass_Turret_BeamCannon_ShootTimer<=0     )     or     (        self.resource.GwanzanClass_Turret_BeamCannon_ShootTimer<${GwanzanClass_Turret_BeamCannon_Shoot} and not self.hasTags(includes='inBattle')    ))) and (not parent.hasTags(includes='ManualControlled') or memory.manualShipRemaining<=0 or self.timeAlive>=memory.manualShipOrderUntil)
