@copyFromSection:template_ManualShip_ArcLine
color:#E6D28C
isVisible:if ${manualControlReady} and memory.hideUI==0 and memory.manualShipArcGroup==0 and self.attachment(slot='HeavyForkClass_Turret_Cannon_L1').hp>0 and not self.attachment(slot='HeavyForkClass_Turret_Cannon_L1').readUnitMemory('breaked',type='bool')
