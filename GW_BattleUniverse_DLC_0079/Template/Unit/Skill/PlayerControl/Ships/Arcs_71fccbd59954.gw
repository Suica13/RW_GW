[core]
dont_load:true

[template_ManualShip_ArcLine]
layer:shadow
order:0
onlyTeam:own
onlyWhenSelectedByOwnPlayer:true
onlyOnNonPreview:true
onlyWhileAlive:true
lineWidth:1

[template_ManualShip_Arc_PapuaClass_Turret_AA_L1_turret_PapuaClass_Turret_AA]
@copyFromSection:template_ManualShip_ArcLine
color:#65E6CE
isVisible:if ${manualControlReady} and memory.hideUI==0 and memory.manualShipArcGroup==0 and self.attachment(slot='PapuaClass_Turret_AA_L1').hp>0 and not self.attachment(slot='PapuaClass_Turret_AA_L1').readUnitMemory('breaked',type='bool')
alpha:select(not self.attachment(slot='PapuaClass_Turret_AA_L1').readUnitMemory('PapuaClass_Turret_AA_OnCD',type='bool') and self.attachment(slot='PapuaClass_Turret_AA_L1').resource.PapuaClass_Turret_AA_ShootTimer>0,0.55,0.15)

