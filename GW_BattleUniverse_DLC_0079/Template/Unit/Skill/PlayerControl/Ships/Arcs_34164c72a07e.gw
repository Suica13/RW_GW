[core]
dont_load:true

[template_ManualShip_ArcLine]
layer:shadow
order:0
onlyTeam:own
onlyWhenSelectedByOwnPlayer:true
onlyOnNonPreview:true
onlyWhileAlive:true
lineWidth:1

[template_ManualShip_Arc_HimalayaClass_Turret_CN_M1_turret_HimalayaClass_Turret_CN]
@copyFromSection:template_ManualShip_ArcLine
color:#E6D28C
isVisible:if ${manualControlReady} and memory.hideUI==0 and memory.manualShipArcGroup==0 and self.attachment(slot='HimalayaClass_Turret_CN_M1').hp>0 and not self.attachment(slot='HimalayaClass_Turret_CN_M1').readUnitMemory('breaked',type='bool')
alpha:select(not self.attachment(slot='HimalayaClass_Turret_CN_M1').readUnitMemory('HimalayaClass_Turret_CN_OnCD',type='bool') and self.attachment(slot='HimalayaClass_Turret_CN_M1').resource.HimalayaClass_Turret_CN_ShootTimer>0,0.55,0.15)

