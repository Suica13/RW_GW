requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_FA_78_2_FrameLauncher_MG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${EF_FA_78_2_FrameLauncher_MG_EN}
alsoTriggerAction:EF_FA_78_2_FrameLauncher_MG_Fire

[hiddenAction_EF_FA_78_2_FrameLauncher_MG_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_FA_78_2_FrameLauncher_MG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.EF_FA_78_2_FrameLauncher_MG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${EF_FA_78_2_FrameLauncher_MG_EN})
setUnitMemory:EF_FA_78_2_FrameLauncher_MG_CDTimer=self.timeAlive+${EF_FA_78_2_FrameLauncher_MG_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
