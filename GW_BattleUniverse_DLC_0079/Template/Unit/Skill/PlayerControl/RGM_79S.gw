requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_Grenade_B_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${Common_Grenade_B_EN}
