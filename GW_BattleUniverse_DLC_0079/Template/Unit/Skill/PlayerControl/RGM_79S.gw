isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.EF_RGM_79S_MS_Line_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${EF_RGM_79S_MS_Line_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_RGM_79S_MS_Line_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${EF_RGM_79S_MS_Line_EN}
alsoTriggerAction:EF_RGM_79S_MS_Line_Fire

[hiddenAction_EF_RGM_79S_MS_Line_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_RGM_79S_MS_Line_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.EF_RGM_79S_MS_Line_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${EF_RGM_79S_MS_Line_EN})
setUnitMemory:EF_RGM_79S_MS_Line_CDTimer=self.timeAlive+${EF_RGM_79S_MS_Line_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
