setUnitMemory:EF_RX_78GP02A_MRLS_S_CDTimer=self.timeAlive+${EF_RX_78GP02A_MRLS_S_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
