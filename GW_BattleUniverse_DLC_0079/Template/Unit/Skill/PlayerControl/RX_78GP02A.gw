requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_RX_78GP02A_MRLS_S_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==0) and (memory.backpackBreaked==false)))) and self.resource.EN>=${EF_RX_78GP02A_MRLS_S_EN}
