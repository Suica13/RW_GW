isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_YMS_16M_Cannon_HE_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.backpackBreaked==false)))) and self.resource.EN>=${ZN_YMS_16M_Cannon_HE_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_YMS_16M_Cannon_HE_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.backpackBreaked==false)))) and self.resource.EN>=${ZN_YMS_16M_Cannon_HE_EN}
alsoTriggerAction:ZN_YMS_16M_Cannon_HE_Fire

[hiddenAction_ZN_YMS_16M_Cannon_HE_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_YMS_16M_Cannon_HE_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_YMS_16M_Cannon_HE_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.backpackBreaked==false)))) and self.resource.EN>=${ZN_YMS_16M_Cannon_HE_EN})
setUnitMemory:ZN_YMS_16M_Cannon_HE_CDTimer=self.timeAlive+${ZN_YMS_16M_Cannon_HE_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
