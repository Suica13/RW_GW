requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_HeatSaber_AF_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false))))
alsoTriggerAction:ZN_HeatSaber_AF_Fire

[hiddenAction_ZN_HeatSaber_AF_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_HeatSaber_AF_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_HeatSaber_AF_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false)))))
setUnitMemory:ZN_HeatSaber_AF_CDTimer=self.timeAlive+${ZN_HeatSaber_AF_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
