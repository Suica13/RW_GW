isVisible:if ${manualControlReady} and ((((memory.armRBreaked==false) and (memory.pilotUnit.readUnitMemory("pilotCqbSkillFinal",type="float")>145))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_HeatSword_BF_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false) and (memory.pilotUnit.readUnitMemory("pilotCqbSkillFinal",type="float")>145)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_HeatSword_BF_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false) and (memory.pilotUnit.readUnitMemory("pilotCqbSkillFinal",type="float")>145))))
