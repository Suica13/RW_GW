isVisible:if ${manualControlReady} and ((((memory.armLBreaked==false) and (self.shield>0) and (memory.pilotUnit.readUnitMemory("pilotCqbSkillFinal",type="float")>145))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_Cqb_A_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armLBreaked==false) and (self.shield>0) and (memory.pilotUnit.readUnitMemory("pilotCqbSkillFinal",type="float")>145)))))
