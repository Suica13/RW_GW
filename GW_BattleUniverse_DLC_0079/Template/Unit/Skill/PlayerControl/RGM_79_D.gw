requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_BeamSprayGunFD_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSprayGunFD_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false)))) and self.resource.EN>=${EF_BeamSprayGunFD_EN})
setUnitMemory:EF_BeamSprayGunFD_CDTimer=self.timeAlive+${EF_BeamSprayGunFD_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
