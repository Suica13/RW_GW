requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_Railgun_79_D_RG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==0) and (memory.armRBreaked==false)))) and self.resource.EN>=${EF_Railgun_79_D_RG_EN}
alsoTriggerAction:EF_Railgun_79_D_RG_Fire

[hiddenAction_EF_Railgun_79_D_RG_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_Railgun_79_D_RG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.EF_Railgun_79_D_RG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==0) and (memory.armRBreaked==false)))) and self.resource.EN>=${EF_Railgun_79_D_RG_EN})
