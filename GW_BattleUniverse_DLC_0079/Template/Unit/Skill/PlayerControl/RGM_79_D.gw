isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSprayGunFD_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false)))) and self.resource.EN>=${EF_BeamSprayGunFD_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSprayGunFD_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false)))) and self.resource.EN>=${EF_BeamSprayGunFD_EN}
