iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==false) and (self.resource().EquipmentIndex==1))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_135mmAntiShipSniper_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false) and (self.resource().EquipmentIndex==1)))) and self.resource.EN>=${ZN_135mmAntiShipSniper_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_135mmAntiShipSniper_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false) and (self.resource().EquipmentIndex==1)))) and self.resource.EN>=${ZN_135mmAntiShipSniper_EN}
alsoTriggerAction:ZN_135mmAntiShipSniper_Fire

[hiddenAction_ZN_135mmAntiShipSniper_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_135mmAntiShipSniper_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_135mmAntiShipSniper_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false) and (self.resource().EquipmentIndex==1)))) and self.resource.EN>=${ZN_135mmAntiShipSniper_EN})
setUnitMemory:ZN_135mmAntiShipSniper_CDTimer=self.timeAlive+${ZN_135mmAntiShipSniper_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
