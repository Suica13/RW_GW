[core]
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_Common_Push_A_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60   and memory.armRBreaked==true)

[hiddenAction_Common_Push_A_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_R4_BeamSniperRifle_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and memory.attackMode==0 and memory.armRBreaked==false and self.resource().EquipmentIndex==0 and eventData("RandomWeapon",type="float")>25)

[hiddenAction_EF_R4_BeamSniperRifle_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_R4_BeamSniperRifle_Sniper_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false and ${onSkill}==false and memory.armRBreaked==false and self.timeAlive>memory.EF_R4_BeamSniperRifle_Sniper_CDTimer and not self.hasTags(includes='inHangar') and not parent.hasTags(includes='SFS_Slot') and self.resource.en>${EF_R4_BeamSniperRifle_Sniper_EN} and memory.EF_R4_BeamSniperRifle_Sniper_AimTarget.hp>0 and ${EF_R4_BeamSniperRifle_Sniper_CanUse})

[hiddenAction_EF_R4_BeamSniperRifle_Sniper_Fire_Step_1]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_R4_BeamSniperRifle_Sniper_Attack]
requireConditional:if (memory.EF_R4_BeamSniperRifle_Sniper_Active==true) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_R4_BeamSniperRifle_Sniper_Attack_T]
requireConditional:if (memory.armRBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_HypeBazooka_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=500 and memory.armRBreaked==false and self.resource().EquipmentIndex==1  and eventData("RandomWeapon",type="float")>25)

[hiddenAction_EF_HypeBazooka_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_BeamSprayGun_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=500 and memory.armRBreaked==false and eventData("RandomWeapon",type="float")<=25)

[hiddenAction_EF_BeamSprayGun_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_ArmBeamSaber_B_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60   and memory.armRBreaked==false)

[hiddenAction_Common_ArmBeamSaber_B_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[action_EF_R4_BeamSniperRifle_Sniper_Trigger]
pos:30
requireConditional:if (parent.hp<=0 and self.resource().EquipmentIndex==0) and (not memory.manualControlEnabled or ${manualWeaponReady})

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff
setUnitMemory:EF_R4_BeamSniperRifle_Sniper_Active=false

[action_Manual_Common_Push_A]
@copyFromSection:template_ManualWeapon
pos:4
text:Punch
text_zh:徒手格斗
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==true))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true))))
alsoTriggerAction:Common_Push_A_Fire

[hiddenAction_Common_Push_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
setUnitMemory:Common_Push_A_CDTimer=self.timeAlive+${Common_Push_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_Push_A_CD}s
addActionCooldownApplyToActions:Manual_Common_Push_A

[action_Manual_EF_R4_BeamSniperRifle]
@copyFromSection:template_ManualWeapon
pos:2
text:Sniper rifle
text_zh:狙击步枪
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==false) and (self.resource().EquipmentIndex==0))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.EF_R4_BeamSniperRifle_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false) and (self.resource().EquipmentIndex==0)))) and self.resource.EN>=${EF_R4_BeamSniperRifle_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_R4_BeamSniperRifle_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false) and (self.resource().EquipmentIndex==0)))) and self.resource.EN>=${EF_R4_BeamSniperRifle_EN}
alsoTriggerAction:EF_R4_BeamSniperRifle_Fire

[hiddenAction_EF_R4_BeamSniperRifle_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_R4_BeamSniperRifle_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.EF_R4_BeamSniperRifle_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false) and (self.resource().EquipmentIndex==0)))) and self.resource.EN>=${EF_R4_BeamSniperRifle_EN})
setUnitMemory:EF_R4_BeamSniperRifle_CDTimer=self.timeAlive+${EF_R4_BeamSniperRifle_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${EF_R4_BeamSniperRifle_CD}s
addActionCooldownApplyToActions:Manual_EF_R4_BeamSniperRifle

[action_Manual_EF_HypeBazooka]
@copyFromSection:template_ManualWeapon
pos:5
text:Bazooka
text_zh:火箭筒
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Bazooka_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==false) and (self.resource().EquipmentIndex==1))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.EF_HypeBazooka_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false) and (self.resource().EquipmentIndex==1)))) and self.resource.EN>=${EF_HypeBazooka_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_HypeBazooka_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false) and (self.resource().EquipmentIndex==1)))) and self.resource.EN>=${EF_HypeBazooka_EN}
alsoTriggerAction:EF_HypeBazooka_Fire

[hiddenAction_EF_HypeBazooka_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_HypeBazooka_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.EF_HypeBazooka_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false) and (self.resource().EquipmentIndex==1)))) and self.resource.EN>=${EF_HypeBazooka_EN})
setUnitMemory:EF_HypeBazooka_CDTimer=self.timeAlive+${EF_HypeBazooka_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${EF_HypeBazooka_CD}s
addActionCooldownApplyToActions:Manual_EF_HypeBazooka

[action_Manual_EF_BeamSprayGun]
