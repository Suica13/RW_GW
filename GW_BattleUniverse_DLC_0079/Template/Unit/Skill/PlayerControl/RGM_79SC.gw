isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSprayGun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${EF_BeamSprayGun_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSprayGun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${EF_BeamSprayGun_EN}
alsoTriggerAction:EF_BeamSprayGun_Fire

[hiddenAction_EF_BeamSprayGun_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_BeamSprayGun_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.EF_BeamSprayGun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${EF_BeamSprayGun_EN})
setUnitMemory:EF_BeamSprayGun_CDTimer=self.timeAlive+${EF_BeamSprayGun_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
