requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_HandMS_L_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armLBreaked==false)))) and self.resource.EN>=${Common_HandMS_L_EN}
