[action_ManualShip_Beam]
@copyFromSection:template_ManualWeapon
pos:2
text:Beam cannon salvo [%{select(self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M1').hp>0 and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M1').attacking.hp>0 and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M1').readUnitMemory('MagellanClassLateType_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M1').resource.MagellanClassLateType_Turret_BeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M2').hp>0 and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M2').attacking.hp>0 and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M2').readUnitMemory('MagellanClassLateType_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M2').resource.MagellanClassLateType_Turret_BeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M3').hp>0 and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M3').attacking.hp>0 and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M3').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M3').readUnitMemory('MagellanClassLateType_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M3').resource.MagellanClassLateType_Turret_BeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_L1').hp>0 and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_L1').attacking.hp>0 and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_L1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_L1').readUnitMemory('MagellanClassLateType_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_L1').resource.MagellanClassLateType_Turret_BeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_R1').hp>0 and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_R1').attacking.hp>0 and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_R1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_R1').readUnitMemory('MagellanClassLateType_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_R1').resource.MagellanClassLateType_Turret_BeamCannon_ShootTimer>0,1,0)}/5]
text_zh:光束炮齐射 [%{select(self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M1').hp>0 and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M1').attacking.hp>0 and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M1').readUnitMemory('MagellanClassLateType_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M1').resource.MagellanClassLateType_Turret_BeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M2').hp>0 and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M2').attacking.hp>0 and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M2').readUnitMemory('MagellanClassLateType_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M2').resource.MagellanClassLateType_Turret_BeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M3').hp>0 and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M3').attacking.hp>0 and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M3').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M3').readUnitMemory('MagellanClassLateType_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M3').resource.MagellanClassLateType_Turret_BeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_L1').hp>0 and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_L1').attacking.hp>0 and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_L1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_L1').readUnitMemory('MagellanClassLateType_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_L1').resource.MagellanClassLateType_Turret_BeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_R1').hp>0 and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_R1').attacking.hp>0 and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_R1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_R1').readUnitMemory('MagellanClassLateType_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_R1').resource.MagellanClassLateType_Turret_BeamCannon_ShootTimer>0,1,0)}/5]
description:Order ready turrets with existing targets to fire. Each turret keeps its own target.
description_zh:命令已有瞄准目标的就绪炮位开火；各炮塔保持独立锁定，无目标、损坏或装填中的炮位跳过。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
isLocked:if not ${manualAuxiliaryReady} or ${onSkill} or (select(self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M1').hp>0 and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M1').attacking.hp>0 and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M1').readUnitMemory('MagellanClassLateType_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M1').resource.MagellanClassLateType_Turret_BeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M2').hp>0 and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M2').attacking.hp>0 and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M2').readUnitMemory('MagellanClassLateType_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M2').resource.MagellanClassLateType_Turret_BeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M3').hp>0 and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M3').attacking.hp>0 and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M3').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M3').readUnitMemory('MagellanClassLateType_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_M3').resource.MagellanClassLateType_Turret_BeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_L1').hp>0 and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_L1').attacking.hp>0 and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_L1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_L1').readUnitMemory('MagellanClassLateType_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_L1').resource.MagellanClassLateType_Turret_BeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_R1').hp>0 and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_R1').attacking.hp>0 and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_R1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_R1').readUnitMemory('MagellanClassLateType_Turret_BeamCannon_OnCD',type='bool') and self.attachment(slot='MagellanClassLateType_Turret_BeamCannon_R1').resource.MagellanClassLateType_Turret_BeamCannon_ShootTimer>0,1,0))<=0 or self.resource.EN<=0
