requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_90mmMG_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==0) and (memory.armRBreaked==false)))) and self.resource.EN>=${EF_90mmMG_EN}
