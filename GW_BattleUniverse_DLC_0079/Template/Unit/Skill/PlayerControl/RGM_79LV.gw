[core]
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_Common_Push_A_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60   and memory.armRBreaked==true)

[hiddenAction_Common_Push_A_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_BOWA_BeamGun_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and self.resource().EquipmentIndex==2 and memory.armRBreaked==false and eventData("RandomWeapon",type="float")>15)

[hiddenAction_EF_BOWA_BeamGun_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_HypeBazooka_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and self.resource().EquipmentIndex==1  and memory.armRBreaked==false and eventData("RandomWeapon",type="float")>15)

[hiddenAction_EF_HypeBazooka_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_90mmMG_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and self.resource().EquipmentIndex==0 and memory.armRBreaked==false and eventData("RandomWeapon",type="float")>15)

[hiddenAction_EF_90mmMG_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_90mmMG_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_Grenade_B_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and memory.attackMode==0 and memory.armRBreaked==false and eventData("RandomWeapon",type="float")<=15)

[hiddenAction_Common_Grenade_B_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_BeamSaber_BF_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60  and memory.armRBreaked==false)

[hiddenAction_EF_BeamSaber_BF_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_BeamSaber_BF_Fire_Step_5]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[action_Common_FullBoost_Trigger]
pos:65

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff

[action_Manual_Common_Push_A]
@copyFromSection:template_ManualWeapon
pos:4
text:Punch
text_zh:徒手格斗
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==true))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true))))
alsoTriggerAction:Common_Push_A_Fire

[hiddenAction_Common_Push_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
setUnitMemory:Common_Push_A_CDTimer=self.timeAlive+${Common_Push_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_Push_A_CD}s
addActionCooldownApplyToActions:Manual_Common_Push_A

[action_Manual_EF_BOWA_BeamGun]
@copyFromSection:template_ManualWeapon
pos:2
text:Beam cannon
text_zh:光束炮
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
isVisible:if ${manualControlReady} and ((((self.resource().EquipmentIndex==2) and (memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.EF_BOWA_BeamGun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==2) and (memory.armRBreaked==false)))) and self.resource.EN>=${EF_BOWA_BeamGun_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_BOWA_BeamGun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==2) and (memory.armRBreaked==false)))) and self.resource.EN>=${EF_BOWA_BeamGun_EN}
alsoTriggerAction:EF_BOWA_BeamGun_Fire

[hiddenAction_EF_BOWA_BeamGun_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_BOWA_BeamGun_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.EF_BOWA_BeamGun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==2) and (memory.armRBreaked==false)))) and self.resource.EN>=${EF_BOWA_BeamGun_EN})
setUnitMemory:EF_BOWA_BeamGun_CDTimer=self.timeAlive+${EF_BOWA_BeamGun_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${EF_BOWA_BeamGun_CD}s
addActionCooldownApplyToActions:Manual_EF_BOWA_BeamGun

[action_Manual_EF_HypeBazooka]
@copyFromSection:template_ManualWeapon
pos:5
text:Bazooka
text_zh:火箭筒
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Bazooka_1.png
isVisible:if ${manualControlReady} and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.EF_HypeBazooka_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false)))) and self.resource.EN>=${EF_HypeBazooka_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_HypeBazooka_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false)))) and self.resource.EN>=${EF_HypeBazooka_EN}
alsoTriggerAction:EF_HypeBazooka_Fire

[hiddenAction_EF_HypeBazooka_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_HypeBazooka_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.EF_HypeBazooka_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false)))) and self.resource.EN>=${EF_HypeBazooka_EN})
setUnitMemory:EF_HypeBazooka_CDTimer=self.timeAlive+${EF_HypeBazooka_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${EF_HypeBazooka_CD}s
addActionCooldownApplyToActions:Manual_EF_HypeBazooka

