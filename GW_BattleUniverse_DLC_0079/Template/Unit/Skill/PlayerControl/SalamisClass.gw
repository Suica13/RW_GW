text_zh:防空点射 [%{select(self.attachment(slot='SalamisClass_Turret_AA_L1').hp>0 and not self.attachment(slot='SalamisClass_Turret_AA_L1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClass_Turret_AA_L1').readUnitMemory('SalamisClass_Turret_AA_OnCD',type='bool') and self.attachment(slot='SalamisClass_Turret_AA_L1').resource.SalamisClass_Turret_AA_ShootTimer>0,1,0)+select(self.attachment(slot='SalamisClass_Turret_AA_R1').hp>0 and not self.attachment(slot='SalamisClass_Turret_AA_R1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClass_Turret_AA_R1').readUnitMemory('SalamisClass_Turret_AA_OnCD',type='bool') and self.attachment(slot='SalamisClass_Turret_AA_R1').resource.SalamisClass_Turret_AA_ShootTimer>0,1,0)+select(self.attachment(slot='SalamisClass_Turret_AA_L2').hp>0 and not self.attachment(slot='SalamisClass_Turret_AA_L2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClass_Turret_AA_L2').readUnitMemory('SalamisClass_Turret_AA_OnCD',type='bool') and self.attachment(slot='SalamisClass_Turret_AA_L2').resource.SalamisClass_Turret_AA_ShootTimer>0,1,0)+select(self.attachment(slot='SalamisClass_Turret_AA_R2').hp>0 and not self.attachment(slot='SalamisClass_Turret_AA_R2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClass_Turret_AA_R2').readUnitMemory('SalamisClass_Turret_AA_OnCD',type='bool') and self.attachment(slot='SalamisClass_Turret_AA_R2').resource.SalamisClass_Turret_AA_ShootTimer>0,1,0)+select(self.attachment(slot='SalamisClass_Turret_MG_L1').hp>0 and not self.attachment(slot='SalamisClass_Turret_MG_L1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClass_Turret_MG_L1').readUnitMemory('SalamisClass_Turret_MG_OnCD',type='bool') and self.attachment(slot='SalamisClass_Turret_MG_L1').resource.SalamisClass_Turret_MG_ShootTimer>0,1,0)+select(self.attachment(slot='SalamisClass_Turret_MG_R1').hp>0 and not self.attachment(slot='SalamisClass_Turret_MG_R1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClass_Turret_MG_R1').readUnitMemory('SalamisClass_Turret_MG_OnCD',type='bool') and self.attachment(slot='SalamisClass_Turret_MG_R1').resource.SalamisClass_Turret_MG_ShootTimer>0,1,0)}/6]
description:Order ready turrets to fire. Each turret aims at its own target; without a target it fires along its current barrel direction.
description_zh:命令就绪炮位开火；有目标时各自瞄准，无目标时沿炮塔当前朝向发射。损坏或装填中的炮位跳过。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Ciws_1.png
isLocked:if not ${manualAuxiliaryReady} or ${onSkill} or (select(self.attachment(slot='SalamisClass_Turret_AA_L1').hp>0 and not self.attachment(slot='SalamisClass_Turret_AA_L1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClass_Turret_AA_L1').readUnitMemory('SalamisClass_Turret_AA_OnCD',type='bool') and self.attachment(slot='SalamisClass_Turret_AA_L1').resource.SalamisClass_Turret_AA_ShootTimer>0,1,0)+select(self.attachment(slot='SalamisClass_Turret_AA_R1').hp>0 and not self.attachment(slot='SalamisClass_Turret_AA_R1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClass_Turret_AA_R1').readUnitMemory('SalamisClass_Turret_AA_OnCD',type='bool') and self.attachment(slot='SalamisClass_Turret_AA_R1').resource.SalamisClass_Turret_AA_ShootTimer>0,1,0)+select(self.attachment(slot='SalamisClass_Turret_AA_L2').hp>0 and not self.attachment(slot='SalamisClass_Turret_AA_L2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClass_Turret_AA_L2').readUnitMemory('SalamisClass_Turret_AA_OnCD',type='bool') and self.attachment(slot='SalamisClass_Turret_AA_L2').resource.SalamisClass_Turret_AA_ShootTimer>0,1,0)+select(self.attachment(slot='SalamisClass_Turret_AA_R2').hp>0 and not self.attachment(slot='SalamisClass_Turret_AA_R2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClass_Turret_AA_R2').readUnitMemory('SalamisClass_Turret_AA_OnCD',type='bool') and self.attachment(slot='SalamisClass_Turret_AA_R2').resource.SalamisClass_Turret_AA_ShootTimer>0,1,0)+select(self.attachment(slot='SalamisClass_Turret_MG_L1').hp>0 and not self.attachment(slot='SalamisClass_Turret_MG_L1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClass_Turret_MG_L1').readUnitMemory('SalamisClass_Turret_MG_OnCD',type='bool') and self.attachment(slot='SalamisClass_Turret_MG_L1').resource.SalamisClass_Turret_MG_ShootTimer>0,1,0)+select(self.attachment(slot='SalamisClass_Turret_MG_R1').hp>0 and not self.attachment(slot='SalamisClass_Turret_MG_R1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClass_Turret_MG_R1').readUnitMemory('SalamisClass_Turret_MG_OnCD',type='bool') and self.attachment(slot='SalamisClass_Turret_MG_R1').resource.SalamisClass_Turret_MG_ShootTimer>0,1,0))<=0 or self.resource.EN<=0
requireConditional:if ${manualAuxiliaryReady} and ${onSkill}==false
alsoTriggerAction:ManualShip_Send_SalamisClass_Turret_AA_L1,ManualShip_Send_SalamisClass_Turret_AA_R1,ManualShip_Send_SalamisClass_Turret_AA_L2,ManualShip_Send_SalamisClass_Turret_AA_R2,ManualShip_Send_SalamisClass_Turret_MG_L1,ManualShip_Send_SalamisClass_Turret_MG_R1

