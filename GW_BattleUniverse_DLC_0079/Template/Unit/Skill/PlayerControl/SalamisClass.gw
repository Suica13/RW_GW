text:Anti-aircraft burst [%{select(self.attachment(slot='SalamisClass_Turret_AA_L1').hp>0 and not self.attachment(slot='SalamisClass_Turret_AA_L1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClass_Turret_AA_L1').readUnitMemory('SalamisClass_Turret_AA_OnCD',type='bool') and self.attachment(slot='SalamisClass_Turret_AA_L1').resource.SalamisClass_Turret_AA_ShootTimer>0,1,0)+select(self.attachment(slot='SalamisClass_Turret_AA_R1').hp>0 and not self.attachment(slot='SalamisClass_Turret_AA_R1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClass_Turret_AA_R1').readUnitMemory('SalamisClass_Turret_AA_OnCD',type='bool') and self.attachment(slot='SalamisClass_Turret_AA_R1').resource.SalamisClass_Turret_AA_ShootTimer>0,1,0)+select(self.attachment(slot='SalamisClass_Turret_AA_L2').hp>0 and not self.attachment(slot='SalamisClass_Turret_AA_L2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClass_Turret_AA_L2').readUnitMemory('SalamisClass_Turret_AA_OnCD',type='bool') and self.attachment(slot='SalamisClass_Turret_AA_L2').resource.SalamisClass_Turret_AA_ShootTimer>0,1,0)+select(self.attachment(slot='SalamisClass_Turret_AA_R2').hp>0 and not self.attachment(slot='SalamisClass_Turret_AA_R2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClass_Turret_AA_R2').readUnitMemory('SalamisClass_Turret_AA_OnCD',type='bool') and self.attachment(slot='SalamisClass_Turret_AA_R2').resource.SalamisClass_Turret_AA_ShootTimer>0,1,0)+select(self.attachment(slot='SalamisClass_Turret_MG_L1').hp>0 and not self.attachment(slot='SalamisClass_Turret_MG_L1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='SalamisClass_Turret_MG_L1').readUnitMemory('SalamisClass_Turret_MG_OnCD',type='bool') and self.attachment(slot='SalamisClass_Turret_MG_L1').resource.SalamisClass_Turret_MG_ShootTimer>0,1,0)+select(self.attachment(slot='SalamisClass_Turret_MG_R1').hp>0 and not self.attachm