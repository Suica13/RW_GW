[hiddenAction_ManualShip_Send_U_Type_Submarine_Turret_MS_M2]
sendMessageTo:self.attachment(slot='U_Type_Submarine_Turret_MS_M2')
sendMessageWithTags:ManualShip_0087_Torpedo
sendMessageWithData:owner=self,controller=memory.manualControlHQ,serial=memory.manualVulcanSerial

[hiddenAction_ManualShip_Send_U_Type_Submarine_Turret_MS_M3]
sendMessageTo:self.attachment(slot='U_Type_Submarine_Turret_MS_M3')
sendMessageWithTags:ManualShip_0087_Torpedo
sendMessageWithData:owner=self,controller=memory.manualControlHQ,serial=memory.manualVulcanSerial

[action_ManualShip_Torpedo]
@copyFromSection:template_ManualWeapon
pos:2
text:Missile / torpedo salvo [%{select(self.attachment(slot='U_Type_Submarine_Turret_AMS_L1').hp>0 and self.attachment(slot='U_Type_Submarine_Turret_AMS_L1').attacking.hp>0 and not self.attachment(slot='U_Type_Submarine_Turret_AMS_L1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='U_Type_Submarine_Turret_AMS_L1').readUnitMemory('U_Type_Submarine_Turret_AMS_OnCD',type='bool') and self.attachment(slot='U_Type_Submarine_Turret_AMS_L1').resource.U_Type_Submarine_Turret_AMS_ShootTimer>0,1,0)+select(self.attachment(slot='U_Type_Submarine_Turret_AMS_R1').hp>0 and self.attachment(slot='U_Type_Submarine_Turret_AMS_R1').attacking.hp>0 and not self.attachment(slot='U_Type_Submarine_Turret_AMS_R1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='U_Type_Submarine_Turret_AMS_R1').readUnitMemory('U_Type_Submarine_Turret_AMS_OnCD',type='bool') and self.attachment(slot='U_Type_Submarine_Turret_AMS_R1').resource.U_Type_Submarine_Turret_AMS_ShootTimer>0,1,0)+select(self.attachment(slot='U_Type_Submarine_Turret_MS_M1').hp>0 and self.attachment(slot='U_Type_Submarine_Turret_MS_M1').attacking.hp>0 and not self.attachment(slot='U_Type_Submarine_Turret_MS_M1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='U_Type_Submarine_Turret_MS_M1').readUnitMemory('U_Type_Submarine_Turret_MS_OnCD',type='bool') and self.attachment(slot='U_Type_Submarine_Turret_MS_M1').resource.U_Type_Submarine_Turret_MS_ShootTimer>0,1,0)+select(self.attachment(slot='U_Type_Submarine_Turret_MS_M2').hp>0 and self.attachment(slot='U_Type_Submarine_Turret_MS_M2').attacking.hp>0 and not self.attachment(slot='U_Type_Submarine_Turret_MS_M2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='U_Type_Submarine_Turret_MS_M2').readUnitMemory('U_Type_Submarine_Turret_MS_OnCD',type='bool') and self.attachment(slot='U_Type_Submarine_Turret_MS_M2').resource.U_Type_Submarine_Turret_MS_ShootTimer>0,1,0)+select(self.attachment(slot='U_Type_Submarine_Turret_MS_M3').hp>0 and self.attachment(slot='U_Type_Submarine_Turret_MS_M3').attacking.hp>0 and not self.attachment(slot='U_Type_Submarine_Turret_MS_M3').readUnitMemory('breaked',type='bool') and not self.attachment(slot='U_Type_Submarine_Turret_MS_M3').readUnitMemory('U_Type_Submarine_Turret_MS_OnCD',type='bool') and self.attachment(slot='U_Type_Submarine_Turret_MS_M3').resource.U_Type_Submarine_Turret_MS_ShootTimer>0,1,0)}/5]
text_zh:导弹／鱼雷齐射 [%{select(self.attachment(slot='U_Type_Submarine_Turret_AMS_L1').hp>0 and self.attachment(slot='U_Type_Submarine_Turret_AMS_L1').attacking.hp>0 and not self.attachment(slot='U_Type_Submarine_Turret_AMS_L1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='U_Type_Submarine_Turret_AMS_L1').readUnitMemory('U_Type_Submarine_Turret_AMS_OnCD',type='bool') and self.attachment(slot='U_Type_Submarine_Turret_AMS_L1').resource.U_Type_Submarine_Turret_AMS_ShootTimer>0,1,0)+select(self.attachment(slot='U_Type_Submarine_Turret_AMS_R1').hp>0 and self.attachment(slot='U_Type_Submarine_Turret_AMS_R1').attacking.hp>0 and not self.attachment(slot='U_Type_Submarine_Turret_AMS_R1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='U_Type_Submarine_Turret_AMS_R1').readUnitMemory('U_Type_Submarine_Turret_AMS_OnCD',type='bool') and self.attachment(slot='U_Type_Submarine_Turret_AMS_R1').resource.U_Type_Submarine_Turret_AMS_ShootTimer>0,1,0)+select(self.attachment(slot='U_Type_Submarine_Turret_MS_M1').hp>0 and self.attachment(slot='U_Type_Submarine_Turret_MS_M1').attacking.hp>0 and not self.attachment(slot='U_Type_Submarine_Turret_MS_M1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='U_Type_Submarine_Turret_MS_M1').readUnitMemory('U_Type_Submarine_Turret_MS_OnCD',type='bool') and self.attachment(slot='U_Type_Submarine_Turret_MS_M1').resource.U_Type_Submarine_Turret_MS_ShootTimer>0,1,0)+select(self.attachment(slot='U_Type_Submarine_Turret_MS_M2').hp>0 and self.attachment(slot='U_Type_Submarine_Turret_MS_M2').attacking.hp>0 and not self.attachment(slot='U_Type_Submarine_Turret_MS_M2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='U_Type_Submarine_Turret_MS_M2').readUnitMemory('U_Type_Submarine_Turret_MS_OnCD',type='bool') and self.attachment(slot='U_Type_Submarine_Turret_MS_M2').resource.U_Type_Submarine_Turret_MS_ShootTimer>0,1,0)+select(self.attachment(slot='U_Type_Submarine_Turret_MS_M3').hp>0 and self.attachment(slot='U_Type_Submarine_Turret_MS_M3').attacking.hp>0 and not self.attachment(slot='U_Type_Submarine_Turret_MS_M3').readUnitMemory('breaked',type='bool') and not self.attachment(slot='U_Type_Submarine_Turret_MS_M3').readUnitMemory('U_Type_Submarine_Turret_MS_OnCD',type='bool') and self.attachment(slot='U_Type_Submarine_Turret_MS_M3').resource.U_Type_Submarine_Turret_MS_ShootTimer>0,1,0)}/5]
description:Order ready turrets with existing targets to fire. Each turret keeps its own target.
description_zh:命令已有瞄准目标的就绪炮位开火；各炮塔保持独立锁定，无目标、损坏或装填中的炮位跳过。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
isLocked:if not ${manualAuxiliaryReady} or ${onSkill} or (select(self.attachment(slot='U_Type_Submarine_Turret_AMS_L1').hp>0 and self.attachment(slot='U_Type_Submarine_Turret_AMS_L1').attacking.hp>0 and not self.attachment(slot='U_Type_Submarine_Turret_AMS_L1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='U_Type_Submarine_Turret_AMS_L1').readUnitMemory('U_Type_Submarine_Turret_AMS_OnCD',type='bool') and self.attachment(slot='U_Type_Submarine_Turret_AMS_L1').resource.U_Type_Submarine_Turret_AMS_ShootTimer>0,1,0)+select(self.attachment(slot='U_Type_Submarine_Turret_AMS_R1').hp>0 and self.attachment(slot='U_Type_Submarine_Turret_AMS_R1').attacking.hp>0 and not self.attachment(slot='U_Type_Submarine_Turret_AMS_R1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='U_Type_Submarine_Turret_AMS_R1').readUnitMemory('U_Type_Submarine_Turret_AMS_OnCD',type='bool') and self.attachment(slot='U_Type_Submarine_Turret_AMS_R1').resource.U_Type_Submarine_Turret_AMS_ShootTimer>0,1,0)+select(self.attachment(slot='U_Type_Submarine_Turret_MS_M1').hp>0 and self.attachment(slot='U_Type_Submarine_Turret_MS_M1').attacking.hp>0 and not self.attachment(slot='U_Type_Submarine_Turret_MS_M1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='U_Type_Submarine_Turret_MS_M1').readUnitMemory('U_Type_Submarine_Turret_MS_OnCD',type='bool') and self.attachment(slot='U_Type_Submarine_Turret_MS_M1').resource.U_Type_Submarine_Turret_MS_ShootTimer>0,1,0)+select(self.attachment(slot='U_Type_Submarine_Turret_MS_M2').hp>0 and self.attachment(slot='U_Type_Submarine_Turret_MS_M2').attacking.hp>0 and not self.attachment(slot='U_Type_Submarine_Turret_MS_M2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='U_Type_Submarine_Turret_MS_M2').readUnitMemory('U_Type_Submarine_Turret_MS_OnCD',type='bool') and self.attachment(slot='U_Type_Submarine_Turret_MS_M2').resource.U_Type_Submarine_Turret_MS_ShootTimer>0,1,0)+select(self.attachment(slot='U_Type_Submarine_Turret_MS_M3').hp>0 and self.attachment(slot='U_Type_Submarine_Turret_MS_M3').attacking.hp>0 and not self.attachment(slot='U_Type_Submarine_Turret_MS_M3').readUnitMemory('breaked',type='bool') and not self.attachment(slot='U_Type_Submarine_Turret_MS_M3').readUnitMemory('U_Type_Submarine_Turret_MS_OnCD',type='bool') and self.attachment(slot='U_Type_Submarine_Turret_MS_M3').resource.U_Type_Submarine_Turret_MS_ShootTimer>0,1,0))<=0 or self.resource.EN<=0
requireConditional:if ${manualAuxiliaryReady} and ${onSkill}==false
alsoTriggerAction:ManualShip_Send_U_Type_Submarine_Turret_AMS_L1,ManualShip_Send_U_Type_Submarine_Turret_AMS_R1,ManualShip_Send_U_Type_Submarine_Turret_MS_M1,ManualShip_Send_U_Type_Submarine_Turret_MS_M2,ManualShip_Send_U_Type_Submarine_Turret_MS_M3

[action_ManualShip_AA]
isVisible:false
requireConditional:false

