[core]
dont_load:true
@global manualControlImplemented=true
@memory manualShipArcGroup:float
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw,ROOT:Template/Unit/Skill/PlayerControl/Ships/Arcs_f0773f4179ab.gw

[action_LaunchAllUnits]
pos:82

[action_ChangeStyleB]
pos:80

[action_ChangeStyleA]
pos:80

[action_ManualShip_Beam]
isVisible:false
requireConditional:false

[action_ManualShip_Shell]
isVisible:false
requireConditional:false

[hiddenAction_ManualShip_Send_U_Type_Submarine_Turret_AMS_L1]
sendMessageTo:self.attachment(slot='U_Type_Submarine_Turret_AMS_L1')
sendMessageWithTags:ManualShip_0087_Torpedo
sendMessageWithData:owner=self,controller=memory.manualControlHQ,serial=memory.manualVulcanSerial

