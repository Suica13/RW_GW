[core]
dont_load:true
@global manualControlImplemented=true
@memory manualShipArcGroup:float
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw,ROOT:Template/Unit/Skill/PlayerControl/Ships/Arcs_3057f2db5540.gw

[action_LaunchAllUnits]
pos:82

[action_Common_FullBoost_Trigger]
pos:65

[action_Common_MinovskyParticle_M_Trigger]
pos:65

[action_Common_ReEntry_NeedBooster_Trigger]
pos:65

[hiddenAction_ManualShip_Send_GwazineClass_Turret_MegaBeamCannon_M1]
sendMessageTo:self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M1')
sendMessageWithTags:ManualShip_0087_Beam
sendMessageWithData:owner=self,controller=memory.manualControlHQ,serial=memory.manualVulcanSerial

[hiddenAction_ManualShip_Send_GwazineClass_Turret_MegaBeamCannon_M2]
sendMessageTo:self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M2')
sendMessageWithTags:ManualShip_0087_Beam
sendMessageWithData:owner=self,controller=memory.manualControlHQ,serial=memory.manualVulcanSerial

[hiddenAction_ManualShip_Send_GwazineClass_Turret_MegaBeamCannon_M3]
sendMessageTo:self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M3')
sendMessageWithTags:ManualShip_0087_Beam
sendMessageWithData:owner=self,controller=memory.manualControlHQ,serial=memory.manualVulcanSerial

[action_ManualShip_Beam]
@copyFromSection:template_ManualWeapon
pos:2
text:Beam cannon salvo [%{select(self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M1').hp>0 and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M1').readUnitMemory('GwazineClass_Turret_MegaBeamCannon_OnCD',type='bool') and self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M1').resource.GwazineClass_Turret_MegaBeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M2').hp>0 and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M2').readUnitMemory('GwazineClass_Turret_MegaBeamCannon_OnCD',type='bool') and self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M2').resource.GwazineClass_Turret_MegaBeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M3').hp>0 and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M3').readUnitMemory('breaked',type='bool') and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M3').readUnitMemory('GwazineClass_Turret_MegaBeamCannon_OnCD',type='bool') and self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M3').resource.GwazineClass_Turret_MegaBeamCannon_ShootTimer>0,1,0)}/3]
text_zh:光束炮齐射 [%{select(self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M1').hp>0 and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M1').readUnitMemory('GwazineClass_Turret_MegaBeamCannon_OnCD',type='bool') and self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M1').resource.GwazineClass_Turret_MegaBeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M2').hp>0 and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M2').readUnitMemory('GwazineClass_Turret_MegaBeamCannon_OnCD',type='bool') and self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M2').resource.GwazineClass_Turret_MegaBeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M3').hp>0 and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M3').readUnitMemory('breaked',type='bool') and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M3').readUnitMemory('GwazineClass_Turret_MegaBeamCannon_OnCD',type='bool') and self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M3').resource.GwazineClass_Turret_MegaBeamCannon_ShootTimer>0,1,0)}/3]
description:Order ready turrets to fire. Each turret aims at its own target; without a target it fires along its current barrel direction.
description_zh:命令就绪炮位开火；有目标时各自瞄准，无目标时沿炮塔当前朝向发射。损坏或装填中的炮位跳过。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
isLocked:if not ${manualAuxiliaryReady} or ${onSkill} or (select(self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M1').hp>0 and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M1').readUnitMemory('GwazineClass_Turret_MegaBeamCannon_OnCD',type='bool') and self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M1').resource.GwazineClass_Turret_MegaBeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M2').hp>0 and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M2').readUnitMemory('GwazineClass_Turret_MegaBeamCannon_OnCD',type='bool') and self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M2').resource.GwazineClass_Turret_MegaBeamCannon_ShootTimer>0,1,0)+select(self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M3').hp>0 and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M3').readUnitMemory('breaked',type='bool') and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M3').readUnitMemory('GwazineClass_Turret_MegaBeamCannon_OnCD',type='bool') and self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M3').resource.GwazineClass_Turret_MegaBeamCannon_ShootTimer>0,1,0))<=0 or self.resource.EN<=0
requireConditional:if ${manualAuxiliaryReady} and ${onSkill}==false
alsoTriggerAction:ManualShip_Send_GwazineClass_Turret_MegaBeamCannon_M1,ManualShip_Send_GwazineClass_Turret_MegaBeamCannon_M2,ManualShip_Send_GwazineClass_Turret_MegaBeamCannon_M3

