[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini





[hiddenAction_AutoProduce_GallopClass]
@copyFromSection:template_AutoProduce
@define UnitID=GallopClass
alsoTriggerAction:AutoProduce_GallopClass_Step2

[hiddenAction_AutoProduce_GallopClass_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2500
@define Resource=3500
alsoQueueAction:Produce_GallopClass



[action_Produce_GallopClass]
@copyFromSection:template_Produce_Fast
@define UnitID=GallopClass
@define Money=2500
@define Resource=3500
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:45s

alsoQueueAction:"""
Produce_GallopClass_1
