[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini





[hiddenAction_AutoProduce_FalmerClass]
@copyFromSection:template_AutoProduce
@define UnitID=FalmerClass
alsoTriggerAction:AutoProduce_FalmerClass_Step2

[hiddenAction_AutoProduce_FalmerClass_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3000
@define Resource=6000
alsoQueueAction:Produce_FalmerClass



[action_Produce_FalmerClass]
@copyFromSection:template_Produce_Fast
@define UnitID=FalmerClass
@define Money=3000
@define Resource=6000
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:55s

alsoQueueAction:"""
Produce_FalmerClass_1
