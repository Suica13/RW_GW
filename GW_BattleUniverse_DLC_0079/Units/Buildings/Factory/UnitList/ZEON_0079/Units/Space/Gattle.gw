[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini




[hiddenAction_AutoProduce_Gattle]
@copyFromSection:template_AutoProduce
@define UnitID=Gattle
alsoTriggerAction:AutoProduce_Gattle_Step2

[hiddenAction_AutoProduce_Gattle_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=300
@define Resource=500
alsoQueueAction:Produce_Gattle_StandardSquad



[action_Produce_Gattle_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=Gattle
@define Money=400
@define Resource=650
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:20s

alsoQueueAction:"""
Produce_Gattle_StandardSquad_1,
Produce_Gattle_StandardSquad_2,
Produce_Gattle_StandardSquad_3
"""
[hiddenAction_Produce_Gattle_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
Gattle*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_Gattle_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
Gattle*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_Gattle_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
Gattle*1(addResources=PilotType:1101|EquipmentIndex:0)
"""