[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_09R:bool


[hiddenAction_Pannel_Close_MS_09R]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_09R=false



[hiddenAction_AutoProduce_MS_09R]
@copyFromSection:template_AutoProduce
@define UnitID=MS_09R
alsoTriggerAction:AutoProduce_MS_09R_Step2

[hiddenAction_AutoProduce_MS_09R_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2000
@define Resource=2750
alsoTriggerAction:AutoProduce_MS_09R_Random



[hiddenAction_AutoProduce_MS_09R_Random]
alsoTriggerAction:"""
AutoProduce_MS_09R_Random_A,
AutoProduce_MS_09R_Random_B
"""
[hiddenAction_AutoProduce_MS_09R_Random_A]
requireConditional:"""
if memory.randomProduce<500
"""
