[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory EMS_10:bool


[hiddenAction_Pannel_Close_EMS_10]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:EMS_10=false



[hiddenAction_AutoProduce_EMS_10]
@copyFromSection:template_AutoProduce
@define UnitID=EMS_10
alsoTriggerAction:AutoProduce_EMS_10_Step2

[hiddenAction_AutoProduce_EMS_10_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1500
@define Resource=2000
alsoTriggerAction:AutoProduce_EMS_10_Random



[hiddenAction_AutoProduce_EMS_10_Random]
alsoTriggerAction:"""
AutoProduce_EMS_10_Random_A,
AutoProduce_EMS_10_Random_B
"""
[hiddenAction_AutoProduce_EMS_10_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_EMS_10_StandardSquad

[hiddenAction_AutoProduce_EMS_10_Random_B]
requireConditional:"""
if memory.randomProduce>500 
"""
alsoQueueAction:Produce_EMS_10_BazookaSquad


[action_Pannel_EMS_10]
@copyFromSection:template_Pannel
@define UnitID=EMS_10
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)


[action_Produce_EMS_10_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=EMS_10
@define Money=1500
@define Resource=2000
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:55s

alsoQueueAction:"""
Produce_EMS_10_StandardSquad_1,
Produce_EMS_10_StandardSquad_2,
Produce_EMS_10_StandardSquad_3
"""
[hiddenAction_Produce_EMS_10_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
EMS_10*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_EMS_10_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
EMS_10*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_EMS_10_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
EMS_10*1(addResources=PilotType:1101|EquipmentIndex:0)
"""



