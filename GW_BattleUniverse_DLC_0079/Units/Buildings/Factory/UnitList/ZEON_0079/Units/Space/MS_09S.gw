[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_09S:bool


[hiddenAction_Pannel_Close_MS_09S]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_09S=false



[hiddenAction_AutoProduce_MS_09S]
@copyFromSection:template_AutoProduce
@define UnitID=MS_09S
alsoTriggerAction:AutoProduce_MS_09S_Step2

[hiddenAction_AutoProduce_MS_09S_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2750
@define Resource=3200
alsoTriggerAction:AutoProduce_MS_09S_Random



[hiddenAction_AutoProduce_MS_09S_Random]
alsoTriggerAction:"""
AutoProduce_MS_09S_Random_A,
AutoProduce_MS_09S_Random_B
"""
[hiddenAction_AutoProduce_MS_09S_Random_A]
requireConditional:"""
if memory.randomProduce<500
"""
alsoQueueAction:Produce_MS_09S_StandardSquad

[hiddenAction_AutoProduce_MS_09S_Random_B]
requireConditional:"""
if memory.randomProduce>500
"""
alsoQueueAction:Produce_MS_09S_MGSquad




[action_Pannel_MS_09S]
@copyFromSection:template_Pannel
@define UnitID=MS_09S
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)


[action_Produce_MS_09S_StandardSquad]
