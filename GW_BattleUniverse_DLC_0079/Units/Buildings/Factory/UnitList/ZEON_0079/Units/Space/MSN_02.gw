[hiddenAction_AutoProduce_MSN_02]
@copyFromSection:template_AutoProduce
@define UnitID=MSN_02
alsoTriggerAction:AutoProduce_MSN_02_Step2

[hiddenAction_AutoProduce_MSN_02_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=4500
@define Resource=4500
alsoTriggerAction:AutoProduce_MSN_02_Random



[hiddenAction_AutoProduce_MSN_02_Random]
alsoTriggerAction:"""
AutoProduce_MSN_02_Random_A
