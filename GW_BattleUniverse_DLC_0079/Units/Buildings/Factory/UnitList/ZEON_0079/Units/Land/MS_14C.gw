[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_14C:bool


[hiddenAction_Pannel_Close_MS_14C]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_14C=false



[hiddenAction_AutoProduce_MS_14C]
@copyFromSection:template_AutoProduce
@define UnitID=MS_14C
alsoTriggerAction:AutoProduce_MS_14C_Step2

[hiddenAction_AutoProduce_MS_14C_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=4200
@define Resource=6500
alsoTriggerAction:AutoProduce_MS_14C_Random



[hiddenAction_AutoProduce_MS_14C_Random]
alsoTriggerAction:"""
AutoProduce_MS_14C_Random_A,
AutoProduce_MS_14C_Random_B
"""
[hiddenAction_AutoProduce_MS_14C_Random_A]
requireConditional:"""
if memory.randomProduce<500
"""
alsoQueueAction:Produce_MS_14C_StandardSquad

[hiddenAction_AutoProduce_MS_14C_Random_B]
requireConditional:"""
if memory.randomProduce>500
"""
alsoQueueAction:Produce_MS_14C_BazookaSquad




[action_Pannel_MS_14C]
@copyFromSection:template_Pannel
@define UnitID=MS_14C
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)


[action_Produce_MS_14C_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MS_14C
@define Money=4200
@define Resource=6500
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:75s

alsoQueueAction:"""
Produce_MS_14C_StandardSquad_1,
Produce_MS_14C_StandardSquad_2,
Produce_MS_14C_StandardSquad_3
"""
[hiddenAction_Produce_MS_14C_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_14C*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_14C_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
