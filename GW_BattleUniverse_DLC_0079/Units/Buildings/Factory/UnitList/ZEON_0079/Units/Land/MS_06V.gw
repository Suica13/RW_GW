[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini





[hiddenAction_AutoProduce_MS_06V]
@copyFromSection:template_AutoProduce
@define UnitID=MS_06V
alsoTriggerAction:AutoProduce_MS_06V_Step2

[hiddenAction_AutoProduce_MS_06V_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=750
@define Resource=1500
alsoQueueAction:Produce_MS_06V_StandardSquad



[action_Produce_MS_06V_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=MS_06V
@define Money=750
@define Resource=1500
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:55s

alsoQueueAction:"""
Produce_MS_06V_StandardSquad_1,
Produce_MS_06V_StandardSquad_2,
Produce_MS_06V_StandardSquad_3
"""
[hiddenAction_Produce_MS_06V_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_06V*1(addResources=PilotType:1001|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_06V_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MS_06V*1(addResources=PilotType:1001|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_06V_StandardSquad_3]
