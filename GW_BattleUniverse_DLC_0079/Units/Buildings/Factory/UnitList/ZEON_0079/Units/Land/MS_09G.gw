[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_09G:bool


[hiddenAction_Pannel_Close_MS_09G]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_09G=false



[hiddenAction_AutoProduce_MS_09G]
@copyFromSection:template_AutoProduce
@define UnitID=MS_09G
alsoTriggerAction:AutoProduce_MS_09G_Step2

[hiddenAction_AutoProduce_MS_09G_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3250
@define Resource=5250
alsoTriggerAction:AutoProduce_MS_09G_Random



[hiddenAction_AutoProduce_MS_09G_Random]
alsoTriggerAction:"""
AutoProduce_MS_09G_Random_A,
AutoProduce_MS_09G_Random_B
"""
[hiddenAction_AutoProduce_MS_09G_Random_A]
requireConditional:"""
if memory.randomProduce<500
"""
alsoQueueAction:Produce_MS_09G_StandardSquad

[hiddenAction_AutoProduce_MS_09G_Random_B]
requireConditional:"""
if memory.randomProduce>500
"""
alsoQueueAction:Produce_MS_09G_MGSquad




[action_Pannel_MS_09G]
@copyFromSection:template_Pannel
@define UnitID=MS_09G
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)


[action_Produce_MS_09G_StandardSquad]
