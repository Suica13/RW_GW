[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini





[hiddenAction_AutoProduce_MS_12]
@copyFromSection:template_AutoProduce
@define UnitID=MS_12
alsoTriggerAction:AutoProduce_MS_12_Step2

[hiddenAction_AutoProduce_MS_12_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1000
@define Resource=1350
alsoQueueAction:Produce_MS_12_StandardSquad



[action_Produce_MS_12_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=MS_12
@define Money=1000
@define Resource=1350
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:40s

alsoQueueAction:"""
Produce_MS_12_StandardSquad_1,
Produce_MS_12_StandardSquad_2,
Produce_MS_12_StandardSquad_3
"""
[hiddenAction_Produce_MS_12_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_12*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_12_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MS_12*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_12_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
MS_12*1(addResources=PilotType:1101|EquipmentIndex:0)
"""