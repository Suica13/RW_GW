[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_06S:bool


[hiddenAction_Pannel_Close_MS_06S]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_06S=false



[hiddenAction_AutoProduce_MS_06S]
@copyFromSection:template_AutoProduce
@define UnitID=MS_06S
alsoTriggerAction:AutoProduce_MS_06S_Step2

[hiddenAction_AutoProduce_MS_06S_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=450
@define Resource=600
alsoTriggerAction:AutoProduce_MS_06S_Random



[hiddenAction_AutoProduce_MS_06S_Random]
alsoTriggerAction:"""
AutoProduce_MS_06S_Random_A,
AutoProduce_MS_06S_Random_B
"""
[hiddenAction_AutoProduce_MS_06S_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MS_06S_StandardSquad

[hiddenAction_AutoProduce_MS_06S_Random_B]
requireConditional:"""
if memory.randomProduce>500 
"""
alsoQueueAction:Produce_MS_06S_BazookaSquad




[action_Pannel_MS_06S]
@copyFromSection:template_Pannel
@define UnitID=MS_06S
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png

[action_Produce_MS_06S_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MS_06S
@define Money=450
@define Resource=600
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:30s

text:MG
text_zh:机枪

alsoQueueAction:"""
Produce_MS_06S_StandardSquad_1
"""
[hiddenAction_Produce_MS_06S_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_06S*1(addResources=PilotType:1101|EquipmentIndex:0)
"""



[action_Produce_MS_06S_BazookaSquad]
@copyFromSection:template_Produce
@define UnitID=MS_06S
@define Money=450
@define Resource=800
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)

text:Bazooka
text_zh:火箭筒

buildSpeed:30s
alsoQueueAction:"""
Produce_MS_06S_BazookaSquad_1
"""
[hiddenAction_Produce_MS_06S_BazookaSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_06S*1(addResources=PilotType:1101|EquipmentIndex:1)
"""