[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_15B:bool


[hiddenAction_Pannel_Close_MS_15B]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_15B=false



[hiddenAction_AutoProduce_MS_15B]
@copyFromSection:template_AutoProduce
@define UnitID=MS_15B
alsoTriggerAction:AutoProduce_MS_15B_Step2

[hiddenAction_AutoProduce_MS_15B_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3750
@define Resource=5500
alsoTriggerAction:AutoProduce_MS_15B_Random



[hiddenAction_AutoProduce_MS_15B_Random]
alsoTriggerAction:"""
AutoProduce_MS_15B_Random_A
"""
[hiddenAction_AutoProduce_MS_15B_Random_A]
requireConditional:"""
if memory.randomProduce<1000
"""
alsoQueueAction:Produce_MS_15B_StandardSquad


[action_Produce_MS_15B_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=MS_15B
@define Money=3750
@define Resource=5500
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:70s

alsoQueueAction:"""
Produce_MS_15B_StandardSquad_1,
Produce_MS_15B_StandardSquad_2,
Produce_MS_15B_StandardSquad_3
"""
[hiddenAction_Produce_MS_15B_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_15B*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_15B_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MS_15B*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_15B_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
MS_15B*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
