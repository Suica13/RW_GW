[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini




[hiddenAction_AutoProduce_Cui]
@copyFromSection:template_AutoProduce
@define UnitID=Cui
alsoTriggerAction:AutoProduce_Cui_Step2

[hiddenAction_AutoProduce_Cui_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=150
@define Resource=250
alsoQueueAction:Produce_Cui_StandardSquad




[action_Produce_Cui_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=Cui
@define Money=150
@define Resource=250
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:20s

alsoQueueAction:"""
Produce_Cui_StandardSquad_1,
Produce_Cui_StandardSquad_2,
Produce_Cui_StandardSquad_3
"""
[hiddenAction_Produce_Cui_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
Cui*1(addResources=PilotType:1001|EquipmentIndex:0)
"""
[hiddenAction_Produce_Cui_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
Cui*1(addResources=PilotType:1001|EquipmentIndex:0)
"""
[hiddenAction_Produce_Cui_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
Cui*1(addResources=PilotType:1001|EquipmentIndex:0)
"""