[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_05:bool


[hiddenAction_Pannel_Close_MS_05]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_05=false



[hiddenAction_AutoProduce_MS_05]
@copyFromSection:template_AutoProduce
@define UnitID=MS_05
alsoTriggerAction:AutoProduce_MS_05_Step2

[hiddenAction_AutoProduce_MS_05_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=600
@define Resource=1200
alsoTriggerAction:AutoProduce_MS_05_Random

[hiddenAction_AutoProduce_MS_05_Random]
alsoTriggerAction:"""
AutoProduce_MS_05_Random_A,
AutoProduce_MS_05_Random_B
"""
[hiddenAction_AutoProduce_MS_05_Random_A]
requireConditional:if memory.randomProduce<=750
alsoQueueAction:Produce_MS_05_StandardSquad

[hiddenAction_AutoProduce_MS_05_Random_B]
requireConditional:if memory.randomProduce>750
alsoQueueAction:Produce_MS_05_BazookaSquad


[action_Pannel_MS_05]
@copyFromSection:template_Pannel
@define UnitID=MS_05
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)


[action_Produce_MS_05_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MS_05
@define Money=600
@define Resource=1250
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:40s

alsoQueueAction:"""
Produce_MS_05_StandardSquad_1,
Produce_MS_05_StandardSquad_2,
Produce_MS_05_StandardSquad_3
"""
[hiddenAction_Produce_MS_05_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_05*1(addResources=PilotType:1001|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_05_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MS_05*1(addResources=PilotType:1001|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_05_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
MS_05*1(addResources=PilotType:1001|EquipmentIndex:0)
"""



[action_Produce_MS_05_BazookaSquad]
@copyFromSection:template_Produce
@define UnitID=MS_05
@define Money=600
@define Resource=1850
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:40s

text:Bazooka Squad
text_zh:火箭筒小队

alsoQueueAction:"""
Produce_MS_05_BazookaSquad_1,
Produce_MS_05_BazookaSquad_2,
Produce_MS_05_BazookaSquad_3
"""
[hiddenAction_Produce_MS_05_BazookaSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_05*1(addResources=PilotType:1101|EquipmentIndex:1)
"""
[hiddenAction_Produce_MS_05_BazookaSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MS_05*1(addResources=PilotType:1101|EquipmentIndex:1)
"""
[hiddenAction_Produce_MS_05_BazookaSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
MS_05*1(addResources=PilotType:1101|EquipmentIndex:1)
"""