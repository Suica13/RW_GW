[hiddenAction_AutoProduce_MS_07B3]
@copyFromSection:template_AutoProduce
@define UnitID=MS_07B3
alsoTriggerAction:AutoProduce_MS_07B3_Step2

[hiddenAction_AutoProduce_MS_07B3_Step2]
