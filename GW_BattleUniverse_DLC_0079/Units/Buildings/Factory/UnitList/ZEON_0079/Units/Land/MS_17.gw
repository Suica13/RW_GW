[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_17:bool


[hiddenAction_Pannel_Close_MS_17]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_17=false



[hiddenAction_AutoProduce_MS_17]
@copyFromSection:template_AutoProduce
@define UnitID=MS_17
alsoTriggerAction:AutoProduce_MS_17_Step2

[hiddenAction_AutoProduce_MS_17_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=4250
@define Resource=5250
alsoTriggerAction:AutoProduce_MS_17_Random



[hiddenAction_AutoProduce_MS_17_Random]
alsoTriggerAction:"""
AutoProduce_MS_17_Random_A,
AutoProduce_MS_17_Random_B
"""
[hiddenAction_AutoProduce_MS_17_Random_A]
requireConditional:"""
if memory.randomProduce<500
"""
alsoQueueAction:Produce_MS_17_StandardSquad

[hiddenAction_AutoProduce_MS_17_Random_B]
requireConditional:"""
if memory.randomProduce>500
"""
alsoQueueAction:Produce_MS_17_BazookaSquad




[action_Pannel_MS_17]
@copyFromSection:template_Pannel
@define UnitID=MS_17
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)


[action_Produce_MS_17_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MS_17
@define Money=4250
@define Resource=5250
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:55s

alsoQueueAction:"""
Produce_MS_17_StandardSquad_1,
Produce_MS_17_StandardSquad_2,
Produce_MS_17_StandardSquad_3
"""
[hiddenAction_Produce_MS_17_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_17*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_17_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MS_17*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
