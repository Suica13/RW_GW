[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory MSM_10:bool


[hiddenAction_Pannel_Close_MSM_10]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MSM_10=false




[hiddenAction_AutoProduce_MSM_10]
@copyFromSection:template_AutoProduce
@define UnitID=MSM_10
alsoTriggerAction:AutoProduce_MSM_10_Step2

[hiddenAction_AutoProduce_MSM_10_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1500
@define Resource=2000
alsoTriggerAction:AutoProduce_MSM_10_Random



[hiddenAction_AutoProduce_MSM_10_Random]
alsoTriggerAction:"""
AutoProduce_MSM_10_Random_A
"""
[hiddenAction_AutoProduce_MSM_10_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MSM_10_StandardSquad




[action_Produce_MSM_10_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=MSM_10
@define Money=1500
@define Resource=2000
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:45s

alsoQueueAction:"""
Produce_MSM_10_StandardSquad_1
"""
[hiddenAction_Produce_MSM_10_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MSM_10*1(addResources=PilotType:1101|EquipmentIndex:0)
"""

