[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory MSM_08:bool


[hiddenAction_Pannel_Close_MSM_08]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MSM_08=false




[hiddenAction_AutoProduce_MSM_08]
@copyFromSection:template_AutoProduce
@define UnitID=MSM_08
alsoTriggerAction:AutoProduce_MSM_08_Step2

[hiddenAction_AutoProduce_MSM_08_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1850
@define Resource=1800
alsoTriggerAction:AutoProduce_MSM_08_Random



[hiddenAction_AutoProduce_MSM_08_Random]
alsoTriggerAction:"""
AutoProduce_MSM_08_Random_A
"""
[hiddenAction_AutoProduce_MSM_08_Random_A]
requireConditional:"""
if memory.randomProduce<=1000
"""
alsoQueueAction:Produce_MSM_08_StandardSquad




[action_Produce_MSM_08_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=MSM_08
@define Money=1850
@define Resource=2000
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:30s

alsoQueueAction:"""
Produce_MSM_08_StandardSquad_1
"""
[hiddenAction_Produce_MSM_08_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MSM_08*1(addResources=PilotType:1101|EquipmentIndex:0)
"""

