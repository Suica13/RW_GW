[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini





[hiddenAction_AutoProduce_MTank]
@copyFromSection:template_AutoProduce
@define UnitID=MTank
alsoTriggerAction:AutoProduce_MTank_Step2

[hiddenAction_AutoProduce_MTank_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=450
@define Resource=950
alsoQueueAction:Produce_MTank_StandardSquad



[action_Produce_MTank_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=MTank
@define Money=450
@define Resource=950
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:30s

alsoQueueAction:"""
Produce_MTank_StandardSquad_1,
Produce_MTank_StandardSquad_2,
Produce_MTank_StandardSquad_3
"""
[hiddenAction_Produce_MTank_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MTank*1(addResources=PilotType:1001|EquipmentIndex:0)
"""
[hiddenAction_Produce_MTank_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MTank*1(addResources=PilotType:1001|EquipmentIndex:0)
"""
[hiddenAction_Produce_MTank_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
MTank*1(addResources=PilotType:1001|EquipmentIndex:0)
"""