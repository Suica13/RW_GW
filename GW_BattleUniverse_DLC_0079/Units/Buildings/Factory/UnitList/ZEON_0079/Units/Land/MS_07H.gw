[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_07H:bool


[hiddenAction_Pannel_Close_MS_07H]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_07H=false



[hiddenAction_AutoProduce_MS_07H]
@copyFromSection:template_AutoProduce
@define UnitID=MS_07H
alsoTriggerAction:AutoProduce_MS_07H_Step2

[hiddenAction_AutoProduce_MS_07H_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2000
@define Resource=3000
alsoTriggerAction:AutoProduce_MS_07H_Random



[hiddenAction_AutoProduce_MS_07H_Random]
alsoTriggerAction:"""
AutoProduce_MS_07H_Random_A,
AutoProduce_MS_07H_Random_B
"""
[hiddenAction_AutoProduce_MS_07H_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MS_07H_StandardSquad

[hiddenAction_AutoProduce_MS_07H_Random_B]
requireConditional:"""
if memory.randomProduce>500 
"""
alsoQueueAction:Produce_MS_07H_BazookaSquad





[action_Pannel_MS_07H]
@copyFromSection:template_Pannel
@define UnitID=MS_07H
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)


[action_Produce_MS_07H_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=MS_07H
@define Money=1800
@define Resource=2800
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
buildSpeed:60s

alsoQueueAction:"""
Produce_MS_07H_StandardSquad_1,
Produce_MS_07H_StandardSquad_2,
Produce_MS_07H_StandardSquad_3
"""
[hiddenAction_Produce_MS_07H_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
MS_07H*1(addResources=PilotType:1001|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_07H_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
MS_07H*1(addResources=PilotType:1001|EquipmentIndex:0)
"""
[hiddenAction_Produce_MS_07H_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
MS_07H*1(addResources=PilotType:1001|EquipmentIndex:0)
"""



