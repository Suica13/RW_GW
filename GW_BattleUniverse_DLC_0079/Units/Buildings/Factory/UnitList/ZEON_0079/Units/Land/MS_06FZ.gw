[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_06FZ:bool


[hiddenAction_Pannel_Close_MS_06FZ]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_06FZ=false



[hiddenAction_AutoProduce_MS_06FZ]
@copyFromSection:template_AutoProduce
@define UnitID=MS_06FZ
alsoTriggerAction:AutoProduce_MS_06FZ_Step2

[hiddenAction_AutoProduce_MS_06FZ_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1750
@define Resource=2200
alsoTriggerAction:AutoProduce_MS_06FZ_Random



[hiddenAction_AutoProduce_MS_06FZ_Random]
alsoTriggerAction:"""
AutoProduce_MS_06FZ_Random_A,
AutoProduce_MS_06FZ_Random_B
"""
[hiddenAction_AutoProduce_MS_06FZ_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MS_06FZ_StandardSquad

[hiddenAction_AutoProduce_MS_06FZ_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_MS_06FZ_BazookaSquad


[action_Pannel_MS_06FZ]
