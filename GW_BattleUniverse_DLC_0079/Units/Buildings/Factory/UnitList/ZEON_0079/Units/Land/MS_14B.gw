[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_14B:bool


[hiddenAction_Pannel_Close_MS_14B]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_14B=false



[hiddenAction_AutoProduce_MS_14B]
@copyFromSection:template_AutoProduce
@define UnitID=MS_14B
alsoTriggerAction:AutoProduce_MS_14B_Step2

[hiddenAction_AutoProduce_MS_14B_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=3850
@define Resource=5650
alsoTriggerAction:AutoProduce_MS_14B_Random



[hiddenAction_AutoProduce_MS_14B_Random]
alsoTriggerAction:"""
AutoProduce_MS_14B_Random_A,
AutoProduce_MS_14B_Random_B
"""
[hiddenAction_AutoProduce_MS_14B_Random_A]
requireConditional:"""
if memory.randomProduce<500
"""
