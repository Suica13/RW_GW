[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory YMS_15E:bool


[hiddenAction_Pannel_Close_YMS_15E]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:YMS_15E=false




[hiddenAction_AutoProduce_YMS_15E]
@copyFromSection:template_AutoProduce
@define UnitID=YMS_15E
alsoTriggerAction:AutoProduce_YMS_15E_Step2

[hiddenAction_AutoProduce_YMS_15E_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2250
@define Resource=2550
alsoTriggerAction:AutoProduce_YMS_15E_Random



[hiddenAction_AutoProduce_YMS_15E_Random]
alsoTriggerAction:"""
AutoProduce_YMS_15E_Random_A
"""
[hiddenAction_AutoProduce_YMS_15E_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_YMS_15E_StandardSquad



[action_Produce_YMS_15E_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=YMS_15E
@define Money=2250
@define Resource=2550
@define FactionVisible= (memory.Pannel_ZEON_0079_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:45s

alsoQueueAction:"""
Produce_YMS_15E_StandardSquad_1
"""
[hiddenAction_Produce_YMS_15E_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
YMS_15E*1(addResources=PilotType:1101|EquipmentIndex:0)
"""

