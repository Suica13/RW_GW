[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini




[hiddenAction_AutoProduce_Gunperry]
@copyFromSection:template_AutoProduce
@define UnitID=Gunperry
alsoTriggerAction:AutoProduce_Gunperry_Step2

[hiddenAction_AutoProduce_Gunperry_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1500
@define Resource=2000
alsoQueueAction:Produce_Gunperry_StandardSquad



[action_Produce_Gunperry_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=Gunperry
@define Money=1500
@define Resource=2000
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:45s

alsoQueueAction:"""
Produce_Gunperry_StandardSquad_1
