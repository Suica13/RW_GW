@define UnitID=Medea
@define Money=500
@define Resource=1000
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
@define OtherVisible= (not self.globalTeamTags(includes='Unlock_MedeaKai'))
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:25s

alsoQueueAction:"""
Produce_Medea_StandardSquad_1
