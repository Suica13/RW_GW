[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGM_79_E:bool


[hiddenAction_Pannel_Close_RGM_79_E]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGM_79_E=false




[hiddenAction_AutoProduce_RGM_79_E]
@copyFromSection:template_AutoProduce
@define UnitID=RGM_79_E
alsoTriggerAction:AutoProduce_RGM_79_E_Step2

