@define Money=1750
@define Resource=2200
alsoTriggerAction:AutoProduce_RGM_79_E_Random



[hiddenAction_AutoProduce_RGM_79_E_Random]
alsoTriggerAction:"""
AutoProduce_RGM_79_E_Random_A,
AutoProduce_RGM_79_E_Random_B
"""
