@define UnitID=RB_79N
@define Money=350
@define Resource=750
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:30s

alsoQueueAction:"""
Produce_RB_79N_StandardSquad_1,
Produce_RB_79N_StandardSquad_2,
Produce_RB_79N_StandardSquad_3
"""
