[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini




[hiddenAction_AutoProduce_EF_TorpedoBoat]
@copyFromSection:template_AutoProduce
@define UnitID=EF_TorpedoBoat
alsoTriggerAction:AutoProduce_EF_TorpedoBoat_Step2

[hiddenAction_AutoProduce_EF_TorpedoBoat_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=350
@define Resource=650
alsoQueueAction:Produce_EF_TorpedoBoat_StandardSquad





[action_Produce_EF_TorpedoBoat_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=EF_TorpedoBoat
@define Money=350
@define Resource=650
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:25s

alsoQueueAction:"""
Produce_EF_TorpedoBoat_StandardSquad_1,
Produce_EF_TorpedoBoat_StandardSquad_2,
Produce_EF_TorpedoBoat_StandardSquad_3
"""
[hiddenAction_Produce_EF_TorpedoBoat_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
EF_TorpedoBoat*1(addResources=PilotType:1001|EquipmentIndex:0)
"""
[hiddenAction_Produce_EF_TorpedoBoat_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
EF_TorpedoBoat*1(addResources=PilotType:1001|EquipmentIndex:0)
"""
[hiddenAction_Produce_EF_TorpedoBoat_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
EF_TorpedoBoat*1(addResources=PilotType:1001|EquipmentIndex:0)
"""