[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini





[hiddenAction_AutoProduce_HimalayaClass]
@copyFromSection:template_AutoProduce
@define UnitID=HimalayaClass
alsoTriggerAction:AutoProduce_HimalayaClass_Step2

[hiddenAction_AutoProduce_HimalayaClass_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2500
@define Resource=5000
alsoQueueAction:Produce_HimalayaClass



[action_Produce_HimalayaClass]
@copyFromSection:template_Produce_Fast
@define UnitID=HimalayaClass
@define Money=2500
@define Resource=5000
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:60s

alsoQueueAction:"""
Produce_HimalayaClass_1
