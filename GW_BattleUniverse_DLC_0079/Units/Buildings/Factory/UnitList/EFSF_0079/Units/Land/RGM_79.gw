[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGM_79:bool


[hiddenAction_Pannel_Close_RGM_79]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGM_79=false




[hiddenAction_AutoProduce_RGM_79]
@copyFromSection:template_AutoProduce
@define UnitID=RGM_79
alsoTriggerAction:AutoProduce_RGM_79_Step2

[hiddenAction_AutoProduce_RGM_79_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1500
@define Resource=2050
alsoTriggerAction:AutoProduce_RGM_79_Random



[hiddenAction_AutoProduce_RGM_79_Random]
alsoTriggerAction:"""
AutoProduce_RGM_79_Random_A,
AutoProduce_RGM_79_Random_B,
AutoProduce_RGM_79_Random_C
"""
[hiddenAction_AutoProduce_RGM_79_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RGM_79_StandardSquad

[hiddenAction_AutoProduce_RGM_79_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RGM_79_BazookaSquad

[hiddenAction_AutoProduce_RGM_79_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_RGM_79_MGSquad





[action_Pannel_RGM_79]
@copyFromSection:template_Pannel
@define UnitID=RGM_79
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)

[action_Produce_RGM_79_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=RGM_79
@define Money=1950
@define Resource=3200
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:45s

alsoQueueAction:"""
Produce_RGM_79_StandardSquad_1,
Produce_RGM_79_StandardSquad_2,
Produce_RGM_79_StandardSquad_3
"""
[hiddenAction_Produce_RGM_79_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RGM_79*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RGM_79_StandardSquad_2]
buildSpeed:1.0s
highPriorityQueue:true
produceUnits:"""
RGM_79*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
[hiddenAction_Produce_RGM_79_StandardSquad_3]
buildSpeed:1.0s 
highPriorityQueue:true
produceUnits:"""
RGM_79*1(addResources=PilotType:1101|EquipmentIndex:0)
"""

