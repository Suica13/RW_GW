@define UnitID=Type61_SPG
@define Money=400
@define Resource=750
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:25s

alsoQueueAction:"""
Produce_Type61_SPG_StandardSquad_1,
Produce_Type61_SPG_StandardSquad_2,
Produce_Type61_SPG_StandardSquad_3
