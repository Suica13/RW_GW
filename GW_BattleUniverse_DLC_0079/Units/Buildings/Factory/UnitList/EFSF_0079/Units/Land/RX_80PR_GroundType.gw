alsoQueueAction:"""
Produce_RX_80PR_GroundType_StandardSquad_1
"""
[hiddenAction_Produce_RX_80PR_GroundType_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RX_80PR_GroundType*1(addResources=PilotType:3101|EquipmentIndex:0)
"""

