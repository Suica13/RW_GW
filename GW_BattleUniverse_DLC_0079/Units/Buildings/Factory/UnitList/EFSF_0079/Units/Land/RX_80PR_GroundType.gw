[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RX_80PR_GroundType:bool


[hiddenAction_Pannel_Close_RX_80PR_GroundType]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RX_80PR_GroundType=false




[hiddenAction_AutoProduce_RX_80PR_GroundType]
@copyFromSection:template_AutoProduce
@define UnitID=RX_80PR_GroundType
alsoTriggerAction:AutoProduce_RX_80PR_GroundType_Step2

[hiddenAction_AutoProduce_RX_80PR_GroundType_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2500
@define Resource=3500
alsoTriggerAction:AutoProduce_RX_80PR_GroundType_Random



[hiddenAction_AutoProduce_RX_80PR_GroundType_Random]
alsoTriggerAction:"""
AutoProduce_RX_80PR_GroundType_Random_A,
AutoProduce_RX_80PR_GroundType_Random_B
"""
[hiddenAction_AutoProduce_RX_80PR_GroundType_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RX_80PR_GroundType_StandardSquad

[hiddenAction_AutoProduce_RX_80PR_GroundType_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=1000
"""
alsoQueueAction:Produce_RX_80PR_GroundType_BeamRifleSquad



[action_Pannel_RX_80PR_GroundType]
@copyFromSection:template_Pannel
@define UnitID=RX_80PR_GroundType
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png

