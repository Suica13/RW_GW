[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RGM_79FD:bool


[hiddenAction_Pannel_Close_RGM_79FD]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RGM_79FD=false




[hiddenAction_AutoProduce_RGM_79FD]
@copyFromSection:template_AutoProduce
@define UnitID=RGM_79FD
alsoTriggerAction:AutoProduce_RGM_79FD_Step2

[hiddenAction_AutoProduce_RGM_79FD_Step2]
