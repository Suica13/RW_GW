@define Money=3750
@define Resource=4200
alsoTriggerAction:AutoProduce_RGM_79FD_Random



[hiddenAction_AutoProduce_RGM_79FD_Random]
alsoTriggerAction:"""
AutoProduce_RGM_79FD_Random_A,
AutoProduce_RGM_79FD_Random_B
"""
[hiddenAction_AutoProduce_RGM_79FD_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
