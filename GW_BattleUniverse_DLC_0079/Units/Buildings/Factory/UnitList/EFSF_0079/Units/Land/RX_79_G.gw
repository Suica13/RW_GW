[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RX_79_G:bool


[hiddenAction_Pannel_Close_RX_79_G]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RX_79_G=false




[hiddenAction_AutoProduce_RX_79_G]
@copyFromSection:template_AutoProduce
@define UnitID=RX_79_G
alsoTriggerAction:AutoProduce_RX_79_G_Step2

[hiddenAction_AutoProduce_RX_79_G_Step2]
