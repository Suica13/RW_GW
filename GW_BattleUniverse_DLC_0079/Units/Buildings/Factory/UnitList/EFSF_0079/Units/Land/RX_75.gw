[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RX_75:bool


[hiddenAction_Pannel_Close_RX_75]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RX_75=false




[hiddenAction_AutoProduce_RX_75]
@copyFromSection:template_AutoProduce
@define UnitID=RX_75
alsoTriggerAction:AutoProduce_RX_75_Step2

[hiddenAction_AutoProduce_RX_75_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1500
@define Resource=2800
alsoTriggerAction:AutoProduce_RX_75_Random



[hiddenAction_AutoProduce_RX_75_Random]
alsoTriggerAction:"""
AutoProduce_RX_75_Random_A
"""
[hiddenAction_AutoProduce_RX_75_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RX_75_StandardSquad



[action_Produce_RX_75_StandardSquad]
@copyFromSection:template_Produce_Fast
@define UnitID=RX_75
@define Money=1500
@define Resource=2800
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png
buildSpeed:45s

alsoQueueAction:"""
Produce_RX_75_StandardSquad_1
"""
[hiddenAction_Produce_RX_75_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RX_75*1(addResources=PilotType:1101|EquipmentIndex:0)
"""
