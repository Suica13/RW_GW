[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RX_78_1:bool


[hiddenAction_Pannel_Close_RX_78_1]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RX_78_1=false




[hiddenAction_AutoProduce_RX_78_1]
@copyFromSection:template_AutoProduce
@define UnitID=RX_78_1
alsoTriggerAction:AutoProduce_RX_78_1_Step2

[hiddenAction_AutoProduce_RX_78_1_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=2550
@define Resource=4000
alsoTriggerAction:AutoProduce_RX_78_1_Random



[hiddenAction_AutoProduce_RX_78_1_Random]
alsoTriggerAction:"""
AutoProduce_RX_78_1_Random_A,
AutoProduce_RX_78_1_Random_B,
AutoProduce_RX_78_1_Random_C
"""
[hiddenAction_AutoProduce_RX_78_1_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
