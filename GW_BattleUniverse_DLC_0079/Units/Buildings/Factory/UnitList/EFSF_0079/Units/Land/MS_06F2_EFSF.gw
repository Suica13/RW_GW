[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini

@memory MS_06F2_EFSF:bool


[hiddenAction_Pannel_Close_MS_06F2_EFSF]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:MS_06F2_EFSF=false



[hiddenAction_AutoProduce_MS_06F2_EFSF]
@copyFromSection:template_AutoProduce
@define UnitID=MS_06F2_EFSF
alsoTriggerAction:AutoProduce_MS_06F2_EFSF_Step2

[hiddenAction_AutoProduce_MS_06F2_EFSF_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1500
@define Resource=2000
alsoTriggerAction:AutoProduce_MS_06F2_EFSF_Random



[hiddenAction_AutoProduce_MS_06F2_EFSF_Random]
alsoTriggerAction:"""
AutoProduce_MS_06F2_EFSF_Random_A,
AutoProduce_MS_06F2_EFSF_Random_B,
AutoProduce_MS_06F2_EFSF_Random_C
"""
[hiddenAction_AutoProduce_MS_06F2_EFSF_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_MS_06F2_EFSF_StandardSquad

[hiddenAction_AutoProduce_MS_06F2_EFSF_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
