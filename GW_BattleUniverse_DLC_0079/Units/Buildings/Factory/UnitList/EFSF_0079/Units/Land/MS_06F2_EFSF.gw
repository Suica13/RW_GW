[hiddenAction_AutoProduce_MS_06F2_EFSF_Random_C]
requireConditional:"""
if memory.randomProduce>850
"""
alsoQueueAction:Produce_MS_06F2_EFSF_AntiAirSquad




[action_Pannel_MS_06F2_EFSF]
