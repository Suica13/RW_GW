[core]
copyFrom:ROOT:Units/Buildings/Factory/UnitList/Mod/UnitTemplate.ini


@memory RAG_79_G1:bool


[hiddenAction_Pannel_Close_RAG_79_G1]
autoTriggerOnEvent:newMessage(withTag="CloseAll")
setUnitMemory:RAG_79_G1=false




[hiddenAction_AutoProduce_RAG_79_G1]
@copyFromSection:template_AutoProduce
@define UnitID=RAG_79_G1
alsoTriggerAction:AutoProduce_RAG_79_G1_Step2

[hiddenAction_AutoProduce_RAG_79_G1_Step2]
@copyFromSection:template_AutoProduce_Step2
@define Money=1750
@define Resource=1950
alsoTriggerAction:AutoProduce_RAG_79_G1_Random



[hiddenAction_AutoProduce_RAG_79_G1_Random]
alsoTriggerAction:"""
AutoProduce_RAG_79_G1_Random_A,
AutoProduce_RAG_79_G1_Random_B
"""
[hiddenAction_AutoProduce_RAG_79_G1_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
alsoQueueAction:Produce_RAG_79_G1_StandardSquad

[hiddenAction_AutoProduce_RAG_79_G1_Random_B]
requireConditional:"""
if memory.randomProduce>500 
and memory.randomProduce<=850
"""
alsoQueueAction:Produce_RAG_79_G1_MSSquad




[action_Pannel_RAG_79_G1]
@copyFromSection:template_Pannel
@define UnitID=RAG_79_G1
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
iconExtraImage:ROOT:Resource/Image/Units/Button/Misc/SingleUnit_1.png

[action_Produce_RAG_79_G1_StandardSquad]
@copyFromSection:template_Produce
@define UnitID=RAG_79_G1
@define Money=1750
@define Resource=1950
@define FactionVisible= (memory.Pannel_EFSF_0079_DontShow==false)
buildSpeed:45s

alsoQueueAction:"""
Produce_RAG_79_G1_StandardSquad_1
"""
[hiddenAction_Produce_RAG_79_G1_StandardSquad_1]
buildSpeed:0.0s
highPriorityQueue:true
produceUnits:"""
RAG_79_G1*1(addResources=PilotType:1101|EquipmentIndex:0)
"""

