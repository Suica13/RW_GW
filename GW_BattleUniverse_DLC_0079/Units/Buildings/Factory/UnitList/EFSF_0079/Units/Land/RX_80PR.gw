[hiddenAction_AutoProduce_RX_80PR]
@copyFromSection:template_AutoProduce
@define UnitID=RX_80PR
alsoTriggerAction:AutoProduce_RX_80PR_Step2

[hiddenAction_AutoProduce_RX_80PR_Step2]
