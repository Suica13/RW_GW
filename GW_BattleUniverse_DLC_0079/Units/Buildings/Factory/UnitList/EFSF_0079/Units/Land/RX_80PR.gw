[hiddenAction_AutoProduce_RX_80PR_Random]
alsoTriggerAction:"""
AutoProduce_RX_80PR_Random_A,
AutoProduce_RX_80PR_Random_B
"""
[hiddenAction_AutoProduce_RX_80PR_Random_A]
requireConditional:"""
if memory.randomProduce<=500
"""
