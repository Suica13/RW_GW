@copyFromSection:template_ManualWeapon
pos:3
text:Missile / torpedo salvo [%{select(self.attachment(slot='MagellanClass_Turret_AMS_L1').hp>0 and not self.attachment(slot='MagellanClass_Turret_AMS_L1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MagellanClass_Turret_AMS_L1').readUnitMemory('MagellanClass_Turret_AMS_OnCD',type='bool') and self.attachment(slot='MagellanClass_Turret_AMS_L1').resource.MagellanClass_Turret_AMS_ShootTimer>0,1,0)+select(self.attachment(slot='MagellanClass_Turret_AMS_R1').hp>0 and not self.attachment(slot='MagellanClass_Turret_AMS_R1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='MagellanClass_Turret_AMS_R1').readUnitMemory('MagellanClass_Turret_AMS_OnCD',type='bool') and self.attachment(slot='MagellanClass_Turret_AMS_R1').resource.MagellanClass_Turret_AMS_ShootTimer>0,1,0)}/2]
