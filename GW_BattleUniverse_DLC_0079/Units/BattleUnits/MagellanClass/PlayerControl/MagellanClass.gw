[action_ManualShip_AA]
@copyFromSection:template_ManualWeapon
pos:4
text:Anti-air: %{select(memory.manualAutoAAOff,'OFF','ON')}
text_zh:防空炮：%{select(memory.manualAutoAAOff,'关闭','自动迎击')}
description:Toggle automatic interception by each anti-air turret. Native arcs, targets, energy, ammunition and reload are retained.
description_zh:开关各防空炮的自动迎击。保留各炮塔射界、索敌、能耗、弹药和装填。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Ciws_1.png
isLocked:false
requireConditional:if ${manualControlReady}
alsoTriggerAction:NONE
displayType:action
setUnitMemory:manualAutoAAOff=not memory.manualAutoAAOff

