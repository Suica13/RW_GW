[core]
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_Common_Push_A_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60   and memory.armRBreaked==true)

[hiddenAction_Common_Push_A_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_Shotgun_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and memory.armRBreaked==false and eventData("RandomWeapon",type="float")>50)

[hiddenAction_ZN_Shotgun_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_ArmGL_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and memory.armRBreaked==false and eventData("RandomWeapon",type="float")<=50 and eventData("RandomWeapon",type="float")>25)

[hiddenAction_Common_ArmGL_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_ArmGL_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MS_08TX_Kai_LegMS_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and not (    memory.legLBreaked==true     and     memory.legRBreaked==true) and eventData("RandomWeapon",type="float")<=25)

[hiddenAction_ZN_MS_08TX_Kai_LegMS_Fire_Step_2]
requireConditional:if (${cantAction}==false  and memory.legLBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MS_08TX_Kai_LegMS_Fire_Step_3]
requireConditional:if (${cantAction}==false  and memory.legRBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_HeatSword_Double_DBDF_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60 and not (    memory.armLBreaked==true     and     memory.armRBreaked==true) and eventData("RandomWeapon",type="float")>50)

[hiddenAction_ZN_HeatSword_Double_DBDF_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_HeatSword_Double_DBDF_Fire_Step_3]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_HeatSword_Double_DBDF_Fire_Step_6]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_HeatSword_Double_DBDF_Fire_Step_7]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_HeatSword_Double_DE_Fire_Step_3]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_HeatSword_Double_DE_Fire_Step_4]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_HeatSword_Double_DE_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60 and not (    memory.armLBreaked==true     and     memory.armRBreaked==true) and eventData("RandomWeapon",type="float")<50)

[action_EXAM]
pos:65

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff

[action_Manual_Common_Push_A]
@copyFromSection:template_ManualWeapon
pos:3
text:Punch
text_zh:徒手格斗
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==true))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true))))
alsoTriggerAction:Common_Push_A_Fire
displayType:action

[hiddenAction_Common_Push_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
setUnitMemory:Common_Push_A_CDTimer=self.timeAlive+${Common_Push_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_Push_A_CD}s
addActionCooldownApplyToActions:Manual_Common_Push_A

[action_Manual_ZN_Shotgun]
@copyFromSection:template_ManualWeapon
pos:2
text:Special weapon
text_zh:特殊武装
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_Shotgun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${ZN_Shotgun_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_Shotgun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${ZN_Shotgun_EN}
alsoTriggerAction:ZN_Shotgun_Fire
displayType:action

[hiddenAction_ZN_Shotgun_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_Shotgun_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_Shotgun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${ZN_Shotgun_EN})
setUnitMemory:ZN_Shotgun_CDTimer=self.timeAlive+${ZN_Shotgun_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZN_Shotgun_CD}s
addActionCooldownApplyToActions:Manual_ZN_Shotgun

[action_Manual_Common_ArmGL]
@copyFromSection:template_ManualWeapon
pos:4
text:Arm grenade launcher
text_zh:腕部榴弹
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmGL_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${Common_ArmGL_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmGL_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${Common_ArmGL_EN}
alsoTriggerAction:Common_ArmGL_Fire
displayType:action

[hiddenAction_Common_ArmGL_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_ArmGL_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_ArmGL_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armRBreaked==false)))) and self.resource.EN>=${Common_ArmGL_EN})
setUnitMemory:Common_ArmGL_CDTimer=self.timeAlive+${Common_ArmGL_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_ArmGL_CD}s
addActionCooldownApplyToActions:Manual_Common_ArmGL

[action_Manual_ZN_MS_08TX_Kai_LegMS]
@copyFromSection:template_ManualWeapon
pos:5
text:Missiles
text_zh:导弹
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
isVisible:if ${manualControlReady} and ((((not ((memory.legLBreaked==true) and (memory.legRBreaked==true))))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MS_08TX_Kai_LegMS_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((not ((memory.legLBreaked==true) and (memory.legRBreaked==true)))))) and self.resource.EN>=${ZN_MS_08TX_Kai_LegMS_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_MS_08TX_Kai_LegMS_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((not ((memory.legLBreaked==true) and (memory.legRBreaked==true)))))) and self.resource.EN>=${ZN_MS_08TX_Kai_LegMS_EN}
alsoTriggerAction:ZN_MS_08TX_Kai_LegMS_Fire
displayType:action

[hiddenAction_ZN_MS_08TX_Kai_LegMS_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_MS_08TX_Kai_LegMS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MS_08TX_Kai_LegMS_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((not ((memory.legLBreaked==true) and (memory.legRBreaked==true)))))) and self.resource.EN>=${ZN_MS_08TX_Kai_LegMS_EN})
setUnitMemory:ZN_MS_08TX_Kai_LegMS_CDTimer=self.timeAlive+${ZN_MS_08TX_Kai_LegMS_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZN_MS_08TX_Kai_LegMS_CD}s
addActionCooldownApplyToActions:Manual_ZN_MS_08TX_Kai_LegMS

