[core]
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_Common_MortarDouble_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false and ${onSkill}==false and memory.close==false and self.resource.EN>${Common_MortarDouble_EN} and self.timeAlive>memory.Common_MortarDouble_CDTimer and self.resource.TileMode==0 and self.parent.hp<=0  and memory.Common_MortarDouble_AimTarget.hp>0 and memory.Common_MortarDouble_AimTarget.teamID>=0 and not memory.Common_MortarDouble_AimTarget.tags(includes='UnDetected') and distanceBetween(self, memory.Common_MortarDouble_AimTarget)>=300)

[hiddenAction_Common_MortarDouble_Fire_Step_4]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_MortarDouble_Fire_Step_5]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_SmokingLauncher_NowPos_Fire_Step_1]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[action_Common_MortarDouble_Trigger]
pos:30
requireConditional:if (true) and (not memory.manualControlEnabled or ${manualWeaponReady})

[action_Common_SmokingLauncher_NowPos_Trigger]
pos:65

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff

[hiddenAction_TryAttack]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_AttackMode_Cqb_WhenHasTarget]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_ResetTargetTags_Step2]
alsoTriggerAction:ManualControl_AfterTransform,ManualControl_RestoreGuard

[action_ChangeAttackRuleMode_Free]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==0 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Guard]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==1 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Hold]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==2 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Shoot]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==0 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Cqb]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==1 and not self.hasTags(includes='inHangar'))

[action_AllowAIOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAI}==false and not self.hasTags(includes='inHangar'))

[action_AllowAssignedOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAssigned}==false and not self.hasTags(includes='inHangar'))

[turret_EF_RMV_1_Cannon]
canAttackCondition:if not memory.manualControlEnabled and (${onAttacking}==false and ${cantAction}==false and ${onSkill}==false and distanceBetween(self,self.attacking)>120)

[action_ManualTurret_EF_RMV_1_Cannon]
alsoTriggerAction:ManualTurret_EF_RMV_1_Cannon_Fire
requireConditional:if ${manualWeaponReady} and ((${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false)) and not memory.EF_RMV_1_Cannon_OnCD and self.resource.EF_RMV_1_Cannon_ShootTimer>0 and self.resource.EF_RMV_1_Cannon_ShootTimer>=1 and self.resource.en>=${EF_RMV_1_Cannon_EN}
isLocked:if not (${manualWeaponReady} and ((${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false)) and not memory.EF_RMV_1_Cannon_OnCD and self.resource.EF_RMV_1_Cannon_ShootTimer>0 and self.resource.EF_RMV_1_Cannon_ShootTimer>=1 and self.resource.en>=${EF_RMV_1_Cannon_EN})
isVisible:if ${manualControlReady}
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
description_zh:沿用原炮口、弹仓、EN消耗及装填。
text_zh:火炮
text:Cannon
pos:2
@copyFromSection:template_ManualWeapon
displayType:action

[turret_ManualTurret_EF_RMV_1_Cannon]
canShoot:false
@copyFromSection:turret_EF_RMV_1_Cannon

[hiddenAction_ManualTurret_EF_RMV_1_Cannon_Fire]
setUnitMemory:manualInputBusyUntil=self.timeAlive+0.15
addResources:EF_RMV_1_Cannon_ShootTimer=-1,en=-${EF_RMV_1_Cannon_EN}
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
fireTurretXAtGround:ManualTurret_EF_RMV_1_Cannon
requireConditional:if ${manualWeaponReady} and ((${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false)) and not memory.EF_RMV_1_Cannon_OnCD and self.resource.EF_RMV_1_Cannon_ShootTimer>0 and self.resource.EF_RMV_1_Cannon_ShootTimer>=1 and self.resource.en>=${EF_RMV_1_Cannon_EN}

[turret_EF_RMV_1_DoubleMS]
canAttackCondition:if not memory.manualControlEnabled and (${cantAction}==false  and ${onSkill}==false)

[action_ManualTurret_EF_RMV_1_DoubleMS]
alsoTriggerAction:ManualTurret_EF_RMV_1_DoubleMS_Fire
requireConditional:if ${manualWeaponReady} and ((${cantAction}==false) and (${onSkill}==false)) and not memory.EF_RMV_1_DoubleMS_OnCD and self.resource.EF_RMV_1_DoubleMS_ShootTimer>0 and self.resource.EF_RMV_1_DoubleMS_ShootTimer>=1 and self.resource.en>=${EF_RMV_1_DoubleMS_EN}
isLocked:if not (${manualWeaponReady} and ((${cantAction}==false) and (${onSkill}==false)) and not memory.EF_RMV_1_DoubleMS_OnCD and self.resource.EF_RMV_1_DoubleMS_ShootTimer>0 and self.resource.EF_RMV_1_DoubleMS_ShootTimer>=1 and self.resource.en>=${EF_RMV_1_DoubleMS_EN})
isVisible:if ${manualControlReady}
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamRifle_1.png
description_zh:沿用原炮口、弹仓、EN消耗及装填。
text_zh:武装 EF_RMV_1_DoubleMS
text:Weapon EF_RMV_1_DoubleMS
pos:5
@copyFromSection:template_ManualWeapon
displayType:action

[turret_ManualTurret_EF_RMV_1_DoubleMS]
canShoot:false
@copyFromSection:turret_EF_RMV_1_DoubleMS

[hiddenAction_ManualTurret_EF_RMV_1_DoubleMS_Fire]
setUnitMemory:manualInputBusyUntil=self.timeAlive+0.15
addResources:EF_RMV_1_DoubleMS_ShootTimer=-1,en=-${EF_RMV_1_DoubleMS_EN}
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
fireTurretXAtGround:ManualTurret_EF_RMV_1_DoubleMS
requireConditional:if ${manualWeaponReady} and ((${cantAction}==false) and (${onSkill}==false)) and not memory.EF_RMV_1_DoubleMS_OnCD and self.resource.EF_RMV_1_DoubleMS_ShootTimer>0 and self.resource.EF_RMV_1_DoubleMS_ShootTimer>=1 and self.resource.en>=${EF_RMV_1_DoubleMS_EN}
