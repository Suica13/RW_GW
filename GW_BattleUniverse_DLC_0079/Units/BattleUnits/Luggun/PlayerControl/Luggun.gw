[core]
dont_load:true
@global manualControlImplemented=true
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw
@memory manualVehicle_ZN_Luggun_AA_L_Left:float
@memory manualVehicle_ZN_Luggun_AA_L_Next:float
@memory manualVehicle_ZN_Luggun_AA_R_Left:float
@memory manualVehicle_ZN_Luggun_AA_R_Next:float

# Use native projectiles, costs, burst delays and reload actions; no weapon polling.

[hiddenAction_Common_DetectArea_On]
requireConditional:if (true) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_MinovskyParticle_S_Fire_Step_1]
requireConditional:if (true) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_Bomb_Luggun_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>=0  and distanceBetween(self,self.attacking)<=60 and not self.attacking.tags(includes='AirUnit'))

[hiddenAction_Common_Bomb_Luggun_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_Bomb_Luggun_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[action_Manual_Common_Bomb_Luggun]
@copyFromSection:template_ManualWeapon
pos:2
text:Bombs
text_zh:炸弹
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
isVisible:if ${manualControlReady} and ((true))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_Bomb_Luggun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${Common_Bomb_Luggun_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_Bomb_Luggun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${Common_Bomb_Luggun_EN}
alsoTriggerAction:Common_Bomb_Luggun_Fire

[hiddenAction_Common_Bomb_Luggun_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Bomb_Luggun_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  and self.attacking.hp>0 and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_Bomb_Luggun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${Common_Bomb_Luggun_EN})
setUnitMemory:Common_Bomb_Luggun_CDTimer=self.timeAlive+${Common_Bomb_Luggun_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_Bomb_Luggun_CD}s
addActionCooldownApplyToActions:Manual_Common_Bomb_Luggun

[turret_ZN_Luggun_AA_L]
canAttackCondition:if not memory.manualControlEnabled and (${onAttacking}==false and ${cantAction}==false)

[action_ManualVehicle_ZN_Luggun_AA_L]
temporarilyAddTags:inBattle
@copyFromSection:template_ManualWeapon
pos:4
text:Autocannon
text_zh:机炮
iconImage:ROOT:Resource/Image/Units/Button/Weapon/MachineGun_1.png
isLocked:if not (${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.ZN_Luggun_AA_ShootTimer>=1 and self.resource.en>=${ZN_Luggun_AA_EN} and memory.manualVehicle_ZN_Luggun_AA_L_Left<=0 and self.timeAlive>=memory.manualVehicle_ZN_Luggun_AA_L_Next)
requireConditional:if ${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.ZN_Luggun_AA_ShootTimer>=1 and self.resource.en>=${ZN_Luggun_AA_EN} and memory.manualVehicle_ZN_Luggun_AA_L_Left<=0 and self.timeAlive>=memory.manualVehicle_ZN_Luggun_AA_L_Next
setUnitMemory:manualVehicle_ZN_Luggun_AA_L_Left=max(1,int(self.resource.ZN_Luggun_AA_ShootTimer/(1)))
alsoTriggerAction:ManualVehicle_ZN_Luggun_AA_L_Shot,ManualVehicle_ZN_Luggun_AA_L_Continue,ManualVehicle_ZN_Luggun_AA_L_Stop

[hiddenAction_ManualVehicle_ZN_Luggun_AA_L_Shot]
addResources:ZN_Luggun_AA_ShootTimer=-1,en=-${ZN_Luggun_AA_EN}
requireConditional:if ${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.ZN_Luggun_AA_ShootTimer>=1 and self.resource.en>=${ZN_Luggun_AA_EN} and memory.manualVehicle_ZN_Luggun_AA_L_Left>0
fireTurretXAtGround:ZN_Luggun_AA_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
setUnitMemory:manualVehicle_ZN_Luggun_AA_L_Left=memory.manualVehicle_ZN_Luggun_AA_L_Left-1,manualVehicle_ZN_Luggun_AA_L_Next=self.timeAlive+0.1
alsoTriggerAction:Check_InBattle_Attack

[hiddenAction_ManualVehicle_ZN_Luggun_AA_L_Wait]
highPriorityQueue:false
allowMultipleInQueue:true
buildSpeed:0.1s
alsoTriggerAction:ManualVehicle_ZN_Luggun_AA_L_Shot,ManualVehicle_ZN_Luggun_AA_L_Continue,ManualVehicle_ZN_Luggun_AA_L_Stop

[hiddenAction_ManualVehicle_ZN_Luggun_AA_L_Continue]
requireConditional:if ${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.ZN_Luggun_AA_ShootTimer>=1 and self.resource.en>=${ZN_Luggun_AA_EN} and memory.manualVehicle_ZN_Luggun_AA_L_Left>0
alsoQueueAction:ManualVehicle_ZN_Luggun_AA_L_Wait

[hiddenAction_ManualVehicle_ZN_Luggun_AA_L_Stop]
requireConditional:if not (${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.ZN_Luggun_AA_ShootTimer>=1 and self.resource.en>=${ZN_Luggun_AA_EN}) or memory.manualVehicle_ZN_Luggun_AA_L_Left<=0
setUnitMemory:manualVehicle_ZN_Luggun_AA_L_Left=0

[turret_ZN_Luggun_AA_R]
canAttackCondition:if not memory.manualControlEnabled and (${onAttacking}==false and ${cantAction}==false)

[action_ManualVehicle_ZN_Luggun_AA_R]
temporarilyAddTags:inBattle
@copyFromSection:template_ManualWeapon
pos:5
text:Autocannon
text_zh:机炮
iconImage:ROOT:Resource/Image/Units/Button/Weapon/MachineGun_1.png
isLocked:if not (${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.ZN_Luggun_AA_ShootTimer>=1 and self.resource.en>=${ZN_Luggun_AA_EN} and memory.manualVehicle_ZN_Luggun_AA_R_Left<=0 and self.timeAlive>=memory.manualVehicle_ZN_Luggun_AA_R_Next)
requireConditional:if ${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.ZN_Luggun_AA_ShootTimer>=1 and self.resource.en>=${ZN_Luggun_AA_EN} and memory.manualVehicle_ZN_Luggun_AA_R_Left<=0 and self.timeAlive>=memory.manualVehicle_ZN_Luggun_AA_R_Next
setUnitMemory:manualVehicle_ZN_Luggun_AA_R_Left=max(1,int(self.resource.ZN_Luggun_AA_ShootTimer/(1)))
alsoTriggerAction:ManualVehicle_ZN_Luggun_AA_R_Shot,ManualVehicle_ZN_Luggun_AA_R_Continue,ManualVehicle_ZN_Luggun_AA_R_Stop

[hiddenAction_ManualVehicle_ZN_Luggun_AA_R_Shot]
addResources:ZN_Luggun_AA_ShootTimer=-1,en=-${ZN_Luggun_AA_EN}
requireConditional:if ${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.ZN_Luggun_AA_ShootTimer>=1 and self.resource.en>=${ZN_Luggun_AA_EN} and memory.manualVehicle_ZN_Luggun_AA_R_Left>0
fireTurretXAtGround:ZN_Luggun_AA_R
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
setUnitMemory:manualVehicle_ZN_Luggun_AA_R_Left=memory.manualVehicle_ZN_Luggun_AA_R_Left-1,manualVehicle_ZN_Luggun_AA_R_Next=self.timeAlive+0.1
alsoTriggerAction:Check_InBattle_Attack

[hiddenAction_ManualVehicle_ZN_Luggun_AA_R_Wait]
highPriorityQueue:false
allowMultipleInQueue:true
buildSpeed:0.1s
alsoTriggerAction:ManualVehicle_ZN_Luggun_AA_R_Shot,ManualVehicle_ZN_Luggun_AA_R_Continue,ManualVehicle_ZN_Luggun_AA_R_Stop

[hiddenAction_ManualVehicle_ZN_Luggun_AA_R_Continue]
requireConditional:if ${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.ZN_Luggun_AA_ShootTimer>=1 and self.resource.en>=${ZN_Luggun_AA_EN} and memory.manualVehicle_ZN_Luggun_AA_R_Left>0
alsoQueueAction:ManualVehicle_ZN_Luggun_AA_R_Wait

[hiddenAction_ManualVehicle_ZN_Luggun_AA_R_Stop]
requireConditional:if not (${manualAuxiliaryReady} and ((${onAttacking}==false) and (${cantAction}==false)) and self.resource.ZN_Luggun_AA_ShootTimer>=1 and self.resource.en>=${ZN_Luggun_AA_EN}) or memory.manualVehicle_ZN_Luggun_AA_R_Left<=0
setUnitMemory:manualVehicle_ZN_Luggun_AA_R_Left=0

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff
setUnitMemory:manualVehicle_ZN_Luggun_AA_L_Left=0,manualVehicle_ZN_Luggun_AA_R_Left=0

[action_Set_AttackMode_Shoot]
autoTrigger:false
isLocked:true
isVisible:if not memory.manualControlEnabled and (memory.attackMode==0 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Cqb]
autoTrigger:false
isLocked:true
isVisible:if not memory.manualControlEnabled and (memory.attackMode==1 and not self.hasTags(includes='inHangar'))
