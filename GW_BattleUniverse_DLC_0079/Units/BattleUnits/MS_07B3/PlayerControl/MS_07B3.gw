isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MS_07B3_Minigun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armLBreaked==false) and (self.shield>0)))) and self.resource.EN>=${ZN_MS_07B3_Minigun_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_MS_07B3_Minigun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armLBreaked==false) and (self.shield>0)))) and self.resource.EN>=${ZN_MS_07B3_Minigun_EN}
alsoTriggerAction:ZN_MS_07B3_Minigun_Fire
displayType:action

[hiddenAction_ZN_MS_07B3_Minigun_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_MS_07B3_Minigun_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MS_07B3_Minigun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.armLBreaked==false) and (self.shield>0)))) and self.resource.EN>=${ZN_MS_07B3_Minigun_EN})
setUnitMemory:ZN_MS_07B3_Minigun_CDTimer=self.timeAlive+${ZN_MS_07B3_Minigun_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
