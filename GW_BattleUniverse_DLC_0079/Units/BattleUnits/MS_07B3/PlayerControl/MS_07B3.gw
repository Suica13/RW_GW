isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MS_07B_HeatRod_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_MS_07B_HeatRod_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false))))
