[action_ManualShip_Torpedo]
@copyFromSection:template_ManualWeapon
pos:2
text:Missile / torpedo salvo [%{select(self.attachment(slot='M_Type_Submarine_Turret_AMS_L1').hp>0 and not self.attachment(slot='M_Type_Submarine_Turret_AMS_L1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='M_Type_Submarine_Turret_AMS_L1').readUnitMemory('M_Type_Submarine_Turret_AMS_OnCD',type='bool') and self.attachment(slot='M_Type_Submarine_Turret_AMS_L1').resource.M_Type_Submarine_Turret_AMS_ShootTimer>0,1,0)+select(self.attachment(slot='M_Type_Submarine_Turret_AMS_R1').hp>0 and not self.attachment(slot='M_Type_Submarine_Turret_AMS_R1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='M_Type_Submarine_Turret_AMS_R1').readUnitMemory('M_Type_Submarine_Turret_AMS_OnCD',type='bool') and self.attachment(slot='M_Type_Submarine_Turret_AMS_R1').resource.M_Type_Submarine_Turret_AMS_ShootTimer>0,1,0)+select(self.attachment(slot='M_Type_Submarine_Turret_AMS_L2').hp>0 and not self.attachment(slot='M_Type_Submarine_Turret_AMS_L2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='M_Type_Submarine_Turret_AMS_L2').readUnitMemory('M_Type_Submarine_Turret_AMS_OnCD',type='bool') and self.attachment(slot='M_Type_Submarine_Turret_AMS_L2').resource.M_Type_Submarine_Turret_AMS_ShootTimer>0,1,0)+select(self.attachment(slot='M_Type_Submarine_Turret_AMS_R2').hp>0 and not self.attachment(slot='M_Type_Submarine_Turret_AMS_R2').readUnitMemory('breaked',type='bool') and not self.attachment(slot='M_Type_Submarine_Turret_AMS_R2').readUnitMemory('M_Type_Submarine_Turret_AMS_OnCD',type='bool') and self.attachment(slot='M_Type_Submarine_Turret_AMS_R2').resource.M_Type_Submarine_Turret_AMS_ShootTimer>0,1,0)+select(self.attachment(slot='M_Type_Submarine_Turret_MS_M1').hp>0 and not self.attachment(slot='M_Type_Submarine_Turret_MS_M1').readUnitMemory('breaked',type='bool') and not self.attachment(slot='M_Type_Submarine_Turret_MS_M1').readUnitMemory('M_Type_Submarine_Turret_MS_OnCD',type='bool') and self.attachment(slot='M_Type_Submarine_Tur