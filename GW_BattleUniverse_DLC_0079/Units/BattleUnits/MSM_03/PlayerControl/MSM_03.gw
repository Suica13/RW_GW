[core]
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_Common_Push_A_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60   and memory.armRBreaked==true and memory.armLBreaked==true)

[hiddenAction_Common_Push_A_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MSM_03_ChestBeam_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange*0.75  and eventData("RandomWeapon",type="float")>50 and memory.backpackBreaked==false)

[hiddenAction_ZN_MSM_03_ChestBeam_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MSM_03_ChestBeam_Fire_Step_Sub]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MSM_03_SMS_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and eventData("RandomWeapon",type="float")<50 and memory.attackMode==0 and memory.backpackBreaked==false)

[hiddenAction_ZN_MSM_03_SMS_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MSM_03_SMS_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_Cqb_Double_A_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60 and not (    memory.armRBreaked==true     and     memory.armLBreaked==true ))

[hiddenAction_Common_Cqb_Double_A_Fire_Step_2]
requireConditional:if (${cantAction}==false and memory.armRBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_Cqb_Double_A_Fire_Step_3]
requireConditional:if (${cantAction}==false and memory.armLBreaked==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff

[action_Manual_Common_Push_A]
@copyFromSection:template_ManualWeapon
pos:4
text:Punch
text_zh:徒手格斗
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==true) and (memory.armLBreaked==true))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true) and (memory.armLBreaked==true)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true) and (memory.armLBreaked==true))))
alsoTriggerAction:Common_Push_A_Fire
displayType:action

[hiddenAction_Common_Push_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true) and (memory.armLBreaked==true)))))
setUnitMemory:Common_Push_A_CDTimer=self.timeAlive+${Common_Push_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_Push_A_CD}s
addActionCooldownApplyToActions:Manual_Common_Push_A

[action_Manual_ZN_MSM_03_ChestBeam]
@copyFromSection:template_ManualWeapon
pos:2
text:Chest beam cannon
text_zh:胸部光束炮
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
isVisible:if ${manualControlReady} and ((((memory.backpackBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MSM_03_ChestBeam_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.backpackBreaked==false)))) and self.resource.EN>=${ZN_MSM_03_ChestBeam_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_MSM_03_ChestBeam_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.backpackBreaked==false)))) and self.resource.EN>=${ZN_MSM_03_ChestBeam_EN}
alsoTriggerAction:ZN_MSM_03_ChestBeam_Fire
displayType:action

[hiddenAction_ZN_MSM_03_ChestBeam_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_MSM_03_ChestBeam_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MSM_03_ChestBeam_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((memory.backpackBreaked==false)))) and self.resource.EN>=${ZN_MSM_03_ChestBeam_EN})
setUnitMemory:ZN_MSM_03_ChestBeam_CDTimer=self.timeAlive+${ZN_MSM_03_ChestBeam_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZN_MSM_03_ChestBeam_CD}s
addActionCooldownApplyToActions:Manual_ZN_MSM_03_ChestBeam

[action_Manual_ZN_MSM_03_SMS]
@copyFromSection:template_ManualWeapon
pos:5
text:Missiles
text_zh:导弹
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
isVisible:if ${manualControlReady} and ((((memory.backpackBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MSM_03_SMS_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.backpackBreaked==false)))) and self.resource.EN>=${ZN_MSM_03_SMS_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_MSM_03_SMS_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.backpackBreaked==false)))) and self.resource.EN>=${ZN_MSM_03_SMS_EN}
alsoTriggerAction:ZN_MSM_03_SMS_Fire
displayType:action

[hiddenAction_ZN_MSM_03_SMS_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_MSM_03_SMS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MSM_03_SMS_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((memory.backpackBreaked==false)))) and self.resource.EN>=${ZN_MSM_03_SMS_EN})
setUnitMemory:ZN_MSM_03_SMS_CDTimer=self.timeAlive+${ZN_MSM_03_SMS_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZN_MSM_03_SMS_CD}s
addActionCooldownApplyToActions:Manual_ZN_MSM_03_SMS

[action_Manual_Common_Cqb_Double_A]
@copyFromSection:template_ManualWeapon
pos:3
text:Melee
text_zh:格斗攻击
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((not ((memory.armRBreaked==true) and (memory.armLBreaked==true))))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_Cqb_Double_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((not ((memory.armRBreaked==true) and (memory.armLBreaked==true)))))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_Cqb_Double_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((not ((memory.armRBreaked==true) and (memory.armLBreaked==true))))))
alsoTriggerAction:Common_Cqb_Double_A_Fire
displayType:action

[hiddenAction_Common_Cqb_Double_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Cqb_Double_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_Cqb_Double_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((not ((memory.armRBreaked==true) and (memory.armLBreaked==true)))))))
setUnitMemory:Common_Cqb_Double_A_CDTimer=self.timeAlive+${Common_Cqb_Double_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_Cqb_Double_A_CD}s
addActionCooldownApplyToActions:Manual_Common_Cqb_Double_A

[hiddenAction_TryAttack]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_AttackMode_Cqb_WhenHasTarget]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_LowPartsForceCqbMode]
requireConditional:if not memory.manualControlEnabled and (memory.attackMode==0 and memory.backpackBreaked==true)

[hiddenAction_ResetTargetTags_Step2]
alsoTriggerAction:ManualControl_AfterTransform,ManualControl_RestoreGuard

[action_ChangeAttackRuleMode_Free]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==0 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Guard]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==1 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Hold]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==2 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Shoot]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==0 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Cqb]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==1 and not self.hasTags(includes='inHangar'))

[action_AllowAIOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAI}==false and not self.hasTags(includes='inHangar'))

[action_AllowAssignedOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAssigned}==false and not self.hasTags(includes='inHangar'))
