[core]
@memory manualShipArcGroup:float
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw,ROOT:Units/BattleUnits/MAX_03/PlayerControl/Ships/Arcs_ceb3ac5ac8d1.gw

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_ZN_MAX_03_Leader_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false and ${onSkill}==false and memory.close==false and self.resource.EN>${ZN_MAX_03_Leader_EN} and self.timeAlive>memory.ZN_MAX_03_Leader_CDTimer and self.resource.TileMode==0 and self.parent.hp<=0  and memory.ZN_MAX_03_Leader_AimTarget.hp>0 and memory.ZN_MAX_03_Leader_AimTarget.teamID>=0 and not memory.ZN_MAX_03_Leader_AimTarget.tags(includes='UnDetected') and distanceBetween(self, memory.ZN_MAX_03_Leader_AimTarget)>=300)

[hiddenAction_ZN_MAX_03_Leader_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[action_ZN_MAX_03_Leader_Trigger]
pos:65
requireConditional:if (true) and (not memory.manualControlEnabled or ${manualWeaponReady})

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:ManualShip_HoldAll,SetOnSkillOff

