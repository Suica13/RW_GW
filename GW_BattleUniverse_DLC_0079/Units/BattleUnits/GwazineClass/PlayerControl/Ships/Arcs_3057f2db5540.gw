alpha:select(not self.attachment(slot='GwazineClass_Turret_AA_R5').readUnitMemory('GwazineClass_Turret_AA_OnCD',type='bool') and self.attachment(slot='GwazineClass_Turret_AA_R5').resource.GwazineClass_Turret_AA_ShootTimer>0,0.55,0.15)

