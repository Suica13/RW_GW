color:#66AAFF
isVisible:if ${manualControlReady} and memory.hideUI==0 and memory.manualShipArcGroup==0 and self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M1').hp>0 and not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M1').readUnitMemory('breaked',type='bool')
alpha:select(not self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M1').readUnitMemory('GwazineClass_Turret_MegaBeamCannon_OnCD',type='bool') and self.attachment(slot='GwazineClass_Turret_MegaBeamCannon_M1').resource.GwazineClass_Turret_MegaBeamCannon_ShootTimer>0,0.55,0.15)

