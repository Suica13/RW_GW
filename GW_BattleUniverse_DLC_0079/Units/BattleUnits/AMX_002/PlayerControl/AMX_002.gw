[core]
@memory manualShipArcGroup:float
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw,ROOT:Units/BattleUnits/AMX_002/PlayerControl/Ships/Arcs_ca903f18d424.gw

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_ZN_AMX_002_MegaBeamCannon_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false and ${onSkill}==false and self.timeAlive>memory.ZN_AMX_002_MegaBeamCannon_CDTimer and not self.hasTags(includes='inHangar') and not parent.hasTags(includes='SFS_Slot') and self.resource.en>${ZN_AMX_002_MegaBeamCannon_EN} and memory.ZN_AMX_002_MegaBeamCannon_AimTarget.hp>0)

[hiddenAction_ZN_AMX_002_MegaBeamCannon_Fire_Step_1]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_AMX_002_MegaBeamCannon_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_AMX_002_AntiShipMS_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_AMX_002_AntiShipMS_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_AMX_002_BeamCannon_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and eventData("RandomWeapon",type="float")>50)

[hiddenAction_ZN_AMX_002_BeamCannon_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_AMX_002_MS_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and eventData("RandomWeapon",type="float")<=50)

[hiddenAction_ZN_AMX_002_MS_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_AMX_002_MS_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_AMX_002_MS_Fire_Step_4]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_BeamSaber_Double_L_A_Fixed_AMX_002_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60)

[hiddenAction_EF_BeamSaber_Double_L_A_Fixed_AMX_002_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_EF_BeamSaber_Double_L_A_Fixed_AMX_002_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[action_ZN_AMX_002_MegaBeamCannon_Trigger]
pos:65
requireConditional:if (true) and (not memory.manualControlEnabled or ${manualWeaponReady})

[action_ZN_AMX_002_AntiShipMS_Trigger]
pos:65
requireConditional:if (true) and (not memory.manualControlEnabled or ${manualWeaponReady})

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:ManualShip_HoldAll,SetOnSkillOff

[action_Manual_ZN_AMX_002_BeamCannon]
@copyFromSection:template_ManualWeapon
pos:2
text:Beam cannon
text_zh:光束炮
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
isVisible:if ${manualControlReady} and ((true))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_AMX_002_BeamCannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${ZN_AMX_002_BeamCannon_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_AMX_002_BeamCannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${ZN_AMX_002_BeamCannon_EN}
alsoTriggerAction:ZN_AMX_002_BeamCannon_Fire
displayType:action

[hiddenAction_ZN_AMX_002_BeamCannon_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_AMX_002_BeamCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_AMX_002_BeamCannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((true)) and self.resource.EN>=${ZN_AMX_002_BeamCannon_EN})
setUnitMemory:ZN_AMX_002_BeamCannon_CDTimer=self.timeAlive+${ZN_AMX_002_BeamCannon_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZN_AMX_002_BeamCannon_CD}s
addActionCooldownApplyToActions:Manual_ZN_AMX_002_BeamCannon

