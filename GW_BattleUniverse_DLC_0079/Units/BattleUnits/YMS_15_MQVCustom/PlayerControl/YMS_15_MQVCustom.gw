requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_YMS_15_BeamSaber_B3_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false))))
alsoTriggerAction:ZN_YMS_15_BeamSaber_B3_Fire
displayType:action

[hiddenAction_ZN_YMS_15_BeamSaber_B3_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_YMS_15_BeamSaber_B3_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_YMS_15_BeamSaber_B3_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false)))))
setUnitMemory:ZN_YMS_15_BeamSaber_B3_CDTimer=self.timeAlive+${ZN_YMS_15_BeamSaber_B3_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
