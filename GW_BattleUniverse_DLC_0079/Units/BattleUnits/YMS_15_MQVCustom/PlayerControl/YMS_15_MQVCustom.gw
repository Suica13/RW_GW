[action_Manual_ZN_YMS_15_BeamSaber_F]
@copyFromSection:template_ManualWeapon
pos:5
text:Beam saber
text_zh:光束军刀
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==false) and (memory.pilotUnit.readUnitMemory("pilotCqbSkillFinal",type="float")>145))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_YMS_15_BeamSaber_F_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false) and (memory.pilotUnit.readUnitMemory("pilotCqbSkillFinal",type="float")>145)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_YMS_15_BeamSaber_F_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false) and (memory.pilotUnit.readUnitMemory("pilotCqbSkillFinal",type="float")>145))))
alsoTriggerAction:ZN_YMS_15_BeamSaber_F_Fire
displayType:action

[hiddenAction_ZN_YMS_15_BeamSaber_F_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_YMS_15_BeamSaber_F_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_YMS_15_BeamSaber_F_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false) and (memory.pilotUnit.readUnitMemory("pilotCqbSkillFinal",type="float")>145)))))
setUnitMemory:ZN_YMS_15_BeamSaber_F_CDTimer=self.timeAlive+${ZN_YMS_15_BeamSaber_F_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZN_YMS_15_BeamSaber_F_CD}s
addActionCooldownApplyToActions:Manual_ZN_YMS_15_BeamSaber_F

[hiddenAction_TryAttack]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_AttackMode_Cqb_WhenHasTarget]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_LowPartsForceCqbMode]
requireConditional:if not memory.manualControlEnabled and (memory.attackMode==0 and memory.armRBreaked==true)

[hiddenAction_ResetTargetTags_Step2]
alsoTriggerAction:ManualControl_AfterTransform,ManualControl_RestoreGuard

[action_ChangeAttackRuleMode_Free]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==0 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Guard]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==1 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Hold]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==2 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Shoot]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==0 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Cqb]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==1 and not self.hasTags(includes='inHangar'))

[action_AllowAIOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAI}==false and not self.hasTags(includes='inHangar'))

[action_AllowAssignedOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAssigned}==false and not self.hasTags(includes='inHangar'))
