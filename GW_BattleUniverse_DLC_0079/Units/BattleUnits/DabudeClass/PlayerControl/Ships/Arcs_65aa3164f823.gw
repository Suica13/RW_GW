color:#E6D28C
isVisible:if ${manualControlReady} and memory.hideUI==0 and memory.manualShipArcGroup==0 and self.attachment(slot='DabudeClass_Turret_Cannon_L1').hp>0 and not self.attachment(slot='DabudeClass_Turret_Cannon_L1').readUnitMemory('breaked',type='bool')
alpha:select(not self.attachment(slot='DabudeClass_Turret_Cannon_L1').readUnitMemory('DabudeClass_Turret_Cannon_OnCD',type='bool') and self.attachment(slot='DabudeClass_Turret_Cannon_L1').resource.DabudeClass_Turret_Cannon_ShootTimer>0,0.55,0.15)

