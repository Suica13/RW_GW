[action_Manual_EF_RTX_440_HandGun]
@copyFromSection:template_ManualWeapon
pos:5
text:Cannon
text_zh:火炮
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
isVisible:if ${manualControlReady} and ((((not ((memory.armRBreaked==true) and (memory.armLBreaked==true))))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.EF_RTX_440_HandGun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((not ((memory.armRBreaked==true) and (memory.armLBreaked==true)))))) and self.resource.EN>=${EF_RTX_440_HandGun_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_RTX_440_HandGun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((not ((memory.armRBreaked==true) and (memory.armLBreaked==true)))))) and self.resource.EN>=${EF_RTX_440_HandGun_EN}
alsoTriggerAction:EF_RTX_440_HandGun_Fire
displayType:action

[hiddenAction_EF_RTX_440_HandGun_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_RTX_440_HandGun_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.EF_RTX_440_HandGun_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((not ((memory.armRBreaked==true) and (memory.armLBreaked==true)))))) and self.resource.EN>=${EF_RTX_440_HandGun_EN})
setUnitMemory:EF_RTX_440_HandGun_CDTimer=self.timeAlive+${EF_RTX_440_HandGun_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${EF_RTX_440_HandGun_CD}s
addActionCooldownApplyToActions:Manual_EF_RTX_440_HandGun

[hiddenAction_TryAttack]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_AttackMode_Cqb_WhenHasTarget]
requireConditional:if not memory.manualControlEnabled and (true)

[hiddenAction_LowPartsForceCqbMode]
requireConditional:if not memory.manualControlEnabled and (false)

[hiddenAction_ResetTargetTags_Step2]
alsoTriggerAction:ManualControl_AfterTransform,ManualControl_RestoreGuard

[action_ChangeAttackRuleMode_Free]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==0 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Guard]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==1 and not self.hasTags(includes='inHangar'))

[action_ChangeAttackRuleMode_Hold]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackRuleMode==2 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Shoot]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==0 and not self.hasTags(includes='inHangar'))

[action_Set_AttackMode_Cqb]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (memory.attackMode==1 and not self.hasTags(includes='inHangar'))

[action_AllowAIOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAI}==false and not self.hasTags(includes='inHangar'))

[action_AllowAssignedOn]
requireConditional:if not memory.manualControlEnabled and (true)
isVisible:if not memory.manualControlEnabled and (${allowAssigned}==false and not self.hasTags(includes='inHangar'))

[action_ManualSpecial_Flamethrower]
alsoTriggerAction:EF_RTX_440_Flamethrower_B1_Trigger
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.EF_RTX_440_Flamethrower_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and self.resource.EN>=${EF_RTX_440_Flamethrower_EN}
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.EF_RTX_440_Flamethrower_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and self.resource.EN>=${EF_RTX_440_Flamethrower_EN})
isVisible:if ${manualControlReady}
iconImage:ROOT:Resource/Image/Units/Button/Weapon/MachineGun_1.png
description_zh:沿用原蓄力、连射、EN消耗及冷却。
text_zh:火焰喷射器
text:Flamethrower
pos:6
@copyFromSection:template_ManualWeapon
displayType:action

[hiddenAction_EF_RTX_440_Flamethrower_B1_Trigger]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.EF_RTX_440_Flamethrower_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.EF_RTX_440_Flamethrower_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and self.resource.EN>=${EF_RTX_440_Flamethrower_EN})

[action_ManualControl_FirstSlot]
isVisible:false
