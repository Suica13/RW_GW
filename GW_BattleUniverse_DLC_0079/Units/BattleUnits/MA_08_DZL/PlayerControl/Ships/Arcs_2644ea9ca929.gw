[core]
dont_load:true

[template_ManualShip_ArcLine]
layer:shadow
order:0
onlyTeam:own
onlyWhenSelectedByOwnPlayer:true
onlyOnNonPreview:true
onlyWhileAlive:true
lineWidth:1

[template_ManualShip_Arc_MA_08_Turret_BeamGun_M1_turret_MA_08_Turret_BeamGun]
@copyFromSection:template_ManualShip_ArcLine
color:#66AAFF
isVisible:if ${manualControlReady} and memory.hideUI==0 and memory.manualShipArcGroup==0 and self.attachment(slot='MA_08_Turret_BeamGun_M1').hp>0 and not self.attachment(slot='MA_08_Turret_BeamGun_M1').readUnitMemory('breaked',type='bool')
alpha:select(not self.attachment(slot='MA_08_Turret_BeamGun_M1').readUnitMemory('MA_08_Turret_BeamGun_OnCD',type='bool') and self.attachment(slot='MA_08_Turret_BeamGun_M1').resource.MA_08_Turret_BeamGun_ShootTimer>0,0.55,0.15)

