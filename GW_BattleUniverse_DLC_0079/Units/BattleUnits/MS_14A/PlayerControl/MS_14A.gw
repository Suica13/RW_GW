[core]
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_Common_Push_A_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60   and memory.armRBreaked==true)

[hiddenAction_Common_Push_A_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MS_14_BR_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and self.resource().EquipmentIndex==0 and memory.armRBreaked==false)

[hiddenAction_ZN_MS_14_BR_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_360mmBazooka_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and self.resource().EquipmentIndex==1  and memory.armRBreaked==false)

[hiddenAction_ZN_360mmBazooka_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MMP80MG_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>60  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and self.resource().EquipmentIndex==2 and memory.armRBreaked==false)

[hiddenAction_ZN_MMP80MG_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MMP80MG_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_TwinBeamSword_A_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=60   and memory.armRBreaked==false)

[hiddenAction_ZN_TwinBeamSword_A_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff

[action_Manual_Common_Push_A]
@copyFromSection:template_ManualWeapon
pos:4
text:Punch
text_zh:徒手格斗
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((((memory.armRBreaked==true))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true))))
alsoTriggerAction:Common_Push_A_Fire
displayType:action

[hiddenAction_Common_Push_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Push_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==true)))))
setUnitMemory:Common_Push_A_CDTimer=self.timeAlive+${Common_Push_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_Push_A_CD}s
addActionCooldownApplyToActions:Manual_Common_Push_A

[action_Manual_ZN_MS_14_BR]
@copyFromSection:template_ManualWeapon
pos:2
text:Missiles
text_zh:导弹
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_1.png
isVisible:if ${manualControlReady} and ((((self.resource().EquipmentIndex==0) and (memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MS_14_BR_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==0) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZN_MS_14_BR_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_MS_14_BR_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==0) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZN_MS_14_BR_EN}
alsoTriggerAction:ZN_MS_14_BR_Fire
displayType:action

[hiddenAction_ZN_MS_14_BR_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_MS_14_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MS_14_BR_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==0) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZN_MS_14_BR_EN})
setUnitMemory:ZN_MS_14_BR_CDTimer=self.timeAlive+${ZN_MS_14_BR_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZN_MS_14_BR_CD}s
addActionCooldownApplyToActions:Manual_ZN_MS_14_BR

[action_Manual_ZN_360mmBazooka]
@copyFromSection:template_ManualWeapon
pos:5
text:Bazooka
text_zh:火箭筒
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Bazooka_1.png
isVisible:if ${manualControlReady} and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_360mmBazooka_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZN_360mmBazooka_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_360mmBazooka_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZN_360mmBazooka_EN}
alsoTriggerAction:ZN_360mmBazooka_Fire
displayType:action

[hiddenAction_ZN_360mmBazooka_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_360mmBazooka_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_360mmBazooka_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZN_360mmBazooka_EN})
setUnitMemory:ZN_360mmBazooka_CDTimer=self.timeAlive+${ZN_360mmBazooka_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZN_360mmBazooka_CD}s
addActionCooldownApplyToActions:Manual_ZN_360mmBazooka

[action_Manual_ZN_MMP80MG]
