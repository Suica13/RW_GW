requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_4XMSL_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==2) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZN_4XMSL_EN}
alsoTriggerAction:ZN_4XMSL_Fire
displayType:action

[hiddenAction_ZN_4XMSL_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_4XMSL_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_4XMSL_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==2) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZN_4XMSL_EN})
setUnitMemory:ZN_4XMSL_CDTimer=self.timeAlive+${ZN_4XMSL_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
