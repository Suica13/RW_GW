isVisible:if ${manualControlReady} and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_270mmBazooka_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZN_270mmBazooka_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_270mmBazooka_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZN_270mmBazooka_EN}
alsoTriggerAction:ZN_270mmBazooka_Fire
displayType:action

[hiddenAction_ZN_270mmBazooka_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_270mmBazooka_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_270mmBazooka_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==1) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZN_270mmBazooka_EN})
setUnitMemory:ZN_270mmBazooka_CDTimer=self.timeAlive+${ZN_270mmBazooka_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZN_270mmBazooka_CD}s
addActionCooldownApplyToActions:Manual_ZN_270mmBazooka

