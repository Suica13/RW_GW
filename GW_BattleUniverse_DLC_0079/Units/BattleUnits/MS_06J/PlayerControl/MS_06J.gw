isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_HeatHawk_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false)))))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_HeatHawk_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false))))
alsoTriggerAction:ZN_HeatHawk_A_Fire
displayType:action

[hiddenAction_ZN_HeatHawk_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_HeatHawk_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_HeatHawk_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((((memory.armRBreaked==false)))))
