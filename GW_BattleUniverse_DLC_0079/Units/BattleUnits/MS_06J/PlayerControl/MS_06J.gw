isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MagellaCannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==2) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZN_MagellaCannon_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_MagellaCannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==2) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZN_MagellaCannon_EN}
