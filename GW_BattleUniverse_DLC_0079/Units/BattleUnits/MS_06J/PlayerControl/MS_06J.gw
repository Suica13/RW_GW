requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_MagellaCannon_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MagellaCannon_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (${onSkill}==false) and (self.resource.EN>0)) and ((((self.resource().EquipmentIndex==2) and (memory.armRBreaked==false)))) and self.resource.EN>=${ZN_MagellaCannon_EN})
