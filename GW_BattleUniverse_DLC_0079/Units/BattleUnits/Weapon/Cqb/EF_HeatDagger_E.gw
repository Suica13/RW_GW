[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Cqb/Common/Cqb_Fire_1_Yellow_R.gw,
ROOT:Resource/Image/Fx/Weapon/Cqb/Common/Cqb_Fire_1_Yellow_L.gw,
ROOT:Template\Unit\Animation\Cqb\Common_Melee_E.gw
"""

@memory EF_HeatDagger_E_CDTimer:float
@global EF_HeatDagger_E_CD=3.5



[decal_EF_HeatDagger_E]
layer:beforeBody
order:3.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Cqb\Image\EF_HeatDagger.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
imageScaleX:-1
xOffsetRelative:14
yOffsetRelative:13
dirOffset:115




[turret_EF_HeatDagger_E]
x:0
y:0
invisible:true

canShoot:false

showRangeUIGuide:false
projectile:EF_HeatDagger_E_Projectile

delay:3s
limitingMinRange:0
limitingRange:0

canAttackMaxAngle:60
barrelX:0
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\HeatHawk_1.ogg
shoot_sound_vol:0.5

[projectile_EF_HeatDagger_E_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Saber_S_A*1
(
    addResources=
    CqbDamage:2750
    |CqbShellDamage:2750
    |DpDamage:600
    |WeaponAccuracy:125
    |PartBreakModifier=0.75
    |CockpitBreakModifier=1.25
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightHitRange:35
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileLife:0.25
    |ProjectileAttackTimes:1
)
"""
[projectile_EF_HeatDagger_E_2_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Saber_S_A_L*1
(
    addResources=
    CqbDamage:2750
    |CqbShellDamage:2750
    |DpDamage:600
    |WeaponAccuracy:125
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightHitRange:35
    |ProjectileSpeed:0
    |ProjectileSpread:0
    |ProjectileLife:0.25
    |ProjectileAttackTimes:1
)
"""







[hiddenAction_EF_HeatDagger_E_Trigger]
alsoTriggerAction:EF_HeatDagger_E_Fire
[hiddenAction_EF_HeatDagger_E_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_HeatDagger_E_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) 
and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50
"""
setUnitMemory:EF_HeatDagger_E_CDTimer=self.timeAlive+${EF_HeatDagger_E_CD}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Cqb,
EF_HeatDagger_E_B_SetWeaponIndex,
PlayCommon_Melee_E_Step_1,
EF_HeatDagger_E_Step_1
"""
[hiddenAction_EF_HeatDagger_E_Step_1]
alsoQueueAction:"""
EF_HeatDagger_E_Fire_Step_1,
EF_HeatDagger_E_Fire_Step_2,
EF_HeatDagger_E_Fire_Step_3,
EF_HeatDagger_E_Fire_Step_4,
EF_HeatDagger_E_Fire_Step_Final
"""







[hiddenAction_EF_HeatDagger_E_B_SetWeaponIndex]
isVisible:false
[hiddenAction_EF_HeatDagger_E_F_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_HeatDagger_E_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_EF_HeatDagger_E_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_HeatDagger_E
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_1_Yellow_R
[hiddenAction_EF_HeatDagger_E_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
alsoTriggerAction:EF_HeatDagger_E_F_SetWeaponIndex
[hiddenAction_EF_HeatDagger_E_Fire_Step_4]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_HeatDagger_E
fireTurretXAtGround_withProjectile:EF_HeatDagger_E_2_Projectile
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
spawnEffects:Cqb_Fire_1_Yellow_L
[hiddenAction_EF_HeatDagger_E_Fire_Step_Final]
buildSpeed:1.4s
alsoTriggerAction:SetAttackingOff

