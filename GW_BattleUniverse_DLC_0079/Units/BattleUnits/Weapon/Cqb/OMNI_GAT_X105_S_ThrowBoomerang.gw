[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Light_1.gw,
ROOT:Resource/Image/Fx/Weapon/Cqb/Common/Cqb_Fire_1_Pink_L.gw,
ROOT:Template\Unit\Animation\Cqb\Common_Melee_F.gw
"""

@memory OMNI_GAT_X105_S_ThrowBoomerang_CDTimer:float
@global OMNI_GAT_X105_S_ThrowBoomerang_CD=4.5
@global OMNI_GAT_X105_S_ThrowBoomerang_EN=55

@memory OMNI_GAT_X105_S_ThrowBoomerang_Unit:unit


[hiddenAction_Get_Spawn_OMNI_GAT_X105_S_ThrowBoomerang_Unit]
autoTriggerOnEvent:newMessage(withTag="Cqb_Boomerang_OMNI_GAT_X105_S_ThrowBoomerang")
setUnitMemory:OMNI_GAT_X105_S_ThrowBoomerang_Unit=eventData("unitInfo",type="unit")






[turret_OMNI_GAT_X105_S_ThrowBoomerang]
x:0
y:0

canShoot:false
projectile:OMNI_GAT_X105_S_ThrowBoomerang_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:0
barrelY:0
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/Throw_1.ogg
shoot_sound_vol:0.4



[projectile_OMNI_GAT_X105_S_ThrowBoomerang_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_OMNI_GAT_X105_S_ThrowBoomerang*1
(
    addResources=
    CqbDamage:3000
    |CqbBeamDamage:3000
    |DpDamage:350
    |WeaponAccuracy=75
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:30
    |ProjectileTurnspeed:1.5
    |ProjectileSpread:1
    |ProjectileExplosionRange:35
    |ProjectileLife:35

    |ProjectileAttackTimes:3
    |ProjectileAttackTimesDamageModifier:0.75
)
"""








[hiddenAction_OMNI_GAT_X105_S_ThrowBoomerang_Trigger]
alsoTriggerAction:OMNI_GAT_X105_S_ThrowBoomerang_Fire
[hiddenAction_OMNI_GAT_X105_S_ThrowBoomerang_Fire]
requireConditional:"""
if self.timeAlive>memory.OMNI_GAT_X105_S_ThrowBoomerang_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:OMNI_GAT_X105_S_ThrowBoomerang_CDTimer=self.timeAlive+${OMNI_GAT_X105_S_ThrowBoomerang_CD}
addResources:EN=-${OMNI_GAT_X105_S_ThrowBoomerang_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
OMNI_GAT_X105_S_ThrowBoomerang_SetWeaponIndex,
PlayCommon_Melee_F_Step_1,
OMNI_GAT_X105_S_ThrowBoomerang_B1_Step_1
"""
[hiddenAction_OMNI_GAT_X105_S_ThrowBoomerang_B1_Step_1]
alsoQueueAction:"""
OMNI_GAT_X105_S_ThrowBoomerang_Fire_Step_1,
OMNI_GAT_X105_S_ThrowBoomerang_Fire_Step_2,
OMNI_GAT_X105_S_ThrowBoomerang_Fire_Step_Final
"""




[hiddenAction_OMNI_GAT_X105_S_ThrowBoomerang_SetWeaponIndex]
isVisible:false


[hiddenAction_OMNI_GAT_X105_S_ThrowBoomerang_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_OMNI_GAT_X105_S_ThrowBoomerang_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:OMNI_GAT_X105_S_ThrowBoomerang
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_OMNI_GAT_X105_S_ThrowBoomerang_Fire_Step_Final]
buildSpeed:0.15s
alsoTriggerAction:SetAttackingOff


