[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw
"""

@memory ZN_APC_MG_OnCD:bool
@memory ZN_APC_MG_CDTimer:float
@global ZN_APC_MG_CD=2
@global ZN_APC_MG_EN=0.5

@global ZN_APC_MG_Shoot=12
[resource_ZN_APC_MG_ShootTimer]
hidden:true








[turret_ZN_APC_MG]
x:0
y:3.5

canShoot:true
canAttackCondition:"""
if ${onAttacking}==false and ${cantAction}==false 
"""
showRangeUIGuide:false
projectile:ZN_APC_MG_Projectile
resourceUsage:ZN_APC_MG_ShootTimer=1,en=${ZN_APC_MG_EN}

delay:0.1s
canAttackMaxAngle:3
barrelX:0
barrelY:5
turnSpeed:2.5

aimOffsetSpread:0
recoilOffset:0
recoilOutTime:0
recoilReturnTime:0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_2.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1

idleSweepAngle:15
idleSweepAddRandomAngle:10
idleSweepDelay:240
idleSweepAddRandomDelay:120
idleSweepSpeed:0.25
idleSweepCondition:if memory.close==false

[projectile_ZN_APC_MG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Vulcan*1
(
    addResources=
    ShellDamage:65 
    |DpDamage:5
    |WeaponAccuracy=125
    |PartBreakModifier=0.5
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=1
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=1
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1.5
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:85
    |ProjectileSpread:4
    |ProjectileLife:20
)
"""


[hiddenAction_ZN_APC_MG_CDStart]
autoTrigger:"""
if memory.ZN_APC_MG_OnCD==false 
and 
(
    (
        self.resource.ZN_APC_MG_ShootTimer<=0 
    ) 
    or 
    (
        self.resource.ZN_APC_MG_ShootTimer<${ZN_APC_MG_Shoot} and not self.hasTags(includes='inBattle')
    )
)
"""
setUnitMemory:ZN_APC_MG_OnCD=true,ZN_APC_MG_CDTimer=self.timeAlive+${ZN_APC_MG_CD}

[hiddenAction_ZN_APC_MG_CDEnd]
autoTriggerOnEvent:created
autoTrigger:if memory.ZN_APC_MG_OnCD==true and self.timeAlive>memory.ZN_APC_MG_CDTimer
setUnitMemory:ZN_APC_MG_OnCD=false
setResourcesWithLogic:ZN_APC_MG_ShootTimer=${ZN_APC_MG_Shoot}
