[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw
"""

@memory EF_RX_75R_DoubleMG_OnCD:bool
@memory EF_RX_75R_DoubleMG_CDTimer:float
@global EF_RX_75R_DoubleMG_CD=3

@global EF_RX_75R_DoubleMG_Shoot=12
[resource_EF_RX_75R_DoubleMG_ShootTimer]
hidden:true









[turret_EF_RX_75R_DoubleMG]
x:0
y:0

canShoot:true
canAttackCondition:"""
if ${cantAction}==false  and ${onSkill}==false 
"""
showRangeUIGuide:false
projectile:EF_RX_75R_DoubleMG_Projectile
resourceUsage:EF_RX_75R_DoubleMG_ShootTimer=1

delay:0.125s
limitingRange:400
canAttackMaxAngle:360
turnSpeed:0

barrelX:14
barrelY:10
barrelOffsetX_onOddShots:-28

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_2.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_EF_RX_75R_DoubleMG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:350
    |DpDamage:25
    |WeaponAccuracy=75
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:65
    |ProjectileSpread:3
    |ProjectileLife:30
)
"""



[hiddenAction_EF_RX_75R_DoubleMG_CDStart]
autoTrigger:"""
if memory.EF_RX_75R_DoubleMG_OnCD==false 
and 
(
    (
        self.resource.EF_RX_75R_DoubleMG_ShootTimer<=0 
    ) 
    or 
    (
        self.resource.EF_RX_75R_DoubleMG_ShootTimer<${EF_RX_75R_DoubleMG_Shoot} and not self.hasTags(includes='inBattle')
    )
)
"""
setUnitMemory:EF_RX_75R_DoubleMG_OnCD=true,EF_RX_75R_DoubleMG_CDTimer=self.timeAlive+${EF_RX_75R_DoubleMG_CD}

[hiddenAction_EF_RX_75R_DoubleMG_CDEnd]
autoTriggerOnEvent:created
autoTrigger:if memory.EF_RX_75R_DoubleMG_OnCD==true and self.timeAlive>memory.EF_RX_75R_DoubleMG_CDTimer
setUnitMemory:EF_RX_75R_DoubleMG_OnCD=false
setResourcesWithLogic:EF_RX_75R_DoubleMG_ShootTimer=${EF_RX_75R_DoubleMG_Shoot}
