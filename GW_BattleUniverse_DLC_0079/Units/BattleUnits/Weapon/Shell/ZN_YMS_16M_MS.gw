[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""


@memory ZN_YMS_16M_MS_CDTimer:float
@global ZN_YMS_16M_MS_CD=6
@global ZN_YMS_16M_MS_EN=35










[turret_ZN_YMS_16M_MS]
x:0
y:0

canShoot:false
projectile:ZN_YMS_16M_MS_Projectile

delay:0.15s
limitingRange:0

canAttackMaxAngle:15
barrelX:-8
barrelY:-10

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.25
shoot_flame:BZ_Fire_1_S



[projectile_ZN_YMS_16M_MS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS*1
(
    addResources=
    ShellDamage:2500
    |DpDamage:65
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightHitRange=20
    |HeightChangeSpeed=2
    |ProjectileSpeed:35
    |ProjectileTurnspeed:1.5
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:45

    |EquipmentIndex:1
    |EquipmentIndex2:150
)
"""







[hiddenAction_ZN_YMS_16M_MS_Trigger]
alsoTriggerAction:ZN_YMS_16M_MS_Fire
[hiddenAction_ZN_YMS_16M_MS_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_YMS_16M_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:ZN_YMS_16M_MS_CDTimer=self.timeAlive+${ZN_YMS_16M_MS_CD}
addResources:EN=-${ZN_YMS_16M_MS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_YMS_16M_MS_SetWeaponIndex,
ZN_YMS_16M_MS_B10_Step_1
"""
[hiddenAction_ZN_YMS_16M_MS_B10_Step_1]
alsoQueueAction:"""
ZN_YMS_16M_MS_Fire_Step_1,
ZN_YMS_16M_MS_Fire_Step_2,
ZN_YMS_16M_MS_Fire_Step_3,
ZN_YMS_16M_MS_Fire_Step_3,
ZN_YMS_16M_MS_Fire_Step_3,
ZN_YMS_16M_MS_Fire_Step_3,
ZN_YMS_16M_MS_Fire_Step_3,
ZN_YMS_16M_MS_Fire_Step_3,
ZN_YMS_16M_MS_Fire_Step_3,
ZN_YMS_16M_MS_Fire_Step_3,
ZN_YMS_16M_MS_Fire_Step_3,
ZN_YMS_16M_MS_Fire_Step_Final
"""





[hiddenAction_ZN_YMS_16M_MS_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_YMS_16M_MS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
alsoTriggerAction:PlayCommon_Cannon_Shoot_A_Step_1
[hiddenAction_ZN_YMS_16M_MS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_YMS_16M_MS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_YMS_16M_MS_Fire_Step_3]
@copyFromSection:hiddenAction_ZN_YMS_16M_MS_Fire_Step_2
buildSpeed:${turret_ZN_YMS_16M_MS.delay}
[hiddenAction_ZN_YMS_16M_MS_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


