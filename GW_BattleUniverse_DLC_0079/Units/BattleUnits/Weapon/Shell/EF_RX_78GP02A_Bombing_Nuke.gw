[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Flash_1.gw,
ROOT:Resource/Image/Fx/Weapon/Shell/Common/Railgun_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_LongTime.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""


@memory EF_RX_78GP02A_Bombing_Nuke_AimTarget:unit
@memory EF_RX_78GP02A_Bombing_Nuke_CDTimer:float
@global EF_RX_78GP02A_Bombing_Nuke_CD=10000
@global EF_RX_78GP02A_Bombing_Nuke_EN=600

@memory EF_RX_78GP02A_Bombing_Nuke_ChargeEffect_1:unit



[decal_EF_RX_78GP02A_Bombing_Nuke]
layer:beforeBody
order:6.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Weapon/Shell/Image/EF_RX_78GP02A_NukeLauncher_1.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.95
xOffsetRelative: 4
yOffsetRelative: 14
dirOffset:0

[decal_EF_RX_78GP02A_Bombing_Nuke_NotUsing]
@copyFromSection:decal_EF_RX_78GP02A_Bombing_Nuke
isVisible:false
order:5.5
basePositionFromLegEnd:arm2
image:ROOT:Units/BattleUnits/Weapon/Shell/Image/EF_RX_78GP02A_NukeLauncher_2.png
imageScale:1.0
xOffsetRelative:2
yOffsetRelative:0




[decal_EF_RX_78GP02A_Bombing_Nuke_Range]
layer: inactive
order:0
onlyTeam:own
alpha:1
image:ROOT:Resource/Image/Ring/Ring150_Action.png
imageScale:900/150
basePosition:self
alwaysStartDirAtZero:true
onlyWhileAlive:true
isVisible:if true





[turret_EF_RX_78GP02A_Bombing_Nuke]
x:0
y:0

canShoot:false
projectile:EF_RX_78GP02A_Bombing_Nuke_Projectile

delay:0.3s
canAttackMaxAngle:15
limitingAngle:0
limitingRange:900
limitingMinRange:300
barrelX:12
barrelY:42

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCannon_2.ogg
shoot_sound_vol:0.6
shoot_flame:Railgun_Fire_1_Yellow



[projectile_EF_RX_78GP02A_Bombing_Nuke_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Mortar_Bombing_Nuke_GP02A*1
(
    addResources=
    ShellDamage:15000
    |DpDamage:750
    |WeaponAccuracy=75
    |PartBreakModifier=0.5
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.0
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.0
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |AntiAqua=0.75
    |AntiAir=0.5 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=0.5
    |HeightHitRange=10
    |ProjectileSpeed:30
    |ProjectileSpread:5
    |ProjectileExplosionRange:450
    |ProjectileLife:50
)
"""








[hiddenAction_EF_RX_78GP02A_Bombing_Nuke_Trigger_ByAI]
autoTrigger:"""
if ${allowAI}==true 
and ${cantAction}==false 
and ${onSkill}==false 
and memory.close==false 
and self.resource().EquipmentIndex==1 
and self.resource.EN>${EF_RX_78GP02A_Bombing_Nuke_EN} 
and self.timeAlive>memory.EF_RX_78GP02A_Bombing_Nuke_CDTimer 
and self.parent.hp<=0  
and memory.EF_RX_78GP02A_Bombing_Nuke_AimTarget.hp>0 
and memory.EF_RX_78GP02A_Bombing_Nuke_AimTarget.teamID>=0 
and not memory.EF_RX_78GP02A_Bombing_Nuke_AimTarget.tags(includes='UnDetected') 
and distanceBetween(self, memory.EF_RX_78GP02A_Bombing_Nuke_AimTarget)>=300 
"""
alsoTriggerAction:EF_RX_78GP02A_Bombing_Nuke_Trigger


[hiddenAction_EF_RX_78GP02A_Bombing_Nuke_FindTarget]
autoTrigger:if ${allowAI}==true 
takeResources_includeUnitsWithinRange:1000
takeResources_includeUnitsWithinRange_team:enemy
takeResources_excludeUnitsWithoutTags:CanBeDetected
takeResources_searchOnly:true
takeResources_maxUnits:30
takeResources_triggerActionForEach:EF_RX_78GP02A_Bombing_Nuke_FindTarget_Step2
[hiddenAction_EF_RX_78GP02A_Bombing_Nuke_FindTarget_Step2]
requireConditional:"""
if not thisActionTarget.tags(includes='UnDetected') 
"""
setUnitMemory:EF_RX_78GP02A_Bombing_Nuke_AimTarget=thisActionTarget


[action_EF_RX_78GP02A_Bombing_Nuke_Trigger]
pos:10
text:Bombing[MK-82] %{select(self.timeAlive<=memory.EF_RX_78GP02A_Bombing_Nuke_CDTimer,str(int(memory.EF_RX_78GP02A_Bombing_Nuke_CDTimer-self.timeAlive))+"s","OK")}
text_zh:轰炸[MK-82] %{select(self.timeAlive<=memory.EF_RX_78GP02A_Bombing_Nuke_CDTimer,str(int(memory.EF_RX_78GP02A_Bombing_Nuke_CDTimer-self.timeAlive))+"秒","OK")}
text_KP:100

displayType:infoOnly

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true

iconImage:ROOT:Resource/Image/Units/Button/Weapon/Mortar_1.png
highPriorityQueue:true

price:EN=${EF_RX_78GP02A_Bombing_Nuke_EN}

onlyOneUnitAtATime:true

isVisible:if self.parent.hp<=0 and self.resource().EquipmentIndex==1

isGuiBlinking:"""
if self.timeAlive>memory.EF_RX_78GP02A_Bombing_Nuke_CDTimer
"""

isLocked:if self.timeAlive<=memory.EF_RX_78GP02A_Bombing_Nuke_CDTimer
isLockedMessage:In CD
isLockedMessage_zh:冷却中
isLockedAlt:if memory.armRBreaked==true or memory.armLBreaked==true
isLockedAltMessage:Arm Breaked
isLockedAltMessage_zh:手臂损害
isLockedAlt2:if ${cantAction}==true  or ${onSkill}==true or ${allowAI}==true
isLockedAlt2Message:Cant Action
isLockedAlt2Message_zh:无法行动

fireTurretXAtGround:EF_RX_78GP02A_Bombing_Nuke
fireTurretXAtGround_count:0
fireTurretXAtGround_showGuideDecals:EF_RX_78GP02A_Bombing_Nuke_Range

alsoTriggerAction:"""
SetAttackingCantAimOn,
SetAttackingCantTurnOn,
SetAttackingOn,
SetOnSkillOn,
PlayCommon_Shoot_A_LongTime_Step_1,
EF_RX_78GP02A_Bombing_Nuke_SetWeaponIndex,
EF_RX_78GP02A_Bombing_Nuke_B1_Step_1
"""
clearAllWaypoints:true
[hiddenAction_EF_RX_78GP02A_Bombing_Nuke_B1_Step_1]
spawnEffects:Flash_1_N
setUnitMemory:"""
EF_RX_78GP02A_Bombing_Nuke_AimTarget=select(${allowAI}==true,memory.EF_RX_78GP02A_Bombing_Nuke_AimTarget,thisActionTarget),
EF_RX_78GP02A_Bombing_Nuke_CDTimer=self.timeAlive+${EF_RX_78GP02A_Bombing_Nuke_CD}
"""

setBodyRotation:directionBetween(self,memory.EF_RX_78GP02A_Bombing_Nuke_AimTarget)

alsoQueueAction:"""
EF_RX_78GP02A_Bombing_Nuke_Fire_Step_ChargeEffect_1,
EF_RX_78GP02A_Bombing_Nuke_Fire_Step_1,

EF_RX_78GP02A_Bombing_Nuke_Fire_Step_2,
EF_RX_78GP02A_Bombing_Nuke_Fire_Step_3,

EF_RX_78GP02A_Bombing_Nuke_Fire_Step_Final
"""
spawnEffects:Flash_1_L



[hiddenAction_EF_RX_78GP02A_Bombing_Nuke_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RX_78GP02A_Bombing_Nuke_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false and memory.armLBreaked==false
"""
buildSpeed:2.5s
whenBuilding_cannotMove:true
[hiddenAction_EF_RX_78GP02A_Bombing_Nuke_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false and memory.armLBreaked==false
"""
buildSpeed:0.5s
whenBuilding_cannotMove:true
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_EF_RX_78GP02A_Bombing_Nuke_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false and memory.armLBreaked==false
"""
buildSpeed:0s
whenBuilding_cannotMove:true
fireTurretXAtGround:EF_RX_78GP02A_Bombing_Nuke
fireTurretXAtGround_withTarget:memory.EF_RX_78GP02A_Bombing_Nuke_AimTarget
[hiddenAction_EF_RX_78GP02A_Bombing_Nuke_Fire_Step_Final]
buildSpeed:1.5s
whenBuilding_cannotMove:true
finishPlayingLastAnimation:true
alsoTriggerAction:"""
SetAttackingOff,
SetOnSkillOff,
SetAttackingCantAimOff,
SetAttackingCantTurnOff
"""
clearAllWaypoints:true














[attachment_EF_RX_78GP02A_Bombing_Nuke_ChargeEffect_1]
x:12
y:42
isVisible:true
keepAliveWhenParentDies:false
canBeAttackedAndDamaged:false
isUnselectable:true
canAttack:false
showAllActionsFrom:true
onConvertKeepExistingUnitInSameSlot:true
idleDir:0
resetRotationWhenNotAttacking:true

[hiddenAction_EF_RX_78GP02A_Bombing_Nuke_ChargeEffect_1_AwakeSet]
autoTriggerOnEvent:created
alsoTriggerAction:"""
EF_RX_78GP02A_Bombing_Nuke_ChargeEffect_1_StartSet
"""
attachments_addNewUnits:Beam_Charge_1_EffectUnit
attachments_onlyOnSlots:EF_RX_78GP02A_Bombing_Nuke_ChargeEffect_1

[hiddenAction_EF_RX_78GP02A_Bombing_Nuke_ChargeEffect_1_StartSet]
setUnitMemory:EF_RX_78GP02A_Bombing_Nuke_ChargeEffect_1=self.attachment(slot='EF_RX_78GP02A_Bombing_Nuke_ChargeEffect_1')
alsoTriggerAction:"""
EF_RX_78GP02A_Bombing_Nuke_ChargeEffect_1_SetColor,
EF_RX_78GP02A_Bombing_Nuke_ChargeEffect_1_SetSpeed
"""

[hiddenAction_EF_RX_78GP02A_Bombing_Nuke_ChargeEffect_1_SetColor]
sendMessageTo:memory.EF_RX_78GP02A_Bombing_Nuke_ChargeEffect_1
sendMessageWithTags:SetColor_Yellow
[hiddenAction_EF_RX_78GP02A_Bombing_Nuke_ChargeEffect_1_SetSpeed]
sendMessageTo:memory.EF_RX_78GP02A_Bombing_Nuke_ChargeEffect_1
sendMessageWithTags:SetSpeed
sendMessageWithData:Speed=5

[hiddenAction_EF_RX_78GP02A_Bombing_Nuke_Fire_Step_ChargeEffect_1]
requireConditional:if ${cantAction}==false
buildSpeed:0s
sendMessageTo:memory.EF_RX_78GP02A_Bombing_Nuke_ChargeEffect_1
sendMessageWithTags:PlayOneTime
playSoundAtUnit:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCharge_4.ogg:2.0