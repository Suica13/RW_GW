[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw
"""

@memory EF_RX_79_BD_ChestMG_CDTimer:float
@global EF_RX_79_BD_ChestMG_CD=10
@global EF_RX_79_BD_ChestMG_EN=35









[turret_EF_RX_79_BD_ChestMG]
x:0
y:0

canShoot:false
projectile:EF_RX_79_BD_ChestMG_Projectile

delay:0.05s
limitingRange:0

canAttackMaxAngle:15
barrelX:6
barrelY:2

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_2.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1
[turret_EF_RX_79_BD_ChestMG_L]
@copyFromSection:turret_EF_RX_79_BD_ChestMG
barrelX:-6



[projectile_EF_RX_79_BD_ChestMG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:550
    |DpDamage:30
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=25
    |ProjectileSpeed:75
    |ProjectileSpread:6
    |ProjectileLife:25
)
"""







[hiddenAction_EF_RX_79_BD_ChestMG_Trigger]
alsoTriggerAction:EF_RX_79_BD_ChestMG_Fire
[hiddenAction_EF_RX_79_BD_ChestMG_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RX_79_BD_ChestMG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0 
"""
setUnitMemory:EF_RX_79_BD_ChestMG_CDTimer=self.timeAlive+${EF_RX_79_BD_ChestMG_CD}
addResources:EN=-${EF_RX_79_BD_ChestMG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RX_79_BD_ChestMG_SetWeaponIndex,
EF_RX_79_BD_ChestMG_B12_Step_1
"""
[hiddenAction_EF_RX_79_BD_ChestMG_B12_Step_1]
alsoQueueAction:"""
EF_RX_79_BD_ChestMG_Fire_Step_1,
EF_RX_79_BD_ChestMG_Fire_Step_2,
EF_RX_79_BD_ChestMG_Fire_Step_4,
EF_RX_79_BD_ChestMG_Fire_Step_3,
EF_RX_79_BD_ChestMG_Fire_Step_4,
EF_RX_79_BD_ChestMG_Fire_Step_3,
EF_RX_79_BD_ChestMG_Fire_Step_4,
EF_RX_79_BD_ChestMG_Fire_Step_3,
EF_RX_79_BD_ChestMG_Fire_Step_4,
EF_RX_79_BD_ChestMG_Fire_Step_3,
EF_RX_79_BD_ChestMG_Fire_Step_4,
EF_RX_79_BD_ChestMG_Fire_Step_3,
EF_RX_79_BD_ChestMG_Fire_Step_4,
EF_RX_79_BD_ChestMG_Fire_Step_3,
EF_RX_79_BD_ChestMG_Fire_Step_4,
EF_RX_79_BD_ChestMG_Fire_Step_Final
"""





[hiddenAction_EF_RX_79_BD_ChestMG_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RX_79_BD_ChestMG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_EF_RX_79_BD_ChestMG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RX_79_BD_ChestMG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_RX_79_BD_ChestMG_Fire_Step_3]
@copyFromSection:hiddenAction_EF_RX_79_BD_ChestMG_Fire_Step_2
buildSpeed:${turret_EF_RX_79_BD_ChestMG.delay}

[hiddenAction_EF_RX_79_BD_ChestMG_Fire_Step_4]
@copyFromSection:hiddenAction_EF_RX_79_BD_ChestMG_Fire_Step_2
buildSpeed:${turret_EF_RX_79_BD_ChestMG.delay}
fireTurretXAtGround:EF_RX_79_BD_ChestMG_L

[hiddenAction_EF_RX_79_BD_ChestMG_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff


