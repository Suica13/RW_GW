[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""


@memory EF_RGM_79S_MG_CDTimer:float
@global EF_RGM_79S_MG_CD=3
@global EF_RGM_79S_MG_EN=35





[decal_EF_RGM_79S_MG]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\EF_RGM_79S_MG.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 2
yOffsetRelative: 16
dirOffset:0
[decal_EF_RGM_79S_MG_NotUsing]
@copyFromSection:decal_EF_RGM_79S_MG
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.9
xOffsetRelative:2
yOffsetRelative:-8.5
dirOffset:-90







[turret_EF_RGM_79S_MG]
x:0
y:0

canShoot:false
projectile:EF_RGM_79S_MG_Projectile

delay:0.075s
limitingRange:0

canAttackMaxAngle:15
barrelX:10
barrelY:28

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_1.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_EF_RGM_79S_MG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:350
    |ShellAPDamage:350
    |DpDamage:30
    |WeaponAccuracy=85
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:80
    |ProjectileSpread:5
    |ProjectileLife:25
)
"""
[projectile_EF_RGM_79S_MG_Projectile_GD]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_S*1
(
    addResources=
    ShellDamage:1250
    |DpDamage:125
    |WeaponAccuracy=85
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75
    |AntiLand=1 
    |AntiSpace=1 
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:55
    |ProjectileSpread:2
    |ProjectileExplosionRange:35
    |ProjectileLife:25
)
"""






[hiddenAction_EF_RGM_79S_MG_Trigger]
alsoTriggerAction:EF_RGM_79S_MG_Fire
[hiddenAction_EF_RGM_79S_MG_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RGM_79S_MG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_RGM_79S_MG_CDTimer=self.timeAlive+${EF_RGM_79S_MG_CD}
addResources:EN=-${EF_RGM_79S_MG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RGM_79S_MG_SetWeaponIndex,
EF_RGM_79S_MG_B12_Step_1
"""
[hiddenAction_EF_RGM_79S_MG_B12_Step_1]
alsoQueueAction:"""
EF_RGM_79S_MG_Fire_Step_1,
EF_RGM_79S_MG_Fire_Step_2,
EF_RGM_79S_MG_Fire_Step_3,
EF_RGM_79S_MG_Fire_Step_3,
EF_RGM_79S_MG_Fire_Step_3,
EF_RGM_79S_MG_Fire_Step_3,
EF_RGM_79S_MG_Fire_Step_3,
EF_RGM_79S_MG_Fire_Step_3,
EF_RGM_79S_MG_Fire_Step_3,
EF_RGM_79S_MG_Fire_Step_3,
EF_RGM_79S_MG_Fire_Step_3,
EF_RGM_79S_MG_Fire_Step_3,
EF_RGM_79S_MG_Fire_Step_3,
EF_RGM_79S_MG_Fire_Step_4,
EF_RGM_79S_MG_Fire_Step_4,
EF_RGM_79S_MG_Fire_Step_4,
EF_RGM_79S_MG_Fire_Step_Final
"""





[hiddenAction_EF_RGM_79S_MG_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RGM_79S_MG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_EF_RGM_79S_MG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RGM_79S_MG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_EF_RGM_79S_MG_Fire_Step_3]
@copyFromSection:hiddenAction_EF_RGM_79S_MG_Fire_Step_2
buildSpeed:${turret_EF_RGM_79S_MG.delay}
[hiddenAction_EF_RGM_79S_MG_Fire_Step_4]
@copyFromSection:hiddenAction_EF_RGM_79S_MG_Fire_Step_2
buildSpeed:${turret_EF_RGM_79S_MG.delay}
fireTurretXAtGround_withProjectile:EF_RGM_79S_MG_Projectile_GD
[hiddenAction_EF_RGM_79S_MG_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


