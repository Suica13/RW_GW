[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Flash_1.gw,
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory EF_HypeBazooka_ACE_CDTimer:float
@global EF_HypeBazooka_ACE_CD=45
@global EF_HypeBazooka_ACE_EN=45





[decal_EF_HypeBazooka_ACE]
layer:beforeBody
order:6.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\EF_HypeBazooka.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.8
xOffsetRelative: 1
yOffsetRelative: 7
dirOffset:0
[decal_EF_HypeBazooka_ACE_NotUsing]
@copyFromSection:decal_EF_HypeBazooka_ACE
order:0
basePositionFromLegEnd:arm1
imageScale:0.7
imageScaleY:-1
xOffsetRelative:-1
yOffsetRelative:-9
dirOffset:90






[turret_EF_HypeBazooka_ACE]
x:0
y:0

canShoot:false
projectile:EF_HypeBazooka_ACE_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:10
barrelY:17
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Bazooka_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_EF_HypeBazooka_ACE_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka*1
(
    addResources=
    ShellDamage:8000
    |DpDamage:600
    |WeaponAccuracy=75
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:55
    |ProjectileSpread:6
    |ProjectileExplosionRange:30
    |ProjectileLife:35

    |ProjectileBlastRange:60
    |ProjectileBlastDamageModifier:0.20
    |ProjectileBlastDpModifier:1
)
"""








[action_EF_HypeBazooka_ACE_Trigger]
pos:10
text:HypeBazooka %{select(self.timeAlive<=memory.EF_HypeBazooka_ACE_CDTimer,str(int(memory.EF_HypeBazooka_ACE_CDTimer-self.timeAlive))+"s","OK")}
text_zh:高能火箭筒 %{select(self.timeAlive<=memory.EF_HypeBazooka_ACE_CDTimer,str(int(memory.EF_HypeBazooka_ACE_CDTimer-self.timeAlive))+"秒","OK")}
text_KP:100

displayType:infoOnly

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true

iconImage:ROOT:Resource\Image\Units\Button\Weapon\Bazooka_1.png
highPriorityQueue:true

price:EN=${EF_HypeBazooka_ACE_EN}

onlyOneUnitAtATime:true

isVisible:if self.parent.hp<=0  

isGuiBlinking:"""
if self.timeAlive>memory.EF_HypeBazooka_ACE_CDTimer
"""

isLocked:if self.timeAlive<=memory.EF_HypeBazooka_ACE_CDTimer
isLockedMessage:In CD
isLockedMessage_zh:冷却中
isLockedAlt:if memory.armRBreaked==true
isLockedAltMessage:Arm Breaked
isLockedAltMessage_zh:手臂损坏
isLockedAlt2:if ${cantAction}==true or ${onSkill}==true or ${allowAI}==true
isLockedAlt2Message:Cant Action
isLockedAlt2Message_zh:无法行动

setUnitMemory:EF_HypeBazooka_ACE_CDTimer=self.timeAlive+${EF_HypeBazooka_ACE_CD}

alsoTriggerAction:"""
SetAttackingOn,
SetOnSkillOn,
SendEnemyTryAttack_Shoot,
EF_HypeBazooka_ACE_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
EF_HypeBazooka_ACE_B3_Step_1
"""
[hiddenAction_EF_HypeBazooka_ACE_B3_Step_1]
alsoQueueAction:"""
EF_HypeBazooka_ACE_Fire_Step_1,
EF_HypeBazooka_ACE_Fire_Step_2,
EF_HypeBazooka_ACE_Fire_Step_3,
EF_HypeBazooka_ACE_Fire_Step_3,
EF_HypeBazooka_ACE_Fire_Step_Final
"""
spawnEffects:Flash_1_N




[hiddenAction_EF_HypeBazooka_ACE_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_HypeBazooka_ACE_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.45s
[hiddenAction_EF_HypeBazooka_ACE_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_HypeBazooka_ACE
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_EF_HypeBazooka_ACE_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
fireTurretXAtGround:EF_HypeBazooka_ACE
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_EF_HypeBazooka_ACE_Fire_Step_Final]
buildSpeed:1.0s
alsoTriggerAction:"""
SetOnSkillOff,
SetAttackingOff
"""

