[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""


@memory EF_90mmMG_L_CDTimer:float
@global EF_90mmMG_L_CD=2
@global EF_90mmMG_L_EN=20





[decal_EF_90mmMG_L]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\EF_90mmMG.png
isVisible:false
basePositionFromLegEnd:arm3
imageScale:0.85
xOffsetRelative: 0
yOffsetRelative: 12
dirOffset:0
[decal_EF_90mmMG_L_NotUsing]
@copyFromSection:decal_EF_90mmMG_L
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.75
imageScaleX:-1
xOffsetRelative:0
yOffsetRelative:-8.5
dirOffset:90






[turret_EF_90mmMG_L]
x:0
y:0

canShoot:false
projectile:EF_90mmMG_L_Projectile

delay:0.1s
limitingRange:0

canAttackMaxAngle:15
barrelX:-8
barrelY:24

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_1.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_EF_90mmMG_L_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:725
    |DpDamage:30
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:5
    |ProjectileLife:25
)
"""







[hiddenAction_EF_90mmMG_L_Trigger]
alsoTriggerAction:EF_90mmMG_L_Fire
[hiddenAction_EF_90mmMG_L_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_90mmMG_L_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_90mmMG_L_CDTimer=self.timeAlive+${EF_90mmMG_L_CD}
addResources:EN=-${EF_90mmMG_L_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_90mmMG_L_SetWeaponIndex,
EF_90mmMG_L_B9_Step_1
"""
[hiddenAction_EF_90mmMG_L_B9_Step_1]
alsoQueueAction:"""
EF_90mmMG_L_Fire_Step_1,
EF_90mmMG_L_Fire_Step_2,
EF_90mmMG_L_Fire_Step_3,
EF_90mmMG_L_Fire_Step_3,
EF_90mmMG_L_Fire_Step_3,
EF_90mmMG_L_Fire_Step_3,
EF_90mmMG_L_Fire_Step_3,
EF_90mmMG_L_Fire_Step_3,
EF_90mmMG_L_Fire_Step_3,
EF_90mmMG_L_Fire_Step_3,
EF_90mmMG_L_Fire_Step_Final
"""





[hiddenAction_EF_90mmMG_L_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_90mmMG_L_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_EF_90mmMG_L_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_90mmMG_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_L_Step_1
[hiddenAction_EF_90mmMG_L_Fire_Step_3]
@copyFromSection:hiddenAction_EF_90mmMG_L_Fire_Step_2
buildSpeed:${turret_EF_90mmMG_L.delay}
alsoTriggerAction:PlayCommon_Shoot_A_FA_Step_1
[hiddenAction_EF_90mmMG_L_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


