SendEnemyTryAttack_Shoot,
PlayCommon_Shoot_A_Step_1,
EF_RX_80_PR_2_FrameLauncher_MG_SetWeaponIndex,
EF_RX_80_PR_2_FrameLauncher_MG_B15_Step_1
