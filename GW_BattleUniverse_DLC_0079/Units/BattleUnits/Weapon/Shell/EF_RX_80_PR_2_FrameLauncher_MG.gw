[hiddenAction_EF_RX_80_PR_2_FrameLauncher_MG_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RX_80_PR_2_FrameLauncher_MG_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_RX_80_PR_2_FrameLauncher_MG_CDTimer=self.timeAlive+${EF_RX_80_PR_2_FrameLauncher_MG_CD}
addResources:EN=-${EF_RX_80_PR_2_FrameLauncher_MG_EN}
alsoTriggerAction:"""
