[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw
"""

@memory ZN_MS_06V_MG_OnCD:bool
@memory ZN_MS_06V_MG_CDTimer:float
@global ZN_MS_06V_MG_CD=2
@global ZN_MS_06V_MG_EN=1

@global ZN_MS_06V_MG_Shoot=12
[resource_ZN_MS_06V_MG_ShootTimer]
hidden:true




[decal_ZN_MS_06V_MG]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\ZN_105mmMG.png
isVisible:false
imageScale:1
xOffsetRelative: 9
yOffsetRelative: 15
dirOffset:0





[turret_ZN_MS_06V_MG]
x:0
y:0

canShoot:true
canAttackCondition:"""
if ${cantAction}==false  and ${onSkill}==false 
"""
showRangeUIGuide:false
projectile:ZN_MS_06V_MG_Projectile
resourceUsage:ZN_MS_06V_MG_ShootTimer=1,en=${ZN_MS_06V_MG_EN}

delay:0.1s
limitingRange:1200
canAttackMaxAngle:360
turnSpeed:0

barrelX:10
barrelY:30

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_2.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_ZN_MS_06V_MG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:350
    |DpDamage:25
    |WeaponAccuracy=75
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:65
    |ProjectileSpread:3
    |ProjectileLife:30
)
"""



[hiddenAction_ZN_MS_06V_MG_CDStart]
autoTrigger:"""
if memory.ZN_MS_06V_MG_OnCD==false 
and 
(
    (
        self.resource.ZN_MS_06V_MG_ShootTimer<=0 
    ) 
    or 
    (
        self.resource.ZN_MS_06V_MG_ShootTimer<${ZN_MS_06V_MG_Shoot} and not self.hasTags(includes='inBattle')
    )
)
"""
setUnitMemory:ZN_MS_06V_MG_OnCD=true,ZN_MS_06V_MG_CDTimer=self.timeAlive+${ZN_MS_06V_MG_CD}

[hiddenAction_ZN_MS_06V_MG_CDEnd]
autoTriggerOnEvent:created
autoTrigger:if memory.ZN_MS_06V_MG_OnCD==true and self.timeAlive>memory.ZN_MS_06V_MG_CDTimer
setUnitMemory:ZN_MS_06V_MG_OnCD=false
setResourcesWithLogic:ZN_MS_06V_MG_ShootTimer=${ZN_MS_06V_MG_Shoot}
