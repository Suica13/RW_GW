[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_StandShoot_A.gw
"""


@memory ZN_MS_06K_BigGun_CDTimer:float
@global ZN_MS_06K_BigGun_CD=4
@global ZN_MS_06K_BigGun_EN=25





[decal_ZN_MS_06K_BigGun_R]
layer:beforeBody
order:3.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Weapon/Shell/Image/ZN_BigGun.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.85
xOffsetRelative: 3
yOffsetRelative: 7.5
dirOffset:0
[decal_ZN_MS_06K_BigGun_L]
@copyFromSection:decal_ZN_MS_06K_BigGun_R
basePositionFromLegEnd:arm3
imageScaleX:-1
xOffsetRelative: -3
[decal_ZN_MS_06K_BigGun_R_NotUsing]
@copyFromSection:decal_ZN_MS_06K_BigGun_R
isVisible:false
order:3
basePositionFromLegEnd:arm2
imageScale:0.85
imageScaleX:-1
imageScaleY:0.35
xOffsetRelative:9
yOffsetRelative:-9
dirOffset:180

[decal_ZN_MS_06K_BigGun_L_NotUsing]
@copyFromSection:decal_ZN_MS_06K_BigGun_L
isVisible:false
order:3
basePositionFromLegEnd:arm2
imageScale:0.85
imageScaleX:1
imageScaleY:0.35
xOffsetRelative:-9
yOffsetRelative:-9
dirOffset:180




[turret_ZN_MS_06K_BigGun]
x:0
y:0

canShoot:false
projectile:ZN_MS_06K_BigGun_Projectile

delay:0.15s
limitingRange:0

canAttackMaxAngle:15
barrelX:11
barrelY:10

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.15
shoot_flame:BZ_Fire_1_S
[turret_ZN_MS_06K_BigGun_L]
@copyFromSection:turret_ZN_MS_06K_BigGun
barrelX:-11



[projectile_ZN_MS_06K_BigGun_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS*1
(
    addResources=
    ShellDamage:1250
    |DpDamage:50
    |WeaponAccuracy=90
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=2.25
    |AntiLand=1
    |AntiSpace=1.0
    |HeightHitRange=20
    |HeightChangeSpeed=2
    |ProjectileSpeed:50
    |ProjectileTurnspeed:3.5
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:20

    |EquipmentIndex:1
    |EquipmentIndex2:200
)
"""







[hiddenAction_ZN_MS_06K_BigGun_Trigger]
alsoTriggerAction:ZN_MS_06K_BigGun_Fire
[hiddenAction_ZN_MS_06K_BigGun_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MS_06K_BigGun_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  
and not (directionBetween(self, self.attacking) < self.dir-45 or directionBetween(self, self.attacking) > self.dir+45)  
and self.resource.EN>0
"""
setUnitMemory:ZN_MS_06K_BigGun_CDTimer=self.timeAlive+${ZN_MS_06K_BigGun_CD}
addResources:EN=-${ZN_MS_06K_BigGun_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_MS_06K_BigGun_SetWeaponIndex,
ZN_MS_06K_BigGun_B2_Step_1,
PlayCommon_StandShoot_A_Step_1
"""
[hiddenAction_ZN_MS_06K_BigGun_B2_Step_1]
alsoQueueAction:"""
ZN_MS_06K_BigGun_Fire_Step_1,
ZN_MS_06K_BigGun_Fire_Step_2,
ZN_MS_06K_BigGun_Fire_Step_3,
ZN_MS_06K_BigGun_Fire_Step_2,
ZN_MS_06K_BigGun_Fire_Step_3,
ZN_MS_06K_BigGun_Fire_Step_Final
"""





[hiddenAction_ZN_MS_06K_BigGun_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MS_06K_BigGun_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_ZN_MS_06K_BigGun_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false and memory.armRBreaked==false
"""
buildSpeed:0.1s
fireTurretXAtGround:ZN_MS_06K_BigGun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MS_06K_BigGun_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false and memory.armLBreaked==false
"""
buildSpeed:0.1s
fireTurretXAtGround:ZN_MS_06K_BigGun_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MS_06K_BigGun_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


