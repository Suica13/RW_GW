[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw
"""

@memory ZN_Wappa_MG_OnCD:bool
@memory ZN_Wappa_MG_CDTimer:float
@global ZN_Wappa_MG_CD=2
@global ZN_Wappa_MG_EN=0.5

@global ZN_Wappa_MG_Shoot=10
[resource_ZN_Wappa_MG_ShootTimer]
hidden:true








[turret_ZN_Wappa_MG]
x:0
y:0

canShoot:true
canAttackCondition:"""
if ${onAttacking}==false and ${cantAction}==false 
"""
showRangeUIGuide:false
projectile:ZN_Wappa_MG_Projectile
resourceUsage:ZN_Wappa_MG_ShootTimer=1,en=${ZN_Wappa_MG_EN}

delay:0.1s
barrelX:0
barrelY:3
turnSpeed:1.0

aimOffsetSpread:0
recoilOffset:0
recoilOutTime:0
recoilReturnTime:0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_2.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1_S



[projectile_ZN_Wappa_MG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Vulcan*1
(
    addResources=
    ShellDamage:25
    |DpDamage:5
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=1
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=1
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:85
    |ProjectileSpread:4
    |ProjectileLife:20
)
"""


[hiddenAction_ZN_Wappa_MG_CDStart]
autoTrigger:"""
if memory.ZN_Wappa_MG_OnCD==false 
and 
(
    (
        self.resource.ZN_Wappa_MG_ShootTimer<=0 
    ) 
    or 
    (
        self.resource.ZN_Wappa_MG_ShootTimer<${ZN_Wappa_MG_Shoot} and not self.hasTags(includes='inBattle')
    )
)
"""
setUnitMemory:ZN_Wappa_MG_OnCD=true,ZN_Wappa_MG_CDTimer=self.timeAlive+${ZN_Wappa_MG_CD}

[hiddenAction_ZN_Wappa_MG_CDEnd]
autoTriggerOnEvent:created
autoTrigger:if memory.ZN_Wappa_MG_OnCD==true and self.timeAlive>memory.ZN_Wappa_MG_CDTimer
setUnitMemory:ZN_Wappa_MG_OnCD=false
setResourcesWithLogic:ZN_Wappa_MG_ShootTimer=${ZN_Wappa_MG_Shoot}
