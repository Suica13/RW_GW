[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw
"""

@memory ZN_MS_06V_Cannon_OnCD:bool
@memory ZN_MS_06V_Cannon_CDTimer:float
@global ZN_MS_06V_Cannon_CD=7
@global ZN_MS_06V_Cannon_EN=30

@global ZN_MS_06V_Cannon_Shoot=2
[resource_ZN_MS_06V_Cannon_ShootTimer]
hidden:true






[turret_ZN_MS_06V_Cannon]
x:0
y:0

canShoot:true
canOnlyAttackUnitsWithoutTags:AirUnit
onShoot_triggerActions:SendEnemyTryAttack_Shoot
canAttackCondition:"""
if ${onAttacking}==false and ${cantAction}==false and self.speed<0.2 and distanceBetween(self,self.attacking)>150 and ${onSkill}==false 
"""
showRangeUIGuide:false
projectile:ZN_MS_06V_Cannon_Projectile
resourceUsage:ZN_MS_06V_Cannon_ShootTimer=1,en=${ZN_MS_06V_Cannon_EN}


delay:0.0s
canAttackMaxAngle:5
barrelX:8
barrelY:12
turnSpeed:1.0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0


shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\ShellCannon_1.ogg
shoot_sound_vol:0.6
shoot_flame:BZ_Fire_1

[turret_ZN_MS_06V_Cannon_Fake]
x:0
y:0

canShoot:false
canAttackCondition:"""
if ${onAttacking}==false and ${cantAction}==false
"""
showRangeUIGuide:false
projectile:ZN_MS_06V_Cannon_Projectile

delay:0.0s
canAttackMaxAngle:5
barrelX:8
barrelY:12
turnSpeed:1.0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\ShellCannon_1.ogg
shoot_sound_vol:0.6
shoot_flame:BZ_Fire_1



[projectile_ZN_MS_06V_Cannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Mortar*1
(
    addResources=
    ShellDamage:4000
    |DpDamage:200
    |WeaponAccuracy=75
    |PartBreakModifier=0.5
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |AntiAqua=0.75
    |AntiAir=0.5 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=0.5
    |HeightHitRange=10
    |ProjectileSpeed:25
    |ProjectileSpread:0
    |ProjectileExplosionRange:30
    |ProjectileLife:50

    |ProjectileBlastRange:60
    |ProjectileBlastDamageModifier:0.20
    |ProjectileBlastDpModifier:1
)
"""



[hiddenAction_ZN_MS_06V_Cannon_CDStart]
autoTrigger:"""
if memory.ZN_MS_06V_Cannon_OnCD==false 
and 
(
    (
        self.resource.ZN_MS_06V_Cannon_ShootTimer<=0 
    ) 
    or 
    (
        self.resource.ZN_MS_06V_Cannon_ShootTimer<${ZN_MS_06V_Cannon_Shoot} and not self.hasTags(includes='inBattle')
    )
)
"""
setUnitMemory:ZN_MS_06V_Cannon_OnCD=true,ZN_MS_06V_Cannon_CDTimer=self.timeAlive+${ZN_MS_06V_Cannon_CD}

[hiddenAction_ZN_MS_06V_Cannon_CDEnd]
autoTriggerOnEvent:created
autoTrigger:if memory.ZN_MS_06V_Cannon_OnCD==true and self.timeAlive>memory.ZN_MS_06V_Cannon_CDTimer
setUnitMemory:ZN_MS_06V_Cannon_OnCD=false
setResourcesWithLogic:ZN_MS_06V_Cannon_ShootTimer=${ZN_MS_06V_Cannon_Shoot}
