[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory EF_RX_75_Cannon_CDTimer:float
@global EF_RX_75_Cannon_CD=4
@global EF_RX_75_Cannon_EN=40










[turret_EF_RX_75_Cannon]
x:0
y:0

canShoot:false
projectile:EF_RX_75_Cannon_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:-5
barrelY:10
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Bazooka_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1
[turret_EF_RX_75_Cannon_R]
@copyFromSection:turret_EF_RX_75_Cannon
barrelX:5


[projectile_EF_RX_75_Cannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Mortar*1
(
    addResources=
    ShellDamage:3500
    |DpDamage:350
    |WeaponAccuracy=75
    |PartBreakModifier=0.5
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.5
    |AntiAqua=0.75
    |AntiAir=0.5 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=0.5
    |HeightHitRange=10
    |ProjectileSpeed:25
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:50

    |ProjectileBlastRange:65
    |ProjectileBlastDamageModifier:0.35
    |ProjectileBlastDpModifier:1
)
"""








[hiddenAction_EF_RX_75_Cannon_Trigger]
alsoTriggerAction:EF_RX_75_Cannon_Fire
[hiddenAction_EF_RX_75_Cannon_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RX_75_Cannon_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:EF_RX_75_Cannon_CDTimer=self.timeAlive+${EF_RX_75_Cannon_CD}
addResources:EN=-${EF_RX_75_Cannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RX_75_Cannon_SetWeaponIndex,
PlayCommon_Cannon_Shoot_A_Step_1,
EF_RX_75_Cannon_B2_Step_1
"""
[hiddenAction_EF_RX_75_Cannon_B2_Step_1]
alsoQueueAction:"""
EF_RX_75_Cannon_Fire_Step_1,
EF_RX_75_Cannon_Fire_Step_2,
EF_RX_75_Cannon_Fire_Step_3,
EF_RX_75_Cannon_Fire_Step_Final
"""




[hiddenAction_EF_RX_75_Cannon_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RX_75_Cannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_EF_RX_75_Cannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RX_75_Cannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_RX_75_Cannon_Fire_Step_3]
@copyFromSection:hiddenAction_EF_RX_75_Cannon_Fire_Step_2
buildSpeed:0.1s
fireTurretXAtGround:EF_RX_75_Cannon_R
[hiddenAction_EF_RX_75_Cannon_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


