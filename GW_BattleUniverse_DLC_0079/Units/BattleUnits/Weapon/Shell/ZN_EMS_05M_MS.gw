[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""


@memory ZN_EMS_05M_MS_CDTimer:float
@global ZN_EMS_05M_MS_CD=5
@global ZN_EMS_05M_MS_EN=45






[turret_ZN_EMS_05M_MS]
x:0
y:0

canShoot:false
projectile:ZN_EMS_05M_MS_Projectile

delay:0.3s
limitingRange:0

canAttackMaxAngle:15
barrelX:-14
barrelY:7

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1



[projectile_ZN_EMS_05M_MS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS*1
(
    addResources=
    ShellDamage:1500
    |DpDamage:75
    |WeaponAccuracy=90
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=3
    |AntiAir=0.5 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=10
    |ProjectileSpeed:40
    |ProjectileTurnspeed:1.25
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:40
)
"""







[hiddenAction_ZN_EMS_05M_MS_Trigger]
alsoTriggerAction:ZN_EMS_05M_MS_Fire
[hiddenAction_ZN_EMS_05M_MS_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_EMS_05M_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:ZN_EMS_05M_MS_CDTimer=self.timeAlive+${ZN_EMS_05M_MS_CD}
addResources:EN=-${ZN_EMS_05M_MS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_EMS_05M_MS_SetWeaponIndex,
ZN_EMS_05M_MS_B4_Step_1
"""
[hiddenAction_ZN_EMS_05M_MS_B4_Step_1]
alsoQueueAction:"""
ZN_EMS_05M_MS_Fire_Step_1,
ZN_EMS_05M_MS_Fire_Step_2,
ZN_EMS_05M_MS_Fire_Step_3,
ZN_EMS_05M_MS_Fire_Step_3,
ZN_EMS_05M_MS_Fire_Step_3,
ZN_EMS_05M_MS_Fire_Step_Final
"""





[hiddenAction_ZN_EMS_05M_MS_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_EMS_05M_MS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_ZN_EMS_05M_MS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_EMS_05M_MS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_L_Step_1
[hiddenAction_ZN_EMS_05M_MS_Fire_Step_3]
@copyFromSection:hiddenAction_ZN_EMS_05M_MS_Fire_Step_2
buildSpeed:${turret_ZN_EMS_05M_MS.delay}
[hiddenAction_ZN_EMS_05M_MS_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


