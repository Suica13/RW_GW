[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw
"""
@memory EF_TorpedoBoat_Cannon_OnCD:bool
@memory EF_TorpedoBoat_Cannon_CDTimer:float
@global EF_TorpedoBoat_Cannon_CD=3
@global EF_TorpedoBoat_Cannon_EN=5

@global EF_TorpedoBoat_Cannon_Shoot=1
[resource_EF_TorpedoBoat_Cannon_ShootTimer]
hidden:true







[turret_EF_TorpedoBoat_Cannon]
x:0
y:26.5

canShoot:true
onShoot_triggerActions:SendEnemyTryAttack_Shoot
canAttackCondition:"""
if ${onAttacking}==false and ${cantAction}==false 
"""
showRangeUIGuide:false
projectile:EF_TorpedoBoat_Cannon_Projectile
resourceUsage:EF_TorpedoBoat_Cannon_ShootTimer=1,en=${EF_TorpedoBoat_Cannon_EN}

delay:0.0s
canAttackMaxAngle:3
barrelX:0
barrelY:5
turnSpeed:1.0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Bazooka_1.ogg
shoot_sound_vol:0.35
shoot_flame:BZ_Fire_1


idleSweepAngle:15
idleSweepAddRandomAngle:10
idleSweepDelay:240
idleSweepAddRandomDelay:120
idleSweepSpeed:0.25
idleSweepCondition:if memory.close==false


[projectile_EF_TorpedoBoat_Cannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_S*1
(
    addResources=
    ShellDamage:2750
    |DpDamage:100
    |WeaponAccuracy=75
    |PartBreakModifier=1.0
    |CockpitBreakModifier=2.0
    |PilotDamageModifier=2.0
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.15 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:50
    |ProjectileSpread:4
    |ProjectileExplosionRange:30
    |ProjectileLife:25
)
"""



[hiddenAction_EF_TorpedoBoat_Cannon_CDStart]
autoTrigger:"""
if memory.EF_TorpedoBoat_Cannon_OnCD==false 
and 
(
    (
        self.resource.EF_TorpedoBoat_Cannon_ShootTimer<=0 
    ) 
    or 
    (
        self.resource.EF_TorpedoBoat_Cannon_ShootTimer<${EF_TorpedoBoat_Cannon_Shoot} and not self.hasTags(includes='inBattle')
    )
)
"""
setUnitMemory:EF_TorpedoBoat_Cannon_OnCD=true,EF_TorpedoBoat_Cannon_CDTimer=self.timeAlive+${EF_TorpedoBoat_Cannon_CD}

[hiddenAction_EF_TorpedoBoat_Cannon_CDEnd]
autoTriggerOnEvent:created
autoTrigger:if memory.EF_TorpedoBoat_Cannon_OnCD==true and self.timeAlive>memory.EF_TorpedoBoat_Cannon_CDTimer
setUnitMemory:EF_TorpedoBoat_Cannon_OnCD=false
setResourcesWithLogic:EF_TorpedoBoat_Cannon_ShootTimer=${EF_TorpedoBoat_Cannon_Shoot}
