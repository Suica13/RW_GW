[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""


@memory ZN_MS_06JK_Gatling_CDTimer:float
@global ZN_MS_06JK_Gatling_CD=5
@global ZN_MS_06JK_Gatling_EN=20










[turret_ZN_MS_06JK_Gatling]
x:0
y:0

canShoot:false
projectile:ZN_MS_06JK_Gatling_Projectile

delay:0.075s
limitingRange:0

canAttackMaxAngle:15
barrelX:9
barrelY:15

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Vulcan_1.ogg
shoot_sound_vol:0.2
shoot_flame:MG_Fire_1



[projectile_ZN_MS_06JK_Gatling_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Vulcan*2
(
    offsetRandomXY=5,
    offsetDir=2.5,
    offsetRandomDir=7.5,
    addResources=
    ShellDamage:350
    |DpDamage:10
    |WeaponAccuracy=100
    |PartBreakModifier=0.5
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=0.5
    |AntiAqua=0.75
    |AntiAir=1.75
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=3 
    |HeightHitRange=20
    |ProjectileSpeed:100
    |ProjectileSpread:8
    |ProjectileLife:7.5
)
"""







[hiddenAction_ZN_MS_06JK_Gatling_Trigger]
alsoTriggerAction:ZN_MS_06JK_Gatling_Fire
[hiddenAction_ZN_MS_06JK_Gatling_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MS_06JK_Gatling_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:ZN_MS_06JK_Gatling_CDTimer=self.timeAlive+${ZN_MS_06JK_Gatling_CD}
addResources:EN=-${ZN_MS_06JK_Gatling_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_MS_06JK_Gatling_SetWeaponIndex,
ZN_MS_06JK_Gatling_B15_Step_1
"""
[hiddenAction_ZN_MS_06JK_Gatling_B15_Step_1]
alsoQueueAction:"""
ZN_MS_06JK_Gatling_Fire_Step_1,
ZN_MS_06JK_Gatling_Fire_Step_2,
ZN_MS_06JK_Gatling_Fire_Step_3,
ZN_MS_06JK_Gatling_Fire_Step_3,
ZN_MS_06JK_Gatling_Fire_Step_3,
ZN_MS_06JK_Gatling_Fire_Step_3,
ZN_MS_06JK_Gatling_Fire_Step_3,
ZN_MS_06JK_Gatling_Fire_Step_3,
ZN_MS_06JK_Gatling_Fire_Step_3,
ZN_MS_06JK_Gatling_Fire_Step_3,
ZN_MS_06JK_Gatling_Fire_Step_3,
ZN_MS_06JK_Gatling_Fire_Step_3,
ZN_MS_06JK_Gatling_Fire_Step_3,
ZN_MS_06JK_Gatling_Fire_Step_3,
ZN_MS_06JK_Gatling_Fire_Step_3,
ZN_MS_06JK_Gatling_Fire_Step_3,
ZN_MS_06JK_Gatling_Fire_Step_Final
"""





[hiddenAction_ZN_MS_06JK_Gatling_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MS_06JK_Gatling_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
alsoTriggerAction:PlayCommon_Cannon_Shoot_A_Step_1
[hiddenAction_ZN_MS_06JK_Gatling_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_MS_06JK_Gatling
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MS_06JK_Gatling_Fire_Step_3]
@copyFromSection:hiddenAction_ZN_MS_06JK_Gatling_Fire_Step_2
buildSpeed:${turret_ZN_MS_06JK_Gatling.delay}
[hiddenAction_ZN_MS_06JK_Gatling_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


