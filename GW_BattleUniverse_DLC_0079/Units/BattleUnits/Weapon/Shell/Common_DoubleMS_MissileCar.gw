[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw
"""

@memory Common_DoubleMS_MissileCar_OnCD:bool
@memory Common_DoubleMS_MissileCar_CDTimer:float
@global Common_DoubleMS_MissileCar_CD=3
@global Common_DoubleMS_MissileCar_EN=5

@global Common_DoubleMS_MissileCar_Shoot=5
[resource_Common_DoubleMS_MissileCar_ShootTimer]
hidden:true










[turret_Common_DoubleMS_MissileCar]
x:0
y:0

canShoot:true
canAttackCondition:"""
if ${cantAction}==false 
"""
showRangeUIGuide:false
resourceUsage:Common_DoubleMS_MissileCar_ShootTimer=1,en=${Common_DoubleMS_MissileCar_EN}
projectile:Common_DoubleMS_MissileCar_Projectile

delay:0.15s
limitingRange:1200
limitingAngle:360
turnSpeed:0

canAttackMaxAngle:360
barrelX:2.5
barrelY:-12.5
barrelOffsetX_onOddShots:-5

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.15
shoot_flame:BZ_Fire_1_S



[projectile_Common_DoubleMS_MissileCar_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS*1
(
    addResources=
    ShellDamage:500
    |DpDamage:20
    |WeaponAccuracy=95
    |PartBreakModifier=1.0
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1.5
    |AntiLand=1
    |AntiSpace=1
    |HeightHitRange=20
    |HeightChangeSpeed=2
    |ProjectileSpeed:50
    |ProjectileTurnspeed:3.5
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:20

    |EquipmentIndex:1
    |EquipmentIndex2:150
)
"""




[hiddenAction_Common_DoubleMS_MissileCar_CDStart]
autoTrigger:"""
if memory.Common_DoubleMS_MissileCar_OnCD==false 
and 
(
    (
        self.resource.Common_DoubleMS_MissileCar_ShootTimer<=0 
    ) 
    or 
    (
        self.resource.Common_DoubleMS_MissileCar_ShootTimer<${Common_DoubleMS_MissileCar_Shoot} and not self.hasTags(includes='inBattle')
    )
)
"""
setUnitMemory:Common_DoubleMS_MissileCar_OnCD=true,Common_DoubleMS_MissileCar_CDTimer=self.timeAlive+${Common_DoubleMS_MissileCar_CD}

[hiddenAction_Common_DoubleMS_MissileCar_CDEnd]
autoTriggerOnEvent:created
autoTrigger:if memory.Common_DoubleMS_MissileCar_OnCD==true and self.timeAlive>memory.Common_DoubleMS_MissileCar_CDTimer
setUnitMemory:Common_DoubleMS_MissileCar_OnCD=false
setResourcesWithLogic:Common_DoubleMS_MissileCar_ShootTimer=${Common_DoubleMS_MissileCar_Shoot}
