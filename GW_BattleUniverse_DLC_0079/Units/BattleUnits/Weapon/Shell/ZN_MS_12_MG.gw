[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw
"""

@memory ZN_MS_12_MG_OnCD:bool
@memory ZN_MS_12_MG_CDTimer:float
@global ZN_MS_12_MG_CD=3
@global ZN_MS_12_MG_EN=1

@global ZN_MS_12_MG_Shoot=12
[resource_ZN_MS_12_MG_ShootTimer]
hidden:true









[turret_ZN_MS_12_MG]
x:0
y:0

canShoot:true
canAttackCondition:"""
if ${cantAction}==false  and ${onSkill}==false 
"""
showRangeUIGuide:false
projectile:ZN_MS_12_MG_Projectile
resourceUsage:ZN_MS_12_MG_ShootTimer=1,en=${ZN_MS_12_MG_EN}

delay:0.1s
limitingRange:500
canAttackMaxAngle:8
turnSpeed:0.5

barrelX:13
barrelY:23

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0


idleSweepAngle:3
idleSweepAddRandomAngle:10
idleSweepDelay:240
idleSweepAddRandomDelay:120
idleSweepSpeed:0.25
idleSweepCondition:if memory.close==false

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_2.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_ZN_MS_12_MG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Vulcan*2
(
    offsetRandomXY=5,
    offsetDir=2.5,
    offsetRandomDir=7.5,
    addResources=
    ShellDamage:300
    |DpDamage:10
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=25
    |ProjectileSpeed:85
    |ProjectileSpread:8
    |ProjectileLife:20
)
"""



[hiddenAction_ZN_MS_12_MG_CDStart]
autoTrigger:"""
if memory.ZN_MS_12_MG_OnCD==false 
and 
(
    (
        self.resource.ZN_MS_12_MG_ShootTimer<=0 
    ) 
    or 
    (
        self.resource.ZN_MS_12_MG_ShootTimer<${ZN_MS_12_MG_Shoot} and not self.hasTags(includes='inBattle')
    )
)
"""
setUnitMemory:ZN_MS_12_MG_OnCD=true,ZN_MS_12_MG_CDTimer=self.timeAlive+${ZN_MS_12_MG_CD}

[hiddenAction_ZN_MS_12_MG_CDEnd]
autoTriggerOnEvent:created
autoTrigger:if memory.ZN_MS_12_MG_OnCD==true and self.timeAlive>memory.ZN_MS_12_MG_CDTimer
setUnitMemory:ZN_MS_12_MG_OnCD=false
setResourcesWithLogic:ZN_MS_12_MG_ShootTimer=${ZN_MS_12_MG_Shoot}
