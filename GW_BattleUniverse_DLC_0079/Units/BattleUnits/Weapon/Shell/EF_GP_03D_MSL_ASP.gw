[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Common/Common_Flash_1.gw,
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw
"""

@memory EF_GP_03D_MSL_ASP_CDTimer:float
@global EF_GP_03D_MSL_ASP_CD=90
@global EF_GP_03D_MSL_ASP_EN=250





[turret_EF_GP_03D_MSL_ASP]
x:0
y:0

canShoot:false
showRangeUIGuide:false
projectile:EF_GP_03D_MSL_ASP_Projectile

delay:0.2s
limitingRange:600
limitingAngle:15

canAttackMaxAngle:15
barrelX:40
barrelY:25

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/Bomb_1.ogg
shoot_sound_vol:0.25
shoot_flame:BZ_Fire_1_S
[turret_EF_GP_03D_MSL_ASP_L]
@copyFromSection:turret_EF_GP_03D_MSL_ASP
barrelX:-40



[projectile_EF_GP_03D_MSL_ASP_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
EF_GP_03D_MSL_ASP*1
"""


[action_EF_GP_03D_MSL_ASP_Trigger]
pos:10
text:MSL[ASP] %{select(self.timeAlive<=memory.EF_GP_03D_MSL_ASP_CDTimer,str(int(memory.EF_GP_03D_MSL_ASP_CDTimer-self.timeAlive))+"s","OK")}
text_zh:导弹货柜[ASP] %{select(self.timeAlive<=memory.EF_GP_03D_MSL_ASP_CDTimer,str(int(memory.EF_GP_03D_MSL_ASP_CDTimer-self.timeAlive))+"秒","OK")}
text_KP:100

displayType:infoOnly

buildSpeed:0s
allowMultipleInQueue:false
alwaysSinglePress:true


iconImage:ROOT:Resource/Image/Units/Button/Weapon/Missile_3.png
highPriorityQueue:true

price:EN=${EF_GP_03D_MSL_ASP_EN}


isVisible:if self.parent.hp<=0  

isGuiBlinking:"""
if self.timeAlive>memory.EF_GP_03D_MSL_ASP_CDTimer
"""

isLocked:if self.timeAlive<=memory.EF_GP_03D_MSL_ASP_CDTimer
isLockedMessage:In CD
isLockedMessage_zh:冷却中
isLockedAlt2:if ${cantAction}==true or ${onSkill}==true or ${allowAI}==true
isLockedAlt2Message:Cant Action
isLockedAlt2Message_zh:无法行动

setUnitMemory:EF_GP_03D_MSL_ASP_CDTimer=self.timeAlive+${EF_GP_03D_MSL_ASP_CD}
alsoTriggerAction:EF_GP_03D_MSL_ASP_Fire
[hiddenAction_EF_GP_03D_MSL_ASP_Fire]
setUnitMemory:EF_GP_03D_MSL_ASP_CDTimer=self.timeAlive+${EF_GP_03D_MSL_ASP_CD} 
addResourcesWithLogic:EN=-select(self.isControlledByAI(),${EF_GP_03D_MSL_ASP_EN},0)
alsoTriggerAction:"""
SetAttackingOn,
SetOnSkillOn,
SendEnemyTryAttack_Shoot,
EF_GP_03D_MSL_ASP_SetWeaponIndex,
EF_GP_03D_MSL_ASP_B2_Step_1
"""
[hiddenAction_EF_GP_03D_MSL_ASP_B2_Step_1]
alsoQueueAction:"""
EF_GP_03D_MSL_ASP_Fire_Step_1,
EF_GP_03D_MSL_ASP_Fire_Step_2,
EF_GP_03D_MSL_ASP_Fire_Step_Final
"""
spawnEffects:Flash_1_N





[hiddenAction_EF_GP_03D_MSL_ASP_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_GP_03D_MSL_ASP_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
[hiddenAction_EF_GP_03D_MSL_ASP_Fire_Step_2]
requireConditional:if ${cantAction}==false
buildSpeed:0.0s
fireTurretXAtGround:EF_GP_03D_MSL_ASP
fireTurretXAtGround_withTarget:self.getOffsetRelative(x=100,y=1000)
alsoTriggerAction:EF_GP_03D_MSL_ASP_Fire_Step_Sub
[hiddenAction_EF_GP_03D_MSL_ASP_Fire_Step_Sub]
requireConditional:if ${cantAction}==false
buildSpeed:0.0s
fireTurretXAtGround:EF_GP_03D_MSL_ASP_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(x=-100,y=1000)
[hiddenAction_EF_GP_03D_MSL_ASP_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:"""
SetOnSkillOff,
SetAttackingOff
"""