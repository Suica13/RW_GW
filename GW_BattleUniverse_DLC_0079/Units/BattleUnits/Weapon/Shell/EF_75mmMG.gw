[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""


@memory EF_75mmMG_CDTimer:float
@global EF_75mmMG_CD=2
@global EF_75mmMG_EN=25





[decal_EF_75mmMG]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\EF_75mmMG.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.85
xOffsetRelative: 0
yOffsetRelative: 16
dirOffset:0
[decal_EF_75mmMG_NotUsing]
@copyFromSection:decal_EF_75mmMG
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.75
xOffsetRelative:-1
yOffsetRelative:-9.5
dirOffset:-90







[turret_EF_75mmMG]
x:0
y:0

canShoot:false
projectile:EF_75mmMG_Projectile

delay:0.05s
limitingRange:0

canAttackMaxAngle:15
barrelX:8
barrelY:20

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_2.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_EF_75mmMG_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:475
    |DpDamage:40
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:5
    |ProjectileLife:20
)
"""







[hiddenAction_EF_75mmMG_Trigger]
alsoTriggerAction:EF_75mmMG_Fire
[hiddenAction_EF_75mmMG_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_75mmMG_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_75mmMG_CDTimer=self.timeAlive+${EF_75mmMG_CD}
addResources:EN=-${EF_75mmMG_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_75mmMG_SetWeaponIndex,
EF_75mmMG_B9_Step_1
"""
[hiddenAction_EF_75mmMG_B9_Step_1]
alsoQueueAction:"""
EF_75mmMG_Fire_Step_1,
EF_75mmMG_Fire_Step_2,
EF_75mmMG_Fire_Step_3,
EF_75mmMG_Fire_Step_3,
EF_75mmMG_Fire_Step_3,
EF_75mmMG_Fire_Step_3,
EF_75mmMG_Fire_Step_3,
EF_75mmMG_Fire_Step_3,
EF_75mmMG_Fire_Step_3,
EF_75mmMG_Fire_Step_3,
EF_75mmMG_Fire_Step_Final
"""





[hiddenAction_EF_75mmMG_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_75mmMG_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.2s
[hiddenAction_EF_75mmMG_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_75mmMG
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_EF_75mmMG_Fire_Step_3]
@copyFromSection:hiddenAction_EF_75mmMG_Fire_Step_2
buildSpeed:${turret_EF_75mmMG.delay}
[hiddenAction_EF_75mmMG_Fire_Step_Final]
buildSpeed:0.2s
alsoTriggerAction:SetAttackingOff


