[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""


@memory EF_RAG_79_G1_MS_CDTimer:float
@global EF_RAG_79_G1_MS_CD=6
@global EF_RAG_79_G1_MS_EN=35










[turret_EF_RAG_79_G1_MS]
x:0
y:0

canShoot:false
projectile:EF_RAG_79_G1_MS_Projectile

delay:0.15s
limitingRange:0

canAttackMaxAngle:15
barrelX:6
barrelY:-15

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.25
shoot_flame:BZ_Fire_1_S
[turret_EF_RAG_79_G1_MS_L]
@copyFromSection:turret_EF_RAG_79_G1_MS
barrelX:-6



[projectile_EF_RAG_79_G1_MS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS_L*1
(
    addResources=
    ShellDamage:2250
    |DpDamage:60
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=1.5
    |AntiAir=0.5 
    |AntiLand=1
    |AntiSpace=1
    |HeightHitRange=20
    |HeightChangeSpeed=2
    |ProjectileSpeed:35
    |ProjectileTurnspeed:1.5
    |ProjectileSpread:0
    |ProjectileExplosionRange:55
    |ProjectileLife:45
)
"""







[hiddenAction_EF_RAG_79_G1_MS_Trigger]
alsoTriggerAction:EF_RAG_79_G1_MS_Fire
[hiddenAction_EF_RAG_79_G1_MS_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RAG_79_G1_MS_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_RAG_79_G1_MS_CDTimer=self.timeAlive+${EF_RAG_79_G1_MS_CD}
addResources:EN=-${EF_RAG_79_G1_MS_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RAG_79_G1_MS_SetWeaponIndex,
EF_RAG_79_G1_MS_B2_Step_1
"""
[hiddenAction_EF_RAG_79_G1_MS_B2_Step_1]
alsoQueueAction:"""
EF_RAG_79_G1_MS_Fire_Step_1,
EF_RAG_79_G1_MS_Fire_Step_2,
EF_RAG_79_G1_MS_Fire_Step_Final
"""





[hiddenAction_EF_RAG_79_G1_MS_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RAG_79_G1_MS_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
alsoTriggerAction:PlayCommon_Cannon_Shoot_A_Step_1
[hiddenAction_EF_RAG_79_G1_MS_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RAG_79_G1_MS
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:EF_RAG_79_G1_MS_Fire_Step_Sub
[hiddenAction_EF_RAG_79_G1_MS_Fire_Step_3]
@copyFromSection:hiddenAction_EF_RAG_79_G1_MS_Fire_Step_2
buildSpeed:${turret_EF_RAG_79_G1_MS.delay}

[hiddenAction_EF_RAG_79_G1_MS_Fire_Step_Sub]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RAG_79_G1_MS_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_EF_RAG_79_G1_MS_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


