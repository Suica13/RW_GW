[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A_L.gw
"""


@memory ZN_105mmMG_L_CDTimer:float
@global ZN_105mmMG_L_CD=1.5
@global ZN_105mmMG_L_EN=20





[decal_ZN_105mmMG_L]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\ZN_105mmMG.png
isVisible:false
basePositionFromLegEnd:arm3
imageScale:1
xOffsetRelative: -2
yOffsetRelative: 15
dirOffset:0
[decal_ZN_105mmMG_L_NotUsing]
@copyFromSection:decal_ZN_105mmMG_L
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.9
xOffsetRelative:1
yOffsetRelative:-8.5
dirOffset:-90








[turret_ZN_105mmMG_L]
x:0
y:0

canShoot:false
projectile:ZN_105mmMG_L_Projectile

delay:0.075s
limitingRange:0

canAttackMaxAngle:15
barrelX:-11
barrelY:30

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_2.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_ZN_105mmMG_L_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:375
    |DpDamage:25
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:8
    |ProjectileLife:20
)
"""







[hiddenAction_ZN_105mmMG_L_Trigger]
alsoTriggerAction:ZN_105mmMG_L_Fire
[hiddenAction_ZN_105mmMG_L_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_105mmMG_L_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:ZN_105mmMG_L_CDTimer=self.timeAlive+${ZN_105mmMG_L_CD}
addResources:EN=-${ZN_105mmMG_L_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_105mmMG_L_SetWeaponIndex,
ZN_105mmMG_L_B8_Step_1
"""
[hiddenAction_ZN_105mmMG_L_B8_Step_1]
alsoQueueAction:"""
ZN_105mmMG_L_Fire_Step_1,
ZN_105mmMG_L_Fire_Step_2,
ZN_105mmMG_L_Fire_Step_3,
ZN_105mmMG_L_Fire_Step_3,
ZN_105mmMG_L_Fire_Step_3,
ZN_105mmMG_L_Fire_Step_3,
ZN_105mmMG_L_Fire_Step_3,
ZN_105mmMG_L_Fire_Step_3,
ZN_105mmMG_L_Fire_Step_3,
ZN_105mmMG_L_Fire_Step_Final
"""





[hiddenAction_ZN_105mmMG_L_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_105mmMG_L_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_ZN_105mmMG_L_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_105mmMG_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_L_Step_1
[hiddenAction_ZN_105mmMG_L_Fire_Step_3]
@copyFromSection:hiddenAction_ZN_105mmMG_L_Fire_Step_2
buildSpeed:${turret_ZN_105mmMG_L.delay}
[hiddenAction_ZN_105mmMG_L_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


