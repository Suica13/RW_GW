[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""


@memory EF_RTX_440_Rocket_CDTimer:float
@global EF_RTX_440_Rocket_CD=18
@global EF_RTX_440_Rocket_EN=35










[turret_EF_RTX_440_Rocket]
x:0
y:0

canShoot:false
projectile:EF_RTX_440_Rocket_Projectile

delay:0.15s
limitingRange:0

canAttackMaxAngle:15
barrelX:-16
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.25
shoot_flame:BZ_Fire_1_S
[turret_EF_RTX_440_Rocket_L]
@copyFromSection:turret_EF_RTX_440_Rocket
barrelX:-18



[projectile_EF_RTX_440_Rocket_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS*1
(
    addResources=
    ShellDamage:1750
    |DpDamage:45
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightHitRange=20
    |HeightChangeSpeed=2
    |ProjectileSpeed:35
    |ProjectileTurnspeed:0.15
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:45
)
"""







[hiddenAction_EF_RTX_440_Rocket_Trigger]
alsoTriggerAction:EF_RTX_440_Rocket_Fire
[hiddenAction_EF_RTX_440_Rocket_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RTX_440_Rocket_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_RTX_440_Rocket_CDTimer=self.timeAlive+${EF_RTX_440_Rocket_CD}
addResources:EN=-${EF_RTX_440_Rocket_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RTX_440_Rocket_SetWeaponIndex,
EF_RTX_440_Rocket_B10_Step_1
"""
[hiddenAction_EF_RTX_440_Rocket_B10_Step_1]
alsoQueueAction:"""
EF_RTX_440_Rocket_Fire_Step_1,
EF_RTX_440_Rocket_Fire_Step_2,
EF_RTX_440_Rocket_Fire_Step_4,
EF_RTX_440_Rocket_Fire_Step_3,
EF_RTX_440_Rocket_Fire_Step_4,
EF_RTX_440_Rocket_Fire_Step_3,
EF_RTX_440_Rocket_Fire_Step_4,
EF_RTX_440_Rocket_Fire_Step_3,
EF_RTX_440_Rocket_Fire_Step_4,
EF_RTX_440_Rocket_Fire_Step_3,
EF_RTX_440_Rocket_Fire_Step_4,
EF_RTX_440_Rocket_Fire_Step_Final
"""





[hiddenAction_EF_RTX_440_Rocket_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RTX_440_Rocket_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
alsoTriggerAction:PlayCommon_Cannon_Shoot_A_Step_1
[hiddenAction_EF_RTX_440_Rocket_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RTX_440_Rocket
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_RTX_440_Rocket_Fire_Step_3]
@copyFromSection:hiddenAction_EF_RTX_440_Rocket_Fire_Step_2
buildSpeed:${turret_EF_RTX_440_Rocket.delay}

[hiddenAction_EF_RTX_440_Rocket_Fire_Step_4]
@copyFromSection:hiddenAction_EF_RTX_440_Rocket_Fire_Step_3
fireTurretXAtGround:EF_RTX_440_Rocket_L

[hiddenAction_EF_RTX_440_Rocket_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


