[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw
"""

@memory EF_RMV_1_DoubleMS_OnCD:bool
@memory EF_RMV_1_DoubleMS_CDTimer:float
@global EF_RMV_1_DoubleMS_CD=6
@global EF_RMV_1_DoubleMS_EN=10

@global EF_RMV_1_DoubleMS_Shoot=8
[resource_EF_RMV_1_DoubleMS_ShootTimer]
hidden:true









[turret_EF_RMV_1_DoubleMS]
x:0
y:0

canShoot:true
canAttackCondition:"""
if ${cantAction}==false  and ${onSkill}==false 
"""
showRangeUIGuide:false
projectile:EF_RMV_1_DoubleMS_Projectile
resourceUsage:EF_RMV_1_DoubleMS_ShootTimer=1,en=${EF_RMV_1_DoubleMS_EN}

delay:0.125s
limitingRange:500
canAttackMaxAngle:360
turnSpeed:0.5

barrelX:14
barrelY:10
barrelOffsetX_onOddShots:-28

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0


idleSweepAngle:3
idleSweepAddRandomAngle:10
idleSweepDelay:240
idleSweepAddRandomDelay:120
idleSweepSpeed:0.25
idleSweepCondition:if memory.close==false

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Missile_1.ogg
shoot_sound_vol:0.2
shoot_flame:BZ_Fire_1_S



[projectile_EF_RMV_1_DoubleMS_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MS*1
(
    addResources=
    ShellDamage:450
    |DpDamage:50
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=0.75
    |AntiAir=1.25
    |AntiLand=1
    |AntiSpace=1.0
    |HeightHitRange=20
    |HeightChangeSpeed=2
    |ProjectileSpeed:35
    |ProjectileTurnspeed:1.5
    |ProjectileSpread:0
    |ProjectileExplosionRange:35
    |ProjectileLife:45
)
"""



[hiddenAction_EF_RMV_1_DoubleMS_CDStart]
autoTrigger:"""
if memory.EF_RMV_1_DoubleMS_OnCD==false 
and 
(
    (
        self.resource.EF_RMV_1_DoubleMS_ShootTimer<=0 
    ) 
    or 
    (
        self.resource.EF_RMV_1_DoubleMS_ShootTimer<${EF_RMV_1_DoubleMS_Shoot} and not self.hasTags(includes='inBattle')
    )
)
"""
setUnitMemory:EF_RMV_1_DoubleMS_OnCD=true,EF_RMV_1_DoubleMS_CDTimer=self.timeAlive+${EF_RMV_1_DoubleMS_CD}

[hiddenAction_EF_RMV_1_DoubleMS_CDEnd]
autoTriggerOnEvent:created
autoTrigger:if memory.EF_RMV_1_DoubleMS_OnCD==true and self.timeAlive>memory.EF_RMV_1_DoubleMS_CDTimer
setUnitMemory:EF_RMV_1_DoubleMS_OnCD=false
setResourcesWithLogic:EF_RMV_1_DoubleMS_ShootTimer=${EF_RMV_1_DoubleMS_Shoot}
