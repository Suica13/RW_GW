[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw
"""


@memory Common_DoubleGun_FX_550_CDTimer:float
@global Common_DoubleGun_FX_550_CD=2
@global Common_DoubleGun_FX_550_EN=6





[turret_Common_DoubleGun_FX_550]
x:0
y:0

canShoot:false
showRangeUIGuide:false
projectile:Common_DoubleGun_FX_550_Projectile

delay:0.075s
limitingRange:1200
limitingAngle:15

canAttackMaxAngle:15
barrelX:3
barrelY:-2

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/Vulcan_1.ogg
shoot_sound_vol:0.15
shoot_flame:MG_Fire_1_S
[turret_Common_DoubleGun_FX_550_L]
@copyFromSection:turret_Common_DoubleGun_FX_550
barrelX:-3



[projectile_Common_DoubleGun_FX_550_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:475
    |DpDamage:40
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:5
    |ProjectileLife:25
)
"""


[hiddenAction_Common_DoubleGun_FX_550_Trigger]
alsoTriggerAction:Common_DoubleGun_FX_550_Fire
[hiddenAction_Common_DoubleGun_FX_550_Fire]
requireConditional:"""
if self.timeAlive>memory.Common_DoubleGun_FX_550_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  
and not (directionBetween(self, self.attacking) < self.dir-25 or directionBetween(self, self.attacking) > self.dir+25)  
and self.resource.EN>0
"""
setUnitMemory:Common_DoubleGun_FX_550_CDTimer=self.timeAlive+${Common_DoubleGun_FX_550_CD} 
addResources:EN=-${Common_DoubleGun_FX_550_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
Common_DoubleGun_FX_550_SetWeaponIndex,
Common_DoubleGun_FX_550_B6_Step_1
"""
[hiddenAction_Common_DoubleGun_FX_550_B6_Step_1]
alsoQueueAction:"""
Common_DoubleGun_FX_550_Fire_Step_1,
Common_DoubleGun_FX_550_Fire_Step_2,
Common_DoubleGun_FX_550_Fire_Step_3,
Common_DoubleGun_FX_550_Fire_Step_4,
Common_DoubleGun_FX_550_Fire_Step_3,
Common_DoubleGun_FX_550_Fire_Step_4,
Common_DoubleGun_FX_550_Fire_Step_3,
Common_DoubleGun_FX_550_Fire_Step_Final
"""




[hiddenAction_Common_DoubleGun_FX_550_SetWeaponIndex]
isVisible:false


[hiddenAction_Common_DoubleGun_FX_550_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
[hiddenAction_Common_DoubleGun_FX_550_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:Common_DoubleGun_FX_550
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_Common_DoubleGun_FX_550_Fire_Step_3]
@copyFromSection:hiddenAction_Common_DoubleGun_FX_550_Fire_Step_2
buildSpeed:${turret_Common_DoubleGun_FX_550.delay}
[hiddenAction_Common_DoubleGun_FX_550_Fire_Step_4]
@copyFromSection:hiddenAction_Common_DoubleGun_FX_550_Fire_Step_3
fireTurretXAtGround:Common_DoubleGun_FX_550_L
[hiddenAction_Common_DoubleGun_FX_550_Fire_Step_Final]
buildSpeed:0.1s
alsoTriggerAction:SetAttackingOff