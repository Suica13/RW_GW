[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory EF_RB_79K_Cannon_CDTimer:float
@global EF_RB_79K_Cannon_CD=3
@global EF_RB_79K_Cannon_EN=50










[turret_EF_RB_79K_Cannon]
x:0
y:0

canShoot:false
projectile:EF_RB_79K_Cannon_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:-5
barrelY:10
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\Bazooka_1.ogg
shoot_sound_vol:0.4
shoot_flame:BZ_Fire_1
[turret_EF_RB_79K_Cannon_R]
@copyFromSection:turret_EF_RB_79K_Cannon
barrelX:5


[projectile_EF_RB_79K_Cannon_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_S*1
(
    addResources=
    ShellDamage:3000
    |DpDamage:250
    |WeaponAccuracy=75
    |PartBreakModifier=1.0
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1.0
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.0
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:50
    |ProjectileSpread:1
    |ProjectileExplosionRange:30
    |ProjectileLife:35
)
"""








[hiddenAction_EF_RB_79K_Cannon_Trigger]
alsoTriggerAction:EF_RB_79K_Cannon_Fire
[hiddenAction_EF_RB_79K_Cannon_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RB_79K_Cannon_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:EF_RB_79K_Cannon_CDTimer=self.timeAlive+${EF_RB_79K_Cannon_CD}
addResources:EN=-${EF_RB_79K_Cannon_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RB_79K_Cannon_SetWeaponIndex,
PlayCommon_Cannon_Shoot_A_Step_1,
EF_RB_79K_Cannon_B2_Step_1
"""
[hiddenAction_EF_RB_79K_Cannon_B2_Step_1]
alsoQueueAction:"""
EF_RB_79K_Cannon_Fire_Step_1,
EF_RB_79K_Cannon_Fire_Step_2,
EF_RB_79K_Cannon_Fire_Step_3,
EF_RB_79K_Cannon_Fire_Step_Final
"""




[hiddenAction_EF_RB_79K_Cannon_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RB_79K_Cannon_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_EF_RB_79K_Cannon_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RB_79K_Cannon
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_RB_79K_Cannon_Fire_Step_3]
@copyFromSection:hiddenAction_EF_RB_79K_Cannon_Fire_Step_2
buildSpeed:0.1s
fireTurretXAtGround:EF_RB_79K_Cannon_R
[hiddenAction_EF_RB_79K_Cannon_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


