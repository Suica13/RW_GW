[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/BZ_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory ZN_YMT_05_MainCannon_AP_CDTimer:float
@global ZN_YMT_05_MainCannon_AP_CD=9
@global ZN_YMT_05_MainCannon_AP_EN=75





[turret_ZN_YMT_05_MainCannon_AP]
x:0
y:0

canShoot:false
projectile:ZN_YMT_05_MainCannon_AP_Projectile

delay:0.3s
canAttackMaxAngle:15
barrelX:0
barrelY:40
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/APFSDS_1.ogg
shoot_sound_vol:1
shoot_flame:BZ_Fire_1



[projectile_ZN_YMT_05_MainCannon_AP_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_S_Target*1
(
    addResources=
    ShellDamage:5500
    |ShellAPDamage:5500
    |DpDamage:500
    |WeaponAccuracy=85
    |PartBreakModifier=1.5
    |CockpitBreakModifier=1.5
    |PilotDamageModifier=1.5
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:70
    |ProjectileSpread:1
    |ProjectileExplosionRange:30
    |ProjectileLife:30

    |ProjectileBlastRange:45
    |ProjectileBlastDamageModifier:0.125
    |ProjectileBlastDpModifier:0.5
)
"""








[hiddenAction_ZN_YMT_05_MainCannon_AP_Trigger]
alsoTriggerAction:ZN_YMT_05_MainCannon_AP_Fire
[hiddenAction_ZN_YMT_05_MainCannon_AP_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_YMT_05_MainCannon_AP_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:ZN_YMT_05_MainCannon_AP_CDTimer=self.timeAlive+${ZN_YMT_05_MainCannon_AP_CD}
addResources:EN=-${ZN_YMT_05_MainCannon_AP_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_YMT_05_MainCannon_AP_SetWeaponIndex,
PlayCommon_Cannon_Shoot_A_Step_1,
ZN_YMT_05_MainCannon_AP_B1_Step_1
"""
[hiddenAction_ZN_YMT_05_MainCannon_AP_B1_Step_1]
alsoQueueAction:"""
ZN_YMT_05_MainCannon_AP_Fire_Step_1,
ZN_YMT_05_MainCannon_AP_Fire_Step_2,
ZN_YMT_05_MainCannon_AP_Fire_Step_Final
"""




[hiddenAction_ZN_YMT_05_MainCannon_AP_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_YMT_05_MainCannon_AP_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.35s
[hiddenAction_ZN_YMT_05_MainCannon_AP_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_YMT_05_MainCannon_AP
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_YMT_05_MainCannon_AP_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


