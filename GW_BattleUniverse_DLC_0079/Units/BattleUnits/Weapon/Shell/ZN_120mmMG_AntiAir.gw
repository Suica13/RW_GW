[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""


@memory ZN_120mmMG_AntiAir_CDTimer:float
@global ZN_120mmMG_AntiAir_CD=2
@global ZN_120mmMG_AntiAir_EN=20





[decal_ZN_120mmMG_AntiAir]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\ZN_120mmMG_AntiAir.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 2
yOffsetRelative: 15
dirOffset:0
[decal_ZN_120mmMG_AntiAir_NotUsing]
@copyFromSection:decal_ZN_120mmMG_AntiAir
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.9
xOffsetRelative:1
yOffsetRelative:-8.5
dirOffset:-90








[turret_ZN_120mmMG_AntiAir]
x:0
y:0

canShoot:false
projectile:ZN_120mmMG_AntiAir_Projectile

delay:0.15s
limitingRange:0

canAttackMaxAngle:15
barrelX:11
barrelY:30

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_2.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_ZN_120mmMG_AntiAir_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_S_Target*1
(
    addResources=
    ShellDamage:850
    |DpDamage:50
    |WeaponAccuracy=85
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiAqua=0.75
    |AntiAir=2.5 
    |AntiLand=1
    |AntiSpace=1
    |AntiSizeLargeDamage=0.75
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=0.75
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:85
    |ProjectileSpread:0
    |ProjectileExplosionRange:40
    |ProjectileLife:35
)
"""







[hiddenAction_ZN_120mmMG_AntiAir_Trigger]
alsoTriggerAction:ZN_120mmMG_AntiAir_Fire
[hiddenAction_ZN_120mmMG_AntiAir_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_120mmMG_AntiAir_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:ZN_120mmMG_AntiAir_CDTimer=self.timeAlive+${ZN_120mmMG_AntiAir_CD}
addResources:EN=-${ZN_120mmMG_AntiAir_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_120mmMG_AntiAir_SetWeaponIndex,
ZN_120mmMG_AntiAir_B6_Step_1
"""
[hiddenAction_ZN_120mmMG_AntiAir_B6_Step_1]
alsoQueueAction:"""
ZN_120mmMG_AntiAir_Fire_Step_1,
ZN_120mmMG_AntiAir_Fire_Step_2,
ZN_120mmMG_AntiAir_Fire_Step_3,
ZN_120mmMG_AntiAir_Fire_Step_3,
ZN_120mmMG_AntiAir_Fire_Step_3,
ZN_120mmMG_AntiAir_Fire_Step_3,
ZN_120mmMG_AntiAir_Fire_Step_3,
ZN_120mmMG_AntiAir_Fire_Step_Final
"""





[hiddenAction_ZN_120mmMG_AntiAir_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_120mmMG_AntiAir_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_ZN_120mmMG_AntiAir_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_120mmMG_AntiAir
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_ZN_120mmMG_AntiAir_Fire_Step_3]
@copyFromSection:hiddenAction_ZN_120mmMG_AntiAir_Fire_Step_2
buildSpeed:${turret_ZN_120mmMG_AntiAir.delay}
[hiddenAction_ZN_120mmMG_AntiAir_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


