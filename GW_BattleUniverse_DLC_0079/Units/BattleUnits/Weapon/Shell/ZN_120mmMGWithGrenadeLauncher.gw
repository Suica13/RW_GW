[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""


@memory ZN_120mmMGWithGrenadeLauncher_CDTimer:float
@global ZN_120mmMGWithGrenadeLauncher_CD=2
@global ZN_120mmMGWithGrenadeLauncher_EN=30





[decal_ZN_120mmMGWithGrenadeLauncher]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\ZN_120mmMGWithGrenadeLauncher.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 2
yOffsetRelative: 15
dirOffset:0
[decal_ZN_120mmMGWithGrenadeLauncher_NotUsing]
@copyFromSection:decal_ZN_120mmMGWithGrenadeLauncher
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.9
xOffsetRelative:1
yOffsetRelative:-8.5
dirOffset:-90







[turret_ZN_120mmMGWithGrenadeLauncher]
x:0
y:0

canShoot:false
projectile:ZN_120mmMGWithGrenadeLauncher_Projectile

delay:0.125s
limitingRange:0

canAttackMaxAngle:15
barrelX:11
barrelY:30

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_2.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_ZN_120mmMGWithGrenadeLauncher_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:575
    |DpDamage:30
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:5
    |ProjectileLife:25
)
"""
[projectile_ZN_120mmMGWithGrenadeLauncher_Projectile_GD]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Bazooka_S*1
(
    addResources=
    ShellDamage:1750
    |DpDamage:100
    |WeaponAccuracy=85
    |PartBreakModifier=1.25
    |CockpitBreakModifier=0.75
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1.25
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1.25
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=0.75
    |AntiLand=1 
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:55
    |ProjectileSpread:2
    |ProjectileExplosionRange:35
    |ProjectileLife:25
)
"""






[hiddenAction_ZN_120mmMGWithGrenadeLauncher_Trigger]
alsoTriggerAction:ZN_120mmMGWithGrenadeLauncher_Fire
[hiddenAction_ZN_120mmMGWithGrenadeLauncher_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_120mmMGWithGrenadeLauncher_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:ZN_120mmMGWithGrenadeLauncher_CDTimer=self.timeAlive+${ZN_120mmMGWithGrenadeLauncher_CD}
addResources:EN=-${ZN_120mmMGWithGrenadeLauncher_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_120mmMGWithGrenadeLauncher_SetWeaponIndex,
ZN_120mmMGWithGrenadeLauncher_B8_Step_1
"""
[hiddenAction_ZN_120mmMGWithGrenadeLauncher_B8_Step_1]
alsoQueueAction:"""
ZN_120mmMGWithGrenadeLauncher_Fire_Step_1,
ZN_120mmMGWithGrenadeLauncher_Fire_Step_2,
ZN_120mmMGWithGrenadeLauncher_Fire_Step_3,
ZN_120mmMGWithGrenadeLauncher_Fire_Step_3,
ZN_120mmMGWithGrenadeLauncher_Fire_Step_3,
ZN_120mmMGWithGrenadeLauncher_Fire_Step_3,
ZN_120mmMGWithGrenadeLauncher_Fire_Step_3,
ZN_120mmMGWithGrenadeLauncher_Fire_Step_3,
ZN_120mmMGWithGrenadeLauncher_Fire_Step_3,
ZN_120mmMGWithGrenadeLauncher_Fire_Step_4,
ZN_120mmMGWithGrenadeLauncher_Fire_Step_Final
"""





[hiddenAction_ZN_120mmMGWithGrenadeLauncher_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_120mmMGWithGrenadeLauncher_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_ZN_120mmMGWithGrenadeLauncher_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_120mmMGWithGrenadeLauncher
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
alsoTriggerAction:PlayCommon_Shoot_A_Step_1
[hiddenAction_ZN_120mmMGWithGrenadeLauncher_Fire_Step_3]
@copyFromSection:hiddenAction_ZN_120mmMGWithGrenadeLauncher_Fire_Step_2
buildSpeed:${turret_ZN_120mmMGWithGrenadeLauncher.delay}
[hiddenAction_ZN_120mmMGWithGrenadeLauncher_Fire_Step_4]
@copyFromSection:hiddenAction_ZN_120mmMGWithGrenadeLauncher_Fire_Step_2
buildSpeed:${turret_ZN_120mmMGWithGrenadeLauncher.delay}
fireTurretXAtGround_withProjectile:ZN_120mmMGWithGrenadeLauncher_Projectile_GD
[hiddenAction_ZN_120mmMGWithGrenadeLauncher_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


