[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw
"""

@memory Common_SingleVulcan_OnCD:bool
@memory Common_SingleVulcan_CDTimer:float
@global Common_SingleVulcan_CD=3

@global Common_SingleVulcan_Shoot=14
[resource_Common_SingleVulcan_ShootTimer]
hidden:true









[turret_Common_SingleVulcan]
x:0
y:0

canShoot:true
canAttackCondition:"""
if ${cantAction}==false 
and distanceBetween(self,self.attacking)<=500 
and memory.headBreaked==false 
and 
(
    attacking.tags(includes='Aircraft') 
    or attacking.tags(includes='Tank') 
    or attacking.tags(includes='Pilot') 
    or memory.attackMode==1
)
"""
showRangeUIGuide:false
projectile:Common_SingleVulcan_Projectile
resourceUsage:Common_SingleVulcan_ShootTimer=1

delay:0.075s
limitingRange:1200
limitingAngle:3

canAttackMaxAngle:15
barrelX:-3
barrelY:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/Vulcan_1.ogg
shoot_sound_vol:0.2
shoot_flame:MG_Fire_1_S



[projectile_Common_SingleVulcan_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_Vulcan*1
(
    addResources=
    ShellDamage:300
    |DpDamage:10
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=0.5
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=1
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=1
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=2.0 
    |AntiLand=1
    |AntiSpace=2.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=25
    |ProjectileSpeed:90
    |ProjectileSpread:8
    |ProjectileLife:20
)
"""



[hiddenAction_Common_SingleVulcan_CDStart]
autoTrigger:"""
if memory.Common_SingleVulcan_OnCD==false 
and 
(
    (
        self.resource.Common_SingleVulcan_ShootTimer<=0 
    ) 
    or 
    (
        self.resource.Common_SingleVulcan_ShootTimer<${Common_SingleVulcan_Shoot} and not self.hasTags(includes='inBattle')
    )
)
"""
setUnitMemory:Common_SingleVulcan_OnCD=true,Common_SingleVulcan_CDTimer=self.timeAlive+${Common_SingleVulcan_CD}

[hiddenAction_Common_SingleVulcan_CDEnd]
autoTriggerOnEvent:created
autoTrigger:if memory.Common_SingleVulcan_OnCD==true and self.timeAlive>memory.Common_SingleVulcan_CDTimer
setUnitMemory:Common_SingleVulcan_OnCD=false
setResourcesWithLogic:Common_SingleVulcan_ShootTimer=${Common_SingleVulcan_Shoot}
