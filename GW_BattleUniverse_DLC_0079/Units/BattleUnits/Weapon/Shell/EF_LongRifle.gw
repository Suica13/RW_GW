[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Shell/Common/MG_Fire_1.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A2.gw
"""


@memory EF_LongRifle_CDTimer:float
@global EF_LongRifle_CD=3.5
@global EF_LongRifle_EN=45





[decal_EF_LongRifle]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Shell\Image\EF_LongRifle.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.85
xOffsetRelative: 0
yOffsetRelative: 12
dirOffset:0
[decal_EF_LongRifle_NotUsing]
@copyFromSection:decal_EF_LongRifle
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.75
xOffsetRelative:-1
yOffsetRelative:-8.5
dirOffset:-90






[turret_EF_LongRifle]
x:0
y:0

canShoot:false
projectile:EF_LongRifle_Projectile

delay:0.125s
limitingRange:0

canAttackMaxAngle:15
barrelX:8
barrelY:33

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\MachineGun_1.ogg
shoot_sound_vol:0.3
shoot_flame:MG_Fire_1



[projectile_EF_LongRifle_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_MG*1
(
    addResources=
    ShellDamage:900
    |ShellAPDamage:450
    |DpDamage:60
    |WeaponAccuracy=100
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1
    |AntiLand=1
    |AntiSpace=1.0
    |HeightChangeSpeed=2.0
    |HeightHitRange=20
    |ProjectileSpeed:100
    |ProjectileSpread:3
    |ProjectileLife:25
)
"""







[hiddenAction_EF_LongRifle_Trigger]
alsoTriggerAction:EF_LongRifle_Fire
[hiddenAction_EF_LongRifle_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_LongRifle_CDTimer and ${onAttacking}==false and ${cantAction}==false  and ${onSkill}==false 
and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30)  
and self.resource.EN>0
"""
setUnitMemory:EF_LongRifle_CDTimer=self.timeAlive+${EF_LongRifle_CD}
addResources:EN=-${EF_LongRifle_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
PlayCommon_Shoot_A2_Step_1,
EF_LongRifle_SetWeaponIndex,
EF_LongRifle_B12_Step_1
"""
[hiddenAction_EF_LongRifle_B12_Step_1]
alsoQueueAction:"""
EF_LongRifle_Fire_Step_1,
EF_LongRifle_Fire_Step_2,
EF_LongRifle_Fire_Step_3,
EF_LongRifle_Fire_Step_3,
EF_LongRifle_Fire_Step_4,

EF_LongRifle_Fire_Step_3,
EF_LongRifle_Fire_Step_3,
EF_LongRifle_Fire_Step_3,
EF_LongRifle_Fire_Step_4,

EF_LongRifle_Fire_Step_3,
EF_LongRifle_Fire_Step_3,
EF_LongRifle_Fire_Step_3,
EF_LongRifle_Fire_Step_4,

EF_LongRifle_Fire_Step_3,
EF_LongRifle_Fire_Step_3,
EF_LongRifle_Fire_Step_3,
EF_LongRifle_Fire_Step_Final
"""





[hiddenAction_EF_LongRifle_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_LongRifle_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.3s
[hiddenAction_EF_LongRifle_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_LongRifle
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_LongRifle_Fire_Step_3]
@copyFromSection:hiddenAction_EF_LongRifle_Fire_Step_2
buildSpeed:${turret_EF_LongRifle.delay}
[hiddenAction_EF_LongRifle_Fire_Step_4]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.2s
[hiddenAction_EF_LongRifle_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff


