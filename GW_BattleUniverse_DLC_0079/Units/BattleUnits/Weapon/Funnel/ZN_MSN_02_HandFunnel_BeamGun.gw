fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
whenBuilding_cannotMove:true
[hiddenAction_ZN_MSN_02_HandFunnel_BeamGun_Fire_Step_Final]
buildSpeed:0s
alsoTriggerAction:"""
SetAttackingOff
"""