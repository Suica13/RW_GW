[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw
"""

@memory ZN_MSN_02_HandFunnel_BeamGun_CDTimer:float
@global ZN_MSN_02_HandFunnel_BeamGun_CD=3
@global ZN_MSN_02_HandFunnel_BeamGun_EN=25


[turret_ZN_MSN_02_HandFunnel_BeamGun]
x:0
y:0

canShoot:false
projectile:ZN_MSN_02_HandFunnel_BeamGun_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:-5 
barrelY:-6
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamGun_3.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Fire_1_Yellow_S
[turret_ZN_MSN_02_HandFunnel_BeamGun_2]
@copyFromSection:turret_ZN_MSN_02_HandFunnel_BeamGun
barrelX:-3
barrelY:-4
shoot_sound_vol:0
[turret_ZN_MSN_02_HandFunnel_BeamGun_3]
@copyFromSection:turret_ZN_MSN_02_HandFunnel_BeamGun
barrelX:0
barrelY:-3
shoot_sound_vol:0
[turret_ZN_MSN_02_HandFunnel_BeamGun_4]
@copyFromSection:turret_ZN_MSN_02_HandFunnel_BeamGun
barrelX:3
barrelY:-3
shoot_sound_vol:0
[turret_ZN_MSN_02_HandFunnel_BeamGun_5]
@copyFromSection:turret_ZN_MSN_02_HandFunnel_BeamGun
barrelX:5
barrelY:-6
shoot_sound_vol:0




[projectile_ZN_MSN_02_HandFunnel_BeamGun_Projectile]
directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Yellow*1
(
    addResources=
    BeamDamage:1750
    |DpDamage:75
    |WeaponAccuracy=85
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:60
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""



[hiddenAction_ZN_MSN_02_HandFunnel_BeamGun_Trigger]
alsoTriggerAction:"""
ZN_MSN_02_HandFunnel_BeamGun_Fire
"""
[hiddenAction_ZN_MSN_02_HandFunnel_BeamGun_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MSN_02_HandFunnel_BeamGun_CDTimer and memory.onAttacking==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:ZN_MSN_02_HandFunnel_BeamGun_CDTimer=self.timeAlive+${ZN_MSN_02_HandFunnel_BeamGun_CD}
addResources:EN=-${ZN_MSN_02_HandFunnel_BeamGun_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_MSN_02_HandFunnel_BeamGun_SetWeaponIndex,
ZN_MSN_02_HandFunnel_BeamGun_B1_Step_1
"""
[hiddenAction_ZN_MSN_02_HandFunnel_BeamGun_B1_Step_1]
setUnitMemory:"""
ZN_MSN_02_HandFunnel_BeamGun_CDTimer=self.timeAlive+${ZN_MSN_02_HandFunnel_BeamGun_CD}
"""

alsoQueueAction:"""
ZN_MSN_02_HandFunnel_BeamGun_Fire_Step_1,
ZN_MSN_02_HandFunnel_BeamGun_Fire_Step_2,
ZN_MSN_02_HandFunnel_BeamGun_Fire_Step_3,
ZN_MSN_02_HandFunnel_BeamGun_Fire_Step_4,
ZN_MSN_02_HandFunnel_BeamGun_Fire_Step_5,
ZN_MSN_02_HandFunnel_BeamGun_Fire_Step_Final
"""




[hiddenAction_ZN_MSN_02_HandFunnel_BeamGun_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MSN_02_HandFunnel_BeamGun_Fire_Step_1]
buildSpeed:0.25s
fireTurretXAtGround:ZN_MSN_02_HandFunnel_BeamGun
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
whenBuilding_cannotMove:true
[hiddenAction_ZN_MSN_02_HandFunnel_BeamGun_Fire_Step_2]
