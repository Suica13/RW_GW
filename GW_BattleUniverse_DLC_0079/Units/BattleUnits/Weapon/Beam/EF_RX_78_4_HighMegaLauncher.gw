requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.1s
whenBuilding_cannotMove:true
fireTurretXAtGround:EF_RX_78_4_HighMegaLauncher
fireTurretXAtGround_withTarget:self.getOffsetRelative(x=select(self.dir>90 or self.dir<-90,25,-25),y=1000)
setBodyRotation:self.dir+0.5
setResourcesWithLogic:"""
hp=self.hp-self.maxHp*0.005,
EN=self.resource().EN-5
"""
