[hiddenAction_EF_RX_78_4_HighMegaLauncher_Fire_Step_1_AI]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:2.0s
spawnEffects:Flash_1_L
whenBuilding_cannotMove:true
playSoundAtUnit:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCannon_6.ogg:3.0
[hiddenAction_EF_RX_78_4_HighMegaLauncher_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:2.0s

stopLastAnimation:true
fireTurretXAtGround:EF_RX_78_4_HighMegaLauncher
fireTurretXAtGround_count:0
fireTurretXAtGround_withTarget:memory.EF_RX_78_4_HighMegaLauncher_AimTarget

whenBuilding_cannotMove:true
whenBuilding_rotateTo_aimAtActionTarget:true
whenBuilding_rotateTo_waitTillRotated:true
playSoundAtUnit:ROOT:Resource/Sound/SE/Weapon/Fire/BeamCannon_6.ogg:3.0
