[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory ZN_MSM_10_ChestBeam_CDTimer:float
@global ZN_MSM_10_ChestBeam_CD=3










[turret_ZN_MSM_10_ChestBeam]
x:0
y:0

canShoot:false
projectile:ZN_MSM_10_ChestBeam_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:-17.5
barrelY:-5
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource/Sound/SE/Weapon/Fire/BeamSprayGun_2.ogg
shoot_sound_vol:0.75
shoot_flame:Beam_Fire_1_Yellow
[turret_ZN_MSM_10_ChestBeam_L]
@copyFromSection:turret_ZN_MSM_10_ChestBeam
barrelX:17.5



[projectile_ZN_MSM_10_ChestBeam_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamRifle_Yellow*1
(
    addResources=
    BeamDamage:5000
    |DpDamage:150
    |WeaponAccuracy=100
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=1.0
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:55
    |ProjectileSpread:3
    |ProjectileLife:35
)
"""





[hiddenAction_ZN_MSM_10_ChestBeam_Trigger]
alsoTriggerAction:ZN_MSM_10_ChestBeam_Fire
[hiddenAction_ZN_MSM_10_ChestBeam_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MSM_10_ChestBeam_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:ZN_MSM_10_ChestBeam_CDTimer=self.timeAlive+${ZN_MSM_10_ChestBeam_CD}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
PlayCommon_Cannon_Shoot_A_Step_1,
ZN_MSM_10_ChestBeam_SetWeaponIndex,
ZN_MSM_10_ChestBeam_B4_Step_1
"""
[hiddenAction_ZN_MSM_10_ChestBeam_B4_Step_1]
alsoQueueAction:"""
ZN_MSM_10_ChestBeam_Fire_Step_1,
ZN_MSM_10_ChestBeam_Fire_Step_2,
ZN_MSM_10_ChestBeam_Fire_Step_3,
ZN_MSM_10_ChestBeam_Fire_Step_2,
ZN_MSM_10_ChestBeam_Fire_Step_3,
ZN_MSM_10_ChestBeam_Fire_Step_Final
"""



[hiddenAction_ZN_MSM_10_ChestBeam_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MSM_10_ChestBeam_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_ZN_MSM_10_ChestBeam_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
fireTurretXAtGround:ZN_MSM_10_ChestBeam
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MSM_10_ChestBeam_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
fireTurretXAtGround:ZN_MSM_10_ChestBeam_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)

[hiddenAction_ZN_MSM_10_ChestBeam_Fire_Step_Final]
buildSpeed:0.5s
alsoTriggerAction:SetAttackingOff

