[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory EF_RX_78_3_BR_CDTimer:float
@global EF_RX_78_3_BR_CD=1.0
@global EF_RX_78_3_BR_EN=25





[decal_EF_RX_78_3_BR]
layer:beforeBody
order:4.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Beam\Image\EF_RX_78_2_BR.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:0.85
xOffsetRelative: 0
yOffsetRelative: 12
dirOffset:0
[decal_EF_RX_78_3_BR_NotUsing]
@copyFromSection:decal_EF_RX_78_3_BR
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScale:0.75
xOffsetRelative:3.5
yOffsetRelative:-8.5
dirOffset:-90







[turret_EF_RX_78_3_BR]
x:0
y:0

canShoot:false
projectile:EF_RX_78_3_BR_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:9
barrelY:25
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_1.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Pink



[projectile_EF_RX_78_3_BR_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamRifle_Pink*1
(
    addResources=
    BeamDamage:6000
    |DpDamage:175
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=25
    |ProjectileSpeed:85
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""





[hiddenAction_EF_RX_78_3_BR_Trigger]
alsoTriggerAction:EF_RX_78_3_BR_Fire
[hiddenAction_EF_RX_78_3_BR_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_RX_78_3_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15)  
and self.resource.EN>0
"""
setUnitMemory:EF_RX_78_3_BR_CDTimer=self.timeAlive+${EF_RX_78_3_BR_CD}
addResources:EN=-${EF_RX_78_3_BR_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_RX_78_3_BR_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
EF_RX_78_3_BR_B1_Step_1
"""
[hiddenAction_EF_RX_78_3_BR_B1_Step_1]
alsoQueueAction:"""
EF_RX_78_3_BR_Fire_Step_1,
EF_RX_78_3_BR_Fire_Step_2,
EF_RX_78_3_BR_Fire_Step_Final
"""



[hiddenAction_EF_RX_78_3_BR_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_RX_78_3_BR_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_EF_RX_78_3_BR_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_RX_78_3_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_RX_78_3_BR_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

