[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw
"""

@memory EF_G_Fighter_BR_CDTimer:float
@global EF_G_Fighter_BR_CD=4
@global EF_G_Fighter_BR_EN=60










[turret_EF_G_Fighter_BR]
x:0
y:0

canShoot:false
showRangeUIGuide:false
projectile:EF_G_Fighter_BR_Projectile

delay:0.1s
limitingRange:1200
limitingAngle:3

canAttackMaxAngle:15
barrelX:-3
barrelY:10

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamRifle_1.ogg
shoot_sound_vol:0.75
shoot_flame:Beam_Fire_1_Pink

[turret_EF_G_Fighter_BR_R]
@copyFromSection:turret_EF_G_Fighter_BR
barrelX:3



[projectile_EF_G_Fighter_BR_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Pink*1
(
    addResources=
    BeamDamage:4000
    |DpDamage:100
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1.0
    |AntiAqua=0.5
    |AntiAir=1.5
    |AntiLand=1
    |AntiSpace=1.5
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""




[hiddenAction_EF_G_Fighter_BR_Trigger]
alsoTriggerAction:EF_G_Fighter_BR_Fire
[hiddenAction_EF_G_Fighter_BR_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_G_Fighter_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false and ${onSkill}==false  
and not (directionBetween(self, self.attacking) < self.dir-35 or directionBetween(self, self.attacking) > self.dir+35)  
and self.resource.EN>0
"""
setUnitMemory:EF_G_Fighter_BR_CDTimer=self.timeAlive+${EF_G_Fighter_BR_CD} 
addResources:EN=-${EF_G_Fighter_BR_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_G_Fighter_BR_SetWeaponIndex,
EF_G_Fighter_BR_B2_Step_1
"""
[hiddenAction_EF_G_Fighter_BR_B2_Step_1]
alsoQueueAction:"""
EF_G_Fighter_BR_Fire_Step_1,
EF_G_Fighter_BR_Fire_Step_2,
EF_G_Fighter_BR_Fire_Step_3,
EF_G_Fighter_BR_Fire_Step_Final
"""




[hiddenAction_EF_G_Fighter_BR_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_G_Fighter_BR_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
[hiddenAction_EF_G_Fighter_BR_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_G_Fighter_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_G_Fighter_BR_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.1s
fireTurretXAtGround:EF_G_Fighter_BR_R
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_G_Fighter_BR_Fire_Step_Final]
buildSpeed:0.3s
alsoTriggerAction:SetAttackingOff