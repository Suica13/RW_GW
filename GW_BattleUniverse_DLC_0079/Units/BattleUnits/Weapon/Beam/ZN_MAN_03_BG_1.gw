[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Yellow.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Cannon_Shoot_A.gw
"""

@memory ZN_MAN_03_BG_1_CDTimer:float
@global ZN_MAN_03_BG_1_CD=5
@global ZN_MAN_03_BG_1_EN=35





[turret_ZN_MAN_03_BG_1]
x:0
y:0

canShoot:false
projectile:ZN_MAN_03_BG_1_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:5
barrelY:-50
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:Resource/Sound/SE/Weapon/Fire/BeamGun_3.ogg
shoot_sound_vol:0.5
shoot_flame:Beam_Fire_1_Yellow
[turret_ZN_MAN_03_BG_1_L]
@copyFromSection:turret_ZN_MAN_03_BG_1
barrelX:-5
barrelY:-50
shoot_sound_vol:0



[projectile_ZN_MAN_03_BG_1_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamRifle_Yellow*1
(
    addResources=
    BeamDamage:3000
    |BeamAPDamage:750
    |DpDamage:175
    |WeaponAccuracy=90
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1 
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1 
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=3
    |HeightHitRange=25
    |ProjectileSpeed:85
    |ProjectileSpread:1
    |ProjectileLife:30
)
"""





[hiddenAction_ZN_MAN_03_BG_1_Trigger]
alsoTriggerAction:ZN_MAN_03_BG_1_Fire
[hiddenAction_ZN_MAN_03_BG_1_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_MAN_03_BG_1_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:ZN_MAN_03_BG_1_CDTimer=self.timeAlive+${ZN_MAN_03_BG_1_CD}
addResources:EN=-${ZN_MAN_03_BG_1_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_MAN_03_BG_1_SetWeaponIndex,
PlayCommon_Cannon_Shoot_A_Step_1,
ZN_MAN_03_BG_1_B1_Step_1
"""
[hiddenAction_ZN_MAN_03_BG_1_B1_Step_1]
alsoQueueAction:"""
ZN_MAN_03_BG_1_Fire_Step_1,
ZN_MAN_03_BG_1_Fire_Step_2,
ZN_MAN_03_BG_1_Fire_Step_3,
ZN_MAN_03_BG_1_Fire_Step_Final
"""



[hiddenAction_ZN_MAN_03_BG_1_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_MAN_03_BG_1_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_ZN_MAN_03_BG_1_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_MAN_03_BG_1
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MAN_03_BG_1_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.02s
fireTurretXAtGround:ZN_MAN_03_BG_1_L
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_MAN_03_BG_1_Fire_Step_Final]
buildSpeed:0s
alsoTriggerAction:"""
SetAttackingOff
"""