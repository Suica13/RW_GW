[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory ZN_YMS_15E_Lance_BR_CDTimer:float
@global ZN_YMS_15E_Lance_BR_CD=3
@global ZN_YMS_15E_Lance_BR_EN=25





[decal_ZN_YMS_15E_Lance_BR]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:Units/BattleUnits/Weapon/Cqb/Image/ZN_YMS_15E_Lance_0.png
isVisible:false
basePositionFromLegEnd:arm11
imageScale:1
imageScaleX:1.15
xOffsetRelative:13
yOffsetRelative:35
dirOffset:-5








[turret_ZN_YMS_15E_Lance_BR]
x:0
y:0

canShoot:false
projectile:ZN_YMS_15E_Lance_BR_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:13
barrelY:33
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource\Sound\SE\Weapon\Fire\BeamSprayGun_1.ogg
shoot_sound_vol:0.6
shoot_flame:Beam_Fire_1_Pink_S



[projectile_ZN_YMS_15E_Lance_BR_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamGun_Pink*1
(
    addResources=
    BeamDamage:3750
    |DpDamage:150
    |WeaponAccuracy=85
    |PartBreakModifier=1
    |CockpitBreakModifier=1
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.5
    |AntiAir=0.75 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:75
    |ProjectileSpread:1
    |ProjectileLife:25
)
"""





[hiddenAction_ZN_YMS_15E_Lance_BR_Trigger]
alsoTriggerAction:ZN_YMS_15E_Lance_BR_Fire
[hiddenAction_ZN_YMS_15E_Lance_BR_Fire]
requireConditional:"""
if self.timeAlive>memory.ZN_YMS_15E_Lance_BR_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:ZN_YMS_15E_Lance_BR_CDTimer=self.timeAlive+${ZN_YMS_15E_Lance_BR_CD}
addResources:EN=-${ZN_YMS_15E_Lance_BR_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
ZN_YMS_15E_Lance_BR_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
ZN_YMS_15E_Lance_BR_B3_Step_1
"""
[hiddenAction_ZN_YMS_15E_Lance_BR_B3_Step_1]
alsoQueueAction:"""
ZN_YMS_15E_Lance_BR_Fire_Step_1,
ZN_YMS_15E_Lance_BR_Fire_Step_2,
ZN_YMS_15E_Lance_BR_Fire_Step_3,
ZN_YMS_15E_Lance_BR_Fire_Step_3,
ZN_YMS_15E_Lance_BR_Fire_Step_Final
"""



[hiddenAction_ZN_YMS_15E_Lance_BR_SetWeaponIndex]
isVisible:false


[hiddenAction_ZN_YMS_15E_Lance_BR_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_ZN_YMS_15E_Lance_BR_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:ZN_YMS_15E_Lance_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_YMS_15E_Lance_BR_Fire_Step_3]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.15s
fireTurretXAtGround:ZN_YMS_15E_Lance_BR
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_ZN_YMS_15E_Lance_BR_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

