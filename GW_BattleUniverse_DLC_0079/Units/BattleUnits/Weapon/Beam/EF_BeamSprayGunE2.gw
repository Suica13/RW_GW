[core]
dont_load:false
copyFrom:"""
ROOT:Resource/Image/Fx/Weapon/Beam/Common/Beam_Fire_1_Pink.gw,
ROOT:Template/Unit/Animation/Shoot/Common_Shoot_A.gw
"""

@memory EF_BeamSprayGunE2_CDTimer:float
@global EF_BeamSprayGunE2_CD=2
@global EF_BeamSprayGunE2_EN=40





[decal_EF_BeamSprayGunE2]
layer:beforeBody
order:5.5
onlyWhileAlive:true
image:ROOT:\Units\BattleUnits\Weapon\Beam\Image\EF_BeamSprayGunE2.png
isVisible:false
basePositionFromLegEnd:arm4
imageScale:1
xOffsetRelative: 0
yOffsetRelative: 12
dirOffset:0
[decal_EF_BeamSprayGunE2_NotUsing]
@copyFromSection:decal_EF_BeamSprayGunE2
isVisible:false
order:3
basePositionFromLegEnd:arm1
imageScaleX:-1
imageScale:0.9
xOffsetRelative:2
yOffsetRelative:-9
dirOffset:-90







[turret_EF_BeamSprayGunE2]
x:0
y:0

canShoot:false
projectile:EF_BeamSprayGunE2_Projectile

delay:0.2s
canAttackMaxAngle:15
barrelX:9
barrelY:12
limitingRange:0

aimOffsetSpread:0
recoilOffset: 0
recoilOutTime: 0
recoilReturnTime: 0

shoot_sound:ROOT:\Resource/Sound/SE/Weapon/Fire/BeamSprayGun_2.ogg
shoot_sound_vol:0.75
shoot_flame:Beam_Fire_1_Pink_S



[projectile_EF_BeamSprayGunE2_Projectile]

directDamage: 0
life: 0
explodeOnEndOfLife:true
speed: 0

lightSize:0.75
lightColor:#ff57e9
effectOnCreate:none
explodeEffect:none

spawnUnit:"""
Projectile_BeamShotGun_Pink*8
(
    offsetRandomDir=9,
    addResources=
    BeamDamage:1250
    |DpDamage:125
    |WeaponAccuracy=95
    |PartBreakModifier=1.0
    |CockpitBreakModifier=1.0
    |PilotDamageModifier=1
    |PilotTrueDamage=0
    |AntiSizeLargeDamage=1
    |AntiSizeSmallDamage=0.75
    |AntiSizeLargeAccuracy=1
    |AntiSizeSmallAccuracy=0.75
    |AntiBuilding=1
    |AntiAqua=0.75
    |AntiAir=1 
    |AntiLand=1
    |AntiSpace=1
    |HeightChangeSpeed=2
    |HeightHitRange=20
    |ProjectileSpeed:55
    |ProjectileSpread:2
    |ProjectileLife:12
)
"""





[hiddenAction_EF_BeamSprayGunE2_Trigger]
alsoTriggerAction:EF_BeamSprayGunE2_Fire
[hiddenAction_EF_BeamSprayGunE2_Fire]
requireConditional:"""
if self.timeAlive>memory.EF_BeamSprayGunE2_CDTimer and ${onAttacking}==false and ${cantAction}==false 
and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) 
and self.resource.EN>0
"""
setUnitMemory:EF_BeamSprayGunE2_CDTimer=self.timeAlive+${EF_BeamSprayGunE2_CD}
addResources:EN=-${EF_BeamSprayGunE2_EN}
alsoTriggerAction:"""
SetAttackingOn,
SendEnemyTryAttack_Shoot,
EF_BeamSprayGunE2_SetWeaponIndex,
PlayCommon_Shoot_A_Step_1,
EF_BeamSprayGunE2_B1_Step_1
"""
[hiddenAction_EF_BeamSprayGunE2_B1_Step_1]
alsoQueueAction:"""
EF_BeamSprayGunE2_Fire_Step_1,
EF_BeamSprayGunE2_Fire_Step_2,
EF_BeamSprayGunE2_Fire_Step_Final
"""



[hiddenAction_EF_BeamSprayGunE2_SetWeaponIndex]
isVisible:false


[hiddenAction_EF_BeamSprayGunE2_Fire_Step_1]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0.25s
[hiddenAction_EF_BeamSprayGunE2_Fire_Step_2]
requireConditional:"""
if ${cantAction}==false 
"""
buildSpeed:0s
fireTurretXAtGround:EF_BeamSprayGunE2
fireTurretXAtGround_withTarget:self.getOffsetRelative(y=1000)
[hiddenAction_EF_BeamSprayGunE2_Fire_Step_3]
@copyFromSection:hiddenAction_EF_BeamSprayGunE2_Fire_Step_2
buildSpeed:${turret_EF_BeamSprayGunE2.delay}
[hiddenAction_EF_BeamSprayGunE2_Fire_Step_Final]
buildSpeed:0.25s
alsoTriggerAction:SetAttackingOff

