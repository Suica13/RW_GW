[core]
dont_load:true
@global manualControlImplemented=true
@memory manualVulcanRightNext:bool
copyFrom:ROOT:Template/Unit/Skill/PlayerControl.gw

# Instance overrides keep native weapon sequences, equipment and damage definitions.

[hiddenAction_ZN_MAN_03_Funnel_Trigger_ByAI]
autoTrigger:if not memory.manualControlEnabled and (${allowAI}==true and ${cantAction}==false and ${onSkill}==false and memory.close==false and self.resource.EN>${ZN_MAN_03_Funnel_EN} and self.timeAlive>memory.ZN_MAN_03_Funnel_CDTimer and self.parent.hp<=0  and self.attacking.hp>0 and memory.pilotUnit.readUnitMemory("pilotAwakeningSkillFinal",type="float")>=${ZN_MAN_03_Funnel_PilotAwakeningSkill})

[hiddenAction_ZN_MAN_03_Funnel_Fire_Step_1]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MAN_03_Funnel_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MAN_03_Funnel_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MAN_03_Funnel_Fire_Step_4]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_Common_Push_L_A_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)<=80)

[hiddenAction_Common_Push_L_A_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MAN_03_BG_1_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>80  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and self.timeAlive>memory.ZN_MAN_03_Funnel_CDTimer and eventData("RandomWeapon",type="float")>50)

[hiddenAction_ZN_MAN_03_BG_1_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MAN_03_BG_1_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MAN_03_BG_2_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>80  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and self.timeAlive>memory.ZN_MAN_03_Funnel_CDTimer and eventData("RandomWeapon",type="float")<=50 and eventData("RandomWeapon",type="float")>25)

[hiddenAction_ZN_MAN_03_BG_2_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MAN_03_BG_2_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MAN_03_BG_3_Trigger]
requireConditional:if not memory.manualControlEnabled and (distanceBetween(self,self.attacking)>80  and distanceBetween(self,self.attacking)<=memory.finalAttackRange and self.timeAlive>memory.ZN_MAN_03_Funnel_CDTimer and eventData("RandomWeapon",type="float")<=25)

[hiddenAction_ZN_MAN_03_BG_3_Fire_Step_2]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[hiddenAction_ZN_MAN_03_BG_3_Fire_Step_3]
requireConditional:if (${cantAction}==false) and (not memory.manualControlEnabled or ${manualControlReady})

[action_ZN_MAN_03_Funnel_Trigger]
pos:30
requireConditional:if (true) and (not memory.manualControlEnabled or ${manualWeaponReady})

[hiddenAction_ManualControl_CancelSpecialWeapons]
requireConditional:true
alsoTriggerAction:SetOnSkillOff

[action_Manual_Common_Push_L_A]
@copyFromSection:template_ManualWeapon
pos:3
text:Melee
text_zh:徒手格斗
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/Cqb_1.png
isVisible:if ${manualControlReady} and ((true))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_L_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((true)))
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_L_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((true))
alsoTriggerAction:Common_Push_L_A_Fire
displayType:action

[hiddenAction_Common_Push_L_A_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.Common_Push_L_A_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-30 or directionBetween(self, self.attacking) > self.dir+30) and max(-(self.attacking.height-self.height),(self.attacking.height-self.height))<=50)) or (${manualWeaponReady} and ((self.timeAlive>memory.Common_Push_L_A_CDTimer) and (${onAttacking}==false) and (${cantAction}==false)) and ((true)))
setUnitMemory:Common_Push_L_A_CDTimer=self.timeAlive+${Common_Push_L_A_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${Common_Push_L_A_CD}s
addActionCooldownApplyToActions:Manual_Common_Push_L_A

[action_Manual_ZN_MAN_03_BG_1]
@copyFromSection:template_ManualWeapon
pos:2
text:Beam cannon
text_zh:光束枪
description:Uses native ammunition, EN and cooldown.
description_zh:沿用原武装弹数、EN消耗与冷却。
iconImage:ROOT:Resource/Image/Units/Button/Weapon/BeamCannon_1.png
isVisible:if ${manualControlReady} and ((((self.timeAlive>memory.ZN_MAN_03_Funnel_CDTimer))))
isLocked:if not (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MAN_03_BG_1_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((self.timeAlive>memory.ZN_MAN_03_Funnel_CDTimer)))) and self.resource.EN>=${ZN_MAN_03_BG_1_EN})
requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_MAN_03_BG_1_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((self.timeAlive>memory.ZN_MAN_03_Funnel_CDTimer)))) and self.resource.EN>=${ZN_MAN_03_BG_1_EN}
alsoTriggerAction:ZN_MAN_03_BG_1_Fire
displayType:action

[hiddenAction_ZN_MAN_03_BG_1_Fire]
requireConditional:if (not memory.manualControlEnabled and (self.timeAlive>memory.ZN_MAN_03_BG_1_CDTimer and ${onAttacking}==false and ${cantAction}==false and not (directionBetween(self, self.attacking) < self.dir-15 or directionBetween(self, self.attacking) > self.dir+15) and self.resource.EN>0)) or (${manualWeaponReady} and ((self.timeAlive>memory.ZN_MAN_03_BG_1_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((self.timeAlive>memory.ZN_MAN_03_Funnel_CDTimer)))) and self.resource.EN>=${ZN_MAN_03_BG_1_EN})
setUnitMemory:ZN_MAN_03_BG_1_CDTimer=self.timeAlive+${ZN_MAN_03_BG_1_CD},manualInputBusyUntil=select(memory.manualControlEnabled,self.timeAlive+0.15,memory.manualInputBusyUntil)
addActionCooldownTime:${ZN_MAN_03_BG_1_CD}s
addActionCooldownApplyToActions:Manual_ZN_MAN_03_BG_1

