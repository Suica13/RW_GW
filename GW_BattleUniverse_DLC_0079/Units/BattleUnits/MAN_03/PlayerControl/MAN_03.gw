requireConditional:if ${manualWeaponReady} and ((self.timeAlive>memory.ZN_MAN_03_BG_3_CDTimer) and (${onAttacking}==false) and (${cantAction}==false) and (self.resource.EN>0)) and ((((self.timeAlive>memory.ZN_MAN_03_Funnel_CDTimer)))) and self.resource.EN>=${ZN_MAN_03_BG_3_EN}
