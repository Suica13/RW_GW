[core]
dont_load:true

[template_ManualShip_ArcLine]
layer:shadow
order:0
onlyTeam:own
onlyWhenSelectedByOwnPlayer:true
onlyOnNonPreview:true
onlyWhileAlive:true
lineWidth:1

[template_ManualShip_Arc_BurkeClass_Turret_AMS_M1_turret_BurkeClass_Turret_AMS]
@copyFromSection:template_ManualShip_ArcLine
color:#FFB45C
isVisible:if ${manualControlReady} and memory.hideUI==0 and memory.manualShipArcGroup==1 and self.attachment(slot='BurkeClass_Turret_AMS_M1').hp>0 and not self.attachment(slot='BurkeClass_Turret_AMS_M1').readUnitMemory('breaked',type='bool')
alpha:select(not self.attachment(slot='BurkeClass_Turret_AMS_M1').readUnitMemory('BurkeClass_Turret_AMS_OnCD',type='bool') and self.attachment(slot='BurkeClass_Turret_AMS_M1').resource.BurkeClass_Turret_AMS_ShootTimer>0,0.55,0.15)

