[core]
copyFrom:"""
ROOT:Template/UI/Common_UI.gw
"""

tags:TechTree_Core
name:TechTree_Core

showInEditor:false

canNotBeDirectlyAttacked:true

@memory showTechTree:bool
@memory autoTech:float

[hiddenAction_Start_Get_AutoTech]
autoTriggerOnEvent:created
setUnitMemory:autoTech=customTarget1.readUnitMemory('autoTech',type='float')

[hiddenAction_InitializeStats]
alsoTriggerAction:"""
Start_Set_Tech
"""


[hiddenAction_Start_Set_Tech]
isVisible:false

[hiddenAction_Update]


[hiddenAction_ClosePage]
autoTriggerOnEvent:newMessage(withTag="ClosePage")
setUnitMemory:showTechTree=false


[hiddenAction_Get_PrintMessage]
autoTriggerOnEvent:newMessage(withTag="PrintMessage")
showMessageToPlayer:"""
%{eventData("message",type="string")}
"""
showMessageToPlayer_zh:"""
%{eventData("message_zh",type="string")}
"""
playSoundToPlayer:ROOT:Resource/Sound/SE/System/Button/Info_1.ogg:



[template_ShowTechTree]
pos:1
text:Test TechTree
text_zh:测试科技树
displayType:action
buildSpeed:0s
isVisible:if self.attachment(slot="EFSF_0079").hp>0 and memory.showTechTree==false
iconImage:ROOT:Resource/Image/Icon/Faction_EFSF_0079_2.png
playSoundToPlayer:ROOT:Resource/Sound/SE/System/Button/Select_1.ogg

refundAllQueuedItems:true

isLocked:if not self.globalTeamTags(includes='Test')
isLockedMessage:No Base Tech
isLockedMessage:没有基础科技

setUnitMemory:showTechTree=true

sendMessageTo:self.attachment(slot="EFSF_0079")
sendMessageWithTags:ShowTechTree



[template_TechTree_Main]
x:0
y:85
setDrawLayerOnBottom:false
isVisible:true
keepAliveWhenParentDies:false
canBeAttackedAndDamaged:false
isUnselectable:true
canAttack:false
showAllActionsFrom:false
prioritizeParentsMainTarget:true
smoothlyBlendPositionWhenExistingUnitAdded:false
onConvertKeepExistingUnitInSameSlot:true
onParentTeamChangeKeepCurrentTeam:false
onCreateSpawnUnitOf:TechTree_UI_Main_EFSF_0079



[decal_Core]
layer:beforeUI
order:1
onlyTeam:own
onlyWhileAlive:true
isVisible:true
image:ROOT:Resource/Image/Icon/TechTreeCore.png
imageScale:0.5
xOffsetRelative:0
yOffsetRelative:0






[decal_Text]
layer:beforeUI
order:3
onlyWhileAlive:true
onlyTeam:own
alpha:1
image:ROOT:Resource/Image/Text/Icon/HQ_TechTree.png
imageScale:0.3
xOffsetAbsolute:0
yOffsetAbsolute:16
alwaysStartDirAtZero:true
onlyOnNonPreview:true
isVisible:if self.resource.GameStart==1
[decal_Text_Background]
@copyFromSection:decal_Text
order:2
imageScale:0.375
image:ROOT:Resource/Image/Text/Icon/HQ_Slot_Background.png
